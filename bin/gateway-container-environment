#!/usr/bin/python3
"""Publish the current Gateway env inode, and the host's nested-fleet files, to the private, read-only guest mount."""
import fcntl
import json
import os
import pwd
import re
import secrets
import stat
import subprocess
import sys
from pathlib import Path

SHARED = Path("/home/orbit/shared")
PROJECTION = SHARED / ".gateway-release-environment"
INVENTORY = Path("/home/orbit/.orbit/gateway-containers.json")
INCUS = ["incus", "--force-local", "--project", "orbit-releases"]
# The fleet rules write these on a nested-fleet Gateway host only (InstanceFleetGateway). The guest reads its copies.
# Publish the environment before the marker and remove the marker first, so a reader never sees the marker without its proxy.
FLEET = {"instance-fleet-environment": Path("/etc/environment"), "instance-fleet": Path("/etc/orbit/instance-fleet")}


def publish_fleet(fd, fleet):
    nested = fleet["instance-fleet"].is_file()
    for name, host in (fleet.items() if nested else reversed(fleet.items())):
        if not nested:
            try:
                os.unlink(name, dir_fd=fd)
            except FileNotFoundError:
                pass
            continue
        staged = ".fleet-refresh-" + secrets.token_hex(12)
        out = os.open(staged, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=fd)
        try:
            with os.fdopen(out, "wb") as copy:
                copy.write(host.read_bytes())
            os.replace(staged, name, src_dir_fd=fd, dst_dir_fd=fd)
        finally:
            try:
                os.unlink(staged, dir_fd=fd)
            except FileNotFoundError:
                pass


def publish(directory=PROJECTION, source=SHARED / "gateway.env", fleet=FLEET):
    directory.mkdir(mode=0o700, exist_ok=True)
    fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        folder = os.fstat(fd)
        if folder.st_uid != os.geteuid() or stat.S_IMODE(folder.st_mode) != 0o700:
            raise ValueError("unexpected Gateway environment projection ownership or permissions")
        # Coordinate with the host credential installer. An older refresh must never overwrite a rotation.
        fcntl.flock(fd, fcntl.LOCK_EX)
        name = source.parent / (".gateway-env-refresh-" + secrets.token_hex(12))
        os.link(source, name, follow_symlinks=False)
        try:
            info = name.lstat()
            if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or stat.S_IMODE(info.st_mode) != 0o600:
                raise ValueError("Gateway environment must be a private file owned by orbit")
            os.replace(name, "gateway.env", dst_dir_fd=fd)
        finally:
            name.unlink(missing_ok=True)
        publish_fleet(fd, fleet)
    finally:
        os.close(fd)


def main(action):
    if action == "publish" and os.geteuid() == pwd.getpwnam("orbit").pw_uid:
        publish()
        return
    if action not in {"refresh", "configure"} or os.geteuid():
        raise ValueError("usage: sudo orbit-gateway-environment refresh|configure")
    subprocess.run(["runuser", "-u", "orbit", "--", os.path.realpath(__file__), "publish"], check=True)
    if action == "configure":
        sha = json.loads(INVENTORY.read_text())["live"]
        if not re.fullmatch("[0-9a-f]{40}", sha):
            raise ValueError("invalid live Gateway release")
        machine = "gateway-" + sha[:12]
        for key, expected in {"target": "gateway", "commit": sha}.items():
            value = subprocess.check_output([*INCUS, "config", "get", machine, "user.orbit.release." + key], text=True)
            if value.strip() != expected:
                raise ValueError("live release identity changed")
        os.execvp("incus", [*INCUS, "exec", machine, "--", "runuser", "-u", "orbit", "--",
                            "/usr/bin/php8.5", "/home/orbit/orbit/apps/gateway/artisan", "gateway:release:configure"])


if __name__ == "__main__":
    try:
        main(sys.argv[1] if len(sys.argv) == 2 else "")
    except (OSError, KeyError, ValueError, subprocess.CalledProcessError) as error:
        sys.exit(str(error))
