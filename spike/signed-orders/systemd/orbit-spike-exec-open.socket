# SPIKE(signed-orders): security test only — an open socket so the executor itself must refuse other users.
[Unit]
Description=Orbit spike executor socket

[Socket]
ListenStream=/run/orbit-spike-exec-open.sock
SocketUser=root
SocketGroup=root
SocketMode=0666
Accept=yes
MaxConnections=16

[Install]
WantedBy=sockets.target
