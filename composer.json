{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "hardimpactdev/orbit",
    "type": "project",
    "description": "Orbit monorepo orchestration.",
    "keywords": [
        "laravel",
        "orbit",
        "environment"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5"
    },
    "scripts": {
        "setup": [
            "composer install",
            "cd packages/core && composer install",
            "cd packages/sdk && composer install",
            "cd apps/gateway && composer install",
            "cd apps/docs && composer install",
            "cd apps/cli && composer install",
            "cd apps/reverb && composer install",
            "cd apps/e2e && composer install",
            "cd apps/gateway && npm install --ignore-scripts && npm run build",
            "cd apps/docs && npm install --ignore-scripts && npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "cd apps/gateway && composer run dev"
        ],
        "docs-lint": [
            "bin/quality-gate-run --gate=docs-lint --command=\"composer docs-lint\" -- bash -lc 'bin/orbit-docs-artisan librarian:lint --format=agent --path=domains && bin/orbit-docs-artisan librarian:lint --format=agent --path=testing && bin/orbit-docs-artisan librarian:lint --format=agent --group=references'"
        ],
        "docs-test": [
            "bin/orbit-docs-pest --compact"
        ],
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "bin/orbit-gateway-artisan config:clear --ansi @no_additional_args",
            "bin/orbit-gateway-pest --exclude-group=e2e --exclude-group=slow --parallel --compact",
            "bin/orbit-cli-pest --exclude-group=slow --compact",
            "bin/orbit-docs-pest --compact",
            "cd packages/core && vendor/bin/pest --compact",
            "cd packages/sdk && vendor/bin/pest --compact"
        ],
        "test:slow": [
            "Composer\\Config::disableProcessTimeout",
            "bin/orbit-gateway-artisan config:clear --ansi @no_additional_args",
            "bin/orbit-gateway-pest --exclude-group=e2e --parallel --compact",
            "bin/orbit-cli-pest --compact",
            "bin/orbit-docs-pest --compact",
            "cd packages/core && vendor/bin/pest --compact",
            "cd packages/sdk && vendor/bin/pest --compact"
        ],
        "test:e2e": [
            "Composer\\Config::disableProcessTimeout",
            "set -a; [ ! -f .env.e2e ] || . ./.env.e2e; set +a; bin/quality-gate-run --gate=e2e --command=\"composer test:e2e\" -- bin/orbit-e2e-artisan e2e:test @additional_args"
        ],
        "test:e2e:next": [
            "Composer\\Config::disableProcessTimeout",
            "cd apps/e2e && vendor/bin/pest --compact @additional_args"
        ],
        "test:e2e:binary": [
            "Composer\\Config::disableProcessTimeout",
            "bin/orbit-build-cli-binary mac arm \"$(bin/orbit-version)\"",
            "ORBIT_E2E_BINARY_PATH=$(pwd)/apps/cli/builds/dist/mac/mac-arm; export ORBIT_E2E_BINARY_PATH; cd apps/e2e && vendor/bin/pest --group=e2e-binary --compact @additional_args"
        ],
        "test:e2e:binary:linux": [
            "Composer\\Config::disableProcessTimeout",
            "bin/orbit-build-cli-binary linux x64 \"$(bin/orbit-version)\""
        ],
        "test:e2e:docker:binary-acceptance": [
            "Composer\\Config::disableProcessTimeout",
            "bin/orbit-build-cli-binary linux x64 \"$(bin/orbit-version)\"",
            "set -a; [ ! -f .env.e2e ] || . ./.env.e2e; set +a; export ORBIT_E2E_BINARY_PATH_LINUX=$(pwd)/apps/cli/builds/dist/linux/linux-x64; cd apps/e2e && ORBIT_E2E=1 ORBIT_E2E_TOPOLOGY_PROVIDER=docker vendor/bin/pest --group=e2e-binary-acceptance --fail-on-empty-test-suite @additional_args"
        ],
        "test:e2e:docker": [
            "Composer\\Config::disableProcessTimeout",
            "set -a; [ ! -f .env.e2e ] || . ./.env.e2e; set +a; ORBIT_E2E_LANES=docker bin/quality-gate-run --gate=e2e-docker --command=\"composer test:e2e:docker\" -- bin/orbit-e2e-artisan e2e:test @additional_args"
        ],
        "test:e2e:docker:canary": [
            "Composer\\Config::disableProcessTimeout",
            "set -a; [ ! -f .env.e2e ] || . ./.env.e2e; set +a; ORBIT_E2E_LANES=docker bin/quality-gate-run --gate=e2e-docker-canary --command=\"composer test:e2e:docker:canary\" -- bin/orbit-e2e-artisan e2e:test --canary @additional_args"
        ],
        "test:e2e:incus": [
            "Composer\\Config::disableProcessTimeout",
            "set -a; [ ! -f .env.e2e ] || . ./.env.e2e; set +a; ORBIT_E2E_LANES=incus bin/quality-gate-run --gate=e2e-incus --command=\"composer test:e2e:incus\" -- bin/orbit-e2e-artisan e2e:test @additional_args"
        ],
        "test:e2e:topology-contract": [
            "Composer\\Config::disableProcessTimeout",
            "set -a; [ ! -f .env.e2e ] || . ./.env.e2e; set +a; cd apps/e2e && ORBIT_E2E=1 ORBIT_E2E_TOPOLOGY_PROVIDER=docker vendor/bin/pest --group=e2e-topology-contract-operator_gateway_app-dev_app-prod_agent_websocket @additional_args"
        ],
        "test:e2e:provision": [
            "Composer\\Config::disableProcessTimeout",
            "composer test:e2e:provision:docker",
            "composer test:e2e:provision:incus"
        ],
        "test:e2e:provision:docker": [
            "Composer\\Config::disableProcessTimeout",
            "set -a; [ ! -f .env.e2e ] || . ./.env.e2e; set +a; bin/orbit-e2e-artisan e2e:prepare-docker-hosts --force --rebuild operator_gateway_app-dev_app-prod_agent_websocket @additional_args"
        ],
        "test:e2e:provision:incus": [
            "Composer\\Config::disableProcessTimeout",
            "set -a; [ ! -f .env.e2e ] || . ./.env.e2e; set +a; cd apps/e2e && ORBIT_E2E=1 vendor/bin/pest --group=e2e-provision --fail-on-empty-test-suite @additional_args"
        ],
        "e2e:preflight": "set -a; [ ! -f .env.e2e ] || . ./.env.e2e; set +a; bin/orbit-e2e-artisan e2e:preflight @additional_args",
        "e2e:dev-topology": [
            "Composer\\Config::disableProcessTimeout",
            "set -a; [ ! -f .env.e2e ] || . ./.env.e2e; set +a; composer --working-dir=apps/e2e e2e:dev-topology -- @additional_args"
        ],
        "e2e:dev-topology:release": [
            "Composer\\Config::disableProcessTimeout",
            "set -a; [ ! -f .env.e2e ] || . ./.env.e2e; set +a; composer --working-dir=apps/e2e e2e:dev-topology:release -- @additional_args"
        ],
        "e2e:incus": [
            "Composer\\Config::disableProcessTimeout",
            "set -a; [ ! -f .env.e2e ] || . ./.env.e2e; set +a; composer --working-dir=apps/e2e e2e:incus -- @additional_args"
        ],
        "e2e:reap-incus": "set -a; [ ! -f .env.e2e ] || . ./.env.e2e; set +a; bin/orbit-e2e-artisan e2e:reap-incus @additional_args",
        "e2e:reap-docker": "set -a; [ ! -f .env.e2e ] || . ./.env.e2e; set +a; bin/orbit-e2e-artisan e2e:reap-docker @additional_args",
        "e2e:prepare-docker-runtime": [
            "Composer\\Config::disableProcessTimeout",
            "set -a; [ ! -f .env.e2e ] || . ./.env.e2e; set +a; bin/orbit-e2e-artisan e2e:prepare-docker-runtime @additional_args"
        ],
        "e2e:prepare-docker-topology": [
            "Composer\\Config::disableProcessTimeout",
            "set -a; [ ! -f .env.e2e ] || . ./.env.e2e; set +a; bin/orbit-e2e-artisan e2e:prepare-docker-topology @additional_args"
        ],
        "e2e:prepare-docker-hosts": [
            "Composer\\Config::disableProcessTimeout",
            "set -a; [ ! -f .env.e2e ] || . ./.env.e2e; set +a; bin/orbit-e2e-artisan e2e:prepare-docker-hosts @additional_args"
        ],
        "e2e:ensure-artifacts": [
            "Composer\\Config::disableProcessTimeout",
            "set -a; [ ! -f .env.e2e ] || . ./.env.e2e; set +a; bin/orbit-e2e-artisan e2e:ensure-artifacts @additional_args"
        ],
        "e2e:prepare-base-image": [
            "Composer\\Config::disableProcessTimeout",
            "set -a; [ ! -f .env.e2e ] || . ./.env.e2e; set +a; bin/orbit-e2e-artisan e2e:prepare-base-image @additional_args"
        ],
        "e2e:prepare-topology": [
            "Composer\\Config::disableProcessTimeout",
            "set -a; [ ! -f .env.e2e ] || . ./.env.e2e; set +a; bin/orbit-e2e-artisan e2e:prepare-topology @additional_args"
        ],
        "e2e:prepare-warm-topology": [
            "Composer\\Config::disableProcessTimeout",
            "set -a; [ ! -f .env.e2e ] || . ./.env.e2e; set +a; bin/orbit-e2e-artisan e2e:prepare-warm-topology @additional_args"
        ],
        "analyse": [
            "Composer\\Config::disableProcessTimeout",
            "bin/orbit-gateway-vendor-bin mago analyze app config database --reporting-format=medium",
            "cd apps/cli && vendor/bin/mago analyze app config --reporting-format=medium",
            "cd apps/docs && vendor/bin/mago analyze app config database --reporting-format=medium",
            "bin/orbit-gateway-vendor-bin mago --workspace ../reverb analyze bootstrap config routes --reporting-format=medium",
            "cd packages/core && vendor/bin/mago analyze src --reporting-format=medium",
            "cd packages/sdk && vendor/bin/mago analyze src --reporting-format=medium",
            "cd apps/e2e && vendor/bin/mago analyze app config database --reporting-format=medium"
        ],
        "format": [
            "bin/orbit-gateway-vendor-bin mago format",
            "cd apps/cli && vendor/bin/mago format",
            "cd apps/docs && vendor/bin/mago format",
            "bin/orbit-gateway-vendor-bin mago --workspace ../reverb format",
            "cd packages/core && vendor/bin/mago format",
            "cd packages/sdk && vendor/bin/mago format",
            "cd apps/e2e && vendor/bin/mago format"
        ],
        "mago:analyze": [
            "Composer\\Config::disableProcessTimeout",
            "bin/orbit-gateway-vendor-bin mago analyze app config database --reporting-format=medium",
            "cd apps/cli && vendor/bin/mago analyze app config --reporting-format=medium",
            "cd apps/docs && vendor/bin/mago analyze app config database --reporting-format=medium",
            "bin/orbit-gateway-vendor-bin mago --workspace ../reverb analyze bootstrap config routes --reporting-format=medium",
            "cd packages/core && vendor/bin/mago analyze src --reporting-format=medium",
            "cd packages/sdk && vendor/bin/mago analyze src --reporting-format=medium",
            "cd apps/e2e && vendor/bin/mago analyze app config database --reporting-format=medium"
        ],
        "mago:lint": [
            "Composer\\Config::disableProcessTimeout",
            "bin/orbit-gateway-vendor-bin mago lint --reporting-format=medium",
            "cd apps/cli && vendor/bin/mago lint --reporting-format=medium",
            "cd apps/docs && vendor/bin/mago lint --reporting-format=medium",
            "bin/orbit-gateway-vendor-bin mago --workspace ../reverb lint --reporting-format=medium",
            "cd packages/core && vendor/bin/mago lint --reporting-format=medium",
            "cd packages/sdk && vendor/bin/mago lint --reporting-format=medium",
            "cd apps/e2e && vendor/bin/mago lint --reporting-format=medium"
        ],
        "mago:format": [
            "bin/orbit-gateway-vendor-bin mago format",
            "cd apps/cli && vendor/bin/mago format",
            "cd apps/docs && vendor/bin/mago format",
            "bin/orbit-gateway-vendor-bin mago --workspace ../reverb format",
            "cd packages/core && vendor/bin/mago format",
            "cd packages/sdk && vendor/bin/mago format",
            "cd apps/e2e && vendor/bin/mago format"
        ],
        "mago:format:check": [
            "bin/orbit-gateway-vendor-bin mago format --check",
            "cd apps/cli && vendor/bin/mago format --check",
            "cd apps/docs && vendor/bin/mago format --check",
            "bin/orbit-gateway-vendor-bin mago --workspace ../reverb format --check",
            "cd packages/core && vendor/bin/mago format --check",
            "cd packages/sdk && vendor/bin/mago format --check",
            "cd apps/e2e && vendor/bin/mago format --check"
        ],
        "rector": [
            "bin/orbit-gateway-vendor-bin rector process",
            "cd apps/cli && vendor/bin/rector process",
            "cd apps/docs && vendor/bin/rector process",
            "cd packages/core && vendor/bin/rector process",
            "cd packages/sdk && vendor/bin/rector process",
            "cd apps/e2e && vendor/bin/rector process"
        ],
        "quality-check": [
            "bin/quality-check.sh"
        ],
        "quality-check:fix": [
            "bin/quality-check.sh --fix"
        ],
        "quality-gate:analyze": [
            "bin/quality-gate-analyze"
        ],
        "quality-gate:final-check": [
            "bin/quality-gate-final-check"
        ],
        "quality-gate:baseline-capture": [
            "bin/quality-gate-baseline-capture"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
