{
  "kind": "analytics.disable",
  "workflow": "operation-analytics-disable-direct",
  "topology": "minimal",
  "clean": true,
  "budget_seconds": 1800,
  "queue_timeout_seconds": 30,
  "before_gateway": [
    [
      "sh",
      "-c",
      "printf '%s' \"$1\" | runuser -u orbit -- env -C apps/gateway php ../../tools/swamp-proof-guest/gateway.php fixture",
      "sh",
      "{\"roles\": {\"${node.metrics}\": [\"analytics\"]}}"
    ]
  ],
  "prepare": [
    {
      "method": "POST",
      "path": "projects",
      "operation": false,
      "bind": "project",
      "body": {
        "slug": "proof-analytics",
        "name": "Proof analytics",
        "type": "monorepo",
        "root": "public",
        "repository_url": "https://github.com/laravel/laravel.git",
        "default_branch": "13.x"
      }
    },
    {
      "method": "POST",
      "path": "instances",
      "bind": "instance",
      "body": {
        "project_id": "${project.id}",
        "node_id": "${node.target}",
        "name": "a-${proof.run}"
      }
    },
    {
      "method": "POST",
      "path": "routes",
      "bind": "route",
      "body": {
        "instance_id": "${instance.id}",
        "domain": "a-${proof.run}.proof.test"
      }
    }
  ],
  "after_prepare": [
    [
      "sh",
      "-c",
      "printf '%s' \"$1\" | runuser -u orbit -- env -C apps/gateway php ../../tools/swamp-proof-guest/gateway.php fixture",
      "sh",
      "{\"analytics_tracking\": [{\"instance_id\": \"${instance.id}\", \"domain\": \"t-${proof.run}.proof.test\"}]}"
    ]
  ],
  "request": {
    "method": "DELETE",
    "path": "instances/${instance.id}/analytics",
    "body": {}
  },
  "expect": {
    "status": "succeeded"
  },
  "phases": [
    {
      "name": "withdraw",
      "job": "analytics",
      "step": "Withdraw sites, certs-0",
      "budget_seconds": 300
    },
    {
      "name": "check",
      "job": "analytics",
      "step": "Check the hosts are gone-0",
      "budget_seconds": 120
    }
  ],
  "parity": "swamp/proof/analytics.disable/parity.py"
}
