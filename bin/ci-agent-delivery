#!/usr/bin/env python3
"""Select or reuse published agent bytes when apps/agent has not changed."""
import argparse
import json
from pathlib import Path
import re
import subprocess
import sys
import tempfile

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / 'tools'))
from combine_agent_delivery import PLATFORMS, combine

REPOSITORY = 'hardimpactdev/orbit'
WORKFLOW = f'{REPOSITORY}/.github/workflows/orbit-cli-release.yml'


def run(*args):
    return subprocess.check_output(args, cwd=ROOT, text=True).strip()


def select():
    # Releases are immutable. Compare with their actual source, not just the last
    # push, because concurrency may have cancelled a preceding agent build.
    page = 1
    while True:
        releases = json.loads(run('gh', 'api', f'repos/{REPOSITORY}/releases?per_page=100&page={page}'))
        for release in releases:
            tag = release['tag_name']
            if release['draft'] or release['prerelease'] or not re.fullmatch(r'cli-v0\.[1-9][0-9]*\.0', tag):
                continue
            asset = next((asset for asset in release['assets'] if asset['name'] == 'manifest.json'), None)
            if asset is None:
                continue
            manifest = json.loads(run('gh', 'api', '-H', 'Accept: application/octet-stream',
                                      f'repos/{REPOSITORY}/releases/assets/{asset["id"]}'))
            commit = manifest['commit']
            if not re.fullmatch(r'[0-9a-f]{40}', commit):
                raise ValueError('The published manifest has an invalid source commit.')
            if subprocess.run(['git', 'merge-base', '--is-ancestor', commit, 'HEAD'], cwd=ROOT,
                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode:
                continue
            changed = subprocess.run(['git', 'diff', '--quiet', commit, 'HEAD', '--', 'apps/agent'], cwd=ROOT).returncode
            if changed not in (0, 1):
                raise ValueError('Cannot compare the published agent source.')
            return {'build': changed == 1, 'release': tag}
        if len(releases) < 100:
            # The first delivery needs a build, even before any release exists.
            return {'build': True, 'release': ''}
        page += 1


def reuse(tag, destination):
    if not re.fullmatch(r'cli-v0\.[1-9][0-9]*\.0', tag):
        raise ValueError('Invalid agent release tag.')
    with tempfile.TemporaryDirectory(prefix='orbit-agent-release-') as temporary:
        source = Path(temporary)
        names = ['manifest.json', 'SHA256SUMS', 'provenance.sigstore.json']
        names += [f'orbit-agent-{platform}' for platform in sorted(PLATFORMS)]
        args = ['gh', 'release', 'download', tag, '--repo', REPOSITORY, '--dir', temporary]
        for name in names:
            args += ['--pattern', name]
        subprocess.run(args, cwd=ROOT, check=True)
        for name in ['manifest.json', 'SHA256SUMS']:
            subprocess.run(['gh', 'attestation', 'verify', str(source / name), '--repo', REPOSITORY,
                            '--bundle', str(source / 'provenance.sigstore.json'),
                            '--signer-workflow', WORKFLOW, '--source-ref', 'refs/heads/main'], check=True)
        # The attested manifest and every binary digest are checked before upload.
        combine(destination, [source])
        print(f'Reused {tag}: {(destination / "manifest.json").read_text()}')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest='command', required=True)
    selection = commands.add_parser('select')
    selection.add_argument('--github-output', type=Path)
    delivery = commands.add_parser('reuse')
    delivery.add_argument('--release', required=True)
    delivery.add_argument('--destination', required=True, type=Path)
    args = parser.parse_args()
    if args.command == 'reuse':
        reuse(args.release, args.destination)
    else:
        result = select()
        print(json.dumps(result))
        if args.github_output:
            with args.github_output.open('a') as output:
                for name, value in result.items():
                    output.write(f'{name}={json.dumps(value) if isinstance(value, bool) else value}\n')


if __name__ == '__main__':
    main()
