# Copy to .env.e2e for local E2E settings. Composer E2E scripts source this
# file before setting their lane-specific defaults.
#
# Do not point E2E at standing live nodes.

ORBIT_E2E_LANES=docker,incus

ORBIT_E2E_DOCKER_HOSTS=sidecar1,sidecar2
ORBIT_E2E_DOCKER_HOST_SLOTS=sidecar1:4,sidecar2:4
ORBIT_E2E_DOCKER_IMAGE_BUILD_HOSTS=beast
ORBIT_E2E_DOCKER_TOPOLOGY_MODE=dns-alias
ORBIT_E2E_DOCKER_MAX_CONTAINERS_PER_HOST=40
ORBIT_E2E_PARALLEL_PROCESSES=8

ORBIT_E2E_PROVIDER=incus
ORBIT_E2E_PROVIDERS=incus
ORBIT_E2E_INCUS_IMAGE_BUILD_HOST=beast
ORBIT_E2E_INCUS_HOSTS=beast
# Provisioning lease pool only. Prepared-topology feature parallelism is
# controlled by ORBIT_E2E_INCUS_PARALLEL_PROCESSES and
# ORBIT_E2E_INCUS_MAX_VMS_PER_HOST.
ORBIT_E2E_INCUS_HOST_SLOTS=beast:1
ORBIT_E2E_INCUS_STORAGE_POOL=orbit-e2e
ORBIT_E2E_INCUS_MAX_VMS_PER_HOST=12
ORBIT_E2E_INCUS_PARALLEL_PROCESSES=3
# Provisioning is serialized by default because beast:1 forces a single lease;
# raising this without bumping `INCUS_HOST_SLOTS` measured slower (live test
# 2026-05-19: PROVISION=2 + beast:1 was 1752s vs 1648s baseline).
ORBIT_E2E_PROVISION_PARALLEL_PROCESSES=1
ORBIT_E2E_TOPOLOGY_CPUS=1

ORBIT_E2E_EXCLUSIVE_HOSTS=beast

# Hetzner is opt-in only. Keep these commented unless a run should create paid
# resources.
# ORBIT_E2E_HCLOUD_RESOURCE_SLOTS=nbg1/cx23/ubuntu-24.04:1
# ORBIT_E2E_HCLOUD_LOCATION_SLOTS=nbg1:1

ORBIT_E2E_SLOT_WAIT_SECONDS=900
ORBIT_E2E_SLOT_STALE_SECONDS=7200
