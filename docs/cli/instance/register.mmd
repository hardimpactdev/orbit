sequenceDiagram
  %% status: reviewed
  %% command: instance:register
  %% kind: instance.register
  autonumber
  %% lane CLI icon=terminal pill=caller tone=gray
  %% lane GW icon=gateway pill=intent tone=blue
  %% lane A icon=server pill=observer tone=amber
  %% lane SW icon=workflow pill=executes tone=green
  %% lane N icon=server pill=target tone=amber
  participant CLI as CLI / MCP
  participant GW as Gateway
  participant A as Node agent
  participant SW as Swamp
  participant N as Target Node
  loop on change
    A->>GW: Report checkout facts
  end
  CLI->>GW: instance:register<br/>--project=7
  Note over GW: Check against the facts<br/>path · origin · layout
  alt facts match
    Note over GW: Record the Instance<br/>branch · commit · application
    alt record-only
      GW-->>CLI: 201 Instance active
    else Node work needed
      GW->>SW: Start run, full intent<br/>operation-instance-register
      GW-->>CLI: 202 Task accepted
      SW->>N: Protect the .env<br/>@swamp/ssh exec
      %%> Only when an existing .env is publicly readable.
      opt --setup
        SW->>N: Run Project setup steps<br/>@swamp/ssh exec
        SW->>N: Create, start Processes<br/>child create · start
      end
      opt --domain
        SW->>N: Create the Route<br/>child route-create
        %%> A completed registration needs --setup to check its Processes before marking the runtime awake.
      end
      alt every step passes
        SW-->>GW: Run succeeded
        Note over GW: Record the result<br/>Instance active · URL
      else a step fails
        SW--xGW: Run failed<br/>failed step · error code
        Note over GW: Keep the Instance reserved<br/>rerun repairs it
      end
    end
  else facts do not match
    GW--xCLI: Refuse registration
  end
