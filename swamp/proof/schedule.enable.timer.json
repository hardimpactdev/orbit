{
  "kind": "schedule.enable",
  "workflow": "operation-schedule-control",
  "topology": "minimal",
  "clean": true,
  "budget_seconds": 180,
  "queue_timeout_seconds": 30,
  "before_gateway": [
    [
      "sh",
      "-c",
      "cd apps/gateway && php ../../swamp/proof/schedule.enable/prepare-timer.php \"$1\" \"$2\"",
      "sh",
      "${node.target}",
      "${proof.run}"
    ]
  ],
  "prepare": [
    {
      "method": "GET",
      "path": "operations/${fixture.create}",
      "body": {}
    }
  ],
  "after_prepare": [
    [
      "sh",
      "-c",
      "cd apps/gateway && php ../../swamp/proof/schedule.enable/admit-timer.php \"$1\"",
      "sh",
      "${fixture.copy}"
    ]
  ],
  "request": {
    "method": "GET",
    "path": "operations/${fixture.enable}",
    "body": {}
  },
  "expect": {
    "status": "succeeded"
  },
  "phases": [
    {
      "name": "timer",
      "job": "schedule",
      "step": "timer",
      "budget_seconds": 30
    },
    {
      "name": "check",
      "job": "schedule",
      "step": "check_timer",
      "budget_seconds": 30
    },
    {
      "name": "end",
      "job": "schedule",
      "step": "Check the timer",
      "budget_seconds": 10
    }
  ],
  "parity": "swamp/proof/schedule.enable/parity-timer.py"
}
