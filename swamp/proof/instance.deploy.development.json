{
  "kind": "instance.deploy",
  "workflow": "operation-instance-deploy-direct",
  "topology": "minimal",
  "clean": true,
  "budget_seconds": 300,
  "queue_timeout_seconds": 30,
  "prepare": [
    {
      "method": "POST",
      "path": "projects",
      "operation": false,
      "bind": "project",
      "body": {
        "slug": "proof-dev-deploy",
        "name": "Proof dev deploy",
        "type": "node-package",
        "root": ".",
        "repository_url": "https://github.com/octocat/Spoon-Knife.git",
        "default_branch": "main"
      }
    },
    {
      "method": "POST",
      "path": "projects/${project.id}/dev-deploy-steps",
      "operation": false,
      "body": {
        "name": "marker",
        "command": "printf x >> .git/orbit-proof-deploy; printf 'proof-private-%s-output' deploy",
        "timeout_seconds": 10,
        "required": true
      }
    },
    {
      "method": "POST",
      "path": "projects/${project.id}/dev-deploy-steps",
      "operation": false,
      "body": {
        "name": "warm",
        "command": "printf 'proof-private-%s-output' deploy; exit 3",
        "timeout_seconds": 10,
        "required": false
      }
    },
    {
      "method": "POST",
      "path": "instances",
      "bind": "instance",
      "body": {
        "project_id": "${project.id}",
        "node_id": "${node.target}",
        "name": "default"
      }
    }
  ],
  "request": {
    "method": "POST",
    "path": "instances/${instance.id}/deploy"
  },
  "expect": {
    "status": "succeeded"
  },
  "phases": [
    {
      "name": "Fetch the branch",
      "job": "development-source",
      "step": "Fetch the branch",
      "budget_seconds": 120
    },
    {
      "name": "Check out the commit",
      "job": "development-checkout",
      "step": "Check out the commit",
      "budget_seconds": 60
    },
    {
      "name": "Check the checkout",
      "job": "deploy",
      "step": "Check the checkout",
      "budget_seconds": 60
    }
  ],
  "parity": "swamp/proof/instance.deploy.development/parity.py"
}
