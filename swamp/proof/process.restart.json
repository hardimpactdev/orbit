{
  "kind": "process.restart",
  "workflow": "operation-process-control",
  "topology": "minimal",
  "budget_seconds": 120,
  "queue_timeout_seconds": 30,
  "prepare": [
    {
      "method": "POST",
      "path": "processes",
      "bind": "process",
      "body": {
        "target_type": "node",
        "target_id": "${node.target}",
        "name": "restart-${proof.run}",
        "runtime": "systemd",
        "command": [
          "/usr/bin/sleep",
          "infinity"
        ],
        "start": true
      }
    }
  ],
  "before_target": [
    [
      "sh",
      "-c",
      "systemctl show --property=MainPID --value orbit-process-${process.id}-restart-${proof.run}.service > /tmp/proof-main-pid-${proof.run}"
    ]
  ],
  "request": {
    "method": "POST",
    "path": "processes/${process.id}/restart"
  },
  "expect": {
    "status": "succeeded"
  },
  "phases": [
    {
      "name": "Set boot policy",
      "job": "runtime",
      "step": "Set boot policy",
      "budget_seconds": 20
    },
    {
      "name": "Control the Process",
      "job": "runtime",
      "step": "Control the Process",
      "budget_seconds": 20
    },
    {
      "name": "Verify the state",
      "job": "runtime",
      "step": "Verify the state",
      "budget_seconds": 20
    }
  ],
  "parity": [
    "swamp/proof/process/parity.py",
    "running"
  ]
}
