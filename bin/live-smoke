#!/usr/bin/env bash

set -euo pipefail

cd "$(dirname "$0")/.."

CONTROL_SSH="${ORBIT_LIVE_CONTROL_SSH:-mini}"
CONTROL_PATH="${ORBIT_LIVE_CONTROL_PATH:-~/orbit}"

case "${1:---control}" in
    --local)
        php artisan test --compact
        ;;
    --control)
        php artisan test --compact
        ssh "$CONTROL_SSH" "cd $CONTROL_PATH && php artisan update:all && php artisan test --compact && php artisan node:list"
        ;;
    -h|--help)
        cat <<'HELP'
usage: bin/live-smoke [--local | --control]

Modes:
  --local    Run the local test suite.
  --control  Run local tests, then ask the standing control node to run the
             idempotent live smoke path: update:all, control-side tests,
             and node:list.

Environment:
  ORBIT_LIVE_CONTROL_SSH   SSH target for the control node. Defaults to "mini".
  ORBIT_LIVE_CONTROL_PATH  Orbit checkout path on the control node. Defaults to "~/orbit".
HELP
        ;;
    *)
        echo "error: unknown mode '$1'" >&2
        echo "usage: bin/live-smoke [--local | --control]" >&2
        exit 2
        ;;
esac
