#!/usr/bin/env bash

set -Eeuo pipefail

ROLE="control"
TARGET_DIR="${ORBIT_INSTALL_PATH:-$HOME/orbit}"
REPO_URL="${ORBIT_REPO_URL:-https://github.com/hardimpactdev/orbit.git}"
BRANCH="${ORBIT_BRANCH:-main}"
PHP_VERSION="${ORBIT_PHP_VERSION:-8.5}"
SOURCE_ARCHIVE=""
LINK_PATH="${ORBIT_BIN_PATH:-/usr/local/bin/orbit}"
USE_SUDO=1
VERBOSE=0
LOG_FILE="${ORBIT_INSTALL_LOG:-}"
CURRENT_STEP=""

usage() {
    cat <<'HELP'
usage: bin/install-orbit [options]

Install the Orbit CLI and its PHP runtime prerequisites on the current host.

Options:
  --role=control|gateway|app   Host role being prepared. Defaults to "control".
  --path=PATH                  Orbit checkout path. Defaults to "$HOME/orbit".
  --repo=URL                   Git repository to clone when no source archive is provided.
  --branch=NAME                Git branch to clone or update. Defaults to "main".
  --php=8.4|8.5                PHP CLI version to install on Ubuntu.
                               Defaults to "8.5".
  --source-archive=PATH        Extract this Orbit source tarball instead of cloning.
  --bin=PATH                   Symlink path for the orbit executable.
                               Defaults to "/usr/local/bin/orbit".
  --no-sudo                    Run package and symlink commands without sudo.
  --verbose                    Stream underlying command output.
  -h, --help                   Show this help text.

The installer is intentionally local-host only. A new control node runs it
before invoking Orbit. First-gateway bootstrap may ship this same script and a
source archive to the remote gateway host, then run it there over SSH.
HELP
}

fail() {
    local code="$1"
    shift

    printf 'orbit-install: error [%s] %s\n' "$code" "$*" >&2

    if [ -n "$LOG_FILE" ] && [ -f "$LOG_FILE" ]; then
        printf 'orbit-install: log %s\n' "$LOG_FILE" >&2
    fi

    exit 1
}

quote() {
    printf '%q' "$1"
}

run() {
    ensure_log_file

    {
        printf '+'
        printf ' %q' "$@"
        printf '\n'
    } >>"$LOG_FILE"

    if [ "$VERBOSE" = "1" ]; then
        "$@" 2>&1 | tee -a "$LOG_FILE"

        return "${PIPESTATUS[0]}"
    fi

    "$@" >>"$LOG_FILE" 2>&1
}

sudo_run() {
    if [ "$USE_SUDO" = "1" ] && [ "$(id -u)" -ne 0 ]; then
        run sudo "$@"
        return
    fi

    run "$@"
}

sudo_shell() {
    if [ "$USE_SUDO" = "1" ] && [ "$(id -u)" -ne 0 ]; then
        run sudo bash -lc "$1"
        return
    fi

    run bash -lc "$1"
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || fail validation_failed "required command missing: $1"
}

ensure_log_file() {
    local tmp_dir
    local tmp_file

    if [ -n "$LOG_FILE" ]; then
        return
    fi

    tmp_dir="${TMPDIR:-/tmp}"
    tmp_dir="${tmp_dir%/}"
    tmp_file="$(mktemp "$tmp_dir/orbit-install.XXXXXX")"
    LOG_FILE="${tmp_file}.log"
    mv "$tmp_file" "$LOG_FILE"
}

render_plan() {
    printf '  ┌ Orbit install\n'
    printf '  │\n'
    printf '  ○  Validate installer input\n'
    printf '  │\n'
    printf '  ○  Install platform prerequisites\n'
    printf '  │\n'
    printf '  ○  Install Orbit source\n'
    printf '  │\n'
    printf '  ○  Bootstrap Laravel runtime\n'
    printf '  │\n'
    printf '  ○  Link orbit executable\n'
    printf '  │\n'
    printf '  ○  Verify Orbit\n'
    printf '  │\n'
    printf '  └  Log: %s\n\n' "$LOG_FILE"
}

start_step() {
    CURRENT_STEP="$1"
    printf '  ◉  %s\n' "$CURRENT_STEP"
}

complete_step() {
    printf '  ●  %s\n' "$CURRENT_STEP"
    CURRENT_STEP=""
}

fail_step() {
    local status="$1"

    if [ -n "$CURRENT_STEP" ]; then
        printf '  ●  %s failed\n' "$CURRENT_STEP" >&2
    fi

    if [ -n "$LOG_FILE" ] && [ -f "$LOG_FILE" ]; then
        printf 'orbit-install: log %s\n' "$LOG_FILE" >&2
        tail -n 20 "$LOG_FILE" >&2 || true
    fi

    exit "$status"
}

finish_tree() {
    printf '\n  └  Orbit installed for %s at %s\n' "$ROLE" "$TARGET_DIR"
}

parse_args() {
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --role=*)
                ROLE="${1#*=}"
                ;;
            --path=*)
                TARGET_DIR="${1#*=}"
                ;;
            --repo=*)
                REPO_URL="${1#*=}"
                ;;
            --branch=*)
                BRANCH="${1#*=}"
                ;;
            --php=*)
                PHP_VERSION="${1#*=}"
                ;;
            --source-archive=*)
                SOURCE_ARCHIVE="${1#*=}"
                ;;
            --bin=*)
                LINK_PATH="${1#*=}"
                ;;
            --no-sudo)
                USE_SUDO=0
                ;;
            --verbose)
                VERBOSE=1
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            *)
                fail validation_failed "unknown option: $1"
                ;;
        esac

        shift
    done
}

validate_args() {
    case "$ROLE" in
        control|gateway|app)
            ;;
        *)
            fail validation_failed "--role must be one of: control, gateway, app"
            ;;
    esac

    [ -n "$TARGET_DIR" ] || fail validation_failed "--path is required"
    [ -n "$LINK_PATH" ] || fail validation_failed "--bin is required"

    case "$PHP_VERSION" in
        8.4|8.5)
            ;;
        *)
            fail validation_failed "--php must be one of: 8.4, 8.5"
            ;;
    esac
}

ubuntu_php_package_available() {
    apt-cache show "php${PHP_VERSION}-cli" >/dev/null 2>&1
}

install_ondrej_php_ppa() {
    local codename
    local ppa_source

    codename="$(. /etc/os-release && printf '%s' "$VERSION_CODENAME")"
    ppa_source="deb [signed-by=/etc/apt/keyrings/ondrej-php.gpg] https://ppa.launchpadcontent.net/ondrej/php/ubuntu ${codename} main"

    sudo_run install -d -m 0755 /etc/apt/keyrings
    sudo_shell "curl -fsSL 'https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x14AA40EC0831756756D7F66C4F4EA0AAE5267A6C' | gpg --batch --yes --dearmor -o /etc/apt/keyrings/ondrej-php.gpg"
    sudo_shell "printf '%s\n' $(quote "$ppa_source") > /etc/apt/sources.list.d/ondrej-php.list"
    sudo_run chmod 0644 /etc/apt/keyrings/ondrej-php.gpg /etc/apt/sources.list.d/ondrej-php.list
}

install_ubuntu_prerequisites() {
    sudo_run apt-get update
    sudo_run env DEBIAN_FRONTEND=noninteractive apt-get install -y \
        ca-certificates \
        curl \
        git \
        gnupg \
        tar \
        unzip

    if ! ubuntu_php_package_available; then
        install_ondrej_php_ppa
        sudo_run apt-get update
    fi

    sudo_run env DEBIAN_FRONTEND=noninteractive apt-get install -y \
        ca-certificates \
        composer \
        curl \
        git \
        "php${PHP_VERSION}-bcmath" \
        "php${PHP_VERSION}-cli" \
        "php${PHP_VERSION}-curl" \
        "php${PHP_VERSION}-mbstring" \
        "php${PHP_VERSION}-sqlite3" \
        "php${PHP_VERSION}-xml" \
        "php${PHP_VERSION}-zip" \
        tar \
        unzip
    sudo_run update-alternatives --set php "/usr/bin/php${PHP_VERSION}"
}

install_macos_prerequisites() {
    require_command brew

    run brew update
    run brew install php composer git
}

install_prerequisites() {
    case "$(uname -s)" in
        Linux)
            if [ -r /etc/os-release ] && grep -q '^ID=ubuntu$' /etc/os-release; then
                install_ubuntu_prerequisites
                return
            fi

            fail node.unsupported_platform "only Ubuntu Linux is supported for Orbit host installation"
            ;;
        Darwin)
            install_macos_prerequisites
            ;;
        *)
            fail node.unsupported_platform "unsupported operating system: $(uname -s)"
            ;;
    esac
}

install_source() {
    if [ -n "$SOURCE_ARCHIVE" ]; then
        [ -f "$SOURCE_ARCHIVE" ] || fail validation_failed "source archive not found: $SOURCE_ARCHIVE"

        if [ -e "$TARGET_DIR" ] && [ ! -f "$TARGET_DIR/artisan" ]; then
            fail validation_failed "$TARGET_DIR exists and does not look like an Orbit checkout"
        fi

        run mkdir -p "$TARGET_DIR"
        run tar -xzf "$SOURCE_ARCHIVE" -C "$TARGET_DIR"

        return
    fi

    require_command git

    if [ -d "$TARGET_DIR/.git" ]; then
        run git -C "$TARGET_DIR" fetch --prune
        run git -C "$TARGET_DIR" checkout "$BRANCH"
        run git -C "$TARGET_DIR" pull --ff-only

        return
    fi

    if [ -e "$TARGET_DIR" ]; then
        fail validation_failed "$TARGET_DIR exists but is not a git checkout"
    fi

    run git clone --branch "$BRANCH" "$REPO_URL" "$TARGET_DIR"
}

bootstrap_laravel() {
    local target

    target="$(quote "$TARGET_DIR")"

    run bash -lc "cd $target && composer install --no-dev --no-interaction --prefer-dist --optimize-autoloader"

    if [ ! -f "$TARGET_DIR/.env" ]; then
        run cp "$TARGET_DIR/.env.example" "$TARGET_DIR/.env"
    fi

    run mkdir -p "$TARGET_DIR/database"

    if [ ! -f "$TARGET_DIR/database/database.sqlite" ]; then
        run touch "$TARGET_DIR/database/database.sqlite"
    fi

    run bash -lc "cd $target && grep -q '^APP_KEY=base64:' .env || php artisan key:generate --force --no-interaction"
    run bash -lc "cd $target && php artisan migrate --force --no-interaction"
}

link_orbit() {
    if [ -e "$LINK_PATH" ] && [ ! -L "$LINK_PATH" ]; then
        fail validation_failed "$LINK_PATH exists and is not a symlink"
    fi

    sudo_run ln -sf "$TARGET_DIR/artisan" "$LINK_PATH"
}

verify_install() {
    local target

    target="$(quote "$TARGET_DIR")"

    run bash -lc "cd $target && php artisan --version"
}

main() {
    parse_args "$@"

    ensure_log_file
    trap 'fail_step "$?"' ERR

    render_plan

    start_step "Validate installer input"
    validate_args
    complete_step

    start_step "Install platform prerequisites"
    install_prerequisites
    complete_step

    start_step "Install Orbit source"
    install_source
    complete_step

    start_step "Bootstrap Laravel runtime"
    bootstrap_laravel
    complete_step

    start_step "Link orbit executable"
    link_orbit
    complete_step

    start_step "Verify Orbit"
    verify_install
    complete_step

    finish_tree
}

main "$@"
