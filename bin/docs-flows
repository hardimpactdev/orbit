#!/usr/bin/env python3
"""Write docs/flows-data.js: the flow charts the CLI pages place, for docs/flow.js.

A page places a chart with `<div className="flow-at" data-chart="<family>/<name>"></div>`, which names
docs/cli/<family>/<name>.mmd. Charts that no page places are left out. bin/check-flows checks the placements.
"""
import json
import re
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
PLACEMENT = re.compile(r'<div className="flow-at" data-chart="([a-z0-9-]+/[a-z0-9-]+)"></div>')


def placed(cli):
    """Each placed chart's name with its kind and source, in page order."""
    charts = {}
    for page in sorted(cli.glob('*/*.mdx')):
        for name in PLACEMENT.findall(page.read_text()):
            src = (cli / f'{name}.mmd').read_text()
            charts[name] = {'kind': re.search(r'^\s*%% kind:\s*(\S+)', src, re.M).group(1), 'src': src}
    return charts


if __name__ == '__main__':
    charts = placed(ROOT / 'docs/cli')
    (ROOT / 'docs/flows-data.js').write_text(
        '// Built by bin/docs-flows from the charts that docs/cli pages place. Do not edit.\n'
        f'window.orbitFlows = {json.dumps({"charts": charts}, indent=1, ensure_ascii=False)}\n'
    )
    print(f'docs/flows-data.js: {len(charts)} charts placed on docs/cli pages')
