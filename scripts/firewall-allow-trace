#!/usr/bin/env bash
# SPIKE, throwaway. Run by `orbit task:script` from the repository root of a task VM. Times three `orbit firewall:allow` calls against the nested
# Gateway (a new rule, a repeat that only skips, and a partial apply that adds the UDP line) and prints each Operation's steps with their timestamps,
# so the seconds of one call can be split into the CLI, the admission, the Swamp dispatch, each step, the projection of the result and the CLI's wait.
#
#   scripts/firewall-allow-trace [PORT]     PORT is the first test port (default 47500); the calls use PORT, PORT+1 and PORT+2
#
# It changes the nested fleet by the firewall rules it creates and one UFW line on app-dev that it adds by hand, the starting state of the
# partial-apply case (a TCP line without a record). Delete it after the spike.
set -uo pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd)
PORT=${1:-47500}
ORBIT=(env PATH=/usr/local/bin:/usr/bin:/bin HOME=/home/orbit ORBIT_HOME=/home/orbit/.orbit php "$ROOT/apps/cli/orbit")
orbit() { "${ORBIT[@]}" "$@" </dev/null; }
now() { date +%s.%N; }
since() { awk -v a="$1" -v b="$(now)" 'BEGIN { printf "%.2f", b - a }'; }

say() { printf '%s\n' "$*"; }

api() { curl -sS --max-time 5 --cacert "$HOME/.orbit/nested-ca.pem" -H 'Accept: application/json' "https://10.45.0.1/api/v1/$1"; }
epoch() { date -u -d "$1" +%s.%N; }
secs() { awk -v a="$1" -v b="$2" 'BEGIN { printf "%.2f", b - a }'; }

# One call: seconds on the wall, the Operation it started step by step, and the gaps between the stages. A watcher reads the Operation from the
# nested Gateway every 50 ms, so the moment the Gateway shows it, and the moment it shows it ended, are known; the steps give the Swamp times.
traced() {
  local label=$1; shift
  local start out rc id last next t0 t1 mark
  last=$(api operations | jq -r '(.data // []) | map(.id) | max // 0')
  next=$((last + 1))
  mark=$(mktemp)
  (
    prev=""
    while :; do
      st=$(api "operations/$next" | jq -r '(.data // .) | .status // empty' 2>/dev/null)
      if [ -n "$st" ] && [ "$st" != "$prev" ]; then printf '%s %s\n' "$(date +%s.%N)" "$st"; prev=$st; fi
      case "$st" in succeeded | failed | cancelled) break ;; esac
      sleep 0.05
    done
  ) >"$mark" &
  local watcher=$!
  t0=$(now)
  out=$(orbit "$@" --json 2>/dev/null); rc=$?
  t1=$(now)
  sleep 0.3; kill "$watcher" 2>/dev/null; wait "$watcher" 2>/dev/null
  say "== $label: rc $rc, $(secs "$t0" "$t1") s on the wall"
  id=$(printf '%s' "$out" | jq -r '(.data // .) | (.id // .operation.id // empty)' 2>/dev/null)
  if [ -z "$id" ]; then say "no operation id in the answer: $(printf '%s' "$out" | head -c 200)"; rm -f "$mark"; return; fi
  [ "$id" = "$next" ] || say "the watcher followed op $next, not op $id: the stages below are not valid"
  local steps first_start last_end seen_first seen_end
  steps=$(orbit operation:show "$id" --json 2>/dev/null)
  printf '%s' "$steps" | jq -r '
    (.data // .) as $o
    | "op \($o.id) \($o.kind) \($o.status) created \($o.created_at) started \($o.started_at) finished \($o.finished_at)",
      ($o.steps[]? | select(.status != "skipped") | "  \(.job // "-") | \(.name) | \(.status) | \(.started_at // "-") | \(.finished_at // "-")")' | cut -c1-170
  first_start=$(printf '%s' "$steps" | jq -r '(.data // .) | [.steps[]? | select(.started_at != null) | .started_at] | sort | first // empty')
  last_end=$(printf '%s' "$steps" | jq -r '(.data // .) | [.steps[]? | select(.finished_at != null) | .finished_at] | sort | last // empty')
  seen_first=$(awk 'NR == 1 { print $1 }' "$mark")
  seen_end=$(awk '$2 == "succeeded" || $2 == "failed" || $2 == "cancelled" { print $1; exit }' "$mark")
  if [ -n "$first_start" ] && [ -n "$last_end" ] && [ -n "$seen_first" ] && [ -n "$seen_end" ]; then
    say "stages: CLI start to the Gateway showing op $id: $(secs "$t0" "$seen_first") s | to the first Swamp step: $(secs "$seen_first" "$(epoch "$first_start")") s | steps: $(secs "$(epoch "$first_start")" "$(epoch "$last_end")") s | last step to the Gateway showing it ended: $(secs "$(epoch "$last_end")" "$seen_end") s | to the CLI returning: $(secs "$seen_end" "$t1") s"
  else
    say "stages: not computed (first step '$first_start', last '$last_end', seen '$seen_first' '$seen_end')"
  fi
  rm -f "$mark"
}

say "== VM $(hostname) commit $(git -C "$ROOT" rev-parse --short HEAD)"
start=$(now); "${ORBIT[@]}" --version </dev/null >/dev/null 2>&1; say "orbit --version (CLI start-up): $(since "$start") s"

start=$(now); NODES=$(orbit node:list --json 2>/dev/null); say "node:list (one read call): $(since "$start") s"
NODE=$(printf '%s' "$NODES" | jq -r '(.data // .) | (.nodes // .) | map(select(.name=="app-dev")) | .[0].id')
APPDEV_IP=$(incus exec nested-app-dev -- sh -c "ip -4 -o addr show scope global | awk '\$2!=\"orbit\" && \$2!=\"docker0\" {print \$4}' | head -1 | cut -d/ -f1")
SRC=$(incus exec nested-gateway -- sh -c "ip -4 route get $APPDEV_IP | grep -o 'src [0-9.]*' | cut -d' ' -f2")
say "app-dev node $NODE at $APPDEV_IP, gateway source $SRC"
[ "$NODE" -gt 0 ] 2>/dev/null || { say "no app-dev node in node:list"; exit 1; }

start=$(now); orbit firewall:list --node="$NODE" --json >/dev/null 2>&1; say "firewall:list (one read call): $(since "$start") s"

traced "new rule, tcp" firewall:allow "$PORT" --node="$NODE" --from="$SRC" --protocol=tcp
traced "repeat (skips)" firewall:allow "$PORT" --node="$NODE" --from="$SRC" --protocol=tcp
traced "second port, tcp" firewall:allow "$((PORT + 1))" --node="$NODE" --from="$SRC" --protocol=tcp
# The starting state of the partial case: only the TCP line exists (a record would make the TCP+UDP rule an overlap).
incus exec nested-app-dev -- ufw insert 1 allow proto tcp from "$SRC" to any port "$((PORT + 2))" comment proof:existing >/dev/null 2>&1
traced "partial apply (adds udp)" firewall:allow "$((PORT + 2))" --node="$NODE" --from="$SRC"

say "== Swamp workers on the nested Gateway"
incus exec nested-gateway -- sh -c "systemctl list-units 'orbit-swamp*' 'swamp*' --no-legend 2>/dev/null | cut -c1-110; nproc" 2>&1 | head -8
