{
  "kind": "fleet.recipe",
  "workflow": "operation-fleet-recipe-direct",
  "topology": "minimal",
  "budget_seconds": 1800,
  "queue_timeout_seconds": 60,
  "request": {
    "method": "POST",
    "path": "fleet/nodes/${node.target}/recipe",
    "body": {
      "automatic": true
    }
  },
  "expect": {
    "status": "succeeded"
  },
  "phases": [
    {
      "name": "Signed packages",
      "job": "packages",
      "step": "packages",
      "budget_seconds": 1800
    },
    {
      "name": "Observer files",
      "job": "observer",
      "step": "Check the footprint",
      "budget_seconds": 1800
    },
    {
      "name": "PHP runtime",
      "job": "footprint",
      "step": "Configure PHP-FPM-8.5",
      "budget_seconds": 1800
    },
    {
      "name": "Delivery proof",
      "job": "delivery",
      "step": "delivery",
      "budget_seconds": 1800
    }
  ],
  "parity": "swamp/proof/fleet.recipe/parity.py",
  "before_gateway": [
    [
      "runuser",
      "-u",
      "orbit",
      "--",
      "php",
      "swamp/proof/fleet.recipe/prepare.php"
    ]
  ]
}
