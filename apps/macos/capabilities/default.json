{
  "identifier": "default",
  "description": "Orbit menu bar, autostart, updater, and browser opener permissions.",
  "windows": [],
  "permissions": [
    "core:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "updater:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://app.orbit" }]
    }
  ]
}
