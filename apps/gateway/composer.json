{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "hardimpactdev/orbit-gateway",
    "type": "project",
    "description": "Orbit gateway Laravel control plane.",
    "keywords": [
        "laravel",
        "orbit",
        "gateway",
        "control-plane"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "hardimpactdev/librarian": "^0.0.2",
        "hardimpactdev/orbit-core": "dev-main",
        "hardimpactdev/orbit-sdk-laravel": "dev-main",
        "laravel/framework": "^13.20",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.0",
        "spatie/laravel-activitylog": "^4.0",
        "spatie/laravel-data": "^4.0"
    },
    "require-dev": {
        "carthage-software/mago": "^1.40.1",
        "dedoc/scramble": "^0.13.31",
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^2.4",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpunit/phpunit": "^13.2.4",
        "rector/rector": "^2.3",
        "spatie/guidelines-skills": "dev-main"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../packages/core",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../../packages/sdk",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\E2E\\Support\\": "../e2e/app/E2E/Support/",
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Support/repository.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        },
        "exclude-from-classmap": [
            "/tests/"
        ],
        "files": [
            "tests/Helpers/E2EEnvironment.php"
        ]
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "vp install --ignore-scripts",
            "vp run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "vp dlx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"vp run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "openapi:prepare": [
            "@php -r \"is_dir('../../.orbit/evidence') || mkdir('../../.orbit/evidence', 0777, true);\"",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --force --no-ansi"
        ],
        "openapi:export": [
            "Composer\\Config::disableProcessTimeout",
            "@openapi:prepare",
            "@php -d memory_limit=1G artisan scramble:export --no-ansi"
        ],
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan config:clear --ansi @no_additional_args",
            "@php -d memory_limit=512M vendor/pestphp/pest/bin/pest --exclude-group=e2e --exclude-group=slow --parallel --compact"
        ],
        "test:slow": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan config:clear --ansi @no_additional_args",
            "@php -d memory_limit=512M vendor/pestphp/pest/bin/pest --exclude-group=e2e --parallel --compact"
        ],
        "analyse": "vendor/bin/mago analyze app config database --reporting-format=medium",
        "format": "vendor/bin/mago format",
        "rector": "vendor/bin/rector process",
        "quality-check": [
            "Composer\\Config::disableProcessTimeout",
            "../../bin/quality-check.sh"
        ],
        "quality-check:fix": [
            "Composer\\Config::disableProcessTimeout",
            "../../bin/quality-check.sh --fix"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "../../bin/orbit-boost-update"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "mago:analyze": "vendor/bin/mago analyze app config database --reporting-format=medium",
        "mago:lint": "vendor/bin/mago lint --reporting-format=medium",
        "mago:format": "vendor/bin/mago format",
        "mago:format:check": "vendor/bin/mago format --check"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "rector/rector": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
