#!/usr/bin/env php
<?php

declare(strict_types=1);

define('LARAVEL_START', microtime(true));

fallbackToRootArtisanWhenCommandIsUnported($_SERVER['argv'] ?? []);

$autoload = __DIR__.'/vendor/autoload.php';

if (! file_exists($autoload)) {
    fwrite(STDERR, "Orbit CLI dependencies are not installed. Run composer install in apps/cli.\n");

    exit(1);
}

require $autoload;

$app = require_once __DIR__.'/bootstrap/app.php';

$kernel = $app->make(Illuminate\Contracts\Console\Kernel::class);

$status = $kernel->handle(
    $input = new Symfony\Component\Console\Input\ArgvInput,
    new Symfony\Component\Console\Output\ConsoleOutput,
);

$kernel->terminate($input, $status);

exit($status);

/**
 * @param  list<string>  $argv
 */
function fallbackToRootArtisanWhenCommandIsUnported(array $argv): void
{
    $command = commandNameFromArgv($argv);

    if ($command === null || isNativeCliCommand($command)) {
        return;
    }

    $artisan = dirname(__DIR__, 2).'/artisan';

    if (! is_file($artisan)) {
        return;
    }

    passthruCommand(PHP_BINARY, [$artisan, ...array_slice($argv, 1)]);
}

/**
 * @param  list<string>  $argv
 */
function commandNameFromArgv(array $argv): ?string
{
    foreach (array_slice($argv, 1) as $argument) {
        if ($argument === '--') {
            return null;
        }

        if ($argument === '' || str_starts_with($argument, '-')) {
            continue;
        }

        return $argument;
    }

    return null;
}

function isNativeCliCommand(string $command): bool
{
    return in_array($command, [
        '_complete',
        'completion',
        'gateway:status',
        'help',
        'internal:executor:verify',
        'internal:wg-easy:state',
        'internal:workspace-adapter:lookup',
        'list',
    ], true);
}

/**
 * @param  list<string>  $arguments
 */
function passthruCommand(string $binary, array $arguments): never
{
    $parts = [$binary, ...$arguments];
    $command = implode(' ', array_map('escapeshellarg', $parts));

    passthru($command, $status);

    exit($status);
}
