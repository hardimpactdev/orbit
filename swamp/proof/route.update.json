{
  "kind": "route.update",
  "workflow": "operation-route-update",
  "topology": "minimal",
  "budget_seconds": 1800,
  "queue_timeout_seconds": 30,
  "prepare": [
    {
      "method": "POST",
      "path": "projects",
      "operation": false,
      "bind": "project",
      "body": {
        "slug": "proof-update",
        "name": "Proof update",
        "type": "monorepo",
        "root": "public",
        "repository_url": "https://github.com/laravel/laravel.git",
        "default_branch": "13.x"
      }
    },
    {
      "method": "POST",
      "path": "instances",
      "bind": "instance",
      "body": {
        "project_id": "${project.id}",
        "node_id": "${node.target}",
        "name": "r-${proof.run}"
      }
    },
    {
      "method": "POST",
      "path": "routes",
      "bind": "route",
      "body": {
        "instance_id": "${instance.id}",
        "domain": "r-${proof.run}.proof.test"
      }
    }
  ],
  "request": {
    "method": "PATCH",
    "path": "routes/${route.id}",
    "body": {
      "domain": "u-${proof.run}.proof.test"
    }
  },
  "expect": {
    "status": "succeeded"
  },
  "phases": [
    {
      "name": "sign",
      "job": "update",
      "step": "Sign the CSR-0",
      "budget_seconds": 60
    },
    {
      "name": "probe",
      "job": "update",
      "step": "Probe the site over TLS-0",
      "budget_seconds": 30
    },
    {
      "name": "withdraw",
      "job": "update",
      "step": "Withdraw the old site-0",
      "budget_seconds": 120
    }
  ],
  "parity": "swamp/proof/route.update/parity.py"
}
