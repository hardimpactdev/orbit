{
  "kind": "instance.env_import",
  "workflow": "operation-instance-env-import",
  "topology": "minimal",
  "clean": true,
  "budget_seconds": 90,
  "queue_timeout_seconds": 30,
  "prepare": [
    {
      "method": "POST",
      "path": "projects",
      "operation": false,
      "bind": "project",
      "body": {
        "slug": "proof-env-import",
        "name": "Proof env import",
        "type": "node-package",
        "root": ".",
        "repository_url": "https://github.com/octocat/Spoon-Knife.git",
        "default_branch": "main"
      }
    },
    {
      "method": "POST",
      "path": "instances",
      "bind": "instance",
      "body": {
        "project_id": "${project.id}",
        "node_id": "${node.target}",
        "name": "i-${proof.run}"
      }
    },
    {
      "method": "PUT",
      "path": "instances/${instance.id}/environment/PROOF_SECRET",
      "operation": false,
      "body": {
        "value": "proof-private-${proof.run}"
      }
    },
    {
      "method": "POST",
      "path": "instances/${instance.id}/environment/sync"
    }
  ],
  "before_target": [
    [
      "sh",
      "-c",
      "f=$(find /home /srv -maxdepth 6 -path '*/i-${proof.run}/.env' 2>/dev/null | head -1); [ -n \"$f\" ] && printf 'PROOF_IMPORTED=\"imported-%s\"\\n' '${proof.run}' >> \"$f\""
    ]
  ],
  "request": {
    "method": "POST",
    "path": "instances/${instance.id}/environment/import",
    "body": {
      "replace": true
    }
  },
  "expect": {
    "status": "succeeded"
  },
  "phases": [
    {
      "name": "Stage .env for the copy",
      "job": "import",
      "step": "Stage .env for the copy",
      "budget_seconds": 15
    },
    {
      "name": "Copy .env to 209",
      "job": "import",
      "step": "Copy .env to 209",
      "budget_seconds": 15
    },
    {
      "name": "Remove the staged copy",
      "job": "import",
      "step": "Remove the staged copy",
      "budget_seconds": 15
    },
    {
      "name": "Read .env into the vault",
      "job": "import",
      "step": "Read .env into the vault",
      "budget_seconds": 15
    }
  ],
  "parity": "swamp/proof/instance.env_import/parity.py"
}
