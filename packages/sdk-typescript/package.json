{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "@orbit/sdk-typescript",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Generated TypeScript client for the public Orbit gateway API surface.",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "openapi/public-gateway-openapi.json",
        "README.md"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "generate": "npm run generate:openapi && npm run generate:types",
        "generate:openapi": "composer --working-dir=../../apps/gateway openapi:export && node scripts/filter-public-openapi.mjs",
        "generate:types": "openapi-typescript openapi/public-gateway-openapi.json -o src/generated/schema.ts",
        "test": "npm run typecheck",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "openapi-fetch": "^0.17.0"
    },
    "devDependencies": {
        "openapi-typescript": "^7.13.0",
        "typescript": "^5.9.3"
    }
}
