#!/usr/bin/env php
<?php

declare(strict_types=1);

require_once __DIR__.'/orbit-quality-subgates.php';
require_once __DIR__.'/orbit-loop-contract.php';
require_once __DIR__.'/orbit-loop-lint.php';
require_once __DIR__.'/orbit-feedback-events.php';
require_once __DIR__.'/orbit-feature-acceptance-contract.php';
require_once __DIR__.'/orbit-feature-proof-requirements.php';
require_once __DIR__.'/orbit-quality-gate-artifacts.php';
require_once __DIR__.'/orbit-session-archive-receipt.php';
require_once __DIR__.'/orbit-session-capture-health.php';
require_once __DIR__.'/orbit-command-classify.php';
require_once __DIR__.'/orbit-git-process.php';
require_once __DIR__.'/orbit-cleanup-checks.php';
require_once __DIR__.'/orbit-finalization-tmux-land.php';

const BLOCK_EXIT_CODE = 2;

const USAGE_EXIT_CODE = 64;

if (($argv[1] ?? null) === '--lint') {
    exit(run_lint($argv[2] ?? './.orbit/loop.md'));
}

$command = command_from_argv($argv) ?? extract_command((string) stream_get_contents(STDIN));

if ($command === null || $command === '') {
    exit(unclassifiable_exit('no command was provided to classify'));
}

$trimmedCommand = trim($command);
$patchLines = preg_split('/\R/', $trimmedCommand);
$patchLineCounts = is_array($patchLines) ? array_count_values($patchLines) : [];

if (
    is_array($patchLines)
    && count($patchLines) >= 3
    && $patchLines[0] === '*** Begin Patch'
    && $patchLines[array_key_last($patchLines)] === '*** End Patch'
    && ($patchLineCounts['*** Begin Patch'] ?? 0) === 1
    && ($patchLineCounts['*** End Patch'] ?? 0) === 1
    && preg_match('/^\*\*\* (?:Add|Update|Delete) File: .+$/m', $trimmedCommand) === 1
) {
    exit(unclassifiable_exit('patch payload is not an executable command'));
}

$e2eInvocation = e2e_manual_only_invocation($trimmedCommand);

if ($e2eInvocation !== null) {
    fwrite(STDERR, e2e_block_message($e2eInvocation, $trimmedCommand));

    exit(BLOCK_EXIT_CODE);
}

$action = classify_command($command);

if ($action === null) {
    exit(unclassifiable_exit(
        'could not classify command as a merge, worktree-remove, branch-delete, or tmux kill-session boundary: '
        .$command,
    ));
}

$root = git_root(getcwd());

if ($root === null || ! is_file($root.'/HARNESS.md') || ! is_file($root.'/AGENTS.md')) {
    exit(unclassifiable_exit('not inside an Orbit checkout (missing HARNESS.md or AGENTS.md at the git root)'));
}

$check = match ($action['type']) {
    'merge' => check_merge($root, $action['targets']),
    'worktree-remove' => check_worktree_remove($root, $action['path']),
    'branch-delete' => check_branch_delete($root, $action['branch']),
    'tmux-session-kill' => check_tmux_session_kill($action, $root, (string) getcwd()),
    'invalid' => block_result($action['subject'], $action['reason']),
};

foreach ($check['warnings'] as $warning) {
    fwrite(STDERR, "WARNING: {$warning}\n");
}

if ($check['ok']) {
    fwrite(STDOUT, 'FINALIZATION: PASS '.action_summary($action)."\n");
    exit(0);
}

fwrite(STDERR, 'FINALIZATION: BLOCKED '.$check['reason']."\n\n");
fwrite(STDERR, block_message($check['subject'], $check['reason']));

exit(BLOCK_EXIT_CODE);

/**
 * Silent exit 0 preserves the PreToolUse contract for unrelated commands.
 * Explicit wrapper invocations (ORBIT_FINALIZATION_EXPLICIT=1) fail loudly
 * with exit 64 instead of silently passing.
 */
function unclassifiable_exit(string $message): int
{
    if (getenv('ORBIT_FINALIZATION_EXPLICIT') !== '1') {
        return 0;
    }

    fwrite(STDERR, "orbit finalization gate: {$message}\n");

    return USAGE_EXIT_CODE;
}

/**
 * @param  array{type: 'merge', targets: list<string>}|array{type: 'worktree-remove', path: string}|array{type: 'branch-delete', branch: string}|array{type: 'tmux-session-kill', session: string, socket: null|array{flag: '-L'|'-S', value: string}}|array{type: 'invalid', subject: string, reason: string}  $action
 */
function action_summary(array $action): string
{
    return match ($action['type']) {
        'merge' => 'git merge '.($action['targets'] === [] ? '(missing)' : implode(' ', $action['targets'])),
        'worktree-remove' => "git worktree remove {$action['path']}",
        'branch-delete' => "git branch delete {$action['branch']}",
        'tmux-session-kill' => tmux_session_kill_subject($action),
        'invalid' => $action['subject'],
    };
}
