{
  "kind": "certificate.remove",
  "workflow": "operation-certificate-remove",
  "budget_seconds": 60,
  "queue_timeout_seconds": 600,
  "envelope": {
    "operation_id": "${proof.operation_id}",
    "node_id": "${proof.target.node_id}",
    "kind": "certificate.remove",
    "intent": {
      "leaf": {
        "node_id": "${proof.target.node_id}",
        "scope": "route-791327",
        "user": "${proof.target.user}",
        "agent_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "in_use": false
      },
      "control_node_id": 209,
      "connection": {
        "nodeHost": "${proof.target.host}",
        "nodeUser": "${proof.target.user}",
        "nodeIdentityFile": "${proof.control.identity_file}",
        "nodePort": "${proof.target.port}"
      },
      "host_keys": "${proof.target.host_keys}"
    },
    "execution_secrets": {}
  },
  "secrets": [],
  "target_setup": "certificate.remove/target-setup.sh",
  "expect": {
    "status": "failed",
    "outputs": {
      "job": "certificate",
      "step": "remove",
      "match": {
        "stdout": "{\"error_code\": \"certificate.account_invalid\"}\n"
      }
    }
  },
  "phases": [
    {
      "name": "assets",
      "job": "certificate",
      "step": "assets",
      "budget_seconds": 10
    },
    {
      "name": "prepare-assets",
      "job": "certificate",
      "step": "prepare-assets",
      "budget_seconds": 10
    },
    {
      "name": "copy-assets",
      "job": "certificate",
      "step": "copy-assets",
      "budget_seconds": 10
    },
    {
      "name": "reload-withdrawal",
      "job": "certificate",
      "step": "reload-withdrawal",
      "budget_seconds": 10
    },
    {
      "name": "remove",
      "job": "certificate",
      "step": "remove",
      "budget_seconds": 10
    }
  ],
  "parity": {
    "command": [
      "python3",
      "-I",
      "swamp/proof/certificate.remove/parity.py"
    ],
    "cases": [
      "noncanonical-nss-home-present",
      "certificate-scope-preserved",
      "unrelated-scope-preserved"
    ]
  }
}
