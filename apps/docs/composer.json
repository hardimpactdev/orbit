{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "hardimpactdev/orbit-docs",
    "type": "project",
    "description": "Orbit documentation app and linter.",
    "keywords": ["laravel", "orbit", "documentation", "librarian"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "hardimpactdev/librarian": "^0.0.2",
        "laravel/framework": "^13.20",
        "laravel/tinker": "^3.0"
    },
    "require-dev": {
        "carthage-software/mago": "^1.40.1",
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpunit/phpunit": "^13.2.4",
        "rector/rector": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Orbit\\Core\\": "../../packages/core/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/mago analyze app config database --reporting-format=medium",
        "format": "vendor/bin/mago format",
        "rector": "vendor/bin/rector process",
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "vp install --ignore-scripts",
            "vp run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "vp dlx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"vp run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php -d memory_limit=512M vendor/pestphp/pest/bin/pest --compact"
        ],
        "lint": [
            "@php artisan librarian:lint --format=agent"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "mago:analyze": "vendor/bin/mago analyze app config database --reporting-format=medium",
        "mago:lint": "vendor/bin/mago lint --reporting-format=medium",
        "mago:format": "vendor/bin/mago format",
        "mago:format:check": "vendor/bin/mago format --check"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "rector/rector": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
