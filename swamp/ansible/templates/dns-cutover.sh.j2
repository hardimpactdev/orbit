#!/bin/sh
{#
  The cutover of dnsmasq onto the VPN address, as one command that runs detached on the Node: it stops the old listener units, restarts
  dnsmasq, and checks that dnsmasq's main process holds every listen address. When one step fails it runs the recovery script of the snapshot
  itself and says so in the state file, so the Node comes back to the old listener even when the play that started it is gone (killed by the
  timeout of its Swamp step, or by a crash of the worker). The play only reads the state file afterwards and records it.
  The state file holds one line: `running PID`, then `ok`, `recovered REASON` or `failed REASON`. It is replaced atomically.
  Pure: it reads cutover_units (the old listener units that run, to stop), dns.listen, and the paths and numbers of the play (dns_cutover_state,
  dns_restore_script, dns_local_resolver, dns_port, dns_held_wait).
#}
# Generated by dns-publish. Do not edit.
state={{ dns_cutover_state | quote }}
note() { printf '%s\n' "$1" > "$state.tmp" && mv -f -- "$state.tmp" "$state"; }
note "running $$"
recover() {
  if sh {{ dns_restore_script | quote }}; then note "recovered $1"; else note "failed $1"; fi
  exit 1
}
{% if cutover_units | length > 0 %}
systemctl stop -- {{ cutover_units | map('quote') | join(' ') }} || recover listener_stop_failed
{% endif %}
systemctl restart {{ dns_service | default('dnsmasq') | quote }} || recover dnsmasq_start_failed
holds() {
  main=$(systemctl show --property=MainPID --value {{ dns_service | default('dnsmasq') | quote }})
  [ "${main:-0}" -gt 0 ] || return 1
  ss -H -ulpn src "$1:{{ dns_port }}" | grep -q "pid=$main,"
}
wait_held() {
  i=0
  while [ "$i" -lt {{ dns_held_wait }} ]; do
    holds "$1" && return 0
    i=$((i + 1))
    sleep 1
  done
  return 1
}
{% for address in dns.listen + ([dns_local_resolver] if dns_local_resolver is not none else []) %}
wait_held {{ address | quote }} || recover dnsmasq_not_listening
{% endfor %}
note ok
