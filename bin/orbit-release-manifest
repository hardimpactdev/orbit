#!/usr/bin/env php
<?php

declare(strict_types=1);

$options = getopt('', [
    'version:',
    'released-at::',
    'gateway-image:',
    'gateway-digest::',
    'repository::',
    'source::',
    'build-id::',
    'asset-base-url::',
    'output::',
    'cli-artifact:',
    'agent-artifact:',
    'desktop-artifact:',
    'desktop-signature:',
    'role-image:',
    'role-image-artifact:',
]);

try {
    $version = normalize_version(required_string($options, 'version'));
    $releasedAt = optional_released_at(optional_string($options, 'released-at', ''));
    $repository = optional_string($options, 'repository', 'hardimpactdev/orbit');
    $source = optional_string($options, 'source', 'github-release');
    $buildId = optional_string($options, 'build-id', '');
    $assetBaseUrl = optional_string($options, 'asset-base-url', '');
    assert_source($source, $buildId, $assetBaseUrl);
    $gatewayImage = gateway_image(
        image: required_string($options, 'gateway-image'),
        digest: optional_string($options, 'gateway-digest', ''),
    );
    $cliArtifacts = cli_artifacts(repeated_values($options, 'cli-artifact'), $repository, $version, $assetBaseUrl);
    $agentArtifacts = optional_artifacts(repeated_values($options, 'agent-artifact'), $repository, $version, $assetBaseUrl, 'agent');
    $desktopArtifacts = desktop_artifacts(
        repeated_values($options, 'desktop-artifact'),
        repeated_values($options, 'desktop-signature'),
        $repository,
        $version,
        $assetBaseUrl,
    );
    $roleImages = role_images(repeated_values($options, 'role-image'));
    $roleImageArtifacts = role_image_artifacts(
        repeated_values($options, 'role-image-artifact'),
        $repository,
        $version,
        $assetBaseUrl,
    );

    $manifest = [
        'schema_version' => 1,
        'version' => $version,
    ];

    if ($releasedAt !== null) {
        $manifest['released_at'] = $releasedAt;
    }

    if ($buildId !== '') {
        $manifest['build_id'] = $buildId;
    }

    $manifest += [
        'source' => $source,
        'images' => [
            'gateway' => $gatewayImage,
        ],
        'cli_artifacts' => $cliArtifacts,
        'role_images' => $roleImages,
    ];

    if ($agentArtifacts !== []) {
        $manifest['agent_artifacts'] = $agentArtifacts;
    }

    if ($desktopArtifacts !== []) {
        $manifest['desktop_artifacts'] = $desktopArtifacts;
    }

    if ($roleImageArtifacts !== []) {
        $manifest['role_image_artifacts'] = $roleImageArtifacts;
    }

    $json = json_encode($manifest, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES);

    if (! is_string($json)) {
        fail('Failed to encode release manifest JSON.');
    }

    $json .= "\n";
    $output = optional_string($options, 'output', '');

    if ($output !== '') {
        file_put_contents($output, $json);
    } else {
        echo $json;
    }
} catch (Throwable $exception) {
    fail($exception->getMessage());
}

/**
 * @param  array<string, mixed>  $options
 */
function required_string(array $options, string $key): string
{
    $value = $options[$key] ?? null;

    if (is_array($value)) {
        $value = end($value);
    }

    if (! is_string($value) || trim($value) === '') {
        fail("Missing required --{$key} option.");
    }

    return trim($value);
}

/**
 * @param  array<string, mixed>  $options
 */
function optional_string(array $options, string $key, string $default): string
{
    $value = $options[$key] ?? null;

    if (is_array($value)) {
        $value = end($value);
    }

    if (! is_string($value) || trim($value) === '') {
        return $default;
    }

    return trim($value);
}

/**
 * @param  array<string, mixed>  $options
 * @return list<string>
 */
function repeated_values(array $options, string $key): array
{
    $value = $options[$key] ?? [];

    if (is_string($value)) {
        return [$value];
    }

    if (! is_array($value)) {
        return [];
    }

    return array_values(array_filter($value, is_string(...)));
}

function normalize_version(string $version): string
{
    $version = ltrim(trim($version), 'v');

    if ($version === '') {
        fail('Release manifest version cannot be empty.');
    }

    return $version;
}

function optional_released_at(string $value): ?string
{
    if ($value === '') {
        return null;
    }

    try {
        $timestamp = new DateTimeImmutable($value);
    } catch (Throwable) {
        fail('Release manifest released-at must be a valid timestamp.');
    }

    return $timestamp->setTimezone(new DateTimeZone('UTC'))->format(DateTimeInterface::ATOM);
}

function assert_source(string $source, string $buildId, string $assetBaseUrl): void
{
    if (! in_array($source, ['github-release', 'topology-candidate'], true)) {
        fail("Release manifest source [{$source}] is not supported.");
    }

    if ($source !== 'topology-candidate') {
        return;
    }

    if ($buildId === '') {
        fail('Topology candidate release manifests require --build-id.');
    }

    if ($assetBaseUrl === '') {
        fail('Topology candidate release manifests require --asset-base-url.');
    }
}

function gateway_image(string $image, string $digest): string
{
    $image = trim($image);

    if ($image === '') {
        fail('Release manifest gateway image cannot be empty.');
    }

    if (str_contains($image, '@sha256:')) {
        assert_digest(substr($image, strpos($image, '@') + 1), 'gateway image digest');

        return $image;
    }

    if ($digest === '') {
        fail('Release manifest gateway digest is required when --gateway-image is not already digest pinned.');
    }

    if (! str_starts_with($digest, 'sha256:')) {
        $digest = "sha256:{$digest}";
    }

    assert_digest($digest, 'gateway digest');

    return "{$image}@{$digest}";
}

function assert_digest(string $digest, string $label): void
{
    if (preg_match('/^sha256:[a-f0-9]{64}$/', $digest) !== 1) {
        fail("Release manifest {$label} must be a sha256 digest.");
    }
}

/**
 * @param  list<string>  $values
 * @return array<string, array{url: string, sha256: string}>
 */
function cli_artifacts(array $values, string $repository, string $version, string $assetBaseUrl): array
{
    if ($values === []) {
        fail('At least one --cli-artifact option is required.');
    }

    return artifacts($values, $repository, $version, $assetBaseUrl, 'CLI');
}

/**
 * @param  list<string>  $values
 * @return array<string, array{url: string, sha256: string}>
 */
function optional_artifacts(array $values, string $repository, string $version, string $assetBaseUrl, string $label): array
{
    if ($values === []) {
        return [];
    }

    return artifacts($values, $repository, $version, $assetBaseUrl, $label);
}

/**
 * @param  list<string>  $values
 * @return array<string, array{url: string, sha256: string}>
 */
function artifacts(array $values, string $repository, string $version, string $assetBaseUrl, string $label): array
{
    $artifacts = [];
    $tag = "v{$version}";

    foreach ($values as $value) {
        [$platform, $asset, $path] = array_pad(explode('=', $value, 3), 3, null);

        if (! is_string($platform) || trim($platform) === '' || ! is_string($asset) || trim($asset) === '' || ! is_string($path) || trim($path) === '') {
            fail("{$label} artifacts must use platform=asset-name=path format.");
        }

        if (! is_file($path)) {
            fail("{$label} artifact file not found: {$path}");
        }

        $asset = trim($asset);
        $sha256 = hash_file('sha256', $path);

        if (! is_string($sha256)) {
            fail("Failed to hash {$label} artifact: {$path}");
        }

        $artifacts[trim($platform)] = [
            'url' => artifact_url($asset, $repository, $tag, $assetBaseUrl),
            'sha256' => $sha256,
        ];
    }

    ksort($artifacts);

    return $artifacts;
}

/**
 * @param  list<string>  $values
 * @param  list<string>  $signatures
 * @return array<string, array{url: string, sha256: string, signature: string, version: string, platform: string, architecture: string}>
 */
function desktop_artifacts(
    array $values,
    array $signatures,
    string $repository,
    string $version,
    string $assetBaseUrl,
): array {
    if ($values === []) {
        return [];
    }

    $signatureByPlatform = [];

    foreach ($signatures as $value) {
        [$platform, $signature] = array_pad(explode('=', $value, 2), 2, null);

        if (! is_string($platform) || trim($platform) === '' || ! is_string($signature) || trim($signature) === '') {
            fail('Desktop signatures must use platform=signature format.');
        }

        $signatureByPlatform[trim($platform)] = trim($signature);
    }

    $artifacts = artifacts($values, $repository, $version, $assetBaseUrl, 'desktop');
    $desktop = [];

    foreach ($artifacts as $platform => $artifact) {
        $signature = $signatureByPlatform[$platform] ?? null;

        if (! is_string($signature) || $signature === '') {
            fail("Desktop artifact [{$platform}] requires --desktop-signature={$platform}=<signature>.");
        }

        [$os, $architecture] = array_pad(explode('-', $platform, 2), 2, null);

        if (! is_string($os) || $os === '' || ! is_string($architecture) || $architecture === '') {
            fail("Desktop artifact platform [{$platform}] must be os-architecture.");
        }

        $desktop[$platform] = [
            'url' => $artifact['url'],
            'sha256' => $artifact['sha256'],
            'signature' => $signature,
            'version' => $version,
            'platform' => $os,
            'architecture' => $architecture,
        ];
    }

    ksort($desktop);

    return $desktop;
}

function artifact_url(string $asset, string $repository, string $tag, string $assetBaseUrl): string
{
    if ($assetBaseUrl !== '') {
        return rtrim($assetBaseUrl, '/')."/{$asset}";
    }

    return "https://github.com/{$repository}/releases/download/{$tag}/{$asset}";
}

/**
 * @param  list<string>  $values
 * @return array<string, string>
 */
function role_images(array $values): array
{
    if ($values === []) {
        fail('At least one --role-image option is required.');
    }

    $images = [];

    foreach ($values as $value) {
        [$role, $image] = array_pad(explode('=', $value, 2), 2, null);

        if (! is_string($role) || trim($role) === '' || ! is_string($image) || trim($image) === '') {
            fail('Role images must use role=image format.');
        }

        $role = trim($role);
        $image = trim($image);

        if ($role === 'orbit-websocket' && preg_match('/\A[^@\s]+@sha256:[0-9a-f]{64}\z/i', $image) !== 1) {
            fail('The orbit-websocket role image must be digest-pinned.');
        }

        $images[$role] = $image;
    }

    ksort($images);

    return $images;
}

/**
 * @param  list<string>  $values
 * @return array<string, array{url: string, sha256: string}>
 */
function role_image_artifacts(array $values, string $repository, string $version, string $assetBaseUrl): array
{
    if ($values === []) {
        return [];
    }

    $artifacts = [];
    $tag = "v{$version}";

    foreach ($values as $value) {
        [$role, $asset, $path] = array_pad(explode('=', $value, 3), 3, null);

        if (! is_string($role) || trim($role) === '' || ! is_string($asset) || trim($asset) === '' || ! is_string($path) || trim($path) === '') {
            fail('Role image artifacts must use role=asset-name=path format.');
        }

        if (! is_file($path)) {
            fail("Role image artifact file not found: {$path}");
        }

        $sha256 = hash_file('sha256', $path);

        if (! is_string($sha256)) {
            fail("Failed to hash role image artifact: {$path}");
        }

        $artifacts[trim($role)] = [
            'url' => artifact_url(trim($asset), $repository, $tag, $assetBaseUrl),
            'sha256' => $sha256,
        ];
    }

    ksort($artifacts);

    return $artifacts;
}

function fail(string $message): never
{
    fwrite(STDERR, rtrim($message)."\n");

    exit(1);
}
