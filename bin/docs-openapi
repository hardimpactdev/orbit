def conn_settings_body(name):
    """The request body of the two Conn settings writes.

    ConnProfileSettingsRules builds its rules from the sections a request holds, so the rule parser cannot read
    them. This schema states the same limits, and a test of the Gateway enforces them.
    """
    def color_map(extra=None):
        schema = {'type': 'object', 'minProperties': 1, 'maxProperties': 80, 'propertyNames': {'pattern': '^[a-zA-Z][a-zA-Z0-9]{0,63}$'}, 'additionalProperties': {'type': 'string', 'maxLength': 64, 'pattern': '^[#A-Za-z0-9(),.%/ -]+$'}}
        schema.update(extra or {})
        return schema

    def slot():
        return {'type': 'object', 'additionalProperties': False, 'required': ['id', 'source'], 'properties': {
            'id': {'type': 'string', 'maxLength': 100},
            'source': {'type': 'string', 'enum': ['stock', 'builtin', 'custom', 'published']},
            'name': {'type': 'string', 'maxLength': 100},
            'appearance': {'type': 'string', 'enum': ['light', 'dark']},
            'colors': color_map(),
        }}

    workspaces = {'type': 'array', 'maxItems': 200, 'items': {'type': 'object', 'additionalProperties': False, 'required': ['id', 'name', 'color', 'icon'], 'properties': {
        'id': {'type': 'string', 'maxLength': 100},
        'name': {'type': 'string', 'maxLength': 100},
        'color': {'type': 'string', 'maxLength': 32},
        'icon': {'type': ['string', 'null'], 'maxLength': 64},
        'image': {'type': ['string', 'null'], 'maxLength': 200000, 'pattern': '^data:image\\/(png|jpeg|webp);base64,[A-Za-z0-9+\\/]+=*$(?![\\s\\S])'},
        'projectRefs': {'type': 'array', 'maxItems': 500, 'items': {'type': 'string', 'maxLength': 512, 'pattern': '^[^:\\s]+:\\S+$(?![\\s\\S])'}},
        'projectKeys': {'type': 'array', 'maxItems': 500, 'items': {'type': 'string', 'maxLength': 512}},
    }}}
    appearance = {'type': 'object', 'additionalProperties': False, 'required': ['schema', 'mode', 'contrast'], 'description': 'Serialized at most 512 KB.', 'properties': {
        'schema': {'type': 'integer', 'minimum': 1, 'maximum': 1000},
        'mode': {'type': 'string', 'enum': ['light', 'dark', 'system']},
        'contrast': {'type': 'integer', 'minimum': 50, 'maximum': 200},
        'themes': {'type': 'object', 'additionalProperties': False, 'minProperties': 1, 'properties': {'light': slot(), 'dark': slot()}},
        'customThemes': {'type': 'array', 'maxItems': 50, 'items': {'type': 'object', 'additionalProperties': False, 'required': ['id', 'name', 'appearance', 'colors'], 'properties': {
            'id': {'type': 'string', 'maxLength': 100, 'description': 'Unique in the list.'},
            'name': {'type': 'string', 'maxLength': 100},
            'appearance': {'type': 'string', 'enum': ['light', 'dark']},
            'colors': color_map(),
            'variants': {'type': 'object', 'additionalProperties': False, 'minProperties': 1, 'properties': {'light': color_map(), 'dark': color_map()}},
        }}},
    }}
    scalar = {'type': ['string', 'number', 'boolean', 'null'], 'maxLength': 512}
    device = {'type': 'object', 'additionalProperties': False, 'required': ['schema', 'values'], 'description': 'Serialized at most 64 KB. The Gateway checks the envelope and the value types; each client checks its own keys.', 'properties': {
        'schema': {'type': 'integer', 'minimum': 1, 'maximum': 1000},
        'values': {'type': 'object', 'minProperties': 1, 'maxProperties': 128, 'propertyNames': {'pattern': '^[a-zA-Z][a-zA-Z0-9]{0,63}$'}, 'additionalProperties': {'oneOf': [scalar, {'type': 'array', 'maxItems': 32, 'items': {'type': ['string', 'number', 'boolean'], 'maxLength': 512}}]}},
    }}
    attached_threads = {'type': 'object', 'additionalProperties': False, 'required': ['schema', 'threads'], 'description': 'Serialized at most 64 KB. The whole set: each thread once. See /reference/conn#attached-threads.', 'properties': {
        'schema': {'type': 'integer', 'minimum': 1, 'maximum': 1000},
        'threads': {'type': 'array', 'maxItems': 500, 'items': {'type': 'object', 'additionalProperties': False, 'required': ['environmentId', 'threadId'], 'properties': {
            'environmentId': {'type': 'string', 'pattern': '^[^\\s:]{1,255}$(?![\\s\\S])'},
            'threadId': {'type': 'string', 'pattern': '^\\S{1,255}$(?![\\s\\S])'},
        }}},
    }}
    device_type = '^[a-z][a-z0-9-]{1,23}$'
    if name == 'conn:profile:settings:update':
        return {'type': 'object', 'required': ['version', 'settings'], 'properties': {
            'version': {'type': 'integer', 'minimum': 1, 'description': 'The document version the client last read.'},
            'settings': {'type': 'object', 'additionalProperties': False, 'minProperties': 1, 'description': 'The sections to replace; the others stay. A replace cannot send `attachedThreads`. A write that grows the document past 4 MB is refused.', 'properties': {
                'workspaces': workspaces,
                'appearance': appearance,
                'devices': {'type': 'object', 'minProperties': 1, 'maxProperties': 8, 'propertyNames': {'pattern': device_type}, 'additionalProperties': device, 'description': 'Replaces every device type. At least one; a patch removes one type.'},
            }},
        }}
    change = lambda value, null: {'type': 'object', 'additionalProperties': False, 'required': ['version', 'value'], 'properties': {
        'version': {'type': 'integer', 'minimum': 0, 'description': 'The section version the client last read. A section with no recorded version reads as 0, including one written before sections had versions.'},
        'value': {'oneOf': [value, {'type': 'null'}]} if null else value,
    }}
    return {'type': 'object', 'required': ['sections'], 'properties': {
        'sections': {'type': 'object', 'minProperties': 1, 'additionalProperties': False, 'description': 'The sections to change by name. A write that grows the document past 8 device types or past 4 MB is refused; a write that does not grow it passes.', 'properties': {
            'workspaces': change(workspaces, False),
            'appearance': change(appearance, True),
            'attachedThreads': change(attached_threads, True),
        }, 'patternProperties': {'^devices\\.[a-z][a-z0-9-]{1,23}$': change(device, True)}},
    }}


def example_path(route, name):
    """Example value for one path parameter."""
    if name == 'operation' and route['name'] == 'websocket:operation:show':
        return '33333333-3333-4333-8333-333333333333'
    return EXAMPLE_PATH.get(name, 1)


def bash_sample(route, path, body_schema, query, tag):
    url = 'https://gateway.orbit' + re.sub(r'\{(\w+)\}', lambda m: str(example_path(route, m.group(1))), path)
    if query:
        examples = {**EXAMPLE_BY_NAME, **ACTIVITY_LIST_EXAMPLES} if route['name'] == 'activity:list' else EXAMPLE_BY_NAME
        if route['name'] in ('instance:dependencies:show', 'project:dependencies:show'):
            examples = {**examples, 'source': '64da9c6b9583ae0c64fd780c2d9ccea8959252e57cd608441c257ca98dc27dcf'}
        url += '?' + '&'.join(f'{q}={examples.get(q, 1)}' for q in query)
    method = '' if route['method'] == 'GET' else f'-X {route["method"]} '
    lines = [f'curl -sS {method}"{url}" \\', '  --cacert /path/to/orbit-root-ca.pem \\', "  -H 'Accept: application/json' \\", "  -H 'X-Orbit-Request-Id: 9d6b1e5c-4a3f-4a1b-9f0e-6d2c3f5a7b81'"]
    if body_schema is not None:
        lines[-1] += ' \\'
        body = example_from_schema(body_schema, None, tag, update=route['method'] in ('PATCH', 'PUT')) or {}
        if route['name'] in EXAMPLE_BY_ROUTE:
            body = EXAMPLE_BY_ROUTE[route['name']] if route['name'] == 'process:update' else {**body, **EXAMPLE_BY_ROUTE[route['name']]}
        lines += ["  -H 'Content-Type: application/json' \\", "  -d '" + json.dumps(body) + "'"]
    return '\n'.join(lines) + '\n'


# ---------------------------------------------------------------- responses
def envelope(data_schema, description):
    return {'description': description, 'content': {'application/json': {'schema': {'type': 'object', 'properties': {'data': data_schema, 'meta': {'$ref': '#/components/schemas/Meta'}}, 'required': ['data', 'meta']}}}}


def websocket_envelope(data_schema, description):
    response = envelope({'oneOf': [ref('WebSocketAppData'), {'type': 'array', 'maxItems': 0}]}, description)
    schema = response['content']['application/json']['schema']
    apply = sdk_schema('WebSocketApplyResponse')
    apply['properties']['id'] = {'type': 'string', 'format': 'uuid'}
    apply['properties']['epoch'] = {'type': 'string', 'format': 'uuid'}
    apply['properties']['state'] = {'type': 'string', 'enum': ['pending', 'applied', 'superseded']}
    apply['properties']['status_url'] = {'type': 'string', 'description': 'Relative URL for this operation status.'}
    apply['required'] = ['id', 'epoch', 'revision', 'state', 'processes', 'missing_node_ids', 'status_url']
    schema['properties']['operation'] = apply
    schema['required'].append('operation')
    return response


def error_response(desc):
    return {'description': desc, 'content': {'application/json': {'schema': {'$ref': '#/components/schemas/Error'}}}}


