{
  "kind": "node.role_add.analytics.no-drift",
  "defaults": "node-role-add-defaults.json",
  "request": {
    "method": "POST",
    "path": "nodes/${node.peer}/roles",
    "body": {"role": "analytics", "postgres_process_id": "${postgres.id}", "clickhouse_process_id": "${clickhouse.id}", "converge_existing": true}
  },
  "parity": ["swamp/proof/node.role_add/parity.py", "peer", "analytics", "no-drift"],
  "prepare": [
    {"method": "GET", "path": "processes", "operation": false, "bind": "postgres", "match": {"name": "proof-analytics-postgres"}, "body": {}},
    {"method": "GET", "path": "processes", "operation": false, "bind": "clickhouse", "match": {"name": "proof-analytics-clickhouse"}, "body": {}}
  ],
  "phases": [
    {"name": "Apply role prerequisites", "job": "prerequisites", "step": "Apply role prerequisites", "budget_seconds": 900},
    {"name": "Apply the role on the Node", "job": "node", "step": "Apply the role on the Node", "budget_seconds": 900},
    {"name": "Publish role sites", "job": "publication", "step": "Publish role sites", "budget_seconds": 180},
    {"name": "Open the firewall", "job": "firewall", "step": "Open the firewall", "budget_seconds": 120},
    {"name": "Check the role", "job": "role", "step": "Check the role", "budget_seconds": 60},
    {"name": "Open Analytics storage", "job": "analytics_storage", "step": "Open Analytics storage", "budget_seconds": 120}
  ],
  "observer_wait_seconds": 0
}
