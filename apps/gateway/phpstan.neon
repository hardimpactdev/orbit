includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/spaze/phpstan-disallowed-calls/extension.neon
    - ../../tools/phpstan/orbit-rules.neon
    - ../../tools/phpstan/parallel.php

parameters:
    level: 9
    paths:
        - app
        - routes
        - database/migrations
        - extensions
        - ../../tools/phpstan
        - ../../tools/boost
    squashedMigrationsPath:
        - database/schema
    # Each extension keeps its own migrations and configuration (docs/reference/extensions.md#layout).
    databaseMigrationsPath:
        - database/migrations
        - extensions/*/database/migrations
    configDirectories:
        - config
        - extensions/*/config
    tmpDir: vendor/phpstan/cache
