#!/usr/bin/env python3
"""Report-only main proof consumer; union selection uses the typed proof:run base input."""
import argparse
import json
import os
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]
KINDS = {'node:list', 'node:show', 'node:role:list', 'node:metrics', 'node:role:add', 'node:converge', 'firewall:list', 'firewall:allow'}


def report(claim, receipt, job_result='success'):
    result = receipt.get('result') or {}
    cases = result.get('cases')
    problems = []
    if job_result != 'success':
        problems.append({'unit': 'proof job', 'reason': 'Job ended ' + job_result, 'files': []})
    if receipt.get('commit') != claim['sha'] or receipt.get('outcome') != 'passed':
        problems.append({'unit': 'proof', 'reason': 'Missing, mismatched or nonpassing pinned-SHA receipt', 'files': []})
    if not isinstance(cases, list):
        problems.append({'unit': 'proof', 'reason': 'Missing case receipts', 'files': []})
        cases = []
    seen = set()
    for case in cases:
        if not isinstance(case, dict) or not case.get('command') or not case.get('case'):
            problems.append({'unit': 'proof', 'reason': 'Malformed case receipt', 'files': []})
            continue
        key = (case['command'], case['case'])
        if key in seen or case.get('verdict') != 'passed':
            problems.append({'unit': ': '.join(key), 'reason': 'Duplicate or nonpassing case: ' + str(case), 'files': [case.get('file', '')]})
        seen.add(key)
    well_formed = isinstance(result.get('cases'), list) and len(seen) == len(cases) and all(
        isinstance(case, dict) and case.get('command') and case.get('case')
        and case.get('verdict') in ('passed', 'failed') for case in cases)
    selected = result.get('selected_commands')
    selection_complete = well_formed and isinstance(selected, list) and all(
        isinstance(command, str) and any(case.get('command') == command for case in cases) for command in selected)
    terminal = receipt.get('operation_status') in ('succeeded', 'failed')
    verdict_reached = bool(receipt.get('commit') == claim['sha'] and result.get('commit', claim['sha']) == claim['sha']
                           and well_formed and terminal and (
        (receipt.get('started_at') and cases and selection_complete and selected
         and result.get('outcome') in ('passed', 'failed'))
        or (receipt.get('outcome') == 'passed' and result.get('outcome') == 'nothing_to_prove'
            and receipt.get('operation_status') == 'succeeded' and not cases and selected in (None, []))))
    if not verdict_reached:
        problems.append({'unit': 'proof admission or incomplete execution',
                         'reason': 'No completed proof verdict; checkpoint retained', 'files': []})
    range_covered = verdict_reached and claim['mode'] == 'range' and receipt.get('base') == claim['base']
    if claim['mode'] == 'range' and receipt.get('base') != claim['base']:
        problems.append({'unit': 'proof range', 'reason': 'Missing or mismatched range base in receipt', 'files': []})
    if claim['mode'] == 'all':
        missing = KINDS - {command for command, _ in seen}
        if missing:
            problems.append({'unit': 'nightly kinds', 'reason': 'Missing ' + ', '.join(sorted(missing)), 'files': []})
    return {'claim': claim, 'passed': not problems, 'range_covered': range_covered, 'verdict_reached': verdict_reached,
            'admission_retry': {'attempt': claim.get('admission_attempt'), 'limit': claim.get('admission_limit'),
                                'state': 'answered' if verdict_reached else ('exhausted; operator retry required' if claim.get('admission_attempt', 0) >= 3 else 'pending; retry on next run')},
            'selection': 'all kinds on newest tree' if claim['mode'] == 'all' else ('union of per-commit selections at tested SHA' if range_covered else 'range not covered'),
            'not_individually_tested': claim['commits'][:-1], 'problems': problems, 'receipt': receipt}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('command', choices=['run', 'report'])
    parser.add_argument('--claim', type=Path, required=True)
    parser.add_argument('--receipt', type=Path)
    parser.add_argument('--job-result', default='failure')
    parser.add_argument('--output', type=Path, required=True)
    args = parser.parse_args()
    claim = json.loads(args.claim.read_text())
    claim['attempt'] = int(os.environ.get('GITHUB_RUN_ATTEMPT', '1'))
    if args.command == 'run':
        env = {**os.environ, 'PROOF_SHA': claim['sha'], 'PROOF_ALL': str(claim['mode'] == 'all').lower(),
               'PROOF_BASE': claim['base'] if claim['mode'] == 'range' else '',
               'PROOF_STORE_RESULT': 'true', 'PROOF_CHECK_ELIGIBILITY': 'true', 'PROOF_RECEIPT': str(args.output)}
        return subprocess.run([sys.executable, '-I', str(ROOT / 'bin/ci-proof-run')], env=env).returncode
    receipt = json.loads(args.receipt.read_text()) if args.receipt.exists() else {}
    result = report(claim, receipt, args.job_result)
    args.output.write_text(json.dumps(result, indent=2) + '\n')
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
