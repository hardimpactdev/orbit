{
    "name": "@orbit/pi-server",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "start": "bun src/main.ts",
        "check": "vp check",
        "test": "vp test run",
        "build": "tsc && bun build src/main.ts --compile --outfile dist/pi-server",
        "build:linux": "bun build src/main.ts --compile --target=bun-linux-x64 --outfile dist/pi-server-linux-x64 && bun build src/main.ts --compile --target=bun-linux-arm64 --outfile dist/pi-server-linux-arm64"
    },
    "dependencies": {
        "@earendil-works/chord": "1.4.0",
        "@earendil-works/pi-agent-core": "1.4.0",
        "@earendil-works/pi-ai": "1.4.0",
        "@earendil-works/pi-coding-agent": "1.4.0",
        "@earendil-works/pi-durable": "1.4.0"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "typescript": "~7.0.2",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
        "vite-plus": "1.2.0"
    },
    "overrides": {
        "@earendil-works/pi-agent-core": "1.4.0",
        "@earendil-works/pi-ai": "1.4.0",
        "source-map-js": "1.2.2",
        "tinypool": "2.1.2",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
        "vitest": "5.0.3"
    },
    "devEngines": {
        "packageManager": {
            "name": "bun",
            "version": "1.4.2",
            "onFail": "download"
        }
    },
    "patchedDependencies": {
        "@earendil-works/pi-ai@1.4.0": "patches/@earendil-works%2Fpi-ai@1.4.0.patch"
    }
}
