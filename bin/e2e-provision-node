#!/usr/bin/env bash

set -Eeuo pipefail

ROLE=""
SOURCE_ARCHIVE=""
INSTALLER=""
COMPOSER_CACHE=""
RUNTIME_IMAGE_ARCHIVE=""
CADDY_IMAGE_ARCHIVE=""
DNSMASQ_IMAGE_ARCHIVE=""
FRANKENPHP_IMAGE_ARCHIVE=""
WG_EASY_IMAGE_ARCHIVE=""
OPERATOR_USER="${ORBIT_E2E_OPERATOR_USER:-${ORBIT_E2E_CONTROL_USER:-orbit}}"
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null && pwd)"
CURRENT_STEP=""
LOG_FILE="${ORBIT_E2E_PROVISION_LOG:-}"

usage() {
    cat <<'HELP'
usage: bin/e2e-provision-node --role=operator|gateway|app --source-archive=PATH [options]

Provision an Orbit role VM cloned from the supported E2E base image by pushing
a source archive into place via bin/install-orbit. Designed to run inside the
VM after the bundle has been pushed.

Required:
  --role=operator|gateway|app  Topology role being installed.
  --source-archive=PATH        Tarball of the Orbit checkout to install.

Optional:
  --installer=PATH             Path to bin/install-orbit. Defaults to a sibling
                               of this script.
  --composer-cache=PATH        Local composer cache directory. If given and
                               non-empty, copied into the role's composer cache
                               before install-orbit runs.
  --runtime-image-archive=PATH Local Docker image archive for
                               orbit-runtime:current. If given, forwarded to
                               install-orbit so fresh VMs do not need to
                               rebuild the runtime image from Docker Hub.
  --caddy-image-archive=PATH   Local Docker image archive for caddy:2-alpine.
                               If given, forwarded to install-orbit so fresh
                               VMs do not need to pull Caddy from Docker Hub.
  --dnsmasq-image-archive=PATH Local Docker image archive for
                               4km3/dnsmasq:latest. If given, forwarded to
                               install-orbit for gateway DNS bootstrap.
  --frankenphp-image-archive=PATH
                               Local Docker image archive for
                               dunglas/frankenphp:1-php8.5-bookworm. If given,
                               forwarded to install-orbit for app runtime
                               bootstrap.
  --wg-easy-image-archive=PATH Local Docker image archive for
                               ghcr.io/wg-easy/wg-easy:15. If given,
                               forwarded to install-orbit for gateway VPN
                               bootstrap.
  --operator-user=NAME         Operator steady-state user. Defaults to
                               $ORBIT_E2E_OPERATOR_USER, then
                               $ORBIT_E2E_CONTROL_USER, then "orbit".
  -h, --help                   Show this help text.
HELP
}

fail() {
    local code="$1"
    shift

    printf 'e2e-provision-node: error [%s] %s\n' "$code" "$*" >&2

    if [ -n "$LOG_FILE" ] && [ -f "$LOG_FILE" ]; then
        printf 'e2e-provision-node: log %s\n' "$LOG_FILE" >&2
    fi

    exit 1
}

ensure_log_file() {
    local tmp_dir
    local tmp_file

    if [ -n "$LOG_FILE" ]; then
        return
    fi

    tmp_dir="${TMPDIR:-/tmp}"
    tmp_dir="${tmp_dir%/}"
    tmp_file="$(mktemp "$tmp_dir/orbit-provision.XXXXXX")"
    LOG_FILE="${tmp_file}.log"
    mv "$tmp_file" "$LOG_FILE"
}

run() {
    ensure_log_file

    {
        printf '+'
        printf ' %q' "$@"
        printf '\n'
    } >>"$LOG_FILE"

    "$@" >>"$LOG_FILE" 2>&1
}

sudo_run() {
    if [ "$(id -u)" -ne 0 ]; then
        run sudo "$@"
        return
    fi

    run "$@"
}

start_step() {
    CURRENT_STEP="$1"
    printf '  ◉  %s\n' "$CURRENT_STEP"
}

complete_step() {
    printf '  ●  %s\n' "$CURRENT_STEP"
    CURRENT_STEP=""
}

fail_step() {
    local status="$1"

    if [ -n "$CURRENT_STEP" ]; then
        printf '  ●  %s failed\n' "$CURRENT_STEP" >&2
    fi

    if [ -n "$LOG_FILE" ] && [ -f "$LOG_FILE" ]; then
        printf 'e2e-provision-node: log %s\n' "$LOG_FILE" >&2
        tail -n 20 "$LOG_FILE" >&2 || true
    fi

    exit "$status"
}

parse_args() {
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --role=*)
                ROLE="${1#*=}"
                ;;
            --source-archive=*)
                SOURCE_ARCHIVE="${1#*=}"
                ;;
            --installer=*)
                INSTALLER="${1#*=}"
                ;;
            --composer-cache=*)
                COMPOSER_CACHE="${1#*=}"
                ;;
            --runtime-image-archive=*)
                RUNTIME_IMAGE_ARCHIVE="${1#*=}"
                ;;
            --caddy-image-archive=*)
                CADDY_IMAGE_ARCHIVE="${1#*=}"
                ;;
            --dnsmasq-image-archive=*)
                DNSMASQ_IMAGE_ARCHIVE="${1#*=}"
                ;;
            --frankenphp-image-archive=*)
                FRANKENPHP_IMAGE_ARCHIVE="${1#*=}"
                ;;
            --wg-easy-image-archive=*)
                WG_EASY_IMAGE_ARCHIVE="${1#*=}"
                ;;
            --operator-user=*)
                OPERATOR_USER="${1#*=}"
                ;;
            --control-user=*)
                OPERATOR_USER="${1#*=}"
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            *)
                fail validation_failed "unknown option: $1"
                ;;
        esac

        shift
    done
}

validate_args() {
    case "$ROLE" in
        operator|control|gateway|app)
            ;;
        "")
            fail validation_failed "--role is required"
            ;;
        *)
            fail validation_failed "--role must be: operator, gateway, or app"
            ;;
    esac

    [ -n "$SOURCE_ARCHIVE" ] || fail validation_failed "--source-archive is required"
    [ -f "$SOURCE_ARCHIVE" ] || fail validation_failed "source archive not found: $SOURCE_ARCHIVE"

    if [ -z "$INSTALLER" ]; then
        INSTALLER="${SCRIPT_DIR}/install-orbit"
    fi

    [ -x "$INSTALLER" ] || fail validation_failed "installer not executable: $INSTALLER"

    if [ -n "$RUNTIME_IMAGE_ARCHIVE" ] && [ ! -f "$RUNTIME_IMAGE_ARCHIVE" ]; then
        fail validation_failed "runtime image archive not found: $RUNTIME_IMAGE_ARCHIVE"
    fi

    if [ -n "$CADDY_IMAGE_ARCHIVE" ] && [ ! -f "$CADDY_IMAGE_ARCHIVE" ]; then
        fail validation_failed "caddy image archive not found: $CADDY_IMAGE_ARCHIVE"
    fi

    if [ -n "$DNSMASQ_IMAGE_ARCHIVE" ] && [ ! -f "$DNSMASQ_IMAGE_ARCHIVE" ]; then
        fail validation_failed "dnsmasq image archive not found: $DNSMASQ_IMAGE_ARCHIVE"
    fi

    if [ -n "$FRANKENPHP_IMAGE_ARCHIVE" ] && [ ! -f "$FRANKENPHP_IMAGE_ARCHIVE" ]; then
        fail validation_failed "frankenphp image archive not found: $FRANKENPHP_IMAGE_ARCHIVE"
    fi

    if [ -n "$WG_EASY_IMAGE_ARCHIVE" ] && [ ! -f "$WG_EASY_IMAGE_ARCHIVE" ]; then
        fail validation_failed "wg-easy image archive not found: $WG_EASY_IMAGE_ARCHIVE"
    fi

    [ -n "$OPERATOR_USER" ] || fail validation_failed "--operator-user must not be empty"
}

target_user_for_role() {
    case "$ROLE" in
        operator|control)
            printf '%s' "$OPERATOR_USER"
            ;;
        gateway|app)
            printf '%s' orbit
            ;;
    esac
}

ensure_target_user() {
    local user
    user="$(target_user_for_role)"

    if id -u "$user" >/dev/null 2>&1; then
        return
    fi

    sudo_run useradd -m -s /bin/bash "$user"
    sudo_run usermod -p '*' "$user"
    sudo_run usermod -aG sudo "$user"
    sudo_run install -d -m 0755 /etc/sudoers.d
    sudo_run bash -lc "printf '%s ALL=(ALL) NOPASSWD:ALL\n' $(printf '%q' "$user") > /etc/sudoers.d/99-${user}"
    sudo_run chmod 440 "/etc/sudoers.d/99-${user}"
    sudo_run install -d -m 700 -o "$user" -g "$user" "/home/${user}/.ssh"
}

restore_composer_cache() {
    local user
    local target

    [ -n "$COMPOSER_CACHE" ] || return 0
    [ -d "$COMPOSER_CACHE" ] || return 0

    user="$(target_user_for_role)"
    target="/home/${user}/.composer/cache"

    sudo_run install -d -m 0755 -o "$user" -g "$user" "/home/${user}/.composer"
    sudo_run install -d -m 0755 -o "$user" -g "$user" "$target"

    if [ -z "$(ls -A "$COMPOSER_CACHE" 2>/dev/null || true)" ]; then
        return 0
    fi

    sudo_run bash -lc "cp -R $(printf '%q' "${COMPOSER_CACHE}/.") $(printf '%q' "$target")"
    sudo_run chown -R "${user}:${user}" "$target"
}

install_e2e_dependencies() {
    if ! command -v apt-get >/dev/null 2>&1; then
        return
    fi

    mapfile -t packages < <("${SCRIPT_DIR}/_e2e-deps.sh" --base)

    sudo_run apt-get update
    sudo_run env DEBIAN_FRONTEND=noninteractive apt-get -o DPkg::Lock::Timeout=300 install -y "${packages[@]}"

    if command -v systemctl >/dev/null 2>&1 && systemctl list-unit-files supervisor.service >/dev/null 2>&1; then
        sudo_run systemctl enable --now supervisor.service
    fi
}

install_role() {
    local user
    local home_dir
    local target_dir
    local guest_stage_dir
    local staged_source_archive
    local staged_installer
    local staged_runtime_image_archive=""
    local staged_caddy_image_archive=""
    local staged_dnsmasq_image_archive=""
    local staged_frankenphp_image_archive=""
    local staged_wg_easy_image_archive=""
    local runtime_image_args=()
    local caddy_image_args=()
    local dnsmasq_image_args=()
    local frankenphp_image_args=()
    local wg_easy_image_args=()

    user="$(target_user_for_role)"
    home_dir="/home/${user}"
    target_dir="${home_dir}/orbit"
    guest_stage_dir="/var/tmp/orbit-e2e-install"
    staged_source_archive="${guest_stage_dir}/orbit-source.tar.gz"
    staged_installer="${guest_stage_dir}/install-orbit"

    sudo_run rm -rf "$guest_stage_dir"
    sudo_run install -d -m 0755 -o "$user" -g "$user" "$guest_stage_dir"
    sudo_run install -m 0644 -o "$user" -g "$user" "$SOURCE_ARCHIVE" "$staged_source_archive"
    sudo_run install -m 0755 -o "$user" -g "$user" "$INSTALLER" "$staged_installer"

    if [ -n "$RUNTIME_IMAGE_ARCHIVE" ]; then
        staged_runtime_image_archive="${guest_stage_dir}/orbit-runtime-current.tar"
        sudo_run install -m 0644 -o "$user" -g "$user" "$RUNTIME_IMAGE_ARCHIVE" "$staged_runtime_image_archive"
        runtime_image_args=(--runtime-image-archive="$staged_runtime_image_archive")
    fi

    if [ -n "$CADDY_IMAGE_ARCHIVE" ]; then
        staged_caddy_image_archive="${guest_stage_dir}/caddy-2-alpine.tar"
        sudo_run install -m 0644 -o "$user" -g "$user" "$CADDY_IMAGE_ARCHIVE" "$staged_caddy_image_archive"
        caddy_image_args=(--caddy-image-archive="$staged_caddy_image_archive")
    fi

    if [ -n "$DNSMASQ_IMAGE_ARCHIVE" ]; then
        staged_dnsmasq_image_archive="${guest_stage_dir}/dnsmasq-latest.tar"
        sudo_run install -m 0644 -o "$user" -g "$user" "$DNSMASQ_IMAGE_ARCHIVE" "$staged_dnsmasq_image_archive"
        dnsmasq_image_args=(--dnsmasq-image-archive="$staged_dnsmasq_image_archive")
    fi

    if [ -n "$FRANKENPHP_IMAGE_ARCHIVE" ]; then
        staged_frankenphp_image_archive="${guest_stage_dir}/frankenphp-1-php8.5-bookworm.tar"
        sudo_run install -m 0644 -o "$user" -g "$user" "$FRANKENPHP_IMAGE_ARCHIVE" "$staged_frankenphp_image_archive"
        frankenphp_image_args=(--frankenphp-image-archive="$staged_frankenphp_image_archive")
    fi

    if [ "$ROLE" = "gateway" ] && [ -n "$WG_EASY_IMAGE_ARCHIVE" ]; then
        staged_wg_easy_image_archive="${guest_stage_dir}/wg-easy-15.tar"
        sudo_run install -m 0644 -o "$user" -g "$user" "$WG_EASY_IMAGE_ARCHIVE" "$staged_wg_easy_image_archive"
        wg_easy_image_args=(--wg-easy-image-archive="$staged_wg_easy_image_archive")
    fi

    sudo_run runuser -u "$user" -- env \
        "HOME=${home_dir}" \
        "COMPOSER_HOME=${home_dir}/.composer" \
        PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
        "$staged_installer" \
        "--path=${target_dir}" \
        "--source-archive=${staged_source_archive}" \
        --bin=/usr/local/bin/orbit \
        "${runtime_image_args[@]}" \
        "${caddy_image_args[@]}" \
        "${dnsmasq_image_args[@]}" \
        "${frankenphp_image_args[@]}" \
        "${wg_easy_image_args[@]}"
}

cleanup_bundle() {
    sudo_run rm -rf /var/tmp/orbit-e2e-install
}

main() {
    parse_args "$@"
    validate_args

    ensure_log_file
    trap 'fail_step "$?"' ERR

    printf '  ┌ Orbit E2E provision (%s)\n' "$ROLE"
    printf '  │\n'
    printf '  └  Log: %s\n\n' "$LOG_FILE"

    start_step "Ensure target user"
    ensure_target_user
    complete_step

    start_step "Install E2E dependencies"
    install_e2e_dependencies
    complete_step

    if [ -n "$COMPOSER_CACHE" ]; then
        start_step "Restore composer cache"
        restore_composer_cache
        complete_step
    fi

    start_step "Install Orbit (${ROLE})"
    install_role
    complete_step

    start_step "Cleanup provisioner bundle"
    cleanup_bundle
    complete_step

    printf '\n  └  Provisioned %s at /home/%s/orbit\n' "$ROLE" "$(target_user_for_role)"
}

main "$@"
