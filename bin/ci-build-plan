#!/usr/bin/env python3
"""Select CI builds from changed inputs; every main commit is a Gateway release, which also loads Swamp."""
import argparse
import json
from pathlib import Path
import re
import subprocess

JOBS = ('php', 'gateway-static', 'gateway-tests', 'cli', 'cli-static', 'sdk-static', 'e2e-static', 'docs', 'api-reference', 'web', 'pi', 'agent', 'swamp', 'proof')
ROOT = Path(__file__).resolve().parent.parent
# Gateway files that the Swamp gate and its Deno tests read: the grant renderer, the workflow definition that a Deno test parses, and the
# frozen agent contract, whose check scans the Gateway and Swamp sources (the PHP job runs the same check for PHP files only).
SWAMP_GATEWAY_INPUTS = ('apps/gateway/app/Infrastructure/GatewayReleases/SwampGrantRenderer.php', 'apps/gateway/app/Support/ValidatedData.php',
                        'apps/gateway/bin/render-swamp-grants', 'apps/gateway/app/Domain/Tasks/direct-operations.php')
FROZEN_SCANNED = ('.ts', '.js', '.py', '.yaml', '.yml')
SELECTION = 'swamp/proof/selection.txt'
SELECTION_COMMAND = re.compile(r'[a-z][a-z0-9_-]*(?::[a-z][a-z0-9_-]*)+')


def selection_regex(glob):
    """Match `ProofSelectionRule` in the Gateway: `**` crosses directories, `*` and `?` stay in one name."""
    pattern, i = '', 0
    while i < len(glob):
        if glob.startswith('**', i):
            i += 2
            if glob.startswith('/', i):
                i += 1
                pattern += '(?:.*/)?'
            else:
                pattern += '.*'
            continue
        pattern += '[^/]*' if glob[i] == '*' else '[^/]' if glob[i] == '?' else re.escape(glob[i])
        i += 1
    return re.compile(pattern)


def selection_rules(text):
    """The lines of `swamp/proof/selection.txt` as (glob regex, selects a proof). The Gateway refuses a malformed line."""
    rules = []
    for number, line in enumerate(text.splitlines(), 1):
        line = line.strip()
        if not line or line.startswith('#'):
            continue
        parts = line.split(None, 1)
        if len(parts) != 2:
            raise ValueError(f'{SELECTION} line {number}: a line holds a path glob and its value')
        glob, value = parts[0], parts[1].strip()
        if value == 'skip' or (value.startswith('none:') and value[5:].strip()):
            selects = False
        elif value == '*' or all(SELECTION_COMMAND.fullmatch(word) for word in value.split()):
            selects = True
        else:
            raise ValueError(f'{SELECTION} line {number}: [{value}] is not skip, *, none: or a family:command')
        rules.append((selection_regex(glob), selects))
    return rules


def proof_run(paths, selection):
    """Whether a changed path selects a command in the list that `orbit proof:run` reads: the last matching line wins.

    A path no line matches also starts the job, so `proof:run` refuses it (proof.path_unmapped). Without a list,
    every change starts it, as proof:run then selects every case.
    """
    paths = [path for path in paths if path]
    if not paths:
        return False
    if selection is None:
        return True
    rules = selection_rules(selection)
    for path in paths:
        match = next((selects for regex, selects in reversed(rules) if regex.fullmatch(path)), True)
        if match:
            return True
    return False


def proof_cases(paths, selection, read, files):
    """Use the runner to plan every candidate, retaining verified empty selections. None means Gateway must refuse an unmapped path."""
    import sys
    sys.path.insert(0, str(ROOT / 'swamp/proof/runner'))
    from selection import select as select_cases
    from spec import Loader
    import yaml

    rules = selection_rules(selection) if selection is not None else []
    # Keep the parser's validation and glob semantics; retain each value for command ownership.
    values = [line.strip().split(None, 1)[1].strip() for line in (selection or '').splitlines() if line.strip() and not line.strip().startswith('#')]
    commands, everything = {}, selection is None
    batch_path = 'swamp/proof/batches.yaml'
    for path in paths:
        matched = next((value for (regex, _), value in reversed(list(zip(rules, values))) if regex.fullmatch(path)), None)
        if matched is None and selection is not None:
            return None
        if matched == '*':
            everything = True
        elif matched and matched != 'skip' and not matched.startswith('none:'):
            for command in matched.split():
                commands.setdefault(command, []).append(path)
    candidates = {f"swamp/proof/{c.split(':', 1)[0]}/{c.split(':', 1)[1].replace(':', '-')}.cases.yaml": c for c in sorted(commands)}
    if everything or batch_path in paths:
        for file in files:
            if file not in candidates:
                try:
                    candidates[file] = yaml.load(read('head', file), Loader=Loader)['command']
                except Exception:
                    candidates[file] = file.removeprefix('swamp/proof/').removesuffix('.cases.yaml').replace('/', ':', 1)
    if not candidates:
        return []
    result = []
    for file, command in candidates.items():
        if file not in files:
            continue
        code_changed = everything or any(path not in (file, batch_path) for path in commands.get(command, []))
        chosen = select_cases(read('base', file), read('head', file), code_changed,
                              read('base', batch_path), read('head', batch_path), changed_paths=paths)
        # Keep empty entries in the artifact: the Gateway must distinguish verified zero from missing data.
        result.append({'command': command, 'file': file, **chosen})
    return sorted(result, key=lambda entry: entry['command'])


# Known source roots are explicit even for the desktop app, whose checks remain paused.
APPS = {'agent', 'cli', 'desktop', 'docs', 'e2e', 'gateway', 'pi-server', 'web'}
SOURCE_ROOTS = {'docs', '.github', 'bin', 'tools', '.agents', '.codex', '.githooks', 'scripts', 'swamp'}
ROOT_INPUTS = {'.editorconfig', '.gitattributes', '.gitignore', '.node-version', 'composer.json', 'composer.lock', 'vet.json', 'LICENSE'}
PROSE = ('.md', '.mdx', '.mmd')


def check_source_roots(paths):
    for path in paths:
        parts = path.split('/')
        known = (parts[0] == 'apps' and len(parts) > 2 and parts[1] in APPS
                 or parts[0] == 'packages' and len(parts) > 2 and parts[1] == 'php-sdk'
                 or parts[0] in SOURCE_ROOTS and len(parts) > 1
                 or len(parts) == 1 and (path in ROOT_INPUTS or path.endswith(PROSE)))
        if not known:
            raise ValueError(f'Unknown CI source root: {path}. Add its check inputs to bin/ci-build-plan.')


def swamp_inputs(path):
    """Check inputs, including the files read by fixtures. Prose is handled by Docs instead."""
    checks = set()
    if path.startswith('swamp/') and not path.endswith(PROSE):
        checks.add('shape')
        relative = path.removeprefix('swamp/')
        if (relative.startswith(('workflows/', 'extensions/', 'models/'))
                or relative.startswith('config/') and not relative.startswith('config/swamp-shape')
                or relative.startswith(('bin/validate-swamp-workflows', 'bin/check-grant-patterns', 'bin/lint-workflow-placement'))
                or relative == 'tests/node_add_bootstrap_test.ts'):
            checks.add('validate')
        # Operation tests parse workflows, grants, manifests and Ansible assets; they also import
        # maintenance helpers, native test support and the YAML analyser. Keep those transitive inputs.
        if relative.startswith(('workflows/', 'extensions/', 'models/', 'ansible/', 'scripts/', 'tests/',
                                'bin/check-swamp-shape', 'bin/gate-test-support', 'bin/check-grant-patterns',
                                'bin/bounded-phase-scripts.ts', 'bin/workflow-placement.ts', 'bin/swamp-shape-relocations.ts')):
            checks.add('tests')
        if relative.startswith('config/'):
            checks.add('tests')
        if '/' not in relative:
            checks.update(('shape', 'validate', 'tests'))
    if path in SWAMP_GATEWAY_INPUTS:
        checks.update(('shape', 'tests'))
        if path != 'apps/gateway/app/Domain/Tasks/direct-operations.php':
            checks.add('validate')
    if path.startswith('apps/gateway/resources/agent/'):
        checks.update(('shape', 'tests'))
    if path.startswith(('apps/gateway/app/', 'apps/gateway/extensions/')) and path.endswith(FROZEN_SCANNED):
        checks.add('shape')
    return checks


def tooling_jobs(path):
    """Narrow known tooling; shared configuration and unclassified tools keep the broad check set."""
    if path.startswith(('.agents/', '.codex/', '.githooks/')):
        return {'docs'}
    if path == 'bin/docs-navigation':
        return {'docs', 'api-reference', 'web'}
    if path.startswith(('bin/docs-', 'bin/check-flows')) and path != 'bin/docs-openapi':
        return {'docs'}
    if path in ('bin/build-api', 'bin/docs-openapi', 'bin/mcp-tools', 'bin/api-fixtures', 'bin/check-operation-kinds'):
        return {'api-reference', 'web'}
    if path == 'bin/swamp-shape-gate':
        return set()
    if path == 'bin/check-frozen-agent-commands':
        return {'php'}
    if path == 'bin/ci-proof-run' or path.startswith('tools/swamp-proof-guest/'):
        return {'proof'}
    if path.startswith(('tools/test_ci_', 'tools/test_swamp_import_base', 'tools/test_frozen_agent_commands')):
        return set()  # Select build inputs always runs these fixtures.
    if path.startswith('tools/phpstan/'):
        return {'gateway-static', 'cli-static', 'sdk-static', 'e2e-static'}
    if path in ('bin/orbit-build-cli-binary', 'bin/orbit-version', 'bin/orbit-cli-release-version', 'bin/orbit-cli-release-assets'):
        return {'cli'}
    return set(JOBS)


def select(paths, main=False, selection=None):
    """`selection` is the text of the selection list; omitted, the list of this checkout is read."""
    paths = [path for path in paths if path]
    check_source_roots(paths)
    swamp_only = bool(paths) and all(path.startswith('swamp/') for path in paths)
    jobs = dict.fromkeys(JOBS, False)
    swamp_checks = dict.fromkeys(('shape', 'validate', 'tests'), False)
    agent = False
    for path in paths:
        # Gateway tests invoke the CLI consent fixture and native firewall behavior, and read
        # proof cases, operation schemas, workflow/Ansible contracts and chart-backed metadata.
        if (path.startswith(('apps/gateway/', 'apps/cli/', 'packages/php-sdk/'))
                or not path.endswith(PROSE) and path.startswith(('swamp/workflows/', 'swamp/ansible/', 'swamp/proof/', 'swamp/config/',
                             'swamp/extensions/behaviors/operations/', 'swamp/extensions/behaviors/_lib/'))
                or path in ('swamp/deno.lock', 'swamp/deno.json', 'swamp/deno.jsonc', 'swamp/.swamp.yaml',
                            'tools/swamp-proof-guest/ansible-recaps.php')
                or path.startswith('docs/cli/') and path.endswith('.mmd')):
            jobs['gateway-tests'] = True
        for name in swamp_inputs(path):
            swamp_checks[name] = True
        # Skills and Swamp prose never install application or Swamp toolchains.
        if path.startswith(('.agents/', '.codex/', '.githooks/')) or path.endswith(PROSE) and not path.startswith(('apps/', 'packages/')):
            jobs['docs'] = True
            if path.startswith('docs/cli/') and path.endswith('.mmd'):
                jobs['api-reference'] = True
            continue
        if path.startswith('swamp/'):
            if path.startswith('swamp/proof/'):
                jobs['proof'] = True
            if path == 'swamp/config/gateway-workflow-grants.json':
                jobs['api-reference'] = True
            if path.startswith('swamp/workflows/'):
                jobs['docs'] = True
            continue
        if path.startswith(('.github/', 'bin/', 'tools/', 'scripts/')) or '/' not in path:
            selected = tooling_jobs(path)
            for name in selected:
                jobs[name] = True
            if 'swamp' in selected:
                swamp_checks = dict.fromkeys(swamp_checks, True)
            if path == 'bin/swamp-shape-gate':
                swamp_checks['shape'] = swamp_checks['validate'] = True
            if path == 'bin/check-frozen-agent-commands':
                swamp_checks['shape'] = True
        if path.startswith('apps/gateway/'):
            jobs['gateway-static'] = True
        if path.startswith(('apps/cli/', 'packages/php-sdk/')):
            jobs['cli-static'] = True
        if path.startswith('packages/php-sdk/'):
            jobs['sdk-static'] = True
        if path.startswith('apps/e2e/'):
            jobs['e2e-static'] = True
        # The PHP job verifies the pin against the published Linux binary's contract.
        if path.startswith('apps/gateway/resources/agent/'):
            jobs['php'] = True
        if path.endswith('.php') or path.endswith(('composer.json', 'composer.lock')):
            jobs['php'] = True
        if path.startswith(('apps/cli/tests/', 'apps/gateway/tests/', 'packages/php-sdk/tests/')):
            continue
        if path.startswith(('apps/cli/', 'packages/php-sdk/')):
            jobs['cli'] = jobs['api-reference'] = jobs['web'] = True
        if path.startswith(('docs/', 'apps/docs/')):
            jobs['docs'] = True
        if path == 'docs/cli/flows-pending.txt':
            jobs['api-reference'] = True
        if path.startswith('apps/gateway/'):
            jobs['api-reference'] = jobs['web'] = True
        if path.startswith('apps/web/'):
            jobs['web'] = True
            if path.startswith(('apps/web/tools/api-types/', 'apps/web/fixtures/')):
                jobs['api-reference'] = True
        if path.startswith('apps/pi-server/') and not path.endswith(('.md', '.mdx')):
            jobs['pi'] = True
        if (path.startswith('apps/agent/') or re.match(r'apps/gateway/extensions/[^/]+/agent/', path)) and not path.endswith(('.md', '.mdx')):
            agent = jobs['agent'] = True
    jobs['swamp'] = any(swamp_checks.values())
    jobs['web'] |= main
    if selection is None and (ROOT / SELECTION).is_file():
        selection = (ROOT / SELECTION).read_text()
    return {'jobs': jobs, 'swamp_checks': swamp_checks, 'agent': agent, 'gateway_release': main or not swamp_only,
            'proof_run': proof_run(paths, selection)}


def swamp_comparison_base(base, head):
    """The first import compares against its retained source; later changes use Orbit's base."""
    if subprocess.run(['git', 'cat-file', '-e', f'{base}:swamp'],
                      stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=60).returncode == 0:
        return base
    source = json.loads(subprocess.check_output(
        ['git', 'show', f'{head}:swamp/import-source.json'], timeout=60))['shape_base']
    if not isinstance(source, str) or not re.fullmatch('[0-9a-f]{40}', source):
        raise ValueError('The Swamp import source must be a full commit SHA')
    subprocess.run(['git', 'merge-base', '--is-ancestor', source, head], check=True,
                   stderr=subprocess.PIPE, timeout=60)
    return source


def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument('--base', required=True)
    p.add_argument('--head', default='HEAD')
    p.add_argument('--main', action='store_true')
    p.add_argument('--proof-cases', action='store_true', help='Compare case definitions at the merge base and head')
    p.add_argument('--github-output', type=Path)
    p.add_argument('--proof-selection-output', type=Path)
    p.add_argument('--swamp-base', action='store_true', help='Resolve the retained source for the first history import')
    a = p.parse_args()
    paths = subprocess.check_output(['git', 'diff', '--name-only', '--no-renames', '-z', a.base, a.head], timeout=60).decode().rstrip('\0').split('\0')
    result = select(paths, a.main)
    # Build jobs may use a shallow checkout. Only the full-history changes job needs the case plan.
    if a.proof_cases:
        base = subprocess.check_output(['timeout', '60', 'git', 'merge-base', a.base, a.head], text=True).strip()
        paths = subprocess.check_output(['timeout', '60', 'git', 'diff', '--name-only', '--no-renames', '-z', base, a.head], text=True).rstrip('\0').split('\0')
        def read(ref, path):
            process = subprocess.run(['timeout', '60', 'git', 'show', f'{base if ref == "base" else a.head}:{path}'], capture_output=True, text=True)
            if process.returncode:
                exists = subprocess.run(['timeout', '60', 'git', 'cat-file', '-e', f'{base if ref == "base" else a.head}:{path}'], capture_output=True)
                if exists.returncode == 1 or exists.returncode == 128:
                    return None
                raise ValueError(process.stderr)
            return process.stdout
        files = subprocess.check_output(['timeout', '60', 'git', 'ls-tree', '-r', '--name-only', a.head, '--', 'swamp/proof'], text=True).splitlines()
        files = [file for file in files if re.fullmatch(r'swamp/proof/[a-z][a-z0-9_]*/[a-z][a-z0-9_-]*\.cases\.yaml', file)]
        result['proof_cases'] = proof_cases(paths, read('head', SELECTION), read, files)
        result['proof_run'] = result['proof_cases'] is None or any(entry['only'] is None or entry['only'] for entry in result['proof_cases'])
        if a.proof_selection_output:
            head = subprocess.check_output(['timeout', '60', 'git', 'rev-parse', a.head], text=True).strip()
            a.proof_selection_output.write_text(json.dumps({'version': 1, 'base': base, 'head': head, 'files': result['proof_cases']}))
    if a.swamp_base and result['jobs']['swamp']:
        result['swamp_base_ref'] = swamp_comparison_base(a.base, a.head)
    print(json.dumps(result))
    if a.github_output:
        with a.github_output.open('a') as output:
            for name, value in result.items():
                encoded = value if isinstance(value, str) else json.dumps(value, separators=(',', ':'))
                output.write(f'{name}={encoded}\n')


if __name__ == '__main__':
    main()
