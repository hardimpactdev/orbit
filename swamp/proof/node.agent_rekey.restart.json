{
  "kind": "node.agent_rekey.restart",
  "workflow": "operation-node-agent-rekey",
  "topology": "minimal",
  "budget_seconds": 120,
  "queue_timeout_seconds": 30,
  "clean_target": [
    [
      "sh",
      "-c",
      "if test -f /usr/local/bin/orbit-agent.proof; then mv /usr/local/bin/orbit-agent.proof /usr/local/bin/orbit-agent && systemctl restart orbit-agent.service; fi"
    ]
  ],
  "prepare": [],
  "before_target": [
    [
      "sh",
      "-c",
      "cp /etc/orbit/agent/secret /tmp/proof-secret-${proof.run} && mv /usr/local/bin/orbit-agent /usr/local/bin/orbit-agent.proof"
    ]
  ],
  "request": {
    "artisan": "orbit:node-agent-rekey",
    "arguments": {
      "node": "${node.target}",
      "--attempt": "2"
    }
  },
  "expect": {
    "status": "failed"
  },
  "phases": [
    {
      "name": "Write the new agent key",
      "job": "rekey",
      "step": "Write the new agent key",
      "budget_seconds": 40
    }
  ],
  "parity": [
    "swamp/proof/node.agent_rekey/parity.py",
    "failed"
  ]
}
