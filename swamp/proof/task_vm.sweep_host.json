{
  "kind": "task_vm.sweep_host",
  "workflow": "operation-task-vm-sweep",
  "topology": "app-dev",
  "budget_seconds": 300,
  "queue_timeout_seconds": 10,
  "prepare": [
    {
      "argv": [
        "orbit",
        "database:create",
        "sweep-cache-${proof.run}",
        "--driver=redis",
        "--node=${topology.gateway.node_id}",
        "--host=${topology.gateway.wireguard_ip}",
        "--port=6379",
        "--database=0",
        "--json"
      ]
    },
    {
      "argv": [
        "orbit",
        "extension:enable",
        "ai-router",
        "--json"
      ]
    },
    {
      "argv": [
        "orbit",
        "ai-router:setup",
        "--node=${topology.gateway.node_id}",
        "--cache-connection=sweep-cache-${proof.run}",
        "--cliproxy-url=http://${topology.gateway.wireguard_ip}:8317",
        "--cliproxy-management-key-file=/etc/orbit/swamp-proof/cliproxy-management-key",
        "--json"
      ]
    },
    {
      "argv": [
        "orbit",
        "extension:enable",
        "tasks",
        "--json"
      ]
    },
    {
      "argv": [
        "orbit",
        "node:settings",
        "${topology.app-dev.node_id}",
        "--setting=task_vms:{\"project\":\"orbit-proof-sweep\",\"pool\":\"orbit-proof-sweep\",\"network\":\"orbittaskproof\",\"cidr\":\"10.251.250.0/24\",\"max_vms\":2}",
        "--json"
      ]
    },
    {
      "argv": [
        "orbit",
        "project:create",
        "sweep-${proof.run}",
        "monorepo",
        "${proof.repo.url}",
        "--root=.",
        "--task-workspace-routed=false",
        "--json"
      ],
      "capture": {
        "project_id": "$.id"
      }
    },
    {
      "argv": [
        "orbit",
        "tasks:create",
        "Sweep proof ${proof.run}",
        "--project=${capture.project_id}",
        "--brief=Own one disposable VM for sweep parity.",
        "--orchestration=external",
        "--status=todo",
        "--subtasks=/home/orbit/orbit/swamp/proof/task_vm.sweep_host/subtasks.json",
        "--json"
      ],
      "capture": {
        "group_id": "$.id"
      }
    },
    {
      "argv": [
        "orbit",
        "tasks:provision",
        "${capture.group_id}",
        "--json"
      ],
      "capture": {
        "task_vm_id": "$.result.task_vm_id"
      }
    },
    {
      "argv": [
        "orbit",
        "tasks:cancel",
        "${capture.group_id}",
        "--yes",
        "--json"
      ],
      "capture": {
        "cancel_operation_id": "$.id"
      }
    }
  ],
  "before_request": [
    {
      "argv": [
        "python3",
        "-I",
        "prepare.py",
        "${capture.task_vm_id}",
        "${topology.app-dev.node_id}",
        "${capture.group_id}",
        "${capture.cancel_operation_id}"
      ],
      "timeout_seconds": 90
    }
  ],
  "request": {
    "artisan": [
      "schedule:test",
      "--name=App\\Jobs\\TaskVms\\SweepTaskVmHosts"
    ],
    "select": {
      "kind": "task_vm.sweep_host",
      "target_type": "task_vm_sweep",
      "target_id": "${topology.app-dev.node_id}",
      "count": 1
    }
  },
  "envelope": {
    "node_id": "${topology.app-dev.node_id}",
    "provider": "incus",
    "deadline_at": "${match.positive_int}",
    "ci_runner": false,
    "scope": {
      "project": "orbit-proof-sweep",
      "pool": "orbit-proof-sweep",
      "live_names": [],
      "max_task_vm_id": "${capture.task_vm_id}"
    }
  },
  "expect": {
    "status": "succeeded",
    "outputs": {
      "job": "sweep",
      "step": "result",
      "match": {
        "ready": true
      }
    }
  },
  "phases": [
    {
      "name": "sweep",
      "job": "sweep",
      "step": "incus",
      "budget_seconds": 225
    }
  ],
  "parity": {
    "command": [
      "python3",
      "-I",
      "swamp/proof/task_vm.sweep_host/parity.py",
      "${capture.task_vm_id}"
    ],
    "cases": [
      "real-public-receipt-matches-deleted-set",
      "real-orphan-absent-on-target",
      "real-topology-volume-absent-on-target"
    ]
  }
}
