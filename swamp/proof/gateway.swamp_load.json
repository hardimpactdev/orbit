{
  "kind": "gateway.swamp_load",
  "workflow": "operation-gateway-swamp-load",
  "topology": "minimal",
  "budget_seconds": 600,
  "queue_timeout_seconds": 120,
  "before_gateway": [
    [
      "python3",
      "swamp/proof/gateway.swamp_load/prepare.py"
    ]
  ],
  "after_prepare": [
    [
      "runuser",
      "-u",
      "orbit",
      "--",
      "php",
      "swamp/proof/gateway.swamp_load/load.php"
    ]
  ],
  "request": {
    "method": "GET",
    "path": "operations/${fixture.operation}"
  },
  "expect": {
    "status": "succeeded"
  },
  "phases": [
    {
      "name": "Move checkout",
      "job": "load",
      "step": "checkout",
      "budget_seconds": 180
    },
    {
      "name": "Write gateway grants",
      "job": "load",
      "step": "grants-gateway",
      "budget_seconds": 60
    },
    {
      "name": "Write serve grants",
      "job": "load",
      "step": "grants-serve",
      "budget_seconds": 60
    },
    {
      "name": "Load the release",
      "job": "load",
      "step": "load",
      "budget_seconds": 300
    }
  ],
  "parity": "swamp/proof/gateway.swamp_load/parity.py"
}
