{
  "kind": "node.role_add.websocket",
  "workflow": "operation-node-role-add",
  "topology": "minimal",
  "clean": false,
  "budget_seconds": 1800,
  "queue_timeout_seconds": 30,
  "before_gateway": [
    ["apt-get", "update"],
    ["apt-get", "install", "--yes", "python3-venv"],
    ["python3", "-m", "venv", "/opt/orbit/ansible/venv"],
    ["/opt/orbit/ansible/venv/bin/pip", "install", "--disable-pip-version-check", "-r", "swamp/ansible/requirements.txt"],
    ["/opt/orbit/ansible/venv/bin/ansible-galaxy", "collection", "install", "-r", "swamp/ansible/requirements.yml", "-p", "/opt/orbit/ansible/collections"],
    [
      "runuser",
      "-u",
      "orbit",
      "--",
      "php",
      "swamp/proof/node.role_add/prepare.php",
      "${node.gateway}",
      "websocket"
    ],
    ["systemctl", "stop", "orbit-websocket.service"],
    [
      "runuser",
      "-u",
      "orbit",
      "--",
      "php",
      "swamp/proof/node.role_add/prepare.php",
      "${node.metrics}",
      "websocket"
    ],
    ["incus", "file", "push", "/home/orbit/.orbit/ca/root.pem", "metrics/usr/local/share/ca-certificates/orbit-managed-root-ca.crt"],
    ["ufw", "allow", "in", "on", "oeproof", "proto", "tcp", "from", "10.231.0.11", "to", "10.231.0.1", "port", "443", "comment", "proof-reverb-gateway"],
    ["incus", "exec", "metrics", "--", "sh", "-c", "sed -i '/gateway\\.orbit/d' /etc/hosts; printf '10.231.0.1 gateway.orbit\\n' >> /etc/hosts; update-ca-certificates"]
  ],
  "request": {
    "method": "POST",
    "path": "nodes/${node.metrics}/roles",
    "body": {
      "role": "websocket"
    }
  },
  "expect": {
    "status": "succeeded"
  },
  "phases": [
    {
      "name": "Apply role prerequisites",
      "job": "prerequisites",
      "step": "Apply role prerequisites",
      "budget_seconds": 900
    },
    {
      "name": "Apply the role on the Node",
      "job": "node",
      "step": "Apply the role on the Node",
      "budget_seconds": 900
    },
    {
      "name": "Publish role sites",
      "job": "publication",
      "step": "Publish role sites",
      "budget_seconds": 180
    },
    {
      "name": "Open the firewall",
      "job": "firewall",
      "step": "Open the firewall",
      "budget_seconds": 120
    },
    {
      "name": "Check the role",
      "job": "role",
      "step": "Check the role",
      "budget_seconds": 60
    }
  ],
  "parity": ["swamp/proof/node.role_add/parity.py", "metrics", "websocket"]
}
