{
  "kind": "tasks.maintenance_finish",
  "workflow": "operation-task-cancel",
  "topology": "minimal",
  "clean": true,
  "budget_seconds": 60,
  "queue_timeout_seconds": 30,
  "before_gateway": [
    [
      "sh",
      "-c",
      "home=$(sed -n 's/^ORBIT_HOME=//p' apps/gateway/.env) && install -d -m 0700 -o orbit -g orbit \"$home/locks\""
    ],
    [
      "runuser",
      "-u",
      "orbit",
      "--",
      "env",
      "-C",
      "apps/gateway",
      "php",
      "../../swamp/proof/tasks.maintenance_finish/prepare.php"
    ]
  ],
  "request": {"method": "GET", "path": "operations/${secret.operation}", "body": {}},
  "expect": {"status": "succeeded"},
  "phases": [
    {"name": "check", "job": "cancel", "step": "Check the VM is gone", "budget_seconds": 15}
  ],
  "parity": "swamp/proof/tasks.maintenance_finish/parity.py",
  "limits": "As tasks.cancel: the minimal topology has no task VM host, so this proves admission through the continuation's intent, the shared cleanup run and the completed projection, not the push, Route, teardown or destroy paths."
}
