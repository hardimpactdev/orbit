{
  "kind": "node.role_add",
  "workflow": "operation-node-role-add-direct",
  "budget_seconds": 120,
  "queue_timeout_seconds": 30,
  "envelope": {
    "intent": {
      "target": {
        "schema_version": 1,
        "node_id": "${proof.target.node_id}",
        "assignment_id": 2,
        "created": true,
        "role": "database",
        "user": "${proof.target.user}",
        "agent_sha256": "bdea47122857fc91744c5121856bff82dc6d3153339f539ce3ce07185eb6b9aa",
        "prerequisites": {
          "releases": [
            "resolute"
          ],
          "packages": [
            "docker.io"
          ],
          "apps_directory": false,
          "composer_home": false
        },
        "ssh": {
          "control_node_id": "${proof.control.node_id}",
          "identity_file": "${proof.control.identity_file}",
          "public_key": "${proof.control.public_key}",
          "target": {
            "name": "target",
            "host": "${proof.target.host}",
            "user": "${proof.target.user}",
            "port": "${proof.target.port}",
            "host_keys": "${proof.target.host_keys}"
          }
        },
        "footprint": {
          "schema_version": 1,
          "node_id": "${proof.target.node_id}",
          "agent_sha256": "bdea47122857fc91744c5121856bff82dc6d3153339f539ce3ce07185eb6b9aa",
          "force_artifacts": false,
          "first_visit": false,
          "artifacts": [
            {
              "name": "agent",
              "digest": "9980885eccae2389f9e67ad9df5b7beceed3fb2a80ae3f2a7447f8ac6782924e",
              "required": true,
              "repair": false
            }
          ],
          "payloads": {
            "agent": {
              "configuration": "gateway_url = \"https://127.0.0.1:9\"\n",
              "certificate": "public fixture root",
              "unit": "# Managed by Orbit: agent\n[Unit]\nDescription=Orbit Node agent\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\nExecStart=/usr/local/bin/orbit-agent\nRestart=always\nRestartSec=2\nUser=root\nGroup=root\nCapabilityBoundingSet=\nNoNewPrivileges=yes\nProtectSystem=strict\nProtectHome=yes\nPrivateTmp=yes\nMemoryMax=128M\nRestrictAddressFamilies=AF_UNIX AF_INET AF_INET6\n\n[Install]\nWantedBy=multi-user.target\n",
              "checkouts": [],
              "user": "${proof.target.user}",
              "apps_root": null,
              "url": "https://github.com/hardimpactdev/orbit/releases/download/agent-v0123456789abcdef0123456789abcdef01234567/orbit-agent-linux-x86_64"
            }
          },
          "network": null,
          "refusal": null
        },
        "cli": {
          "user": "${proof.target.user}",
          "release": {
            "version": "0.4681.0",
            "url": "https://github.com/hardimpactdev/orbit/releases/download/cli-v0.4681.0/orbit-0.4681.0-linux-x86_64",
            "sha256": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
          },
          "profile": "{}\n",
          "skip_reason": null,
          "plan_error": null
        },
        "metrics_fleet": null
      }
    },
    "execution_secrets": {
      "observer": {
        "vault": "orbit-control-inputs",
        "key": "node-role-1-observer"
      }
    },
    "operation_id": "${proof.operation_id}",
    "kind": "node.role_add",
    "node_id": "${proof.target.node_id}"
  },
  "secrets": [
    {
      "vault": "orbit-control-inputs",
      "key": "node-role-1-observer",
      "value": "generate:hex32"
    }
  ],
  "expect": {
    "status": "succeeded",
    "outputs": {
      "job": "result",
      "step": "result",
      "match": {
        "ready": true,
        "target_completed": true
      }
    }
  },
  "phases": [
    {
      "name": "target-prerequisites",
      "job": "target",
      "step": "packages",
      "budget_seconds": 60
    },
    {
      "name": "target-contribution",
      "job": "target",
      "step": "role_result",
      "budget_seconds": 10
    }
  ],
  "parity": {
    "command": [
      "python3",
      "-I",
      "swamp/proof/node.role_add/parity.py"
    ],
    "cases": [
      "same-admitted-assignment",
      "target-role-runtime-ready",
      "new-assignment-created"
    ]
  }
}
