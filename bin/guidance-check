#!/usr/bin/env bash

# Guidance must not reuse Blade files owned by another gate user.
set -euo pipefail
exec "$(dirname "${BASH_SOURCE[0]}")/pest-plain" bash -c '
    mkdir -m 700 "$TMPDIR/views"
    export VIEW_COMPILED_PATH="$TMPDIR/views"
    exec vendor/bin/pest --configuration=phpunit.guidance.xml --compact "$@"
' guidance-check "$@"
