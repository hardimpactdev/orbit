#!/usr/bin/env bash
# run-effect <marker-dir> <stage>
# Runs one effect script for one idempotency key, detached from the swamp
# process that launched it. The marker dir holds env (inputs), pid, log and,
# when finished, result.json. A result.json that already exists means the key
# is done: the effect never runs twice for one key.
set -euo pipefail
# Effects run with a minimal environment. Agent markers inherited from the
# launching session (CLAUDECODE, AI_AGENT, ...) switch Pest to agent output
# and break Orbit's own tests; a cron or serve launch would not have them.
if [ -z "${RUN_EFFECT_CLEAN:-}" ]; then
  exec env -i RUN_EFFECT_CLEAN=1 HOME="$HOME" USER="${USER:-$(id -un)}" LOGNAME="${USER:-$(id -un)}" \
    PATH="$PATH" LANG="${LANG:-C.UTF-8}" TERM=dumb TMPDIR="${TMPDIR:-/tmp}" \
    COMPOSER_HOME="${COMPOSER_HOME:-$HOME/.config/composer}" "$0" "$@"
fi
dir="$1"
stage="$2"
here="$(cd "$(dirname "$0")" && pwd)"
[ -f "$dir/result.json" ] && exit 0
# One job per key: a second launch while the first still runs exits at once.
exec 9>"$dir/lock"
flock -n 9 || exit 0
[ -f "$dir/result.json" ] && exit 0

set -a
# shellcheck disable=SC1091
. "$dir/env"
set +a
export RESULT="$dir/result.json" INPUTS="$dir/inputs.json"
echo $$ > "$dir/pid"
date -u +%FT%TZ >> "$dir/attempts"

set +e
script="$here/effects/$stage.sh"
[ -f "${SCRATCH_ROOT:-/fast/apps/orbit-swamp-scratch}/fake/$WORK_ITEM.json" ] && script="$here/effects/fake.sh"
STAGE="$stage" "$script" >> "$dir/effect.log" 2>&1
code=$?
set -e
if [ ! -f "$dir/result.json" ]; then
  # The script died without a result; record a failure the driver can act on.
  jq -n --argjson code "$code" --arg tail "$(tail -c 8000 "$dir/effect.log")" \
    '{status:"failed", exitCode:$code, error:"effect exited without a result", outputTail:$tail}' > "$dir/result.json"
fi
rm -f "$dir/pid"
