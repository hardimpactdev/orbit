#!/usr/bin/env bash
# The permanent Gateway Node entry point. Swamp runs each phase from the admitted commit.
set -euo pipefail
phase=$1 sha=$2 operation=$3
shift 3
[[ $sha =~ ^[a-f0-9]{40}$ && $operation =~ ^[1-9][0-9]*$ ]] || exit 64
repo=/home/orbit/shared/orbit.git
script=swamp/scripts/gateway-release-container.sh
workflow=swamp/workflows/workflow-gateway-release-activate.yaml
inventory=/home/orbit/.orbit/gateway-containers.json
journal=/var/lib/orbit/gateway-release-switch
check_recovery() {
  local path
  for path in "$script" "$workflow"; do
    if ! git -c safe.directory="$repo" -C "$repo" grep -q '^# orbit-gateway-recovery-protocol: 1$' "$sha" -- "$path"; then
      echo "gateway.release_recovery_incompatible: $sha lacks container recovery protocol 1 in $path" >&2
      return 1
    fi
  done
}
# Manual moves and offline recovery already hold the same lock.
case "$phase" in
  reconcile-idle|reconcile-verify|check-load|check-recovery|switch|restore|switch-back|restore-host|start-horizon|retire|prune|prune-pending|release-unused)
    if [[ ${ORBIT_GATEWAY_RELEASE_LOCK_HELD:-0} != 1 ]]; then
      exec 9</home/orbit/.orbit/gateway-release.lock
      flock -w 130 9 || { echo 'Gateway release lock is busy' >&2; exit 1; }
      export ORBIT_GATEWAY_RELEASE_LOCK_HELD=1
    fi
    ;;
esac
# Check compatibility before starting new work. Recovery of a durable switch
# uses its exact candidate and operation, including switches made before this check.
case "$phase" in
  drain)
    echo 'gateway.release_recovery_incompatible: container Horizon must drain inside the journaled switch' >&2
    exit 1
    ;;
  reconcile-idle|reconcile-verify|build|build-checked|switch|restore-host|check-recovery|check-load)
    [[ ! -e $journal/operation ]] || { echo 'Recover the interrupted Gateway switch with --recover first' >&2; exit 1; }
    if [[ $phase != check-load || -f $inventory ]]; then check_recovery; fi
    ;;
  restore|switch-back|start-horizon|retire)
    if [[ -e $journal/operation || $phase == restore || $phase == switch-back ]]; then
      [[ -f $journal/operation && -f $journal/candidate &&
        $(cat "$journal/operation") == "$operation" && $(cat "$journal/candidate") == "$sha" ]] ||
        { echo 'There is no matching Gateway switch' >&2; exit 1; }
    fi
    ;;
esac
# The native workflow uses the checked entry points so an older installed
# dispatcher refuses before Build or Load can change the target.
if [[ $phase == check-recovery || $phase == check-load ]]; then exit 0; fi
# Reconcile the exact serving container through its existing read-only checks.
# Never resume, build or hand over a release when the caller asks to recover definitions.
if [[ $phase == reconcile-idle || $phase == reconcile-verify ]]; then
  [[ -f $inventory && $(jq -er '.live' "$inventory") == "$sha" ]] || {
    echo 'gateway.release_reconcile_not_live: the requested commit no longer serves traffic' >&2; exit 1;
  }
  if [[ $phase == reconcile-idle ]]; then
    bash <(git -c safe.directory="$repo" -C "$repo" show "$sha:$script") wait-idle "$sha" "$operation" >&2
  fi
  phase=public-ready
fi
if [[ $phase == build-checked ]]; then phase=build; fi
# A failed deletion must complete before a new build can reuse the previous SHA.
if [[ $phase == build && -f $journal/pending-prune ]]; then
  "$0" prune-pending "$sha" "$operation"
fi
if [[ $phase == retire ]]; then
  # Avoid handing the scheduler over at the first or last two seconds of a minute.
  second=$((10#$(date -u +%S)))
  if (( second < 2 )); then sleep "$((2-second))"; elif (( second >= 58 )); then sleep "$((62-second))"; fi
fi
# Cleanup belongs to the current host controller, including a rollback to an older
# sealed release whose script predates this phase. A failed fetch can have no object.
if [[ $phase == park-preparation || $phase == release-unused ]]; then
  candidate=gateway-${sha:0:12}
  incus_cli=(incus --force-local --project orbit-releases)
  ctl() { python3 <(git -c safe.directory="$repo" -C "$repo" show "$sha:swamp/scripts/release-container.py") "$@"; }
  if [[ $phase == park-preparation ]]; then
    if [[ $("${incus_cli[@]}" config get prepare-gateway user.orbit.release.operation) == "$operation" ]]; then ctl sleep gateway "$operation"; fi
    exit
  fi
  # A failed run may have woken the rollback container or left its new clone private.
  # The operation that created the clone and the serving inventory fence deletion.
  if [[ ! -f $inventory && ${ORBIT_GATEWAY_INITIAL_MOVE:-0} != 1 ]]; then exit 0; fi
  if [[ -e $journal/operation ]]; then
    [[ ! -e $inventory && -f $journal/host-fallback/verified &&
      $(cat "$journal/operation") == "$operation" && $(cat "$journal/candidate") == "$sha" ]] ||
      { echo 'Unfinished traffic switch needs recovery' >&2; exit 1; }
  fi
  # A refused rollback never woke the retained release. Leave it alone.
  old=
  if [[ -f $inventory ]]; then old=$(jq -r '.old // ""' "$inventory"); fi
  if [[ $old == "$sha" ]] && ! check_recovery 2>/dev/null; then exit 0; fi
  # A failed Incus copy can leave only the preparer snapshot. Check the seal that
  # created it rather than trusting the name of a snapshot or the current preparer.
  snapshot="built-$operation"
  snapshots=$("${incus_cli[@]}" snapshot list prepare-gateway --format json)
  if jq -e --arg name "$snapshot" 'any(.[]; .name==$name)' <<< "$snapshots" >/dev/null; then
    jq -e --arg name "$snapshot" --arg op "$operation" --arg sha "$sha" '
      any(.[]; .name==$name and .config["user.orbit.release.target"]=="gateway"
        and .config["user.orbit.release.role"]=="prepare" and .config["user.orbit.release.operation"]==$op
        and .config["user.orbit.release.commit"]==$sha)' <<< "$snapshots" >/dev/null || {
          echo 'Refusing to remove a snapshot with a different identity' >&2; exit 1;
        }
    "${incus_cli[@]}" snapshot delete prepare-gateway "$snapshot"
  fi
  if [[ -f $inventory && $(jq -er '.live' "$inventory") == "$sha" ]]; then exit 0; fi
  if [[ $old == "$sha" ]]; then
    ctl retire gateway "${sha:0:12}" "$operation"
    exit
  fi
  existing=$("${incus_cli[@]}" list "$candidate" --format json | jq -ce --arg name "$candidate" 'map(select(.name==$name))|first // {}')
  if [[ $existing != '{}' || ! -f $journal/operation ]]; then
    if [[ $(jq -r '.config["user.orbit.release.operation"] // ""' <<< "$existing") != "$operation" ]]; then
      [[ ! -f $journal/operation ]] || { echo 'Refusing to clean up a clone from another operation' >&2; exit 1; }
      exit 0
    fi
    jq -e --arg sha "$sha" '.config | .["user.orbit.release.target"]=="gateway" and .["user.orbit.release.commit"]==$sha and .["user.orbit.release.role"]=="candidate" and .["boot.autostart"]=="false"' <<< "$existing" >/dev/null
    "${incus_cli[@]}" delete "$candidate" --force
  fi
  ctl forget gateway "${sha:0:12}"
  if [[ ! -f $journal/operation ]]; then rm -f -- "$journal/rollback-$sha"; fi
  exit
fi
git -c safe.directory="$repo" -C "$repo" cat-file -e "$sha:$script"
exec bash <(git -c safe.directory="$repo" -C "$repo" show "$sha:$script") "$phase" "$sha" "$operation" "$@"
