{
  "kind": "process.stop.docker",
  "workflow": "operation-process-stop",
  "topology": "minimal",
  "budget_seconds": 180,
  "queue_timeout_seconds": 30,
  "expect": {
    "status": "succeeded"
  },
  "prepare": [
    {
      "method": "POST",
      "path": "processes",
      "body": {
        "target_type": "node",
        "target_id": "${node.target}",
        "name": "dstop-${proof.run}",
        "runtime": "docker",
        "image": "busybox:1.36",
        "command": [
          "sleep",
          "infinity"
        ],
        "start": true
      },
      "bind": "process"
    }
  ],
  "request": {
    "method": "POST",
    "path": "processes/${process.id}/stop"
  },
  "phases": [
    {
      "name": "Apply the unit state",
      "job": "runtime",
      "step": "Apply the unit state",
      "budget_seconds": 20
    },
    {
      "name": "Accept the Process",
      "job": "runtime",
      "step": "Accept the Process",
      "budget_seconds": 20
    }
  ],
  "parity": [
    "swamp/proof/process/parity.py",
    "stopped"
  ]
}
