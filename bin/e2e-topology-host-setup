#!/usr/bin/env bash
# Prepares a task VM to run E2E topologies (ADR 0222): it adopts the VM's clone of the topology seed as the Incus
# pool `topology-seed`, which holds the stopped VM `node-template`, and installs an nftables table and UFW rules that
# keep topology guests away from this machine's own WireGuard network. The VM's image carries Incus and QEMU.
# Idempotent. Run with sudo.
set -euo pipefail

pool=topology-seed
template=node-template
seed_device=topology-seed
# Incus names a VM disk's SCSI serial `incus_<device>` with each `-` doubled, and udev links it by that serial.
device=/dev/disk/by-id/scsi-0QEMU_QEMU_HARDDISK_incus_${seed_device//-/--}
wireguard_interface=orbit
wireguard_subnet=10.44.0.0/24

usage() {
    cat >&2 <<'USAGE'
usage: sudo bin/e2e-topology-host-setup [--wireguard-interface=NAME] [--wireguard-subnet=CIDR]

  --wireguard-interface=NAME    this machine's own WireGuard interface (default orbit)
  --wireguard-subnet=CIDR       the WireGuard network topology guests must not reach (default 10.44.0.0/24)
USAGE
    exit 64
}

for argument in "$@"; do
    case $argument in
        --wireguard-interface=*) wireguard_interface=${argument#*=} ;;
        --wireguard-subnet=*) wireguard_subnet=${argument#*=} ;;
        *) usage ;;
    esac
done
[[ $wireguard_interface =~ ^[a-zA-Z0-9_.-]{1,15}$ ]] || usage
[[ $wireguard_subnet =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}/[0-9]{1,2}$ ]] || usage
[[ $(id -u) -eq 0 ]] || { echo 'e2e-topology-host-setup: run it with sudo.' >&2; exit 1; }

step() {
    printf 'e2e-topology-host-setup: %s\n' "$1" >&2
}

step 'topology seed'
[[ -e /dev/kvm ]] || { echo 'e2e-topology-host-setup: /dev/kvm is missing; topology VMs need (nested) KVM.' >&2; exit 1; }
if ! incus storage show "$pool" >/dev/null 2>&1 </dev/null; then
    [[ -b $device ]] || {
        echo 'e2e-topology-host-setup: this machine has no topology seed disk; only a task VM of a size that runs a topology boots with one.' >&2
        exit 1
    }
    # `incus admin recover` asks its questions on a terminal. Its API takes the pool directly: validate reports what
    # recovery would import and what it lacks, and import creates the pool and the instances on it.
    recovery=$(printf '{"pools":[{"name":"%s","driver":"btrfs","config":{"source":"%s"}}]}' "$pool" "$device")
    validation=$(incus query --request POST --data "$recovery" /internal/recover/validate </dev/null)
    errors=$(python3 -c 'import json, sys; print("; ".join(json.load(sys.stdin).get("DependencyErrors") or []))' <<<"$validation")
    [[ -z $errors ]] || { echo "e2e-topology-host-setup: the topology seed cannot be adopted: $errors" >&2; exit 1; }
    incus query --request POST --data "$recovery" /internal/recover/import </dev/null >/dev/null
fi
[[ $(incus list --format csv --columns ns -- "$template" </dev/null) == "$template,STOPPED" ]] \
    || { echo "e2e-topology-host-setup: the pool $pool holds no stopped $template." >&2; exit 1; }

step 'isolation'
install -d -m 0755 /etc/orbit-e2e
# Its own table, at a priority before the filter table: the harness inserts its own forward rules at the
# filter hook for each topology network. Incus uses nftables (including 6.0.5); the harness also adds forwarding rules through Ubuntu's iptables-nft backend.
cat >/etc/orbit-e2e/isolation.nft <<NFT
table inet orbit-e2e-isolation
delete table inet orbit-e2e-isolation
table inet orbit-e2e-isolation {
    chain forward {
        type filter hook forward priority -10; policy accept;
        iifname "oe*" oifname "$wireguard_interface" drop
    }
    chain input {
        type filter hook input priority -10; policy accept;
        iifname "oe*" ip daddr $wireguard_subnet drop
    }
}
NFT
cat >/etc/systemd/system/orbit-e2e-isolation.service <<'UNIT'
[Unit]
Description=Keep E2E topology guests away from this machine's WireGuard network
DefaultDependencies=no
Before=network-pre.target incus.service
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/orbit-e2e/isolation.nft

[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable orbit-e2e-isolation.service >/dev/null
# A task VM runs UFW with incoming and routed traffic denied. Topology guests then get no DHCP or DNS from their
# network and cannot route out. Allow exactly that; the table above still drops their traffic to the WireGuard
# network, because a drop in any table is final.
if ufw status 2>/dev/null | grep -qx 'Status: active'; then
    ufw allow in on 'oe+' to any port 67 proto udp comment 'orbit-e2e dhcp' >/dev/null
    ufw allow in on 'oe+' to any port 53 proto udp comment 'orbit-e2e dns' >/dev/null
    ufw route allow in on 'oe+' comment 'orbit-e2e guests' >/dev/null
fi
systemctl restart orbit-e2e-isolation.service
nft list table inet orbit-e2e-isolation >/dev/null

step 'ready'
printf '{"state":"ready","pool":"%s","template":"%s","isolation":"inet orbit-e2e-isolation"}\n' "$pool" "$template"
