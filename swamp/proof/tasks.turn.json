{
  "kind": "tasks.turn",
  "workflow": "operation-task-turn",
  "topology": "minimal",
  "clean": true,
  "budget_seconds": 180,
  "queue_timeout_seconds": 60,
  "before_gateway": [
    [
      "python3",
      "-I",
      "swamp/proof/tasks.turn/prepare.py",
      "${node.target}",
      "${proof.run}"
    ]
  ],
  "request": {
    "method": "POST",
    "path": "task-groups/${secret.group}/turn",
    "body": {
      "subtask": "${secret.subtask}",
      "role": "reviewer",
      "check": "${secret.check}",
      "prompt": "Complete the synthetic proof turn.",
      "thread": "new"
    }
  },
  "expect": {
    "status": "succeeded"
  },
  "phases": [
    {"name": "outcome", "job": "turn", "step": "outcome", "budget_seconds": 30},
    {"name": "shape_result", "job": "turn", "step": "shape_result", "budget_seconds": 30},
    {"name": "delete_local_artifacts", "job": "turn", "step": "delete_local_artifacts", "budget_seconds": 30},
    {
      "name": "snapshot_before_add",
      "job": "turn",
      "step": "snapshot_before_add",
      "budget_seconds": 60
    },
    {
      "name": "snapshot_before_tree",
      "job": "turn",
      "step": "snapshot_before_tree",
      "budget_seconds": 60
    },
    {
      "name": "snapshot_after_add",
      "job": "turn",
      "step": "snapshot_after_add",
      "budget_seconds": 60
    },
    {
      "name": "snapshot_after_tree",
      "job": "turn",
      "step": "snapshot_after_tree",
      "budget_seconds": 60
    },
    {
      "name": "restore_reset",
      "job": "turn",
      "step": "restore_reset",
      "budget_seconds": 60
    },
    {
      "name": "restore_clean",
      "job": "turn",
      "step": "restore_clean",
      "budget_seconds": 60
    },
    {
      "name": "delete_snapshot_indexes",
      "job": "turn",
      "step": "delete_snapshot_indexes",
      "budget_seconds": 60
    }
  ],
  "parity": "swamp/proof/tasks.turn/parity.py"
}
