{
  "kind": "fleet.peer_dns",
  "workflow": "operation-fleet-peer-dns",
  "topology": "minimal",
  "budget_seconds": 120,
  "queue_timeout_seconds": 60,
  "before_gateway": [
    [
      "bash",
      "tools/swamp-proof-guest/peer-dns-proof.sh",
      "${node.target}",
      "${node.peer}"
    ]
  ],
  "request": {
    "method": "POST",
    "path": "fleet/nodes/${node.peer}/peer-dns"
  },
  "expect": {
    "status": "succeeded"
  },
  "phases": [
    {
      "name": "Keep the DNS hook",
      "job": "dns",
      "step": "Keep the DNS hook",
      "budget_seconds": 30
    },
    {
      "name": "Write the DNS marker",
      "job": "dns",
      "step": "Write the DNS marker",
      "budget_seconds": 30
    },
    {
      "name": "Set the DNS policy",
      "job": "dns",
      "step": "Set the DNS policy",
      "budget_seconds": 30
    },
    {
      "name": "Check resolution",
      "job": "dns",
      "step": "Check resolution",
      "budget_seconds": 30
    }
  ],
  "parity": "swamp/proof/fleet.peer_dns/parity.py"
}
