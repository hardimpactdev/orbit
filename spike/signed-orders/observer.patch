+/// SPIKE(signed-orders): pass the order bytes unchanged to the executor socket and post its reply to the
+/// Gateway with the agent secret. The observer holds no key and does not read the order.
+fn spike_pass_order(client: &reqwest::Client, gateway: &str, value: &Value) {
+    let data: Value = match &value["data"] {
+        Value::String(text) => serde_json::from_str(text).unwrap_or(Value::Null),
+        data => data.clone(),
+    };
+    let Some(order) = data["order"].as_str().map(str::to_owned) else {
+        return;
+    };
+    let received_ns = spike_now_ns();
+    let client = client.clone();
+    let url = format!("{}/api/v1/agent/spike-result", gateway.trim_end_matches('/'));
+    tokio::spawn(async move {
+        let reply = tokio::task::spawn_blocking(move || -> std::io::Result<Vec<u8>> {
+            use std::io::{Read, Write};
+            let mut stream = std::os::unix::net::UnixStream::connect("/run/orbit-spike-exec.sock")?;
+            stream.set_read_timeout(Some(Duration::from_secs(5)))?;
+            stream.write_all(order.as_bytes())?;
+            stream.shutdown(std::net::Shutdown::Write)?;
+            let mut reply = Vec::new();
+            stream.take(4096).read_to_end(&mut reply)?;
+            Ok(reply)
+        })
+        .await;
+        let replied_ns = spike_now_ns();
+        let body = match reply {
+            Ok(Ok(reply)) => reply,
+            Ok(Err(error)) => format!("{{\"status\":\"observer_error\",\"error\":\"{error}\"}}").into_bytes(),
+            Err(_) => return,
+        };
+        if let Err(error) = client
+            .post(url)
+            .header("content-type", "application/json")
+            .header("x-spike-observer-received-ns", received_ns)
+            .header("x-spike-observer-replied-ns", replied_ns)
+            .body(body)
+            .send()
+            .await
+        {
+            eprintln!("orbit-agent: spike result post failed: {}", error.without_url());
+        }
+    });
+}
+
+fn spike_now_ns() -> String {
+    std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map(|d| d.as_nanos().to_string())
+        .unwrap_or_default()
+}
