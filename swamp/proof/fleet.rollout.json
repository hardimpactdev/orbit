{
  "kind": "fleet.rollout",
  "workflow": "operation-fleet-rollout",
  "topology": "minimal",
  "budget_seconds": 900,
  "queue_timeout_seconds": 60,
  "request": {
    "method": "POST",
    "path": "fleet/rollout",
    "body": {
      "node_ids": [
        "${node.target}"
      ]
    }
  },
  "expect": {
    "status": "succeeded"
  },
  "phases": [
    {
      "name": "Publish the CLI and observer on the target",
      "job": "nodes",
      "step": "node-0",
      "budget_seconds": 900
    }
  ],
  "parity": "swamp/proof/fleet.rollout/parity.py",
  "before_gateway": [
    [
      "runuser",
      "-u",
      "orbit",
      "--",
      "php",
      "swamp/proof/fleet.cli_converge/prepare.php"
    ],
    [
      "runuser",
      "-u",
      "orbit",
      "--",
      "sh",
      "-c",
      "grep -q '^ORBIT_FLEET_ROLLOUT=true$' apps/gateway/.env || printf '\\nORBIT_FLEET_ROLLOUT=true\\nORBIT_GATEWAY_CHECKOUT=%s/apps/gateway\\n' \"$PWD\" >> apps/gateway/.env"
    ]
  ]
}
