#!/usr/bin/env bash

set -euo pipefail

cd "$(dirname "$0")/.."

case "${1:---control}" in
    --local)
        php artisan test --compact
        ;;
    --control)
        # This script runs ON the control node (mini). update:all is a control-node
        # operation — run it directly, then verify node:list is reachable.
        php artisan test --compact
        php artisan update:all
        php artisan node:list
        ;;
    -h|--help)
        cat <<'HELP'
usage: bin/live-smoke [--local | --control]

Modes:
  --local    Run the local test suite only.
  --control  Run local tests, then run the idempotent live smoke path:
             update:all (pushes to gateway and beast) and node:list.
             Must be run ON the control node (mini).
HELP
        ;;
    *)
        echo "error: unknown mode '$1'" >&2
        echo "usage: bin/live-smoke [--local | --control]" >&2
        exit 2
        ;;
esac
