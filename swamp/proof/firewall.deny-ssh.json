{
  "kind": "firewall.deny-ssh",
  "workflow": "operation-firewall-direct",
  "topology": "minimal",
  "budget_seconds": 300,
  "expect": {
    "http_status": 422,
    "error_code": "firewall.protected_port"
  },
  "phases": [
    {
      "name": "Read the rules",
      "job": "firewall",
      "step": "Read the rules",
      "budget_seconds": 60
    },
    {
      "name": "Plan the changes",
      "job": "firewall",
      "step": "Plan the changes",
      "budget_seconds": 60
    },
    {
      "name": "Read the result",
      "job": "firewall",
      "step": "Read the result",
      "budget_seconds": 60
    },
    {
      "name": "Check the rules",
      "job": "firewall",
      "step": "Check the rules",
      "budget_seconds": 60
    },
    {
      "name": "accepted",
      "job": "firewall",
      "step": "accepted",
      "budget_seconds": 60
    }
  ],
  "request": {
    "method": "POST",
    "path": "nodes/${node.target}/firewall-rules/deny",
    "body": {
      "port": "22",
      "protocol": "tcp"
    }
  },
  "parity": [
    "swamp/proof/firewall/check.py",
    "-22/tcp DENY Anywhere",
    "-22/tcp (v6) DENY Anywhere (v6)"
  ]
}
