{
  "kind": "node.wireguard_hub_converge",
  "workflow": "operation-node-wireguard-hub-converge",
  "topology": "minimal",
  "budget_seconds": 120,
  "queue_timeout_seconds": 30,
  "before_gateway": [
    [
      "sh",
      "-c",
      "printf '%s' \"$1\" | runuser -u orbit -- env -C apps/gateway php ../../tools/swamp-proof-guest/gateway.php fixture",
      "sh",
      "{\"roles\": {\"${node.target}\": [\"vpn\"]}, \"wireguard_keys\": {\"${node.gateway}\": \"AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE=\", \"${node.operator}\": \"AgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgI=\"}}"
    ]
  ],
  "clean_target": [
    [
      "sh",
      "-c",
      "command -v wg-quick >/dev/null || DEBIAN_FRONTEND=noninteractive apt-get install -y -q wireguard-tools >/dev/null; umask 077; mkdir -p /etc/wireguard; printf '[Interface]\\nAddress = 10.99.0.1/24\\nListenPort = 51820\\nPrivateKey = %s\\n\\n[Peer]\\nPublicKey = AwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwM=\\nAllowedIPs = 10.99.0.99/32\\n' \"$(wg genkey)\" > /etc/wireguard/orbit.conf; systemctl enable wg-quick@orbit >/dev/null 2>&1; systemctl restart wg-quick@orbit"
    ]
  ],
  "request": {
    "method": "POST",
    "path": "nodes/${node.target}/wireguard-hub/converge"
  },
  "expect": {
    "status": "succeeded"
  },
  "phases": [
    {
      "name": "Read the live peers",
      "job": "read",
      "step": "Read the live peers",
      "budget_seconds": 15
    },
    {
      "name": "Set the peers",
      "job": "apply",
      "step": "Set the peers",
      "budget_seconds": 30
    },
    {
      "name": "Remove stale peers",
      "job": "apply",
      "step": "Remove stale peers",
      "budget_seconds": 30
    },
    {
      "name": "Save the config",
      "job": "apply",
      "step": "Save the config",
      "budget_seconds": 30
    },
    {
      "name": "Check the hub service",
      "job": "check",
      "step": "Check the hub service",
      "budget_seconds": 30
    },
    {
      "name": "Read the peers again",
      "job": "check",
      "step": "Read the peers again",
      "budget_seconds": 15
    },
    {
      "name": "Confirm the hub",
      "job": "check",
      "step": "Confirm the hub",
      "budget_seconds": 15
    }
  ],
  "parity": "swamp/proof/node.wireguard_hub_converge/parity.py"
}
