{
  "kind": "node.role_add.analytics.local-storage.repair-port",
  "defaults": "node-role-add-defaults.json",
  "request": {
    "method": "POST",
    "path": "nodes/${node.metrics}/roles",
    "body": {"role": "analytics", "postgres_process_id": "${postgres.id}", "clickhouse_process_id": "${clickhouse.id}", "converge_existing": true}
  },
  "parity": ["swamp/proof/node.role_add/parity.py", "metrics", "analytics", "repair-port"],
  "prepare": [
    {"method": "GET", "path": "processes", "operation": false, "bind": "postgres", "match": {"name": "proof-analytics-postgres"}, "body": {}},
    {"method": "GET", "path": "processes", "operation": false, "bind": "clickhouse", "match": {"name": "proof-analytics-clickhouse"}, "body": {}}
  ],
  "after_prepare": [
    [
      "incus",
      "exec",
      "metrics",
      "--",
      "ufw",
      "--force",
      "delete",
      "allow",
      "in",
      "on",
      "docker0",
      "proto",
      "tcp",
      "to",
      "10.231.0.11",
      "port",
      "5432",
      "comment",
      "orbit:analytics-postgres-local"
    ],
    [
      "incus",
      "exec",
      "metrics",
      "--",
      "ufw",
      "allow",
      "in",
      "on",
      "docker0",
      "proto",
      "tcp",
      "to",
      "10.231.0.11",
      "port",
      "55432",
      "comment",
      "orbit:analytics-postgres-local"
    ],
    ["incus", "exec", "metrics", "--", "ufw", "allow", "55432/tcp", "comment", "proof-kept-other-rule"]
  ]
}
