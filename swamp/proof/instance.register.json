{
  "kind": "instance.register",
  "workflow": "operation-instance-register",
  "topology": "minimal",
  "budget_seconds": 180,
  "queue_timeout_seconds": 30,
  "before_node": {
    "target": [
      [
        "runuser",
        "-u",
        "orbit",
        "--",
        "sh",
        "-eu",
        "-c",
        "base=/home/orbit/apps/proof-source/plain-$1; linked=/home/orbit/apps/proof-source/r-$1; mkdir -p /home/orbit/apps/proof-source; git clone -q --depth=1 --branch 13.x https://github.com/laravel/laravel.git \"$base\"; git -C \"$base\" worktree add -q -b temporary-$1 \"$linked\"; git -C \"$linked\" branch -m renamed-$1",
        "sh",
        "${proof.run}"
      ]
    ]
  },
  "prepare": [
    {
      "method": "POST",
      "path": "projects",
      "operation": false,
      "bind": "project",
      "body": {
        "slug": "proof-source",
        "name": "Proof source",
        "type": "monorepo",
        "root": "public",
        "repository_url": "https://github.com/laravel/laravel.git",
        "default_branch": "13.x"
      }
    },
    {
      "method": "PUT",
      "path": "nodes/${node.target}/access/${node.target}",
      "operation": false
    },
    {
      "method": "POST",
      "path": "projects/${project.id}/setup-steps",
      "operation": false,
      "body": {
        "name": "prepare-env",
        "command": "umask 077; printf 'PRIVATE_SENTINEL=proof-private-setup\\n' > .env; printf 'registered-worktree\\n' > public/proof.txt",
        "timeout_seconds": 10
      }
    },
    {
      "method": "POST",
      "path": "projects/${project.id}/process-definitions",
      "operation": false,
      "body": {
        "name": "proof-server",
        "environments": [
          "development"
        ],
        "spec": {
          "runtime": "systemd",
          "command": [
            "/usr/bin/python3",
            "-m",
            "http.server",
            "8765"
          ],
          "restart_policy": "on-failure"
        }
      }
    },
    {
      "method": "POST",
      "path": "instances/register",
      "caller": "target",
      "operation": false,
      "bind": "plain",
      "body": {
        "source_path": "/home/orbit/apps/proof-source/plain-${proof.run}",
        "project_id": "${project.id}"
      }
    }
  ],
  "request": {
    "method": "POST",
    "path": "instances/register",
    "bind": "instance",
    "body": {
      "source_path": "/home/orbit/apps/proof-source/r-${proof.run}",
      "project_id": "${project.id}",
      "instance_name": "r-${proof.run}",
      "setup": true,
      "domain": "r-${proof.run}.proof-source.test"
    },
    "caller": "target"
  },
  "expect": {
    "status": "succeeded"
  },
  "phases": [
    {
      "name": "setup",
      "job": "register",
      "step": "Run Project setup steps-0",
      "budget_seconds": 15
    },
    {
      "name": "processes",
      "job": "register",
      "step": "Create, start Processes-0",
      "budget_seconds": 90
    },
    {
      "name": "route",
      "job": "register",
      "step": "Create the Route",
      "budget_seconds": 60
    }
  ],
  "parity": "swamp/proof/instance.register/parity.py",
  "before_gateway": [
    [
      "sleep",
      "5"
    ]
  ]
}
