#!/usr/bin/env python3
"""Run the Swamp shape gate and the Swamp workflow validation, the same steps CI runs.

CI's "Swamp shape gate" and "Swamp workflow validate" jobs call this script, and bin/review-check
(root `composer check`) calls it when a change selects the Swamp checks. Run it from any directory
before you push; commit first, because the checkers compare committed HEAD with the base.

--base REF         compare with REF (default: the merge base with origin/main)
--only shape       run only the shape group; --only validate runs only the validation group
--reports DIR      write the JSON reports here (default: a per-user directory in the temp directory)
--cache DIR        Swamp runtime cache for the validation (default: ~/.cache/orbit-shape-runtime)
--tools DIR        cache of the pinned tool venvs (default: /opt/orbit-shape-gate when the task image holds tools
                   for these pins, else ~/.cache/orbit-shape-gate)
--shard I/3        run one deterministic file partition (requires --only shape)
--control-only     run the four source ratchets once (requires --only shape)
--workers N        maximum concurrent independent shape commands (default: up to four available CPUs)
--strict           fail instead of skipping a step that needs a credential or a tool

The linters are pinned in swamp/ansible/shape-gate-requirements.txt, the only place that names them.
The task VM role playbook builds them into /opt/orbit-shape-gate, so a task VM runs the gate without a download.
Native workflow validation needs a Swamp account. It reads only SWAMP_API_KEY and SWAMP_SIGNIN_TOKEN.
Without them it is skipped and reported as skipped, not passed. `--only validate` then exits 78."""
import argparse
from concurrent.futures import ThreadPoolExecutor, as_completed
from itertools import groupby
import fcntl
import hashlib
import json
import os
import re
import runpy
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SWAMP = ROOT / 'swamp'
REQUIREMENTS = SWAMP / 'ansible/shape-gate-requirements.txt'
COLLECTIONS = SWAMP / 'ansible/requirements.yml'
SYSTEM_TOOLS = Path('/opt/orbit-shape-gate')
CREDENTIALS = ('SWAMP_API_KEY', 'SWAMP_SIGNIN_TOKEN')
CREDENTIALS_MISSING = 78
BASES = ('origin/main', 'main')

DENO_UNIT_TESTS = (
    ('--allow-env', '--allow-read', '--allow-run', '--allow-write', 'bin/check-swamp-shape_test.ts'),
    ('--allow-read', '--allow-run', 'bin/lint-behavior-names_test.ts'),
    ('-A', 'bin/swamp-liveness_test.ts'),
    ('-A', 'bin/source_test.ts'),
    ('-A', 'extensions/behaviors/automatic-deploy', 'extensions/behaviors/composer-maintenance',
     'extensions/behaviors/js-maintenance', 'extensions/behaviors/projects'),
    ('--allow-env', '--allow-read', '--allow-run', '--allow-write', 'bin/swamp-shape-python_test.ts'),
    ('--allow-env', '--allow-read', '--allow-run', '--allow-write', 'bin/validate-swamp-workflows_test.ts'),
    ('--allow-env', '--allow-read', '--allow-run', '--allow-write', 'bin/check-swamp-base-policy_test.ts'),
)
# The file names `deno test` takes from a directory.
DENO_TEST_FILE = re.compile(r'(.*[._])?test\.(ts|tsx|mts|js|mjs|jsx)')
# External owners must be verified against executable CI selection, never exclusions.
DENO_TESTS_ELSEWHERE = ('tests/metrics_exporter_firewall_test.ts', 'tests/node_add_bootstrap_test.ts')
TIMINGS = SWAMP / 'tests/shape-timings.json'
INSTANCE_HOST_BUDGET_SECONDS = 720
SHARD_BUDGET_SECONDS = 1440
WORKFLOW = ROOT / '.github/workflows/swamp-shape.yml'
CI_PLAN = ROOT / 'bin/ci-build-plan'


def test_inventory():
    return sorted(str(path.relative_to(SWAMP)) for path in SWAMP.rglob('*')
                  if not {'.swamp', 'node_modules', '.git'} & set(path.relative_to(SWAMP).parts)
                  and path.is_file() and (path.name.endswith('_test.ts') or path.name.endswith('_test.py')))


def external_owners(steps):
    source = WORKFLOW.read_text()
    scope = runpy.run_path(str(CI_PLAN))['select']
    owners = {}
    for file in test_inventory():
        if file.startswith('extensions/behaviors/operations/') and file.endswith('_test.ts'):
            job, label, command, selection = ('tests', 'Run Operations unit tests',
                'deno test --parallel -A extensions/behaviors/operations', 'tests')
            condition = "if: ${{ !inputs.changed-only || steps.scope.outputs.selected == 'true' }}"
        elif file in DENO_TESTS_ELSEWHERE:
            job, label, command, selection = ('validate', 'Run the Swamp workflow validation',
                'python3 "$GITHUB_WORKSPACE/bin/swamp-shape-gate" --only validate --strict --cache "$HOME/.cache/orbit-shape-runtime" --reports "$RUNNER_TEMP"', 'validate')
            condition = "if: steps.scope.outputs.selected == 'true'"
            matches = [s for s in steps if s.group == 'validate' and s.argv == ['deno', 'test', '-A', file]]
            if len(matches) != 1:
                raise ValueError('test file without a shard owner: ' + file + ' (validation step missing)')
        else:
            continue
        block = re.search(r'^  ' + job + r':\n(.*?)(?=^  [\w-]+:|\Z)', source, re.M | re.S)
        step = re.search(r'      - name: ' + re.escape(label) + r'\n(.*?)(?=      - |\Z)', block[1] if block else '', re.S)
        if (not step or condition != step[1].splitlines()[0].strip()
                or [line for line in step[1].splitlines() if line.startswith('        run:')] != ['        run: ' + command]
                or re.search(r'^    if:', block[1], re.M)
                or '      - uses: ./.github/actions/ci-scope' not in block[1].splitlines()
                or '        id: scope' not in block[1].splitlines()
                or '          job: swamp-' + selection not in block[1].splitlines()
                or not scope(['swamp/' + file])['swamp_checks'][selection]):
            raise ValueError('test file without a shard owner: ' + file + ' (external CI owner does not select file)')
        owners[file] = {'job': job, 'step': matches[0].name if job == 'validate' else label}
    return owners


def audit_ownership(steps):
    owners = external_owners(steps)
    for file in test_inventory():
        count = sum(s.parallel and s.argv[:2] in (['deno', 'test'], ['python3', '-I']) and s.argv[-1] == file for s in steps)
        count += file in owners
        if count != 1:
            raise ValueError('test file without a shard owner: ' + file + f' (owners: {count})')
    return owners


def external_owner_groups(steps):
    owners = audit_ownership(steps)
    return {
        'Operations': {'job': 'tests', 'step': 'Run Operations unit tests',
                       'files': sorted(file for file, owner in owners.items() if owner['job'] == 'tests')},
        'validation': {'job': 'validate', 'files': {file: owner['step'] for file, owner in owners.items() if owner['job'] == 'validate'}},
        'host services': {'files': [], 'note': 'No tests excluded; mocked native-host tests run in shape shards'},
    }


def deno_test_files():
    explicit = {args[-1] for args in expanded_unit_tests()}
    return [('-A', file) for file in test_inventory() if file.endswith('_test.ts')
            and file not in explicit and file not in DENO_TESTS_ELSEWHERE
            and not file.startswith('extensions/behaviors/operations/')]


def ansible_test_files():
    return [file for file in test_inventory() if file.endswith('_test.py')]


def expanded_unit_tests():
    for arguments in DENO_UNIT_TESTS:
        flags = [arg for arg in arguments if arg.startswith('-')]
        for entry in (arg for arg in arguments if not arg.startswith('-')):
            path = SWAMP / entry
            files = sorted(str(file.relative_to(SWAMP)) for file in path.rglob('*') if DENO_TEST_FILE.fullmatch(file.name)) if path.is_dir() else [entry]
            for file in files:
                yield (*flags, file)


def weights():
    return json.loads(TIMINGS.read_text())['units']


def weight(step):
    # Integer tenths avoid floating point accumulation changing tie breaks.
    return round(weights().get(step.unit, {'beast': 1})['beast'] * 10)


def ordered(steps):
    return sorted(steps, key=lambda step: (-weight(step), step.unit))


def shard_units(steps, index, total=3):
    if total != 3 or not 1 <= index <= total:
        raise ValueError('shape shards must be 1/3, 2/3 or 3/3')
    shards, totals = [[] for _ in range(total)], [0] * total
    for step in ordered(step for step in steps if step.parallel):
        slot = min(range(total), key=lambda slot: (totals[slot], slot))
        shards[slot].append(step)
        totals[slot] += weight(step)
    return shards[index - 1]


def select_steps(steps, shard=None, control_only=False):
    if shard:
        return [step for step in steps if step.name == 'ansible collections'] + shard_units(steps, *shard)
    if control_only:
        return [step for step in steps if step.group == 'shape' and not step.parallel]
    return steps


def manifest_id():
    canonical = plan('BASE', Path('REPORTS'), Path('CACHE'), Path('COLLECTIONS'))
    payload = [(step.group, step.name, step.argv, step.needs, step.env, step.parallel, step.fixture_seconds) for step in canonical]
    return hashlib.sha256(json.dumps({'steps': payload, 'external_owners': audit_ownership(canonical)}, sort_keys=True).replace(str(ROOT), '/REPO').encode() + TIMINGS.read_bytes()).hexdigest()


class Step:
    """One command of the gate. `needs` names what a missing prerequisite skips: credentials or a tool."""

    def __init__(self, group, name, argv, needs=(), env=None, parallel=False, fixture_seconds=None):
        self.group, self.name, self.argv, self.needs, self.env = group, name, list(argv), needs, env or {}
        self.parallel = parallel
        self.fixture_seconds = fixture_seconds
        self.unit = self.argv[-1] if self.argv[:2] == ["deno", "test"] or self.argv[:2] == ["python3", "-I"] else name


def plan(base, reports, cache, collections):
    """The steps in CI's order, with CI's arguments."""
    shape_report = reports / 'shape.json'
    ansible_env = {'ANSIBLE_COLLECTIONS_PATH': str(collections)}
    steps = [
        Step('shape', 'ansible collections', ['ansible-galaxy', 'collection', 'install', '-r', 'ansible/requirements.yml', '-p', str(collections)],
             env=ansible_env),
        Step('shape', 'ansible-lint', ['ansible-lint', 'ansible/operation-instance-create.yml', 'ansible/route-create-site.yml', 'ansible/route-withdraw.yml', 'ansible/ai-router-task-guard.yml', 'ansible/ai-router-model-forwarder.yml', 'ansible/operation-node-add.yml', 'ansible/operation-node-role-add.yml', 'ansible/operation-node-role-add-local-dns.yml', 'ansible/operation-node-converge-local-dns.yml', 'ansible/swamp-worker-renewal.yml', 'ansible/task-vm-role.yml',
                                       'ansible/task-vm-fleet-wait.yml', 'ansible/task-vm-idle-save.yml', 'ansible/task-vm-host.yml', 'ansible/proof-gateway.yml', 'ansible/proof-observers.yml', 'ansible/operation-fleet-reboot.yml'], env=ansible_env, parallel=True),
    ]
    deno_files = deno_test_files()

    def deno_step(arguments):
        return Step('shape', 'deno test ' + ' '.join(arg for arg in arguments if not arg.startswith('-')),
                    ['deno', 'test', *arguments], env=ansible_env, parallel=True,
                    fixture_seconds=INSTANCE_HOST_BUDGET_SECONDS if arguments[-1].startswith(('tests/ansible_instance_host_', 'tests/ansible_instance_container_', 'tests/ansible_instance_migrate_')) else None)

    steps += [Step('shape', test, ['python3', '-I', test], env=ansible_env, parallel=True) for test in ansible_test_files()]
    steps.append(Step('shape', 'ruff', ['ruff', 'check', 'ansible/build_vars.py', 'ansible/instance_migrate_links.py', 'ansible/library/orbit_artifact.py', 'tests/_support/fixture_supervisor.py',
                                        *ansible_test_files()], parallel=True))
    steps += [deno_step(arguments) for arguments in (*expanded_unit_tests(), *deno_files)]
    steps[1:] = ordered(steps[1:])
    steps += [
        Step('shape', 'check-swamp-shape', ['deno', 'run', '--allow-env', '--allow-read', f'--allow-write={shape_report}', '--allow-run',
                                            'bin/check-swamp-shape.ts', '--base', base, '--report', str(shape_report)]),
        Step('shape', 'check-swamp-base-policy', ['python3', 'bin/check-swamp-base-policy.py', '--base', base]),
        Step('shape', 'lint-behavior-names', ['deno', 'run', '--allow-read', '--allow-run', 'bin/lint-behavior-names.ts', '--base', base]),
        Step('shape', 'frozen agent commands', [str(ROOT / 'bin/check-frozen-agent-commands'), '--root', str(ROOT)]),
        Step('validate', 'validate-swamp-workflows', ['python3', 'bin/validate-swamp-workflows.py', '--cache', str(cache),
                                                      '--report', str(reports / 'workflow-validation.json')], needs=('credentials',)),
        # It imports the extensions that the workflow validation pulls, so it needs the same credential.
        Step('validate', 'node enrollment trust', ['deno', 'test', '-A', 'tests/node_add_bootstrap_test.ts'], needs=('credentials',)),
        Step('validate', 'exporter firewall', ['deno', 'test', '-A', 'tests/metrics_exporter_firewall_test.ts'], needs=('credentials',)),
        Step('validate', 'check-grant-patterns', ['python3', 'bin/check-grant-patterns.py', '--cache', str(cache),
                                                  '--report', str(reports / 'grant-validation.json')], needs=('credentials', 'php')),
        Step('validate', 'workflow placement', ['deno', 'run', '--allow-read', 'bin/lint-workflow-placement.ts']),
    ]
    audit_ownership(steps)
    return steps


def git(*args):
    return subprocess.run(['git', '-C', str(ROOT), *args], capture_output=True, text=True, timeout=60)


def resolve_base(base):
    """CI passes the event's base commit. An empty or all-zero one (a new branch) means the previous commit."""
    if base is not None and base.strip() and not re.fullmatch(r'0+', base.strip()):
        return base.strip()
    if base is not None:
        return git('rev-parse', 'HEAD^').stdout.strip()
    for ref in BASES:
        result = git('merge-base', 'HEAD', ref)
        if result.returncode == 0:
            return result.stdout.strip()
    raise SystemExit('No merge base with origin/main. Fetch it, or pass --base REF.')


def venv_name():
    """The venv folder of these pins. The task VM role playbook derives the same name from the same two files."""
    pins = REQUIREMENTS.read_text() + (SWAMP / 'ansible/requirements.txt').read_text()
    return f'venv-{hashlib.sha256(pins.encode()).hexdigest()[:16]}'


def collections_path(tools):
    return tools / f'collections-{hashlib.sha256(COLLECTIONS.read_bytes()).hexdigest()[:16]}'


def default_tools():
    """The tools of the task image when they are built for these pins, else the per-user cache."""
    if (SYSTEM_TOOLS / venv_name() / '.complete').exists():
        return SYSTEM_TOOLS
    return Path.home() / '.cache/orbit-shape-gate'


def tool_path(tools, deadline=None):
    """The bin directory of the pinned venv, built once per pin set under a lock. A built venv needs no write access."""
    venv = tools / venv_name()
    if not (venv / '.complete').exists():
        tools.mkdir(parents=True, exist_ok=True)
        with (tools / 'lock').open('w') as lock:
            while True:
                try:
                    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    break
                except BlockingIOError:
                    remaining(deadline)
                    time.sleep(0.1)
            if not (venv / '.complete').exists():
                shutil.rmtree(venv, ignore_errors=True)
                print(f'Installing the pinned shape tools into {venv}', flush=True)
                install_tool([sys.executable, '-m', 'venv', str(venv)], deadline)
                install_tool([str(venv / 'bin/pip'), 'install', '--disable-pip-version-check', '-q', '-r', str(REQUIREMENTS)], deadline)
                (venv / '.complete').write_text('')
    return venv / 'bin'


def install_tool(command, deadline):
    if deadline is None:
        subprocess.run(command, check=True)
        return
    with tempfile.TemporaryDirectory(prefix='orbit-shape-install-') as scratch:
        seconds = remaining(deadline)
        subprocess.run([sys.executable, str(SWAMP / 'tests/_support/fixture_supervisor.py'),
                        str(seconds), str(Path(scratch) / 'deadline.json'), *command],
                       check=True, timeout=seconds + 5)


def skip_reason(step, environment):
    if 'credentials' in step.needs and not all(environment.get(name) for name in CREDENTIALS):
        return 'no Swamp credential: set ' + ' and '.join(CREDENTIALS)
    if 'php' in step.needs and not shutil.which('php', path=environment['PATH']):
        return 'php not found'
    return None


def remaining(deadline):
    if deadline is None:
        return None
    seconds = deadline - time.monotonic()
    if seconds <= 0:
        raise TimeoutError('shard deadline exhausted')
    return seconds


def run_step(step, environment, strict, deadline=None):
    print(f'==> {step.name}', flush=True)
    if deadline is not None and time.monotonic() >= deadline:
        return (step, 'FAILED', 0.0, 'shard deadline exhausted'), ''
    reason = skip_reason(step, environment)
    if reason and not strict:
        return (step, 'skipped', 0.0, reason), ''
    started = time.monotonic()
    # Each command owns its output and temporary fixtures. A parallel Deno command gets one worker,
    # so nested test parallelism cannot multiply the shared command budget.
    with tempfile.TemporaryDirectory(prefix='orbit-shape-step-') as scratch, tempfile.TemporaryFile(mode='w+t') as output:
        scratch = str(Path(scratch).resolve())
        env = {**environment, **step.env, 'TMPDIR': scratch, 'TEMP': scratch, 'TMP': scratch}
        if step.parallel:
            env.update(DENO_JOBS='1', ANSIBLE_FORKS='1', PYTHON_CPU_COUNT='1', RAYON_NUM_THREADS='1')
        seconds = min(value for value in (max(0, deadline - time.monotonic()) if deadline is not None else None, step.fixture_seconds if step.fixture_seconds is not None else INSTANCE_HOST_BUDGET_SECONDS if step.parallel else None, float('inf')) if value is not None)
        if seconds <= 0:
            return (step, 'FAILED', 0.0, 'shard deadline exhausted'), ''
        if step.fixture_seconds is not None:
            env['ORBIT_INSTANCE_HOST_DEADLINE_MS'] = str(int(time.time() * 1000 + seconds * 1000))
        receipt = Path(scratch) / 'deadline.json'
        command = step.argv
        if seconds != float('inf'):
            command = [sys.executable, str(SWAMP / 'tests/_support/fixture_supervisor.py'), str(seconds), str(receipt), *command]
        detail = ''
        try:
            code = subprocess.run(command, cwd=SWAMP, env=env, stdout=output, stderr=subprocess.STDOUT,
                                  timeout=seconds + 5 if seconds != float('inf') else None).returncode
            if receipt.exists() and json.loads(receipt.read_text())['timedOut']:
                detail = 'shard deadline exhausted' if deadline is not None and time.monotonic() >= deadline else 'command deadline exhausted'
                code = 124
        except (subprocess.TimeoutExpired, TimeoutError):
            detail, code = 'deadline supervisor exceeded cleanup allowance', 124
        except FileNotFoundError as error:
            output.write(f'{error.filename or step.argv[0]}: required tool not found\n')
            code = 127
        output.seek(0)
        return (step, 'passed' if code == 0 else 'FAILED', time.monotonic() - started, detail or f'exit {code}'), output.read()


def execute(steps, environment, strict, workers, deadline=None):
    results = []
    order = {id(step): index for index, step in enumerate(steps)}

    def record(completed):
        result, output = completed
        step, outcome, _seconds, detail = result
        print(f'==> {step.name}: {outcome}' + (f', {detail}' if outcome == 'skipped' else ''), flush=True)
        if output:
            print(output, end='' if output.endswith('\n') else '\n', flush=True)
        results.append(result)

    # Collections and tool setup finish before the independent group. Ratchets and validation stay serial.
    for parallel, group in groupby(steps, key=lambda step: step.parallel):
        group = list(group)
        if parallel:
            with ThreadPoolExecutor(max_workers=workers) as pool:
                futures = [pool.submit(run_step, step, environment, strict, *([deadline] if deadline is not None else [])) for step in group]
                for future in as_completed(futures):
                    record(future.result())
        else:
            for step in group:
                record(run_step(step, environment, strict, *([deadline] if deadline is not None else [])))
    # Keep the summary and callers in plan order while command output streams in completion order.
    return sorted(results, key=lambda result: order[id(result[0])])


def main(argv=None):
    started = time.monotonic()
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('--base')
    parser.add_argument('--only', choices=('shape', 'validate'))
    parser.add_argument('--reports', type=Path, default=Path(tempfile.gettempdir()) / f'orbit-shape-gate-{os.getuid()}')
    parser.add_argument('--cache', type=Path, default=Path.home() / '.cache/orbit-shape-runtime')
    parser.add_argument('--tools', type=Path)
    parser.add_argument('--strict', action='store_true')
    parser.add_argument('--workers', type=int, default=min(4, os.cpu_count() or 1))
    selection = parser.add_mutually_exclusive_group()
    selection.add_argument('--shard', help='one of 1/3, 2/3 or 3/3')
    selection.add_argument('--control-only', action='store_true')
    parser.add_argument('--manifest-id', action='store_true', help='print the canonical manifest/timing identity without running tools')
    args = parser.parse_args(argv)
    if args.shard or args.control_only:
        if args.only != 'shape':
            parser.error('--shard and --control-only require --only shape')
    if args.shard:
        if args.shard not in ('1/3', '2/3', '3/3'):
            parser.error('--shard must be 1/3, 2/3 or 3/3')
        args.shard = tuple(map(int, args.shard.split('/')))
    if args.manifest_id:
        print(manifest_id())
        return 0
    if args.workers < 1:
        parser.error('--workers must be positive')
    # CI's umask; a looser one changes file modes that the Ansible artifact tests compare.
    os.umask(0o022)
    # The validation group needs neither the base nor the pinned linters, so its CI job can check out one commit.
    args.tools = args.tools or default_tools()
    base = resolve_base(args.base) if args.only != 'validate' else ''
    args.reports.mkdir(parents=True, exist_ok=True)
    environment = {**os.environ}
    collections = collections_path(args.tools)
    steps = [step for step in plan(base, args.reports, args.cache, collections) if args.only in (None, step.group)]
    steps = select_steps(steps, args.shard, args.control_only)
    deadline = None
    if args.shard:
        # CI starts the clock before checkout/setup; a local shard starts at gate entry.
        deadline = min(started + SHARD_BUDGET_SECONDS,
                       time.monotonic() + float(environment.get('ORBIT_SHAPE_DEADLINE_EPOCH', time.time() + SHARD_BUDGET_SECONDS)) - time.time())
    print('Swamp shape gate' + (f' against {base[:12]}' if base else '') + f'; reports in {args.reports}', flush=True)
    try:
        if args.only != 'validate':
            installed = tool_path(args.tools, deadline) if deadline is not None else tool_path(args.tools)
            environment['PATH'] = f'{installed}{os.pathsep}{environment["PATH"]}'
        results = execute(steps, environment, args.strict, args.workers, *([deadline] if deadline is not None else []))
    except (TimeoutError, subprocess.SubprocessError, OSError) as error:
        results = [(step, 'FAILED', 0.0, 'gate setup/execution failed: ' + str(error)) for step in steps]
    if args.shard:
        report = {
            'sha': git('rev-parse', 'HEAD').stdout.strip(), 'base': base, 'manifest_id': manifest_id(),
            'shard': f'{args.shard[0]}/{args.shard[1]}',
            'budget_seconds': SHARD_BUDGET_SECONDS, 'seconds': time.monotonic() - started,
            'external_owners': audit_ownership(plan(base, args.reports, args.cache, collections)),
            'external_owner_groups': external_owner_groups(plan(base, args.reports, args.cache, collections)),
            'units': [{'unit': step.unit, 'argv': step.argv, 'outcome': outcome, 'seconds': seconds, 'detail': detail}
                      for step, outcome, seconds, detail in results if step.parallel],
        }
        (args.reports / 'shard.json').write_text(json.dumps(report, indent=2) + '\n')
    print('\nSwamp shape gate summary', flush=True)
    for step, outcome, seconds, detail in results:
        print(f'  {outcome:<7} {step.name} ({seconds:.1f}s{"; " + detail if outcome != "passed" else ""})', flush=True)
    failed = [step.name for step, outcome, _seconds, _detail in results if outcome == 'FAILED']
    skipped = [step.name for step, outcome, _seconds, _detail in results if outcome == 'skipped']
    if failed:
        print(f'FAILED: {", ".join(failed)}', flush=True)
        return 1
    if skipped:
        print(f'PASSED with skipped steps: {", ".join(skipped)}. CI runs them.', flush=True)
        return CREDENTIALS_MISSING if args.only == 'validate' else 0
    print('PASSED', flush=True)
    return 0


if __name__ == '__main__':
    sys.exit(main())
