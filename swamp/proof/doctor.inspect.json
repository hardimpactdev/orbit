{
  "kind": "doctor.inspect",
  "workflow": "operation-doctor-inspect",
  "topology": "minimal",
  "budget_seconds": 180,
  "queue_timeout_seconds": 60,
  "before_gateway": [
    [
      "sh",
      "-c",
      "printf '\\nORBIT_DEPENDENCY_DETECTION_SERVICES_NODE_ID=%s\\n' \"$1\" >> apps/gateway/.env",
      "sh",
      "${node.target}"
    ],
    [
      "runuser",
      "-u",
      "orbit",
      "--",
      "env",
      "-C",
      "apps/gateway",
      "php",
      "-r",
      "require \"vendor/autoload.php\"; $app=require \"bootstrap/app.php\"; $app->make(Illuminate\\Contracts\\Console\\Kernel::class)->bootstrap(); app(App\\Domain\\Tasks\\TaskExtensionState::class)->enable(); App\\Models\\ProblemCollectorState::query()->delete(); file_put_contents(storage_path(\"logs/laravel.log\"), \"[2026-11-02 12:00:00] proof.INFO: doctor proof marker\\n\", FILE_APPEND);"
    ]
  ],
  "request": {
    "method": "POST",
    "path": "observation/maintenance/health",
    "caller": "target"
  },
  "expect": {
    "status": "succeeded"
  },
  "phases": [
    {
      "name": "plan",
      "job": "plan",
      "step": "plan",
      "budget_seconds": 30
    },
    {
      "name": "result",
      "job": "report",
      "step": "result",
      "budget_seconds": 30
    }
  ],
  "parity": "swamp/proof/doctor.inspect/parity.py"
}
