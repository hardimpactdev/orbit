#!/usr/bin/env bash

set -Eeuo pipefail

TARGET_DIR="${ORBIT_INSTALL_PATH:-$HOME/orbit}"
REPO_URL="${ORBIT_REPO_URL:-https://github.com/hardimpactdev/orbit.git}"
BRANCH="${ORBIT_BRANCH:-main}"
SOURCE_ARCHIVE=""
RUNTIME_IMAGE_ARCHIVE="${ORBIT_RUNTIME_IMAGE_ARCHIVE:-}"
CADDY_IMAGE_ARCHIVE="${ORBIT_CADDY_IMAGE_ARCHIVE:-}"
DNSMASQ_IMAGE_ARCHIVE="${ORBIT_DNSMASQ_IMAGE_ARCHIVE:-}"
FRANKENPHP_IMAGE_ARCHIVE="${ORBIT_FRANKENPHP_IMAGE_ARCHIVE:-}"
WG_EASY_IMAGE_ARCHIVE="${ORBIT_WG_EASY_IMAGE_ARCHIVE:-}"
LINK_PATH="${ORBIT_BIN_PATH:-/usr/local/bin/orbit}"
USE_SUDO=1
SKIP_PREREQUISITES="${ORBIT_INSTALL_SKIP_PREREQUISITES:-0}"
GATEWAY_MODE="${ORBIT_INSTALL_GATEWAY:-0}"
VERBOSE=0
LOG_FILE="${ORBIT_INSTALL_LOG:-}"
CURRENT_STEP=""

usage() {
    cat <<'HELP'
usage: bin/install-orbit [options]

Install the Orbit CLI and its Docker-first runtime prerequisites on the
current host. The installer prepares host PHP CLI for the CLI/local-executor
artifact, Docker, the Orbit source checkout, the orbit-runtime, orbit-caddy,
and default FrankenPHP runtime images, runs migrations inside a disposable
orbit-runtime container, and starts the long-running orbit-runtime container.
No host Composer, host Caddy, or host PHP-FPM is installed.

Options:
  --path=PATH                  Orbit checkout path. Defaults to "$HOME/orbit".
  --repo=URL                   Git repository to clone when no source archive is provided.
  --branch=NAME                Git branch to clone or update. Defaults to "main".
  --source-archive=PATH        Extract this Orbit source tarball instead of cloning.
  --runtime-image-archive=PATH Load orbit-runtime:current from this Docker
                               image archive before building from source.
  --caddy-image-archive=PATH   Load caddy:2-alpine from this Docker image
                               archive before falling back to Docker Hub.
  --dnsmasq-image-archive=PATH Load 4km3/dnsmasq:latest from this Docker
                               image archive for gateway DNS bootstrap.
  --frankenphp-image-archive=PATH
                               Load dunglas/frankenphp:1-php8.5-bookworm from
                               this Docker image archive before falling back
                               to Docker Hub.
  --wg-easy-image-archive=PATH Load ghcr.io/wg-easy/wg-easy:15 from this Docker
                               image archive before the gateway VPN runtime
                               starts.
  --bin=PATH                   Symlink path for the orbit executable.
                               Defaults to "/usr/local/bin/orbit".
  --skip-prerequisites         Skip Docker / package prerequisite installation.
                               Intended for prepared E2E images that already
                               contain runtime packages.
  --gateway                    Start orbit-runtime with ORBIT_IS_GATEWAY=1 so
                               the gateway API HTTP listener is brought up
                               alongside the scheduler and trusts the
                               orbit-caddy-owned WireGuard peer header. Pass
                               on first-gateway provisioning.
  --no-sudo                    Run package and symlink commands without sudo.
  --verbose                    Stream underlying command output.
  -h, --help                   Show this help text.

The installer is intentionally local-host only. A new operator node runs it
before invoking Orbit. Gateway and app roles are provisioned by node:new from a
configured operator node.
HELP
}

fail() {
    local code="$1"
    shift

    printf 'orbit-install: error [%s] %s\n' "$code" "$*" >&2

    if [ -n "$LOG_FILE" ] && [ -f "$LOG_FILE" ]; then
        printf 'orbit-install: log %s\n' "$LOG_FILE" >&2
    fi

    exit 1
}

quote() {
    printf '%q' "$1"
}

run() {
    ensure_log_file

    {
        printf '+'
        printf ' %q' "$@"
        printf '\n'
    } >>"$LOG_FILE"

    if [ "$VERBOSE" = "1" ]; then
        "$@" 2>&1 | tee -a "$LOG_FILE"

        return "${PIPESTATUS[0]}"
    fi

    "$@" >>"$LOG_FILE" 2>&1
}

sudo_run() {
    if [ "$USE_SUDO" = "1" ] && [ "$(id -u)" -ne 0 ]; then
        run sudo "$@"
        return
    fi

    run "$@"
}

sudo_shell() {
    if [ "$USE_SUDO" = "1" ] && [ "$(id -u)" -ne 0 ]; then
        run sudo bash -lc "$1"
        return
    fi

    run bash -lc "$1"
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || fail validation_failed "required command missing: $1"
}

ensure_log_file() {
    local tmp_dir
    local tmp_file

    if [ -n "$LOG_FILE" ]; then
        return
    fi

    tmp_dir="${TMPDIR:-/tmp}"
    tmp_dir="${tmp_dir%/}"
    tmp_file="$(mktemp "$tmp_dir/orbit-install.XXXXXX")"
    LOG_FILE="${tmp_file}.log"
    mv "$tmp_file" "$LOG_FILE"
}

render_plan() {
    printf '  ┌ Orbit install\n'
    printf '  │\n'
    printf '  ○  Validate installer input\n'
    printf '  │\n'
    printf '  ○  Install host prerequisites\n'
    printf '  │\n'
    printf '  ○  Install Orbit source\n'
    printf '  │\n'
    printf '  ○  Prepare runtime Docker images\n'
    printf '  │\n'
    printf '  ○  Bootstrap Orbit runtime in the container\n'
    printf '  │\n'
    printf '  ○  Run migrations inside orbit-runtime\n'
    printf '  │\n'
    printf '  ○  Start orbit-runtime container\n'
    printf '  │\n'
    printf '  ○  Align orbit checkout ownership\n'
    printf '  │\n'
    printf '  ○  Link orbit executable\n'
    printf '  │\n'
    printf '  ○  Verify Orbit\n'
    printf '  │\n'
    printf '  └  Log: %s\n\n' "$LOG_FILE"
}

start_step() {
    CURRENT_STEP="$1"
    printf '  ◉  %s\n' "$CURRENT_STEP"
}

complete_step() {
    printf '  ●  %s\n' "$CURRENT_STEP"
    CURRENT_STEP=""
}

fail_step() {
    local status="$1"

    if [ -n "$CURRENT_STEP" ]; then
        printf '  ●  %s failed\n' "$CURRENT_STEP" >&2
    fi

    if [ -n "$LOG_FILE" ] && [ -f "$LOG_FILE" ]; then
        printf 'orbit-install: log %s\n' "$LOG_FILE" >&2
        tail -n 20 "$LOG_FILE" >&2 || true
    fi

    exit "$status"
}

finish_tree() {
    printf '\n  └  Orbit installed at %s\n' "$TARGET_DIR"
}

parse_args() {
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --path=*)
                TARGET_DIR="${1#*=}"
                ;;
            --repo=*)
                REPO_URL="${1#*=}"
                ;;
            --branch=*)
                BRANCH="${1#*=}"
                ;;
            --source-archive=*)
                SOURCE_ARCHIVE="${1#*=}"
                ;;
            --runtime-image-archive=*)
                RUNTIME_IMAGE_ARCHIVE="${1#*=}"
                ;;
            --caddy-image-archive=*)
                CADDY_IMAGE_ARCHIVE="${1#*=}"
                ;;
            --dnsmasq-image-archive=*)
                DNSMASQ_IMAGE_ARCHIVE="${1#*=}"
                ;;
            --frankenphp-image-archive=*)
                FRANKENPHP_IMAGE_ARCHIVE="${1#*=}"
                ;;
            --wg-easy-image-archive=*)
                WG_EASY_IMAGE_ARCHIVE="${1#*=}"
                ;;
            --bin=*)
                LINK_PATH="${1#*=}"
                ;;
            --skip-prerequisites)
                SKIP_PREREQUISITES=1
                ;;
            --gateway)
                GATEWAY_MODE=1
                ;;
            --no-sudo)
                USE_SUDO=0
                ;;
            --verbose)
                VERBOSE=1
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            *)
                fail validation_failed "unknown option: $1"
                ;;
        esac

        shift
    done
}

validate_args() {
    [ -n "$TARGET_DIR" ] || fail validation_failed "--path is required"
    [ -n "$LINK_PATH" ] || fail validation_failed "--bin is required"

    if [ -n "$RUNTIME_IMAGE_ARCHIVE" ] && [ ! -f "$RUNTIME_IMAGE_ARCHIVE" ]; then
        fail validation_failed "runtime image archive not found: $RUNTIME_IMAGE_ARCHIVE"
    fi

    if [ -n "$CADDY_IMAGE_ARCHIVE" ] && [ ! -f "$CADDY_IMAGE_ARCHIVE" ]; then
        fail validation_failed "caddy image archive not found: $CADDY_IMAGE_ARCHIVE"
    fi

    if [ -n "$DNSMASQ_IMAGE_ARCHIVE" ] && [ ! -f "$DNSMASQ_IMAGE_ARCHIVE" ]; then
        fail validation_failed "dnsmasq image archive not found: $DNSMASQ_IMAGE_ARCHIVE"
    fi

    if [ -n "$FRANKENPHP_IMAGE_ARCHIVE" ] && [ ! -f "$FRANKENPHP_IMAGE_ARCHIVE" ]; then
        fail validation_failed "frankenphp image archive not found: $FRANKENPHP_IMAGE_ARCHIVE"
    fi

    if [ -n "$WG_EASY_IMAGE_ARCHIVE" ] && [ ! -f "$WG_EASY_IMAGE_ARCHIVE" ]; then
        fail validation_failed "wg-easy image archive not found: $WG_EASY_IMAGE_ARCHIVE"
    fi
}

wait_for_cloud_init() {
    if ! command -v cloud-init >/dev/null 2>&1; then
        return
    fi

    sudo_run cloud-init status --wait || true
}

host_php_is_ready() {
    local version

    command -v php >/dev/null 2>&1 || return 1

    version="$(php --version 2>/dev/null | head -n 1 || true)"

    [[ "$version" == PHP\ 8.5.* ]] || return 1

    php -r 'foreach (["pdo_sqlite", "openssl", "curl", "mbstring", "json"] as $extension) { if (! extension_loaded($extension)) { exit(1); } }' >/dev/null 2>&1
}

verify_host_php_baseline() {
    local version

    require_command php

    version="$(php --version 2>/dev/null | head -n 1 || true)"

    if [[ "$version" != PHP\ 8.5.* ]]; then
        fail validation_failed "host php must resolve to PHP 8.5.x after prerequisite installation; got: ${version:-missing}"
    fi

    if ! php -r 'foreach (["pdo_sqlite", "openssl", "curl", "mbstring", "json"] as $extension) { if (! extension_loaded($extension)) { fwrite(STDERR, $extension.PHP_EOL); exit(1); } }' >/dev/null 2>&1; then
        fail validation_failed "host php is missing one of the required extensions: pdo_sqlite, openssl, curl, mbstring, json"
    fi
}

ubuntu_requires_ondrej_php_ppa() {
    local version_id

    version_id="$(. /etc/os-release && printf '%s' "$VERSION_ID")"

    case "$version_id" in
        22.04|24.04)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

install_host_php_ubuntu() {
    if host_php_is_ready; then
        printf 'orbit-install: host PHP 8.5 CLI baseline already present\n'
        return
    fi

    printf 'orbit-install: installing host PHP 8.5 CLI baseline\n'

    sudo_run env DEBIAN_FRONTEND=noninteractive apt-get install -y software-properties-common

    if ubuntu_requires_ondrej_php_ppa; then
        sudo_run add-apt-repository ppa:ondrej/php -y
        sudo_run apt-get update
    else
        printf 'orbit-install: using Ubuntu package repositories for PHP 8.5 CLI baseline\n'
    fi

    sudo_run env DEBIAN_FRONTEND=noninteractive apt-get install -y \
        php8.5-cli \
        php8.5-mbstring \
        php8.5-curl \
        php8.5-sqlite3 \
        php8.5-xml

    if [ -x /usr/bin/php8.5 ]; then
        sudo_run update-alternatives --set php /usr/bin/php8.5
    fi

    verify_host_php_baseline
}

install_ubuntu_prerequisites() {
    wait_for_cloud_init

    sudo_run apt-get update
    sudo_run env DEBIAN_FRONTEND=noninteractive apt-get install -y \
        ca-certificates \
        curl \
        git \
        gnupg \
        openssh-client \
        tar \
        unzip \
        wireguard \
        wireguard-tools

    install_host_php_ubuntu
    install_docker_engine_ubuntu
}

install_docker_engine_ubuntu() {
    local needs_install=0
    if ! command -v docker >/dev/null 2>&1; then
        needs_install=1
    fi

    if [ "$needs_install" = "1" ]; then
        local keyring="/etc/apt/keyrings/docker.gpg"
        local codename
        codename="$(. /etc/os-release && printf '%s' "$VERSION_CODENAME")"

        sudo_run install -d -m 0755 /etc/apt/keyrings
        sudo_shell "curl -fsSL --retry 3 --retry-delay 2 https://download.docker.com/linux/ubuntu/gpg -o /tmp/docker.gpg.armor && gpg --batch --yes --dearmor -o ${keyring} /tmp/docker.gpg.armor && rm -f /tmp/docker.gpg.armor"
        sudo_run chmod 0644 "${keyring}"
        sudo_shell "printf 'deb [arch=%s signed-by=%s] https://download.docker.com/linux/ubuntu %s stable\n' \"\$(dpkg --print-architecture)\" \"${keyring}\" \"${codename}\" > /etc/apt/sources.list.d/docker.list"
        sudo_run apt-get update
        sudo_run env DEBIAN_FRONTEND=noninteractive apt-get install -y \
            docker-ce \
            docker-ce-cli \
            containerd.io \
            docker-buildx-plugin \
            docker-compose-plugin
        sudo_run systemctl enable --now docker
    fi

    grant_runtime_user_docker_access
}

grant_runtime_user_docker_access() {
    # Add the user that runs Orbit commands to the docker group so steady-state
    # use of `orbit` does not need sudo. The current shell will not gain the
    # new group membership in this session — install-orbit therefore continues
    # to invoke docker via sudo through `docker_cli` so the install path is
    # valid before group membership is picked up by a future login.
    local current_user
    current_user="$(id -un)"

    if [ "$current_user" = "root" ]; then
        return
    fi

    if ! getent group docker >/dev/null 2>&1; then
        # docker-ce should have created this group; in case it didn't (or
        # docker is supplied through an alternate mechanism), keep going so
        # later steps surface the real error.
        return
    fi

    if id -nG "$current_user" 2>/dev/null | tr ' ' '\n' | grep -qx docker; then
        return
    fi

    sudo_run usermod -aG docker "$current_user"
}

# Wrapper around `docker` that picks the right access path for install-time
# use. The runtime user is added to the docker group above, but that
# membership is not visible until the next login, so we transparently sudo
# during install. After install, the host launcher (`bin/orbit`) runs as the
# user's interactive session and uses the docker group directly.
docker_cli() {
    if [ "$(id -u)" -eq 0 ] || [ "$USE_SUDO" != "1" ]; then
        docker "$@"
        return
    fi

    sudo -n docker "$@"
}

brew_formula_installed() {
    brew --prefix "$1" >/dev/null 2>&1
}

install_host_php_macos() {
    if host_php_is_ready; then
        printf 'orbit-install: host PHP 8.5 CLI baseline already present\n'
        return
    fi

    printf 'orbit-install: installing host PHP 8.5 CLI baseline\n'

    if brew_formula_installed php@8.5; then
        printf 'orbit-install: Homebrew php@8.5 already installed; linking host php\n'
    elif brew search --formula php@8.5 2>/dev/null | grep -qx php@8.5; then
        run brew install php@8.5
    else
        run brew install php
    fi

    if brew_formula_installed php@8.5; then
        run brew link --overwrite --force php@8.5
    fi

    verify_host_php_baseline
}

install_macos_prerequisites() {
    require_command brew

    run brew update
    install_host_php_macos
    run brew install git
    require_command docker
}

install_prerequisites() {
    if [ "$SKIP_PREREQUISITES" = "1" ]; then
        return
    fi

    case "$(uname -s)" in
        Linux)
            if [ -r /etc/os-release ] && grep -q '^ID=ubuntu$' /etc/os-release; then
                install_ubuntu_prerequisites
                return
            fi

            fail node.unsupported_platform "only Ubuntu Linux is supported for Orbit host installation"
            ;;
        Darwin)
            install_macos_prerequisites
            ;;
        *)
            fail node.unsupported_platform "unsupported operating system: $(uname -s)"
            ;;
    esac
}

require_docker() {
    require_command docker

    if ! docker_cli info >/dev/null 2>&1; then
        fail validation_failed "Docker daemon is not reachable; start Docker before running install-orbit"
    fi
}

install_source() {
    if [ -n "$SOURCE_ARCHIVE" ]; then
        [ -f "$SOURCE_ARCHIVE" ] || fail validation_failed "source archive not found: $SOURCE_ARCHIVE"

        if [ -e "$TARGET_DIR" ] && [ ! -f "$TARGET_DIR/apps/gateway/artisan" ]; then
            fail validation_failed "$TARGET_DIR exists and does not look like an Orbit checkout"
        fi

        run mkdir -p "$TARGET_DIR"
        run tar --no-same-owner -xzf "$SOURCE_ARCHIVE" -C "$TARGET_DIR"

        return
    fi

    require_command git

    if [ -d "$TARGET_DIR/.git" ]; then
        run git -C "$TARGET_DIR" fetch --prune
        run git -C "$TARGET_DIR" checkout "$BRANCH"
        run git -C "$TARGET_DIR" pull --ff-only

        return
    fi

    if [ -e "$TARGET_DIR" ]; then
        fail validation_failed "$TARGET_DIR exists but is not a git checkout"
    fi

    run git clone --branch "$BRANCH" "$REPO_URL" "$TARGET_DIR"
}

build_runtime_images() {
    require_docker

    ensure_runtime_image
    ensure_caddy_image
    ensure_dnsmasq_image
    ensure_frankenphp_image
    ensure_wg_easy_image
}

ensure_runtime_image() {
    if docker_cli image inspect "orbit-runtime:current" >/dev/null 2>&1; then
        return
    fi

    if [ -n "$RUNTIME_IMAGE_ARCHIVE" ]; then
        run docker_cli load -i "$RUNTIME_IMAGE_ARCHIVE"

        if docker_cli image inspect "orbit-runtime:current" >/dev/null 2>&1; then
            return
        fi

        fail validation_failed "runtime image archive did not load orbit-runtime:current: $RUNTIME_IMAGE_ARCHIVE"
    fi

    run docker_cli build \
        -f "$TARGET_DIR/docker/orbit-runtime/Dockerfile" \
        -t "orbit-runtime:current" \
        "$TARGET_DIR"
}

ensure_caddy_image() {
    if docker_cli image inspect "caddy:2-alpine" >/dev/null 2>&1; then
        return
    fi

    if [ -n "$CADDY_IMAGE_ARCHIVE" ]; then
        run docker_cli load -i "$CADDY_IMAGE_ARCHIVE"

        if docker_cli image inspect "caddy:2-alpine" >/dev/null 2>&1; then
            return
        fi

        fail validation_failed "caddy image archive did not load caddy:2-alpine: $CADDY_IMAGE_ARCHIVE"
    fi

    run docker_cli pull "caddy:2-alpine"
}

ensure_dnsmasq_image() {
    if [ -z "$DNSMASQ_IMAGE_ARCHIVE" ]; then
        return
    fi

    if docker_cli image inspect "4km3/dnsmasq:latest" >/dev/null 2>&1; then
        return
    fi

    run docker_cli load -i "$DNSMASQ_IMAGE_ARCHIVE"

    if docker_cli image inspect "4km3/dnsmasq:latest" >/dev/null 2>&1; then
        return
    fi

    fail validation_failed "dnsmasq image archive did not load 4km3/dnsmasq:latest: $DNSMASQ_IMAGE_ARCHIVE"
}

ensure_frankenphp_image() {
    if docker_cli image inspect "dunglas/frankenphp:1-php8.5-bookworm" >/dev/null 2>&1; then
        return
    fi

    if [ -n "$FRANKENPHP_IMAGE_ARCHIVE" ]; then
        run docker_cli load -i "$FRANKENPHP_IMAGE_ARCHIVE"

        if docker_cli image inspect "dunglas/frankenphp:1-php8.5-bookworm" >/dev/null 2>&1; then
            return
        fi

        fail validation_failed "frankenphp image archive did not load dunglas/frankenphp:1-php8.5-bookworm: $FRANKENPHP_IMAGE_ARCHIVE"
    fi

    run docker_cli pull "dunglas/frankenphp:1-php8.5-bookworm"
}

ensure_wg_easy_image() {
    if docker_cli image inspect "ghcr.io/wg-easy/wg-easy:15" >/dev/null 2>&1; then
        return
    fi

    if [ -z "$WG_EASY_IMAGE_ARCHIVE" ]; then
        return
    fi

    run docker_cli load -i "$WG_EASY_IMAGE_ARCHIVE"

    if docker_cli image inspect "ghcr.io/wg-easy/wg-easy:15" >/dev/null 2>&1; then
        return
    fi

    fail validation_failed "wg-easy image archive did not load ghcr.io/wg-easy/wg-easy:15: $WG_EASY_IMAGE_ARCHIVE"
}

read_env_var() {
    local key="$1"
    local value

    [ -f "$TARGET_DIR/apps/gateway/.env" ] || return 1

    value="$(grep -E "^${key}=" "$TARGET_DIR/apps/gateway/.env" | tail -n 1 | cut -d= -f2- || true)"

    if [ -z "$value" ]; then
        return 1
    fi

    printf '%s\n' "$value"
}

write_env_var() {
    local key="$1"
    local value="$2"

    ensure_log_file

    printf '%s' "$value" | php -r '
$path = $argv[1];
$key = $argv[2];
$value = stream_get_contents(STDIN);
$contents = file_exists($path) ? file_get_contents($path) : "";
$line = "{$key}={$value}";

if (preg_match("/^".preg_quote($key, "/")."=/m", $contents) === 1) {
    $contents = preg_replace("/^".preg_quote($key, "/")."=.*$/m", $line, $contents);
} else {
    $contents = rtrim($contents).PHP_EOL.$line.PHP_EOL;
}

file_put_contents($path, $contents);
' "$TARGET_DIR/apps/gateway/.env" "$key" >>"$LOG_FILE" 2>&1
}

generate_operation_token_secret() {
    php -r 'echo base64_encode(random_bytes(32));'
}

ensure_operation_token_secret() {
    local secret

    secret="${ORBIT_OPERATION_TOKEN_SECRET:-}"

    if [ -z "$secret" ]; then
        secret="$(read_env_var "ORBIT_OPERATION_TOKEN_SECRET" || true)"
    fi

    if [ -z "$secret" ]; then
        secret="$(read_env_var "ORBIT_EXECUTOR_SECRET" || true)"
    fi

    if [ -z "$secret" ]; then
        secret="$(generate_operation_token_secret)"
    fi

    write_env_var "ORBIT_OPERATION_TOKEN_SECRET" "$secret"
    write_env_var "ORBIT_EXECUTOR_SECRET" "$secret"

    export ORBIT_OPERATION_TOKEN_SECRET="$secret"
    export ORBIT_EXECUTOR_SECRET="$secret"
}

ensure_node_identity() {
    if [ -z "${ORBIT_NODE_IDENTITY:-}" ]; then
        return
    fi

    write_env_var "ORBIT_NODE_IDENTITY" "$ORBIT_NODE_IDENTITY"
}

ensure_forward_install_image_archives_flag() {
    if [ -z "$RUNTIME_IMAGE_ARCHIVE" ] && [ -z "$CADDY_IMAGE_ARCHIVE" ] && [ -z "$DNSMASQ_IMAGE_ARCHIVE" ] && [ -z "$FRANKENPHP_IMAGE_ARCHIVE" ]; then
        return
    fi

    write_env_var "ORBIT_FORWARD_INSTALL_IMAGE_ARCHIVES" "1"
    export ORBIT_FORWARD_INSTALL_IMAGE_ARCHIVES=1
}

clear_laravel_bootstrap_cache() {
    run rm -f \
        "$TARGET_DIR/apps/gateway/bootstrap/cache"/*.php
}

bootstrap_runtime() {
    require_docker

    if [ ! -f "$TARGET_DIR/apps/gateway/.env" ]; then
        run cp "$TARGET_DIR/apps/gateway/.env.example" "$TARGET_DIR/apps/gateway/.env"
    fi

    run mkdir -p "$TARGET_DIR/apps/gateway/database"

    if [ ! -f "$TARGET_DIR/apps/gateway/database/database.sqlite" ]; then
        run touch "$TARGET_DIR/apps/gateway/database/database.sqlite"
    fi

    ensure_operation_token_secret
    ensure_node_identity
    ensure_forward_install_image_archives_flag
    clear_laravel_bootstrap_cache

    run docker_cli run --rm \
        --pull never \
        -v "$TARGET_DIR":/opt/orbit \
        --workdir /opt/orbit/apps/gateway \
        orbit-runtime:current \
        composer install --no-dev --no-interaction --prefer-dist --optimize-autoloader

    run docker_cli run --rm \
        --pull never \
        -v "$TARGET_DIR":/opt/orbit \
        --workdir /opt/orbit/apps/cli \
        orbit-runtime:current \
        composer install --no-dev --no-interaction --prefer-dist --optimize-autoloader

    run docker_cli run --rm \
        --pull never \
        -v "$TARGET_DIR":/opt/orbit \
        --workdir /opt/orbit/apps/gateway \
        orbit-runtime:current \
        bash -lc "grep -q '^APP_KEY=base64:' .env || php artisan key:generate --force --no-interaction"
}

container_env_contains() {
    local needle="$1"
    local env_output

    # Capture docker output before piping into grep so pipefail does not
    # turn a SIGPIPE-on-early-grep-match into a false negative.
    env_output="$(docker_cli container inspect --format '{{range .Config.Env}}{{println .}}{{end}}' orbit-runtime 2>/dev/null || true)"

    grep -qxF -- "$needle" <<<"$env_output"
}

prepare_orbit_caddy_host_paths() {
    # orbit-runtime mounts /etc/caddy and /etc/orbit (rw) so the gateway
    # bootstrap inside the container can mutate the same host paths that
    # orbit-caddy reads. Docker `--mount type=bind` requires the source to
    # exist, so prepare it on the host first.
    sudo_run install -d -m 0755 \
        /etc/caddy \
        /etc/caddy/orbit \
        /etc/caddy/sites \
        /etc/orbit \
        /etc/orbit/certs
}

start_runtime_container() {
    require_docker
    prepare_orbit_caddy_host_paths

    if ! docker_cli network inspect orbit-network >/dev/null 2>&1; then
        run docker_cli network create \
            --label "orbit.managed=true" \
            --label "orbit.network.kind=runtime" \
            orbit-network
    fi

    local gateway_env=()
    if [ "$GATEWAY_MODE" = "1" ]; then
        gateway_env=(--env "ORBIT_IS_GATEWAY=1" --env "ORBIT_TRUST_WIREGUARD_PROXY_HEADER=1")
    fi

    if docker_cli container inspect orbit-runtime >/dev/null 2>&1; then
        local needs_recreate=0

        if [ "$GATEWAY_MODE" = "1" ] && ! container_env_contains "ORBIT_IS_GATEWAY=1"; then
            printf 'orbit-install: existing orbit-runtime container is missing ORBIT_IS_GATEWAY=1; recreating to enable the gateway API listener\n' >&2
            needs_recreate=1
        fi

        if [ "$GATEWAY_MODE" = "1" ] && [ "$needs_recreate" = "0" ] && ! container_env_contains "ORBIT_TRUST_WIREGUARD_PROXY_HEADER=1"; then
            printf 'orbit-install: existing orbit-runtime container is missing ORBIT_TRUST_WIREGUARD_PROXY_HEADER=1; recreating to enable gateway proxy identity\n' >&2
            needs_recreate=1
        fi

        if [ "$needs_recreate" = "0" ] && ! container_env_contains "ORBIT_HOST_PATH=$TARGET_DIR"; then
            printf 'orbit-install: existing orbit-runtime container is missing ORBIT_HOST_PATH=%s; recreating so host-path-aware operations work\n' "$TARGET_DIR" >&2
            needs_recreate=1
        fi

        if [ "$needs_recreate" = "1" ]; then
            run docker_cli rm -f orbit-runtime
        else
            local running
            running="$(docker_cli container inspect --format '{{.State.Running}}' orbit-runtime 2>/dev/null || true)"

            if [ "$running" != "true" ]; then
                run docker_cli start orbit-runtime
            fi

            return
        fi
    fi

    run docker_cli run -d \
        --pull never \
        --name orbit-runtime \
        --restart unless-stopped \
        --network orbit-network \
        --network-alias orbit-runtime \
        --label "orbit.managed=true" \
        --label "orbit.container.kind=runtime" \
        --env "ORBIT_SOURCE_PATH=/opt/orbit" \
        --env "ORBIT_HOST_PATH=$TARGET_DIR" \
        "${gateway_env[@]}" \
        --mount "type=bind,source=$TARGET_DIR,target=/opt/orbit" \
        --mount "type=bind,source=/var/run/docker.sock,target=/var/run/docker.sock" \
        --mount "type=bind,source=/etc/caddy,target=/etc/caddy" \
        --mount "type=bind,source=/etc/orbit,target=/etc/orbit" \
        orbit-runtime:current
}

run_migrations_in_container() {
    require_docker

    run docker_cli run --rm \
        --pull never \
        -v "$TARGET_DIR":/opt/orbit \
        orbit-runtime:current \
        php /opt/orbit/apps/gateway/artisan migrate --force --no-interaction
}

link_orbit() {
    if [ -e "$LINK_PATH" ] && [ ! -L "$LINK_PATH" ]; then
        fail validation_failed "$LINK_PATH exists and is not a symlink"
    fi

    if [ ! -f "$TARGET_DIR/bin/orbit" ]; then
        fail validation_failed "Orbit launcher missing: $TARGET_DIR/bin/orbit"
    fi

    run chmod 0755 "$TARGET_DIR/bin/orbit"
    sudo_run ln -sf "$TARGET_DIR/bin/orbit" "$LINK_PATH"
}

# Write the per-operator-host CLI JSON config skeleton at ~/.config/orbit/config.json
# per decisions D8, D11, D13. The actual gateway entry is populated later by
# gateway:add / gateway:trust / node:new --template=gateway on the operator host. The skeleton
# only guarantees the file exists with correct ownership and permissions so the importer
# does not race with first-CLI-run.
#
# The gateway-runtime self-trust store (LocalGatewaySettings in apps/gateway SQLite) is
# written separately by the gateway-runtime container during bootstrap per decision D17.
# These two writers are documented as the dual-writer contract; they describe overlapping
# state from different OS-user perspectives.
write_cli_config_skeleton() {
    local target_home
    local config_dir
    local config_file

    target_home="${ORBIT_CONFIG_HOME:-$HOME}"

    if [ -z "$target_home" ]; then
        # No HOME — skip silently; first CLI run will write the skeleton itself.
        return 0
    fi

    config_dir="${target_home}/.config/orbit"
    config_file="${config_dir}/config.json"

    if [ -e "$config_file" ]; then
        # Idempotent: never overwrite an existing config (D11 importer contract).
        return 0
    fi

    run mkdir -p "$config_dir"
    run chmod 0700 "$config_dir"

    cat > "$config_file" <<'JSON'
{
    "schema_version": 1,
    "active_gateway": null,
    "gateways": {},
    "defaults": {"node": null, "profile": null},
    "meta": {"imported_from": null, "imported_at": null}
}
JSON
    run chmod 0600 "$config_file"
}

verify_install() {
    if [ ! -x "$TARGET_DIR/bin/orbit" ]; then
        fail validation_failed "Orbit launcher is not executable: $TARGET_DIR/bin/orbit"
    fi

    local running
    running="$(docker_cli container inspect --format '{{.State.Running}}' orbit-runtime 2>/dev/null || true)"

    if [ "$running" != "true" ]; then
        fail validation_failed "orbit-runtime container is not running after install"
    fi
}

finalize_target_ownership() {
    local parent
    local parent_owner

    parent="$(dirname "$TARGET_DIR")"

    case "$(uname -s)" in
        Linux)
            parent_owner="$(stat -c '%U:%G' "$parent" 2>/dev/null || true)"
            ;;
        Darwin)
            parent_owner="$(stat -f '%Su:%Sg' "$parent" 2>/dev/null || true)"
            ;;
        *)
            return
            ;;
    esac

    if [ -z "$parent_owner" ] || [ "${parent_owner%:*}" = "$(id -un)" ]; then
        return
    fi

    sudo_run chown -R "$parent_owner" "$TARGET_DIR"
}

main() {
    parse_args "$@"

    ensure_log_file
    trap 'fail_step "$?"' ERR

    render_plan

    start_step "Validate installer input"
    validate_args
    complete_step

    start_step "Install host prerequisites"
    install_prerequisites
    complete_step

    start_step "Install Orbit source"
    install_source
    complete_step

    start_step "Prepare runtime Docker images"
    build_runtime_images
    complete_step

    start_step "Bootstrap Orbit runtime in the container"
    bootstrap_runtime
    complete_step

    start_step "Run migrations inside orbit-runtime"
    run_migrations_in_container
    complete_step

    start_step "Start orbit-runtime container"
    start_runtime_container
    complete_step

    start_step "Align orbit checkout ownership"
    finalize_target_ownership
    complete_step

    start_step "Link orbit executable"
    link_orbit
    complete_step

    start_step "Write CLI config skeleton"
    write_cli_config_skeleton
    complete_step

    start_step "Verify Orbit"
    verify_install
    complete_step

    finish_tree
}

if [ "${BASH_SOURCE[0]:-$0}" = "$0" ]; then
    main "$@"
fi
