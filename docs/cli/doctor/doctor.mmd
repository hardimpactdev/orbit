sequenceDiagram
  %% Target design: Nick 2026-11-01, liveness 2026-11-02. Only the Node agent collects facts; doctor reads Gateway state. No Swamp run, no SSH (R1).
  %% status: reviewed
  %% command: doctor
  %% kind: doctor.inspect
  autonumber
  %% lane CLI icon=terminal pill=caller tone=gray
  %% lane GW icon=gateway pill=intent tone=blue
  %% lane A icon=server pill=observer tone=amber
  participant CLI as CLI / MCP<br/>orbit · MCP tools
  participant GW as Gateway<br/>Laravel API
  participant A as Node agent<br/>orbit-agent
  loop on a short interval
    A->>GW: Heartbeat
    %%> Result:
    %%> - the Gateway marks the Node online
    %%> - when heartbeats stop, it marks the Node offline, shown in the web dashboard and in node:list and node:show
  end
  loop continuously, on change
    Note over A: Observe the Node<br/>services, Processes, disk, ufw
    A->>GW: Report observations<br/>with observed_at
    Note over GW: Store latest facts<br/>per Node, per check
  end
  CLI->>GW: doctor --node=7<br/>{families: [node, firewall]}
  Note over GW: Compare facts with intent<br/>exact, drift, missing
  %%> Doctor always answers from the Gateway's state:
  %%> - it never starts a run and never SSHes into the Node
  alt agent online
    GW-->>CLI: Report<br/>agent online · findings
    %%> Result:
    %%> - first line: agent online
    %%> - then the findings; exit 0 with no drift, 1 with drift
  else agent offline
    GW-->>CLI: Report<br/>agent offline since 12:04
    %%> Result:
    %%> - first line: agent offline since <time>
    %%> - the findings still show, each marked "possibly outdated, agent silent since <time>"
    %%> - a nudge to look at the Node agent first
  end
