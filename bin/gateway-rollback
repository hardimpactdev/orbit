#!/usr/bin/env bash
# Switches the Gateway to a retained release: the release run switches forward with it, and an operator rolls back
# with it when Swamp or the Gateway cannot run `gateway:release:rollback`. Run it on the Gateway Node with sudo.
# It switches the application link, and the web link when the release keeps its web build, reloads PHP-FPM so every
# request runs the release, and restarts each running service that runs from the application, such as the scheduler.
# A restart of Horizon waits for its running jobs, up to the drain, because the unit carries the stop policy.
# It changes no schema and restores no snapshot. docs/reference/gateway-recovery.md#roll-back-without-swamp
set -euo pipefail

base=${ORBIT_RELEASE_BASE:-/home/orbit}
id=${1:-}
fail() { echo "gateway-rollback: $*" >&2; exit 1; }

[[ $id =~ ^[0-9a-f]{12}$ ]] || { echo 'usage: sudo bin/gateway-rollback <12-digit release id>' >&2; exit 64; }
sha=$(cat "$base/releases/$id/REVISION" 2>/dev/null) || fail "release $id is not sealed: $base/releases/$id/REVISION is missing"
[[ $sha == "$id"* ]] || fail "release $id holds REVISION $sha"

owner=$(stat -c %U "$base/orbit")
as_owner() { if [ "$(id -un)" = "$owner" ]; then "$@"; else runuser -u "$owner" -- "$@"; fi; }
swap() { as_owner rm -f "$1.next" && as_owner ln -s "releases/$id" "$1.next" && as_owner mv -T "$1.next" "$1"; }

swap "$base/orbit"
echo "gateway-rollback: $base/orbit -> releases/$id"
if [ -f "$base/web/releases/$id/index.html" ]; then
    swap "$base/web/current"
    echo "gateway-rollback: $base/web/current -> releases/$id"
else
    echo "gateway-rollback: release $id keeps no web build; the web app stays as it is"
fi

application=$base/orbit/apps/gateway
# A reload replaces every PHP-FPM worker and clears OPcache; requests in flight finish first.
systemctl reload php8.5-fpm && echo "gateway-rollback: reloaded php8.5-fpm"
# Only running services: a stopped Process stays stopped, and a running one-shot unit is activating, not active.
for unit in $(systemctl list-units --type=service --state=active --plain --no-legend | awk '{print $1}'); do
    directory=$(systemctl show -p WorkingDirectory --value "$unit")
    case $directory in "$application" | "$application"/*) systemctl restart "$unit" && echo "gateway-rollback: restarted $unit" ;; esac
done
# Horizon is the Gateway's queue, and a release drains it before the switch, so a stopped Horizon is what a failed release leaves behind: start it.
# A template such as getty@.service has no properties to show, and a unit that cannot be read is not Horizon.
for unit in $(systemctl list-unit-files --type=service --state=enabled --plain --no-legend | awk '{print $1}'); do
    case $unit in *@.service) continue ;; esac
    directory=$(systemctl show -p WorkingDirectory --value "$unit" 2>/dev/null) || continue
    case $directory in "$application" | "$application"/*) ;; *) continue ;; esac
    { systemctl show -p ExecStart --value "$unit" 2>/dev/null || true; } | grep -q 'artisan horizon ;' || continue
    systemctl is-active --quiet "$unit" || { systemctl start "$unit" && echo "gateway-rollback: started $unit"; }
done
