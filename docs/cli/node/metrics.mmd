sequenceDiagram
  %% Target design: a synchronous read of the Node agent's metrics snapshot from Gateway records. Node family read rules and docs/reference/node-agent.md#liveness.
  %% status: draft
  %% command: node:metrics
  %% kind: node.metrics
  autonumber
  %% lane CLI icon=terminal pill=caller tone=gray
  %% lane GW icon=gateway pill=intent tone=blue
  participant CLI as CLI / MCP<br/>orbit · MCP tools
  participant GW as Gateway<br/>Laravel API
  CLI->>GW: node:metrics NODE
  %%> Command:
  %%> - `orbit node:metrics NODE`
  %%> - syntax: `<node> [--json]`
  Note over GW: Resolve and authorize
  %%> Requirements:
  %%> - apply the shared Node authority rule (`NodeAccessAuthorizer`), linked from `docs/cli/node/metrics.mdx` to the Node family page
  alt unknown Node
    %% path: unknown-node
    GW--xCLI: 404 Not Found<br/>http.404
    %%> Result:
    %%> - no Node record matches the ID
  else refused caller
    %% path: refused-caller
    GW--xCLI: 403 Forbidden<br/>node_access.required
    %%> Result:
    %%> - the shared Node authority rule refuses the caller
  else authorized Node
    %% path: authorized
    Note over GW: Read recorded snapshot
    %%> What it does:
    %%> - reads only the latest metrics snapshot reported by this Node's agent and the recorded agent liveness
    %%> - contacts no Node or other system, waits for no report and starts no run
    alt no snapshot yet
      %% path: no-snapshot
      GW--xCLI: 422 Unprocessable<br/>node.metrics_unavailable
      %%> Result:
      %%> - no metrics snapshot has been recorded for this Node
    else stale snapshot
      %% path: stale-snapshot
      GW-->>CLI: 200 OK<br/>snapshot · possibly outdated
      %%> Result:
      %%> - returns the retained snapshot, its observation time and agent state; `possibly_outdated` is true when the agent state is not `online`
      %%> - offline wording matches `node:show`: `offline since <time>`; `not_seen` and `unknown` keep their shared meanings
    else current snapshot
      %% path: current-snapshot
      GW-->>CLI: 200 OK<br/>snapshot · observation time
      %%> Result:
      %%> - returns the snapshot with Node name and ID, observation time and agent state; `possibly_outdated` is false
    end
  end
  Note over GW: Leave state unchanged
  %%> Result:
  %%> - success and refusal change no records or Node state
  %%> - a repeat reads the latest recorded snapshot again; it is not a skipped action
