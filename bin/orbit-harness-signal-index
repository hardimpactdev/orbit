#!/usr/bin/env php
<?php

declare(strict_types=1);

const MAX_SIGNAL_SUMMARY_LENGTH = 240;

const MAX_REAPPEARANCE_CHECK_LENGTH = 240;

$options = getopt('', ['check', 'write', 'help']);

if (array_key_exists('help', $options)) {
    fwrite(STDOUT, <<<'EOF'
        Usage:
          bin/orbit-harness-signal-index
              Print the generated harness signal index JSON to stdout.
          bin/orbit-harness-signal-index --write
              Write harness-signals/index.json from harness-signals/YYYY-*.md records.
          bin/orbit-harness-signal-index --check
              Fail when harness-signals/index.json is missing or stale.
          bin/orbit-harness-signal-index --help
              Show this help text.

        The index is deterministic metadata for quick routing before opening records.
        Signal files remain curated harness history, not product authority.
        EOF);

    exit(0);
}

$root = dirname(__DIR__);
$indexPath = $root . '/harness-signals/index.json';
$index = build_index($root);

if (array_key_exists('check', $options)) {
    if (!is_file($indexPath)) {
        fwrite(STDERR, "Harness signal index is missing. Run `bin/orbit-harness-signal-index --write`.\n");

        exit(1);
    }

    $committed = file_get_contents($indexPath);

    if ($committed === false) {
        fwrite(STDERR, "Harness signal index could not be read at {$indexPath}.\n");

        exit(1);
    }

    if ($committed !== to_json($index)) {
        fwrite(STDERR, "Harness signal index is stale. Run `bin/orbit-harness-signal-index --write`.\n");

        exit(1);
    }

    fwrite(STDOUT, "Harness signal index is up to date.\n");

    exit(0);
}

$json = to_json($index);

if (array_key_exists('write', $options)) {
    $directory = dirname($indexPath);

    if (!is_dir($directory) && !mkdir($directory, permissions: 0o775, recursive: true) && !is_dir($directory)) {
        fwrite(STDERR, "Unable to create harness signal index directory: {$directory}\n");

        exit(1);
    }

    if (file_put_contents($indexPath, $json) === false) {
        fwrite(STDERR, "Unable to write harness signal index: {$indexPath}\n");

        exit(1);
    }

    fwrite(STDOUT, "Wrote {$indexPath}.\n");

    exit(0);
}

fwrite(STDOUT, $json);

/**
 * @return array<string, mixed>
 */
function build_index(string $root): array
{
    $recordsDirectory = $root . '/harness-signals';
    $paths = glob($recordsDirectory . '/????-??-??-*.md') ?: [];
    sort($paths, SORT_STRING);

    $entries = [];

    foreach ($paths as $absolutePath) {
        $relativePath = 'harness-signals/' . basename($absolutePath);
        $content = file_get_contents($absolutePath);

        if ($content === false) {
            continue;
        }

        $entries[] = parse_record($relativePath, $content);
    }

    return [
        'schema_version' => 1,
        'generated_from' => 'harness-signals/YYYY-*.md',
        'entry_count' => count($entries),
        'entries' => $entries,
    ];
}

/**
 * @return array<string, mixed>
 */
function parse_record(string $path, string $content): array
{
    $title = parse_title($content);
    $metadata = parse_metadata_block($content);

    return [
        'path' => $path,
        'title' => $title,
        'status' => nullable_string($metadata['Status'] ?? null),
        'signal_type' => nullable_string($metadata['Signal type'] ?? null),
        'guardrail_target' => parse_list_value($metadata['Guardrail target'] ?? null),
        'guardrail_change' => nullable_string($metadata['Guardrail change'] ?? null),
        'related_signals' => parse_list_value($metadata['Related signals'] ?? null),
        'superseded_by' => parse_nullable_reference($metadata['Superseded by'] ?? null),
        'tags' => parse_list_value($metadata['Tags'] ?? null),
        'signal_summary' => parse_section_paragraph($content, 'Signal'),
        'reappearance_check' => parse_section_text($content, 'Reappearance Check', MAX_REAPPEARANCE_CHECK_LENGTH),
    ];
}

function parse_title(string $content): ?string
{
    if (!preg_match('/^#\s+Signal:\s+(.+)$/m', $content, $matches)) {
        return null;
    }

    return normalize_whitespace($matches[1]);
}

/**
 * @return array<string, string>
 */
function parse_metadata_block(string $content): array
{
    $metadata = [];

    foreach (preg_split('/\R/', $content) ?: [] as $line) {
        if (str_starts_with($line, '## ')) {
            break;
        }

        if (!preg_match('/^([A-Za-z][A-Za-z ]+):\s*(.*)$/', $line, $matches)) {
            continue;
        }

        $metadata[$matches[1]] = trim($matches[2]);
    }

    return $metadata;
}

/**
 * @return list<string>
 */
function parse_list_value(?string $value): array
{
    if ($value === null || $value === '' || strcasecmp($value, 'none') === 0) {
        return [];
    }

    $items = array_map(
        static fn(string $item): string => trim($item),
        preg_split('/\s*[;,]\s*/', $value, flags: PREG_SPLIT_NO_EMPTY) ?: [],
    );

    return array_values(array_filter(
        $items,
        static fn(string $item): bool => $item !== '' && strcasecmp($item, 'none') !== 0,
    ));
}

function parse_nullable_reference(?string $value): ?string
{
    if ($value === null || $value === '' || strcasecmp($value, 'none') === 0) {
        return null;
    }

    return $value;
}

function nullable_string(?string $value): ?string
{
    if ($value === null || $value === '') {
        return null;
    }

    return $value;
}

function parse_section_paragraph(string $content, string $heading): ?string
{
    $section = parse_section_text($content, $heading);

    if ($section === null) {
        return null;
    }

    $paragraph = preg_split('/\R\s*\R/', $section, 2)[0] ?? $section;

    return compact_text(normalize_whitespace($paragraph), MAX_SIGNAL_SUMMARY_LENGTH);
}

function parse_section_text(string $content, string $heading, ?int $maxLength = null): ?string
{
    $pattern = '/^##\s+' . preg_quote($heading, '/') . '\s*\R(.*?)(?=^##\s+|\z)/ms';

    if (!preg_match($pattern, $content, $matches)) {
        return null;
    }

    $text = trim($matches[1]);

    if ($text === '') {
        return null;
    }

    $normalized = normalize_whitespace($text);

    if ($maxLength === null) {
        return $normalized;
    }

    return compact_text($normalized, $maxLength);
}

function normalize_whitespace(string $value): string
{
    return trim((string) preg_replace('/\s+/u', ' ', $value));
}

function compact_text(string $value, int $maxLength): string
{
    if (strlen($value) <= $maxLength) {
        return $value;
    }

    $words = preg_split('/\s+/u', $value) ?: [];
    $compacted = '';

    foreach ($words as $word) {
        $candidate = $compacted === '' ? $word : "{$compacted} {$word}";

        if (strlen($candidate) > ($maxLength - 3)) {
            break;
        }

        $compacted = $candidate;
    }

    if ($compacted === '') {
        return '...';
    }

    return rtrim($compacted, '.,;:') . '...';
}

/**
 * @param array<string, mixed> $index
 */
function to_json(array $index): string
{
    return json_encode($index, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR) . "\n";
}
