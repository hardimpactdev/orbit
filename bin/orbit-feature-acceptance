#!/usr/bin/env php
<?php

declare(strict_types=1);

require_once __DIR__.'/orbit-feedback-events.php';
require_once __DIR__.'/orbit-loop-contract.php';
require_once __DIR__.'/orbit-secret-rules.php';

try {
    $command = $argv[1] ?? null;
    $options = acceptanceOptions(array_slice($argv, 2));
    $cwd = realpath((string) ($options['cwd'] ?? getcwd())) ?: (string) ($options['cwd'] ?? getcwd());
    $loopPath = (string) ($options['loop'] ?? "{$cwd}/.orbit/loop.md");

    if (! is_file($loopPath) || is_link($loopPath)) {
        throw new RuntimeException("compact loop is missing: {$loopPath}");
    }

    match ($command) {
        'ready' => acceptanceReady($cwd, $loopPath, $options),
        'accept' => acceptanceAccept($cwd, $loopPath, $options),
        'reprove' => acceptanceReprove($cwd, $loopPath, $options),
        'invalidate' => acceptanceInvalidate($loopPath, $options),
        'show' => acceptanceShow($cwd, $loopPath),
        default => throw new RuntimeException(
            'Usage: bin/orbit-feature-acceptance ready|accept|reprove|invalidate|show [options]',
        ),
    };
} catch (Throwable $exception) {
    fwrite(STDERR, $exception->getMessage().PHP_EOL);
    exit(2);
}

/**
 * @param list<string> $arguments
 * @return array<string, string|bool>
 */
function acceptanceOptions(array $arguments): array
{
    $options = [];

    foreach ($arguments as $argument) {
        if (! str_starts_with($argument, '--')) {
            throw new RuntimeException("Unexpected argument: {$argument}");
        }

        $parts = explode('=', substr($argument, 2), 2);
        $options[$parts[0]] = $parts[1] ?? true;
    }

    return $options;
}

/** @param array<string, string|bool> $options */
function acceptanceReady(string $cwd, string $loopPath, array $options): never
{
    acceptanceRequireClean($cwd);
    acceptanceRequireSecretClean($cwd, dirname($loopPath));
    acceptanceRequireFeedbackValid(dirname($loopPath).'/feedback.jsonl');
    $loop = acceptanceLoop($loopPath);
    $review = orbitLoopLabel($loop, 'Proof', 'Review');

    if (! orbitLoopReviewPassed($review)) {
        throw new RuntimeException('review is not passed');
    }

    $featureTip = acceptanceGitRequired($cwd, ['rev-parse', 'HEAD']);
    $reviewProblem = orbitLoopReviewedIdentityProblem($loop, $featureTip);

    if ($reviewProblem !== null) {
        throw new RuntimeException($reviewProblem);
    }

    $minimum = orbitLoopAcceptanceVenue(orbitLoopChangedFiles($cwd));
    $defaultVenue = orbitLoopReviewSaysNonObservable($review) ? 'automated' : $minimum;
    $venue = (string) ($options['venue'] ?? $defaultVenue);

    if (! in_array($venue, ORBIT_LOOP_ACCEPTANCE_VENUES, true)) {
        throw new RuntimeException("invalid acceptance venue: {$venue}");
    }

    if (! orbitLoopVenueSatisfies($venue, $minimum, $review)) {
        throw new RuntimeException("acceptance venue {$venue} is weaker than {$minimum}");
    }

    $loop = orbitLoopSetLabel($loop, 'Proof', 'Acceptance venue', $venue);
    $loop = orbitLoopSetLabel($loop, 'Proof', 'Acceptance', 'pending');
    $loop = orbitLoopSetLabel($loop, 'Proof', 'Accepted feature tip', 'none');
    $loop = orbitLoopSetLabel($loop, 'Proof', 'Accepted main tip', 'none');
    $loop = orbitLoopSetLabel($loop, 'Status', 'State', 'accept');
    $loop = orbitLoopSetLabel($loop, 'Status', 'Blocker', 'none');
    acceptanceWriteLoop($loopPath, $loop);

    fwrite(STDOUT, "ACCEPTANCE READY venue={$venue}\n");
    exit(0);
}

/** @param array<string, string|bool> $options */
function acceptanceAccept(string $cwd, string $loopPath, array $options): never
{
    acceptanceRequireClean($cwd);
    acceptanceRequireSecretClean($cwd, dirname($loopPath));
    acceptanceRequireFeedbackValid(dirname($loopPath).'/feedback.jsonl');
    $loop = acceptanceLoop($loopPath);
    $review = orbitLoopLabel($loop, 'Proof', 'Review');

    if (! orbitLoopReviewPassed($review)) {
        throw new RuntimeException('review is not passed');
    }

    $featureTip = acceptanceGitRequired($cwd, ['rev-parse', 'HEAD']);
    $reviewProblem = orbitLoopReviewedIdentityProblem($loop, $featureTip);

    if ($reviewProblem !== null) {
        throw new RuntimeException($reviewProblem);
    }

    $actor = acceptanceRequiredOption($options, 'actor');

    if (! in_array($actor, ['user', 'automated'], true)) {
        throw new RuntimeException('acceptance actor must be user or automated');
    }

    $minimum = orbitLoopAcceptanceVenue(orbitLoopChangedFiles($cwd));
    $venue = (string) orbitLoopLabel($loop, 'Proof', 'Acceptance venue');

    if ($actor === 'automated' && ! orbitLoopReviewSaysNonObservable($review)) {
        throw new RuntimeException('automated acceptance requires reviewer-confirmed non-observable behavior');
    }

    if (! orbitLoopVenueSatisfies($venue, $minimum, $review)) {
        throw new RuntimeException("acceptance venue {$venue} is weaker than {$minimum}");
    }

    $mainTip = acceptanceGitRequired($cwd, ['rev-parse', 'main']);
    $acceptanceValue = 'accepted - automated - reviewer-confirmed non-observable';

    if ($actor === 'user') {
        $sourceRef = acceptanceRequiredOption($options, 'source-ref');
        $raw = rtrim((string) stream_get_contents(STDIN), "\r\n");

        if (! orbitFeedbackSourceRefIsValid($sourceRef)) {
            throw new RuntimeException('user acceptance requires a safe Codex or Solo source reference');
        }

        if ($raw === '') {
            throw new RuntimeException('user acceptance requires the verbatim message on STDIN');
        }

        acceptanceAppendUserMessage(dirname($loopPath).'/feedback.jsonl', $raw, $sourceRef, $featureTip, $venue);
        $acceptanceValue = "accepted - user @ {$sourceRef}";
    }

    $loop = orbitLoopSetLabel($loop, 'Proof', 'Acceptance', $acceptanceValue);
    $loop = orbitLoopSetLabel($loop, 'Proof', 'Accepted feature tip', $featureTip);
    $loop = orbitLoopSetLabel($loop, 'Proof', 'Accepted main tip', $mainTip);
    $loop = orbitLoopSetLabel($loop, 'Status', 'State', 'accepted');
    $loop = orbitLoopSetLabel($loop, 'Status', 'Blocker', 'none');
    acceptanceWriteLoop($loopPath, $loop);

    fwrite(STDOUT, "ACCEPTED feature={$featureTip} main={$mainTip}\n");
    exit(0);
}

/** @param array<string, string|bool> $options */
function acceptanceReprove(string $cwd, string $loopPath, array $options): never
{
    acceptanceRequireClean($cwd);
    acceptanceRequireSecretClean($cwd, dirname($loopPath));
    throw new RuntimeException(
        'main moved after acceptance; integrate main into the feature, then repeat PROVE and ACCEPT on the new HEAD',
    );
}

/** @param array<string, string|bool> $options */
function acceptanceInvalidate(string $loopPath, array $options): never
{
    $reason = orbitRedactSecrets(acceptanceRequiredOption($options, 'reason'))['text'];
    $loop = acceptanceLoop($loopPath);
    $loop = orbitLoopSetLabel($loop, 'Proof', 'Review', 'fix - acceptance invalidated - '.$reason);
    $loop = orbitLoopSetLabel($loop, 'Proof', 'Reviewed feature tip', 'none');
    $loop = orbitLoopSetLabel($loop, 'Proof', 'Acceptance', 'changes-requested - '.$reason);
    $loop = orbitLoopSetLabel($loop, 'Proof', 'Accepted feature tip', 'none');
    $loop = orbitLoopSetLabel($loop, 'Proof', 'Accepted main tip', 'none');
    $loop = orbitLoopSetLabel($loop, 'Status', 'State', 'build');
    acceptanceWriteLoop($loopPath, $loop);

    fwrite(STDOUT, "INVALIDATED reason={$reason}\n");
    exit(0);
}

function acceptanceShow(string $cwd, string $loopPath): never
{
    $loop = acceptanceLoop($loopPath);
    $featureTip = acceptanceGitRequired($cwd, ['rev-parse', 'HEAD']);
    $mainTip = acceptanceGitRequired($cwd, ['rev-parse', 'main']);
    $acceptedFeature = orbitLoopLabel($loop, 'Proof', 'Accepted feature tip');
    $acceptedMain = orbitLoopLabel($loop, 'Proof', 'Accepted main tip');
    $status = orbitLoopStatusHead(orbitLoopLabel($loop, 'Status', 'State')) ?? 'unknown';

    if (
        $acceptedFeature !== null
        && preg_match('/^[0-9a-f]{40}$/', $acceptedFeature) === 1
        && ! hash_equals($featureTip, $acceptedFeature)
    ) {
        $status = 'changes-requested';
    } elseif (
        $acceptedMain !== null
        && preg_match('/^[0-9a-f]{40}$/', $acceptedMain) === 1
        && ! hash_equals($mainTip, $acceptedMain)
    ) {
        $status = 'reproof-required';
    }

    fwrite(
        STDOUT,
        json_encode(
            [
                'status' => $status,
                'feature_tip' => $featureTip,
                'main_tip' => $mainTip,
                'accepted_feature_tip' => $acceptedFeature,
                'accepted_main_tip' => $acceptedMain,
                'acceptance' => orbitLoopLabel($loop, 'Proof', 'Acceptance'),
                'venue' => orbitLoopLabel($loop, 'Proof', 'Acceptance venue'),
            ],
            JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR,
        )
            .PHP_EOL,
    );
    exit(0);
}

function acceptanceLoop(string $path): string
{
    $loop = (string) file_get_contents($path);

    if (! orbitLoopIsCompact($loop)) {
        throw new RuntimeException('acceptance requires the compact Orbit feature loop');
    }

    return $loop;
}

function acceptanceRequireClean(string $cwd): void
{
    $status = acceptanceGitRequired($cwd, ['status', '--porcelain', '--untracked-files=all']);

    if ($status === '') {
        return;
    }

    $first = trim((string) strtok($status, "\n"));
    throw new RuntimeException("accepted HEAD omits an uncommitted or nonignored untracked file: {$first}");
}

function acceptanceRequireSecretClean(string $cwd, string $orbitDir): void
{
    [$exitCode, , $stderr] = acceptanceRun([
        __DIR__.'/orbit-secret-scan',
        "--worktree={$cwd}",
        "--orbit-dir={$orbitDir}",
    ], $cwd);

    if ($exitCode !== 0) {
        throw new RuntimeException(trim($stderr));
    }
}

function acceptanceRequireFeedbackValid(string $path): void
{
    if (! file_exists($path) && ! is_link($path)) {
        return;
    }

    try {
        $events = orbitFeedbackRead($path);
        orbitFeedbackRequireActionableClosure($events);
    } catch (Throwable $exception) {
        throw new RuntimeException('feedback stream is invalid: '.$exception->getMessage(), previous: $exception);
    }
}

function acceptanceAppendUserMessage(
    string $stream,
    string $raw,
    string $sourceRef,
    string $featureTip,
    string $venue,
): void {
    $redacted = orbitRedactSecrets($raw);
    $event = [
        'schema_version' => 1,
        'type' => 'feedback.recorded',
        'id' => 'feedback-acceptance-'.gmdate('YmdHis').'-'.bin2hex(random_bytes(6)),
        'recorded_at' => gmdate('c'),
        'raw_text' => $redacted['text'],
        'session_ref' => $sourceRef,
        'candidate_commit' => $featureTip,
        'surface' => 'acceptance.'.$venue,
        'actionable' => false,
        'context' => ['kind' => 'acceptance'],
        'evidence' => [],
    ];

    if ($redacted['redactions'] !== []) {
        $event['raw_sha256'] = $redacted['raw_sha256'];
        $event['redactions'] = $redacted['redactions'];
    }

    orbitFeedbackAppend($stream, $event);
}

function acceptanceWriteLoop(string $path, string $contents): void
{
    $finding = orbitSecretFindings($contents)[0] ?? null;

    if ($finding !== null) {
        throw new RuntimeException("compact loop contains secret-shaped content rule={$finding['rule']}");
    }

    $temporary = dirname($path).'/.'.basename($path).'.tmp-'.bin2hex(random_bytes(6));

    if (file_put_contents($temporary, rtrim($contents).PHP_EOL) === false || ! rename($temporary, $path)) {
        @unlink($temporary);
        throw new RuntimeException("unable to update compact loop: {$path}");
    }
}

/** @param array<string, string|bool> $options */
function acceptanceRequiredOption(array $options, string $name): string
{
    $value = $options[$name] ?? null;

    if (! is_string($value) || trim($value) === '') {
        throw new RuntimeException("missing --{$name}");
    }

    return trim($value);
}

/** @param list<string> $arguments */
function acceptanceGitRequired(string $cwd, array $arguments): string
{
    [$exitCode, $stdout, $stderr] = acceptanceRun(['git', ...$arguments], $cwd);

    if ($exitCode !== 0) {
        throw new RuntimeException(trim($stderr) ?: 'Git command failed: git '.implode(' ', $arguments));
    }

    return trim($stdout);
}

/**
 * @param list<string> $command
 * @return array{int, string, string}
 */
function acceptanceRun(array $command, string $cwd): array
{
    $process = proc_open(
        $command,
        [
            0 => ['file', '/dev/null', 'r'],
            1 => ['pipe', 'w'],
            2 => ['pipe', 'w'],
        ],
        $pipes,
        $cwd,
    );

    if (! is_resource($process)) {
        throw new RuntimeException('Unable to start process: '.implode(' ', $command));
    }

    $stdout = (string) stream_get_contents($pipes[1]);
    $stderr = (string) stream_get_contents($pipes[2]);
    fclose($pipes[1]);
    fclose($pipes[2]);

    return [proc_close($process), $stdout, $stderr];
}
