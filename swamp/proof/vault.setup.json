{
  "kind": "vault.setup",
  "workflow": "operation-vault-setup",
  "topology": "minimal",
  "budget_seconds": 180,
  "queue_timeout_seconds": 30,
  "expect": {
    "status": "succeeded"
  },
  "before_gateway": [
    [
      "python3",
      "-I",
      "tools/swamp-proof-guest/vaultwarden_setup.py"
    ]
  ],
  "prepare": [
    {
      "method": "POST",
      "path": "extensions/vault/enable",
      "body": {},
      "operation": false
    }
  ],
  "request": {
    "method": "PUT",
    "path": "vault",
    "body": {
      "url": "${secret.url}",
      "client_id": "${secret.client_id}",
      "client_secret": "${secret.client_secret}",
      "master_password": "${secret.master_password}",
      "organization": "${secret.organization}",
      "collection": "${secret.collection}"
    }
  },
  "phases": [
    {
      "name": "Prepare public data",
      "job": "setup",
      "step": "Prepare public data",
      "budget_seconds": 30
    },
    {
      "name": "workspace",
      "job": "setup",
      "step": "workspace",
      "budget_seconds": 60
    },
    {
      "name": "Prepare session file",
      "job": "setup",
      "step": "Prepare session file",
      "budget_seconds": 30
    },
    {
      "name": "Configure the server",
      "job": "setup",
      "step": "Configure the server",
      "budget_seconds": 60
    },
    {
      "name": "Log in",
      "job": "setup",
      "step": "Log in",
      "budget_seconds": 60
    },
    {
      "name": "Unlock the vault",
      "job": "setup",
      "step": "Unlock the vault",
      "budget_seconds": 60
    },
    {
      "name": "Resolve the session",
      "job": "setup",
      "step": "Resolve the session",
      "budget_seconds": 30
    },
    {
      "name": "Read account status",
      "job": "setup",
      "step": "Read account status",
      "budget_seconds": 60
    },
    {
      "name": "Read organizations",
      "job": "setup",
      "step": "Read organizations",
      "budget_seconds": 60
    },
    {
      "name": "Read collections",
      "job": "setup",
      "step": "Read collections",
      "budget_seconds": 60
    },
    {
      "name": "Check account KDF",
      "job": "setup",
      "step": "Check account KDF",
      "budget_seconds": 30
    },
    {
      "name": "Select the organization",
      "job": "setup",
      "step": "Select the organization",
      "budget_seconds": 30
    },
    {
      "name": "Select the collection",
      "job": "setup",
      "step": "Select the collection",
      "budget_seconds": 30
    },
    {
      "name": "Probe write access",
      "job": "setup",
      "step": "Probe write access",
      "budget_seconds": 60
    },
    {
      "name": "Read probe identity",
      "job": "setup",
      "step": "Read probe identity",
      "budget_seconds": 30
    },
    {
      "name": "Verify the account",
      "job": "setup",
      "step": "Verify the account",
      "budget_seconds": 30
    },
    {
      "name": "Clear the session",
      "job": "setup",
      "step": "Clear the session",
      "budget_seconds": 60
    },
    {
      "name": "Log out",
      "job": "setup",
      "step": "Log out",
      "budget_seconds": 60
    },
    {
      "name": "Remove CLI session",
      "job": "setup",
      "step": "Remove CLI session",
      "budget_seconds": 60
    },
    {
      "name": "Confirm the setup",
      "job": "setup",
      "step": "Confirm the setup",
      "budget_seconds": 30
    }
  ],
  "parity": "swamp/proof/vault/parity.py",
  "clean": true
}
