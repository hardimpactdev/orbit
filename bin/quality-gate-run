#!/usr/bin/env bash

set -u

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
GATE=""
COMMAND=""
MODE="check"
ARTIFACT_DIR="${ORBIT_QUALITY_GATES_DIR:-${ROOT}/.orbit/quality-gates}"
TIMING_RAW_TMP=""
TIMING_STDOUT_TMP=""
TIMING_STDOUT_FIFO=""
TIMING_STDERR_TMP=""
TIMING_STDERR_FIFO=""
PLAN_METADATA_TMP=""

cleanup() {
    if [ -n "$TIMING_RAW_TMP" ]; then
        rm -f "$TIMING_RAW_TMP"
    fi

    if [ -n "$TIMING_STDOUT_TMP" ]; then
        rm -f "$TIMING_STDOUT_TMP"
    fi

    if [ -n "$TIMING_STDOUT_FIFO" ]; then
        rm -f "$TIMING_STDOUT_FIFO"
    fi

    if [ -n "$TIMING_STDERR_TMP" ]; then
        rm -f "$TIMING_STDERR_TMP"
    fi

    if [ -n "$TIMING_STDERR_FIFO" ]; then
        rm -f "$TIMING_STDERR_FIFO"
    fi

    if [ -n "$PLAN_METADATA_TMP" ]; then
        rm -f "$PLAN_METADATA_TMP"
    fi
}

trap cleanup EXIT

usage_error() {
    echo "$1" >&2
    exit 1
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --gate=*)
            GATE="${1#*=}"
            shift
            ;;
        --gate)
            [ "$#" -ge 2 ] || usage_error "Missing value for --gate."
            GATE="${2:-}"
            shift 2
            ;;
        --command=*)
            COMMAND="${1#*=}"
            shift
            ;;
        --command)
            [ "$#" -ge 2 ] || usage_error "Missing value for --command."
            COMMAND="${2:-}"
            shift 2
            ;;
        --mode=*)
            MODE="${1#*=}"
            shift
            ;;
        --mode)
            [ "$#" -ge 2 ] || usage_error "Missing value for --mode."
            MODE="${2:-}"
            shift 2
            ;;
        --artifact-dir=*)
            ARTIFACT_DIR="${1#*=}"
            shift
            ;;
        --artifact-dir)
            [ "$#" -ge 2 ] || usage_error "Missing value for --artifact-dir."
            ARTIFACT_DIR="${2:-}"
            shift 2
            ;;
        --)
            shift
            break
            ;;
        *)
            echo "Unknown option [$1]." >&2
            exit 1
            ;;
    esac
done

if [ -z "$GATE" ]; then
    usage_error "Missing required option --gate."
fi

if [ "$GATE" = "quality-check" ]; then
    usage_error "Gate [quality-check] is reserved for bin/quality-check.sh."
fi

if [ "$#" -eq 0 ]; then
    usage_error "Missing command after --."
fi

if [ -z "$COMMAND" ]; then
    COMMAND="$GATE"
fi

STARTED_AT="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
GIT_BRANCH="$(git -C "$ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || echo unknown)"
GIT_COMMIT="$(git -C "$ROOT" rev-parse HEAD 2>/dev/null || echo unknown)"
GIT_START_CLEAN=0
if GIT_START_STATUS="$(git -C "$ROOT" status --porcelain --untracked-files=all 2>/dev/null)" && [ -z "$GIT_START_STATUS" ]; then
    GIT_START_CLEAN=1
fi
CAPTURE_E2E_TIMINGS=0
TIMING_RAW_PATH=""
TIMING_SUMMARY_PATH=""
TEST_SUMMARY_LINE=""

case "$GATE" in
    e2e*)
        CAPTURE_E2E_TIMINGS=1
        TIMING_RAW_TMP="$(mktemp "${TMPDIR:-/tmp}/orbit-quality-gate-e2e-timings.XXXXXX")"
        TIMING_STDOUT_TMP="$(mktemp "${TMPDIR:-/tmp}/orbit-quality-gate-stdout.XXXXXX")"
        TIMING_STDOUT_FIFO="$(mktemp "${TMPDIR:-/tmp}/orbit-quality-gate-stdout-fifo.XXXXXX")"
        TIMING_STDERR_TMP="$(mktemp "${TMPDIR:-/tmp}/orbit-quality-gate-stderr.XXXXXX")"
        TIMING_STDERR_FIFO="$(mktemp "${TMPDIR:-/tmp}/orbit-quality-gate-stderr-fifo.XXXXXX")"
        PLAN_METADATA_TMP="$(mktemp "${TMPDIR:-/tmp}/orbit-quality-gate-e2e-plan.XXXXXX")"
        rm -f "$TIMING_STDOUT_FIFO"
        rm -f "$TIMING_STDERR_FIFO"
        mkfifo "$TIMING_STDOUT_FIFO" || CAPTURE_E2E_TIMINGS=0
        mkfifo "$TIMING_STDERR_FIFO" || CAPTURE_E2E_TIMINGS=0
        ;;
esac

set +e
if [ "$CAPTURE_E2E_TIMINGS" -eq 1 ]; then
    tee "$TIMING_STDOUT_TMP" < "$TIMING_STDOUT_FIFO" &
    TIMING_STDOUT_TEE_PID="$!"

    tee "$TIMING_STDERR_TMP" >&2 < "$TIMING_STDERR_FIFO" &
    TIMING_STDERR_TEE_PID="$!"

    ORBIT_E2E_PLAN_METADATA_FILE="$PLAN_METADATA_TMP" "$@" > "$TIMING_STDOUT_FIFO" 2> "$TIMING_STDERR_FIFO"
    EXIT_CODE="$?"

    wait "$TIMING_STDOUT_TEE_PID" || true
    wait "$TIMING_STDERR_TEE_PID" || true
    awk '$1 == "[orbit-e2e]" { print }' "$TIMING_STDERR_TMP" > "$TIMING_RAW_TMP" 2>/dev/null || true
else
    "$@"
    EXIT_CODE="$?"
fi
set -e

ENDED_AT="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
GIT_END_COMMIT="$(git -C "$ROOT" rev-parse HEAD 2>/dev/null || echo unknown)"
GIT_END_CLEAN=0
if GIT_END_STATUS="$(git -C "$ROOT" status --porcelain --untracked-files=all 2>/dev/null)" && [ -z "$GIT_END_STATUS" ]; then
    GIT_END_CLEAN=1
fi
GIT_DIRTY=true
if [ "$GIT_START_CLEAN" -eq 1 ] && [ "$GIT_END_CLEAN" -eq 1 ] && [ "$GIT_COMMIT" != unknown ] && [ "$GIT_END_COMMIT" = "$GIT_COMMIT" ]; then
    GIT_DIRTY=false
fi

if [ "$CAPTURE_E2E_TIMINGS" -eq 1 ] && [ -s "$TIMING_RAW_TMP" ]; then
    TIMING_DIR="${ARTIFACT_DIR}/e2e-timings"
    TIMING_STAMP="$(date -u +"%Y%m%dT%H%M%SZ")"
    TIMING_BASENAME="${GATE}-${TIMING_STAMP}-$$"

    mkdir -p "$TIMING_DIR" 2>/dev/null || true

    if [ -d "$TIMING_DIR" ]; then
        TIMING_RAW_PATH="${TIMING_DIR}/${TIMING_BASENAME}-raw.log"
        TIMING_SUMMARY_PATH="${TIMING_DIR}/${TIMING_BASENAME}-summary.txt"

        cp "$TIMING_RAW_TMP" "$TIMING_RAW_PATH" 2>/dev/null || TIMING_RAW_PATH=""

        if [ -n "$TIMING_RAW_PATH" ]; then
            awk -f "${ROOT}/bin/e2e-timings.awk" "$TIMING_RAW_PATH" > "$TIMING_SUMMARY_PATH" 2>/dev/null || TIMING_SUMMARY_PATH=""

            if [ ! -s "$TIMING_SUMMARY_PATH" ]; then
                rm -f "$TIMING_SUMMARY_PATH"
                TIMING_SUMMARY_PATH=""
            fi
        fi
    fi
fi

if [ "$CAPTURE_E2E_TIMINGS" -eq 1 ] && [ -s "$TIMING_STDOUT_TMP" ]; then
    TEST_SUMMARY_LINE="$(grep -E '(^|[[:space:]])Tests:[[:space:]]+.*\([[:space:]]*[0-9]+ assertions?\)' "$TIMING_STDOUT_TMP" | tail -n 1 || true)"
fi

ARTIFACT_ARGS=(
    "${ROOT}/bin/quality-gate-write-artifact"
    "--gate=$GATE"
    "--producer=quality-gate-run"
    "--command=$COMMAND"
    "--mode=$MODE"
    "--started-at=$STARTED_AT"
    "--ended-at=$ENDED_AT"
    "--exit-code=$EXIT_CODE"
    "--git-branch=$GIT_BRANCH"
    "--git-commit=$GIT_COMMIT"
    "--git-dirty=$GIT_DIRTY"
    "--artifact-dir=$ARTIFACT_DIR"
)

if [ -n "$TIMING_SUMMARY_PATH" ]; then
    ARTIFACT_ARGS+=("--timing-summary-path=$TIMING_SUMMARY_PATH")
fi

if [ -n "$TIMING_RAW_PATH" ]; then
    ARTIFACT_ARGS+=("--timing-raw-path=$TIMING_RAW_PATH")
fi

if [ -n "$TEST_SUMMARY_LINE" ]; then
    ARTIFACT_ARGS+=("--test-summary-line=$TEST_SUMMARY_LINE")
fi

if [ "$CAPTURE_E2E_TIMINGS" -eq 1 ]; then
    E2E_PLAN_LINES="$(grep -E '^\[orbit-e2e-plan\] ' "$PLAN_METADATA_TMP" 2>/dev/null || true)"

    if [ -z "$E2E_PLAN_LINES" ]; then
        E2E_PLAN_LINES="$(grep -E '^\[orbit-e2e-plan\] ' "$TIMING_STDOUT_TMP" 2>/dev/null || true)"
    fi

    if [ -z "$E2E_PLAN_LINES" ]; then
        E2E_PLAN_LINES="$(grep -E '^\[orbit-e2e-plan\] ' "$TIMING_STDERR_TMP" 2>/dev/null || true)"
    fi

    while IFS= read -r E2E_PLAN_LINE; do
        if [ -n "$E2E_PLAN_LINE" ]; then
            ARTIFACT_ARGS+=("--e2e-plan-line=$E2E_PLAN_LINE")
        fi
    done <<< "$E2E_PLAN_LINES"
fi

php "${ARTIFACT_ARGS[@]}" >/dev/null 2>&1 || true

exit "$EXIT_CODE"
