#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

if [[ $# -lt 1 ]]; then
    cat >&2 <<'USAGE'
usage: bin/e2e-topology <action> ISSUE [...]

  acquire ISSUE WORKTREE [--nodes=LIST] [--replace]
                                  compose a topology on the mounted worktree; LIST is a comma-separated list of the
                                  declarable Nodes in apps/e2e/resources/topology-nodes.json, each with optional
                                  +ROLE (default app-dev,app-prod); --replace releases a held topology first
  shell   ISSUE NODE              login shell as orbit on one Node
  exec    ISSUE NODE --argv=JSON [--timeout=SECONDS] [--record=LABEL]
                                  run on one Node; --record appends the command and output to <worktree>/.e2e/evidence.log
                                  and one JSON line to <worktree>/.e2e/evidence.jsonl
  spawn   ISSUE NODE NAME --argv=JSON
                                  start a long-lived process on a Node and return at once
  logs    ISSUE NODE NAME [--since=TIME] [--lines=N] [--record=LABEL]
                                  print the timestamped output of a spawned process
  kill    ISSUE NODE NAME         stop a spawned process; its logs stay readable
  sync    ISSUE [--quick]         migrate the Gateway and re-verify the mounted source identity;
                                  --quick skips readiness verification and keeps the recorded binding
  web     ISSUE                   foreground web dev session in the operator; publishes on host loopback
  firewall-fixture ISSUE OPERATION --record=LABEL
                                  fixed TASK-1791 Router LAN acceptance control; prepare, overlap, narrow,
                                  probe, rollback, restore or inspect (no arbitrary privileged command)
  verify  ISSUE                   verify the topology
  status  ISSUE                   report the topology from <worktree>/.e2e/
  release ISSUE                   release the topology

Every action except acquire finds the issue among registered Git worktrees
or takes --worktree=PATH. State lives in <worktree>/.e2e/.
USAGE
    exit 64
fi

action=$1
shift

case "$action" in
    acquire|shell|exec|spawn|logs|kill|sync|web|firewall-fixture|verify|status|release)
        # exec keeps the public PID for the foreground PHP owner, including TERM/HUP ownership.
        exec php "$root/apps/e2e/artisan" "topology:$action" "$@"
        ;;
    *)
        echo "unknown topology action: $action" >&2
        exit 64
        ;;
esac
