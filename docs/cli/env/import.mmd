sequenceDiagram
  %% status: migrated
  %% command: env:import
  %% kind: instance.env_import
  autonumber
  %% lane CLI icon=terminal pill=caller tone=gray
  %% lane GW icon=gateway pill=intent tone=blue
  %% lane SW icon=workflow pill=executes tone=green
  %% lane N icon=server pill=target tone=amber
  participant CLI as CLI / MCP
  participant GW as Gateway
  participant SW as Swamp
  participant N as Instance Node
  CLI->>GW: env:import --instance=42
  Note over GW: Validate, lock Instance
  GW->>SW: Start run, full intent
  GW-->>CLI: 202 Task accepted
  SW->>N: Stage .env for the copy
  %%> Refuse a missing, linked, foreign-owned or oversized file.
  SW->>N: Copy .env to 209
  SW->>N: Remove the staged copy
  Note over SW: Read .env into the vault
  Note over SW: Remove the local copy
  %%> Also after a failed copy or vault write.
  alt read and stored
    SW-->>GW: Run succeeded<br/>size · sha256
    GW->>SW: Read the vault key once
    Note over GW: Parse, check, store
    GW->>SW: Delete the vault key
    GW-->>CLI: Operation succeeded
  else read or import fails
    SW--xGW: Run failed
    Note over GW: Store nothing<br/>delete the vault key
    GW--xCLI: Operation failed
  end
