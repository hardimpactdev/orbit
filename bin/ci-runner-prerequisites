#!/usr/bin/env bash
# Bounded Ubuntu 26.04 prerequisites for hosted Gateway checks.
set -euo pipefail

case "${1:-}" in
    nftables) tools=(nft); primary_budget=10 ;;
    valkey-server) tools=(valkey-server valkey-cli); primary_budget=25 ;;
    *) echo 'Usage: ci-runner-prerequisites {nftables|valkey-server}' >&2; exit 2 ;;
esac
package=$1

have_tools() {
    local tool
    for tool in "${tools[@]}"; do
        "$tool" --version >/dev/null 2>&1 || return 1
    done
}

if have_tools; then
    echo "Using installed $package prerequisites: ${tools[*]}"
    exit 0
fi

# ORBIT_CI_APT_ARCHIVES names a folder of packages that an earlier install on this runner image downloaded. With them
# the install needs no mirror. A package set that no longer installs falls through to the mirrors.
archives=${ORBIT_CI_APT_ARCHIVES:-}
if [[ -n "$archives" ]] && compgen -G "$archives/*.deb" >/dev/null; then
    echo "Installing $package from the cached packages in $archives"
    if sudo -n dpkg --install "$archives"/*.deb && have_tools; then
        echo "Verified $package prerequisites: ${tools[*]}"
        exit 0
    fi
    echo "Could not supply $package from the cached packages" >&2
fi

scratch=$(mktemp -d -t orbit-ci-apt.XXXXXXXX)
trap 'sudo -n rm -rf -- "$scratch"' EXIT
chmod 755 "$scratch"

for mirror in azure.archive.ubuntu.com mirrors.edge.kernel.org; do
    budget=$primary_budget
    if [[ "$mirror" == mirrors.edge.kernel.org ]]; then budget=20; fi
    attempt="$scratch/$mirror"
    mkdir -m 755 "$attempt" "$attempt/lists" "$attempt/archives"
    # The caller uses ubuntu-26.04. Only the base main index is needed for these packages.
    echo "deb [signed-by=/usr/share/keyrings/ubuntu-archive-keyring.gpg] https://$mirror/ubuntu resolute main" > "$attempt/ubuntu.list"
    options=(
        -o "Dir::Etc::sourcelist=$attempt/ubuntu.list"
        -o 'Dir::Etc::sourceparts=-'
        -o "Dir::State::lists=$attempt/lists"
        -o "Dir::Cache::archives=$attempt/archives"
        -o 'APT::Keep-Downloaded-Packages=true'
        -o 'Acquire::Languages=none'
        -o 'Acquire::Retries=0'
        -o 'Acquire::http::Timeout=3'
        -o 'Acquire::https::Timeout=3'
        -o 'APT::Update::Error-Mode=any'
        -o 'DPkg::Lock::Timeout=0'
    )
    echo "Installing $package from $mirror (update and install budget: ${budget}s)"
    # Root owns each apt process group so it can kill all children at the shared deadline.
    if sudo -n python3 - "$budget" "$package" "${options[@]}" <<'PYTHON'
import os
import signal
import subprocess
import sys
import time

# These runners are disposable; unrelated service scans and restarts are not prerequisites.
os.environ['NEEDRESTART_SUSPEND'] = '1'
budget = int(sys.argv[1])
package = sys.argv[2]
deadline = time.monotonic() + budget
for operation in (['update'], ['install', '--no-install-recommends', '--yes', package]):
    remaining = deadline - time.monotonic()
    timeout_message = f'apt-get {operation[0]} exceeded the shared {budget}s deadline for {package}'
    if remaining <= 0:
        print(timeout_message, file=sys.stderr)
        sys.exit(124)
    child = subprocess.Popen(['apt-get', *sys.argv[3:], *operation], start_new_session=True)
    try:
        result = child.wait(timeout=remaining)
    except subprocess.TimeoutExpired:
        os.killpg(child.pid, signal.SIGKILL)
        child.wait()
        print(timeout_message, file=sys.stderr)
        sys.exit(124)
    if result != 0:
        sys.exit(1)
PYTHON
    then
        if ! have_tools; then
            echo "Installed $package did not supply working prerequisites" >&2
            continue
        fi
        echo "Verified $package prerequisites: ${tools[*]}"
        if [[ -n "$archives" ]] && compgen -G "$attempt/archives/*.deb" >/dev/null; then
            # The packages this install downloaded are the whole set a later run on this image needs.
            mkdir -p "$archives"
            rm -f -- "$archives"/*.deb
            cp -- "$attempt"/archives/*.deb "$archives"/
        fi
        exit 0
    fi
    echo "Could not supply $package from $mirror" >&2
done

echo "Missing $package prerequisites after both Ubuntu mirrors" >&2
exit 1
