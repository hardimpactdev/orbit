{
    "compilerOptions": {
        "allowSyntheticDefaultImports": true,
        "declaration": true,
        "declarationMap": true,
        "exactOptionalPropertyTypes": true,
        "lib": [
            "ES2024",
            "DOM",
            "DOM.Iterable"
        ],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "noEmit": true,
        "noUncheckedIndexedAccess": true,
        "outDir": "dist",
        "rootDir": ".",
        "skipLibCheck": true,
        "strict": true,
        "target": "ES2024",
        "verbatimModuleSyntax": true
    },
    "include": [
        "src/**/*.ts",
        "tests/typecheck.ts"
    ],
    "exclude": [
        "tests/process-stream.test.ts",
        "tests/client.test.ts"
    ]
}
