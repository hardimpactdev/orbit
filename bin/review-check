#!/usr/bin/env python3
"""Run the quality checks and affected tests on one candidate: a commit, or a working tree with uncommitted changes."""
import json
import os
import re
import shutil
import stat
from pathlib import Path
import subprocess
import sys
import tempfile
import threading
import time
from concurrent.futures import ThreadPoolExecutor

PHP_PROJECTS = ('apps/cli', 'apps/docs', 'apps/gateway', 'apps/e2e', 'packages/php-sdk')
PHP_COMMANDS = (('composer', 'validate', '--strict'), ('composer', 'check'), ('composer', 'test:affected'))
WEB_INSTALL = ('bun', 'install', '--frozen-lockfile')
WEB_BUILD_OUTPUTS = ('bash', '-c', 'test -s dist/index.html && test -s dist/version.json')
WEB_TYPES = ('bash', '-c', 'generated=$(mktemp) && trap \'rm -f "$generated"\' EXIT && ./node_modules/.bin/openapi-typescript ../../docs/openapi.json -o "$generated" && { diff -u --label src/api/schema.d.ts --label generated/schema.d.ts src/api/schema.d.ts "$generated" || { echo "src/api/schema.d.ts is stale. Run: cd apps/web && bun run types" >&2; exit 1; }; }')
WEB_CHECK_COMMANDS = (('bun', 'run', 'check'), ('bun', 'run', 'build'), WEB_BUILD_OUTPUTS, WEB_TYPES)
PI_SERVER_COMMANDS = (('bun', 'install', '--frozen-lockfile'), ('bun', 'run', 'check'),
                      ('bun', 'run', 'test'), ('bun', 'run', 'build'))
AFFECTED = ('composer', 'test:affected')
ARCHITECTURE_TESTS = {
    'apps/cli': ('tests/Feature/CommandSurfaceTest.php', 'tests/Feature/CliBinaryBuildContractTest.php'),
    'apps/gateway': (
        'tests/Unit/Architecture',
        'tests/Feature/Infrastructure/Instances/ConfiguredOriginReadTest.php',
        'tests/Feature/Infrastructure/Caddy/CaddyPublicationLockTest.php',
    ),
    'apps/e2e': (
        'tests/Unit/E2E/Value/TopologyNodeCatalogTest.php',
        'tests/Feature/Configuration/ComposerConfigurationTest.php',
        'tests/Feature/Configuration/SubprocessTestGroupTest.php',
        'tests/Feature/Configuration/DocsMergeRefWorkflowTest.php',
    ),
    'packages/php-sdk': (
        'tests/Unit/SuccessRequestIdBoundaryTest.php',
        'tests/Unit/RepositoryGuidanceTest.php',
        'tests/Unit/Requests/Workspaces/WorkspaceRequestsTest.php',
        'tests/Unit/Requests/Deployments/DeploymentRequestsTest.php',
    ),
}
# Paths outside a project that its architecture tests read, so a change there runs them too.
ARCHITECTURE_TRIGGERS = {
    'apps/cli': ('docs/cli/', 'bin/orbit-build-cli-binary', 'bin/orbit-version', '.github/workflows/', 'bin/review-check'),
    # Configuration and test-group contracts scan all five projects and repository tooling.
    'apps/e2e': ('',),
}
# Include generated outputs as well as source inputs, so hand edits cannot bypass freshness checks.
API_ARTIFACT_TRIGGERS = (
    'apps/gateway/', 'apps/cli/', 'packages/php-sdk/', 'bin/docs-openapi', 'bin/mcp-tools',
    'docs/openapi.json', 'docs/docs.json', 'bin/review-check',
)
API_ARTIFACT_COMMANDS = (('bin/docs-openapi', '--check'), ('bin/mcp-tools', '--check'))
API_FIXTURE_TRIGGERS = ('docs/openapi.json', 'packages/php-sdk/fixtures/', 'apps/web/fixtures/',
                        'bin/api-fixtures', 'bin/review-check')
RUST_FORMAT = ('cargo', 'fmt', '--all', '--', '--check')
# The lint and direct tests of the programs that the Gateway runs on Nodes (docs/reference/remote-programs.md).
# A change to the gate alone does not run it: copies of the gate in test fixtures have no programs to check.
REMOTE_PROGRAM_TRIGGERS = ('apps/gateway/resources/', 'apps/gateway/tests/Programs/', 'apps/gateway/ruff.toml',
                           'bin/remote-programs-check')
BASES = ('origin/main', 'main')
# Reports older than this are removed by the next run of the user that wrote them.
REPORT_RETENTION_SECONDS = 24 * 60 * 60
NO_SELECTION = 'No affected tests found'
FULL_SUITE = ('../../bin/pest-plain', 'vendor/bin/pest', '--no-tia',
              '--fail-on-empty-test-suite', '--compact', '--colors=never')
# Checks of these projects share files, so they run in one lane, in order. The Gateway's annotator check reads
# apps/web/node_modules, which the web checks install. The repository's bin/docs-openapi --check boots Laravel in
# apps/gateway.
SHARED_LANES = {'apps/web': 'apps/gateway', 'repository': 'apps/gateway'}


# The whole-suite fallback runs in parallel: in one process the Gateway suite takes about 30 minutes. The lane fills in
# its process count when the command starts.
LANE_PROCESSES = '--processes=LANE'
PARALLEL_FULL_SUITE = ('../../bin/pest-plain', 'vendor/bin/pest', '--parallel', LANE_PROCESSES, '--no-tia',
                       '--fail-on-empty-test-suite', '--compact', '--colors=never')


def check_processes(root):
    """The process budget of the whole gate: ORBIT_CHECK_PROCESSES, or the default of bin/check-processes."""
    result = subprocess.run([str(root / 'bin/check-processes')], capture_output=True, text=True)
    if result.returncode or not re.fullmatch(r'[1-9][0-9]*', result.stdout.strip()):
        raise RuntimeError(result.stderr.strip() or 'bin/check-processes printed no process count.')
    return int(result.stdout.strip())


def lanes(selected):
    """Group the selected checks by project, keeping their order. Different lanes run at the same time."""
    groups = {}
    for order, (project, commands) in enumerate(selected):
        groups.setdefault(SHARED_LANES.get(project, project), []).append((order, project, commands))
    return list(groups.values())


def lane_key(entries):
    return SHARED_LANES.get(entries[0][1], entries[0][1])


def lane_weight(root, entries):
    """A lane's share of the budget follows the size of its test suites; other checks count as one."""
    weight = 0
    for _order, project, _commands in entries:
        tests = root / project / 'tests'
        weight += max(1, sum(1 for _path in tests.rglob('*Test.php'))) if project in PHP_PROJECTS and tests.is_dir() else 1
    return weight


def lane_count(groups, processes):
    """How many lanes run at once. The heaviest lane keeps at least half the budget, so with the default of 4 the
    Gateway runs two processes while two other lanes run one each."""
    return max(1, min(len(groups), 1 + processes // 2))


class ProcessBudget:
    """Hands out processes to the commands of the running lanes, so the tools of all lanes together stay within the
    budget. A command gets its lane's weighted share of the lanes that are still running, so a lane gets the
    processes that finished lanes freed. A command waits when every process is in use."""

    def __init__(self, processes, weights):
        self.processes, self.weights = processes, weights
        self.held, self.running = {}, set()
        self.condition = threading.Condition()

    def start(self, lane):
        with self.condition:
            self.running.add(lane)

    def finish(self, lane):
        with self.condition:
            self.running.discard(lane)
            self.held.pop(lane, None)
            self.condition.notify_all()

    def acquire(self, lane):
        with self.condition:
            while True:
                others = [other for other in self.running if other != lane]
                free = self.processes - sum(self.held.get(other, 0) for other in others)
                # Keep one process for each running lane between commands, so it can continue.
                waiting = sum(1 for other in others if not self.held.get(other))
                total = sum(self.weights[other] for other in self.running | {lane})
                share = max(1, self.processes * self.weights[lane] // total)
                granted = min(share, free - waiting) if free - waiting >= 1 else min(1, free)
                if granted >= 1:
                    self.held[lane] = granted
                    return granted
                self.condition.wait()

    def release(self, lane):
        with self.condition:
            self.held[lane] = 0
            self.condition.notify_all()


def git(root, *args):
    return subprocess.check_output(['git', '-C', str(root), *args], text=True).strip()


def working_tree(root):
    """Return the tree hash of the whole working tree, uncommitted and untracked files included, without touching the index."""
    index = Path(git(root, 'rev-parse', '--path-format=absolute', '--git-path', 'index'))
    with tempfile.TemporaryDirectory(prefix='review-tree-') as scratch:
        candidate_index = Path(scratch) / 'index'
        if index.exists():
            shutil.copyfile(index, candidate_index)
        environment = {**os.environ, 'GIT_INDEX_FILE': str(candidate_index)}
        subprocess.run(['git', '-C', str(root), 'add', '--all'], env=environment, check=True, capture_output=True)
        return subprocess.check_output(['git', '-C', str(root), 'write-tree'], env=environment, text=True).strip()


def candidate_paths(root, head, committed):
    """Return the main merge base and the paths the candidate changes since it; none without a main branch."""
    for base in BASES:
        merge_base = subprocess.run(['git', '-C', str(root), 'merge-base', base, head], capture_output=True, text=True)
        if merge_base.returncode == 0:
            base_sha = merge_base.stdout.strip()
            if committed:
                return base_sha, git(root, 'diff', '--name-only', base_sha, head).splitlines()
            changed = git(root, 'diff', '--name-only', base_sha).splitlines()
            untracked = git(root, 'ls-files', '--others', '--exclude-standard').splitlines()
            return base_sha, sorted(set(changed) | set(untracked))
    return None, []


def task_test_base(root, head):
    """Every Orbit handoff, including the last, may narrow tests; CI checks the full branch."""
    value = os.environ.get('ORBIT_TASK_CHECK_BASE')
    if not value or os.environ.get('CI') or os.environ.get('GITHUB_ACTIONS'):
        return None
    if not re.fullmatch(r'[0-9a-f]{40}(?:[0-9a-f]{24})?', value):
        raise RuntimeError('The task test base must be a full commit or tree SHA.')
    try:
        kind = git(root, 'cat-file', '-t', value)
    except subprocess.CalledProcessError as error:
        raise RuntimeError('The task test base does not exist.') from error
    if kind == 'tree':
        return value
    if kind != 'commit' or subprocess.run(['git', '-C', str(root), 'merge-base', '--is-ancestor', value, head],
                      stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode:
        raise RuntimeError('The task test base is not an ancestor of the candidate.')
    return value


def paths_since(root, base, head, committed):
    if committed:
        return git(root, 'diff', '--name-only', base, head).splitlines()
    return git(root, 'diff', '--name-only', base, working_tree(root)).splitlines()


def scope_tia_graph(destination, base):
    """Reuse real dependency edges without claiming cached test verdicts at a new base."""
    path = destination / 'graph.json'
    if not path.is_file():
        return
    graph = json.loads(path.read_text())
    graph['baselines'] = {'main': {'sha': base, 'tree': {}, 'results': {}, 'complete': False}}
    path.write_text(json.dumps(graph, separators=(',', ':')))


def handoff_cache(root):
    return Path(git(root, 'rev-parse', '--absolute-git-dir')) / 'orbit-handoff-tia'


def selected_projects(paths, root):
    """Return project profiles selected by changed paths and the OpenAPI schema dependency."""
    selected = [(project, PHP_COMMANDS) for project in PHP_PROJECTS]
    if any(path.startswith(API_ARTIFACT_TRIGGERS) for path in paths):
        selected.append(('repository', API_ARTIFACT_COMMANDS))
    if any(path.startswith(API_FIXTURE_TRIGGERS) for path in paths):
        selected.append(('repository', (('bin/api-fixtures', '--check'),)))
    for project in ('apps/agent', 'apps/desktop/src-tauri'):
        prefix = 'apps/desktop/' if 'desktop' in project else project + '/'
        if any(path.startswith(prefix) or path == '.github/workflows/ci.yml' for path in paths):
            selected.append((project, (RUST_FORMAT,)))
    if any(path.startswith('apps/web/') for path in paths):
        selected.extend((('apps/web', (WEB_INSTALL,)), ('apps/web', WEB_CHECK_COMMANDS)))
    elif 'docs/openapi.json' in paths:
        selected.append(('apps/web', (WEB_INSTALL, WEB_TYPES)))
    if any(path.startswith('apps/pi-server/') for path in paths):
        selected.append(('apps/pi-server', PI_SERVER_COMMANDS))
    if any(path.startswith(REMOTE_PROGRAM_TRIGGERS) for path in paths):
        selected.append(('repository', (('bin/remote-programs-check',),)))
    for project, _commands in list(selected):
        if project not in PHP_PROJECTS:
            continue
        if 'bin/check-classification-fakes' in paths:
            selected.append((project, (('php', '../../bin/check-classification-fakes', 'tests'),)))
            continue
        test_sources = [path[len(project) + 1:] for path in changed_php_test_sources(paths)
                        if path.startswith(project + '/') and (root / path).is_file()]
        if test_sources:
            selected.append((project, (('php', '../../bin/check-classification-fakes', *test_sources),)))
    return selected


def command_log_name(command):
    """Return a concise, unique log label for a gate command."""
    if len(command) > 1 and command[1] == '../../bin/check-classification-fakes':
        return 'classification-fakes'
    if command == WEB_TYPES:
        return 'generated-types'
    if command == WEB_BUILD_OUTPUTS:
        return 'build-outputs'
    return '-'.join(command).replace('/', '-').replace(':', '-')


def changed_php_tests(paths):
    """Return changed Pest test files among the selected PHP projects."""
    return [path for path in paths if path.endswith('Test.php') and '/tests/' in path]


def changed_php_test_sources(paths):
    """Return every changed PHP source under a selected project's tests directory."""
    return [path for path in paths if path.endswith('.php') and '/tests/' in path]


def project_tia_directory(root, project):
    """Resolve the directory used by the project's Pest bootstrap."""
    configured = os.environ.get('ORBIT_TIA_DIRECTORY')
    if configured:
        directory = Path(configured)
        return directory if directory.is_absolute() else (root / project / directory).resolve()
    return root / project / '.orbit-tia'


def keep_main_baseline(destination):
    """Drop branch baselines so the run selects every change since main."""
    graph_path = destination / 'graph.json'
    if not graph_path.is_file():
        return
    try:
        graph = json.loads(graph_path.read_text())
    except (OSError, json.JSONDecodeError):
        return
    if not isinstance(graph, dict):
        return
    baselines = graph.get('baselines')
    if not isinstance(baselines, dict) or set(baselines) <= {'main'}:
        return
    graph['baselines'] = {'main': baselines['main']} if 'main' in baselines else {}
    graph_path.write_text(json.dumps(graph, separators=(',', ':'), ensure_ascii=True))


def prepare_tia_directory(root, project, destination, test_base=None):
    """Copy the project TIA cache into a run directory that keeps only the main baseline."""
    source = project_tia_directory(root, project)
    if test_base is not None:
        cached = handoff_cache(root)
        try:
            metadata = json.loads((cached / 'receipt.json').read_text())
            if metadata.get('tree') == git(root, 'rev-parse', test_base + '^{tree}'):
                candidate = cached / project.replace('/', '-')
                if candidate.is_dir():
                    source = candidate
        except (OSError, json.JSONDecodeError):
            pass
    destination.mkdir(parents=True, exist_ok=True)
    if source.is_dir() and source.resolve() != destination.resolve() and destination.resolve() not in source.resolve().parents:
        shutil.copytree(source, destination, dirs_exist_ok=True)
        keep_main_baseline(destination)
    if test_base is not None:
        scope_tia_graph(destination, test_base)
    (destination / 'affected.json').unlink(missing_ok=True)


def prune_reports(checks):
    """Remove this user's report directories older than a day, then HEAD directories that stayed empty for a day.

    Reports live in the Git common directory that every worktree shares, and more than one account may
    write them. Only an owner can reliably remove its own report, so each run removes what its user left."""
    cutoff = time.time() - REPORT_RETENTION_SECONDS
    try:
        heads = [entry for entry in checks.iterdir() if entry.is_dir() and not entry.is_symlink()]
    except OSError:
        return
    for head in heads:
        try:
            reports = list(head.iterdir())
        except OSError:
            continue
        for report in reports:
            try:
                info = report.lstat()
            except OSError:
                continue
            if (not report.name.startswith('review-') or not stat.S_ISDIR(info.st_mode)
                    or info.st_uid != os.geteuid() or info.st_mtime >= cutoff):
                continue
            try:
                shutil.rmtree(report)
            except OSError as error:
                print(f'Could not remove the old check report {report}: {error}', file=sys.stderr, flush=True)
        try:
            if head.stat().st_mtime < cutoff:
                head.rmdir()
        except OSError:
            pass


def report_directory(reports):
    """Create this run's report directory. Another run may remove an old, empty HEAD directory at the same time."""
    for attempt in range(3):
        reports.mkdir(parents=True, exist_ok=True)
        try:
            return Path(tempfile.mkdtemp(prefix='review-', dir=reports))
        except FileNotFoundError:
            if attempt == 2:
                raise


def selected_test_files(tia_directory):
    """Return current-run selected tests only when TIA wrote valid evidence."""
    artifact = tia_directory / 'affected.json'
    if not artifact.is_file():
        return set(), False
    try:
        selected = json.loads(artifact.read_text())
    except (OSError, json.JSONDecodeError):
        return set(), False
    if not isinstance(selected, list) or not all(isinstance(item, str) for item in selected):
        return set(), False
    return {item.removeprefix('./') for item in selected}, True


def selection_warning(project, command, exit_code, log, paths):
    """Describe an affected-test step that selected nothing for a project the candidate changes."""
    touched = [path for path in paths if path.startswith(project + '/')]
    if command != AFFECTED or exit_code != 0 or not touched or NO_SELECTION not in log.read_text(errors='replace'):
        return None
    return {'project': project, 'command': list(command), 'log': str(log), 'paths': touched,
            'message': f'composer test:affected selected no tests although the candidate changes '
                       f'{len(touched)} path(s) under {project}/'}


def main():
    root = Path(__file__).resolve().parent.parent
    processes = check_processes(root)
    head = git(root, 'rev-parse', 'HEAD')
    committed = not git(root, 'status', '--porcelain')
    tree = working_tree(root)
    common = Path(git(root, 'rev-parse', '--path-format=absolute', '--git-common-dir'))
    prune_reports(common / 'orbit-checks')
    directory = report_directory(common / 'orbit-checks' / head)
    # mkdtemp uses mode 0700. Under an inherited default ACL, the group bits become the ACL mask, so 0700 leaves
    # mask::--- and disables the named entries of that ACL. 0750 keeps them readable; other stays closed.
    directory.chmod(0o750)
    base, paths = candidate_paths(root, head, committed)
    test_base = task_test_base(root, head)
    test_paths = paths_since(root, test_base, head, committed) if test_base else paths
    report = {'schema': 1, 'role': 'builder', 'candidate': head, 'committed': committed, 'tree': tree,
              'worktree': str(root), 'base': base, 'test_base': test_base or base, 'changed_paths': paths, 'started_at': time.time(),
              'checks': [], 'warnings': [], 'passed': False}
    if base is not None:
        log = directory / 'docs-impact-gate.log'
        started = time.monotonic()
        with log.open('w') as output:
            result = subprocess.run([str(root / 'bin/docs-impact'), '--gate', '--base', base], cwd=root,
                                    stdout=output, stderr=subprocess.STDOUT)
        check = {'project': 'repository', 'command': ['bin/docs-impact', '--gate', '--base', base],
                 'exit_code': result.returncode, 'seconds': round(time.monotonic() - started, 3), 'log': str(log)}
        report['checks'].append(check)
        print(f'[repository] bin/docs-impact --gate --base {base}: '
              f'{"passed" if result.returncode == 0 else "FAILED"} ({report["checks"][-1]["seconds"]:.3f}s; {log})', flush=True)
        if result.returncode:
            print(log.read_text(), flush=True)
    else:
        log = directory / 'docs-impact-gate.log'
        log.write_text('Unable to determine the group start commit: no main branch merge base is available.\n')
        report['checks'].append({'project': 'repository', 'command': ['bin/docs-impact', '--gate'],
                                 'exit_code': 1, 'seconds': 0, 'log': str(log)})
        print(f'[repository] bin/docs-impact --gate: FAILED (0.000s; {log})', flush=True)
        print(log.read_text(), flush=True)
    for check_name in ('project-vocabulary', 'env-docs', 'tooling-baseline', 'docs-nav'):
        log = directory / f'{check_name}.log'
        started = time.monotonic()
        with log.open('w') as output:
            result = subprocess.run([str(root / 'bin' / check_name)], cwd=root,
                                    stdout=output, stderr=subprocess.STDOUT)
        report['checks'].append({'project': 'repository', 'command': [f'bin/{check_name}'],
                                 'exit_code': result.returncode,
                                 'seconds': round(time.monotonic() - started, 3), 'log': str(log)})
        print(f'[repository] bin/{check_name}: '
              f'{"passed" if result.returncode == 0 else "FAILED"} ({report["checks"][-1]["seconds"]:.3f}s; {log})', flush=True)
        if result.returncode:
            print(log.read_text(), flush=True)
    # Seed absent quality and test caches first, so a fresh clone does not run every check cold.
    # A cache miss or a missing seeding script only makes the checks slower.
    for seed in (['bin/worktree-cache', '--worktree', str(root)], ['bin/tia-cache', 'seed', '--repository', str(root)]):
        if (root / seed[0]).is_file():
            started = time.monotonic()
            seeded = subprocess.run([str(root / seed[0]), *seed[1:]], check=False)
            print(f'[cache] {" ".join(seed)}: {"passed" if seeded.returncode == 0 else "cache miss"} '
                  f'({time.monotonic() - started:.3f}s)', flush=True)
    # Pint and Rector check only the files the candidate changes; CI and plain runs check every file.
    # ORBIT_CHECK_SCOPE=full in the environment makes the gate check every file too.
    quality_scope = {} if 'ORBIT_CHECK_SCOPE' in os.environ else {
        'ORBIT_CHECK_SCOPE': 'changed', 'ORBIT_CHECK_BASE': base or ''}
    lane_checks = []
    groups = lanes(selected_projects(paths, root))
    weights = {lane_key(entries): lane_weight(root, entries) for entries in groups}
    # The heaviest lane starts first, so it never waits for a free lane.
    groups.sort(key=lambda entries: -weights[lane_key(entries)])
    budget = ProcessBudget(processes, weights)
    lane_warnings = []
    lock = threading.Lock()

    def say(message):
        with lock:
            print(message, flush=True)

    def run_entry(lane, order, project, project_commands):
        commands_run = []
        commands = list(project_commands)
        triggers = (project + '/', *ARCHITECTURE_TRIGGERS.get(project, ()))
        if project_commands == PHP_COMMANDS and any(path.startswith(triggers) for path in paths):
            commands.extend(('vendor/bin/pest', architecture_path)
                            for architecture_path in ARCHITECTURE_TESTS.get(project, ()))
        index = 0
        while index < len(commands):
            command = commands[index]
            index += 1
            lane_processes = budget.acquire(lane)
            command = tuple(f'--processes={lane_processes}' if part == LANE_PROCESSES else part for part in command)
            log = directory / (project.replace('/', '-') + '-' + command_log_name(command) + '.log')
            started = time.monotonic()
            command_environment = {**os.environ, 'COMPOSER_PROCESS_TIMEOUT': '0',
                                   'ORBIT_CHECK_PROCESSES': str(lane_processes)}
            if project in PHP_PROJECTS and command == ('composer', 'check'):
                command_environment.update(quality_scope)
            run_tia_directory = None
            if command == AFFECTED:
                run_tia_directory = directory / 'tia' / project.replace('/', '-')
                prepare_tia_directory(root, project, run_tia_directory, test_base)
                command_environment['ORBIT_TIA_DIRECTORY'] = str(run_tia_directory)
            with log.open('w') as output:
                try:
                    result = subprocess.run(command, cwd=root if project == 'repository' else root / project, stdout=output, stderr=subprocess.STDOUT,
                                            env=command_environment)
                except FileNotFoundError as error:
                    missing = error.filename or command[0]
                    output.write(f'{missing}: required tool not found\n')
                    result = subprocess.CompletedProcess(command, 127)
            budget.release(lane)
            if len(command) > 1 and command[1] == '--list-tests' and result.returncode == 0:
                if not re.search(r'^\s*-\s+\S+', log.read_text(errors='replace'), re.MULTILINE):
                    result = subprocess.CompletedProcess(command, 1)
                    with log.open('a') as output:
                        output.write('Pest did not discover any tests in the changed file.\n')
            check = {'project': project, 'command': list(command), 'exit_code': result.returncode,
                     'seconds': round(time.monotonic() - started, 3), 'log': str(log)}
            warning = selection_warning(project, command, result.returncode, log, test_paths)
            if warning is not None:
                check['warning'] = warning['message']
                with lock:
                    lane_warnings.append((order, len(commands_run), warning))
            with lock:
                lane_checks.append((order, len(commands_run), check))
                commands_run.append(command)
            say(f'[{project}] {" ".join(command)}: {"passed" if result.returncode == 0 else "FAILED"} ({check["seconds"]:.3f}s; {log})')
            if warning is not None:
                say(f'[{project}] WARNING: {warning["message"]} ({log})')
            if result.returncode:
                say(log.read_text())
            if command == AFFECTED and result.returncode == 0:
                selected_tests, has_current_evidence = selected_test_files(run_tia_directory)
                check['selected_test_files'] = sorted(selected_tests)
                check['selection_evidence_current'] = has_current_evidence
                check['selection_artifact'] = str(run_tia_directory / 'affected.json')
                if warning is not None:
                    commands.append(PARALLEL_FULL_SUITE)
                for test in changed_php_tests(test_paths):
                    if not test.startswith(project + '/'):
                        continue
                    relative = test[len(project) + 1:]
                    if (root / test).is_file() and relative not in selected_tests:
                        commands.extend((('vendor/bin/pest', '--list-tests', relative),
                                         (*FULL_SUITE, relative)))

    def run_lane(entries):
        lane = lane_key(entries)
        budget.start(lane)
        try:
            for order, project, project_commands in entries:
                run_entry(lane, order, project, project_commands)
        finally:
            budget.finish(lane)

    with ThreadPoolExecutor(max_workers=lane_count(groups, processes)) as pool:
        for future in [pool.submit(run_lane, entries) for entries in groups]:
            future.result()
    # Lanes finish in any order; the receipt lists the checks in the order the gate selected them.
    report['checks'].extend(check for *_order, check in sorted(lane_checks, key=lambda item: item[:2]))
    report['warnings'].extend(warning for *_order, warning in sorted(lane_warnings, key=lambda item: item[:2]))
    report['unchanged'] = head == git(root, 'rev-parse', 'HEAD') and tree == working_tree(root)
    report['passed'] = report['unchanged'] and bool(report['checks']) and all(
        check['exit_code'] == 0 for check in report['checks'])
    if report['passed']:
        cached = handoff_cache(root)
        cached.mkdir(parents=True, exist_ok=True)
        for project in PHP_PROJECTS:
            source = directory / 'tia' / project.replace('/', '-')
            if source.is_dir():
                shutil.copytree(source, cached / project.replace('/', '-'), dirs_exist_ok=True)
        (cached / 'receipt.json').write_text(json.dumps({'tree': tree, 'candidate': head}))
    report['finished_at'] = time.time()
    path = directory / 'result.json'
    path.write_text(json.dumps(report, indent=2) + '\n')
    if report['warnings']:
        print(f'Selection warnings: {len(report["warnings"])}; the receipt records the full suite with --no-tia for those projects.',
              flush=True)
    candidate = head if committed else f'{head} with uncommitted changes (tree {tree})'
    print(f'Candidate gate {"PASSED" if report["passed"] else "FAILED"} at {candidate}; receipt: {path}', flush=True)
    if not report['unchanged']:
        print('Candidate changed during checks; approval is not valid.', file=sys.stderr)
    return 0 if report['passed'] else 1


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, RuntimeError, subprocess.CalledProcessError) as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
