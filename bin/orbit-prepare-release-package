#!/usr/bin/env php
<?php

declare(strict_types=1);

$options = getopt('', [
    'package:',
    'version:',
    'output:',
]);

try {
    $package = required_string($options, 'package');
    $output = required_string($options, 'output');
    $repoRoot = dirname(__DIR__);

    $sources = [
        'core' => 'packages/core',
        'sdk' => 'packages/sdk',
        'sdk-typescript' => 'packages/sdk-typescript',
        'cli' => 'apps/cli',
        'gateway' => 'apps/gateway',
    ];

    if (! array_key_exists($package, $sources)) {
        fail('Unsupported package ['.$package.']. Expected one of: core, sdk, sdk-typescript, cli, gateway.');
    }

    $source = $repoRoot.'/'.$sources[$package];

    if (! is_dir($source)) {
        fail('Package source directory not found: '.$source);
    }

    // TypeScript SDK is independently versioned from monorepo root VERSION.
    // Prefer the source package.json version; --version must match when supplied.
    if ($package === 'sdk-typescript') {
        $packageVersion = read_npm_package_version($source.'/package.json');
        $requested = $options['version'] ?? null;

        if (is_array($requested)) {
            $requested = end($requested);
        }

        if (is_string($requested) && trim($requested) !== '') {
            $version = normalize_version($requested);

            if ($version !== $packageVersion) {
                fail(
                    "sdk-typescript version [{$version}] must match packages/sdk-typescript/package.json version [{$packageVersion}].",
                );
            }
        } else {
            $version = $packageVersion;
        }
    } else {
        $version = normalize_version(required_string($options, 'version'));
    }

    reset_directory($output);
    copy_directory($source, $output);

    if ($package === 'sdk-typescript') {
        rewrite_npm_package_json($output.'/package.json', $version);
        rewrite_npm_package_lock($output.'/package-lock.json', $version);
    } else {
        rewrite_composer_json($output.'/composer.json', $version, $package);
    }
} catch (Throwable $exception) {
    fail($exception->getMessage());
}

/**
 * @param  array<string, mixed>  $options
 */
function required_string(array $options, string $key): string
{
    $value = $options[$key] ?? null;

    if (is_array($value)) {
        $value = end($value);
    }

    if (! is_string($value) || trim($value) === '') {
        fail("Missing required --{$key} option.");
    }

    return trim($value);
}

function normalize_version(string $version): string
{
    $version = ltrim(trim($version), 'v');

    if (preg_match('/^\d+\.\d+\.\d+$/', $version) !== 1) {
        fail('Version must be semver without a v prefix.');
    }

    return $version;
}

function reset_directory(string $path): void
{
    if (is_dir($path)) {
        remove_directory($path);
    }

    if (! mkdir($path, 0755, true) && ! is_dir($path)) {
        fail('Could not create output directory: '.$path);
    }
}

function remove_directory(string $path): void
{
    $iterator = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator($path, FilesystemIterator::SKIP_DOTS),
        RecursiveIteratorIterator::CHILD_FIRST,
    );

    foreach ($iterator as $item) {
        $item->isDir() ? rmdir($item->getPathname()) : unlink($item->getPathname());
    }

    rmdir($path);
}

function copy_directory(string $source, string $destination): void
{
    $filter = new RecursiveCallbackFilterIterator(
        new RecursiveDirectoryIterator($source, FilesystemIterator::SKIP_DOTS),
        static function (SplFileInfo $item) use ($source): bool {
            $relative = substr($item->getPathname(), strlen($source) + 1);

            return ! should_skip($relative, $item);
        },
    );

    $iterator = new RecursiveIteratorIterator(
        $filter,
        RecursiveIteratorIterator::SELF_FIRST,
    );

    foreach ($iterator as $item) {
        $relative = substr($item->getPathname(), strlen($source) + 1);

        $target = $destination.'/'.$relative;

        if ($item->isDir()) {
            if (! is_dir($target) && ! mkdir($target, 0755, true) && ! is_dir($target)) {
                fail('Could not create directory: '.$target);
            }

            continue;
        }

        $parent = dirname($target);

        if (! is_dir($parent) && ! mkdir($parent, 0755, true) && ! is_dir($parent)) {
            fail('Could not create directory: '.$parent);
        }

        if (! copy($item->getPathname(), $target)) {
            fail('Could not copy file: '.$item->getPathname());
        }

        $mode = $item->getPerms() & 0777;

        if (($mode & 0111) !== 0) {
            chmod($target, $mode);
        }
    }
}

function should_skip(string $relative, SplFileInfo $item): bool
{
    $segments = explode(DIRECTORY_SEPARATOR, $relative);
    $first = $segments[0] ?? '';

    if (in_array($first, ['.git', 'vendor', 'node_modules', 'build', 'builds', 'coverage'], true)) {
        return true;
    }

    if (in_array($relative, ['.env', '.env.testing', 'composer.lock'], true)) {
        return true;
    }

    if (str_contains(basename($relative), '.tmp.')) {
        return true;
    }

    if (is_path_or_child($relative, 'storage/logs')
        || is_path_or_child($relative, 'storage/framework/cache')
        || is_path_or_child($relative, 'storage/framework/sessions')
        || is_path_or_child($relative, 'storage/framework/testing')
        || is_path_or_child($relative, 'storage/framework/views')
        || is_path_or_child($relative, 'bootstrap/cache')) {
        return true;
    }

    return $item->isFile() && (str_ends_with($relative, '.sqlite') || str_ends_with($relative, '.log'));
}

function is_path_or_child(string $relative, string $path): bool
{
    return $relative === $path || str_starts_with($relative, $path.DIRECTORY_SEPARATOR);
}

function rewrite_composer_json(string $path, string $version, string $package): void
{
    if (! is_file($path)) {
        fail('composer.json not found in split package.');
    }

    $json = json_decode((string) file_get_contents($path), true, flags: JSON_THROW_ON_ERROR);

    if (! is_array($json)) {
        fail('composer.json did not decode to an object.');
    }

    $json['version'] = $version;

    if ($package !== 'core') {
        unset($json['repositories']);
    }

    if (in_array($package, ['cli', 'gateway'], true)) {

        if (! isset($json['require']) || ! is_array($json['require'])) {
            $json['require'] = [];
        }

        $json['require']['hardimpactdev/orbit-core'] = $version;
        $json['require']['hardimpactdev/orbit-sdk-laravel'] = $version;
        ksort($json['require']);
    }

    $encoded = json_encode($json, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES);

    if (! is_string($encoded)) {
        fail('Could not encode composer.json.');
    }

    file_put_contents($path, $encoded."\n");
}

function read_npm_package_version(string $path): string
{
    if (! is_file($path)) {
        fail('package.json not found: '.$path);
    }

    $json = json_decode((string) file_get_contents($path), true, flags: JSON_THROW_ON_ERROR);

    if (! is_array($json) || ! is_string($json['version'] ?? null)) {
        fail('package.json is missing a string version field: '.$path);
    }

    return normalize_version($json['version']);
}

function rewrite_npm_package_json(string $path, string $version): void
{
    if (! is_file($path)) {
        fail('package.json not found in split package.');
    }

    $json = json_decode((string) file_get_contents($path), true, flags: JSON_THROW_ON_ERROR);

    if (! is_array($json)) {
        fail('package.json did not decode to an object.');
    }

    // Exact public npm identity. Never preserve a legacy monorepo/local name.
    // Source monorepo keeps private=true; the prepared split package is public.
    $json['name'] = '@hardimpactdev/orbit-sdk-typescript';
    $json['version'] = $version;
    $json['private'] = false;
    $json['license'] = is_string($json['license'] ?? null) ? $json['license'] : 'MIT';
    $json['description'] = is_string($json['description'] ?? null) && trim($json['description']) !== ''
        ? $json['description']
        : 'Generated TypeScript client for the public Orbit gateway API surface.';
    // Durable split consumption points at the generated package repository.
    // Canonical source remains hardimpactdev/orbit packages/sdk-typescript.
    $json['repository'] = [
        'type' => 'git',
        'url' => 'https://github.com/hardimpactdev/orbit-sdk-typescript.git',
    ];
    $json['homepage'] = 'https://github.com/hardimpactdev/orbit-sdk-typescript';
    $json['bugs'] = [
        'url' => 'https://github.com/hardimpactdev/orbit/issues',
    ];
    $json['publishConfig'] = [
        'access' => 'public',
        'registry' => 'https://registry.npmjs.org/',
    ];

    // Prepared release packages are consumable outside the monorepo: keep the
    // published file set and drop monorepo-only generate scripts that require
    // the gateway checkout.
    $json['files'] = [
        'dist',
        'openapi/public-gateway-openapi.json',
        'README.md',
    ];
    $json['scripts'] = [
        'build' => 'tsc -p tsconfig.build.json',
        'typecheck' => 'tsc --noEmit',
        'test' => 'npm run typecheck',
    ];

    $encoded = json_encode($json, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES);

    if (! is_string($encoded)) {
        fail('Could not encode package.json.');
    }

    file_put_contents($path, $encoded."\n");
}

function rewrite_npm_package_lock(string $path, string $version): void
{
    if (! is_file($path)) {
        fail('package-lock.json not found in split package.');
    }

    $json = json_decode((string) file_get_contents($path), true, flags: JSON_THROW_ON_ERROR);

    if (! is_array($json)) {
        fail('package-lock.json did not decode to an object.');
    }

    // Keep prepared lock identity aligned with package.json for the generated
    // split/npm tree. Dependency graphs stay as-copied from the monorepo lock.
    $json['name'] = '@hardimpactdev/orbit-sdk-typescript';
    $json['version'] = $version;

    if (! isset($json['packages']) || ! is_array($json['packages'])) {
        fail('package-lock.json is missing a packages map.');
    }

    $root = $json['packages'][''] ?? null;

    if (! is_array($root)) {
        fail('package-lock.json is missing the root packages[""] entry.');
    }

    $root['name'] = '@hardimpactdev/orbit-sdk-typescript';
    $root['version'] = $version;
    $json['packages'][''] = $root;

    $encoded = json_encode($json, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES);

    if (! is_string($encoded)) {
        fail('Could not encode package-lock.json.');
    }

    file_put_contents($path, $encoded."\n");
}

function fail(string $message): never
{
    fwrite(STDERR, "orbit-prepare-release-package: {$message}\n");
    exit(1);
}
