{
  "kind": "node.role_add",
  "defaults": "node-role-add-defaults.json",
  "clean": true,
  "before_gateway": [
    ["apt-get", "update"],
    ["apt-get", "install", "--yes", "python3-venv"],
    ["python3", "-m", "venv", "/opt/orbit/ansible/venv"],
    ["/opt/orbit/ansible/venv/bin/pip", "install", "--disable-pip-version-check", "-r", "swamp/ansible/requirements.txt"],
    ["/opt/orbit/ansible/venv/bin/ansible-galaxy", "collection", "install", "-r", "swamp/ansible/requirements.yml", "-p", "/opt/orbit/ansible/collections"],
    ["runuser", "-u", "orbit", "--", "php", "swamp/proof/node.role_add/prepare.php", "${node.peer}", "app-dev"]
  ],
  "request": {
    "method": "POST",
    "path": "nodes/${node.peer}/roles",
    "body": {
      "role": "app-dev"
    }
  },
  "parity": ["swamp/proof/node.role_add/parity.py", "peer", "app-dev", "corrupt-mirror"],
  "prepare": [
    {
      "method": "POST",
      "path": "nodes/${node.peer}/converge",
      "body": {}
    }
  ],
  "before_node": {
    "peer": [
      ["rm", "-f", "/var/cache/apt/archives/caddy_2.11.7_linux_amd64.deb"],
      ["timeout", "35", "curl", "--head", "--fail", "--silent", "--show-error", "--location", "--max-time", "30", "--output", "/dev/null", "https://github.com/caddyserver/caddy/releases/download/v2.11.7/caddy_2.11.7_linux_amd64.deb"]
    ]
  },
  "after_prepare": [
    ["runuser", "-u", "orbit", "--", "php", "swamp/proof/node.role_add/prepare.php", "${node.peer}", "app-dev", "corrupt-mirror"],
    ["incus", "exec", "peer", "--", "rm", "-f", "${fixture.caddy_path}"],
    ["incus", "file", "push", "/home/orbit/.orbit/ca/root.pem", "peer/usr/local/share/ca-certificates/orbit-proof-mirror.crt"],
    ["incus", "exec", "peer", "--", "timeout", "60", "update-ca-certificates"],
    ["incus", "exec", "peer", "--", "timeout", "35", "curl", "--fail", "--silent", "--show-error", "--max-time", "30", "--output", "/dev/null", "${fixture.corrupt_url}"]
  ],
  "expect": {
    "status": "failed"
  },
  "phases": []
}
