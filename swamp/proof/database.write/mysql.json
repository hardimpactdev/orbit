{
  "kind": "database.write",
  "workflow": "operation-database-write",
  "topology": [
    "app-dev+database"
  ],
  "budget_seconds": 60,
  "queue_timeout_seconds": 30,
  "prepare": [
    {
      "argv": [
        "orbit",
        "database:server:create",
        "proof-write-server-mysql-${proof.run}",
        "--node=${topology.app-dev.node_id}",
        "--driver=mysql",
        "--port=33192",
        "--json"
      ],
      "capture": {
        "server_id": "$.target_id"
      }
    },
    {
      "argv": [
        "orbit",
        "database:create",
        "proof-write-mysql-${proof.run}",
        "--server=proof-write-server-mysql-${proof.run}",
        "--json"
      ],
      "capture": {
        "connection_id": "$.input.connection_id"
      }
    },
    {
      "argv": [
        "orbit",
        "database:query",
        "proof-write-mysql-${proof.run}",
        "CREATE TABLE proof_rows (id integer PRIMARY KEY, label varchar(64) NOT NULL)",
        "--write",
        "--json"
      ]
    }
  ],
  "request": {
    "argv": [
      "orbit",
      "database:query",
      "proof-write-mysql-${proof.run}",
      "INSERT INTO proof_rows (id,label) VALUES (1,'write-proof')",
      "--write",
      "--json"
    ],
    "operation": "$.id"
  },
  "envelope": {
    "connection_id": "${capture.connection_id}",
    "driver": "mysql",
    "connection_node_id": "${topology.app-dev.node_id}",
    "intent_id": "${match.positive_int}"
  },
  "expect": {
    "status": "succeeded",
    "outputs": {
      "job": "write",
      "step": "result",
      "match": {
        "exitCode": 0
      }
    }
  },
  "phases": [
    {
      "name": "execute-statement",
      "job": "write",
      "step": "sql",
      "budget_seconds": 60
    }
  ],
  "parity": {
    "command": [
      "python3",
      "-I",
      "swamp/proof/database-inspection/parity.py",
      "write",
      "mysql",
      "proof-write-mysql-${proof.run}",
      "--connection-id=${capture.connection_id}",
      "--node-id=${topology.app-dev.node_id}",
      "--server=proof-write-server-mysql-${proof.run}",
      "--port=33192",
      "--ip=${topology.app-dev.wireguard_ip}"
    ],
    "cases": [
      "exact-proof-identity-native-public-result",
      "independent-cli-readback",
      "unflagged-write-refused",
      "stacked-sql-refused-with-data-intact"
    ]
  }
}
