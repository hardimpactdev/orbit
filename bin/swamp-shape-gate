#!/usr/bin/env python3
"""Run the Swamp shape gate and the Swamp workflow validation, the same steps CI runs.

CI's "Swamp shape gate" and "Swamp workflow validate" jobs call this script, and bin/review-check
(root `composer check`) calls it when a change selects the Swamp checks. Run it from any directory
before you push; commit first, because the checkers compare committed HEAD with the base.

--base REF         compare with REF (default: the merge base with origin/main)
--only shape       run only the shape group; --only validate runs only the validation group
--only lint        run the pinned Ansible lint and Ruff checks; --only control runs static controls
--reports DIR      write the JSON reports here (default: a per-user directory in the temp directory)
--cache DIR        Swamp runtime cache for the validation (default: ~/.cache/orbit-shape-runtime)
--tools DIR        cache of the pinned tool venvs (default: /opt/orbit-shape-gate when the task image holds tools
                   for these pins, else ~/.cache/orbit-shape-gate)
--workers N        maximum concurrent independent shape commands (default: CI's shard_workers, capped by available CPUs)
--strict           fail instead of skipping credential-dependent validation (missing tools always fail)

The linters are pinned in swamp/ansible/shape-gate-requirements.txt, the only place that names them.
Container preparation caches them in /opt/orbit-shape-gate so a task copy runs the gate without a download.
Native workflow validation needs a Swamp account. It reads only SWAMP_API_KEY and SWAMP_SIGNIN_TOKEN.
Without them it is skipped and reported as skipped, not passed. `--only validate` then exits 78."""
import argparse
from concurrent.futures import ThreadPoolExecutor, as_completed
from itertools import groupby
import fcntl
import hashlib
import json
import os
import re
import runpy
import shutil
import subprocess
import sys
import tempfile
import time
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SWAMP = ROOT / 'swamp'
REQUIREMENTS = SWAMP / 'ansible/shape-gate-requirements.txt'
COLLECTIONS = SWAMP / 'ansible/requirements.yml'
SYSTEM_TOOLS = Path('/opt/orbit-shape-gate')
CREDENTIALS = ('SWAMP_API_KEY', 'SWAMP_SIGNIN_TOKEN')
CREDENTIALS_MISSING = 78
BASES = ('origin/main', 'main')

ANSIBLE_TESTS = ('tests/ansible_artifact_test.py', 'tests/ansible_inputs_test.py', 'tests/ansible_firewall_test.py', 'tests/ansible_model_forwarder_test.py',
                 'tests/ansible_swamp_retention_test.py', 'tests/ansible_apt_missing_test.py',
                 'tests/ansible_instance_egress_test.py', 'tests/ansible_instance_bridge_test.py', 'tests/ansible_instance_migrate_links_test.py',
                 'tests/ansible_container_host_system_test.py', 'tests/task_instance_workspace_test.py',
                 'tests/task_instance_workspace_snapshot_test.py',
                 'tests/task_instance_workspace_receipt_test.py',
                 'tests/task_instance_workspace_export_test.py',
                 'tests/task_instance_check_test.py',
                 'tests/task_instance_check_dependencies_test.py',
                 'tests/ansible_node_add_test.py', 'tests/ansible_shape_gate_tools_test.py',
                 'tests/ansible_gateway_swamp_grants_test.py',
                 'tests/ansible_task_vm_fleet_wait_test.py',
                 'tests/ansible_hub_prune_test.py', 'tests/ansible_fleet_converge_poll_test.py',
                 'tests/ansible_wireguard_hub_lan_rules_test.py', 'tests/ansible_wireguard_hub_lan_recovery_test.py',
                 'tests/ansible_wireguard_hub_lan_load_test.py', 'tests/ansible_hub_converge_peers_test.py', 'tests/ansible_static_php_test.py',
                 'tests/instance_migrate_env_test.py', 'tests/instance_node_runtime_test.py', 'tests/ansible_instance_app_account_boot_test.py',
                 'tests/instance_migrate_dotenv_test.py',
                 'tests/ansible_instance_module_args_test.py', 'tests/ansible_command_output_test.py',
                 'tests/instance_machine_name_test.py', 'tests/instance_power_helper_test.py',
                 'tests/instance_root_disk_test.py')
DENO_UNIT_TESTS = (
    ('--allow-env', '--allow-read', '--allow-run', '--allow-write', 'bin/check-swamp-shape_test.ts'),
    ('--allow-read', '--allow-run', 'bin/lint-behavior-names_test.ts'),
    ('-A', 'bin/swamp-liveness_test.ts'),
    ('-A', 'bin/source_test.ts'),
    ('-A', 'extensions/behaviors/automatic-deploy', 'extensions/behaviors/composer-maintenance',
     'extensions/behaviors/js-maintenance', 'extensions/behaviors/projects'),
    ('--allow-env', '--allow-read', '--allow-run', '--allow-write', 'bin/swamp-shape-python_test.ts'),
    ('--allow-env', '--allow-read', '--allow-run', '--allow-write', 'bin/validate-swamp-workflows_test.ts'),
    ('--allow-env', '--allow-read', '--allow-run', '--allow-write', 'bin/check-swamp-base-policy_test.ts'),
)
# Fast read-only audits run serially with the controls, outside fixture scheduling.
DENO_CONTROL_TESTS = ('tests/writes_declared_test.ts',)
# The file names `deno test` takes from a directory.
DENO_TEST_FILE = re.compile(r'(.*[._])?test\.(ts|tsx|mts|js|mjs|jsx)')
# Not in the shape group: the validation group runs the enrollment trust test, the firewall test stays out until it passes,
# and the host method test needs systemd and passwordless sudo.
DENO_TESTS_ELSEWHERE = ('tests/metrics_exporter_firewall_test.ts', 'tests/native_host_method_test.ts', 'tests/node_add_bootstrap_test.ts')


# Discovery groups only. Execution expands these into the same metadata slices as CI.
INSTANCE_HOST_TEST_GROUPS = (
    ('tests/ansible_instance_host_updates_test.ts',),
    ('tests/ansible_instance_host_test.ts', 'tests/ansible_instance_host_image_test.ts', 'tests/ansible_instance_host_runtime_test.ts'),
    ('tests/ansible_instance_host_acl_test.ts',),
    ('tests/ansible_instance_host_browser_test.ts',),
)


def deno_test_files(tracked_paths=None):
    """Start the long Instance-host groups first; every other file owns one command."""
    grouped = {file for group in INSTANCE_HOST_TEST_GROUPS for file in group}
    files = (sorted(path for path in tracked_paths if path.startswith('tests/') and DENO_TEST_FILE.fullmatch(Path(path).name))
             if tracked_paths is not None else
             sorted(str(path.relative_to(SWAMP)) for path in (SWAMP / 'tests').rglob('*') if DENO_TEST_FILE.fullmatch(path.name)))
    return [('-A', *group) for group in INSTANCE_HOST_TEST_GROUPS] + [
        ('-A', file) for file in files if file not in DENO_TESTS_ELSEWHERE and file not in grouped and file not in DENO_CONTROL_TESTS]


class Step:
    """One command of the gate. `needs` names what a missing prerequisite skips: credentials or a tool."""

    def __init__(self, group, name, argv, needs=(), env=None, parallel=False):
        self.group, self.name, self.argv, self.needs, self.env = group, name, list(argv), needs, env or {}
        self.parallel = parallel


def plan(base, reports, cache, collections, tracked_paths=None):
    """The steps in CI's order, with CI's arguments."""
    shape_report = reports / 'shape.json'
    ansible_env = {'ANSIBLE_COLLECTIONS_PATH': str(collections)}
    steps = [
        Step('shape', 'ansible collections', ['ansible-galaxy', 'collection', 'install', '-r', 'ansible/requirements.yml', '-p', str(collections)],
             env=ansible_env),
        Step('shape', 'ansible-lint', ['ansible-lint', 'ansible/operation-instance-create.yml', 'ansible/route-create-site.yml', 'ansible/route-withdraw.yml', 'ansible/ai-router-task-guard.yml', 'ansible/ai-router-model-forwarder.yml', 'ansible/operation-node-add.yml', 'ansible/operation-node-role-add.yml', 'ansible/operation-node-role-add-local-dns.yml', 'ansible/operation-node-converge-local-dns.yml', 'ansible/swamp-worker-renewal.yml',
                                       'ansible/task-vm-fleet-wait.yml', 'ansible/task-instance-workspace.yml', 'ansible/proof-gateway.yml', 'ansible/proof-observers.yml', 'ansible/operation-fleet-reboot.yml', 'ansible/conn-environment-restart.yml', 'ansible/operation-process-upgrade.yml'], env=ansible_env, parallel=True),
    ]
    deno_files = deno_test_files(tracked_paths)

    def deno_step(arguments):
        return Step('shape', 'deno test ' + ' '.join(arg for arg in arguments if not arg.startswith('-')),
                    ['deno', 'test', *arguments], env=ansible_env, parallel=True)

    # Start the long fixture groups alongside lint, rather than at the queue's tail.
    steps += [deno_step(arguments) for arguments in deno_files[:len(INSTANCE_HOST_TEST_GROUPS)]]
    steps += [Step('shape', test, ['python3', '-I', test], env=ansible_env, parallel=True) for test in ANSIBLE_TESTS]
    steps.append(Step('shape', 'ruff', ['ruff', 'check', 'ansible/build_vars.py', 'ansible/instance_bridge.py', 'ansible/instance_migrate_links.py', 'ansible/library/orbit_artifact.py', 'ansible/library/orbit_migrate_env.py', 'ansible/instance_machine_name.py', 'tests/_support/fixture_supervisor.py',
                                        *ANSIBLE_TESTS], parallel=True))
    steps += [deno_step(arguments) for arguments in (*DENO_UNIT_TESTS, *deno_files[len(INSTANCE_HOST_TEST_GROUPS):])]
    steps += [Step('shape', 'deno test ' + file, ['deno', 'test', '--allow-read', file]) for file in DENO_CONTROL_TESTS]
    steps += [
        Step('shape', 'check-swamp-shape', ['deno', 'run', '--allow-env', '--allow-read', f'--allow-write={shape_report}', '--allow-run',
                                            'bin/check-swamp-shape.ts', '--base', base, '--report', str(shape_report)]),
        Step('shape', 'check-swamp-base-policy', ['python3', 'bin/check-swamp-base-policy.py', '--base', base]),
        Step('shape', 'lint-behavior-names', ['deno', 'run', '--allow-read', '--allow-run', 'bin/lint-behavior-names.ts', '--base', base]),
        Step('shape', 'frozen agent commands', [str(ROOT / 'bin/check-frozen-agent-commands'), '--root', str(ROOT)]),
        Step('shape', 'workflow placement', ['deno', 'run', '--allow-read', 'bin/lint-workflow-placement.ts']),
        Step('validate', 'validate-swamp-workflows', ['python3', 'bin/validate-swamp-workflows.py', '--cache', str(cache),
                                                      '--report', str(reports / 'workflow-validation.json')], needs=('credentials',)),
        # It imports the extensions that the workflow validation pulls, so it needs the same credential.
        Step('validate', 'node enrollment trust', ['deno', 'test', '-A', 'tests/node_add_bootstrap_test.ts'], needs=('credentials',)),
        Step('validate', 'check-grant-patterns', ['python3', 'bin/check-grant-patterns.py', '--cache', str(cache),
                                                  '--report', str(reports / 'grant-validation.json')], needs=('credentials', 'php')),
    ]
    return steps


def git(*args):
    return subprocess.run(['git', '-C', str(ROOT), *args], capture_output=True, text=True, timeout=60)


def resolve_base(base):
    """CI passes the event's base commit. An empty or all-zero one (a new branch) means the previous commit."""
    if base is not None and base.strip() and not re.fullmatch(r'0+', base.strip()):
        return base.strip()
    if base is not None:
        return git('rev-parse', 'HEAD^').stdout.strip()
    for ref in BASES:
        result = git('merge-base', 'HEAD', ref)
        if result.returncode == 0:
            return result.stdout.strip()
    raise SystemExit('No merge base with origin/main. Fetch it, or pass --base REF.')


def venv_name():
    """The venv folder of these pins, built by this interpreter. swamp/ansible/shape_tool_names.py holds the rule, which the task VM
    role playbook runs on the VM."""
    pins = REQUIREMENTS.read_text() + (SWAMP / 'ansible/requirements.txt').read_text()
    return runpy.run_path(str(SWAMP / 'ansible/shape_tool_names.py'))['venv_name'](pins)


def collections_path(tools):
    return tools / f'collections-{hashlib.sha256(COLLECTIONS.read_bytes()).hexdigest()[:16]}'


def default_tools():
    """The tools of the task image when they are built for these pins, else the per-user cache."""
    if (SYSTEM_TOOLS / venv_name() / '.complete').exists():
        return SYSTEM_TOOLS
    return Path.home() / '.cache/orbit-shape-gate'


def tool_path(tools):
    """The bin directory of the pinned venv, built once per pin set under a lock. A built venv needs no write access."""
    venv = tools / venv_name()
    if not (venv / '.complete').exists():
        tools.mkdir(parents=True, exist_ok=True)
        with (tools / 'lock').open('w') as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            if not (venv / '.complete').exists():
                shutil.rmtree(venv, ignore_errors=True)
                # Standard error: the proof runner reads standard output of its fleet preparation as JSON.
                print(f'Installing the pinned shape tools into {venv}', file=sys.stderr, flush=True)
                subprocess.run([sys.executable, '-m', 'venv', str(venv)], check=True)
                subprocess.run([str(venv / 'bin/pip'), 'install', '--disable-pip-version-check', '-q', '-r', str(REQUIREMENTS)], check=True)
                (venv / '.complete').write_text('')
    return venv / 'bin'


def skip_reason(step, environment):
    missing = [tool for tool in step.needs if tool != 'credentials' and not shutil.which(tool, path=environment['PATH'])]
    if missing:
        return 'required tools not found on PATH: ' + ', '.join(missing)
    if 'credentials' in step.needs and not all(environment.get(name) for name in CREDENTIALS):
        return 'no Swamp credential: set ' + ' and '.join(CREDENTIALS)
    return None


def fixture_commands(steps, reports, tools, base, planner_python):
    """Select, pack and run fixtures through CI's planner and bounded runner."""
    units = runpy.run_path(str(ROOT / 'bin/ci-units'))
    budget, fixtures, _defaults = units['configuration']()
    planned = subprocess.run([str(planner_python), str(ROOT / 'bin/ci-units'), 'plan', '--base', base,
                              '--head', 'HEAD', '--plan-json', str(reports / 'fixture-plan.json')],
                             cwd=ROOT, capture_output=True, text=True)
    if planned.returncode:
        raise ValueError('Cannot plan CI fixtures: ' + planned.stderr)
    result = json.loads(planned.stdout)
    print(units['plan_summary'](result, fixtures), flush=True)
    if result.get('capacity'):
        raise ValueError('Fixture plan fails CI admission; see fixture-plan.json')
    commands = []
    for index, row in enumerate(result['shards'] + result['self_hosted_shards'], 1):
        shard = row['units']
        # Retain the lanes used for packing; serializing a shard can exceed its unchanged deadline.
        commands.append(Step('shape', f'CI fixture shard {index}', [sys.executable, str(ROOT / 'bin/ci-units'), 'run',
             '--units', json.dumps(shard), '--workers', str(units['shard_workers'](shard, budget, fixtures)),
             '--tools', str(tools), '--times', str(reports / f'fixture-{index}.json')],
             needs=tuple(sorted({tool for unit in shard for tool in fixtures[unit.split('#')[0]].get('host_programs', [])}))))
    pending = iter(commands)
    expanded = []
    for step in steps:
        if step.parallel and step.argv[0] in ('python3', 'deno'):
            expanded.extend(pending)
        else:
            expanded.append(step)
    return expanded


def run_step(step, environment, strict):
    print(f'==> {step.name}', flush=True)
    reason = skip_reason(step, environment)
    if reason:
        outcome = 'skipped' if not strict and reason.startswith('no Swamp credential:') else 'FAILED'
        return (step, outcome, 0.0, reason), reason + '\n'
    started = time.monotonic()
    # Each command owns its output and temporary fixtures. A parallel Deno command gets one worker,
    # so nested test parallelism cannot multiply the shared command budget.
    with tempfile.TemporaryDirectory(prefix='orbit-shape-step-') as scratch, tempfile.TemporaryFile(mode='w+t') as output:
        scratch = str(Path(scratch).resolve())
        env = {**environment, **step.env, 'TMPDIR': scratch, 'TEMP': scratch, 'TMP': scratch}
        if step.parallel:
            env.update(DENO_JOBS='1', ANSIBLE_FORKS='1', PYTHON_CPU_COUNT='1', RAYON_NUM_THREADS='1')
        try:
            code = subprocess.run(step.argv, cwd=SWAMP, env=env, stdout=output, stderr=subprocess.STDOUT).returncode
        except FileNotFoundError as error:
            output.write(f'{error.filename or step.argv[0]}: required tool not found\n')
            code = 127
        output.seek(0)
        return (step, 'passed' if code == 0 else 'FAILED', time.monotonic() - started, f'exit {code}'), output.read()


def execute(steps, environment, strict, workers):
    results = []
    order = {id(step): index for index, step in enumerate(steps)}

    def record(completed):
        result, output = completed
        step, outcome, _seconds, detail = result
        print(f'==> {step.name}: {outcome}' + (f', {detail}' if outcome == 'skipped' else ''), flush=True)
        if output:
            print(output, end='' if output.endswith('\n') else '\n', flush=True)
        results.append(result)

    # Collections and tool setup finish before the independent group. Ratchets and validation stay serial.
    for parallel, group in groupby(steps, key=lambda step: step.parallel):
        group = list(group)
        if parallel:
            with ThreadPoolExecutor(max_workers=workers) as pool:
                futures = [pool.submit(run_step, step, environment, strict) for step in group]
                for future in as_completed(futures):
                    record(future.result())
        else:
            for step in group:
                record(run_step(step, environment, strict))
    # Keep the summary and callers in plan order while command output streams in completion order.
    return sorted(results, key=lambda result: order[id(result[0])])


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('--base')
    parser.add_argument('--only', choices=('shape', 'control', 'lint', 'validate'))
    parser.add_argument('--reports', type=Path, default=Path(tempfile.gettempdir()) / f'orbit-shape-gate-{os.getuid()}')
    parser.add_argument('--cache', type=Path, default=Path.home() / '.cache/orbit-shape-runtime')
    parser.add_argument('--tools', type=Path)
    parser.add_argument('--strict', action='store_true')
    parser.add_argument('--workers', type=int, default=min(
        tomllib.loads((ROOT / '.github/ci/checks.toml').read_text())['budget']['shard_workers'], os.cpu_count() or 1))
    args = parser.parse_args(argv)
    if args.workers < 1:
        parser.error('--workers must be positive')
    # CI's umask; a looser one changes file modes that the Ansible artifact tests compare.
    os.umask(0o022)
    args.reports = args.reports.resolve()
    args.reports.mkdir(parents=True, exist_ok=True)
    environment = {**os.environ}
    missing = [tool for tool in (() if args.only == 'lint' else ('git', 'deno'))
               if not shutil.which(tool, path=environment['PATH'])]
    if missing:
        print('Missing gate prerequisites: ' + ', '.join(missing)
              + '. Install Git and Deno 2.9.8 on PATH; see docs/reference/implementation-loop.md#run-the-swamp-shape-gate-before-you-push.',
              file=sys.stderr)
        return 2
    # Lint and validation need no base; their CI jobs can check out one commit.
    args.tools = (args.tools or default_tools()).resolve()
    base = resolve_base(args.base) if args.only not in ('validate', 'lint') else ''
    if args.only != 'validate':
        try:
            tools_bin = tool_path(args.tools)
            environment['PATH'] = f'{tools_bin}{os.pathsep}{environment["PATH"]}'
        except (OSError, subprocess.CalledProcessError) as error:
            print(f'Cannot prepare pinned gate tools: {error}. Install Python 3.13+ with venv/pip '
                  'support (python3-venv on Debian/Ubuntu) and allow downloads from PyPI.', file=sys.stderr)
            return 2
    collections = collections_path(args.tools)
    steps = [step for step in plan(base, args.reports, args.cache, collections)
             if args.only in (None, step.group)
             or args.only == 'control' and step.group == 'shape' and not step.parallel and step.name != 'ansible collections'
             or args.only == 'lint' and step.name in ('ansible collections', 'ansible-lint', 'ruff')]
    if args.only in (None, 'shape'):
        try:
            steps = fixture_commands(steps, args.reports, args.tools, base, tools_bin / 'python3')
        except ValueError as error:
            print(str(error), file=sys.stderr)
            return 1
    print('Swamp shape gate' + (f' against {base[:12]}' if base else '') + f'; reports in {args.reports}', flush=True)
    results = execute(steps, environment, args.strict, args.workers)
    print('\nSwamp shape gate summary', flush=True)
    for step, outcome, seconds, detail in results:
        print(f'  {outcome:<7} {step.name} ({seconds:.1f}s{"; " + detail if outcome != "passed" else ""})', flush=True)
    failed = [step.name for step, outcome, _seconds, _detail in results if outcome == 'FAILED']
    skipped = [step.name for step, outcome, _seconds, _detail in results if outcome == 'skipped']
    if failed:
        print(f'FAILED: {", ".join(failed)}', flush=True)
        return 1
    if skipped:
        print(f'PASSED with skipped steps: {", ".join(skipped)}. CI runs them.', flush=True)
        return CREDENTIALS_MISSING if args.only == 'validate' else 0
    print('PASSED', flush=True)
    return 0


if __name__ == '__main__':
    sys.exit(main())
