{
	admin unix/{$GATEWAY_ADMIN_SOCKET:/run/orbit-gateway-web/admin.sock}
	persist_config off
	auto_https off
	servers {
		trusted_proxies static {$GATEWAY_TRUSTED_PROXY}
		client_ip_headers X-Forwarded-For
		trusted_proxies_strict
	}
	frankenphp {
		php_ini memory_limit 128M
		php_ini post_max_size 64M
		php_ini upload_max_filesize 64M
		php_ini max_execution_time {$GATEWAY_REQUEST_TIMEOUT:600}
		php_ini opcache.enable 1
		php_ini opcache.validate_timestamps 0
	}
}

(gateway_worker) {
	root * {$GATEWAY_APP_ROOT:/home/orbit/orbit/apps/gateway}/public
	php_server {
		# The host Caddy overwrites X-Forwarded-For and terminates TLS.
		env REMOTE_ADDR {client_ip}
		env HTTPS on
		worker {
			name {args[0]}
			file {$GATEWAY_APP_ROOT:/home/orbit/orbit/apps/gateway}/vendor/laravel/octane/bin/frankenphp-worker.php
			num {args[1]}
			match *
			env APP_BASE_PATH {$GATEWAY_APP_ROOT:/home/orbit/orbit/apps/gateway}
			env MAX_REQUESTS 500
			env REQUEST_MAX_EXECUTION_TIME {$GATEWAY_REQUEST_TIMEOUT:600}
		}
	}
}

http://:{$GATEWAY_PORT:8080} {
	bind {$GATEWAY_BIND_ADDRESS}

	@fast path /up /api/v1/gateway/status /api/v1/runtime-activations/*
	handle @fast {
		import gateway_worker fast {$GATEWAY_FAST_WORKERS:4}
	}

	@gateway path /api/* /mcp /mcp/* /.well-known/* /horizon /horizon/*
	handle @gateway {
		import gateway_worker api {$GATEWAY_API_WORKERS:12}
	}

	handle /vendor/horizon-new-dawn/* {
		root * {$GATEWAY_APP_ROOT:/home/orbit/orbit/apps/gateway}/public
		file_server
	}

	handle /assets/* {
		root * {$GATEWAY_WEB_ROOT:/home/orbit/web/current}
		@asset file
		header @asset Cache-Control "public, max-age=31536000, immutable"
		@missing not file
		header @missing Cache-Control "no-cache"
		file_server
	}

	handle {
		root * {$GATEWAY_WEB_ROOT:/home/orbit/web/current}
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
