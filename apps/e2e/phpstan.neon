includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/spaze/phpstan-disallowed-calls/extension.neon
    - ../../tools/phpstan/orbit-rules.neon
    - ../../tools/phpstan/parallel.php

parameters:
    level: 9
    paths:
        - app
        - ../../tools/phpstan
    tmpDir: vendor/phpstan/cache

