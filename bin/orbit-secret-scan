#!/usr/bin/env php
<?php

declare(strict_types=1);

require_once __DIR__.'/orbit-loop-contract.php';
require_once __DIR__.'/orbit-secret-rules.php';

$options = getopt('', ['worktree:', 'orbit-dir:', 'tree:', 'help']);

if (isset($options['help'])) {
    fwrite(STDOUT, "Usage: bin/orbit-secret-scan --worktree=<path> --orbit-dir=<path> [--tree=<path>]\n");
    exit(0);
}

$worktree = realpath((string) ($options['worktree'] ?? getcwd())) ?: (string) ($options['worktree'] ?? getcwd());
$orbitDir = rtrim((string) ($options['orbit-dir'] ?? "{$worktree}/.orbit"), '/');
$tree = isset($options['tree']) ? rtrim((string) $options['tree'], '/') : null;
$findings = $tree === null ? scanCandidateAndCompactState($worktree, $orbitDir) : scanConstructedTree($tree);

if ($findings !== []) {
    foreach ($findings as $finding) {
        fwrite(STDERR, "SECRET_SCAN: BLOCKED {$finding['path']} rule={$finding['rule']}\n");
    }

    exit(2);
}

fwrite(STDOUT, "SECRET_SCAN: PASS\n");

/** @return list<array{path: string, rule: string}> */
function scanCandidateAndCompactState(string $worktree, string $orbitDir): array
{
    $findings = [];
    $base = orbitLoopGitValue($worktree, ['merge-base', 'main', 'HEAD']);

    if ($base !== null) {
        $diff = orbitLoopGitValue($worktree, ['diff', '--unified=0', '--no-color', $base, 'HEAD']);
        $path = 'candidate diff';

        foreach (preg_split('/\R/', (string) $diff) ?: [] as $line) {
            if (str_starts_with($line, '+++ b/')) {
                $path = substr($line, 6);

                continue;
            }

            if (! str_starts_with($line, '+') || str_starts_with($line, '+++')) {
                continue;
            }

            foreach (orbitSecretFindings(substr($line, 1), includeSessionAssignments: false) as $finding) {
                $findings[] = ['path' => $path, 'rule' => $finding['rule']];
            }
        }
    }

    foreach (['loop.md', 'feedback.jsonl'] as $name) {
        $path = "{$orbitDir}/{$name}";

        if (is_link($path)) {
            $findings[] = ['path' => $path, 'rule' => 'unsafe-symlink'];

            continue;
        }

        if (! is_file($path)) {
            continue;
        }

        foreach (orbitSecretFindings(secretScanReadPinnedFile($path)) as $finding) {
            $findings[] = ['path' => $path, 'rule' => $finding['rule']];
        }
    }

    return $findings;
}

/** @return list<array{path: string, rule: string}> */
function scanConstructedTree(string $tree): array
{
    $rootStat = @lstat($tree);

    if ($rootStat === false || ! secretScanStatIsDirectory($rootStat)) {
        return [['path' => $tree, 'rule' => 'unsafe-tree-root']];
    }

    $findings = [];
    $iterator = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator($tree, RecursiveDirectoryIterator::SKIP_DOTS),
        RecursiveIteratorIterator::SELF_FIRST,
    );

    foreach ($iterator as $entry) {
        $path = $entry->getPathname();
        $relative = ltrim(substr($path, strlen($tree)), '/');

        if ($entry->isLink()) {
            $findings[] = ['path' => $relative, 'rule' => 'unsafe-symlink'];

            continue;
        }

        if ($entry->isDir()) {
            continue;
        }

        if (! $entry->isFile()) {
            $findings[] = ['path' => $relative, 'rule' => 'unsafe-nonregular'];

            continue;
        }

        try {
            $contents = secretScanReadPinnedFile($path);
        } catch (Throwable) {
            $findings[] = ['path' => $relative, 'rule' => 'unsafe-unreadable'];

            continue;
        }

        foreach (orbitSecretFindings($contents) as $finding) {
            $findings[] = ['path' => $relative, 'rule' => $finding['rule']];
        }
    }

    return $findings;
}

function secretScanReadPinnedFile(string $path): string
{
    $initial = @lstat($path);

    if ($initial === false || ! secretScanStatIsRegular($initial)) {
        throw new RuntimeException("Secret scan path must be a regular file: {$path}");
    }

    $handle = @fopen($path, 'rb');

    if ($handle === false) {
        throw new RuntimeException("Unable to read secret scan path: {$path}");
    }

    try {
        $opened = fstat($handle);

        if ($opened === false || ! secretScanSameIdentity($initial, $opened)) {
            throw new RuntimeException("Secret scan path changed before read: {$path}");
        }

        $contents = stream_get_contents($handle);
        $current = @lstat($path);

        if ($contents === false || $current === false || ! secretScanSameIdentity($initial, $current)) {
            throw new RuntimeException("Secret scan path changed during read: {$path}");
        }

        return $contents;
    } finally {
        fclose($handle);
    }
}

/** @param array<int|string, mixed> $stat */
function secretScanStatIsRegular(array $stat): bool
{
    return ((int) $stat['mode'] & 0o170000) === 0o100000;
}

/** @param array<int|string, mixed> $stat */
function secretScanStatIsDirectory(array $stat): bool
{
    return ((int) $stat['mode'] & 0o170000) === 0o040000;
}

/**
 * @param array<int|string, mixed> $left
 * @param array<int|string, mixed> $right
 */
function secretScanSameIdentity(array $left, array $right): bool
{
    return (
        (int) $left['dev'] === (int) $right['dev']
        && (int) $left['ino'] === (int) $right['ino']
        && ((int) $left['mode'] & 0o170000) === ((int) $right['mode'] & 0o170000)
    );
}
