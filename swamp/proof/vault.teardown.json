{
  "kind": "vault.teardown",
  "workflow": "operation-vault-teardown",
  "topology": "minimal",
  "clean": true,
  "budget_seconds": 1800,
  "queue_timeout_seconds": 30,
  "expect": {
    "status": "succeeded"
  },
  "before_gateway": [
    [
      "python3",
      "-I",
      "swamp/tests/fixtures/vaultwarden_proof_setup.py",
      "teardown"
    ]
  ],
  "prepare": [
    {
      "method": "POST",
      "path": "extensions/vault/enable",
      "body": {},
      "operation": false
    },
    {
      "method": "PUT",
      "path": "vault",
      "body": {
        "url": "${secret.url}",
        "client_id": "${secret.client_id}",
        "client_secret": "${secret.client_secret}",
        "master_password": "${secret.master_password}",
        "organization": "${secret.organization}",
        "collection": "${secret.collection}"
      }
    },
    {
      "method": "POST",
      "path": "vault/sync",
      "body": {}
    }
  ],
  "request": {
    "method": "DELETE",
    "path": "vault",
    "body": {}
  },
  "phases": [
    {
      "name": "Prepare public data",
      "job": "prepare",
      "step": "Prepare public data",
      "budget_seconds": 60
    },
    {
      "name": "Create CLI session",
      "job": "prepare",
      "step": "Create CLI session",
      "budget_seconds": 60
    },
    {
      "name": "Prepare session file",
      "job": "prepare",
      "step": "Prepare session file",
      "budget_seconds": 60
    },
    {
      "name": "Configure the server",
      "job": "prepare",
      "step": "Configure the server",
      "budget_seconds": 60
    },
    {
      "name": "Log in",
      "job": "prepare",
      "step": "Log in",
      "budget_seconds": 60
    },
    {
      "name": "Unlock the vault",
      "job": "prepare",
      "step": "Unlock the vault",
      "budget_seconds": 60
    },
    {
      "name": "Resolve the session",
      "job": "prepare",
      "step": "Resolve the session",
      "budget_seconds": 60
    },
    {
      "name": "Sync the vault",
      "job": "prepare",
      "step": "Sync the vault",
      "budget_seconds": 60
    },
    {
      "name": "Read private inventory",
      "job": "prepare",
      "step": "Read private inventory",
      "budget_seconds": 60
    },
    {
      "name": "inventory",
      "job": "prepare",
      "step": "inventory",
      "budget_seconds": 60
    },
    {
      "name": "Read private trash",
      "job": "prepare",
      "step": "Read private trash",
      "budget_seconds": 60
    },
    {
      "name": "trash",
      "job": "prepare",
      "step": "trash",
      "budget_seconds": 60
    },
    {
      "name": "Select published items",
      "job": "prepare",
      "step": "Select published items",
      "budget_seconds": 60
    },
    {
      "name": "Read organizations",
      "job": "prepare",
      "step": "Read organizations",
      "budget_seconds": 60
    },
    {
      "name": "Select the organization",
      "job": "prepare",
      "step": "Select the organization",
      "budget_seconds": 60
    },
    {
      "name": "Log out",
      "job": "cleanup",
      "step": "Log out",
      "budget_seconds": 60
    },
    {
      "name": "Remove CLI session",
      "job": "cleanup",
      "step": "Remove CLI session",
      "budget_seconds": 60
    },
    {
      "name": "Confirm teardown",
      "job": "cleanup",
      "step": "Confirm teardown",
      "budget_seconds": 60
    }
  ],
  "parity": "swamp/proof/vault/teardown_parity.py"
}
