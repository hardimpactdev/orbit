{
  "kind": "firewall.deny",
  "workflow": "operation-firewall-direct",
  "topology": "minimal",
  "budget_seconds": 300,
  "expect": {
    "status": "succeeded"
  },
  "phases": [
    {
      "name": "Read the rules",
      "job": "firewall",
      "step": "Read the rules",
      "budget_seconds": 60
    },
    {
      "name": "Plan the changes",
      "job": "firewall",
      "step": "Plan the changes",
      "budget_seconds": 60
    },
    {
      "name": "Read the result",
      "job": "firewall",
      "step": "Read the result",
      "budget_seconds": 60
    },
    {
      "name": "Check the rules",
      "job": "firewall",
      "step": "Check the rules",
      "budget_seconds": 60
    },
    {
      "name": "accepted",
      "job": "firewall",
      "step": "accepted",
      "budget_seconds": 60
    }
  ],
  "prepare": [
    {
      "method": "POST",
      "path": "nodes/${node.target}/firewall-rules/allow",
      "body": {
        "port": "25"
      }
    }
  ],
  "request": {
    "method": "POST",
    "path": "nodes/${node.target}/firewall-rules/deny",
    "body": {
      "port": "25",
      "source": "192.0.2.10",
      "label": "spam host"
    }
  },
  "parity": [
    "swamp/proof/firewall/check.py",
    "+25/tcp DENY 192.0.2.10 # orbit spam host",
    "+25/tcp ALLOW Anywhere",
    "+25/udp DENY 192.0.2.10 # orbit spam host",
    "+25/udp ALLOW Anywhere",
    "+25/tcp (v6) ALLOW Anywhere (v6)"
  ]
}
