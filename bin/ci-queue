#!/usr/bin/env python3
"""Report per-attempt fixture queue time and observed runner pressure from the read-only Actions API."""
import argparse
from collections import Counter
from datetime import datetime
import json
import math
import os
from pathlib import Path
import subprocess
import sys
import tomllib

ROOT = Path(__file__).resolve().parents[1]


def peak(intervals):
    events = [(stamp, change) for start, end in intervals if start < end
              for stamp, change in ((start, 1), (end, -1))]
    running = maximum = 0
    for _, change in sorted(events):
        running += change
        maximum = max(maximum, running)
    return maximum


def queue_summary(jobs, slots):
    groups = {'Ordinary shared': [], 'Tool-dependent shared': [], 'GitHub-hosted': []}
    excluded = Counter(dict.fromkeys(('skipped', 'unassigned', 'unfinished', 'invalid timestamps'), 0))
    shared = []
    runners = set()
    for job in jobs:
        if not job['name'].startswith(('Fixtures (', 'Self-hosted fixtures (')):
            continue
        if job.get('conclusion') == 'skipped':
            excluded['skipped'] += 1
            continue
        if not job.get('runner_name'):
            excluded['unassigned'] += 1
            continue
        if job['status'] != 'completed' or not job.get('completed_at'):
            excluded['unfinished'] += 1
            continue
        try:
            created, started, completed = (datetime.fromisoformat(job[key]) for key in
                                           ('created_at', 'started_at', 'completed_at'))
            if not created <= started <= completed:
                raise ValueError('Copied rerun or unordered timestamps')
        except (ValueError, TypeError, KeyError):
            excluded['invalid timestamps'] += 1
            continue
        if 'self-hosted' in job['labels']:
            group = 'Tool-dependent shared' if job['name'].startswith('Self-hosted fixtures (') else 'Ordinary shared'
            shared.append((created, started, completed))
            runners.add(job['runner_name'])
        else:
            group = 'GitHub-hosted'
        groups[group].append(((started - created).total_seconds(), (completed - started).total_seconds()))

    body = ('## Fixture queue pressure\n\n'
            '| Pool | Measured jobs | Queue p50 s | Queue p90 s | Queue max s | Run p50 s | Run p90 s | Run max s |\n'
            '| --- | ---: | ---: | ---: | ---: | ---: | ---: | ---: |\n')
    for group, rows in groups.items():
        numbers = []
        for column in (0, 1):
            values = sorted(row[column] for row in rows)
            numbers += [f'{values[math.ceil(len(values) * fraction) - 1]:g}' if values else 'n/a'
                        for fraction in (0.5, 0.9, 1)]
        body += f'| {group} | {len(rows)} | ' + ' | '.join(numbers) + ' |\n'
    body += (f'\nDistinct shared runners: {len(runners)}'
             + (f' (`{", ".join(sorted(runners))}`)' if runners else '') + '.\n\n'
             f'Peak running: {peak((s, e) for _, s, e in shared)} / {slots} model slots; '
             f'peak queued: {peak((c, s) for c, s, _ in shared)}. '
             'Per-run shared fixture peaks only, not global occupancy or online inventory.\n\n'
             'Excluded fixture records: ' + '; '.join(f'{key} {value}' for key, value in excluded.items()) + '.\n\n'
             'Completed assigned jobs with ordered timestamps only, including failed and cancelled executions. '
             'Queue = created → started; run = started → completed (setup and teardown included). '
             'Nearest-rank percentiles; excluded records are not zero waits.\n')
    return body


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--repo', default=os.environ.get('GITHUB_REPOSITORY', '{owner}/{repo}'))
    parser.add_argument('--run-id', type=int, default=os.environ.get('GITHUB_RUN_ID'))
    parser.add_argument('--attempt', type=int, default=os.environ.get('GITHUB_RUN_ATTEMPT'))
    args = parser.parse_args()
    if not args.run_id or args.run_id < 1 or args.attempt is not None and args.attempt < 1:
        parser.error('Pass a positive --run-id and, optionally, --attempt')
    try:
        base = f'repos/{args.repo}/actions/runs/{args.run_id}'
        attempt = args.attempt
        if attempt is None:
            attempt = json.loads(subprocess.check_output(['gh', 'api', base], timeout=20))['run_attempt']
        pages = json.loads(subprocess.check_output([
            'gh', 'api', '--paginate', '--slurp', f'{base}/attempts/{attempt}/jobs?per_page=100',
        ], timeout=20))
        slots = tomllib.loads((ROOT / '.github/ci/checks.toml').read_text())['runner-pool']['slots']
        body = queue_summary([job for page in pages for job in page['jobs']], slots)
        body += f'\nRun {args.run_id}, attempt {attempt}.\n'
        result = 0
    except (ValueError, KeyError, TypeError, OSError, subprocess.SubprocessError) as error:
        body = f'## Fixture queue pressure unavailable\n\n{error}\n'
        result = 1
    print(body, end='')
    if os.environ.get('GITHUB_STEP_SUMMARY'):
        with Path(os.environ['GITHUB_STEP_SUMMARY']).open('a') as summary:
            summary.write(body)
    return result


if __name__ == '__main__':
    sys.exit(main())
