{
  "topology": "minimal",
  "queue_timeout_seconds": 300,
  "kind": "schedule.create",
  "workflow": "task-command-run",
  "budget_seconds": 150,
  "request": {
    "method": "POST",
    "path": "schedules",
    "body": {
      "target_type": "node",
      "target_id": "${node.target}",
      "name": "disabled-${proof.run}",
      "calendar": "@daily",
      "command": "true",
      "timeout_seconds": 60,
      "start": false
    }
  },
  "expect": {
    "status": "succeeded",
    "run": false
  },
  "phases": [],
  "parity": [
    "swamp/proof/schedule/parity.py",
    "disabled"
  ]
}
