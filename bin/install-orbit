#!/usr/bin/env bash

set -Eeuo pipefail

TARGET_DIR="${ORBIT_INSTALL_PATH:-$HOME/orbit}"
CONFIG_ROOT="${ORBIT_CONFIG_ROOT:-$HOME/.config/orbit}"
GATEWAY_ENV_FILE="$CONFIG_ROOT/.env"
GATEWAY_DATABASE_FILE="$CONFIG_ROOT/gateway.sqlite"
REPO_URL="${ORBIT_REPO_URL:-https://github.com/hardimpactdev/orbit.git}"
BRANCH="${ORBIT_BRANCH:-main}"
SOURCE_ARCHIVE=""
GATEWAY_IMAGE="${ORBIT_GATEWAY_IMAGE:-orbit-gateway:current}"
GATEWAY_IMAGE_ARCHIVE="${ORBIT_GATEWAY_IMAGE_ARCHIVE:-}"
CADDY_IMAGE_ARCHIVE="${ORBIT_CADDY_IMAGE_ARCHIVE:-}"
DNSMASQ_IMAGE_ARCHIVE="${ORBIT_DNSMASQ_IMAGE_ARCHIVE:-}"
FRANKENPHP_IMAGE_ARCHIVE="${ORBIT_FRANKENPHP_IMAGE_ARCHIVE:-}"
WG_EASY_IMAGE_ARCHIVE="${ORBIT_WG_EASY_IMAGE_ARCHIVE:-}"
LINK_PATH="${ORBIT_BIN_PATH:-$HOME/.local/bin/orbit}"
SHARED_BINARY_PATH="${ORBIT_SHARED_BINARY_PATH:-}"
USE_SUDO=1
SKIP_PREREQUISITES="${ORBIT_INSTALL_SKIP_PREREQUISITES:-0}"
APT_LOCK_TIMEOUT_SECONDS="${ORBIT_APT_LOCK_TIMEOUT_SECONDS:-300}"
VERBOSE=0
LOG_FILE="${ORBIT_INSTALL_LOG:-}"
CURRENT_STEP=""

# The Orbit CLI is a self-contained native binary with embedded PHP 8.5.
# The installer downloads the prebuilt binary for the host OS/arch and links
# it as the host `orbit` command — no host PHP is required to run the CLI.
#
# Default download: authenticated `gh release download` from the private GitHub
# repository. `gh` is a host prerequisite and automatically picks up
# GH_TOKEN / GITHUB_TOKEN from the environment (or the host `gh auth` login).
#
# Supported asset names:
#   orbit-macos-arm64   (macOS Apple Silicon)
#   orbit-linux-x64     (Ubuntu x86_64)
#
# Override with ORBIT_BINARY_URL to skip gh and fetch via curl instead
# (local file:// artifacts, public mirrors, or CI-cached URLs):
#   ORBIT_BINARY_URL=file:///path/to/orbit-linux-x64 bin/install-orbit
#   ORBIT_BINARY_URL=https://example.com/orbit-linux-x64 bin/install-orbit
ORBIT_BINARY_REPO="${ORBIT_BINARY_REPO:-hardimpactdev/orbit}"
ORBIT_RELEASE_TAG="${ORBIT_RELEASE_TAG:-}"
ORBIT_BINARY_URL="${ORBIT_BINARY_URL:-}"

usage() {
    cat <<'HELP'
usage: bin/install-orbit [options]

Install the Orbit CLI and its Docker-first gateway prerequisites on the
current host. The installer downloads and links the prebuilt Orbit CLI binary
(with embedded PHP 8.5) via authenticated `gh release download` (gh is a host
prerequisite; GH_TOKEN / GITHUB_TOKEN are picked up automatically), sets up
the Orbit source checkout when requested, prepares the orbit-gateway image and
gateway dependency images, and runs gateway migrations inside a disposable
orbit-gateway container. Long-running gateway API and scheduler services are
converged separately by the gateway Swarm bootstrap path. No host PHP, no host
Composer, no host Caddy, and no host PHP-FPM is installed. Set ORBIT_BINARY_URL
to override the download with a direct curl
(e.g. a local file:// artifact or public mirror).

Options:
  --path=PATH                  Orbit checkout path. Defaults to "$HOME/orbit".
  --repo=URL                   Git repository to clone when no source archive is provided.
  --branch=NAME                Git branch to clone or update. Defaults to "main".
  --source-archive=PATH        Extract this Orbit source tarball instead of cloning.
  --gateway-image=IMAGE        Gateway image reference to load, pull, or build.
                               Defaults to orbit-gateway:current.
  --gateway-image-archive=PATH Load the configured gateway image from this
                               Docker image archive before pulling/building.
  --caddy-image-archive=PATH   Load caddy:2-alpine from this Docker image
                               archive before falling back to Docker Hub.
  --dnsmasq-image-archive=PATH Load 4km3/dnsmasq:latest from this Docker
                               image archive for gateway DNS bootstrap.
  --frankenphp-image-archive=PATH
                               Load ghcr.io/hardimpactdev/orbit-frankenphp:2-php8.5-bookworm from
                               this Docker image archive before falling back
                               to Docker Hub.
  --wg-easy-image-archive=PATH Load ghcr.io/wg-easy/wg-easy:15 from this Docker
                               image archive before the gateway VPN service
                               starts.
  --bin=PATH                   Symlink path for the orbit executable.
                               Defaults to "$HOME/.local/bin/orbit".
  --skip-prerequisites         Skip Docker / package prerequisite installation.
                               Intended for prepared E2E images that already
                               contain gateway packages.
  --no-sudo                    Run package and symlink commands without sudo.
  --verbose                    Stream underlying command output.
  -h, --help                   Show this help text.

The installer is intentionally local-host only. A new operator node runs it
before invoking Orbit. Gateway and app roles are provisioned by node:new from a
configured operator node.
HELP
}

fail() {
    local code="$1"
    shift

    printf 'orbit-install: error [%s] %s\n' "$code" "$*" >&2

    if [ -n "$LOG_FILE" ] && [ -f "$LOG_FILE" ]; then
        printf 'orbit-install: log %s\n' "$LOG_FILE" >&2
    fi

    exit 1
}

quote() {
    printf '%q' "$1"
}

json_escape() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

run() {
    ensure_log_file

    {
        printf '+'
        printf ' %q' "$@"
        printf '\n'
    } >>"$LOG_FILE"

    if [ "$VERBOSE" = "1" ]; then
        "$@" 2>&1 | tee -a "$LOG_FILE"

        return "${PIPESTATUS[0]}"
    fi

    "$@" >>"$LOG_FILE" 2>&1
}

sudo_run() {
    if [ "$USE_SUDO" = "1" ] && [ "$(id -u)" -ne 0 ]; then
        run sudo "$@"
        return
    fi

    run "$@"
}

sudo_shell() {
    if [ "$USE_SUDO" = "1" ] && [ "$(id -u)" -ne 0 ]; then
        run sudo bash -lc "$1"
        return
    fi

    run bash -lc "$1"
}

apt_get_update() {
    sudo_run apt-get -o "DPkg::Lock::Timeout=${APT_LOCK_TIMEOUT_SECONDS}" update
}

apt_get_install() {
    sudo_run env DEBIAN_FRONTEND=noninteractive apt-get -o "DPkg::Lock::Timeout=${APT_LOCK_TIMEOUT_SECONDS}" install -y "$@"
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || fail validation_failed "required command missing: $1"
}

ensure_log_file() {
    local default_log_dir
    local tmp_dir
    local tmp_file

    if [ -n "$LOG_FILE" ]; then
        return
    fi

    default_log_dir="/var/tmp"

    if [ ! -d "$default_log_dir" ] || [ ! -w "$default_log_dir" ]; then
        default_log_dir="/tmp"
    fi

    tmp_dir="${TMPDIR:-$default_log_dir}"
    tmp_dir="${tmp_dir%/}"
    tmp_file="$(mktemp "$tmp_dir/orbit-install.XXXXXX")"
    LOG_FILE="${tmp_file}.log"
    mv "$tmp_file" "$LOG_FILE"
}

render_plan() {
    printf '  ┌ Orbit install\n'
    printf '  │\n'
    printf '  ○  Validate installer input\n'
    printf '  │\n'
    printf '  ○  Install host prerequisites\n'
    printf '  │\n'
    printf '  ○  Install Orbit source\n'
    printf '  │\n'
    printf '  ○  Prepare gateway Docker images\n'
    printf '  │\n'
    printf '  ○  Bootstrap gateway state in the container\n'
    printf '  │\n'
    printf '  ○  Run migrations inside orbit-gateway\n'
    printf '  │\n'
    printf '  ○  Align Orbit host ownership\n'
    printf '  │\n'
    printf '  ○  Download and link Orbit CLI binary\n'
    printf '  │\n'
    printf '  ○  Write CLI config skeleton\n'
    printf '  │\n'
    printf '  ○  Ensure zsh shell integration\n'
    printf '  │\n'
    printf '  ○  Verify Orbit\n'
    printf '  │\n'
    printf '  └  Log: %s\n\n' "$LOG_FILE"
}

start_step() {
    CURRENT_STEP="$1"
    printf '  ◉  %s\n' "$CURRENT_STEP"
}

complete_step() {
    printf '  ●  %s\n' "$CURRENT_STEP"
    CURRENT_STEP=""
}

fail_step() {
    local status="$1"

    if [ -n "$CURRENT_STEP" ]; then
        printf '  ●  %s failed\n' "$CURRENT_STEP" >&2
    fi

    if [ -n "$LOG_FILE" ] && [ -f "$LOG_FILE" ]; then
        printf 'orbit-install: log %s\n' "$LOG_FILE" >&2
        tail -n 20 "$LOG_FILE" >&2 || true
    fi

    exit "$status"
}

finish_tree() {
    printf '\n  └  Orbit installed at %s\n' "$TARGET_DIR"
}

parse_args() {
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --path=*)
                TARGET_DIR="${1#*=}"
                ;;
            --repo=*)
                REPO_URL="${1#*=}"
                ;;
            --branch=*)
                BRANCH="${1#*=}"
                ;;
            --source-archive=*)
                SOURCE_ARCHIVE="${1#*=}"
                ;;
            --gateway-image=*)
                GATEWAY_IMAGE="${1#*=}"
                ;;
            --gateway-image-archive=*)
                GATEWAY_IMAGE_ARCHIVE="${1#*=}"
                ;;
            --caddy-image-archive=*)
                CADDY_IMAGE_ARCHIVE="${1#*=}"
                ;;
            --dnsmasq-image-archive=*)
                DNSMASQ_IMAGE_ARCHIVE="${1#*=}"
                ;;
            --frankenphp-image-archive=*)
                FRANKENPHP_IMAGE_ARCHIVE="${1#*=}"
                ;;
            --wg-easy-image-archive=*)
                WG_EASY_IMAGE_ARCHIVE="${1#*=}"
                ;;
            --bin=*)
                LINK_PATH="${1#*=}"
                ;;
            --skip-prerequisites)
                SKIP_PREREQUISITES=1
                ;;
            --no-sudo)
                USE_SUDO=0
                ;;
            --verbose)
                VERBOSE=1
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            *)
                fail validation_failed "unknown option: $1"
                ;;
        esac

        shift
    done
}

validate_args() {
    [ -n "$TARGET_DIR" ] || fail validation_failed "--path is required"
    [ -n "$LINK_PATH" ] || fail validation_failed "--bin is required"

    [ -n "$GATEWAY_IMAGE" ] || fail validation_failed "--gateway-image is required"

    if [ -n "$GATEWAY_IMAGE_ARCHIVE" ] && [ ! -f "$GATEWAY_IMAGE_ARCHIVE" ]; then
        fail validation_failed "gateway image archive not found: $GATEWAY_IMAGE_ARCHIVE"
    fi

    if [ -n "$CADDY_IMAGE_ARCHIVE" ] && [ ! -f "$CADDY_IMAGE_ARCHIVE" ]; then
        fail validation_failed "caddy image archive not found: $CADDY_IMAGE_ARCHIVE"
    fi

    if [ -n "$DNSMASQ_IMAGE_ARCHIVE" ] && [ ! -f "$DNSMASQ_IMAGE_ARCHIVE" ]; then
        fail validation_failed "dnsmasq image archive not found: $DNSMASQ_IMAGE_ARCHIVE"
    fi

    if [ -n "$FRANKENPHP_IMAGE_ARCHIVE" ] && [ ! -f "$FRANKENPHP_IMAGE_ARCHIVE" ]; then
        fail validation_failed "frankenphp image archive not found: $FRANKENPHP_IMAGE_ARCHIVE"
    fi

    if [ -n "$WG_EASY_IMAGE_ARCHIVE" ] && [ ! -f "$WG_EASY_IMAGE_ARCHIVE" ]; then
        fail validation_failed "wg-easy image archive not found: $WG_EASY_IMAGE_ARCHIVE"
    fi
}

install_ubuntu_prerequisites() {
    apt_get_update
    apt_get_install \
        ca-certificates \
        curl \
        git \
        gnupg \
        openssh-client \
        tar \
        unzip \
        wireguard \
        wireguard-tools

    install_docker_engine_ubuntu
}

install_docker_engine_ubuntu() {
    local needs_install=0
    if ! command -v docker >/dev/null 2>&1; then
        needs_install=1
    fi

    if [ "$needs_install" = "1" ]; then
        local keyring="/etc/apt/keyrings/docker.gpg"
        local codename
        codename="$(. /etc/os-release && printf '%s' "$VERSION_CODENAME")"

        sudo_run install -d -m 0755 /etc/apt/keyrings
        sudo_shell "curl -fsSL --retry 3 --retry-delay 2 https://download.docker.com/linux/ubuntu/gpg -o /tmp/docker.gpg.armor && gpg --batch --yes --dearmor -o ${keyring} /tmp/docker.gpg.armor && rm -f /tmp/docker.gpg.armor"
        sudo_run chmod 0644 "${keyring}"
        sudo_shell "printf 'deb [arch=%s signed-by=%s] https://download.docker.com/linux/ubuntu %s stable\n' \"\$(dpkg --print-architecture)\" \"${keyring}\" \"${codename}\" > /etc/apt/sources.list.d/docker.list"
        apt_get_update
        apt_get_install \
            docker-ce \
            docker-ce-cli \
            containerd.io \
            docker-buildx-plugin \
            docker-compose-plugin
        sudo_run systemctl enable --now docker
    fi

    grant_orbit_user_docker_access
}

grant_orbit_user_docker_access() {
    # Add the user that runs Orbit commands to the docker group so steady-state
    # use of `orbit` does not need sudo. The current shell will not gain the
    # new group membership in this session — install-orbit therefore continues
    # to invoke docker via sudo through `docker_cli` so the install path is
    # valid before group membership is picked up by a future login.
    local current_user
    current_user="$(id -un)"

    if [ "$current_user" = "root" ]; then
        return
    fi

    if ! getent group docker >/dev/null 2>&1; then
        # docker-ce should have created this group; in case it didn't (or
        # docker is supplied through an alternate mechanism), keep going so
        # later steps surface the real error.
        return
    fi

    if id -nG "$current_user" 2>/dev/null | tr ' ' '\n' | grep -qx docker; then
        return
    fi

    sudo_run usermod -aG docker "$current_user"
}

# Wrapper around `docker` that picks the right access path for install-time
# use. The orbit user is added to the docker group above, but that
# membership is not visible until the next login, so we transparently sudo
# during install. After install, the host launcher (`bin/orbit`) runs as the
# user's interactive session and uses the docker group directly.
docker_cli() {
    if [ "$(id -u)" -eq 0 ] || [ "$USE_SUDO" != "1" ]; then
        docker "$@"
        return
    fi

    sudo -n docker "$@"
}

brew_formula_installed() {
    brew --prefix "$1" >/dev/null 2>&1
}

install_macos_prerequisites() {
    require_command brew

    run brew update
    run brew install git
    require_command docker
}

install_prerequisites() {
    if [ "$SKIP_PREREQUISITES" = "1" ]; then
        return
    fi

    case "$(uname -s)" in
        Linux)
            if [ -r /etc/os-release ] && grep -q '^ID=ubuntu$' /etc/os-release; then
                install_ubuntu_prerequisites
                return
            fi

            fail node.unsupported_platform "only Ubuntu Linux is supported for Orbit host installation"
            ;;
        Darwin)
            install_macos_prerequisites
            ;;
        *)
            fail node.unsupported_platform "unsupported operating system: $(uname -s)"
            ;;
    esac
}

require_docker() {
    require_command docker

    if ! docker_cli info >/dev/null 2>&1; then
        fail validation_failed "Docker daemon is not reachable; start Docker before running install-orbit"
    fi
}

install_source() {
    if [ -n "$SOURCE_ARCHIVE" ]; then
        [ -f "$SOURCE_ARCHIVE" ] || fail validation_failed "source archive not found: $SOURCE_ARCHIVE"

        if [ -e "$TARGET_DIR" ] && [ ! -f "$TARGET_DIR/apps/gateway/artisan" ]; then
            fail validation_failed "$TARGET_DIR exists and does not look like an Orbit checkout"
        fi

        run mkdir -p "$TARGET_DIR"
        run tar --no-same-owner -xzf "$SOURCE_ARCHIVE" -C "$TARGET_DIR"

        return
    fi

    require_command git

    if [ -d "$TARGET_DIR/.git" ]; then
        run git -C "$TARGET_DIR" fetch --prune
        run git -C "$TARGET_DIR" checkout "$BRANCH"
        run git -C "$TARGET_DIR" pull --ff-only

        return
    fi

    if [ -e "$TARGET_DIR" ]; then
        fail validation_failed "$TARGET_DIR exists but is not a git checkout"
    fi

    run git clone --branch "$BRANCH" "$REPO_URL" "$TARGET_DIR"
}

build_gateway_images() {
    require_docker

    ensure_gateway_image
    ensure_caddy_image
    ensure_dnsmasq_image
    ensure_frankenphp_image
    ensure_wg_easy_image
}

ensure_gateway_image() {
    if docker_cli image inspect "$GATEWAY_IMAGE" >/dev/null 2>&1; then
        ensure_gateway_current_alias

        return
    fi

    if [ -n "$GATEWAY_IMAGE_ARCHIVE" ]; then
        run docker_cli load -i "$GATEWAY_IMAGE_ARCHIVE"

        if docker_cli image inspect "$GATEWAY_IMAGE" >/dev/null 2>&1; then
            ensure_gateway_current_alias

            return
        fi

        fail validation_failed "gateway image archive did not load $GATEWAY_IMAGE: $GATEWAY_IMAGE_ARCHIVE"
    fi

    case "$GATEWAY_IMAGE" in
        *@sha256:*|ghcr.io/*)
            pull_remote_gateway_image
            ;;
        *)
            run docker_cli build \
                -f "$TARGET_DIR/docker/orbit-gateway/Dockerfile" \
                -t "$GATEWAY_IMAGE" \
                "$TARGET_DIR"
            ;;
    esac
}

ensure_gateway_current_alias() {
    if [ -z "$GATEWAY_IMAGE_ARCHIVE" ] || [ "$GATEWAY_IMAGE" = "orbit-gateway:current" ]; then
        return
    fi

    run docker_cli tag "$GATEWAY_IMAGE" "orbit-gateway:current"
}

pull_remote_gateway_image() {
    run docker_cli pull "$GATEWAY_IMAGE"
}

ensure_caddy_image() {
    if docker_cli image inspect "caddy:2-alpine" >/dev/null 2>&1; then
        return
    fi

    if [ -n "$CADDY_IMAGE_ARCHIVE" ]; then
        run docker_cli load -i "$CADDY_IMAGE_ARCHIVE"

        if docker_cli image inspect "caddy:2-alpine" >/dev/null 2>&1; then
            return
        fi

        fail validation_failed "caddy image archive did not load caddy:2-alpine: $CADDY_IMAGE_ARCHIVE"
    fi

    run docker_cli pull "caddy:2-alpine"
}

ensure_dnsmasq_image() {
    if [ -z "$DNSMASQ_IMAGE_ARCHIVE" ]; then
        return
    fi

    if docker_cli image inspect "4km3/dnsmasq:latest" >/dev/null 2>&1; then
        return
    fi

    run docker_cli load -i "$DNSMASQ_IMAGE_ARCHIVE"

    if docker_cli image inspect "4km3/dnsmasq:latest" >/dev/null 2>&1; then
        return
    fi

    fail validation_failed "dnsmasq image archive did not load 4km3/dnsmasq:latest: $DNSMASQ_IMAGE_ARCHIVE"
}

ensure_frankenphp_image() {
    if docker_cli image inspect "ghcr.io/hardimpactdev/orbit-frankenphp:2-php8.5-bookworm" >/dev/null 2>&1; then
        return
    fi

    if [ -n "$FRANKENPHP_IMAGE_ARCHIVE" ]; then
        run docker_cli load -i "$FRANKENPHP_IMAGE_ARCHIVE"

        if docker_cli image inspect "ghcr.io/hardimpactdev/orbit-frankenphp:2-php8.5-bookworm" >/dev/null 2>&1; then
            return
        fi

        fail validation_failed "frankenphp image archive did not load ghcr.io/hardimpactdev/orbit-frankenphp:2-php8.5-bookworm: $FRANKENPHP_IMAGE_ARCHIVE"
    fi

    run docker_cli pull "ghcr.io/hardimpactdev/orbit-frankenphp:2-php8.5-bookworm"
}

ensure_wg_easy_image() {
    if docker_cli image inspect "ghcr.io/wg-easy/wg-easy:15" >/dev/null 2>&1; then
        return
    fi

    if [ -z "$WG_EASY_IMAGE_ARCHIVE" ]; then
        return
    fi

    run docker_cli load -i "$WG_EASY_IMAGE_ARCHIVE"

    if docker_cli image inspect "ghcr.io/wg-easy/wg-easy:15" >/dev/null 2>&1; then
        return
    fi

    fail validation_failed "wg-easy image archive did not load ghcr.io/wg-easy/wg-easy:15: $WG_EASY_IMAGE_ARCHIVE"
}

write_env_var() {
    local key="$1"
    local value="$2"
    local env_file="$GATEWAY_ENV_FILE"
    local tmp_file

    ensure_log_file

    # Pure-shell .env writer — no host PHP required. The CLI binary embeds its
    # own PHP; this installer must not depend on host PHP being present.
    {
        if [ -f "$env_file" ]; then
            chmod 0600 "$env_file"

            # Replace an existing KEY=... line or append a new one.
            tmp_file="${env_file}.tmp.$$"
            install -m 0600 /dev/null "$tmp_file"

            if grep -q "^${key}=" "$env_file" 2>/dev/null; then
                grep -v "^${key}=" "$env_file" > "$tmp_file"
            else
                cp "$env_file" "$tmp_file"
            fi

            printf '%s=%s\n' "$key" "$value" >> "$tmp_file"
            chmod 0600 "$tmp_file"
            mv "$tmp_file" "$env_file"
        else
            install -m 0600 /dev/null "$env_file"
            printf '%s=%s\n' "$key" "$value" >> "$env_file"
        fi
    } >>"$LOG_FILE" 2>&1
}

ensure_gateway_app_key() {
    local current_app_key
    local generated_key

    current_app_key="$(grep '^APP_KEY=' "$GATEWAY_ENV_FILE" 2>/dev/null | tail -n 1 | cut -d= -f2- || true)"

    if [ -n "$current_app_key" ]; then
        return
    fi

    generated_key="base64:$(head -c 32 /dev/urandom | base64 | tr -d '\n')"
    write_env_var "APP_KEY" "$generated_key"
}

ensure_forward_install_image_archives_flag() {
    if [ -z "$GATEWAY_IMAGE_ARCHIVE" ] && [ -z "$CADDY_IMAGE_ARCHIVE" ] && [ -z "$DNSMASQ_IMAGE_ARCHIVE" ] && [ -z "$FRANKENPHP_IMAGE_ARCHIVE" ] && [ -z "$WG_EASY_IMAGE_ARCHIVE" ]; then
        return
    fi

    write_env_var "ORBIT_FORWARD_INSTALL_IMAGE_ARCHIVES" "1"
    export ORBIT_FORWARD_INSTALL_IMAGE_ARCHIVES=1
}

clear_laravel_bootstrap_cache() {
    run rm -f \
        "$TARGET_DIR/apps/gateway/bootstrap/cache"/*.php
}

bootstrap_gateway_state() {
    require_docker

    run install -d -m 0700 "$CONFIG_ROOT" "$CONFIG_ROOT/certs"

    if [ ! -f "$GATEWAY_ENV_FILE" ]; then
        run install -m 0600 "$TARGET_DIR/apps/gateway/.env.example" "$GATEWAY_ENV_FILE"
    else
        run chmod 0600 "$GATEWAY_ENV_FILE"
    fi

    ensure_gateway_app_key
    write_env_var "DB_DATABASE" "$GATEWAY_DATABASE_FILE"
    write_env_var "SESSION_DRIVER" "file"

    if [ ! -f "$GATEWAY_DATABASE_FILE" ]; then
        run install -m 0600 /dev/null "$GATEWAY_DATABASE_FILE"
    else
        run chmod 0600 "$GATEWAY_DATABASE_FILE"
    fi

    ensure_forward_install_image_archives_flag
    clear_laravel_bootstrap_cache

    run docker_cli run --rm \
        --pull never \
        --env "ORBIT_CONFIG_ROOT=$CONFIG_ROOT" \
        --env "GATEWAY_ENV_FILE=$GATEWAY_ENV_FILE" \
        --mount "type=bind,source=$CONFIG_ROOT,target=$CONFIG_ROOT" \
        "$GATEWAY_IMAGE" \
        artisan --version
}

run_migrations_in_gateway_image() {
    require_docker

    run docker_cli run --rm \
        --pull never \
        --env "ORBIT_CONFIG_ROOT=$CONFIG_ROOT" \
        --mount "type=bind,source=$CONFIG_ROOT,target=$CONFIG_ROOT" \
        "$GATEWAY_IMAGE" \
        migrate --no-interaction --path=/srv/orbit/apps/gateway/database/migrations --realpath
}

# Detect the host OS and architecture and set ORBIT_CLI_OS_ARCH to the
# matching prebuilt binary asset name:
#   orbit-macos-arm64   (macOS Apple Silicon / arm64)
#   orbit-linux-x64     (Ubuntu Linux x86_64)
detect_cli_binary_asset() {
    local os arch

    os="$(uname -s)"
    arch="$(uname -m)"

    case "$os" in
        Darwin)
            case "$arch" in
                arm64)
                    ORBIT_CLI_OS_ARCH="orbit-macos-arm64"
                    ;;
                *)
                    fail node.unsupported_platform "unsupported macOS architecture for Orbit CLI binary: $arch (only arm64 is supported)"
                    ;;
            esac
            ;;
        Linux)
            case "$arch" in
                x86_64)
                    ORBIT_CLI_OS_ARCH="orbit-linux-x64"
                    ;;
                *)
                    fail node.unsupported_platform "unsupported Linux architecture for Orbit CLI binary: $arch (only x86_64 is supported)"
                    ;;
            esac
            ;;
        *)
            fail node.unsupported_platform "unsupported operating system for Orbit CLI binary: $os"
            ;;
    esac
}

# Download the prebuilt Orbit CLI binary for this host OS/arch and place it
# at $TARGET_DIR/bin/orbit-binary. When ORBIT_BINARY_URL is set, curl is used
# directly (for local file:// artifacts, CI mirrors, etc.). Otherwise the
# binary is fetched via authenticated `gh release download` so the private
# GitHub repository can be accessed using GH_TOKEN / GITHUB_TOKEN or the
# host `gh auth` login without any extra token wiring in this script.
download_cli_binary() {
    local binary_dest

    detect_cli_binary_asset

    binary_dest="$TARGET_DIR/bin/orbit-binary"

    run mkdir -p "$TARGET_DIR/bin"

    if [ -n "$ORBIT_BINARY_URL" ]; then
        printf 'orbit-install: downloading Orbit CLI binary from %s\n' "$ORBIT_BINARY_URL"
        run curl -fsSL --retry 3 --retry-delay 2 -o "$binary_dest" "$ORBIT_BINARY_URL"
    else
        require_command gh

        if [ -n "$ORBIT_RELEASE_TAG" ]; then
            printf 'orbit-install: downloading %s from %s release %s via gh\n' "$ORBIT_CLI_OS_ARCH" "$ORBIT_BINARY_REPO" "$ORBIT_RELEASE_TAG"
            run gh release download "$ORBIT_RELEASE_TAG" --repo "$ORBIT_BINARY_REPO" --pattern "$ORBIT_CLI_OS_ARCH" --output "$binary_dest" --clobber
        else
            printf 'orbit-install: downloading %s from %s release latest via gh\n' "$ORBIT_CLI_OS_ARCH" "$ORBIT_BINARY_REPO"
            run gh release download --repo "$ORBIT_BINARY_REPO" --pattern "$ORBIT_CLI_OS_ARCH" --output "$binary_dest" --clobber
        fi
    fi

    if [ ! -s "$binary_dest" ]; then
        fail validation_failed "downloaded Orbit CLI binary is empty: $binary_dest"
    fi

    run chmod 0755 "$binary_dest"
}

link_orbit() {
    local link_dir
    local link_target

    link_dir="$(dirname "$LINK_PATH")"
    link_target="$TARGET_DIR/bin/orbit-binary"

    if [ -e "$LINK_PATH" ] && [ ! -L "$LINK_PATH" ]; then
        fail validation_failed "$LINK_PATH exists and is not a symlink"
    fi

    if [ ! -f "$TARGET_DIR/bin/orbit-binary" ]; then
        fail validation_failed "Orbit CLI binary missing: $TARGET_DIR/bin/orbit-binary"
    fi

    if link_uses_shared_binary; then
        link_target="$(shared_orbit_binary_path)"
        sudo_run install -d -m 0755 "$(dirname "$link_target")"
        sudo_run install -m 0755 "$TARGET_DIR/bin/orbit-binary" "$link_target"
    fi

    if [ ! -d "$link_dir" ]; then
        run mkdir -p "$link_dir"
    fi

    if [ -w "$link_dir" ]; then
        run ln -sf "$link_target" "$LINK_PATH"
        return
    fi

    sudo_run ln -sf "$link_target" "$LINK_PATH"
}

link_uses_shared_binary() {
    case "$LINK_PATH" in
        /usr/local/bin/*)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

shared_orbit_binary_path() {
    local link_name

    if [ -n "$SHARED_BINARY_PATH" ]; then
        printf '%s\n' "$SHARED_BINARY_PATH"
        return
    fi

    link_name="$(basename "$LINK_PATH")"
    printf '/usr/local/lib/orbit/%s-binary\n' "$link_name"
}

# Write the per-operator-host CLI JSON config skeleton at ~/.config/orbit/config.json
# per decisions D8, D11, D13. The actual gateway entry is populated later by
# gateway:add / gateway:trust / node:new --template=gateway on the operator host. The skeleton
# only guarantees the file exists with correct ownership and permissions so the importer
# does not race with first-CLI-run.
#
# The gateway container self-trust store (LocalGatewaySettings in apps/gateway SQLite) is
# written separately by the gateway container during bootstrap per decision D17.
# These two writers are documented as the dual-writer contract; they describe overlapping
# state from different OS-user perspectives.
write_cli_config_skeleton() {
    local target_home
    local config_parent
    local config_dir
    local config_file
    local tmp_file
    local owner
    local group

    target_home="${ORBIT_CONFIG_HOME:-$HOME}"

    if [ -z "$target_home" ]; then
        # No HOME — skip silently; first CLI run will write the skeleton itself.
        return 0
    fi

    owner="$(id -un)"
    group="$(id -gn)"
    config_parent="${target_home}/.config"
    config_dir="${target_home}/.config/orbit"
    config_file="${config_dir}/config.json"

    sudo_run install -d -m 0755 -o "$owner" -g "$group" "$config_parent"
    sudo_run install -d -m 0700 -o "$owner" -g "$group" "$config_dir"

    if [ -e "$config_file" ]; then
        # Idempotent: never overwrite an existing config (D11 importer contract).
        sudo_run chown "$owner:$group" "$config_file"
        sudo_run chmod 0600 "$config_file"

        return 0
    fi

    tmp_file="$(mktemp "${TMPDIR:-/tmp}/orbit-cli-config.XXXXXX")"

    cat > "$tmp_file" <<'JSON'
{
    "schema_version": 1,
    "active_gateway": null,
    "gateways": {},
    "defaults": {"node": null, "profile": null},
    "meta": {"imported_from": null, "imported_at": null}
}
JSON
    sudo_run install -m 0600 -o "$owner" -g "$group" "$tmp_file" "$config_file"
    run rm -f "$tmp_file"
}

write_install_metadata() {
    local target_home
    local metadata_file
    local metadata_dir
    local tmp_file
    local owner
    local group
    local version
    local installed_at

    target_home="${ORBIT_CONFIG_HOME:-$HOME}"
    metadata_file="${ORBIT_INSTALL_METADATA_PATH:-}"

    if [ -z "$metadata_file" ]; then
        if [ -z "$target_home" ]; then
            # No HOME — skip silently; the CLI will fall back to binary mtime.
            return 0
        fi

        metadata_file="${target_home}/.config/orbit/install.json"
    fi

    owner="$(id -un)"
    group="$(id -gn)"
    metadata_dir="$(dirname "$metadata_file")"

    version="$("$LINK_PATH" --version 2>/dev/null | sed -nE 's/.*([0-9]+\.[0-9]+\.[0-9]+([-+][A-Za-z0-9.-]+)?).*/\1/p' | head -n 1 || true)"

    if [ -z "$version" ]; then
        version="0.0.0"
    fi

    installed_at="$(date -u '+%Y-%m-%dT%H:%M:%S+00:00')"
    tmp_file="$(mktemp "${TMPDIR:-/tmp}/orbit-install-metadata.XXXXXX")"

    cat > "$tmp_file" <<JSON
{
    "schema_version": 1,
    "version": "$(json_escape "$version")",
    "installed_at": "$(json_escape "$installed_at")",
    "binary_path": "$(json_escape "$LINK_PATH")",
    "install_root": "$(json_escape "$TARGET_DIR")"
}
JSON

    sudo_run install -d -m 0700 -o "$owner" -g "$group" "$metadata_dir"
    sudo_run install -m 0600 -o "$owner" -g "$group" "$tmp_file" "$metadata_file"
    run rm -f "$tmp_file"
}

verify_install() {
    if [ ! -x "$TARGET_DIR/bin/orbit-binary" ]; then
        fail validation_failed "Orbit CLI binary is not executable: $TARGET_DIR/bin/orbit-binary"
    fi

    # Confirm the linked binary runs. The binary embeds its own PHP so no
    # host PHP is required for this check.
    if ! "$LINK_PATH" --version >/dev/null 2>&1; then
        fail validation_failed "Orbit CLI binary did not respond to --version: $LINK_PATH"
    fi

    if ! docker_cli image inspect "$GATEWAY_IMAGE" >/dev/null 2>&1; then
        fail validation_failed "gateway image is not available after install: $GATEWAY_IMAGE"
    fi
}

# Ensure the supported zsh integration for unquoted Orbit namespace wildcards
# such as process:*. Only runs when the active login shell is zsh so bash-only
# hosts do not receive a new ~/.zshrc. The Orbit-owned snippet may be rewritten
# on upgrade; ~/.zshrc is append-only for the managed source block so symlink
# targets and existing modes stay intact. Failure is not silent.
ensure_zsh_shell_integration() {
    local target_home
    local shell_name
    local snippet_dir
    local snippet_path
    local zshrc_path
    local begin_marker
    local end_marker
    local block
    local tmp_file

    shell_name="$(basename "${SHELL:-}")"
    case "$shell_name" in
        zsh) ;;
        *)
            printf 'orbit-install: skipping zsh shell integration (SHELL=%s)\n' "${SHELL:-unset}"
            return 0
            ;;
    esac

    target_home="${ORBIT_CONFIG_HOME:-$HOME}"

    if [ -z "$target_home" ]; then
        fail validation_failed "Failed to ensure zsh shell integration: HOME is not set."
    fi

    # Root-safe join: HOME=/ must yield /.config/... not //.config/... (match PHP).
    if [ "$target_home" = "/" ]; then
        snippet_dir="/.config/orbit/shell"
    else
        snippet_dir="${target_home%/}/.config/orbit/shell"
    fi
    snippet_path="${snippet_dir}/zsh-noglob.zsh"
    # zsh loads $ZDOTDIR/.zshrc when ZDOTDIR is a non-empty export; otherwise
    # $HOME/.zshrc. The Orbit-owned snippet still lives under config home.
    if [ -n "${ZDOTDIR:-}" ]; then
        if [ "$ZDOTDIR" = "/" ]; then
            zshrc_path="/.zshrc"
        else
            zshrc_path="${ZDOTDIR%/}/.zshrc"
        fi
    elif [ "$target_home" = "/" ]; then
        zshrc_path="/.zshrc"
    else
        zshrc_path="${target_home%/}/.zshrc"
    fi
    begin_marker='# >>> orbit zsh integration >>>'
    end_marker='# <<< orbit zsh integration <<<'
    source_line="[ -f $(printf '%q' "$snippet_path") ] && . $(printf '%q' "$snippet_path")"

    zshrc_dir="$(dirname "$zshrc_path")"
    if [ -n "$zshrc_dir" ] && [ "$zshrc_dir" != "." ] && [ ! -d "$zshrc_dir" ]; then
        run mkdir -p "$zshrc_dir"
    fi

    run mkdir -p "$snippet_dir"
    run chmod 0700 "$snippet_dir"

    # Atomic same-directory replacement: never redirect writes onto the final
    # snippet path (that follows a hostile or stale symlink and can truncate its
    # target) and never treat install-as-copy as atomic. Stage beside the final
    # path so `mv -f` replaces the destination path itself on the same filesystem.
    tmp_file="$(mktemp "${snippet_dir}/.zsh-noglob.XXXXXX")"
    cat > "$tmp_file" <<'ZSH'
# Orbit-managed zsh integration.
# Preserve literal argv for Orbit namespace wildcards such as process:* and
# node:* when operators type unquoted flags. Applies only to the orbit command
# via noglob; does not set NONOMATCH or change globbing for other commands.
alias orbit='noglob orbit'
ZSH

    if [ ! -s "$tmp_file" ]; then
        run rm -f "$tmp_file"
        fail validation_failed "Failed to ensure zsh shell integration: could not stage ${snippet_path}."
    fi

    if ! run chmod 0600 "$tmp_file"; then
        run rm -f "$tmp_file"
        fail validation_failed "Failed to ensure zsh shell integration: could not chmod staged ${snippet_path}."
    fi

    if ! run mv -f "$tmp_file" "$snippet_path"; then
        run rm -f "$tmp_file"
        fail validation_failed "Failed to ensure zsh shell integration: could not replace ${snippet_path}."
    fi

    if [ ! -s "$snippet_path" ] || [ -L "$snippet_path" ]; then
        fail validation_failed "Failed to ensure zsh shell integration: snippet is missing or still a symlink: ${snippet_path}."
    fi

    block="${begin_marker}
${source_line}
${end_marker}
"

    if [ -e "$zshrc_path" ] || [ -L "$zshrc_path" ]; then
        # Exact adjacent canonical block only (BEGIN\nsource\nEND). Lines in any
        # other order do not count. Partial/orphan markers are left untouched;
        # append one complete block only when the exact block is absent.
        # Use ENVIRON (not -v) so source lines with spaces/quotes match safely.
        # Do not `exit 0` mid-script without a found flag — END still runs.
        if ORBIT_ZSH_BEGIN="$begin_marker" ORBIT_ZSH_END="$end_marker" ORBIT_ZSH_SRC="$source_line" awk '
            BEGIN {
                begin = ENVIRON["ORBIT_ZSH_BEGIN"]
                end = ENVIRON["ORBIT_ZSH_END"]
                src = ENVIRON["ORBIT_ZSH_SRC"]
            }
            $0 == begin { b = 1; next }
            b == 1 {
                if ($0 == src) {
                    b = 2
                    next
                }
                b = 0
            }
            b == 2 {
                if ($0 == end) {
                    found = 1
                    exit
                }
                b = 0
            }
            END { exit found ? 0 : 1 }
        ' "$zshrc_path"; then
            printf 'orbit-install: zsh shell integration already present in %s\n' "$zshrc_path"
            return 0
        fi

        # Append-only: never rewrite/truncate the rc (preserves symlink target/mode
        # and leaves partial/orphan text and user content untouched).
        if [ -s "$zshrc_path" ] && [ "$(tail -c 1 "$zshrc_path" | wc -l | tr -d ' ')" = "0" ]; then
            printf '\n' >>"$zshrc_path" || fail validation_failed "Failed to ensure zsh shell integration: could not append to ${zshrc_path}."
        fi

        printf '%s' "$block" >>"$zshrc_path" || fail validation_failed "Failed to ensure zsh shell integration: could not append to ${zshrc_path}."
        return 0
    fi

    printf '%s' "$block" >"$zshrc_path" || fail validation_failed "Failed to ensure zsh shell integration: could not write ${zshrc_path}."
}

finalize_target_ownership() {
    local parent
    local parent_owner

    parent="$(dirname "$TARGET_DIR")"

    case "$(uname -s)" in
        Linux)
            parent_owner="$(stat -c '%U:%G' "$parent" 2>/dev/null || true)"
            ;;
        Darwin)
            parent_owner="$(stat -f '%Su:%Sg' "$parent" 2>/dev/null || true)"
            ;;
        *)
            return
            ;;
    esac

    if [ -z "$parent_owner" ] || [ "${parent_owner%:*}" = "$(id -un)" ]; then
        return
    fi

    sudo_run chown -R "$parent_owner" "$TARGET_DIR"
}

finalize_config_root_ownership() {
    local owner
    local group

    if [ ! -d "$CONFIG_ROOT" ]; then
        return
    fi

    owner="$(id -un)"
    group="$(id -gn)"

    sudo_run chown -R "$owner:$group" "$CONFIG_ROOT"
    sudo_run chmod 0700 "$CONFIG_ROOT"
}

main() {
    parse_args "$@"

    ensure_log_file
    trap 'fail_step "$?"' ERR

    render_plan

    start_step "Validate installer input"
    validate_args
    complete_step

    start_step "Install host prerequisites"
    install_prerequisites
    complete_step

    start_step "Install Orbit source"
    install_source
    complete_step

    start_step "Prepare gateway Docker images"
    build_gateway_images
    complete_step

    start_step "Bootstrap gateway state in the container"
    bootstrap_gateway_state
    complete_step

    start_step "Run migrations inside orbit-gateway"
    run_migrations_in_gateway_image
    complete_step

    start_step "Align Orbit host ownership"
    finalize_target_ownership
    finalize_config_root_ownership
    complete_step

    start_step "Download and link Orbit CLI binary"
    download_cli_binary
    link_orbit
    complete_step

    start_step "Write CLI config skeleton"
    write_cli_config_skeleton
    complete_step

    start_step "Ensure zsh shell integration"
    ensure_zsh_shell_integration
    complete_step

    start_step "Verify Orbit"
    verify_install
    complete_step

    start_step "Write CLI install metadata"
    write_install_metadata
    complete_step

    finish_tree
}

if [ "${BASH_SOURCE[0]:-$0}" = "$0" ]; then
    main "$@"
fi
