# Copy to .env.e2e for local E2E settings. Composer E2E scripts source this
# file before setting their lane-specific defaults.
#
# Do not point E2E at standing live nodes.

ORBIT_E2E_DOCKER_TEST_RUNNERS=sidecar1:4:28,sidecar2:4:28
ORBIT_E2E_DOCKER_IMAGE_BUILD_HOSTS=beast
# Optional path on the Docker image build host. When set, topology bakes bind
# this Composer cache into transient runtime containers instead of starting from
# an empty named volume.
# ORBIT_E2E_DOCKER_COMPOSER_CACHE=/home/nckrtl/.cache/composer
# ORBIT_E2E_DOCKER_COMPOSER_CACHE_READ_ONLY=1

ORBIT_E2E_INCUS_IMAGE_BUILD_HOST=beast
ORBIT_E2E_INCUS_HOSTS=beast
# Provisioning lease pool only. Prepared-topology feature worker count is
# requested through ORBIT_E2E_INCUS_PARALLEL_PROCESSES; VM capacity is leased
# per topology through ORBIT_E2E_INCUS_HOST_VM_CAPS.
ORBIT_E2E_INCUS_HOST_SLOTS=beast:1
ORBIT_E2E_INCUS_STORAGE_POOL=orbit-e2e
ORBIT_E2E_INCUS_HOST_VM_CAPS=beast:16
ORBIT_E2E_INCUS_PARALLEL_PROCESSES=4
# Optional warm stateful snapshots for Incus feature tests. Build them with
# composer e2e:prepare-warm-topology -- --force <topology>.
# ORBIT_E2E_INCUS_WARM_SNAPSHOTS=1
# ORBIT_E2E_INCUS_WARM_SNAPSHOT_SLOTS=1
ORBIT_E2E_TOPOLOGY_CPUS=1
ORBIT_E2E_TOPOLOGY_ROOT_SIZE=16GiB

ORBIT_E2E_EXCLUSIVE_HOSTS=beast

ORBIT_E2E_SLOT_WAIT_SECONDS=900
ORBIT_E2E_SLOT_STALE_SECONDS=7200
