#!/usr/bin/env bash

set -Eeuo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
repo_root="${ORBIT_RELEASE_CANDIDATE_ROOT:-$(cd "${script_dir}/.." >/dev/null 2>&1 && pwd)}"
state_root="${repo_root}/.orbit/release-candidates"
latest_pointer="${state_root}/latest"

work_dir=""
ghcr_docker_config=""

cleanup() {
    if [ -n "$work_dir" ] && [ -d "$work_dir" ]; then
        rm -rf "$work_dir"
    fi

    if [ -n "$ghcr_docker_config" ] && [ -d "$ghcr_docker_config" ]; then
        rm -rf "$ghcr_docker_config"
    fi
}
trap cleanup EXIT

usage() {
    cat <<'EOF'
Usage:
  bin/orbit-release-candidate build [--native-assets=<dir>]
  bin/orbit-release-candidate verify-native --native-assets=<dir> [--commit=<sha>] [--version=<version>]
  bin/orbit-release-candidate env [--build-id=<id>]
  bin/orbit-release-candidate promote-runtime --build-id=<accepted-id> --accepted
  bin/orbit-release-candidate verify [--build-id=<id>] [--release-image=<ref>]

Formalizes the release-candidate publication flow from step 7 of
.agents/skills/release/SKILL.md.

  build   Preflight (VERSION, HEAD == origin/main), build CLI binaries and the
          candidate gateway image and Orbit Agent binaries, push to GHCR, generate the candidate
          manifest, upload artifacts plus the channel manifest through the
          gateway orbit-artifacts disk, then record durable state under
          .orbit/release-candidates/<build_id>/ (candidate.env includes
          sha256_linux_amd64, sha256_darwin_arm64, and
          sha256_agent_linux_amd64/sha256_agent_darwin_arm64) and update the
          .orbit/release-candidates/latest pointer file. With --native-assets,
          import a verified Darwin ARM64 Agent bundle instead of building it.
  verify-native
          Verify a transferred native Agent bundle without building, pushing,
          uploading, or mutating candidate state.
  env     Print eval-able `export key=value` lines from the recorded
          candidate.env of the latest (or --build-id) candidate.
  promote-runtime
          After live candidate acceptance, promote the recorded FrankenPHP
          digest to its stable runtime-family tag and verify exact digest
          equality. This does not create a GitHub release.
  verify  Recompute sha256 hashes of the stored CLI and Agent artifacts against
          candidate.env, and with --release-image compare the image digest
          from `docker buildx imagetools inspect` against gateway_digest.

This helper never creates GitHub releases or pushes Git tags. `build` ends at
candidate channel publication. Runtime-family promotion is a separate,
acceptance-gated action; GitHub promotion stays human-approved in the release
skill.
EOF
}

fail() {
    printf 'orbit-release-candidate: %s\n' "$*" >&2
    exit 1
}

compute_sha256() {
    local file="$1"

    if command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$file" | awk '{ print $1 }'
    elif command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$file" | awk '{ print $1 }'
    else
        openssl dgst -sha256 -r "$file" | awk '{ print $1 }'
    fi
}

state_value() {
    local key="$1"
    local file="$2"

    awk -F= -v key="$key" '$1 == key { print substr($0, length(key) + 2); exit }' "$file"
}

native_value() {
    local key="$1"
    local manifest="$2"

    awk -F= -v key="$key" '$1 == key { print substr($0, length(key) + 2); exit }' "$manifest"
}

verify_native_assets() {
    local dir="$1"
    local expected_commit="$2"
    local expected_version="$3"
    local manifest="${dir}/native-assets.env"
    local artifact="${dir}/orbit-agent-macos-arm64"

    [ -d "$dir" ] && [ ! -L "$dir" ] || fail 'native assets path must be a directory, not a symlink.'
    [ -f "$manifest" ] && [ ! -L "$manifest" ] || fail 'native-assets.env is missing or unsafe.'
    [ -f "$artifact" ] && [ ! -L "$artifact" ] || fail 'orbit-agent-macos-arm64 is missing or unsafe.'

    local inventory
    inventory="$(find "$dir" -mindepth 1 -maxdepth 1 -exec basename {} \; | LC_ALL=C sort)"
    [ "$inventory" = $'native-assets.env\norbit-agent-macos-arm64' ] \
        || fail 'native assets directory contains missing or undeclared files.'

    local manifest_keys
    manifest_keys="$(awk -F= 'NF >= 2 { print $1 }' "$manifest" | LC_ALL=C sort)"
    [ "$manifest_keys" = $'builder_arch\nbuilder_os\ncommit\nschema\nsha256_agent_darwin_arm64\nversion' ] \
        || fail 'native manifest contains missing, duplicate, or undeclared keys.'

    [ "$(native_value schema "$manifest")" = '1' ] || fail 'native manifest schema is invalid.'
    [ "$(native_value commit "$manifest")" = "$expected_commit" ] || fail 'native source commit does not match.'
    [ "$(native_value version "$manifest")" = "$expected_version" ] || fail 'native source version does not match.'
    [ "$(native_value builder_os "$manifest")" = 'Darwin' ] || fail 'native builder_os must be Darwin.'
    [ "$(native_value builder_arch "$manifest")" = 'arm64' ] || fail 'native builder_arch must be arm64.'

    local expected_sha actual_sha
    expected_sha="$(native_value sha256_agent_darwin_arm64 "$manifest")"
    [[ "$expected_sha" =~ ^[0-9a-f]{64}$ ]] || fail 'native Agent SHA-256 is invalid.'
    actual_sha="$(compute_sha256 "$artifact")"
    [ "$actual_sha" = "$expected_sha" ] || fail 'sha256_agent_darwin_arm64 does not match.'
    file "$artifact" | grep -Eq 'Mach-O 64-bit executable arm64' \
        || fail 'native Agent artifact is not a Mach-O arm64 executable.'

    printf '%s\n' "$actual_sha"
}

resolve_state_dir() {
    local build_id="$1"

    if [ -z "$build_id" ]; then
        if [ ! -f "$latest_pointer" ]; then
            fail "No release candidate state found: missing ${latest_pointer}. Run \`bin/orbit-release-candidate build\` first."
        fi

        build_id="$(tr -d '[:space:]' < "$latest_pointer")"

        if [ -z "$build_id" ]; then
            fail "No release candidate state found: ${latest_pointer} is empty."
        fi
    fi

    local build_id_pattern='^[0-9]{8}T[0-9]{6}Z-[0-9a-f]+$'

    if ! [[ "$build_id" =~ $build_id_pattern ]]; then
        fail "invalid build id [${build_id}]: expected the pattern ${build_id_pattern}."
    fi

    local dir="${state_root}/${build_id}"

    if [ ! -f "${dir}/candidate.env" ]; then
        fail "No release candidate state found for build id ${build_id}: missing ${dir}/candidate.env."
    fi

    printf '%s\n' "$dir"
}

cmd_build() {
    local native_assets_dir=''
    local argument

    for argument in "$@"; do
        case "$argument" in
            --native-assets=*)
                native_assets_dir="${argument#--native-assets=}"
                ;;
            *)
                fail "unknown build option: ${argument}. Usage: bin/orbit-release-candidate build [--native-assets=<dir>]"
                ;;
        esac
    done

    if [ -n "$native_assets_dir" ]; then
        case "$native_assets_dir" in
            /*) ;;
            *) native_assets_dir="${repo_root}/${native_assets_dir}" ;;
        esac
        native_assets_dir="${native_assets_dir%/}"
    fi

    cd "$repo_root"

    local version source_commit origin_main_commit
    version="$("${repo_root}/bin/orbit-version")"
    source_commit="$(git rev-parse HEAD)"
    origin_main_commit="$(git ls-remote origin refs/heads/main | awk '{ print $1 }')"

    if [ "$source_commit" != "$origin_main_commit" ]; then
        echo "Candidate artifacts must be built from the pushed origin/main commit." >&2
        exit 1
    fi

    local tracked_tree_status
    tracked_tree_status="$(git status --porcelain)"

    if [ -n "$tracked_tree_status" ]; then
        echo "Candidate artifacts must be built from a clean checkout of the pushed origin/main commit; commit or stash these changes first:" >&2
        printf '%s\n' "$tracked_tree_status" >&2
        exit 1
    fi

    local build_id candidate_tag candidate_image candidate_reverb_image candidate_frankenphp_image stable_frankenphp_image candidate_prefix candidate_channel
    build_id="$(date -u +%Y%m%dT%H%M%SZ)-$(git rev-parse --short HEAD)"
    candidate_tag="${version}-candidate-${build_id}"
    candidate_image="ghcr.io/hardimpactdev/orbit-gateway:${candidate_tag}"
    candidate_reverb_image="ghcr.io/hardimpactdev/orbit-reverb:${candidate_tag}"
    stable_frankenphp_image="ghcr.io/hardimpactdev/orbit-frankenphp:2-php8.5-bookworm"
    candidate_frankenphp_image="${stable_frankenphp_image}-candidate-${build_id}"
    candidate_prefix="candidates/${build_id}"
    candidate_channel="${ORBIT_RELEASE_CANDIDATE_CHANNEL:-live-test}"

    work_dir="$(mktemp -d)"

    # Prepared worktrees symlink the primary checkout's root .env. Source that
    # local release env into this shell before Laravel reads apps/gateway
    # config. The env must include ORBIT_ARTIFACTS_BASE_URL and either
    # ORBIT_ARTIFACTS_* keys or the S3_UPCLOUD_* fallback keys.
    local primary_checkout primary_env
    primary_checkout="${ORBIT_PRIMARY_CHECKOUT:-${HOME}/orbit}"
    primary_env="${ORBIT_RELEASE_ENV_FILE:-}"

    if [ -z "$primary_env" ]; then
        if [ -f ".env" ]; then
            primary_env=".env"
        else
            primary_env="${primary_checkout}/.env"
        fi
    fi

    if [ -f "$primary_env" ]; then
        set -a
        # shellcheck disable=SC1090
        source "$primary_env"
        set +a
    fi

    local artifact_base_url
    artifact_base_url="$("${repo_root}/bin/orbit-gateway-artisan" tinker --execute='echo rtrim((string) config("orbit.artifacts.base_url"), "/");')"

    if [ -z "$artifact_base_url" ]; then
        echo "ORBIT_ARTIFACTS_BASE_URL is required for candidate artifact publishing." >&2
        exit 1
    fi

    local artifact_disk_ready
    artifact_disk_ready="$("${repo_root}/bin/orbit-gateway-artisan" tinker --execute='echo collect([
    config("filesystems.disks.orbit-artifacts.key"),
    config("filesystems.disks.orbit-artifacts.secret"),
    config("filesystems.disks.orbit-artifacts.bucket"),
    config("filesystems.disks.orbit-artifacts.endpoint"),
])->every(fn ($value) => filled($value)) ? "yes" : "no";')"

    if [ "$artifact_disk_ready" != "yes" ]; then
        echo "orbit-artifacts disk config is incomplete; check ORBIT_ARTIFACTS_* or S3_UPCLOUD_* env values." >&2
        exit 1
    fi

    local candidate_asset_base_url="${artifact_base_url}/${candidate_prefix}"

    "${repo_root}/bin/orbit-build-cli-binary" mac arm "$version"
    "${repo_root}/bin/orbit-build-cli-binary" linux x64 "$version"
    "${repo_root}/bin/orbit-build-agent-binary" linux x64

    cp apps/cli/builds/dist/linux/linux-x64 "${work_dir}/orbit-linux-x64"
    cp apps/cli/builds/dist/mac/mac-arm "${work_dir}/orbit-macos-arm64"
    cp apps/agent/builds/dist/linux/linux-x64 "${work_dir}/orbit-agent-linux-x64"

    local imported_agent_sha='' native_builder_os='' native_builder_arch='' native_source_commit=''
    if [ -n "$native_assets_dir" ]; then
        imported_agent_sha="$(verify_native_assets "$native_assets_dir" "$source_commit" "$version")"
        cp "${native_assets_dir}/orbit-agent-macos-arm64" "${work_dir}/orbit-agent-macos-arm64"
        native_builder_os="$(native_value builder_os "${native_assets_dir}/native-assets.env")"
        native_builder_arch="$(native_value builder_arch "${native_assets_dir}/native-assets.env")"
        native_source_commit="$(native_value commit "${native_assets_dir}/native-assets.env")"
    else
        "${repo_root}/bin/orbit-build-agent-binary" mac arm
        cp apps/agent/builds/dist/mac/mac-arm "${work_dir}/orbit-agent-macos-arm64"
        imported_agent_sha=''
    fi

    docker buildx build \
        --platform linux/amd64 \
        -f docker/orbit-gateway/Dockerfile \
        --tag "$candidate_image" \
        --load \
        .

    docker buildx build \
        --platform linux/amd64 \
        -f docker/orbit-reverb/Dockerfile \
        --tag "$candidate_reverb_image" \
        --load \
        .

    docker buildx build \
        --platform linux/amd64 \
        -f docker/orbit-frankenphp/Dockerfile \
        --tag "$candidate_frankenphp_image" \
        --load \
        .

    gh auth status -h github.com

    # Helper-free GHCR auth (release skill Failure Handling): write a minimal
    # Docker config so no credential helper runs. The token is never echoed,
    # teed, or written outside the throwaway config directory.
    ghcr_docker_config="$(mktemp -d)"
    local ghcr_user ghcr_auth active_docker_host
    ghcr_user="$(gh api user -q .login)"
    ghcr_auth="$(printf '%s:%s' "$ghcr_user" "$(gh auth token)" | base64 | tr -d '\n')"
    (umask 077 && printf '{"auths":{"ghcr.io":{"auth":"%s"}}}\n' "$ghcr_auth" > "${ghcr_docker_config}/config.json")
    unset ghcr_auth

    active_docker_host="${DOCKER_HOST:-}"

    if [ -z "$active_docker_host" ]; then
        active_docker_host="$(docker context inspect "$(docker context show)" --format '{{ (index .Endpoints "docker").Host }}' 2>/dev/null || true)"
    fi

    if [ -n "$active_docker_host" ]; then
        DOCKER_CONFIG="$ghcr_docker_config" DOCKER_HOST="$active_docker_host" docker push "$candidate_image" > "${work_dir}/gateway-image-push.log" 2>&1
        DOCKER_CONFIG="$ghcr_docker_config" DOCKER_HOST="$active_docker_host" docker push "$candidate_reverb_image" > "${work_dir}/reverb-image-push.log" 2>&1
        DOCKER_CONFIG="$ghcr_docker_config" DOCKER_HOST="$active_docker_host" docker push "$candidate_frankenphp_image" > "${work_dir}/frankenphp-image-push.log" 2>&1
    else
        DOCKER_CONFIG="$ghcr_docker_config" docker push "$candidate_image" > "${work_dir}/gateway-image-push.log" 2>&1
        DOCKER_CONFIG="$ghcr_docker_config" docker push "$candidate_reverb_image" > "${work_dir}/reverb-image-push.log" 2>&1
        DOCKER_CONFIG="$ghcr_docker_config" docker push "$candidate_frankenphp_image" > "${work_dir}/frankenphp-image-push.log" 2>&1
    fi

    rm -rf "$ghcr_docker_config"
    ghcr_docker_config=""

    local gateway_digest reverb_digest frankenphp_digest
    gateway_digest="$(awk '/digest: sha256:/ { print $3 }' "${work_dir}/gateway-image-push.log" | tail -1)"
    reverb_digest="$(awk '/digest: sha256:/ { print $3 }' "${work_dir}/reverb-image-push.log" | tail -1)"
    frankenphp_digest="$(awk '/digest: sha256:/ { print $3 }' "${work_dir}/frankenphp-image-push.log" | tail -1)"

    if [ -z "$gateway_digest" ]; then
        echo "Failed to capture the pushed gateway image digest." >&2
        exit 1
    fi

    if [ -z "$reverb_digest" ]; then
        echo "Failed to capture the pushed Reverb image digest." >&2
        exit 1
    fi

    if [ -z "$frankenphp_digest" ]; then
        echo "Failed to capture the pushed FrankenPHP image digest." >&2
        exit 1
    fi

    docker save "$candidate_reverb_image" -o "${work_dir}/orbit-reverb-linux-amd64.tar"
    docker save "$candidate_frankenphp_image" -o "${work_dir}/orbit-frankenphp-linux-amd64.tar"

    "${repo_root}/bin/orbit-release-manifest" \
        --version="$version" \
        --source=topology-candidate \
        --build-id="$build_id" \
        --asset-base-url="$candidate_asset_base_url" \
        --gateway-image="$candidate_image" \
        --gateway-digest="$gateway_digest" \
        --cli-artifact="linux-amd64=orbit-linux-x64=${work_dir}/orbit-linux-x64" \
        --cli-artifact="darwin-arm64=orbit-macos-arm64=${work_dir}/orbit-macos-arm64" \
        --agent-artifact="linux-amd64=orbit-agent-linux-x64=${work_dir}/orbit-agent-linux-x64" \
        --agent-artifact="darwin-arm64=orbit-agent-macos-arm64=${work_dir}/orbit-agent-macos-arm64" \
        --role-image="orbit-caddy=caddy:2-alpine" \
        --role-image="orbit-frankenphp=${candidate_frankenphp_image}@${frankenphp_digest}" \
        --role-image="orbit-websocket=${candidate_reverb_image}@${reverb_digest}" \
        --role-image-artifact="orbit-frankenphp=orbit-frankenphp-linux-amd64.tar=${work_dir}/orbit-frankenphp-linux-amd64.tar" \
        --role-image-artifact="orbit-websocket=orbit-reverb-linux-amd64.tar=${work_dir}/orbit-reverb-linux-amd64.tar" \
        --output="${work_dir}/orbit-release-manifest.candidate.json"

    ORBIT_CANDIDATE_PREFIX="$candidate_prefix" \
    ORBIT_CANDIDATE_DIR="$work_dir" \
    ORBIT_CANDIDATE_CHANNEL="$candidate_channel" \
        "${repo_root}/bin/orbit-gateway-artisan" tinker --execute='
            $diskConfig = config("filesystems.disks.".config("orbit.artifacts.disk"));
            $prefix = trim((string) getenv("ORBIT_CANDIDATE_PREFIX"), "/");
            $dir = rtrim((string) getenv("ORBIT_CANDIDATE_DIR"), "/");
            $channel = trim((string) getenv("ORBIT_CANDIDATE_CHANNEL"), "/");
            $s3Config = [
                "version" => "latest",
                "region" => $diskConfig["region"],
                "use_path_style_endpoint" => (bool) ($diskConfig["use_path_style_endpoint"] ?? false),
                "credentials" => [
                    "key" => $diskConfig["key"],
                    "secret" => $diskConfig["secret"],
                ],
            ];

            if (filled($diskConfig["endpoint"] ?? null)) {
                $s3Config["endpoint"] = $diskConfig["endpoint"];
            }

            $client = new Aws\S3\S3Client($s3Config);
            $bucket = $diskConfig["bucket"];
            $acl = ($diskConfig["visibility"] ?? "private") === "public" ? "public-read" : "private";

            $upload = function (string $target, string $source) use ($client, $bucket, $acl): void {
                $stream = fopen($source, "rb");

                if ($stream === false) {
                    throw new RuntimeException("Unable to open candidate artifact [{$source}] for upload.");
                }

                try {
                    $client->putObject([
                        "Bucket" => $bucket,
                        "Key" => $target,
                        "ACL" => $acl,
                        "Body" => $stream,
                    ]);
                } finally {
                    if (is_resource($stream)) {
                        fclose($stream);
                    }
                }
            };

            $retryingUpload = function (string $target, string $source) use ($upload): void {
                $lastThrowable = null;

                for ($attempt = 1; $attempt <= 5; $attempt++) {
                    try {
                        $upload($target, $source);

                        return;
                    } catch (Throwable $throwable) {
                        $lastThrowable = $throwable;

                        if ($attempt < 5) {
                            usleep(min(1_000_000 * $attempt, 5_000_000));
                        }
                    }
                }

                throw $lastThrowable;
            };

            foreach (["orbit-linux-x64", "orbit-macos-arm64", "orbit-agent-linux-x64", "orbit-agent-macos-arm64", "orbit-release-manifest.candidate.json", "orbit-frankenphp-linux-amd64.tar", "orbit-reverb-linux-amd64.tar"] as $asset) {
                $retryingUpload("{$prefix}/{$asset}", "{$dir}/{$asset}");
            }

            $retryingUpload(
                "channels/{$channel}/orbit-release-manifest.json",
                "{$dir}/orbit-release-manifest.candidate.json",
            );
        '

    local sha256_linux_amd64 sha256_darwin_arm64 sha256_agent_linux_amd64 sha256_agent_darwin_arm64
    sha256_linux_amd64="$(compute_sha256 "${work_dir}/orbit-linux-x64")"
    sha256_darwin_arm64="$(compute_sha256 "${work_dir}/orbit-macos-arm64")"
    sha256_agent_linux_amd64="$(compute_sha256 "${work_dir}/orbit-agent-linux-x64")"
    sha256_agent_darwin_arm64="$(compute_sha256 "${work_dir}/orbit-agent-macos-arm64")"

    local state_dir="${state_root}/${build_id}"
    mkdir -p "$state_dir"

    cp "${work_dir}/orbit-linux-x64" "${state_dir}/orbit-linux-x64"
    cp "${work_dir}/orbit-macos-arm64" "${state_dir}/orbit-macos-arm64"
    cp "${work_dir}/orbit-agent-linux-x64" "${state_dir}/orbit-agent-linux-x64"
    cp "${work_dir}/orbit-agent-macos-arm64" "${state_dir}/orbit-agent-macos-arm64"
    cp "${work_dir}/orbit-release-manifest.candidate.json" "${state_dir}/orbit-release-manifest.candidate.json"
    cp "${work_dir}/orbit-frankenphp-linux-amd64.tar" "${state_dir}/orbit-frankenphp-linux-amd64.tar"
    cp "${work_dir}/orbit-reverb-linux-amd64.tar" "${state_dir}/orbit-reverb-linux-amd64.tar"
    cp "${work_dir}/gateway-image-push.log" "${state_dir}/gateway-image-push.log"
    cp "${work_dir}/reverb-image-push.log" "${state_dir}/reverb-image-push.log"
    cp "${work_dir}/frankenphp-image-push.log" "${state_dir}/frankenphp-image-push.log"

    local candidate_channel_manifest_url="${artifact_base_url}/channels/${candidate_channel}/orbit-release-manifest.json"
    local sha256_frankenphp_linux_amd64 sha256_reverb_linux_amd64
    sha256_frankenphp_linux_amd64="$(compute_sha256 "${work_dir}/orbit-frankenphp-linux-amd64.tar")"
    sha256_reverb_linux_amd64="$(compute_sha256 "${work_dir}/orbit-reverb-linux-amd64.tar")"

    {
        printf 'version=%s\n' "$version"
        printf 'build_id=%s\n' "$build_id"
        printf 'commit=%s\n' "$source_commit"
        printf 'candidate_image=%s\n' "$candidate_image"
        printf 'candidate_dir=%s\n' "$state_dir"
        printf 'candidate_prefix=%s\n' "$candidate_prefix"
        printf 'candidate_channel=%s\n' "$candidate_channel"
        printf 'candidate_asset_base_url=%s\n' "$candidate_asset_base_url"
        printf 'gateway_digest=%s\n' "$gateway_digest"
        printf 'candidate_reverb_image=%s\n' "$candidate_reverb_image"
        printf 'reverb_digest=%s\n' "$reverb_digest"
        printf 'candidate_frankenphp_image=%s\n' "$candidate_frankenphp_image"
        printf 'stable_frankenphp_image=%s\n' "$stable_frankenphp_image"
        printf 'frankenphp_digest=%s\n' "$frankenphp_digest"
        printf 'candidate_channel_manifest_url=%s\n' "$candidate_channel_manifest_url"
        printf 'sha256_linux_amd64=%s\n' "$sha256_linux_amd64"
        printf 'sha256_darwin_arm64=%s\n' "$sha256_darwin_arm64"
        printf 'sha256_agent_linux_amd64=%s\n' "$sha256_agent_linux_amd64"
        printf 'sha256_agent_darwin_arm64=%s\n' "$sha256_agent_darwin_arm64"
        printf 'sha256_frankenphp_linux_amd64=%s\n' "$sha256_frankenphp_linux_amd64"
        printf 'sha256_reverb_linux_amd64=%s\n' "$sha256_reverb_linux_amd64"
        if [ -n "$native_assets_dir" ]; then
            printf 'native_builder_os=%s\n' "$native_builder_os"
            printf 'native_builder_arch=%s\n' "$native_builder_arch"
            printf 'native_source_commit=%s\n' "$native_source_commit"
        fi
    } > "${state_dir}/candidate.env"

    printf '%s\n' "$build_id" > "$latest_pointer"

    echo "Candidate channel manifest: ${candidate_channel_manifest_url}"
    echo "Release candidate state: ${state_dir}"
}

cmd_promote_runtime() {
    local build_id=""
    local accepted=0
    local arg

    for arg in "$@"; do
        case "$arg" in
            --build-id=*)
                build_id="${arg#--build-id=}"
                ;;
            --accepted)
                accepted=1
                ;;
            *)
                fail "unknown promote-runtime option: ${arg}. Usage: bin/orbit-release-candidate promote-runtime --build-id=<accepted-id> --accepted"
                ;;
        esac
    done

    [ "$accepted" -eq 1 ] || fail "promote-runtime requires --accepted after live candidate acceptance."
    [ -n "$build_id" ] || fail "promote-runtime requires --build-id=<accepted-id>; the latest pointer is not an acceptance identity."

    local state_dir state_file recorded_build_id candidate_image stable_image expected_digest expected_candidate
    local source_docker_config source_buildx_plugin
    state_dir="$(resolve_state_dir "$build_id")"
    state_file="${state_dir}/candidate.env"
    recorded_build_id="$(state_value build_id "$state_file")"
    candidate_image="$(state_value candidate_frankenphp_image "$state_file")"
    stable_image="$(state_value stable_frankenphp_image "$state_file")"
    expected_digest="$(state_value frankenphp_digest "$state_file")"
    expected_candidate="${stable_image}-candidate-${recorded_build_id}"

    [ -n "$recorded_build_id" ] || fail "build_id is missing from ${state_file}."
    [ "$candidate_image" = "$expected_candidate" ] || fail "candidate FrankenPHP image does not match the recorded build id."
    [[ "$stable_image" =~ ^ghcr\.io/hardimpactdev/orbit-frankenphp:[^@[:space:]]+$ ]] || fail "stable FrankenPHP image is invalid."
    [[ "$expected_digest" =~ ^sha256:[0-9a-f]{64}$ ]] || fail "FrankenPHP digest is invalid."

    gh auth status -h github.com

    source_docker_config="${DOCKER_CONFIG:-${HOME}/.docker}"
    source_buildx_plugin="${source_docker_config}/cli-plugins/docker-buildx"
    ghcr_docker_config="$(mktemp -d)"
    local ghcr_user ghcr_auth
    ghcr_user="$(gh api user -q .login)"
    ghcr_auth="$(printf '%s:%s' "$ghcr_user" "$(gh auth token)" | base64 | tr -d '\n')"
    (umask 077 && printf '{"auths":{"ghcr.io":{"auth":"%s"}}}\n' "$ghcr_auth" > "${ghcr_docker_config}/config.json")
    unset ghcr_auth

    if [ -x "$source_buildx_plugin" ]; then
        source_buildx_plugin="$(
            cd "$(dirname "$source_buildx_plugin")"
            printf '%s/%s\n' "$PWD" "$(basename "$source_buildx_plugin")"
        )"
        mkdir -p "${ghcr_docker_config}/cli-plugins"
        ln -s "$source_buildx_plugin" \
            "${ghcr_docker_config}/cli-plugins/docker-buildx"
    fi

    DOCKER_CONFIG="$ghcr_docker_config" docker buildx imagetools create \
        --prefer-index=false \
        --tag "$stable_image" \
        "${candidate_image}@${expected_digest}"

    local inspect_output actual_digest
    inspect_output="$(DOCKER_CONFIG="$ghcr_docker_config" docker buildx imagetools inspect "$stable_image")"
    actual_digest="$(awk '/^Digest:/ { print $2; exit }' <<< "$inspect_output")"

    if [ "$actual_digest" != "$expected_digest" ]; then
        fail "promoted FrankenPHP digest mismatch: expected ${expected_digest}, got ${actual_digest:-missing}."
    fi

    {
        printf 'build_id=%s\n' "$recorded_build_id"
        printf 'candidate_image=%s\n' "$candidate_image"
        printf 'stable_image=%s\n' "$stable_image"
        printf 'digest=%s\n' "$actual_digest"
        printf 'promoted_at=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    } > "${state_dir}/frankenphp-promotion.log"

    printf 'PASS frankenphp_digest %s\n' "$actual_digest"
    printf 'Runtime promotion evidence: %s\n' "${state_dir}/frankenphp-promotion.log"
}

cmd_verify_native() {
    local native_assets_dir=''
    local expected_commit=''
    local expected_version=''
    local argument

    for argument in "$@"; do
        case "$argument" in
            --native-assets=*)
                native_assets_dir="${argument#--native-assets=}"
                ;;
            --commit=*)
                expected_commit="${argument#--commit=}"
                ;;
            --version=*)
                expected_version="${argument#--version=}"
                ;;
            *)
                fail "unknown verify-native option: ${argument}. Usage: bin/orbit-release-candidate verify-native --native-assets=<dir> [--commit=<sha>] [--version=<version>]"
                ;;
        esac
    done

    [ -n "$native_assets_dir" ] || fail 'verify-native requires --native-assets=<dir>.'

    case "$native_assets_dir" in
        /*) ;;
        *) native_assets_dir="${repo_root}/${native_assets_dir}" ;;
    esac
    native_assets_dir="${native_assets_dir%/}"

    if [ -z "$expected_commit" ]; then
        expected_commit="$(git -C "$repo_root" rev-parse HEAD)"
    fi

    if [ -z "$expected_version" ]; then
        expected_version="$("${repo_root}/bin/orbit-version")"
    fi

    local actual_sha
    actual_sha="$(verify_native_assets "$native_assets_dir" "$expected_commit" "$expected_version")"
    printf 'PASS sha256_agent_darwin_arm64 %s\n' "$actual_sha"
}

cmd_env() {
    local build_id=""
    local arg

    for arg in "$@"; do
        case "$arg" in
            --build-id=*)
                build_id="${arg#--build-id=}"
                ;;
            *)
                fail "unknown env option: ${arg}. Usage: bin/orbit-release-candidate env [--build-id=<id>]"
                ;;
        esac
    done

    local state_dir
    state_dir="$(resolve_state_dir "$build_id")"

    local line key value
    while IFS= read -r line; do
        [ -n "$line" ] || continue

        key="${line%%=*}"
        value="${line#*=}"

        if ! [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
            fail "invalid state key [${key}] in ${state_dir}/candidate.env."
        fi

        printf 'export %s=%q\n' "$key" "$value"
    done < "${state_dir}/candidate.env"
}

cmd_verify() {
    local build_id=""
    local release_image=""
    local arg

    for arg in "$@"; do
        case "$arg" in
            --build-id=*)
                build_id="${arg#--build-id=}"
                ;;
            --release-image=*)
                release_image="${arg#--release-image=}"
                ;;
            *)
                fail "unknown verify option: ${arg}. Usage: bin/orbit-release-candidate verify [--build-id=<id>] [--release-image=<ref>]"
                ;;
        esac
    done

    local state_dir
    state_dir="$(resolve_state_dir "$build_id")"
    local state_file="${state_dir}/candidate.env"

    local failures=0
    local pair key artifact expected actual

    for pair in \
        'sha256_linux_amd64:orbit-linux-x64' \
        'sha256_darwin_arm64:orbit-macos-arm64' \
        'sha256_agent_linux_amd64:orbit-agent-linux-x64' \
        'sha256_agent_darwin_arm64:orbit-agent-macos-arm64' \
        'sha256_frankenphp_linux_amd64:orbit-frankenphp-linux-amd64.tar' \
        'sha256_reverb_linux_amd64:orbit-reverb-linux-amd64.tar'
    do
        key="${pair%%:*}"
        artifact="${state_dir}/${pair#*:}"
        expected="$(state_value "$key" "$state_file")"

        if [ -z "$expected" ]; then
            printf 'FAIL %s: key missing from %s\n' "$key" "$state_file"
            failures=$((failures + 1))
            continue
        fi

        if [ ! -f "$artifact" ]; then
            printf 'FAIL %s: artifact missing at %s\n' "$key" "$artifact"
            failures=$((failures + 1))
            continue
        fi

        actual="$(compute_sha256 "$artifact")"

        if [ "$actual" = "$expected" ]; then
            printf 'PASS %s %s\n' "$key" "$actual"
        else
            printf 'FAIL %s: expected %s got %s for %s\n' "$key" "$expected" "$actual" "$artifact"
            failures=$((failures + 1))
        fi
    done

    if [ -n "$release_image" ]; then
        local expected_digest actual_digest inspect_output
        expected_digest="$(state_value gateway_digest "$state_file")"

        if [ -z "$expected_digest" ]; then
            printf 'FAIL gateway_digest: key missing from %s\n' "$state_file"
            failures=$((failures + 1))
        elif ! inspect_output="$(docker buildx imagetools inspect "$release_image")"; then
            printf 'FAIL gateway_digest: imagetools inspect failed for %s\n' "$release_image"
            failures=$((failures + 1))
        else
            actual_digest="$(awk '/^Digest:/ { print $2; exit }' <<< "$inspect_output")"

            if [ "$actual_digest" = "$expected_digest" ]; then
                printf 'PASS gateway_digest %s\n' "$actual_digest"
            else
                printf 'FAIL gateway_digest: expected %s got %s for %s\n' "$expected_digest" "$actual_digest" "$release_image"
                failures=$((failures + 1))
            fi
        fi
    fi

    if [ "$failures" -gt 0 ]; then
        printf 'orbit-release-candidate: verify failed with %s mismatch(es) for %s\n' "$failures" "$state_dir" >&2
        exit 1
    fi
}

subcommand="${1:-}"

case "$subcommand" in
    build)
        shift
        cmd_build "$@"
        ;;
    verify-native)
        shift
        cmd_verify_native "$@"
        ;;
    env)
        shift
        cmd_env "$@"
        ;;
    promote-runtime)
        shift
        cmd_promote_runtime "$@"
        ;;
    verify)
        shift
        cmd_verify "$@"
        ;;
    -h|--help|help)
        usage
        ;;
    '')
        usage >&2
        exit 2
        ;;
    *)
        printf 'orbit-release-candidate: unknown subcommand [%s].\n' "$subcommand" >&2
        usage >&2
        exit 2
        ;;
esac
