#!/usr/bin/env python3
"""Select CI builds from changed inputs; every main commit is a Gateway release, which also loads Swamp."""
import argparse
import json
from pathlib import Path
import re
import subprocess

JOBS = ('php', 'gateway-static', 'cli', 'cli-static', 'sdk-static', 'e2e-static', 'docs', 'api-reference', 'web', 'pi', 'agent', 'swamp', 'proof')
ROOT = Path(__file__).resolve().parent.parent
# Gateway files that the Swamp gate and its Deno tests read: the grant renderer, the workflow definition that a Deno test parses, and the
# frozen agent contract, whose check scans the Gateway and Swamp sources (the PHP job runs the same check for PHP files only).
SWAMP_GATEWAY_INPUTS = ('apps/gateway/app/Infrastructure/GatewayReleases/SwampGrantRenderer.php', 'apps/gateway/app/Support/ValidatedData.php',
                        'apps/gateway/bin/render-swamp-grants', 'apps/gateway/app/Domain/Tasks/direct-operations.php')
FROZEN_SCANNED = ('.ts', '.js', '.py', '.yaml', '.yml')
SELECTION = 'swamp/proof/selection.txt'
SELECTION_COMMAND = re.compile(r'[a-z][a-z0-9_-]*(?::[a-z][a-z0-9_-]*)+')


def selection_regex(glob):
    """Match `ProofSelectionRule` in the Gateway: `**` crosses directories, `*` and `?` stay in one name."""
    pattern, i = '', 0
    while i < len(glob):
        if glob.startswith('**', i):
            i += 2
            if glob.startswith('/', i):
                i += 1
                pattern += '(?:.*/)?'
            else:
                pattern += '.*'
            continue
        pattern += '[^/]*' if glob[i] == '*' else '[^/]' if glob[i] == '?' else re.escape(glob[i])
        i += 1
    return re.compile(pattern)


def selection_rules(text):
    """The lines of `swamp/proof/selection.txt` as (glob regex, selects a proof). The Gateway refuses a malformed line."""
    rules = []
    for number, line in enumerate(text.splitlines(), 1):
        line = line.strip()
        if not line or line.startswith('#'):
            continue
        parts = line.split(None, 1)
        if len(parts) != 2:
            raise ValueError(f'{SELECTION} line {number}: a line holds a path glob and its value')
        glob, value = parts[0], parts[1].strip()
        if value == 'skip' or (value.startswith('none:') and value[5:].strip()):
            selects = False
        elif value == '*' or all(SELECTION_COMMAND.fullmatch(word) for word in value.split()):
            selects = True
        else:
            raise ValueError(f'{SELECTION} line {number}: [{value}] is not skip, *, none: or a family:command')
        rules.append((selection_regex(glob), selects))
    return rules


def proof_run(paths, selection):
    """Whether a changed path selects a command in the list that `orbit proof:run` reads: the last matching line wins.

    A path no line matches also starts the job, so `proof:run` refuses it (proof.path_unmapped). Without a list,
    every change starts it, as proof:run then selects every case.
    """
    paths = [path for path in paths if path]
    if not paths:
        return False
    if selection is None or SELECTION in paths:
        return True
    rules = selection_rules(selection)
    for path in paths:
        match = next((selects for regex, selects in reversed(rules) if regex.fullmatch(path)), True)
        if match:
            return True
    return False


def select(paths, main=False, selection=None):
    """`selection` is the text of the selection list; omitted, the list of this checkout is read."""
    paths = [path for path in paths if path]
    swamp_only = bool(paths) and all(path.startswith('swamp/') for path in paths)
    jobs = dict.fromkeys(JOBS, False)
    agent = False
    for path in paths:
        if path.startswith('apps/gateway/'):
            jobs['gateway-static'] = True
        if path in SWAMP_GATEWAY_INPUTS or path.startswith('apps/gateway/resources/agent/') or (path.startswith(('apps/gateway/app/', 'apps/gateway/extensions/')) and path.endswith(FROZEN_SCANNED)):
            jobs['swamp'] = True
        if path.startswith('swamp/'):
            jobs['swamp'] = True
            # The proof harness has its own unit tests, lint and native workflow validation.
            if path.startswith('swamp/proof/'):
                jobs['proof'] = True
            if path == 'swamp/config/gateway-workflow-grants.json':
                jobs['api-reference'] = True
            # bin/check-flows compares migrated charts with their workflow step names.
            if path.startswith('swamp/workflows/'):
                jobs['docs'] = True
            continue
        if '/' not in path and path.endswith(('.md', '.mdx')):
            jobs['docs'] = True
            continue
        if path.startswith(('.github/', 'bin/', 'tools/', '.agents/')) or '/' not in path:
            jobs = dict.fromkeys(JOBS, True)
        # Each PHP project that no other job analyses has its own static analysis. Every file of the project selects it,
        # its Composer manifest and lock included, so a dependency bump is analysed with the code that uses it.
        if path.startswith(('apps/cli/', 'packages/php-sdk/')):
            jobs['cli-static'] = True
        if path.startswith('packages/php-sdk/'):
            jobs['sdk-static'] = True
        if path.startswith('apps/e2e/'):
            jobs['e2e-static'] = True
        if path.endswith('.php') or path.endswith(('composer.json', 'composer.lock')):
            jobs['php'] = True
        if path.startswith(('apps/cli/tests/', 'apps/gateway/tests/', 'packages/php-sdk/tests/')):
            continue
        if path.startswith(('apps/cli/', 'packages/php-sdk/')):
            jobs['cli'] = jobs['api-reference'] = jobs['web'] = True
        if path.startswith(('docs/', 'apps/docs/')):
            jobs['docs'] = True
        # bin/check-operation-kinds needs a chart or a flows-pending.txt line for every kind.
        if path.startswith('docs/cli/') and path.endswith(('.mmd', 'flows-pending.txt')):
            jobs['api-reference'] = True
        if path.startswith('apps/gateway/'):
            jobs['api-reference'] = jobs['web'] = True
        if path.startswith('apps/web/'):
            jobs['web'] = True
            if path.startswith(('apps/web/tools/api-types/', 'apps/web/fixtures/')):
                jobs['api-reference'] = True
        if path.startswith('apps/pi-server/') and not path.endswith(('.md', '.mdx')):
            jobs['pi'] = True
        if (path.startswith('apps/agent/') or re.match(r'apps/gateway/extensions/[^/]+/agent/', path)) and not path.endswith(('.md', '.mdx')):
            agent = jobs['agent'] = True
        if not path.startswith(('apps/', 'packages/', 'docs/', '.github/', 'bin/', 'tools/', '.agents/')) and '/' in path:
            jobs = dict.fromkeys(JOBS, True)
    jobs['web'] |= main
    if selection is None and (ROOT / SELECTION).is_file():
        selection = (ROOT / SELECTION).read_text()
    # The proof-run job is report-only and outside `jobs`, so `Required checks` does not see it yet.
    return {'jobs': jobs, 'agent': agent, 'gateway_release': main or not swamp_only, 'proof_run': proof_run(paths, selection)}


def swamp_comparison_base(base, head):
    """The first import compares against its retained source; later changes use Orbit's base."""
    if subprocess.run(['git', 'cat-file', '-e', f'{base}:swamp'],
                      stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=60).returncode == 0:
        return base
    source = json.loads(subprocess.check_output(
        ['git', 'show', f'{head}:swamp/import-source.json'], timeout=60))['shape_base']
    if not isinstance(source, str) or not re.fullmatch('[0-9a-f]{40}', source):
        raise ValueError('The Swamp import source must be a full commit SHA')
    subprocess.run(['git', 'merge-base', '--is-ancestor', source, head], check=True,
                   stderr=subprocess.PIPE, timeout=60)
    return source


def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument('--base', required=True)
    p.add_argument('--head', default='HEAD')
    p.add_argument('--main', action='store_true')
    p.add_argument('--github-output', type=Path)
    p.add_argument('--swamp-base', action='store_true', help='Resolve the retained source for the first history import')
    a = p.parse_args()
    paths = subprocess.check_output(['git', 'diff', '--name-only', '--no-renames', '-z', a.base, a.head], timeout=60).decode().rstrip('\0').split('\0')
    result = select(paths, a.main)
    if a.swamp_base and result['jobs']['swamp']:
        result['swamp_base_ref'] = swamp_comparison_base(a.base, a.head)
    print(json.dumps(result))
    if a.github_output:
        with a.github_output.open('a') as output:
            for name, value in result.items():
                encoded = value if isinstance(value, str) else json.dumps(value, separators=(',', ':'))
                output.write(f'{name}={encoded}\n')


if __name__ == '__main__':
    main()
