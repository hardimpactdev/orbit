#!/usr/bin/env bash

set -euo pipefail

run_checks=1
with_bun=0
with_rust=0
for argument in "$@"; do
    case "$argument" in
        --skip-checks) run_checks=0 ;;
        --with-bun) with_bun=1 ;;
        --with-rust) with_rust=1 ;;
        *)
            printf 'Usage: bin/bootstrap [--skip-checks] [--with-bun] [--with-rust]\n' >&2
            exit 2
            ;;
    esac
done

repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
projects=("apps/cli" "apps/docs" "apps/gateway" "apps/e2e" "packages/php-sdk")

# A Gateway release is immutable (docs/reference/gateway-recovery.md#release-layout). Installing
# dependencies in place would change the code the Gateway serves; deploy another commit instead.
if [[ -e "$repository_root/REVISION" ]]; then
    printf 'This checkout is an immutable Gateway release. Use gateway:release:deploy instead of updating it in place.\n' >&2
    exit 2
fi

if ! command -v composer >/dev/null 2>&1; then
    printf 'Composer is required.\n' >&2
    exit 2
fi

if ! command -v openssl >/dev/null 2>&1; then
    printf 'OpenSSL is required.\n' >&2
    exit 2
fi

# The web app, the Pi server, and the desktop app use Bun; the Node agent and the desktop shell use Cargo.
# docs/reference/bun-and-rust-projects.md lists the versions and how to check each project.
bun_projects=("apps/web" "apps/pi-server" "apps/desktop")
cargo_projects=("apps/agent" "apps/desktop/src-tauri")

if ((with_bun)) && ! command -v bun >/dev/null 2>&1; then
    printf 'Bun is required for --with-bun. See https://bun.sh.\n' >&2
    exit 2
fi

if ((with_rust)) && ! command -v cargo >/dev/null 2>&1; then
    printf 'Cargo is required for --with-rust. See https://rustup.rs.\n' >&2
    exit 2
fi

log_directory="$(mktemp -d)"
failed=0

cleanup() {
    find "$log_directory" -maxdepth 1 -type f -delete
    rmdir "$log_directory"
}

trap cleanup EXIT

# Composer's shared file cache is not safe for concurrent writers. Keep installs
# serial; each Composer process still downloads its packages concurrently.
for project in "${projects[@]}"; do
    log_file="$log_directory/${project//\//-}.log"

    if (
        cd "$repository_root/$project" || exit

        if [[ -f .env.example && ! -e .env ]]; then
            cp .env.example .env || exit
        fi

        composer install --no-interaction --prefer-dist
    ) >"$log_file" 2>&1; then
        printf '\n[%s] installed\n' "$project"
    else
        printf '\n[%s] failed\n' "$project" >&2
        failed=1
    fi

    sed 's/^/  /' "$log_file"
done

if ((failed != 0)); then
    exit "$failed"
fi

if ((with_bun)); then
    for project in "${bun_projects[@]}"; do
        printf '\n[%s] bun install\n' "$project"
        (cd "$repository_root/$project" && bun install --frozen-lockfile)
    done
fi

if ((with_rust)); then
    for project in "${cargo_projects[@]}"; do
        printf '\n[%s] cargo fetch\n' "$project"
        (cd "$repository_root/$project" && cargo fetch --locked)
    done
fi

(cd "$repository_root" && bin/generated-merge --install)

"$repository_root/bin/worktree-cache"

"$repository_root/bin/gateway-app-key"

# A cache miss falls back to normal checks.
"$repository_root/bin/tia-cache" seed --repository="$repository_root" || printf 'TIA cache seeding unavailable.\n' >&2
unset ORBIT_MAIN_CACHE_STORE

pids=()

for project in "${projects[@]}"; do
    (
        cd "$repository_root/$project"
        composer guidance:check
    ) >"$log_directory/${project//\//-}-guidance.log" 2>&1 &
    pids+=("$!")
done

for index in "${!projects[@]}"; do
    project="${projects[$index]}"
    log_file="$log_directory/${project//\//-}-guidance.log"

    if wait "${pids[$index]}"; then
        printf '\n[%s] guidance valid\n' "$project"
    else
        printf '\n[%s] guidance failed\n' "$project" >&2
        failed=1
    fi

    sed 's/^/  /' "$log_file"
done

if ((failed != 0)); then
    exit "$failed"
fi

if ((run_checks)); then
    for project in "${projects[@]}"; do
        printf '\n[%s] affected tests and quality checks\n' "$project"
        (
            cd "$repository_root/$project"
            export COMPOSER_PROCESS_TIMEOUT=0
            composer test:affected
            composer check
        )
    done
fi
