{
  "kind": "metrics.exporter_enable",
  "workflow": "operation-metrics-exporter-enable",
  "topology": "minimal",
  "clean": true,
  "budget_seconds": 600,
  "queue_timeout_seconds": 60,
  "before_gateway": [
    [
      "runuser",
      "-u",
      "orbit",
      "--",
      "env",
      "-C",
      "apps/gateway",
      "PROOF_METRICS_NODE=${node.target}",
      "php",
      "-r",
      "require \"vendor/autoload.php\"; $app=require \"bootstrap/app.php\"; $app->make(Illuminate\\Contracts\\Console\\Kernel::class)->bootstrap(); $node=App\\Models\\Node::findOrFail((int)getenv(\"PROOF_METRICS_NODE\")); $node->roles()->firstOrCreate([\"role\"=>\"metrics\"],[\"status\"=>\"active\"]);"
    ]
  ],
  "clean_target": [
    [
      "sh",
      "-c",
      "docker rm --force orbit-metrics-prometheus >/dev/null 2>&1 || true; rm -f /etc/orbit/metrics/prometheus.yml"
    ]
  ],
  "before_target": [
    [
      "timeout",
      "120",
      "sh",
      "-c",
      "mkdir -p /etc/orbit/metrics && printf 'global: {}\\nscrape_configs: []\\n' > /etc/orbit/metrics/prometheus.yml && docker run --detach --name orbit-metrics-prometheus --network host --volume /etc/orbit/metrics/prometheus.yml:/etc/prometheus/prometheus.yml:ro prom/prometheus:v3.5.0 --config.file=/etc/prometheus/prometheus.yml --web.listen-address=127.0.0.1:9090"
    ],
    [
      "timeout",
      "60",
      "curl",
      "--silent",
      "--show-error",
      "--fail",
      "--retry",
      "30",
      "--retry-connrefused",
      "--retry-delay",
      "1",
      "--output",
      "/dev/null",
      "http://127.0.0.1:9090/-/ready"
    ]
  ],
  "request": {
    "method": "PUT",
    "path": "metrics/exporters/${node.metrics}"
  },
  "expect": {
    "status": "succeeded"
  },
  "phases": [
    {
      "name": "Install the exporters",
      "job": "exporter",
      "step": "Install the exporters",
      "budget_seconds": 300
    },
    {
      "name": "Publish the config",
      "job": "exporter",
      "step": "Publish the config",
      "budget_seconds": 120
    },
    {
      "name": "Prove the exporter state",
      "job": "exporter",
      "step": "Prove the exporter state",
      "budget_seconds": 10
    }
  ],
  "parity": [
    "swamp/proof/metrics.exporter/parity.py",
    "enable"
  ]
}
