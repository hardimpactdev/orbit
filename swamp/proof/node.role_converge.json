      "role": "database",
      "converge_existing": true
    }
  },
  "expect": {
    "status": "succeeded"
  },
  "phases": [
    {
      "name": "Converge the role",
      "job": "dispatch",
      "step": "native-0",
      "budget_seconds": 900
    }
  ],
  "parity": [
    "swamp/proof/node.role_converge/parity.py"
  ]
