{
  "kind": "process.create.docker.environment",
  "workflow": "operation-process-create",
  "topology": "minimal",
  "budget_seconds": 180,
  "queue_timeout_seconds": 30,
  "expect": {
    "status": "succeeded"
  },
  "request": {
    "method": "POST",
    "path": "processes",
    "body": {
      "target_type": "node",
      "target_id": "${node.target}",
      "name": "docker-${proof.run}",
      "runtime": "docker",
      "image": "busybox:1.36",
      "command": [
        "sleep",
        "infinity"
      ],
      "start": true,
      "environment": {
        "TOKEN": "${secret.environment}",
        "PUNCT": " literal $HOME \"quoted\" = : #"
      },
      "working_directory": "/tmp"
    }
  },
  "phases": [
    {
      "name": "Pull the image",
      "job": "process",
      "step": "Pull the image",
      "budget_seconds": 120
    },
    {
      "name": "Run the container",
      "job": "process",
      "step": "Run the container",
      "budget_seconds": 20
    },
    {
      "name": "Verify it runs",
      "job": "process",
      "step": "Verify it runs",
      "budget_seconds": 20
    },
    {
      "name": "Write the environment",
      "job": "process",
      "step": "Write the environment",
      "budget_seconds": 20
    }
  ],
  "parity": [
    "swamp/proof/process/docker_environment_parity.py"
  ],
  "before_gateway": [
    [
      "python3",
      "-c",
      "import secrets,json; print(json.dumps({'secrets':{'environment':secrets.token_hex(32)}}))"
    ]
  ]
}
