{
  "kind": "process.create",
  "workflow": "operation-process-create",
  "topology": "minimal",
  "budget_seconds": 120,
  "queue_timeout_seconds": 30,
  "request": {
    "method": "POST",
    "path": "processes",
    "body": {
      "target_type": "node",
      "target_id": "${node.target}",
      "name": "create-${proof.run}",
      "runtime": "systemd",
      "command": [
        "/usr/bin/sleep",
        "infinity"
      ],
      "start": true
    }
  },
  "expect": {
    "status": "succeeded"
  },
  "phases": [
    {
      "name": "Apply the unit",
      "job": "process",
      "step": "Apply the unit",
      "budget_seconds": 20
    },
    {
      "name": "Reload systemd",
      "job": "process",
      "step": "Reload systemd",
      "budget_seconds": 20
    },
    {
      "name": "Verify it runs",
      "job": "process",
      "step": "Verify it runs",
      "budget_seconds": 20
    }
  ],
  "parity": [
    "swamp/proof/process/parity.py",
    "running"
  ]
}
