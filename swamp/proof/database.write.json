{
  "kind": "database.write",
  "workflow": "operation-database-write",
  "topology": "minimal",
  "clean": true,
  "budget_seconds": 120,
  "queue_timeout_seconds": 30,
  "expect": {
    "status": "succeeded"
  },
  "clean_target": [
    [
      "sh",
      "-c",
      "docker ps --all --quiet --filter name=-proof- | xargs -r docker rm --force"
    ]
  ],
  "prepare": [
    {
      "method": "POST",
      "path": "database-servers",
      "body": {
        "slug": "proof-rdsrv-${proof.run}",
        "node_id": "${node.target}",
        "driver": "mysql",
        "port": 33196
      },
      "bind": "server"
    },
    {
      "method": "POST",
      "path": "database-connections",
      "body": {
        "slug": "proof-rd-${proof.run}",
        "server": "proof-rdsrv-${proof.run}"
      },
      "bind": "connection"
    }
  ],
  "request": {
    "method": "POST",
    "path": "database-connections/proof-rd-${proof.run}/query",
    "body": {
      "sql": "CREATE TABLE proof_write (id INT)",
      "write": true
    }
  },
  "phases": [
    {
      "name": "Run the statement",
      "job": "write",
      "step": "Run the statement",
      "budget_seconds": 40
    }
  ],
  "parity": [
    "swamp/proof/database/write_parity.py",
    "{\"backend\": \"active\", \"row_count\": 0, \"truncated\": false}"
  ]
}
