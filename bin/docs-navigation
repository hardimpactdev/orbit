#!/usr/bin/env python3
"""Assemble Mintlify settings and sorted navigation fragments into docs/docs.json."""
import argparse
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent


def configuration(root=ROOT, spec=None):
    config = json.loads((root / 'docs/site.json').read_text())
    entries = []
    for path in sorted((root / 'docs/navigation').glob('*.json')):
        fragment = json.loads(path.read_text())
        entries.extend(fragment.get('navigation', []))
        config['redirects'].extend(fragment.get('redirects', []))
    for entry in sorted(entries, key=lambda entry: entry['order']):
        tab = next(tab for tab in config['navigation']['tabs'] if tab['tab'] == entry['tab'])
        group = next((group for group in tab['groups'] if group['group'] == entry['group']), None)
        if group is None:
            group = {'group': entry['group'], 'pages': []}
            tab['groups'].append(group)
        group['pages'].extend(entry['pages'])
    spec_path = root / 'docs/openapi.json'
    if spec is None and spec_path.exists():
        spec = json.loads(spec_path.read_text())
    if spec is not None:
        groups = {}
        for path, methods in spec['paths'].items():
            for method, operation in methods.items():
                if method not in ('get', 'post', 'put', 'patch', 'delete'):
                    continue
                groups.setdefault(operation['tags'][0], []).append(f'{method.upper()} {path}')
        api = next(tab for tab in config['navigation']['tabs'] if tab['tab'] == 'API')
        for tag in spec['tags']:
            if tag['name'] in groups:
                api['groups'].append({'group': tag['name'], 'openapi': '/openapi.json', 'pages': groups[tag['name']]})
    return config


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--root', type=Path, default=ROOT)
    root = parser.parse_args().root
    (root / 'docs/docs.json').write_text(json.dumps(configuration(root), indent=2) + '\n')
