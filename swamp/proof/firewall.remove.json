{
  "kind": "firewall.remove",
  "workflow": "operation-firewall-direct",
  "topology": "minimal",
  "budget_seconds": 300,
  "queue_timeout_seconds": 30,
  "expect": {
    "status": "succeeded"
  },
  "phases": [
    {
      "name": "Read the rules",
      "job": "firewall",
      "step": "Read the rules",
      "budget_seconds": 60
    },
    {
      "name": "Plan the changes",
      "job": "firewall",
      "step": "Plan the changes",
      "budget_seconds": 60
    },
    {
      "name": "Read the result",
      "job": "firewall",
      "step": "Read the result",
      "budget_seconds": 60
    },
    {
      "name": "Check the rules",
      "job": "firewall",
      "step": "Check the rules",
      "budget_seconds": 60
    },
    {
      "name": "accepted",
      "job": "firewall",
      "step": "accepted",
      "budget_seconds": 60
    }
  ],
  "prepare": [
    {
      "method": "POST",
      "path": "nodes/${node.target}/firewall-rules/allow",
      "body": {
        "port": "8443",
        "protocol": "tcp",
        "source": "192.0.2.2"
      }
    },
    {
      "method": "POST",
      "path": "nodes/${node.target}/firewall-rules/allow",
      "body": {
        "port": "8443",
        "protocol": "udp",
        "source": "192.0.2.2"
      }
    }
  ],
  "request": {
    "method": "POST",
    "path": "nodes/${node.target}/firewall-rules/remove",
    "body": {
      "port": "8443",
      "protocol": "tcp"
    }
  },
  "parity": [
    "swamp/proof/firewall/check.py",
    "-8443/tcp ALLOW 192.0.2.2",
    "+8443/udp ALLOW 192.0.2.2"
  ]
}
