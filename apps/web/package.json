{
    "name": "@orbit/web",
    "version": "0.0.0",
    "private": true,
    "workspaces": [
        "tools/api-types"
    ],
    "type": "module",
    "scripts": {
        "dev": "vp dev",
        "demo": "VITE_ORBIT_DEMO=1 vp dev",
        "build": "bun run types && tsc && vp build",
        "preview": "vp preview",
        "check": "bun run types && vp check",
        "test": "bun run test:unit && bun run test:browser",
        "test:unit": "vp test run --project unit --project verification",
        "test:browser": "vp test run --project browser",
        "types": "bun run --cwd tools/api-types generate"
    },
    "dependencies": {
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@heroicons/react": "2",
        "@nckrtl/annotator": "^0.3.0",
        "@tanstack/react-query": "^5.106.1",
        "@tanstack/react-router": "^1.170.46",
        "@tanstack/react-table": "^9.3.1",
        "@tanstack/react-virtual": "^3.14.26",
        "pusher-js": "^8.6.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.4",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.2.1",
        "@vitest/browser-playwright": "5.1.0",
        "playwright": "1.65.0",
        "tailwindcss": "^4.3.4",
        "typescript": "~7.0.2",
        "undici": "^8.12.4",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
        "vite-plus": "1.5.0",
        "vitest-browser-react": "^2.3.0"
    },
    "overrides": {
        "source-map-js": "1.2.2",
        "tinypool": "2.1.2",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
        "vitest": "5.0.5"
    },
    "devEngines": {
        "packageManager": {
            "name": "bun",
            "version": "1.4.2",
            "onFail": "download"
        }
    }
}
