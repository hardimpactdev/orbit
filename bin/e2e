            -o UserKnownHostsFile=/dev/null \
            "${ssh_user}@${ipv4}" \
            "test \"\$(uname -s)\" = Linux && test -r /etc/os-release" </dev/null >/dev/null 2>&1; then
            return 0
        fi

        sleep 3
    done

    echo "orbit-e2e failed: SSH never became ready on ${ipv4} within ${timeout_seconds}s" >&2
    return 1
}

trap cleanup EXIT

command -v incus >/dev/null
command -v ssh-keygen >/dev/null
command -v ssh >/dev/null

if ! incus image info "$control_image" >/dev/null 2>&1; then
    echo "orbit-e2e missing control image: ${control_image}; run bin/e2e --prepare-control first" >&2
    exit 2
fi

if ! incus image info "$gateway_image" >/dev/null 2>&1; then
    echo "orbit-e2e missing gateway image: ${gateway_image}; run bin/e2e --prepare-gateway first" >&2
    exit 2
fi

rm -rf "$run_dir"
mkdir -p "$run_dir"

ssh-keygen -t ed25519 -N '' -f "$run_dir/id_ed25519" -C "orbit-e2e-${run_id}" >/dev/null

echo "orbit-e2e launching ${control_name} from ${control_image} and ${gateway_name} from ${gateway_image} on $(hostname)"

incus launch "$control_image" "$control_name" --vm \
    --config=limits.cpu="$cpus" \
    --config=limits.memory="$memory" </dev/null >/dev/null

sleep 3

incus launch "$gateway_image" "$gateway_name" --vm \
    --config=limits.cpu="$cpus" \
    --config=limits.memory="$memory" </dev/null >/dev/null

wait_for_agent "$control_name"
wait_for_agent "$gateway_name"

# Set up SSH access on control VM
incus exec "$control_name" -- sh -lc "install -d -m 700 -o ${control_user} -g ${control_user} /home/${control_user}/.ssh" </dev/null >/dev/null
incus file push "$run_dir/id_ed25519.pub" "$control_name/home/${control_user}/.ssh/authorized_keys" </dev/null >/dev/null
incus exec "$control_name" -- sh -lc "chown ${control_user}:${control_user} /home/${control_user}/.ssh/authorized_keys && chmod 600 /home/${control_user}/.ssh/authorized_keys && systemctl start ssh || systemctl start sshd || true" </dev/null >/dev/null

# Set up SSH access on gateway VM for orbit user
incus exec "$gateway_name" -- sh -lc "install -d -m 700 -o orbit -g orbit /home/orbit/.ssh" </dev/null >/dev/null
incus file push "$run_dir/id_ed25519.pub" "$gateway_name/home/orbit/.ssh/authorized_keys" </dev/null >/dev/null
incus exec "$gateway_name" -- sh -lc "chown orbit:orbit /home/orbit/.ssh/authorized_keys && chmod 600 /home/orbit/.ssh/authorized_keys && systemctl start ssh || systemctl start sshd || true" </dev/null >/dev/null

# Copy private key to control VM so it can SSH to gateway
incus file push "$run_dir/id_ed25519" "$control_name/home/${control_user}/.ssh/id_ed25519" </dev/null >/dev/null
incus exec "$control_name" -- sh -lc "chown ${control_user}:${control_user} /home/${control_user}/.ssh/id_ed25519 && chmod 600 /home/${control_user}/.ssh/id_ed25519" </dev/null >/dev/null

control_ipv4="$(wait_for_ipv4 "$control_name")"
gateway_ipv4="$(wait_for_ipv4 "$gateway_name")"

# Ensure VMs have distinct IPs; retry briefly if they collide
ip_check_deadline=$((SECONDS + 30))
while [ "$SECONDS" -lt "$ip_check_deadline" ] && [ "$control_ipv4" = "$gateway_ipv4" ]; do
    sleep 2
    control_ipv4="$(extract_ipv4 "$control_name")"
    gateway_ipv4="$(extract_ipv4 "$gateway_name")"
done

if [ "$control_ipv4" = "$gateway_ipv4" ]; then
    echo "orbit-e2e failed: control and gateway VMs have the same IP (${control_ipv4})" >&2
    exit 1
fi

wait_for_ssh "$control_ipv4" "$run_dir/id_ed25519" "$control_user"
wait_for_ssh "$gateway_ipv4" "$run_dir/id_ed25519" "orbit"

echo "orbit-e2e control VM ready at ${control_ipv4}"
echo "orbit-e2e gateway VM ready at ${gateway_ipv4}"

# Configure gateway VM with WireGuard-like dummy interface
# so it is reachable at the expected gateway WireGuard IP
incus exec "$gateway_name" -- sh -lc "ip link add dummy0 type dummy 2>/dev/null || true && ip addr add 10.6.0.2/16 dev dummy0 2>/dev/null || true && ip link set dummy0 up 2>/dev/null || true" </dev/null >/dev/null

# Seed control node into gateway database so /api/me returns success
incus exec "$gateway_name" -- sudo -iu orbit bash -lc "cd /home/orbit/orbit && php artisan tinker --execute '
    \\\$control = \\App\\Models\\Node::query()->updateOrCreate(
        [\"name\" => \"control-1\"],
        [
            \"role\" => \"control\",
            \"environment\" => null,
            \"tld\" => null,
            \"platform\" => \"unknown\",
            \"host\" => \"${control_ipv4}\",
            \"wireguard_address\" => \"10.6.0.3\",
            \"gateway_endpoint\" => \"10.6.0.2\",
            \"ssh_user\" => \"${control_user}\",
            \"user\" => \"${control_user}\",
            \"orbit_path\" => \"/home/${control_user}/orbit\",
            \"status\" => \"active\",
            \"is_local\" => false,
        ]
    );
    echo \"Seeded control-1 with WG IP 10.6.0.3\";
'" </dev/null >/dev/null

echo "orbit-e2e seeded control node into gateway database"

# Start gateway API server on the dummy interface
# NOTE: This starts Laravel's built-in development server for the CA endpoint.
# HTTPS for /api/me requires a reverse proxy or web server (Caddy/nginx).
# Until gateway web server infrastructure is ready in the ephemeral harness,
# gateway:add may fail at the HTTPS verification step.
incus exec "$gateway_name" -- sudo -iu orbit bash -lc "cd /home/orbit/orbit && nohup php artisan serve --host=10.6.0.2 --port=80 > /tmp/gateway-api.log 2>&1 &" </dev/null >/dev/null

# Give the server a moment to start
sleep 2

echo "orbit-e2e running 'orbit gateway:add 10.6.0.2 --json' from control VM"

set +e
gateway_add_output="$(ssh \
    -i "$run_dir/id_ed25519" \
    -o BatchMode=yes \
    -o ConnectTimeout=5 \
    -o StrictHostKeyChecking=no \
    -o UserKnownHostsFile=/dev/null \
    "${control_user}@${control_ipv4}" \
    "cd /home/${control_user}/orbit && orbit gateway:add 10.6.0.2 --json" </dev/null 2>&1)"
gateway_add_exit_code=$?
set -e

if [ "$gateway_add_exit_code" -ne 0 ]; then
    echo "orbit-e2e gateway:add failed with exit code ${gateway_add_exit_code}" >&2
    echo "$gateway_add_output" >&2
    exit 1
fi

echo "orbit-e2e gateway:add output:"
echo "$gateway_add_output"

# Verify the response contains expected success fields
if ! echo "$gateway_add_output" | grep -q '"success"'; then
    echo "orbit-e2e failed: gateway:add did not return a success response" >&2
    echo "$gateway_add_output" >&2
    exit 1
fi

echo "orbit-e2e gateway:add passed: control=${control_ipv4} gateway=${gateway_ipv4}"
REMOTE
}

gateway_trust() {
    ssh "$E2E_HOST" "bash -s" -- \
        "$E2E_CONTROL_IMAGE" \
        "$E2E_GATEWAY_IMAGE" \
        "$E2E_CONTROL_USER" \
        "$E2E_PREFIX" \
        "$E2E_TIMEOUT_SECONDS" \
        "$E2E_CPUS" \
        "$E2E_MEMORY" \
        "$E2E_KEEP" <<'REMOTE'
set -euo pipefail

control_image="$1"
gateway_image="$2"
control_user="$3"
prefix="$4"
timeout_seconds="$5"
cpus="$6"
memory="$7"
keep="$8"

run_id="$(date +%Y%m%d%H%M%S)-$$"
control_name="${prefix}-${run_id}-control"
gateway_name="${prefix}-${run_id}-gateway"
run_dir="/tmp/${prefix}-${run_id}-gateway-trust"

cleanup() {
    status=$?
    set +e

    if [ "$status" -ne 0 ] && [ "$keep" = "1" ]; then
        echo "orbit-e2e keeping instances ${control_name} and ${gateway_name} on $(hostname) because ORBIT_E2E_KEEP=1" >&2
    else
        incus delete --force "$control_name" >/dev/null 2>&1
        incus delete --force "$gateway_name" >/dev/null 2>&1
        rm -rf "$run_dir"
    fi

    return "$status"
}

extract_ipv4() {
    incus list "$1" --format csv -c 4 | grep -Eo '([0-9]{1,3}\.){3}[0-9]{1,3}' | head -n 1 || true
}

wait_for_agent() {
    instance="$1"
    deadline=$((SECONDS + timeout_seconds))

    while [ "$SECONDS" -lt "$deadline" ]; do
        if incus exec "$instance" -- true </dev/null >/dev/null 2>&1; then
            return 0
        fi

        sleep 2
    done

    echo "orbit-e2e failed: Incus agent never became ready on ${instance} within ${timeout_seconds}s" >&2
    incus list "$instance" </dev/null >&2 || true
    return 1
}

wait_for_ipv4() {
    instance="$1"
    deadline=$((SECONDS + timeout_seconds))

    while [ "$SECONDS" -lt "$deadline" ]; do
        ipv4="$(extract_ipv4 "$instance")"

        if [ -n "$ipv4" ]; then
            echo "$ipv4"
            return 0
        fi

        sleep 2
    done

    echo "orbit-e2e failed: ${instance} did not receive an IPv4 address within ${timeout_seconds}s" >&2
    incus list "$instance" </dev/null >&2 || true
    return 1
}

wait_for_ssh() {
    ipv4="$1"
    key="$2"
    ssh_user="$3"
    deadline=$((SECONDS + timeout_seconds))

    while [ "$SECONDS" -lt "$deadline" ]; do
        if ssh \
            -i "$key" \
            -o BatchMode=yes \
            -o ConnectTimeout=5 \
            -o StrictHostKeyChecking=no \
            -o UserKnownHostsFile=/dev/null \
            "${ssh_user}@${ipv4}" \
            "test \"\$(uname -s)\" = Linux && test -r /etc/os-release" </dev/null >/dev/null 2>&1; then
            return 0
        fi

        sleep 3
    done

    echo "orbit-e2e failed: SSH never became ready on ${ipv4} within ${timeout_seconds}s" >&2
    return 1
}

trap cleanup EXIT

command -v incus >/dev/null
command -v ssh-keygen >/dev/null
command -v ssh >/dev/null

if ! incus image info "$control_image" >/dev/null 2>&1; then
    echo "orbit-e2e missing control image: ${control_image}; run bin/e2e --prepare-control first" >&2
    exit 2
fi

if ! incus image info "$gateway_image" >/dev/null 2>&1; then
    echo "orbit-e2e missing gateway image: ${gateway_image}; run bin/e2e --prepare-gateway first" >&2
    exit 2
fi

rm -rf "$run_dir"
mkdir -p "$run_dir"

ssh-keygen -t ed25519 -N '' -f "$run_dir/id_ed25519" -C "orbit-e2e-${run_id}" >/dev/null

echo "orbit-e2e launching ${control_name} from ${control_image} and ${gateway_name} from ${gateway_image} on $(hostname)"

incus launch "$control_image" "$control_name" --vm \
    --config=limits.cpu="$cpus" \
    --config=limits.memory="$memory" </dev/null >/dev/null

sleep 3

incus launch "$gateway_image" "$gateway_name" --vm \
    --config=limits.cpu="$cpus" \
    --config=limits.memory="$memory" </dev/null >/dev/null

wait_for_agent "$control_name"
wait_for_agent "$gateway_name"

# Set up SSH access on control VM
incus exec "$control_name" -- sh -lc "install -d -m 700 -o ${control_user} -g ${control_user} /home/${control_user}/.ssh" </dev/null >/dev/null
incus file push "$run_dir/id_ed25519.pub" "$control_name/home/${control_user}/.ssh/authorized_keys" </dev/null >/dev/null
incus exec "$control_name" -- sh -lc "chown ${control_user}:${control_user} /home/${control_user}/.ssh/authorized_keys && chmod 600 /home/${control_user}/.ssh/authorized_keys && systemctl start ssh || systemctl start sshd || true" </dev/null >/dev/null

# Set up SSH access on gateway VM for orbit user
incus exec "$gateway_name" -- sh -lc "install -d -m 700 -o orbit -g orbit /home/orbit/.ssh" </dev/null >/dev/null
incus file push "$run_dir/id_ed25519.pub" "$gateway_name/home/orbit/.ssh/authorized_keys" </dev/null >/dev/null
incus exec "$gateway_name" -- sh -lc "chown orbit:orbit /home/orbit/.ssh/authorized_keys && chmod 600 /home/orbit/.ssh/authorized_keys && systemctl start ssh || systemctl start sshd || true" </dev/null >/dev/null

control_ipv4="$(wait_for_ipv4 "$control_name")"
gateway_ipv4="$(wait_for_ipv4 "$gateway_name")"

# Ensure VMs have distinct IPs; retry briefly if they collide
ip_check_deadline=$((SECONDS + 30))
while [ "$SECONDS" -lt "$ip_check_deadline" ] && [ "$control_ipv4" = "$gateway_ipv4" ]; do
    sleep 2
    control_ipv4="$(extract_ipv4 "$control_name")"
    gateway_ipv4="$(extract_ipv4 "$gateway_name")"
done

if [ "$control_ipv4" = "$gateway_ipv4" ]; then
    echo "orbit-e2e failed: control and gateway VMs have the same IP (${control_ipv4})" >&2
    exit 1
fi

wait_for_ssh "$control_ipv4" "$run_dir/id_ed25519" "$control_user"
wait_for_ssh "$gateway_ipv4" "$run_dir/id_ed25519" "orbit"

echo "orbit-e2e control VM ready at ${control_ipv4}"
echo "orbit-e2e gateway VM ready at ${gateway_ipv4}"

# Configure gateway VM with a dummy interface at the expected gateway WireGuard IP
# so the gateway API is reachable at 10.6.0.2 from the control VM
incus exec "$gateway_name" -- sh -lc "ip link add dummy0 type dummy 2>/dev/null || true && ip addr add 10.6.0.2/16 dev dummy0 2>/dev/null || true && ip link set dummy0 up 2>/dev/null || true" </dev/null >/dev/null

# Start gateway API server on the dummy interface
incus exec "$gateway_name" -- sudo -iu orbit bash -lc "cd /home/orbit/orbit && nohup php artisan serve --host=10.6.0.2 --port=80 > /tmp/gateway-api.log 2>&1 &" </dev/null >/dev/null

# Give the server a moment to start
sleep 3

# Verify the gateway CA endpoint is responding
if ! incus exec "$gateway_name" -- sh -lc "curl -s http://10.6.0.2/api/ca/root | grep -q 'BEGIN CERTIFICATE'" </dev/null >/dev/null 2>&1; then
    echo "orbit-e2e failed: Gateway CA endpoint is not responding" >&2
    exit 1
fi

echo "orbit-e2e gateway CA endpoint verified"

# Seed gateway node into control database so gateway:trust can resolve it
ssh \
    -i "$run_dir/id_ed25519" \
    -o BatchMode=yes \
    -o ConnectTimeout=5 \
    -o StrictHostKeyChecking=no \
    -o UserKnownHostsFile=/dev/null \
    "${control_user}@${control_ipv4}" \
    "sqlite3 /home/${control_user}/orbit/database/database.sqlite \"INSERT INTO nodes (name, role, environment, platform, host, wireguard_address, gateway_endpoint, ssh_user, user, orbit_path, status, is_local, created_at, updated_at) VALUES ('gateway-1', 'gateway', NULL, 'unknown', '${gateway_ipv4}', '10.6.0.2', '${gateway_ipv4}', 'orbit', 'orbit', '/home/orbit/orbit', 'active', 0, datetime('now'), datetime('now'));\"" </dev/null >/dev/null

echo "orbit-e2e seeded gateway node into control database"

# Run gateway:trust from the control VM
# NOTE: gateway:trust needs root to write to the OS trust store.
echo "orbit-e2e running 'orbit gateway:trust --json' from control VM"

set +e
trust_output="$(ssh \
    -i "$run_dir/id_ed25519" \
    -o BatchMode=yes \
    -o ConnectTimeout=5 \
    -o StrictHostKeyChecking=no \
    -o UserKnownHostsFile=/dev/null \
    "${control_user}@${control_ipv4}" \
    "cd /home/${control_user}/orbit && sudo orbit gateway:trust --json" </dev/null 2>&1)"
trust_exit_code=$?
set -e

if [ "$trust_exit_code" -ne 0 ]; then
    echo "orbit-e2e gateway:trust failed with exit code ${trust_exit_code}" >&2
    echo "$trust_output" >&2
    exit 1
fi

echo "orbit-e2e gateway:trust output:"
echo "$trust_output"

# Verify 1: JSON response indicates success
if ! echo "$trust_output" | grep -q '"trusted":true'; then
    echo "orbit-e2e failed: gateway:trust did not report trusted=true" >&2
    echo "$trust_output" >&2
    exit 1
fi

# Verify 2: CA file is installed in the local trust store
if ! ssh \
    -i "$run_dir/id_ed25519" \
    -o BatchMode=yes \
    -o ConnectTimeout=5 \
    -o StrictHostKeyChecking=no \
    -o UserKnownHostsFile=/dev/null \
    "${control_user}@${control_ipv4}" \
    "test -f /usr/local/share/ca-certificates/orbit-gateway-ca-orbit.crt" </dev/null >/dev/null 2>&1; then
    echo "orbit-e2e failed: Gateway CA was not installed in local trust store" >&2
    exit 1
fi

echo "orbit-e2e local trust store verified"

# Verify 3: idempotence — re-run gateway:trust and expect already_trusted
echo "orbit-e2e re-running gateway:trust for idempotence check"

set +e
trust_output2="$(ssh \
    -i "$run_dir/id_ed25519" \
    -o BatchMode=yes \
    -o ConnectTimeout=5 \
    -o StrictHostKeyChecking=no \
    -o UserKnownHostsFile=/dev/null \
    "${control_user}@${control_ipv4}" \
    "cd /home/${control_user}/orbit && sudo orbit gateway:trust --json" </dev/null 2>&1)"
trust_exit_code2=$?
set -e

if [ "$trust_exit_code2" -ne 0 ]; then
    echo "orbit-e2e gateway:trust idempotence run failed with exit code ${trust_exit_code2}" >&2
    echo "$trust_output2" >&2
    exit 1
fi

if ! echo "$trust_output2" | grep -q '"status":"already_trusted"'; then
    echo "orbit-e2e failed: gateway:trust idempotence check did not return already_trusted" >&2
    echo "$trust_output2" >&2
    exit 1
fi

echo "orbit-e2e gateway:trust idempotence verified"

echo "orbit-e2e gateway:trust passed: control=${control_ipv4} gateway=${gateway_ipv4}"
REMOTE
}

case "${1:-}" in
    -h|--help)
        usage
        exit 0
        ;;
    *)
        validate_user_config
        ;;
esac

case "${1:---lifecycle}" in
    --preflight)
        preflight
        ;;
    --prepare-blank)
        prepare_blank
        ;;
    --prepare-control)
        prepare_control
        ;;
    --prepare-gateway)
        prepare_gateway
        ;;
    --lifecycle)
        lifecycle
        ;;
    --control)
        control
        ;;
    --node-new-gateway)
        node_new_gateway
        ;;
    --gateway-add)
        gateway_add
        ;;
    *)
        echo "error: unknown mode '$1'" >&2
        usage >&2
        exit 2
        ;;
esac
