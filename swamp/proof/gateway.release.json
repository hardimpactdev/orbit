{
  "kind": "gateway.release",
  "workflow": "operation-gateway-release",
  "topology": "minimal",
  "clean": true,
  "budget_seconds": 1800,
  "queue_timeout_seconds": 120,
  "before_gateway": [
    [
      "python3",
      "-I",
      "swamp/proof/gateway.release/release_fixture.py",
      "setup",
      "${node.gateway}"
    ]
  ],
  "prepare": [
    {
      "method": "POST",
      "path": "processes",
      "body": {
        "target_type": "node",
        "target_id": "${node.gateway}",
        "name": "schedule-work",
        "runtime": "systemd",
        "command": ["/usr/bin/php8.5", "artisan", "schedule:work"],
        "working_directory": "/home/orbit/orbit/apps/gateway",
        "user": "orbit",
        "start": true
      }
    }
  ],
  "after_prepare": [
    [
      "runuser",
      "-u",
      "orbit",
      "--",
      "php",
      "swamp/proof/gateway.release/admit.php",
      "${fixture.target}"
    ]
  ],
  "request": {
    "method": "GET",
    "path": "operations/${fixture.operation}"
  },
  "expect": {
    "status": "succeeded"
  },
  "phases": [
    {"name": "Build", "job": "release", "step": "Build the release", "budget_seconds": 900},
    {"name": "Web build", "job": "release", "step": "Install the web build", "budget_seconds": 120},
    {"name": "Snapshot", "job": "release", "step": "Snapshot the database", "budget_seconds": 120},
    {"name": "Migrate", "job": "release", "step": "Migrate", "budget_seconds": 300},
    {"name": "Load Swamp", "job": "release", "step": "Load Swamp on Node 209", "budget_seconds": 300},
    {"name": "Hand over", "job": "release", "step": "Hand over the release", "budget_seconds": 900},
    {"name": "Record", "job": "release", "step": "Record the release", "budget_seconds": 60}
  ],
  "parity": ["swamp/proof/gateway.release/release_fixture.py", "parity"]
}
