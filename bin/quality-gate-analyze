#!/usr/bin/env php
<?php

declare(strict_types=1);

const DEFAULT_WARNING_THRESHOLD_PERCENT = 25;
const MIN_SUBGATE_WARNING_DELTA_SECONDS = 1.0;
const MIN_TIMING_PHASE_WARNING_DELTA_SECONDS = 1.0;
const TIMING_TRIAGE_SKILL_PATH = '.agents/skills/quality-gate-triage/SKILL.md';

$options = getopt('', [
    'artifact-dir::',
    'gate:',
    'max-age-hours::',
]);

try {
    $artifactDir = optional_string($options, 'artifact-dir', default_artifact_dir());
    $expectedGates = expected_gates(repeated_values($options, 'gate'));
    $maxAgeHours = optional_positive_int($options, 'max-age-hours', 168);

    $artifacts = load_artifacts($artifactDir);
    $latestByGate = latest_artifacts_by_gate($artifacts);
    $now = new DateTimeImmutable('now', new DateTimeZone('UTC'));
    $currentCommit = current_git_commit();

    fwrite(STDOUT, 'Quality gate analyzer'.PHP_EOL);
    fwrite(STDOUT, 'Artifact directory: '.$artifactDir.PHP_EOL.PHP_EOL);

    foreach ($expectedGates as $gate) {
        $latest = $latestByGate[$gate] ?? null;

        if ($latest === null) {
            fwrite(STDOUT, "missing evidence: no artifact found for gate [{$gate}]".PHP_EOL);

            continue;
        }

        $ageHours = artifact_age_hours($latest, $now);

        if ($ageHours > $maxAgeHours) {
            fwrite(STDOUT, sprintf(
                'missing evidence: latest [%s] artifact is %.1f hours old (max %.1f hours)%s',
                $gate,
                $ageHours,
                (float) $maxAgeHours,
                PHP_EOL,
            ));
        }

        write_commit_freshness_warning($gate, $latest, $currentCommit);

        fwrite(STDOUT, sprintf(
            'recent run: gate=%s duration=%.1fs exit=%d mode=%s branch=%s commit=%s ended_at=%s%s',
            $gate,
            (float) ($latest['duration_seconds'] ?? 0),
            (int) ($latest['exit_code'] ?? 1),
            (string) ($latest['mode'] ?? 'unknown'),
            (string) ($latest['git']['branch'] ?? 'unknown'),
            (string) ($latest['git']['commit'] ?? 'unknown'),
            (string) ($latest['ended_at'] ?? 'unknown'),
            PHP_EOL,
        ));

        write_subgate_durations($latest);
        write_e2e_context($latest);
        write_test_summary($latest);
        write_timing_summary($latest);

        $baseline = load_baseline($artifactDir, $gate);

        if ($baseline === null) {
            fwrite(STDOUT, "baseline: no local baseline for gate [{$gate}]".PHP_EOL);

            continue;
        }

        $baselineDuration = (float) ($baseline['duration_seconds'] ?? 0);
        $runDuration = (float) ($latest['duration_seconds'] ?? 0);

        if ($baselineDuration <= 0) {
            fwrite(STDOUT, "baseline: invalid duration for gate [{$gate}]".PHP_EOL);

            continue;
        }

        $thresholdPercent = baseline_warning_threshold_percent($baseline);
        $thresholdMultiplier = 1 + ($thresholdPercent / 100);
        $needsTimingTriage = false;

        if ($runDuration > ($baselineDuration * $thresholdMultiplier)) {
            fwrite(STDOUT, sprintf(
                'warning: gate [%s] duration %.1fs exceeds local baseline %.1fs (warning-only)%s',
                $gate,
                $runDuration,
                $baselineDuration,
                PHP_EOL,
            ));
            $needsTimingTriage = true;
        } else {
            fwrite(STDOUT, sprintf(
                'baseline: gate [%s] duration %.1fs is within local baseline %.1fs%s',
                $gate,
                $runDuration,
                $baselineDuration,
                PHP_EOL,
            ));
        }

        if (write_subgate_duration_warnings($gate, $latest, $baseline, $thresholdMultiplier)) {
            $needsTimingTriage = true;
        }

        if (write_timing_phase_warnings($gate, $latest, $baseline, $thresholdMultiplier)) {
            $needsTimingTriage = true;
        }

        if ($needsTimingTriage) {
            fwrite(STDOUT, 'timing triage: '.TIMING_TRIAGE_SKILL_PATH.PHP_EOL);
        }
    }

    fwrite(STDOUT, PHP_EOL.'Analyzer did not rerun quality-check or E2E lanes.'.PHP_EOL);
} catch (Throwable $exception) {
    fwrite(STDERR, $exception->getMessage().PHP_EOL);
    exit(1);
}

/**
 * @param  array<string, mixed>  $options
 */
function optional_string(array $options, string $key, string $default = ''): string
{
    $value = $options[$key] ?? $default;

    if (! is_string($value)) {
        return $default;
    }

    return trim($value);
}

/**
 * @param  array<string, mixed>  $options
 */
function optional_positive_int(array $options, string $key, int $default): int
{
    $value = $options[$key] ?? $default;

    if ($value === false || ! is_numeric($value)) {
        return $default;
    }

    $parsed = (int) $value;

    return $parsed > 0 ? $parsed : $default;
}

/**
 * @return list<string>
 */
function repeated_values(array $options, string $key): array
{
    $value = $options[$key] ?? [];

    if (is_string($value)) {
        return [$value];
    }

    if (! is_array($value)) {
        return [];
    }

    return array_values(array_filter($value, fn (mixed $item): bool => is_string($item) && $item !== ''));
}

/**
 * @param  list<string>  $gates
 * @return list<string>
 */
function expected_gates(array $gates): array
{
    if ($gates !== []) {
        return array_values(array_unique($gates));
    }

    return ['quality-check'];
}

function default_artifact_dir(): string
{
    $root = dirname(__DIR__);

    return $root.'/.orbit/quality-gates';
}

/**
 * @return list<array<string, mixed>>
 */
function load_artifacts(string $artifactDir): array
{
    if (! is_dir($artifactDir)) {
        return [];
    }

    $artifacts = [];

    foreach (glob(rtrim($artifactDir, '/').'/*.json') ?: [] as $path) {
        if (! is_file($path)) {
            continue;
        }

        $decoded = json_decode((string) file_get_contents($path), true);

        if (! is_array($decoded) || ! isset($decoded['gate'], $decoded['ended_at'])) {
            continue;
        }

        $decoded['_path'] = $path;
        $artifacts[] = $decoded;
    }

    usort(
        $artifacts,
        fn (array $left, array $right): int => strcmp((string) $right['ended_at'], (string) $left['ended_at']),
    );

    return $artifacts;
}

/**
 * @param  list<array<string, mixed>>  $artifacts
 * @return array<string, array<string, mixed>>
 */
function latest_artifacts_by_gate(array $artifacts): array
{
    $latest = [];

    foreach ($artifacts as $artifact) {
        $gate = (string) $artifact['gate'];

        if (! isset($latest[$gate])) {
            $latest[$gate] = $artifact;
        }
    }

    return $latest;
}

/**
 * @return array<string, mixed>|null
 */
function load_baseline(string $artifactDir, string $gate): ?array
{
    $path = rtrim($artifactDir, '/').'/baselines/'.$gate.'.json';

    if (! is_file($path)) {
        return null;
    }

    $decoded = json_decode((string) file_get_contents($path), true);

    return is_array($decoded) ? $decoded : null;
}

/**
 * @param  array<string, mixed>  $artifact
 */
function artifact_age_hours(array $artifact, DateTimeImmutable $now): float
{
    $endedAt = DateTimeImmutable::createFromFormat(DateTimeInterface::ATOM, normalize_timestamp((string) $artifact['ended_at']));

    if ($endedAt === false) {
        return INF;
    }

    return max(0.0, ($now->getTimestamp() - $endedAt->getTimestamp()) / 3600);
}

function normalize_timestamp(string $timestamp): string
{
    if (str_ends_with($timestamp, 'Z')) {
        return substr($timestamp, 0, -1).'+00:00';
    }

    return $timestamp;
}

function current_git_commit(): ?string
{
    $command = ['git', '-C', dirname(__DIR__), 'rev-parse', 'HEAD'];
    $descriptorSpec = [
        1 => ['pipe', 'w'],
        2 => ['pipe', 'w'],
    ];

    $process = proc_open($command, $descriptorSpec, $pipes);

    if (! is_resource($process)) {
        return null;
    }

    $output = stream_get_contents($pipes[1]);
    stream_get_contents($pipes[2]);

    fclose($pipes[1]);
    fclose($pipes[2]);

    if (proc_close($process) !== 0 || ! is_string($output)) {
        return null;
    }

    $commit = trim($output);

    return is_full_git_commit($commit) ? strtolower($commit) : null;
}

/**
 * @param  array<string, mixed>  $artifact
 */
function write_commit_freshness_warning(string $gate, array $artifact, ?string $currentCommit): void
{
    if ($currentCommit === null) {
        return;
    }

    $artifactCommit = artifact_git_commit($artifact);

    if ($artifactCommit === null || $artifactCommit === $currentCommit) {
        return;
    }

    fwrite(STDOUT, sprintf(
        'missing evidence: latest [%s] artifact commit %s does not match current HEAD %s%s',
        $gate,
        $artifactCommit,
        $currentCommit,
        PHP_EOL,
    ));
}

/**
 * @param  array<string, mixed>  $artifact
 */
function artifact_git_commit(array $artifact): ?string
{
    $git = $artifact['git'] ?? null;

    if (! is_array($git)) {
        return null;
    }

    $commit = $git['commit'] ?? null;

    if (! is_string($commit)) {
        return null;
    }

    $commit = trim($commit);

    return is_full_git_commit($commit) ? strtolower($commit) : null;
}

function is_full_git_commit(string $value): bool
{
    return preg_match('/\A[0-9a-f]{40}\z/i', $value) === 1;
}

/**
 * @param  array<string, mixed>  $baseline
 */
function baseline_warning_threshold_percent(array $baseline): float
{
    $value = $baseline['warning_threshold_percent'] ?? null;

    if (! is_numeric($value)) {
        return (float) DEFAULT_WARNING_THRESHOLD_PERCENT;
    }

    $parsed = (float) $value;

    return $parsed > 0 ? $parsed : (float) DEFAULT_WARNING_THRESHOLD_PERCENT;
}

/**
 * @param  array<string, mixed>  $artifact
 */
function write_subgate_durations(array $artifact): void
{
    $durations = subgate_durations($artifact);

    if ($durations === []) {
        return;
    }

    $labels = array_keys($durations);
    sort($labels);

    foreach ($labels as $label) {
        $seconds = $durations[$label];

        if (! is_numeric($seconds)) {
            continue;
        }

        fwrite(STDOUT, sprintf(
            'subgate duration: %s=%.1fs%s',
            $label,
            (float) $seconds,
            PHP_EOL,
        ));
    }
}

/**
 * @param  array<string, mixed>  $artifact
 */
function write_timing_summary(array $artifact): void
{
    $summary = $artifact['timing_summary'] ?? null;

    if (! is_array($summary)) {
        return;
    }

    $summaryPath = $summary['summary_path'] ?? null;

    if (is_string($summaryPath) && trim($summaryPath) !== '') {
        fwrite(STDOUT, 'timing summary: '.trim($summaryPath).PHP_EOL);
    }

    $lines = $summary['summary_lines'] ?? null;

    if (! is_array($lines)) {
        return;
    }

    foreach ($lines as $line) {
        if (! is_string($line) || trim($line) === '') {
            continue;
        }

        fwrite(STDOUT, 'timing phase: '.trim($line).PHP_EOL);
    }
}

/**
 * @param  array<string, mixed>  $artifact
 */
function write_e2e_context(array $artifact): void
{
    $context = $artifact['e2e_context'] ?? null;

    if (! is_array($context)) {
        return;
    }

    $plans = $context['plans'] ?? null;

    if (! is_array($plans)) {
        return;
    }

    foreach ($plans as $plan) {
        if (! is_array($plan)) {
            continue;
        }

        fwrite(STDOUT, sprintf(
            'e2e plan: lane=%s provider=%s lane_mode=%s test_mode=%s command_processes=%s test_files=%s%s',
            metadata_string($plan['lane'] ?? null, 'unknown'),
            metadata_string($plan['provider'] ?? null, 'unknown'),
            metadata_string($plan['lane_execution_mode'] ?? null, 'unknown'),
            metadata_string($plan['test_execution_mode'] ?? null, 'unknown'),
            metadata_string($plan['command_processes'] ?? null, 'none'),
            metadata_string($plan['test_file_count'] ?? null, 'unknown'),
            PHP_EOL,
        ));

        $environment = is_array($plan['environment'] ?? null) ? $plan['environment'] : [];
        $environmentParts = [];

        foreach ($environment as $key => $value) {
            if (! is_string($key) || trim($key) === '') {
                continue;
            }

            $environmentParts[] = trim($key).'='.metadata_string($value, 'unknown');
        }

        if ($environmentParts !== []) {
            fwrite(STDOUT, 'e2e plan env: '.implode(' ', $environmentParts).PHP_EOL);
        }
    }
}

/**
 * @param  array<string, mixed>  $artifact
 */
function write_test_summary(array $artifact): void
{
    $summary = $artifact['test_summary'] ?? null;

    if (! is_array($summary)) {
        return;
    }

    $tests = $summary['tests'] ?? null;
    $assertions = $summary['assertions'] ?? null;
    $status = $summary['status'] ?? null;

    if (! is_numeric($tests) || ! is_numeric($assertions) || ! is_string($status) || trim($status) === '') {
        return;
    }

    fwrite(STDOUT, sprintf(
        'test summary: %d tests, %d assertions, %s%s',
        (int) $tests,
        (int) $assertions,
        trim($status),
        PHP_EOL,
    ));
}

function metadata_string(mixed $value, string $default): string
{
    if (is_int($value) || is_float($value)) {
        return (string) $value;
    }

    if (is_bool($value)) {
        return $value ? 'true' : 'false';
    }

    if (! is_string($value) || trim($value) === '') {
        return $default;
    }

    return trim($value);
}

/**
 * @param  array<string, mixed>  $artifact
 * @param  array<string, mixed>  $baseline
 */
function write_subgate_duration_warnings(string $gate, array $artifact, array $baseline, float $thresholdMultiplier): bool
{
    $artifactDurations = subgate_durations($artifact);
    $baselineDurations = subgate_durations($baseline);

    if ($artifactDurations === [] || $baselineDurations === []) {
        return false;
    }

    $warned = false;
    $labels = array_keys($artifactDurations);

    foreach ($labels as $label) {
        $baselineSeconds = $baselineDurations[$label] ?? null;

        if ($baselineSeconds === null || $baselineSeconds <= 0) {
            continue;
        }

        $runSeconds = $artifactDurations[$label];
        $deltaSeconds = $runSeconds - $baselineSeconds;

        if ($runSeconds <= ($baselineSeconds * $thresholdMultiplier)) {
            continue;
        }

        if ($deltaSeconds < MIN_SUBGATE_WARNING_DELTA_SECONDS) {
            continue;
        }

        fwrite(STDOUT, sprintf(
            'warning: subgate [%s:%s] duration %.1fs exceeds local baseline %.1fs (warning-only)%s',
            $gate,
            $label,
            $runSeconds,
            $baselineSeconds,
            PHP_EOL,
        ));

        $warned = true;
    }

    return $warned;
}

/**
 * @param  array<string, mixed>  $artifact
 * @param  array<string, mixed>  $baseline
 */
function write_timing_phase_warnings(string $gate, array $artifact, array $baseline, float $thresholdMultiplier): bool
{
    $artifactPhases = timing_phases($artifact);
    $baselinePhases = timing_phases($baseline);

    if ($artifactPhases === [] || $baselinePhases === []) {
        return false;
    }

    $warned = false;
    $labels = array_keys($artifactPhases);

    foreach ($labels as $label) {
        $baselinePhase = $baselinePhases[$label] ?? null;

        if ($baselinePhase === null || $baselinePhase['p95'] <= 0) {
            continue;
        }

        $runPhase = $artifactPhases[$label];
        $runP95 = $runPhase['p95'];
        $baselineP95 = $baselinePhase['p95'];
        $deltaSeconds = $runP95 - $baselineP95;

        if ($runP95 <= ($baselineP95 * $thresholdMultiplier)) {
            continue;
        }

        if ($deltaSeconds < MIN_TIMING_PHASE_WARNING_DELTA_SECONDS) {
            continue;
        }

        fwrite(STDOUT, sprintf(
            'warning: timing phase [%s:%s] p95 %.1fs exceeds local baseline %.1fs (warning-only)%s',
            $gate,
            $label,
            $runP95,
            $baselineP95,
            PHP_EOL,
        ));

        $warned = true;
    }

    return $warned;
}

/**
 * @param  array<string, mixed>  $source
 * @return array<string, float>
 */
function subgate_durations(array $source): array
{
    $durations = $source['subgate_durations'] ?? null;

    if (! is_array($durations)) {
        return [];
    }

    $parsedDurations = [];

    foreach ($durations as $label => $seconds) {
        if (! is_string($label) || trim($label) === '' || ! is_numeric($seconds)) {
            continue;
        }

        $parsed = (float) $seconds;

        if ($parsed < 0) {
            continue;
        }

        $parsedDurations[$label] = $parsed;
    }

    ksort($parsedDurations);

    return $parsedDurations;
}

/**
 * @param  array<string, mixed>  $source
 * @return array<string, array{sample_count: int, p50: float, p95: float}>
 */
function timing_phases(array $source): array
{
    $storedPhases = $source['timing_phases'] ?? null;

    if (is_array($storedPhases)) {
        return parsed_timing_phases($storedPhases);
    }

    $summary = $source['timing_summary'] ?? null;

    if (! is_array($summary) || ! is_array($summary['summary_lines'] ?? null)) {
        return [];
    }

    $phases = [];

    foreach ($summary['summary_lines'] as $line) {
        if (! is_string($line)) {
            continue;
        }

        $phase = timing_phase_from_summary_line($line);

        if ($phase === null) {
            continue;
        }

        $phases[$phase['label']] = [
            'sample_count' => $phase['sample_count'],
            'p50' => $phase['p50'],
            'p95' => $phase['p95'],
        ];
    }

    ksort($phases);

    return $phases;
}

/**
 * @param  array<mixed>  $storedPhases
 * @return array<string, array{sample_count: int, p50: float, p95: float}>
 */
function parsed_timing_phases(array $storedPhases): array
{
    $phases = [];

    foreach ($storedPhases as $label => $phase) {
        if (! is_string($label) || trim($label) === '' || ! is_array($phase)) {
            continue;
        }

        $sampleCount = $phase['sample_count'] ?? null;
        $p50 = $phase['p50'] ?? null;
        $p95 = $phase['p95'] ?? null;

        if (! is_numeric($sampleCount) || ! is_numeric($p50) || ! is_numeric($p95)) {
            continue;
        }

        $parsedSampleCount = (int) $sampleCount;
        $parsedP50 = (float) $p50;
        $parsedP95 = (float) $p95;

        if ($parsedSampleCount <= 0 || $parsedP50 < 0 || $parsedP95 < 0) {
            continue;
        }

        $phases[trim($label)] = [
            'sample_count' => $parsedSampleCount,
            'p50' => $parsedP50,
            'p95' => $parsedP95,
        ];
    }

    ksort($phases);

    return $phases;
}

/**
 * @return array{label: string, sample_count: int, p50: float, p95: float}|null
 */
function timing_phase_from_summary_line(string $line): ?array
{
    $line = trim($line);

    if (preg_match('/^(.+?)\s+n=([0-9]+)\s+p50=([0-9]+(?:\.[0-9]+)?)\s+p95=([0-9]+(?:\.[0-9]+)?)$/', $line, $matches) !== 1) {
        return null;
    }

    $sampleCount = (int) $matches[2];
    $p50 = (float) $matches[3];
    $p95 = (float) $matches[4];

    if ($sampleCount <= 0 || $p50 < 0 || $p95 < 0) {
        return null;
    }

    return [
        'label' => trim($matches[1]),
        'sample_count' => $sampleCount,
        'p50' => $p50,
        'p95' => $p95,
    ];
}
