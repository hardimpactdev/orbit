#!/usr/bin/env php
<?php

declare(strict_types=1);

$root = dirname(__DIR__);
$helper = $root.'/bin/orbit-firewall-retained-proof.php';

require $helper;

try {
    firewall_proof_require_root_autoload($root);
    firewall_proof_require_process_autoload($root);
} catch (Throwable $exception) {
    fwrite(STDERR, $exception->getMessage()."\n");
    exit(2);
}

$options = [];

foreach (array_slice($argv, 1) as $argument) {
    if ($argument === '--dry-run') {
        $options['dry-run'] = true;
        continue;
    }

    if ($argument === '--cleanup') {
        $options['cleanup'] = true;
        continue;
    }

    if (str_starts_with($argument, '--candidate=')) {
        $options['candidate'] = substr($argument, 12);
        continue;
    }

    if (str_starts_with($argument, '--receipt=')) {
        $options['receipt'] = substr($argument, 10);
        continue;
    }

    fwrite(STDERR, "unknown argument: {$argument}\n");
    exit(2);
}

load_e2e_environment($root);

try {
    $candidate = local_firewall_proof_candidate($root, $options['candidate'] ?? null);
    $statePath = $root.'/.orbit/evidence/firewall-retained-proof/'.$candidate.'.json';
    $receiptPath = $options['receipt'] ?? $statePath;

    if (($options['dry-run'] ?? false) === true) {
        fwrite(STDOUT, json_encode([
            'candidate' => $candidate,
            'steps' => ['allow', 'list', 'doctor', 'remove'],
            'seed' => firewall_proof_seed_commands(),
        ], JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR)."\n");
        exit(0);
    }

    if (($options['cleanup'] ?? false) === true) {
        $state = firewall_proof_validate_state(read_firewall_proof_state($statePath), $candidate);
        firewall_proof_cleanup_seed_rules($state);
        @unlink($statePath);
        exit(0);
    }

    $topology = acquire_firewall_proof_topology($root, $candidate, $statePath);
    $identity = bind_remote_firewall_proof_identity($root, $candidate, $topology);
    $state = [
        ...$identity,
        'topology_id' => $identity['target'],
        'checkouts' => $topology['checkouts'] ?? [],
    ];
    write_json_file($statePath, $state);
    $observed = run_firewall_proof_scenario($state);
    $receipt = firewall_proof_receipt([
        'candidate' => $identity['candidate'],
        'target' => $identity['target'],
        'binding' => $identity['binding'],
        'checkout_digest' => $identity['checkout_digest'],
        'expected' => 'allow-list-doctor-remove pass with owned comment and unrelated same-port preserved',
        'observed' => $observed,
        'result' => 'passed',
        'evidence' => relative_repo_path($root, $receiptPath),
    ]);
    write_json_file($receiptPath, [
        ...$state,
        'receipt' => $receipt,
        'observed' => $observed,
        'result' => 'passed',
    ]);
    fwrite(STDOUT, $receipt."\n");
} catch (Throwable $exception) {
    fwrite(STDERR, $exception->getMessage()."\n");

    if (isset($candidate, $receiptPath, $identity) && is_array($identity ?? null)) {
        $receipt = firewall_proof_receipt([
            'candidate' => $identity['candidate'],
            'target' => $identity['target'],
            'binding' => $identity['binding'],
            'checkout_digest' => $identity['checkout_digest'],
            'expected' => 'allow-list-doctor-remove pass with owned comment and unrelated same-port preserved',
            'observed' => $exception->getMessage(),
            'result' => 'failed',
            'evidence' => relative_repo_path($root, $receiptPath),
        ]);
        write_json_file($receiptPath, [
            ...$identity,
            'topology_id' => $identity['target'],
            'receipt' => $receipt,
            'observed' => $exception->getMessage(),
            'result' => 'failed',
        ]);
        fwrite(STDOUT, $receipt."\n");
    }

    exit(1);
}

function local_firewall_proof_candidate(string $root, ?string $requestedCandidate): string
{
    $head = trim((string) shell_exec('git -C '.escapeshellarg($root).' rev-parse HEAD'));
    $candidate = $requestedCandidate ?? $head;

    if ($candidate !== $head) {
        throw new InvalidArgumentException('candidate SHA mismatch');
    }

    $dirty = trim((string) shell_exec('git -C '.escapeshellarg($root).' status --porcelain --untracked-files=all'));

    if ($dirty !== '') {
        throw new InvalidArgumentException('candidate SHA mismatch');
    }

    firewall_proof_require_sha($candidate);

    return $candidate;
}

/**
 * @return array<string, mixed>
 */
function acquire_firewall_proof_topology(string $root, string $candidate, string $statePath): array
{
    if (is_file($statePath)) {
        $raw = read_firewall_proof_state($statePath);
        $state = firewall_proof_validate_state($raw, $candidate);
        run_e2e_incus($root, ['--sync', '--id='.$state['target']]);

        return [
            'id' => $state['target'],
            'host' => $state['host'],
            'instances' => $state['instances'],
            'checkouts' => is_array($raw['checkouts'] ?? null) ? $raw['checkouts'] : [],
        ];
    }

    $existing = retained_incus_manifest($root);
    $output = '';

    if (is_array($existing) && is_string($existing['id'] ?? null) && $existing['id'] !== '') {
        firewall_proof_assert_owned_instances($existing['id'], is_array($existing['instances'] ?? null) ? $existing['instances'] : []);
        run_e2e_incus($root, ['--sync', '--id='.$existing['id']]);
        $topology = $existing;
    } else {
        $output = run_e2e_incus($root, [
            '--start',
            '--topology=operator_gateway_app-dev',
            '--json',
        ]);
        $payload = decode_json_object($output, required: false);
        $topology = is_array($payload['success']['dev_topology'] ?? null)
            ? $payload['success']['dev_topology']
            : retained_incus_manifest($root);
    }

    if (! is_array($topology)) {
        throw new RuntimeException('retained Incus acquisition did not return a topology manifest: '.$output);
    }

    $host = strtolower((string) ($topology['host'] ?? ''));
    $topologyId = is_string($topology['id'] ?? null) ? $topology['id'] : (string) ($topology['run_id'] ?? '');
    $instances = is_array($topology['instances'] ?? null) ? $topology['instances'] : [];

    if ($host !== FIREWALL_PROOF_HOST) {
        throw new InvalidArgumentException('target identity mismatch');
    }

    firewall_proof_assert_owned_instances($topologyId, $instances);

    return [
        'id' => $topologyId,
        'host' => $host,
        'instances' => $instances,
        'checkouts' => $topology['checkouts'] ?? [],
    ];
}

/**
 * @param  array<string, mixed>  $topology
 * @return array{candidate: string, binding: string, checkout_digest: string, target: string, host: string, instances: array{operator: string, gateway: string, dev: string}}
 */
function bind_remote_firewall_proof_identity(string $root, string $candidate, array $topology): array
{
    $instances = is_array($topology['instances'] ?? null) ? $topology['instances'] : [];
    $target = is_string($topology['id'] ?? null) ? $topology['id'] : '';
    $gateway = proof_instance(['instances' => $instances], 'gateway');
    $localFiles = firewall_proof_local_synced_files($root);
    $remoteFiles = observe_remote_synced_tree($gateway, $localFiles, $root);
    firewall_proof_assert_synced_trees($localFiles, $remoteFiles);

    return firewall_proof_bind([
        'candidate' => $candidate,
        'local_checkout_digest' => firewall_proof_tree_digest($localFiles),
        'remote_checkout_digest' => firewall_proof_tree_digest($remoteFiles),
        'target' => $target,
        'instances' => $instances,
        'host' => is_string($topology['host'] ?? null) ? strtolower($topology['host']) : FIREWALL_PROOF_HOST,
    ]);
}

/**
 * @param  array<string, mixed>  $state
 */
function run_firewall_proof_scenario(array $state): string
{
    $dev = proof_instance($state, 'dev');
    $gateway = proof_instance($state, 'gateway');
    $checkout = proof_checkout($state, 'gateway');
    $node = FIREWALL_PROOF_NODE;
    $name = FIREWALL_PROOF_RULE_NAME;

    firewall_proof_cleanup_seed_rules($state);

    foreach (firewall_proof_seed_commands() as $command) {
        beast_incus_exec($dev, $command);
    }

    $allowPayload = decode_json_object(beast_incus_exec(
        $gateway,
        "cd {$checkout} && orbit firewall:allow {$name} --node={$node} --port=".FIREWALL_PROOF_PORT
            .' --from='.FIREWALL_PROOF_SOURCE
            .' --protocol='.FIREWALL_PROOF_PROTOCOL
            .' --json',
        asOrbit: true,
        allowFailure: true,
    ));
    firewall_proof_assert_allow_succeeded($allowPayload);

    $listPayload = decode_json_object(beast_incus_exec(
        $gateway,
        "cd {$checkout} && orbit firewall:list --node={$node} --json",
        asOrbit: true,
        allowFailure: true,
    ));

    if (! isset($listPayload['success'])) {
        throw new RuntimeException('failed-step=list');
    }

    $names = array_column($listPayload['success']['data']['rules'] ?? [], 'name');

    if (! in_array($name, $names, true)) {
        throw new RuntimeException('failed-step=list');
    }

    $doctorReport = doctor_report(beast_incus_exec(
        $gateway,
        "cd {$checkout} && orbit doctor --node={$node} --family=firewall_rule --json",
        asOrbit: true,
        allowFailure: true,
    ));
    firewall_proof_assert_doctor_healthy($doctorReport);

    $rules = firewall_proof_parse_ufw(beast_incus_exec($dev, 'sudo ufw status numbered'));
    firewall_proof_assert_single_managed_source($rules, FIREWALL_PROOF_SOURCE);

    if (! firewall_proof_has_comment($rules, FIREWALL_PROOF_PROTECTED_COMMENT)) {
        throw new RuntimeException('failed-step=allow unrelated same-port rule was not preserved');
    }

    if (! firewall_proof_managed_allow_precedes_deny($rules)) {
        throw new RuntimeException('failed-step=allow managed allow did not precede the broad deny');
    }

    $removePayload = decode_json_object(beast_incus_exec(
        $gateway,
        "cd {$checkout} && orbit firewall:remove {$name} --node={$node} --force --json",
        asOrbit: true,
        allowFailure: true,
    ));

    if (! isset($removePayload['success'])) {
        throw new RuntimeException('failed-step=remove');
    }

    $afterRemove = firewall_proof_parse_ufw(beast_incus_exec($dev, 'sudo ufw status numbered'));

    if (firewall_proof_managed_port_rules($afterRemove) !== []) {
        throw new RuntimeException('failed-step=remove managed comment identity remained');
    }

    if (! firewall_proof_has_comment($afterRemove, FIREWALL_PROOF_PROTECTED_COMMENT)) {
        throw new RuntimeException('failed-step=remove deleted the unrelated same-port rule');
    }

    return 'allow-list-doctor-remove passed, managed allow preceded deny, protected same-port survived';
}

/**
 * @param  array<string, mixed>  $state
 */
function firewall_proof_cleanup_seed_rules(array $state): void
{
    $dev = proof_instance($state, 'dev');
    $rules = firewall_proof_parse_ufw(beast_incus_exec($dev, 'sudo ufw status numbered', allowFailure: true));

    foreach (firewall_proof_seed_cleanup_indexes($rules) as $index) {
        beast_incus_exec($dev, 'sudo ufw --force delete '.$index, allowFailure: true);
    }
}

/**
 * @param  list<array{index: int, action: string, port: string, source: string, comment: string}>  $rules
 */
function firewall_proof_has_comment(array $rules, string $comment): bool
{
    foreach ($rules as $rule) {
        if ($rule['comment'] === $comment) {
            return true;
        }
    }

    return false;
}

/**
 * @param  list<string>  $arguments
 */
function run_e2e_incus(string $root, array $arguments): string
{
    $result = firewall_proof_run_command(
        array_merge(['php', $root.'/apps/e2e/bin/e2e-incus'], $arguments),
        $root,
        1800,
    );

    if ($result['exit'] !== 0) {
        throw new RuntimeException('Beast Incus command failed: '.$result['stderr'].$result['stdout']);
    }

    return $result['stdout'];
}

function beast_incus_exec(string $instance, string $command, bool $asOrbit = false, bool $allowFailure = false): string
{
    $guest = $asOrbit
        ? 'sudo -u orbit bash -lc '.escapeshellarg($command)
        : 'bash -lc '.escapeshellarg($command);
    $result = firewall_proof_run_command([
        'ssh',
        '-o',
        'BatchMode=yes',
        '-o',
        'ConnectTimeout=10',
        FIREWALL_PROOF_HOST,
        'incus exec '.escapeshellarg($instance).' -- '.$guest,
    ], getcwd() ?: '/', 180);

    if ($result['exit'] !== 0 && $allowFailure === false) {
        throw new RuntimeException("incus exec {$instance} failed: ".$result['stderr'].$result['stdout']);
    }

    return $result['stdout'];
}

/**
 * @param  array<string, mixed>  $state
 */
function proof_instance(array $state, string $role): string
{
    $instance = $state['instances'][$role] ?? null;

    if (! is_string($instance) || $instance === '') {
        throw new InvalidArgumentException('target identity mismatch');
    }

    return $instance;
}

/**
 * @param  array<string, mixed>  $state
 */
function proof_checkout(array $state, string $role): string
{
    $checkout = $state['checkouts'][$role] ?? '/home/orbit/orbit-run';

    return is_string($checkout) && $checkout !== '' ? $checkout : '/home/orbit/orbit-run';
}

/**
 * @return array<string, mixed>
 */
function read_firewall_proof_state(string $path): array
{
    if (! is_file($path)) {
        throw new InvalidArgumentException('cleanup identity mismatch');
    }

    return decode_json_object((string) file_get_contents($path));
}

/**
 * @param  array<string, mixed>  $payload
 */
function write_json_file(string $path, array $payload): void
{
    $directory = dirname($path);

    if (! is_dir($directory) && ! mkdir($directory, 0777, true) && ! is_dir($directory)) {
        throw new RuntimeException("unable to write proof receipt: {$path}");
    }

    file_put_contents(
        $path,
        json_encode($payload, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR)."\n",
    );
}

/**
 * @return array<string, mixed>
 */
function decode_json_object(string $output, bool $required = true): array
{
    $trimmed = trim($output);
    $start = strpos($trimmed, '{');
    $end = strrpos($trimmed, '}');

    if ($start === false || $end === false || $end < $start) {
        if ($required) {
            throw new RuntimeException('expected JSON object in command output: '.$trimmed);
        }

        return [];
    }

    $decoded = json_decode(substr($trimmed, $start, $end - $start + 1), true);

    if (! is_array($decoded)) {
        if ($required) {
            throw new RuntimeException('expected JSON object in command output: '.$trimmed);
        }

        return [];
    }

    return $decoded;
}

/**
 * @return array<string, mixed>|null
 */
function retained_incus_manifest(string $root): ?array
{
    $files = glob($root.'/apps/e2e/var/dev-topology/*.json') ?: [];
    rsort($files);

    foreach ($files as $file) {
        $payload = decode_json_object((string) file_get_contents($file), required: false);

        if (($payload['provider'] ?? null) === 'incus'
            && strtolower((string) ($payload['host'] ?? '')) === FIREWALL_PROOF_HOST) {
            return $payload;
        }
    }

    return null;
}

/**
 * @param  array<string, string>  $localFiles
 * @return array<string, string>
 */
function observe_remote_synced_tree(string $instance, array $localFiles, string $localRoot): array
{
    $excludes = var_export(firewall_proof_synced_exclude_patterns(), true);
    $code = <<<PHP
\$excludes = {$excludes};
\$root = getenv('ORBIT_PROOF_ROOT');
if (! is_string(\$root) || \$root === '' || ! is_dir(\$root)) {
    fwrite(STDERR, "checkout digest mismatch\\n");
    exit(1);
}
function proof_norm(string \$path): string {
    \$path = str_replace('\\\\', '/', \$path);
    return str_starts_with(\$path, './') ? substr(\$path, 2) : ltrim(\$path, '/');
}
function proof_excluded(string \$path, array \$excludes): bool {
    \$path = proof_norm(\$path);
    if (\$path === '') {
        return true;
    }
    foreach (\$excludes as \$pattern) {
        \$pattern = proof_norm(\$pattern);
        if (\$path === \$pattern || str_starts_with(\$path, \$pattern.'/')) {
            return true;
        }
        if (fnmatch(\$pattern, \$path)) {
            return true;
        }
    }
    return false;
}
\$expected = [];
foreach (explode("\\0", (string) stream_get_contents(STDIN)) as \$path) {
    \$path = proof_norm(\$path);
    if (\$path === '') {
        continue;
    }
    \$expected[\$path] = true;
    \$full = \$root.'/'.\$path;
    if (is_file(\$full)) {
        echo "H\\t{\$path}\\t".hash_file('sha256', \$full)."\\n";
    }
}
\$iterator = new RecursiveIteratorIterator(
    new RecursiveCallbackFilterIterator(
        new RecursiveDirectoryIterator(\$root, FilesystemIterator::SKIP_DOTS),
        static function (\$current) use (\$root, \$excludes): bool {
            \$rel = proof_norm(substr(\$current->getPathname(), strlen(\$root) + 1));
            return ! proof_excluded(\$rel, \$excludes);
        }
    )
);
foreach (\$iterator as \$file) {
    if (! \$file->isFile()) {
        continue;
    }
    \$rel = proof_norm(substr(\$file->getPathname(), strlen(\$root) + 1));
    if (\$rel === '' || isset(\$expected[\$rel])) {
        continue;
    }
    echo "E\\t{\$rel}\\n";
}
PHP;

    $result = firewall_proof_run_command([
        'ssh',
        '-o',
        'BatchMode=yes',
        '-o',
        'ConnectTimeout=10',
        FIREWALL_PROOF_HOST,
        'incus exec '.escapeshellarg($instance).' -- env ORBIT_PROOF_ROOT='.escapeshellarg(FIREWALL_PROOF_TRANSPORT_CHECKOUT).' php -r '.escapeshellarg($code),
    ], getcwd() ?: '/', 600, implode("\0", array_keys($localFiles)));

    if ($result['exit'] !== 0) {
        throw new RuntimeException('incus exec '.$instance.' failed: '.$result['stderr'].$result['stdout']);
    }

    $parsed = firewall_proof_parse_remote_tree_output($result['stdout']);

    return firewall_proof_include_unexplained_extras($parsed['files'], $parsed['extras'], $localRoot);
}

/**
 * @return array<string, mixed>
 */
function doctor_report(string $output): array
{
    $payload = decode_json_object($output);
    $report = $payload['data']['data']['doctor']
        ?? $payload['data']['doctor']
        ?? $payload['success']['data']['doctor']
        ?? null;

    if (! is_array($report)) {
        throw new RuntimeException('failed-step=doctor');
    }

    return $report;
}

function relative_repo_path(string $root, string $path): string
{
    return str_starts_with($path, $root.'/') ? substr($path, strlen($root) + 1) : $path;
}

function load_e2e_environment(string $root): void
{
    $path = $root.'/.env.e2e';

    if (! is_file($path)) {
        return;
    }

    foreach (file($path) ?: [] as $line) {
        $line = trim($line);

        if ($line === '' || str_starts_with($line, '#') || ! str_contains($line, '=')) {
            continue;
        }

        [$key, $value] = explode('=', $line, 2);
        $key = trim($key);
        $value = trim($value, " \t\"'");

        if ($key !== '') {
            putenv("{$key}={$value}");
            $_ENV[$key] = $value;
        }
    }
}
