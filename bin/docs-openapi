        }, 'required': ['instance_id', 'path', 'base', 'start']}
        responses['200'] = envelope({'type': 'object', 'properties': {
            'services': {'type': 'array', 'items': {'type': 'string'}, 'description': "Systemd services of the Node's roles, such as `caddy.service`."},
            'workspaces': {'type': 'array', 'items': workspace, 'description': 'Task checkouts, as `agent:workspaces` lists them.'},
            'apps_root': {'type': ['string', 'null'], 'description': 'The apps path of an active app-dev Node, whose checkouts the agent reports; null otherwise.'},
            'applications': {'type': 'object', 'additionalProperties': {'type': 'string'}, 'description': 'By Project slug, the application directory inside a checkout when it is not the checkout root, such as `server/web`.'},
            'tools': {'type': 'array', 'items': {'type': 'object', 'properties': {'manager': {'type': 'string'}, 'paths': {'type': 'array', 'items': {'type': 'string'}}}, 'required': ['manager', 'paths']}, 'description': 'Each active Tool Manager with the candidate paths of its package state.'},
        }, 'required': ['services', 'workspaces', 'apps_root', 'applications', 'tools']}, 'The request succeeded.')
    elif route['name'] == 'agent:facts':
        op['requestBody'] = {'required': True, 'content': {'application/json': {'schema': {'type': 'object', 'additionalProperties': False,
            'required': ['kind', 'observed_at', 'data'], 'description': 'At most 1 MiB.', 'properties': {
                'kind': {'type': 'string', 'enum': ['host', 'units', 'checkout', 'checkouts', 'packages']},
                'subject': {'type': 'string', 'description': 'The checkout path for `checkout`, the Tool Manager name for `packages`; refused for other kinds.'},
                'observed_at': {'type': 'string', 'format': 'date-time', 'description': "The agent's time, to the second or millisecond, in UTC."},
                'data': {'type': 'object', 'description': 'The fact, as the Node agent reference defines each kind.'},
            }}}}}
        responses['204'] = {'description': 'The Gateway stored the fact, or it was unchanged.'}
        responses['413'] = error_response('The request is larger than 1 MiB (`agent.fact_too_large`).')
        responses['422'] = error_response('The data does not match the kind, or an `egress` fact came from a Node that is no task VM host or names another bridge than its own (`agent.fact_not_expected`).')
    elif route['name'] == 'agent:log-streams':
        source = {'type': 'object', 'properties': {
            'type': {'type': 'string', 'enum': ['laravel', 'journal', 'docker'], 'description': 'The source type.'},
            'path': {'type': 'string', 'description': '`laravel`: the Instance checkout path.'},
            'unit': {'type': 'string', 'description': '`journal`: the unit `orbit-process-{id}-{name}.service`.'},
            'container': {'type': 'string', 'description': '`docker`: the container `orbit-process-{id}-{name}`.'},
            'process_id': {'type': 'integer', 'description': '`docker`: the Process ID in the container name and label.'},
        }, 'required': ['type']}
        stream_item = {'type': 'object', 'properties': {
            'id': {'type': 'string', 'pattern': '^[0-9a-f]{32}$', 'description': 'The stream ID.'},
            'lines': {'type': 'integer', 'minimum': 1, 'maximum': 1000, 'description': 'The number of earlier lines to send first.'},
            'source': source,
        }, 'required': ['id', 'lines', 'source']}
        responses['200'] = envelope({'type': 'array', 'items': stream_item}, 'The request succeeded.')
    elif route['name'] in ('instance:log-stream:create', 'process:log-stream:create', 'schedule:log-stream:create'):
        opened = {'type': 'object', 'properties': {
            'id': {'type': 'string', 'pattern': '^[0-9a-f]{32}$', 'description': 'The stream ID.'},
            'channel': {'type': 'string', 'description': 'The private channel, `private-log-stream.{id}`.'},
            'auth': {'type': 'string', 'description': "The Pusher signature of this channel for the request's `socket_id` only."},
            'lines': {'type': 'integer', 'description': 'The number of earlier lines the stream sends first.'},
            'lease_seconds': {'type': 'integer', 'description': 'Seconds the stream lives without a renewal.'},
            'renew_seconds': {'type': 'integer', 'description': 'Seconds between renewals.'},
        }, 'required': ['id', 'channel', 'auth', 'lines', 'lease_seconds', 'renew_seconds']}
        responses['201'] = envelope(opened, 'Created.')
        responses['429'] = error_response('The Node already has 16 open log streams (`logs.stream_limit`).')
    elif route['name'] in ('instance:log-stream:renew', 'process:log-stream:renew', 'schedule:log-stream:renew'):
        responses['200'] = envelope({'type': 'object', 'properties': {
            'id': {'type': 'string', 'description': 'The stream ID.'},
            'lease_seconds': {'type': 'integer', 'description': 'Seconds the stream lives from now without another renewal.'},
        }, 'required': ['id', 'lease_seconds']}, 'The request succeeded.')
    elif route['name'] in ('instance:log-stream:destroy', 'schedule:log-stream:destroy', 'process:log-stream:destroy'):
        responses['200'] = envelope({'type': 'object', 'properties': {
            'id': {'type': 'string', 'description': 'The stream ID.'},
            'closed': {'type': 'boolean', 'const': True, 'description': 'Always true.'},
        }, 'required': ['id', 'closed']}, 'The request succeeded.')
    elif route['name'] == 'project:dependency-read-token':
        responses['200'] = {'description': 'Ephemeral credential. Cache-Control: no-store. No Activity or Operation is created.', 'content': {'application/json': {'schema': {'type': 'object', 'required': ['data'], 'properties': {'data': {'type': 'object', 'additionalProperties': False, 'required': ['project_id', 'repository', 'clone_url', 'token', 'expires_at'], 'properties': {'project_id': {'type': 'integer', 'minimum': 1}, 'repository': {'type': 'string'}, 'clone_url': {'type': 'string', 'format': 'uri'}, 'token': {'type': 'string', 'description': 'Ephemeral credential; never persist or log.'}, 'expires_at': {'type': 'string', 'format': 'date-time'}}}}}}}}
        responses['404'] = error_response('Project not found (`project.not_found`).')
        responses['503'] = error_response('Token minting unavailable or unsafe reply (`dependency_token.unavailable`).')
    elif route['name'] == 'agent:realtime:auth':
        responses['200'] = {'description': 'The Pusher channel signature.', 'content': {'application/json': {'schema': {'type': 'object', 'properties': {
            'auth': {'type': 'string', 'description': 'Pusher channel signature.'},
            'channel_data': {'type': 'string', 'description': 'JSON-encoded presence member data.'},
        }, 'required': ['auth', 'channel_data']}}}}
        responses['404'] = error_response('Realtime is not configured (`realtime.not_configured`).')
    elif route['name'] == 'schedule:complete':
        responses['204'] = {'description': 'The Gateway recorded the latest run.'}
    elif route['name'] == 'metrics:grafana:authorize':
        responses['204'] = {'description': 'The caller may reach Grafana.'}
    elif route['name'] == 'runtime-activation:app-instance':
        responses['200'] = {'description': 'Not used: Caddy proxies the site once the awake marker exists and never calls this endpoint for an awake Instance.'}
        responses['401'] = {'description': 'An HTML progress page with the animated Orbit mark. The browser polls the original path once a second while X-Orbit-Runtime-Activation-State is pending.', 'content': {'text/html': {'schema': {'type': 'string'}}}}
        responses['503'] = {'description': 'An HTML failure page with the animated Orbit mark, the stored error, and a Try again link. It does not poll.', 'content': {'text/html': {'schema': {'type': 'string'}}}}
    else:
        data, is_list = data_schema_for(route)
        if is_list:
            data = {'type': 'array', 'items': data}
        if route['name'] == 'websocket:operation:show':
            responses['200'] = websocket_envelope(data, 'Saved registry status, including superseded results.')
        elif route['name'] == 'conn:pairing:create':
            responses['202'] = envelope(ref('OperationData'), 'Accepted. Follow conn:operation:show, then conn:pairing:show.')
            responses['409'] = error_response('conn.pairing_revoked: renew is true and the newest pairing of the calling Node on this server is revoked; no Operation started. conn.session_expired: the admin session expired.')
            responses['422'] = error_response('validation.failed: renew is not a boolean.')
        elif route['name'] == 'tool:adopt':
            # The adopted Tool and the liveness of the agent whose report the Gateway checked.
            if 'AdoptedTool' not in components:
                components['AdoptedTool'] = {'allOf': [ref('ToolData'), {'type': 'object', 'required': ['agent'], 'properties': {
                    'agent': {'oneOf': [ref('NodeAgentData'), {'type': 'null'}], 'description': 'The agent liveness; while it is offline the answer is possibly outdated. Null on a Node without an observing agent.'}}}]}
            responses['201'] = envelope({'$ref': '#/components/schemas/AdoptedTool'}, "Recorded at once from the Node agent's latest `packages` fact; no task runs.")
        elif route['name'] == 'conn:environment:session':
            responses['200'] = envelope(ref('ConnHeldSessionData'), "The calling Node's held session; no Operation runs. Cache-Control: no-store.")
            responses['202'] = envelope(ref('OperationData'), 'Accepted conn.session_hold, or the open one of this Node. Follow conn:operation:show, then read again.')
        elif route['name'] == 'conn:pairing:list':
            responses['200'] = envelope(data, 'Device pairings, or with include_held=true also held pairings, each with held.')
            responses['422'] = error_response('validation.failed: include_held must be 1, true, 0 or false.')
        elif route['name'] == 'conn:thread:list':
            listed = envelope(data, 'The index rows of the covered servers, newest user message first, and every covered server in `meta.environments`.')
            server = {'type': 'object', 'required': ['environment_id', 'instance_id', 'power_state', 'read_at', 'read_error'], 'properties': {
                'environment_id': {'type': 'string'}, 'instance_id': {'type': 'integer'},
                'power_state': {'type': ['string', 'null'], 'description': 'The container power state: `stopped` is asleep, and its rows are the last read.'},
                'read_at': {'type': ['string', 'null'], 'format': 'date-time', 'description': 'When the Gateway last read the server, or tried to; null before its first read.'},
                'read_error': {'type': ['string', 'null'], 'description': 'Why that read failed, such as `conn.server_unreachable` or `conn.session_expired`; null after a success.'}}}
            listed['content']['application/json']['schema']['properties']['meta'] = {'allOf': [{'$ref': '#/components/schemas/Meta'},
                {'type': 'object', 'required': ['environments'], 'properties': {'environments': {'type': 'array', 'items': server}}}]}
            responses['200'] = listed
            responses['422'] = error_response('validation.failed: project or instance is not a positive integer.')
        elif route['name'] == 'conn:thread:record':
            responses['201'] = envelope(data, 'Recorded a new row; `state` is null until the Gateway reads the server.')
            responses['200'] = envelope(data, 'The thread was recorded already; its title and `seen_at` were updated.')
            responses['409'] = error_response('conn.thread_index_unsupported: the server is not the T3 server of a container Instance.')
        elif route['name'] == 'conn:environment:cleanup':
            responses['202'] = envelope(ref('OperationData'), 'Accepted pending registration cleanup. Follow conn:operation:show.')
            responses['204'] = {'description': 'The registration cleanup revision is already complete.'}
        elif route['name'] == 'conn:project:list':
            responses['200'] = envelope(data, 'Compatible ready-default Projects, or all reachable Projects with include_unavailable=true.')
            responses['422'] = error_response('validation.failed: include_unavailable must be 1, true, 0 or false.')
        elif route['name'] == 'conn:instance:name:check':
            responses['422'] = error_response('validation.failed: name is missing or is not a string, or the query has unknown fields.')
            responses['200'] = envelope(ref('ConnInstanceNameCheckData'), 'Advisory name availability; unavailable names also answer 200. No name is reserved.')
            responses['403'] = error_response("node_access.required: the caller has no node access to the default's Node.")
            responses['409'] = error_response('instance.default_missing: the Project has no ready container default.')
        elif route['name'] == 'conn:instance:create':
            responses['202'] = envelope(ref('OperationData'), "Accepted instance.create of the thread's clone. Follow conn:operation:show.")
            responses['403'] = error_response("node_access.required: the caller has no node access to the Node of the Project's default Instance.")
            responses['409'] = error_response("instance.default_missing: no ready container default. instance.name_taken: another device's create holds the name. branch.in_use: details.instance {id, name}, or {} for a hidden holder. instance.placement_conflict: changed branch resume intent.")
            responses['422'] = error_response('validation.failed: malformed branch selection. branch.not_found: details.field branch.name or branch.from. branch.exists: details {field: name, branch: derived target}. No Instance or Operation is reserved.')
            responses['502'] = error_response('source.head_unavailable: remote heads could not be read within ten seconds including credentials. No Instance or Operation is reserved.')
        elif starts_operation:
            if route['name'] == 'node:update':
                responses['200'] = envelope(ref('NodeData'), 'A record-only change was saved; the Node with its new values.')
            if route['name'] == 'instance:register':
                responses['201'] = envelope(ref('InstanceData'), "Registered at once from the Node agent's report: `.env` is absent or private, and no task runs.")
            responses['202'] = envelope(ref('OperationData'), 'Accepted. The operation is queued; follow it with `operation:show`.')
            responses['503'] = error_response('The Gateway has no queue (`operation.queue_unavailable`) and recorded nothing, or it could not queue the job (`operation.dispatch_failed`) and ended the operation as failed.')
        elif route['name'] in ('gateway:release:deploy', 'gateway:release:rollback'):
            responses['202'] = envelope(data, 'Accepted. The release record runs as the `gateway.release` Swamp run, which ends it.')
            responses['503'] = error_response('Swamp did not start the run. The record ends as failed and retryable, or stays running when Swamp did not confirm the start (`swamp.start_uncertain`).')
        elif controllers.get(action, {}).get('created'):
            responses['201'] = envelope(data, 'Created.')
            # Development deploy step creation refuses duplicate names, including exact retries.
            if route['name'] not in ('project:dev-deploy-step:create', 'project:document:create', 'task:comment:create'):
                responses['200'] = envelope(data, 'The request succeeded; an exact retry returned the existing record.')
        else:
            responses['200'] = envelope(data, 'The request succeeded.')
        if route['name'] == 'gateway:trust':
            responses['503'] = error_response('The Gateway root CA is unavailable (`ca.unavailable`).')
    if route['name'] == 'conn:project:branches':
        meta = responses['200']['content']['application/json']['schema']['properties']
        meta['meta'] = {'allOf': [{'$ref': '#/components/schemas/Meta'}, {'type': 'object', 'properties': {'pull_requests_unavailable': {'type': 'boolean', 'description': 'True when the bounded GitHub PR read failed or exceeded 500 open requests; all pull_request fields are null.'}}, 'required': ['pull_requests_unavailable']}]}
        responses['502'] = error_response('The remote branches cannot be read (`source.head_unavailable`).')
        responses['422'] = error_response('query must be a string of at most 255 characters without control characters or leading/trailing whitespace (`validation.failed`).')
        responses['409'] = error_response('The Project has no ready container default (`instance.default_missing`).')
    if route['name'] == 'operation:list':
        meta = responses['200']['content']['application/json']['schema']['properties']
        meta['meta'] = {'allOf': [{'$ref': '#/components/schemas/Meta'}, {'type': 'object', 'properties': {'next_cursor': {'type': ['string', 'null'], 'description': 'Send as `cursor` with the same filters for the next page; null on the last page.'}}, 'required': ['next_cursor']}]}
    if route['name'].startswith('project:document:'):
        op['description'] = 'Project-scoped Documents. Requires ProjectOwning Node access. See /reference/project-documents for limits, archive inheritance, revision preconditions and retry recovery. No object keys or credentials are returned.'
        if route['name'] in ('project:document:list', 'project:document:search', 'project:document:version:list'):
            meta = responses['200']['content']['application/json']['schema']['properties']
            meta['meta'] = {'allOf': [{'$ref': '#/components/schemas/Meta'}, {'type': 'object', 'properties': {'next_cursor': {'type': ['string', 'null']}}, 'required': ['next_cursor']}]}
        if route['name'] == 'project:document:create':
            responses.pop('200', None)
            responses['201'] = envelope(ref('DocumentEntryData'), 'Created.')
    if route['name'] in ('agent:realtime', 'agent:realtime:auth', 'agent:workspaces', 'agent:watch', 'agent:facts', 'agent:log-streams'):
        responses['401'] = error_response('The request carries no agent secret (`agent.secret_required`).')
    if route['name'] in ('agent:realtime', 'agent:workspaces', 'agent:watch', 'agent:facts', 'agent:log-streams'):
        responses['403'] = error_response('The caller is not an active WireGuard peer (`peer.identity_unknown`), its agent secret does not match (`agent.secret_invalid`), or its Node is not eligible for an agent (`agent.node_ineligible`).')
    elif route['name'] == 'project:dependency-read-token':
        responses['403'] = error_response('Services-only authorization or GitHub installation/token refusal (`dependency_token.forbidden`, `dependency_token.refused`).')
    elif route['name'] == 'agent:realtime:auth':
        responses['403'] = error_response('The caller is not an active WireGuard peer (`peer.identity_unknown`), its agent secret does not match (`agent.secret_invalid`), its Node is not eligible for an agent (`agent.node_ineligible`), or it asked for another Node\'s channel (`agent.channel_forbidden`).')
    elif route['name'] not in ('gateway:status', 'gateway:trust'):
        responses['403'] = error_response('The caller is not an active WireGuard peer (`peer.identity_unknown`) or lacks Node access to the target (`node_access.required`).')
    if route['name'] == 'tool:scan':
        responses['404'] = error_response('No Node matches `node_id` (`http.404`).')
        responses['409'] = error_response('The Node is not active (`tool.node_inactive`) or is not Gateway-managed (`tool.node_unmanaged`). `error.details.step` is `scan`, `error.details.outcome` is `manager_failed`, and there is no Tool id. A manager that is unsupported or not observed does not fail the request.')
        responses['422'] = error_response('The query is not the one strict integer `node_id`, or the body is not empty (`validation.failed`).')
    if params and route['name'] not in INTERNAL and route['name'] not in ('extension:enable', 'extension:disable'):
        responses['404'] = error_response('No record matches the path parameters.')
    if starts_operation or (route['method'] in ('POST', 'PUT', 'PATCH', 'DELETE') and route['name'] not in INTERNAL):
        responses['409'] = error_response('A guard refused the change and the Gateway changed nothing; `error.code` names the guard.')
    if route['name'] == 'conn:environment:session':
        responses['409'] = error_response('conn.environment_not_instance: a host server. conn.environment_asleep: the Instance sleeps and the Node holds no session. conn.session_expired: the Gateway admin session ended. instance.removal_conflict: the Instance is being removed.')
    if route['name'] in ('instance:log-stream:create', 'process:log-stream:create', 'schedule:log-stream:create'):
        responses['409'] = error_response('The live log path is not available (`logs.live_unavailable`); `details.reason` is `ssh_only` for a production Instance, or `realtime_not_configured`, `subscriber_down`, `agent_unavailable`, or `agent_not_joined`.')
    if route['name'] in ('instance:log-stream:renew', 'instance:log-stream:destroy', 'schedule:log-stream:renew', 'process:log-stream:renew', 'schedule:log-stream:destroy', 'process:log-stream:destroy'):
        responses['404'] = error_response('The stream does not exist, has ended, belongs to another record, or was opened by another Node (`logs.stream_not_found`).')
    if route['name'] in ('task:list', 'task:show', 'task:question:list', 'task:agent:list', 'task:egress', 'task:agent:stream'):
        responses['409'] = error_response('The tasks extension is disabled (`extension.disabled`).')
    if route['name'] == 'task:cancel':
        responses['200'] = envelope(ref('TaskData'), 'The selected child was cancelled.')
    if route['name'] == 'task:comment:create':
        responses['409'] = error_response('The group uses tick orchestration (`tasks.not_orchestrated`), has ended (`tasks.group_closed`), or has an open subtask (`tasks.assistance_subtask_open`). No comment or assistance change is recorded.')
    if route['name'] == 'task:agent:show':
        responses['409'] = error_response('The thread is a stored `t3` thread (`tasks.agent_transcript_unavailable`), or its Node is gone and Orbit saved no transcript (`tasks.agent_unavailable`).')
        responses['502'] = error_response('The thread\'s Pi server is unavailable, refused the read, did not answer within 5 seconds, or sent a session over 16 MiB, and Orbit saved no transcript (`tasks.agent_read_failed`).')
    if route['name'] == 'task:question:close':
        responses['409'] = error_response('The tasks extension is disabled (`extension.disabled`), or the question is already answered or superseded (`tasks.question_closed`).')
    if route['name'] == 'task:cancel':
        responses['409'] = error_response('The tasks extension is disabled (extension.disabled), the selected parent cannot be cancelled (tasks.not_cancellable), origin does not reach its latest approved commit (tasks.approved_work_unpublished), its VM has an open Operation (operation.target_busy), or the child is not running (tasks.subtask_not_running). Nothing changes.')
        responses['502'] = error_response('A child turn/check could not be stopped (tasks.subtask_interrupt_failed). No workspace is removed on that failure.')
    if route['name'] == 'task:complete':
        responses['409'] = error_response('The tasks extension is disabled (`extension.disabled`), the Task group is not ready to complete (`tasks.not_settling`), or origin does not reach its latest approved commit (`tasks.approved_work_unpublished`). Running or reviewing groups need an ended watched pull request or a stored completion receipt.')
        responses['502'] = error_response('A running agent or check could not be stopped (`tasks.subtask_interrupt_failed`). The completion receipt is kept for retry; the group and its open subtasks remain open.')
    if op.get('x-orbit-extension'):
        extension_error = 'A disabled extension returns HTTP 409 (`extension.disabled`).'
        if '409' in responses:
            responses['409']['description'] += ' ' + extension_error
        else:
            responses['409'] = error_response(extension_error)
    if route['name'] == 'ai-router:model:list':
        responses['409'] = error_response('The collector is not set up (`ai_router.disabled`). A disabled extension returns HTTP 409 (`extension.disabled`).')
    if route['name'] in ('extension:enable', 'extension:disable'):
        responses['422'] = error_response('The extension slug is unknown (`validation.failed`).')
    if route['name'] == 'extension:enable':
        responses['409'] = error_response('A dependency of the extension is disabled (`extension.dependency_disabled`); `error.details.dependency` names it.')
    if route['name'] == 'extension:disable':
        responses['409'] = error_response('An enabled extension depends on this one (`extension.required`); `error.details.required_by` names it.')
    if body_schema is not None:
        responses['422'] = error_response('The JSON body is not an object, has duplicate or unknown members, or fails validation (`validation.failed`).')
    if route['name'] == 'instance:rollback':
        responses['422'] = error_response('The JSON body fails validation (`validation.failed`), or the Instance does not retain the release (`rollback.release_not_retained`). The Gateway records nothing and supersedes no deploy.')
    if keyed:
        responses['409']['description'] += ' The key already belongs to another target or input (`operation.idempotency_conflict`), or another operation holds the target (`operation.target_busy`).'
        responses.setdefault('422', error_response('Invalid input (`validation.failed`).'))['description'] += ' A malformed Idempotency-Key also returns `validation.failed`.'
    if route['name'] in ('node:role:add', 'node:role:remove', 'node:role:relocate'):
        responses['502'] = error_response('A role step failed on the Node (`node_role.convergence_failed` or `node_role.remove_failed`). `error.details.step` names the failed step, and `error.details.error_code` names its own code, such as `node_role.node_busy` or `node_role.tool_manager_locked`.')
    if route['name'] in ('node:add', 'node:remove'):
        responses['502'] = error_response('A step failed on the Node; `error.details.step` names it. When a role step failed, `error.details.error_code` names that step\'s own code.')
    if route['name'] == 'node:metrics':
        responses['409'] = error_response('No Node has the Metrics role (`metrics.assignment_missing`).')
        responses['422'] = error_response('The Node is not an active, WireGuard-managed Node (`node.metrics_unavailable`).')
        responses['502'] = error_response('Grafana or Prometheus did not answer, or Prometheus has no samples for this Node, as for a Node without an enabled exporter (`node.metrics_unreachable`).')
    if route['name'].startswith('project:document:'):
        responses['404'] = error_response('Project-scoped entry or file-scoped version not found (`project_documents.not_found`); a missing Project returns `http.404`.')
        responses['422'] = error_response('Invalid fields, content encoding, names, hierarchy, query or cursor (`validation.failed`), folder content operation (`project_documents.not_file`), or content outside inline editing limits (`project_documents.not_editable`).')
        if route['method'] != 'GET':
            responses['409'] = error_response('Revision conflict (`project_documents.revision_conflict`, with entry_id and current_revision), duplicate sibling name (`project_documents.name_conflict`), archived destination (`project_documents.archived`), nonempty folder (`project_documents.folder_not_empty`), abandoned upload (`project_documents.upload_abandoned`), or unconfigured storage (`project_documents.storage_not_configured`). No automatic retry.')
        if route['name'] in ('project:document:read', 'project:document:download'):
            responses['409'] = error_response('Storage is not configured (`project_documents.storage_not_configured`); metadata remains available.')
        if route['name'] in ('project:document:create', 'project:document:write', 'project:document:read', 'project:document:download', 'project:document:restore-version'):
            responses['413'] = error_response('Decoded content or JSON request exceeds the documented limit (`project_documents.content_too_large`).')
            responses['502'] = error_response('Committed body is missing or corrupt (`project_documents.body_unavailable`); metadata is retained.')
            responses['503'] = error_response('Storage is unavailable (`project_documents.storage_unavailable`); provider diagnostics are not returned.')
    op['responses'] = responses
    request_schema = op.get('requestBody', {}).get('content', {}).get('application/json', {}).get('schema') if body_schema is not None else None
    samples = [{'lang': 'bash', 'label': 'curl', 'source': bash_sample(route, path, request_schema, query, tag)}]
    if sdkreq:
        samples.append({'lang': 'php', 'label': 'PHP SDK', 'source': php_sample(sdkreq, tag, route['name'])})
    op['x-codeSamples'] = samples
    if not op['parameters']:
        op.pop('parameters')
    spec['paths'].setdefault(path, {})[method] = op
    nav_pages[tag].append(f'{route["method"]} {path}')

spec['components']['schemas'].update({k: v for k, v in components.items() if v is not None})


def route_create_accepts(schema, payload):
    """Exercise the emitted Route create schema's object, oneOf, required and enum semantics."""
    if schema.get('type', 'object') != 'object' or not isinstance(payload, dict):
        return False
    if any(key not in payload for key in schema.get('required', [])):
        return False
    properties = schema.get('properties', {})
    if schema.get('additionalProperties') is False and any(key not in properties for key in payload):
        return False
    for key, value in payload.items():
        rule = properties.get(key, {})
        if rule.get('type') == 'integer' and (not isinstance(value, int) or isinstance(value, bool)):
            return False
        if rule.get('type') == 'string' and not isinstance(value, str):
            return False
        if 'enum' in rule and value not in rule['enum']:
            return False
    return 'oneOf' not in schema or sum(route_create_accepts(option, payload) for option in schema['oneOf']) == 1


route_create_schema = spec['paths']['/api/v1/routes']['post']['requestBody']['content']['application/json']['schema']
for payload, expected in [
    ({'instance_id': 12, 'domain': 'shop.example.test'}, True),
    ({'instance_id': 12, 'domain': 'shop.example.test', 'publication': 'public'}, True),
    ({'node_id': 4, 'domain': 'executor.orbit', 'upstream': 'http://127.0.0.1:4788'}, True),
    ({'node_id': 4, 'domain': 'executor.orbit', 'process_id': 7}, True),
    ({'ingress_node_id': 4, 'process_id': 267, 'domain': 'sync.example.com', 'publication': 'public'}, True),
    ({'process_id': 267, 'domain': 'sync.example.com', 'publication': 'public'}, True),
    ({'cluster_id': 9, 'process_id': 267, 'domain': 'sync.example.com'}, False),
    ({'cluster_id': 9, 'node_id': 4, 'process_id': 267, 'domain': 'sync.example.com', 'publication': 'public'}, False),
    ({'app_id': 3, 'instance_id': 12, 'domain': 'shop.example.test'}, False),
    ({'node_id': 4, 'domain': 'shop.example.test'}, False),
    ({'cluster_id': 5, 'domain': 'shop.example.test'}, False),
    ({'instance_id': 12, 'domain': 'shop.example.test', 'node_id': 4}, False),
    ({'node_id': 4, 'domain': 'executor.orbit', 'upstream': 'http://127.0.0.1:4788', 'process_id': 7}, False),
    ({'node_id': 4, 'domain': 'executor.orbit', 'upstream': 'http://127.0.0.1:4788', 'publication': 'public'}, False),
]:
    if route_create_accepts(route_create_schema, payload) != expected:
        sys.exit(f'route:create OpenAPI schema disagrees with the Gateway contract for {payload!r}')

outputs = {OUTPUT: json.dumps(spec, indent=2) + '\n'}

# keep docs.json navigation in sync with the operations
config_path = DOCS / 'docs.json'
config = runpy.run_path(str(ROOT / 'bin/docs-navigation'))['configuration'](spec=spec)
for tab in config['navigation']['tabs']:
    if tab['tab'] != 'API':
        continue
    groups = [g for g in tab['groups'] if 'openapi' not in g]
    for _, t, _ in TAGS:
        if nav_pages[t]:
            groups.append({'group': t, 'openapi': '/openapi.json', 'pages': nav_pages[t]})
    tab['groups'] = groups
outputs[config_path] = json.dumps(config, indent=2) + '\n'

if CHECK:
    stale = [str(path.relative_to(ROOT)) for path, text in outputs.items() if not path.exists() or path.read_text() != text]
    if stale:
        for path, expected in outputs.items():
            if str(path.relative_to(ROOT)) in stale:
                actual = path.read_text() if path.exists() else ''
                sys.stdout.writelines(difflib.unified_diff(
                    actual.splitlines(keepends=True), expected.splitlines(keepends=True),
                    fromfile=str(path.relative_to(ROOT)), tofile='generated/' + str(path.relative_to(ROOT))))
        sys.exit(f'{" and ".join(stale)} {"is" if len(stale) == 1 else "are"} stale. Run bin/docs-openapi.')
    print(f'{OUTPUT.relative_to(ROOT)} and the API navigation match the Gateway sources')
    sys.exit(0)

for path, text in outputs.items():
    path.write_text(text)

print(f'wrote {OUTPUT.relative_to(ROOT)}: {sum(len(v) for v in spec["paths"].values())} operations, {len(spec["components"]["schemas"])} schemas')
if unmatched:
    print('routes without a PHP SDK request:', ', '.join(unmatched), file=sys.stderr)
