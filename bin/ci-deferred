#!/usr/bin/env python3
"""Run the bounded main plan's omitted cases at its exact push SHA, outside Required."""
import argparse
import json
import os
from pathlib import Path
import runpy
import subprocess
import sys
from types import SimpleNamespace

ROOT = Path(__file__).resolve().parents[1]
full = SimpleNamespace(**runpy.run_path(str(ROOT / 'bin/ci-full-set')))
CONTEXT = 'Main deferred fixtures'


def requested_cases(pr, fixtures, fixture_api):
    """Keep capacity deferrals and explicit exclusions; never rerun admitted cases."""
    admitted = {unit.split('#')[0] for shard in pr.get('shards', []) for unit in shard['units']}
    requested = {}
    for unit in pr['deferred']:
        file = unit.split('#')[0]
        requested.setdefault(file, set()).update(fixture_api.case_names(unit, fixtures))
    for row in pr.get('excluded', []):
        requested.setdefault(row['file'], set()).add(row['case'])
    return {file: None if file not in admitted or fixtures[file].get('after_merge') or file.endswith('.py') else sorted(names)
            for file, names in requested.items()}


def build_plan(base, sha):
    fixture_api = full.api()
    budget, fixtures, defaults = fixture_api.configuration()
    changed_base, paths = fixture_api.selection.changed_inputs(base, sha)
    if changed_base != base:
        raise ValueError('Deferred base must be an ancestor of the tested SHA')
    inventory_changed = fixture_api.inventory_changes(base, sha) if fixture_api.registry.metadata_changed(paths) else []
    registry_changed, shared = fixture_api.registry_changes(base, sha) if fixture_api.registry.metadata_changed(paths) else ([], False)
    pr = fixture_api.plan(paths, budget, fixtures, defaults, inventory_changed, registry_changed, shared)
    requested = requested_cases(pr, fixtures, fixture_api)
    # Add receiver self-coverage without changing Required's admission decisions.
    if any(p in ('bin/ci-deferred', 'bin/ci-full-set', '.github/workflows/ci-deferred.yml') for p in paths):
        for file, fixture in fixtures.items():
            if fixture.get('after_merge'):
                requested[file] = None
            elif fixture.get('after_merge_cases') and requested.get(file, []) is not None:
                requested[file] = sorted(set(requested.get(file, [])) | set(fixture['after_merge_cases']))
    config, inventory = fixture_api.registry.load(ROOT)
    result = full.build_plan(config, inventory, full.collect_current, fixture_api, requested=requested)
    result.update(empty_selection=not requested, required_plan=pr, changed_paths=paths)
    return result



def union_requests(rows):
    merged = {}
    for row in rows:
        for file, names in row.items():
            if file not in merged:
                merged[file] = None if names is None else sorted(set(names))
            elif merged[file] is not None:
                merged[file] = None if names is None else sorted(set(merged[file]) | set(names))
    return merged


def historical_request(base, sha, read_revision=None):
    """Replay current admission rules with historical DATA, never historical programs."""
    fixture_api = full.api()
    read = read_revision or (lambda rev: fixture_api.registry.read_revision(ROOT, rev))
    config, inventory = read(sha)
    before, old_inventory = read(base)
    budget = config['budget']
    fixtures = {f['file']: {'cost': budget['default_cost'], 'inputs': [], **f, **inventory.get(f['file'], {})}
                for f in config['fixture']}
    # Use Required's discovery too: grouped extension tests and every Deno test suffix can be unregistered.
    tracked = full.git('ls-tree', '-r', '--name-only', sha, '--', 'swamp').splitlines()
    for file in fixture_api.fixture_steps(tracked):
        fixtures.setdefault(file, {'file': file, 'cost': budget['default_cost'], 'inputs': []})
    paths = full.git('diff', '--name-only', base, sha).splitlines()
    old = {f['file']: f for f in before['fixture']}
    new = {f['file']: f for f in config['fixture']}
    registry_changed = sorted(file for file in old.keys() | new.keys() if old.get(file) != new.get(file))
    inventory_changed = sorted(file for file in old_inventory.keys() | inventory.keys() if old_inventory.get(file) != inventory.get(file))
    shared = (any(before.get(key) != config.get(key) for key in ('budget', 'fixtures'))
              or [f for f in old if f in new] != [f for f in new if f in old])
    pr = fixture_api.plan(paths, budget, fixtures, config['fixtures']['default'], inventory_changed, registry_changed, shared)
    requested = requested_cases(pr, fixtures, fixture_api)
    if any(p in ('bin/ci-deferred', 'bin/ci-full-set', 'bin/ci-main-queue', '.github/workflows/ci-deferred.yml') for p in paths):
        requested = union_requests([requested, {file: None if f.get('after_merge') else f['after_merge_cases']
                                               for file, f in fixtures.items() if f.get('after_merge') or f.get('after_merge_cases')}])
    required_names = {file: sorted(names if names is not None else fixtures[file].get('cases', [])) for file, names in requested.items()}
    return requested, required_names, paths


def build_range(base, sha, commits):
    fixture_api = full.api()
    cache = {}

    def read(rev):
        if rev not in cache:
            cache[rev] = fixture_api.registry.read_revision(ROOT, rev)
        return cache[rev]

    requests, names, paths = [], [], set()
    parent = base
    for commit in commits:
        wanted, required, changed = historical_request(parent, commit, read)
        requests.append(wanted)
        names.append(required)
        paths.update(changed)
        parent = commit
    if parent != sha:
        raise ValueError('The claimed range does not end at the tested SHA')
    requested, required_names = union_requests(requests), union_requests(names)
    config, inventory = fixture_api.registry.load(ROOT)

    def collect(file):
        population = full.collect_current(file)
        missing = set(required_names.get(file, [])) - set(population['cases'])
        if missing:
            raise ValueError(file + ': historical deferred cases no longer registered: ' + ', '.join(sorted(missing)))
        return population

    plan = full.build_plan(config, inventory, collect, fixture_api, requested=requested)
    plan.update(empty_selection=not requested, changed_paths=sorted(paths), historical_cases=required_names)
    return plan

def initial_context(sha):
    context = CONTEXT
    if os.environ.get('GITHUB_EVENT_NAME') == 'workflow_dispatch':
        context += ' (backfill ' + os.environ['GITHUB_RUN_ID'] + ')'
    return {'sha': sha, 'base': None, 'commits': [], 'context': context,
            'shards': [], 'units': [], 'fixtures': {}}


def plan_push(base_ref, sha, output):
    context = initial_context(sha)
    context['requested_base'] = base_ref
    # Save before resolving the base: a deleted or invalid ref still gets a red status.
    full.save(output, context)
    try:
        base = full.git('rev-parse', ('HEAD^' if base_ref == '0' * 40 else base_ref) + '^{commit}')
        result = build_plan(base, sha)
        context.update(base=base, commits=full.git('rev-list', '--first-parent', f'{base}..{sha}').splitlines())
    except (ValueError, OSError, subprocess.SubprocessError) as error:
        full.save(output, {**context, 'planner_error': str(error)})
        raise
    plan = {**context, **result}
    full.save(output, plan)
    return plan


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('command', choices=['plan', 'run', 'report'])
    parser.add_argument('--base', default='HEAD^')
    parser.add_argument('--output', type=Path, required=True)
    parser.add_argument('--plan', type=Path)
    parser.add_argument('--shard')
    parser.add_argument('--results', type=Path)
    parser.add_argument('--shard-result', default='failure')
    args = parser.parse_args()
    if args.command == 'run':
        return full.run_shard(json.loads(args.plan.read_text()), args.shard, args.output)
    sha = full.git('rev-parse', 'HEAD')
    if args.command == 'plan':
        plan = plan_push(args.base, sha, args.output)
        with open(os.environ['GITHUB_OUTPUT'], 'a') as output:
            output.write('matrix=' + json.dumps({'include': [{'name': s['name']} for s in plan['shards']]}) + '\n')
            output.write('has_shards=' + str(bool(plan['shards'])).lower() + '\n')
        print(f'{sha}: {plan["files_total"]} files; {plan["cases_total"]} deferred cases; {len(plan["shards"])} shards')
        return 0
    plan = json.loads(args.plan.read_text()) if args.plan.exists() else initial_context(sha)
    github = full.GitHub()
    link = f'{os.environ.get("GITHUB_SERVER_URL", "https://github.com")}/{github.repo}/actions/runs/{os.environ["GITHUB_RUN_ID"]}'
    return full.report(github, plan, args.results, args.shard_result, link, args.output)


if __name__ == '__main__':
    sys.exit(main())
