sequenceDiagram
  %% Target design: fleet maintenance redesign (recipe.json read by Ansible, Tools phase last, recipe packages held). docs/reference/node-provisioning.md#converge-the-orbit-footprint.
  %% status: draft
  %% command: node:converge
  %% kind: node.converge
  autonumber
  %% lane CLI icon=terminal pill=caller tone=gray
  %% lane GW icon=gateway pill=intent tone=blue
  %% lane SW icon=workflow pill=executes tone=green
  %% lane N icon=server pill=target tone=amber
  %% lane H icon=server pill=target tone=purple
  participant CLI as CLI / MCP<br/>orbit · MCP tools
  participant GW as Gateway<br/>Laravel API
  participant SW as Swamp<br/>workflow execution
  participant N as Target Node<br/>reached over ssh
  participant H as VPN hub<br/>WireGuard peers
  CLI->>GW: node:converge NODE
  %%> Command:
  %%> - `orbit node:converge NODE`
  %%> - syntax: `<node> [--force] [--idempotency-key=KEY] [--json]`
  Note over GW: Validate, lock Node, hub
  %%> Requirements:
  %%> - the calling Node has an access grant to the target Node (`node_access.required`)
  %%> - the target is an active, managed Linux Node (`node.converge_unsupported`)
  %%> - no converge owns the target or its hub (`operation.target_busy`)
  %%> Input:
  %%> - capture the target, active roles, recorded Tools and network; release pins stay in the recipe
  %%> Refusals:
  %%> - an unrenderable part is node.footprint_failed; an unsupported contribution is operation.kind_unavailable
  alt admission refused
    %% path: admission-refused
    GW--xCLI: Refused, no run
    %%> Result:
    %%> - return the admission error without changing the Node
  else admitted
    %% path: admitted
    GW->>SW: Start run, full intent<br/>operation-node-converge
    GW-->>CLI: 202 Accepted<br/>task ID
    SW->>SW: Write the playbook input<br/>inventory · vars · known_hosts
    %%> Why:
    %%> - keep the captured intent and private execution files in one run folder
    SW->>N: Install Orbit binaries<br/>Ansible phase: binaries
    %%> Why first:
    %%> - later phases depend on the agent configuration and the orbit-env group
    SW->>N: Install role software<br/>Ansible phase: software
    %%> Why:
    %%> - establish and hold the recipe baseline before operator Tools
    SW->>N: Configure the roles<br/>Ansible phase: roles
    %%> On a cleanup failure:
    %%> - Instance .env permission cleanup and recorded Route residue cleanup are best effort
    opt Node has recorded Tools
      %% path: tools
      SW->>N: Install Tools<br/>Ansible phase: tools
      %%> On a Tool failure:
      %%> - continue with the other Tools and return each Tool's outcome
    end
    opt Node has a recorded hub
      %% path: network
      SW->>H: Apply the network<br/>Ansible phase: network
      %%> Order:
      %%> - configure the hub before the target Node; check the tunnel after both
      %%> On a repeat:
      %%> - matching live state writes no file and reloads nothing
    end
    SW->>N: Check the Node<br/>Ansible phase: check
    %%> Result:
    %%> - the single end check covers the required state, including the network when applicable
    %%> Exceptions:
    %%> - a hub with no peers has no handshake to check
    SW->>SW: Remove the run folder<br/>after work has stopped
    %%> When:
    %%> - declare cleanup after completion or failure, including skipped downstream phases
    %%> On a cleanup failure:
    %%> - preserve the original failure and expose incomplete cleanup; a worker crash proves no cleanup
    alt all required state matches, no changes or failed Tools
      %% path: already-applied
      SW-->>GW: Succeeded, skipped<br/>node.footprint_unchanged
      %%> Result:
      %%> - record the checked footprint and the stable skip reason
    else required phases pass
      %% path: succeeded
      SW-->>GW: Succeeded, record state
      %%> Result:
      %%> - the shared terminal reader records the footprint and each Tool's outcome
      %%> - a failed Tool does not fail the task
    else a required phase fails
      %% path: phase-failed
      SW--xGW: Failed, retain changes<br/>error_code · failed phase
      %%> On the Node:
      %%> - completed work and partial changes within the failed phase stay; no rollback
      %%> - skip later work, but still schedule cleanup once execution has stopped
      %%> Retry:
      %%> - a new invocation starts at the first phase and repairs what does not match
    end
    loop until terminal
      %% path: follow
      CLI->>GW: operation:show TASK
      GW-->>CLI: status + result
    end
  end
