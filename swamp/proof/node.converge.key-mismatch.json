{
  "kind": "node.converge.key-mismatch",
  "workflow": "operation-node-converge-direct",
  "topology": "minimal",
  "budget_seconds": 600,
  "queue_timeout_seconds": 30,
  "prepare": [],
  "before_target": [
    [
      "sh",
      "-c",
      "cp -p /etc/orbit/agent/secret /etc/orbit/agent/secret.proof && printf %s proof-mismatched-key > /etc/orbit/agent/secret"
    ]
  ],
  "clean_target": [
    [
      "sh",
      "-c",
      "test -f /etc/orbit/agent/secret.proof && mv /etc/orbit/agent/secret.proof /etc/orbit/agent/secret || true"
    ]
  ],
  "request": {
    "method": "POST",
    "path": "nodes/${node.target}/converge",
    "body": {
      "force": true
    }
  },
  "expect": {
    "status": "failed"
  },
  "phases": [
    {
      "name": "Install the Node agent",
      "job": "converge",
      "step": "Install the Node agent",
      "budget_seconds": 250
    }
  ],
  "parity": [
    "swamp/proof/node.converge/parity.py",
    "refused"
  ]
}
