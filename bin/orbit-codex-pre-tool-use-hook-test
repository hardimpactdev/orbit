#!/usr/bin/env bash

set -Eeuo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." >/dev/null 2>&1 && pwd)"
HOOK="$ROOT/bin/orbit-codex-pre-tool-use-hook"
CHECK="$ROOT/bin/orbit-feature-finalization-check"
TMP="$(mktemp -d "${TMPDIR:-/tmp}/orbit-codex-hook-test.XXXXXX")"

cleanup() {
    rm -rf "$TMP"
}

trap cleanup EXIT

fail() {
    printf 'FAIL: %s\n' "$*" >&2
    exit 1
}

run_hook() {
    local repo="$1"
    local command="$2"

    printf '{"tool_input":{"command":"%s"}}' "$command" | (cd "$repo" && "$HOOK") >/tmp/orbit-hook-test.out 2>/tmp/orbit-hook-test.err
}

run_check() {
    local repo="$1"
    shift

    (cd "$repo" && "$CHECK" "$@") >/tmp/orbit-hook-test.out 2>/tmp/orbit-hook-test.err
}

expect_pass() {
    local repo="$1"
    local command="$2"

    if ! run_hook "$repo" "$command"; then
        cat /tmp/orbit-hook-test.err >&2
        fail "expected pass for [$command]"
    fi
}

expect_block() {
    local repo="$1"
    local command="$2"
    local status=0

    run_hook "$repo" "$command" || status=$?

    if [ "$status" -eq 0 ]; then
        fail "expected block for [$command]"
    fi

    [ "$status" -eq 2 ] || fail "expected block exit code 2 for [$command], got $status"

    grep -q 'Orbit finalization gate blocked' /tmp/orbit-hook-test.err \
        || fail "block message missing for [$command]"
}

expect_e2e_block() {
    local repo="$1"
    local command="$2"
    local status=0

    run_hook "$repo" "$command" || status=$?

    if [ "$status" -eq 0 ]; then
        fail "expected e2e block for [$command]"
    fi

    [ "$status" -eq 2 ] || fail "expected e2e block exit code 2 for [$command], got $status"

    grep -q 'Orbit E2E guard blocked' /tmp/orbit-hook-test.err \
        || fail "dedicated e2e block message missing for [$command]"

    grep -q 'human-only' /tmp/orbit-hook-test.err \
        || fail "human-only teaching missing for [$command]"

    if grep -q 'Orbit finalization gate blocked' /tmp/orbit-hook-test.err; then
        fail "e2e block for [$command] must use the dedicated e2e message, not the finalization gate message"
    fi
}

expect_check_block() {
    local repo="$1"
    shift
    local status=0

    run_check "$repo" "$@" || status=$?

    if [ "$status" -eq 0 ]; then
        fail "expected explicit check block for [$*]"
    fi

    [ "$status" -eq 2 ] || fail "expected explicit check exit code 2 for [$*], got $status"

    grep -q 'Orbit finalization gate blocked' /tmp/orbit-hook-test.err \
        || fail "explicit check block message missing for [$*]"
}

write_loop() {
    local path="$1"
    local loop_outcome="$2"
    local no_new_signal_rationale="$3"

    mkdir -p "$(dirname "$path")"

    cat >"$path" <<EOF
# Orbit Current Slice State

## Done Contract

- Done when:
  - checked

## Final Distillation

- Loop outcome:
  - $loop_outcome
- Required verification:
  - Retained topology proof: not applicable - hook fixture has no topology runtime diff
  - \`composer quality-check\`: not applicable - hook fixture has no branch diff
- Distillation packet:
  - Location: .orbit/loop.md
  - Includes objective/final diff: yes
  - Includes worker/reviewer/terminal/evidence pointers: yes
  - Includes orchestrator steering notes: yes
- Fresh analyzer:
  - Persona: not used
  - Solo process or analyzer: not used; tiny mechanical hook test
  - Verdict: not used with rationale
- Candidate signals:
  - none
- Accepted durable updates:
  - none
- Rejected or already-covered signals:
  - none
- Deferred follow-ups:
  - none
- No-new-signal rationale:
  - $no_new_signal_rationale
EOF
}

write_custom_outcome_loop() {
    local path="$1"

    mkdir -p "$(dirname "$path")"

    cat >"$path" <<'EOF'
# Orbit Current Slice State

## Done Contract

- Done when:
  - checked

## Final Distillation

### Harness Signals

- Accepted/promoted by parent loop: a real guardrail exists elsewhere.
- Deferred follow-up: none.
EOF
}

write_bare_label_loop() {
    local path="$1"

    mkdir -p "$(dirname "$path")"

    cat >"$path" <<'EOF'
# Orbit Current Slice State

## Done Contract

- Done when:
  - checked

## Final Distillation

Accepted durable updates

- A real guardrail exists elsewhere.

Rejected or already-covered signals

- none

Deferred follow-ups

- none

No-new-signal rationale

- not applicable because a guardrail was accepted.
EOF
}

commit_docs_fixture() {
    local worktree="$1"
    local name="$2"
    local head

    printf '# %s\n' "$name" >"$worktree/$name.md"
    git -C "$worktree" add "$name.md"
    git -C "$worktree" commit -m "Add $name fixture" >/dev/null
    head="$(git -C "$worktree" rev-parse HEAD)"
    mkdir -p "$worktree/.orbit/quality-gates"
    printf '{"gate":"docs-lint","producer":"quality-gate-run","command":"composer docs-lint","mode":"check","exit_code":0,"ended_at":"2026-07-10T18:00:00Z","subgates":[],"git":{"commit":"%s","dirty":false}}\n' "$head" \
        >"$worktree/.orbit/quality-gates/docs-lint.json"
}

REPO="$TMP/repo"

mkdir -p "$REPO"
cd "$REPO"

git init -b main >/dev/null
git config user.name 'Orbit Hook Test'
git config user.email 'orbit-hook-test@example.invalid'

printf '/.worktrees/\n/.orbit/*\n!/.orbit/sessions/\n!/.orbit/sessions/**\n' >.gitignore
touch HARNESS.md AGENTS.md README.md
git add .gitignore HARNESS.md AGENTS.md README.md
git commit -m 'Initial test repo' >/dev/null

git branch finalized
git worktree add .worktrees/finalized finalized >/dev/null 2>&1
commit_docs_fixture "$REPO/.worktrees/finalized" 'finalized'
write_loop "$REPO/.worktrees/finalized/.orbit/loop.md" 'complete' 'No durable signal remained after reviewing the feature evidence.'

git branch historical-pending
git worktree add .worktrees/historical-pending historical-pending >/dev/null 2>&1
commit_docs_fixture "$REPO/.worktrees/historical-pending" 'historical-pending'
write_loop "$REPO/.worktrees/historical-pending/.orbit/loop.md" 'complete' 'No durable signal remained after reviewing the historical pending-state block evidence.'

git branch templated
git worktree add .worktrees/templated templated >/dev/null 2>&1
write_loop "$REPO/.worktrees/templated/.orbit/loop.md" 'complete' '<why local cleanup, existing guardrails, or rejection was enough>'

git branch pending-outcome
git worktree add .worktrees/pending-outcome pending-outcome >/dev/null 2>&1
write_loop "$REPO/.worktrees/pending-outcome/.orbit/loop.md" 'pending' 'No durable signal remained after reviewing the pending outcome fixture.'

git branch custom-outcome-heading
git worktree add .worktrees/custom-outcome-heading custom-outcome-heading >/dev/null 2>&1
write_custom_outcome_loop "$REPO/.worktrees/custom-outcome-heading/.orbit/loop.md"

git branch bare-outcome-labels
git worktree add .worktrees/bare-outcome-labels bare-outcome-labels >/dev/null 2>&1
write_bare_label_loop "$REPO/.worktrees/bare-outcome-labels/.orbit/loop.md"

git branch missing-loop
git worktree add .worktrees/missing-loop missing-loop >/dev/null 2>&1

expect_pass "$REPO" 'composer quality-check'

# The composer test:e2e* lanes are human-only; the hook denies every agent
# tool form deterministically (exit 2, dedicated teaching message).
expect_e2e_block "$REPO" 'composer test:e2e'
expect_e2e_block "$REPO" 'composer test:e2e:docker'
expect_e2e_block "$REPO" 'composer test:e2e:binary:linux'
expect_e2e_block "$REPO" 'composer run test:e2e:incus'
expect_e2e_block "$REPO" 'composer run-script test:e2e'
expect_e2e_block "$REPO" 'ORBIT_E2E_LANES=docker composer test:e2e:docker'
expect_e2e_block "$REPO" '/usr/local/bin/composer test:e2e'
expect_e2e_block "$REPO" 'composer --working-dir apps/e2e test:e2e'
expect_e2e_block "$REPO" 'composer quality-check && composer test:e2e'
expect_e2e_block "$REPO" 'cd apps/e2e; composer test:e2e:docker:canary'
expect_e2e_block "$REPO" 'git merge --ff-only finalized && composer test:e2e'
expect_e2e_block "$REPO" "bash -lc 'composer test:e2e:incus'"
expect_e2e_block "$REPO" '/usr/bin/env bash -lc \"composer test:e2e\"'
expect_e2e_block "$REPO" 'php composer.phar test:e2e'
e2e_heredoc_command='bash <<EOF\ncomposer test:e2e\nEOF'
expect_e2e_block "$REPO" "$e2e_heredoc_command"

# Non-e2e composer scripts and quoted prose mentions must not false-positive.
expect_pass "$REPO" 'composer test'
expect_pass "$REPO" "echo 'composer test:e2e'"
expect_pass "$REPO" "git commit -m 'composer test:e2e stays a human-only shell lane'"
expect_pass "$REPO" "rg -n 'composer test:e2e' HARNESS.md"

e2e_patch_payload='*** Begin Patch\n*** Update File: docs/example.md\n@@\n composer test:e2e\n*** End Patch'
expect_pass "$REPO" "$e2e_patch_payload"

boundary_command='git'
boundary_command+=' merge --ff-only templated'
patch_payload="*** Begin Patch\\n*** Update File: docs/example.md\\n@@\\n $boundary_command\\n*** End Patch"
expect_pass "$REPO" "$patch_payload"
invalid_patch_payload="*** Begin Patch\\n$boundary_command\\n*** End Patch"
expect_block "$REPO" "$invalid_patch_payload"
wrapped_patch_payload="*** Begin Patch wrapped\\n*** Update File: docs/example.md\\n$boundary_command\\n*** End Patch"
expect_block "$REPO" "$wrapped_patch_payload"
duplicate_end_patch_payload="*** Begin Patch\\n*** Update File: docs/example.md\\n$boundary_command\\n*** End Patch\\n*** End Patch"
expect_block "$REPO" "$duplicate_end_patch_payload"
expect_pass "$REPO" 'git merge --ff-only finalized'
git -C "$REPO" merge --ff-only finalized >/dev/null
expect_pass "$REPO" 'git merge --ff-only historical-pending'
expect_block "$REPO" 'git merge --ff-only templated'
expect_block "$REPO" 'git merge --ff-only pending-outcome'
expect_block "$REPO" 'git merge --ff-only custom-outcome-heading'
expect_block "$REPO" 'git merge --ff-only bare-outcome-labels'
expect_block "$REPO" 'git merge --ff-only missing-loop'
expect_block "$REPO" 'git worktree remove .worktrees/templated && git branch -d templated'
expect_check_block "$REPO" git merge --ff-only templated

mkdir -p "$REPO/.orbit/sessions/2026-07-10-180000-finalized/agent-sessions"
cp "$REPO/.worktrees/finalized/.orbit/loop.md" "$REPO/.orbit/sessions/2026-07-10-180000-finalized/loop.md"
printf '{"schema_version":1,"sessions":[]}\n' \
    >"$REPO/.orbit/sessions/2026-07-10-180000-finalized/agent-sessions/manifest.json"
printf '%s\n' '{
  "schema_version": 2,
  "generated_from": ".orbit/sessions/YYYY-MM-DD-HHMMSS-<slug>",
  "record_count": 1,
  "records": [{"archive":"2026-07-10-180000-finalized","slug":"finalized","timestamp":"2026-07-10-180000"}]
}' >"$REPO/.orbit/sessions/index.json"
git -C "$REPO" add .orbit/sessions/2026-07-10-180000-finalized .orbit/sessions/index.json
git -C "$REPO" commit -m 'Archive finalized session' >/dev/null
expect_pass "$REPO" 'git branch -d finalized'

printf 'orbit-codex-pre-tool-use-hook tests passed\n'
