{
  "kind": "route.create",
  "workflow": "operation-route-create",
  "topology": "minimal",
  "budget_seconds": 1800,
  "queue_timeout_seconds": 30,
  "prepare": [
    {
      "method": "POST",
      "path": "projects",
      "operation": false,
      "bind": "project",
      "body": {
        "slug": "proof-route-${proof.run}",
        "name": "Proof route",
        "type": "node-package",
        "root": "public",
        "repository_url": "https://github.com/laravel/laravel.git",
        "default_branch": "13.x"
      }
    },
    {
      "method": "POST",
      "path": "instances",
      "bind": "instance",
      "body": {
        "project_id": "${project.id}",
        "node_id": "${node.target}",
        "name": "r-${proof.run}",
        "branch": "13.x"
      }
    },
    {
      "method": "POST",
      "path": "routes",
      "bind": "bootstrap",
      "body": {
        "instance_id": "${instance.id}",
        "domain": "b-${proof.run}.proof.test"
      }
    },
    {
      "method": "PATCH",
      "path": "projects/${project.id}",
      "operation": false,
      "body": {
        "type": "laravel-app"
      }
    }
  ],
  "request": {
    "method": "POST",
    "path": "routes",
    "body": {
      "instance_id": "${instance.id}",
      "domain": "r-${proof.run}.proof.test",
      "web_root": "public"
    }
  },
  "expect": {
    "status": "succeeded"
  },
  "phases": [
    {
      "name": "sign",
      "job": "create",
      "step": "Sign the CSR-0",
      "budget_seconds": 60
    },
    {
      "name": "probe",
      "job": "create",
      "step": "Probe the site over TLS-0",
      "budget_seconds": 30
    }
  ],
  "parity": "swamp/proof/route.create/parity.py",
  "clean": true
}
