APP_NAME=Laravel
APP_URL=http://default.example.test
SECRET=synthetic-secret
NAME=clone
DB_PASSWORD=synthetic-password
AWS_SECRET_ACCESS_KEY=synthetic-access-key
VITE_PASSWORD="${DB_PASSWORD}"
VITE_AWS="${AWS_SECRET_ACCESS_KEY}"
LITERAL_SECRET='${SECRET}'
BACKSLASH="C:\\${NAME}"
ALLOW_BACKSLASH="C:\\${APP_NAME}"
SOURCE="first\nsecond"
CARRIAGE="first\rsecond"
COPY=${SOURCE}
QUOTE='a"b'
HASHES="value#with#hashes"
PASSWORD=pa$$word
BCRYPT=$2y$10$abcdef
PRICE=price$5
ESCAPED="\${APP_NAME}"
SINGLE='${APP_NAME}'
DEFAULT_COLON='${MISSING:-default}'
DEFAULT_DASH='${MISSING-default}'
DOUBLE_DEFAULT_COLON="${MISSING:-default}"
DOUBLE_DEFAULT_DASH="${MISSING-default}"
UNQUOTED_DEFAULT_COLON=${MISSING:-default}
UNQUOTED_DEFAULT_DASH=${MISSING-default}
UNDEFINED=${MISSING}
