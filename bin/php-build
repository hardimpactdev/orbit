#!/usr/bin/env python3
"""Install, verify the one PHP build that the machine software recipe pins. See ADR 0216.

  bin/php-build verify --profile PROFILE [--recipe PATH] [--version X.Y]
  sudo bin/php-build install --profile PROFILE [--ci] [--purge-extras] [--coverage pcov|none] [--no-composer] [--recipe PATH] [--version X.Y]
  bin/php-build mirror --directory DIR # download external pinned Debian files for the php-build-mirror release
  bin/php-build key [--all]            # digest of the pins, for a download cache key
  bin/php-build describe               # the upstream PHP releases the recipe pins

`install` calls php.install-build in the agent built from this checkout. Build apps/agent with cargo build --release --locked first.
`verify` exits 1 when the `php` on PATH is not the recipe build: its PHP_VERSION, its CLI modules, or a package version.
"""
import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import runpy
import shutil
import subprocess
import sys
import urllib.request

ROOT = Path(__file__).resolve().parent.parent
RECIPE = ROOT / 'apps/gateway/resources/machine-software/recipe.json'
AGENT = ROOT / 'apps/agent/target/release/orbit-agent'
agent_command = runpy.run_path(str(ROOT / 'tools/agent_command.py'))
# php.install-build keeps every pinned and repacked file here; they are the rollback.
CACHE = Path('/var/cache/orbit/php-packages')
CODENAMES = {'26.04': 'resolute'}
COMPOSER_VERSION = '2.10.3'
COMPOSER_SHA256 = '7a2d379d5b8ffdaa028580ef26494c36d2feef4b178d3dd1473a4dbc5e17c8d6'
FIX = ('Fix the host: on a GitHub-hosted runner the PHP action installs the build; for a Node with the ci-runner role, run '
       '`php artisan node:converge-recipe NODE` on the Gateway; in a shard container run '
       '`tools/ci-runners/setup.sh container NAME` on its host; elsewhere run `sudo bin/php-build install --profile=PROFILE`.')


class BuildError(Exception):
    pass


class DownloadUnavailable(BuildError):
    pass


def load(path):
    return json.loads(Path(path).read_text())


def upstream(version):
    """`8.5.11-1+0~...` and `2:8.5.11-1` both report PHP_VERSION 8.5.11."""
    return re.sub(r'^[0-9]+:', '', version).split('-', 1)[0]


def profile_policy(recipe, profile, version):
    """Select PHP policy from the recipe profile; there is no implicit machine role."""
    profiles = {**recipe['roles'], 'base': recipe['base']}
    if profile not in profiles:
        raise BuildError(f'The recipe has no profile {profile}.')
    if f'php:{version}' not in profiles[profile]:
        raise BuildError(f'The recipe profile {profile} does not declare PHP {version}.')
    return {'pcov': profile in recipe['php']['pcov'],
            'opentelemetry': profile in recipe['php']['opentelemetry']}


def build(recipe, version=None, architecture=None, *, profile):
    """The recipe's PHP set of one version: its pins for one architecture and the CLI extensions."""
    php = recipe['php']
    version = version or php['ci']
    if version not in php['versions']:
        raise BuildError(f'The recipe has no PHP {version} build.')
    selected = php['versions'][version]
    policy = profile_policy(recipe, profile, version)
    excluded = set() if policy['opentelemetry'] else {f'php{version}-opentelemetry'}
    names = sorted((set(selected['packages']) | set(php['shared'])) - excluded)
    pins = {}
    for name in names:
        tool = recipe['tools'][name]
        if architecture is not None:
            artifact = tool['artifacts'].get(architecture)
            if artifact is None:
                raise BuildError(f'PHP is not available for {architecture}')
            pins[name] = {'version': tool['version'], 'url': artifact['url'], 'sha256': artifact['sha256']}
    return {'version': version, 'php_version': upstream(recipe['tools'][f'php{version}-common']['version']),
            'packages': names, 'extensions': [name for name in selected['extensions']
                                             if name != 'opentelemetry' and (name != 'pcov' or policy['pcov'])], 'pins': pins}


def modules(text):
    """`php -m` as the recipe lists it: lower case, sorted, unique, without section headers."""
    return sorted({line.strip().lower() for line in text.splitlines() if line.strip() and not line.startswith('[')})


def compare(expected, php_version, loaded, installed):
    """Every difference between the host and the recipe build, as readable lines. Empty means the build matches."""
    problems = []
    if php_version != expected['php_version']:
        problems.append(f'PHP_VERSION is {php_version or "missing"}, expected {expected["php_version"]}.')
    missing = sorted(set(expected['extensions']) - set(loaded))
    extra = sorted(set(loaded) - set(expected['extensions']))
    if missing:
        problems.append('Missing extensions: ' + ', '.join(missing) + '.')
    if extra:
        problems.append('Extra extensions: ' + ', '.join(extra) + '.')
    for name, pin in sorted(expected['pins'].items()):
        if installed.get(name) != pin['version']:
            problems.append(f'{name} is {installed.get(name) or "not installed"}, expected {pin["version"]}.')
    return problems


def pins_digest(recipe, architecture, versions):
    lines = []
    for version in versions:
        for name, pin in sorted(build(recipe, version, architecture, profile='base')['pins'].items()):
            lines.append(f'{name} {pin["version"]} {pin["sha256"]}')
    return hashlib.sha256('\n'.join(sorted(set(lines))).encode()).hexdigest()


def run(argv, **kwargs):
    result = subprocess.run(argv, capture_output=True, text=True, **kwargs)
    if result.returncode:
        raise BuildError(f'{" ".join(argv[:3])} failed: {result.stderr.strip()[-2000:]}')
    return result.stdout


def architecture():
    return run(['dpkg', '--print-architecture']).strip()


def installed_versions():
    output = run(['dpkg-query', '-W', '-f=${Package} ${Status} ${Version}\n'])
    versions = {}
    for line in output.splitlines():
        fields = line.split()
        if len(fields) == 5 and fields[1:4] == ['install', 'ok', 'installed']:
            versions[fields[0]] = fields[4]
    return versions


def host_build(php='php'):
    if shutil.which(php) is None:
        return '', []
    version = subprocess.run([php, '-r', 'echo PHP_VERSION;'], capture_output=True, text=True).stdout.strip()
    loaded = modules(subprocess.run([php, '-m'], capture_output=True, text=True).stdout)
    return version, loaded


def verify(recipe, version, profile):
    expected = build(recipe, version, architecture(), profile=profile)
    php_version, loaded = host_build()
    problems = compare(expected, php_version, loaded, installed_versions())
    if problems:
        raise BuildError(f'The PHP on this host is not the recipe build (PHP {expected["version"]}, '
                         f'{RECIPE.relative_to(ROOT)}):\n  ' + '\n  '.join(problems) + '\n' + FIX)
    print(f'PHP {php_version} matches the recipe build: {len(expected["pins"])} packages, '
          f'{len(expected["extensions"])} extensions.')


def download(url, destination, digest, *, algorithm='sha256'):
    if destination.is_file() and hashlib.new(algorithm, destination.read_bytes()).hexdigest() == digest:
        return
    if not url.startswith('https://'):
        raise BuildError(f'Refusing a non-HTTPS URL: {url}')
    partial = destination.with_suffix('.partial')
    try:
        with urllib.request.urlopen(url, timeout=60) as response:
            if not response.geturl().startswith('https://'):
                raise BuildError(f'{url} redirected away from HTTPS.')
            partial.write_bytes(response.read())
    except OSError as error:
        raise DownloadUnavailable(f'{url} cannot be downloaded ({error}). The upstream may have published a newer build; '
                         'run `bin/recipe-artifacts bump`.') from error
    if hashlib.new(algorithm, partial.read_bytes()).hexdigest() != digest:
        partial.unlink()
        raise BuildError(f'{url} does not match its recipe {algorithm} digest.')
    partial.rename(destination)


def installer_input(recipe, versions, *, profile, extras='refuse', fpm='shared'):
    """The input of php.install-build, as PhpBuildInstaller::input() builds it in the Gateway."""
    sets = {}
    for version in versions:
        selected = build(recipe, version, profile=profile)
        packages = []
        for name in selected['packages']:
            tool = recipe['tools'][name]
            for architecture, artifact in tool['artifacts'].items():
                packages.append({'name': name, 'version': tool['version'], 'architecture': architecture,
                                 'url': artifact['url'], 'sha256': artifact['sha256']})
        sets[version] = {'packages': packages, 'extensions': selected['extensions']}
    policy = profile_policy(recipe, profile, versions[0])
    rollback = recipe['php']['rollback']
    return {'versions': sets, 'mirror': recipe['artifact_mirror'], **policy, 'extras': extras,
            'fpm': 'disabled' if profile == 'vpn' else fpm, 'repack': {'package': rollback, 'version': recipe['tools'][rollback]['version']},
            'release': {'id': 'ubuntu', 'codenames': [CODENAMES[recipe['ubuntu']['release']]]}}


def run_installer(payload):
    """Run php.install-build, the one installer of the PHP build (ADR 0216), and return (outcome, data, log)."""
    try:
        result, log = agent_command['run'](AGENT, 'php.install-build', payload, 1800)
    except agent_command['Refused'] as error:
        if error.code.startswith('php.build_'):
            return error.code.removeprefix('php.build_'), error.details, error.log
        raise BuildError(f'php.install-build refused: {error}') from error
    except agent_command['CommandError'] as error:
        raise BuildError(str(error)) from error
    if result.get('outcome') not in ('current', 'applied') or not isinstance(result.get('data'), dict):
        raise BuildError('php.install-build ended without a valid agent result.')
    return result['outcome'], result['data'], log


def install(recipe, version, ci, coverage, composer, purge, profile):
    if os.geteuid() != 0:
        raise BuildError('Install needs root: run `sudo bin/php-build install --profile=PROFILE`.')
    version = version or recipe['php']['ci']
    # A CI machine purges the PHP packages outside the recipe only when asked: --purge-extras.
    outcome, data, log = run_installer(installer_input(recipe, [version], profile=profile, extras='purge' if purge else 'refuse'))
    if outcome not in ('current', 'applied'):
        details = ', '.join(f'{key}: {value}' for key, value in data.items())
        hint = ' Rerun with --purge-extras on a CI machine to remove them.' if outcome in ('extra_packages', 'unowned_extensions', 'conflicting_source') else ''
        raise BuildError(f'php.install-build ended with {outcome} ({details}).{hint}\n{log[-4000:]}')
    print(f'php.install-build: {outcome}; changed {", ".join(data.get("changed", [])) or "nothing"}, '
          f'repaired {", ".join(data.get("repaired", [])) or "nothing"}, '
          f'purged {", ".join(data.get("purged", [])) or "nothing"}, '
          f'disabled {", ".join(data.get("disabled", [])) or "nothing"}.')
    conf = Path(f'/etc/php/{version}/cli/conf.d')
    ci_ini, coverage_ini = conf / '99-orbit-ci.ini', conf / '99-orbit-coverage.ini'
    ci_ini.write_text('zend.exception_ignore_args=0\n') if ci else ci_ini.unlink(missing_ok=True)
    # Coverage collection does not change which modules the profile loads.
    coverage_ini.write_text('pcov.enabled=0\n') if coverage == 'none' else coverage_ini.unlink(missing_ok=True)
    if Path(f'/usr/bin/php{version}').exists():
        run(['update-alternatives', '--set', 'php', f'/usr/bin/php{version}'])
    if composer:
        target = Path('/usr/local/bin/composer')
        CACHE.mkdir(parents=True, exist_ok=True)
        phar = CACHE / f'composer-{COMPOSER_VERSION}.phar'
        download(f'https://getcomposer.org/download/{COMPOSER_VERSION}/composer.phar', phar, COMPOSER_SHA256)
        if not target.is_file() or hashlib.sha256(target.read_bytes()).hexdigest() != COMPOSER_SHA256:
            shutil.copyfile(phar, target)
        target.chmod(0o755)
    verify(recipe, version, profile)


def mirror(recipe, directory, published=()):
    """Retain every external Debian artifact; already published content-addressed assets need no download."""
    directory.mkdir(parents=True, exist_ok=True)
    seen = set(published)
    for name, pin in sorted(recipe['tools'].items()):
        if pin['source'] != 'artifact':
            continue
        for artifact in pin['artifacts'].values():
            if not artifact['url'].endswith('.deb'):
                continue
            algorithm = 'sha256' if 'sha256' in artifact else 'sha512'
            filename = name + '_' + artifact[algorithm] + '.deb'
            if filename in seen:
                continue
            urls = list(dict.fromkeys([
                *([recipe['artifact_mirror'] + '/' + filename] if recipe['artifact_mirror'] else []),
                artifact['url'],
            ]))
            for index, url in enumerate(urls):
                try:
                    download(url, directory / filename, artifact[algorithm], algorithm=algorithm)
                    break
                except DownloadUnavailable:
                    if index == len(urls) - 1:
                        raise
            seen.add(filename)
    print(f'{len(list(directory.glob("*.deb")))} files in {directory}')


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    commands = parser.add_subparsers(dest='command', required=True)
    for name in ('verify', 'install', 'key', 'describe', 'mirror'):
        command = commands.add_parser(name)
        command.add_argument('--recipe', default=str(RECIPE))
        if name in ('verify', 'install', 'key'):
            command.add_argument('--version')
        if name in ('verify', 'install'):
            command.add_argument('--profile', required=True, help='Recipe profile for packages and loaded extensions.')
    commands.choices['install'].add_argument('--ci', action='store_true', help='Set zend.exception_ignore_args=0 for the CLI.')
    commands.choices['install'].add_argument('--coverage', choices=('pcov', 'none'), default='pcov')
    commands.choices['install'].add_argument('--purge-extras', action='store_true',
                                             help='Purge PHP packages and apt sources outside the recipe. CI machines only.')
    commands.choices['mirror'].add_argument('--directory', required=True)
    commands.choices['mirror'].add_argument('--published', help='File listing release asset names, one per line')
    commands.choices['install'].add_argument('--no-composer', action='store_true')
    commands.choices['key'].add_argument('--all', action='store_true')
    arguments = parser.parse_args(argv)
    try:
        recipe = load(arguments.recipe)
        if arguments.command == 'verify':
            verify(recipe, arguments.version, arguments.profile)
        elif arguments.command == 'install':
            install(recipe, arguments.version, arguments.ci, arguments.coverage, not arguments.no_composer, arguments.purge_extras, arguments.profile)
        elif arguments.command == 'mirror':
            mirror(recipe, Path(arguments.directory), Path(arguments.published).read_text().splitlines() if arguments.published else ())
        elif arguments.command == 'key':
            versions = sorted(recipe['php']['versions']) if arguments.all else [arguments.version or recipe['php']['ci']]
            print(pins_digest(recipe, architecture(), versions))
        elif arguments.command == 'describe':
            print(', '.join(f'PHP {upstream(recipe["tools"][f"php{v}-common"]["version"])}' for v in recipe['php']['versions']))
    except BuildError as error:
        print(f'php-build: {error}', file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
