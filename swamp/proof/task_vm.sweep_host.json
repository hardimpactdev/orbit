{
  "kind": "task_vm.sweep_host",
  "workflow": "operation-task-vm-sweep",
  "topology": "app-dev",
  "budget_seconds": 300,
  "queue_timeout_seconds": 10,
  "envelope": {
    "operation_id": "${proof.operation_id}",
    "node_id": "${proof.target.node_id}",
    "kind": "task_vm.sweep_host",
    "intent": {
      "node_id": "${proof.target.node_id}",
      "provider": "incus",
      "deadline_at": "${proof.epoch+300}",
      "ci_runner": false,
      "stray_vm_ids": [],
      "image_cutoff": 0,
      "running_stamps": [],
      "scope": {
        "project": "orbit-proof-sweep",
        "pool": "orbit-proof-sweep",
        "operator_owned": [],
        "live_names": [],
        "max_task_vm_id": 6,
        "max_build_id": 0,
        "recorded_build_ids": [],
        "retired_build_ids": [],
        "protected_build_ids": []
      },
      "ssh_execution": {
        "control_node_id": "${proof.control.node_id}",
        "identity_file": "${proof.control.identity_file}",
        "public_key": "${proof.control.public_key}",
        "target": {
          "name": "${proof.target.name}",
          "host": "${proof.target.host}",
          "user": "${proof.target.user}",
          "port": "${proof.target.port}",
          "host_keys": "${proof.target.host_keys}"
        }
      }
    },
    "execution_secrets": {}
  },
  "secrets": [],
  "target_setup": "task_vm.sweep_host/target-setup.sh",
  "expect": {
    "status": "succeeded",
    "outputs": {
      "job": "sweep",
      "step": "result",
      "match": {
        "ready": true
      }
    }
  },
  "phases": [
    {
      "name": "sweep",
      "job": "sweep",
      "step": "incus",
      "budget_seconds": 225
    }
  ],
  "parity": {
    "command": [
      "python3",
      "swamp/proof/task_vm.sweep_host/parity.py"
    ],
    "cases": [
      "real-public-receipt-matches-deleted-set",
      "real-orphan-absent-on-target",
      "real-topology-volume-absent-on-target"
    ]
  }
}
