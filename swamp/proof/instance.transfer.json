{
  "kind": "instance.transfer",
  "workflow": "operation-instance-transfer",
  "topology": "minimal",
  "budget_seconds": 1800,
  "queue_timeout_seconds": 30,
  "before_gateway": [
    [
      "sh",
      "-c",
      "printf '%s' \"$1\" | runuser -u orbit -- env -C apps/gateway php ../../tools/swamp-proof-guest/gateway.php fixture",
      "sh",
      "{\"clusters\": [{\"name\": \"proof\", \"node_ids\": [\"${node.target}\", \"${node.peer}\"], \"router_node_id\": \"${node.target}\"}]}"
    ]
  ],
  "prepare": [
    {
      "method": "POST",
      "path": "projects",
      "operation": false,
      "bind": "project",
      "body": {
        "slug": "proof-move",
        "name": "Proof move",
        "type": "monorepo",
        "root": "public",
        "repository_url": "https://github.com/laravel/laravel.git",
        "default_branch": "13.x"
      }
    },
    {
      "method": "POST",
      "path": "instances",
      "bind": "instance",
      "body": {
        "project_id": "${project.id}",
        "node_id": "${node.target}",
        "name": "t-${proof.run}"
      }
    },
    {
      "method": "PUT",
      "path": "instances/${instance.id}/environment/PROOF_MOVED",
      "operation": false,
      "body": {
        "value": "proof-moved-${proof.run}"
      }
    },
    {
      "method": "POST",
      "path": "routes",
      "body": {
        "instance_id": "${instance.id}",
        "domain": "t-${proof.run}.proof.test"
      }
    },
    {
      "method": "POST",
      "path": "schedules",
      "body": {
        "target_type": "instance",
        "target_id": "${instance.id}",
        "name": "moved-${proof.run}",
        "calendar": "@hourly",
        "command": "true"
      }
    }
  ],
  "request": {
    "method": "POST",
    "path": "instances/${instance.id}/transfer",
    "body": {
      "node_id": "${node.peer}"
    }
  },
  "expect": {
    "status": "succeeded"
  },
  "phases": [
    {
      "name": "Archive the checkout",
      "job": "transfer",
      "step": "Archive the checkout",
      "budget_seconds": 30
    },
    {
      "name": "Unpack the checkout",
      "job": "transfer",
      "step": "Unpack the checkout",
      "budget_seconds": 30
    },
    {
      "name": "Write .env",
      "job": "transfer",
      "step": "Write .env",
      "budget_seconds": 15
    },
    {
      "name": "Publish the Route",
      "job": "transfer",
      "step": "Publish the Route",
      "budget_seconds": 120
    },
    {
      "name": "Check the destination",
      "job": "transfer",
      "step": "Check the destination",
      "budget_seconds": 40
    },
    {
      "name": "Retire the source",
      "job": "transfer",
      "step": "Retire the source",
      "budget_seconds": 30
    }
  ],
  "parity": "swamp/proof/instance.transfer/parity.py"
}
