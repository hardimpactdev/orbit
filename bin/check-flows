#!/usr/bin/env node
// Checks every docs/cli/<family>/<name>.mmd against the subset the renderer supports and the text limits,
// checks the `%% kind:` lines and the chart placements in the pages, keeps flows-pending.txt shrinking,
// and holds the kinds in flows-migrated.txt to their Swamp workflow step names.
const { readdirSync, readFileSync } = require('node:fs')
const { execFileSync } = require('node:child_process')
const root = `${__dirname}/..`, dir = `${root}/docs/cli`
const list = (text) => text.split('\n').map((l) => l.trim()).filter((l) => l && !l.startsWith('#'))
const ok = [/^sequenceDiagram$/, /^autonumber$/, /^%%/, /^participant \w+ as .+$/, /^(alt|loop|opt|par)\b/, /^(else|and)\b/, /^end$/,
  /^Note over [\w, ]+: .+$/, /^\w+\s*(-->>|->>|--x|-x)\s*\w+\s*:\s*.+$/]
const files = readdirSync(dir, { recursive: true }).filter((n) => n.split('/').length === 2)
let bad = 0
const fail = (msg) => { bad++; console.log(msg) }
// Each chart names its operation kind once, and no two charts name the same kind.
const charts = new Map()
// The pipeline stage charts live in docs/reference/pipeline and are placed on reference pages; they are held to the same rules.
const refDir = `${root}/docs/reference`
const refCharts = readdirSync(`${refDir}/pipeline`).filter((n) => n.endsWith('.mmd')).map((n) => `pipeline/${n.slice(0, -4)}`)
for (const f of [...files.filter((n) => n.endsWith('.mmd')), ...refCharts.map((n) => `../reference/${n}.mmd`)]) {
  const kinds = [...readFileSync(`${dir}/${f}`, 'utf8').matchAll(/^\s*%% kind: (\S+)\s*$/gm)].map((m) => m[1])
  if (kinds.length !== 1) fail(`${f}: needs exactly one '%% kind: <kind>' line`)
  else if (charts.has(kinds[0])) fail(`${f}: kind ${kinds[0]} already has chart ${charts.get(kinds[0])}`)
  else charts.set(kinds[0], f)
}
for (const f of charts.values()) {
  const ids = new Set(), errs = []
  readFileSync(`${dir}/${f}`, 'utf8').split('\n').forEach((raw, i) => {
    const l = raw.trim(); if (!l) return
    if (!ok.some((r) => r.test(l))) errs.push(`${i + 1}: unsupported: ${l}`)
    let m
    if ((m = l.match(/^participant (\w+) as (.+)$/))) { ids.add(m[1]); const [t, s = ''] = m[2].split('<br/>'); if (t.length > 14 || s.length > 18) errs.push(`${i + 1}: lane text too long`) }
    if ((m = l.match(/^(\w+)\s*(?:-->>|->>|--x|-x)\s*(\w+)\s*:\s*(.+)$/))) { for (const id of [m[1], m[2]]) if (!ids.has(id)) errs.push(`${i + 1}: unknown lane ${id}`) }
    const text = l.match(/^(?:Note over [\w, ]+|\w+\s*(?:-->>|->>|--x|-x)\s*\w+)\s*:\s*(.+)$/)?.[1]
    if (text) { const [a, b = ''] = text.split('<br/>'); if (a.length > 26 || b.length > 34) errs.push(`${i + 1}: text too long (${a.length}/${b.length})`) }
  })
  if (errs.length) fail(`${f}\n  ${errs.join('\n  ')}`)
}

// A page places a chart explicitly under `## How it works`, in the form bin/docs-flows reads. Each placement names
// a chart, and a chart beside a page of its name is placed there.
const placed = new Map()
for (const page of files.filter((n) => n.endsWith('.mdx'))) {
  const text = readFileSync(`${dir}/${page}`, 'utf8')
  for (const m of text.matchAll(/^.*className="flow-at".*$/gm)) {
    const name = m[0].match(/^<div className="flow-at" data-chart="([a-z0-9-]+\/[a-z0-9-]+)"><\/div>$/)?.[1]
    const section = [...text.slice(0, m.index).matchAll(/^## (.+)$/gm)].at(-1)?.[1]
    if (!name) fail(`${page}: write a placement as <div className="flow-at" data-chart="<family>/<name>"></div>`)
    else if (section !== 'How it works') fail(`${page}: place ${name} under '## How it works'`)
    else if (!files.includes(`${name}.mmd`)) fail(`${page}: places ${name}, which is no chart`)
    else if (placed.has(name)) fail(`${page}: places ${name}, which ${placed.get(name)} places already`)
    else placed.set(name, page)
  }
}
for (const f of charts.values()) {
  const name = f.slice(0, -4)
  if (files.includes(`${name}.mdx`) && placed.get(name) !== `${name}.mdx`) fail(`${name}.mdx: place its chart under '## How it works'`)
}
// A reference page places a pipeline chart as `data-chart="reference/pipeline/<name>"`, and each of them is placed once.
const refPlaced = new Map()
for (const page of readdirSync(refDir).filter((n) => n.endsWith('.mdx'))) {
  for (const m of readFileSync(`${refDir}/${page}`, 'utf8').matchAll(/^.*className="flow-at".*$/gm)) {
    const name = m[0].match(/^<div className="flow-at" data-chart="reference\/(pipeline\/[a-z0-9-]+)"><\/div>$/)?.[1]
    if (!name) fail(`reference/${page}: write a placement as <div className="flow-at" data-chart="reference/pipeline/<name>"></div>`)
    else if (!refCharts.includes(name)) fail(`reference/${page}: places reference/${name}, which is no chart`)
    else if (refPlaced.has(name)) fail(`reference/${page}: places reference/${name}, which ${refPlaced.get(name)} places already`)
    else refPlaced.set(name, page)
  }
}
for (const name of refCharts) if (!refPlaced.has(name)) fail(`reference/${name}.mmd: place it on a reference page`)

// flows-pending.txt names kinds without a chart. A kind leaves it when its chart lands; no kind joins it.
const pending = list(readFileSync(`${dir}/flows-pending.txt`, 'utf8'))
for (const kind of pending) if (charts.has(kind)) fail(`flows-pending.txt: ${kind} has a chart; remove the line`)
if (process.env.BASE) {
  let before = null
  try { before = execFileSync('git', ['show', `${process.env.BASE}:docs/cli/flows-pending.txt`], { cwd: root, encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] }) } catch {}
  if (before !== null) for (const kind of pending) if (!list(before).includes(kind)) fail(`flows-pending.txt: ${kind} is new; the list may only shrink, so add its chart instead`)
}

// For a migrated kind, the Swamp lane's calls and notes are the workflow's steps, by the same names.
const workflows = readdirSync(`${root}/swamp/workflows`).filter((n) => n.endsWith('.yaml')).map((n) => readFileSync(`${root}/swamp/workflows/${n}`, 'utf8'))
// A child workflow may accept its callers' kinds; the Gateway declaration names the workflow that runs the kind.
const gateway = readdirSync(`${root}/apps/gateway/app/Domain`).flatMap((d) => { try { return [readFileSync(`${root}/apps/gateway/app/Domain/${d}/direct-operations.php`, 'utf8')] } catch { return [] } }).join('\n')
const namedWorkflow = (kind) => gateway.match(new RegExp(`'${kind.replace('.', '\\.')}' => \\[\\s*'workflow' => '([\\w-]+)'`))?.[1]
const runs = (yaml, kind) => namedWorkflow(kind) === undefined || yaml.match(/^name: (\S+)$/m)?.[1] === namedWorkflow(kind)
const declares = (yaml, kind) => (yaml.match(/^ {4}kind: \{type: string, (?:const: ([\w.]+)|enum: \[([^\]]+)\])\}/m) ?? []).slice(1).some((v) => v?.split(/,\s*/).includes(kind))
const stepNames = (yaml, kind) => {
  const names = []; let steps = null, item = null
  for (const line of yaml.split('\n')) {
    const indent = line.search(/\S/); if (indent < 0) continue
    if (/^\s*steps:\s*$/.test(line)) { steps = indent; item = null; continue }
    if (steps === null) continue
    if (indent < steps || (indent === steps && !line.trimStart().startsWith('- '))) { steps = null; continue }
    const m = line.match(/^(\s*)- name:\s*['"]?(.+?)['"]?\s*$/)
    if (m && (item ?? m[1].length) === m[1].length) { item = m[1].length; names.push(m[2]) }
    // An OR term which guards every other kind makes this step exclusive to one kind.
    const exclusive = line.match(/^\s*guard:.*\|\|\s*\(?inputs\.kind\s*!=\s*"([\w.]+)"\s*\|\|/)
    // A literal leading kind comparison joined by OR makes the whole skip guard true for that kind.
    // Unknown predicates stay in the chart; neither ternaries nor nested expressions are inferred.
    const skip = indent === item + 2 && !line.includes('?') && line.match(/^\s*guard:\s*['"]?\$\{\{\s*inputs(?:\.intent)?\.kind\s*(==|!=)\s*"([\w.]+)"\s*(?:\|\||\}\})/)
    if ((exclusive && exclusive[1] !== kind) || (skip && (skip[1] === '==' ? kind === skip[2] : kind !== skip[2]))) names.pop()
  }
  return names
}
for (const kind of list(readFileSync(`${dir}/flows-migrated.txt`, 'utf8'))) {
  const declared = workflows.filter((w) => declares(w, kind))
  const yaml = declared.length === 0 && namedWorkflow(kind) !== undefined ? workflows.filter((w) => runs(w, kind)) : declared.length > 1 ? declared.filter((w) => runs(w, kind)) : declared
  if (yaml.length !== 1) { fail(`flows-migrated.txt: ${kind} is declared by ${yaml.length} workflows, expected 1`); continue }
  if (!charts.has(kind)) { fail(`flows-migrated.txt: ${kind} has no chart`); continue }
  const src = readFileSync(`${dir}/${charts.get(kind)}`, 'utf8')
  const swamp = src.match(/^\s*participant (\w+) as Swamp\b/m)?.[1]
  const labels = [...src.matchAll(/^\s*(?:(\w+)\s*->>\s*\w+|Note over (\w+))\s*:\s*([^<\n]+)/gm)]
    .filter((m) => (m[1] ?? m[2]) === swamp).map((m) => m[3].trim())
  const names = stepNames(yaml[0], kind)
  if ([...labels].sort().join('\n') !== [...names].sort().join('\n')) fail(`${kind}: chart steps [${labels.join(', ')}] differ from workflow steps [${names.join(', ')}]`)
}
// Conn maps these stable clone phases to stage detail (docs/reference/conn.md#threads-in-an-orbit-project).
const cloneStages = ['clone-container', 'clone-workspace', 'clone-t3', 'clone-register']
const cloneWorkflow = workflows.find((yaml) => /^name: operation-instance-create$/m.test(yaml)) ?? ''
const cloneChart = readFileSync(`${dir}/instance/container/create.mmd`, 'utf8')
const workflowStages = stepNames(cloneWorkflow, 'instance.create').filter((name) => cloneStages.includes(name))
const chartStages = [...cloneChart.matchAll(/^\s*\w+->>\w+: [^\n]*<br\/>native (clone-[a-z0-9-]+)(?=$|[ \t])/gm)]
  .map((m) => m[1]).filter((name) => cloneStages.includes(name))
if ([workflowStages, chartStages].some((names) => names.join('\n') !== cloneStages.join('\n'))) {
  fail(`Conn clone stage contract: expected [${cloneStages.join(', ')}] in workflow and chart order; got workflow [${workflowStages.join(', ')}], chart [${chartStages.join(', ')}]`)
}
console.log(bad ? `${bad} problem(s)` : `all flows ok; ${pending.length} kinds pending`)
process.exitCode = bad ? 1 : 0
