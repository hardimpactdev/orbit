{
  "kind": "node.role_converge.metrics",
  "workflow": "operation-node-role-add",
  "topology": "minimal",
  "clean": true,
  "budget_seconds": 1800,
  "queue_timeout_seconds": 30,
  "before_gateway": [
    [
      "python3",
      "-c",
      "from pathlib import Path; public=' '.join(Path('/home/orbit/.orbit/ssh/proof_worker_ed25519.pub').read_text().split()[:2]); target=Path('/home/orbit/.ssh/authorized_keys'); lines=target.read_text().splitlines(); target.write_text('\\n'.join([*lines, public])+'\\n') if not any(' '.join(line.split()[:2]) == public for line in lines) else None"
    ],
    [
      "runuser",
      "-u",
      "orbit",
      "--",
      "php",
      "swamp/proof/node.role_add/prepare.php",
      "${node.metrics}",
      "metrics"
    ]
  ],
  "request": {
    "method": "POST",
    "path": "nodes/${node.metrics}/roles",
    "body": {
      "role": "metrics",
      "converge_existing": true
    }
  },
  "expect": {
    "status": "succeeded"
  },
  "phases": [
    {
      "name": "Check the role",
      "job": "role",
      "step": "Check the role",
      "budget_seconds": 20
    }
  ],
  "parity": [
    "swamp/proof/node.role_converge/parity.py",
    "metrics",
    "metrics"
  ],
  "prepare": [
    {
      "method": "POST",
      "path": "nodes/${node.metrics}/roles",
      "body": {
        "role": "metrics"
      }
    }
  ],
  "after_prepare": [
    [
      "python3",
      "swamp/proof/node.role_converge/capture.py",
      "metrics",
      "metrics"
    ]
  ]
}
