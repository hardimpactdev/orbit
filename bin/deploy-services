#!/usr/bin/env python3
"""Deploy origin/main to the existing Swamp Process on Services over SSH."""
import contextlib
import json
import os
from pathlib import Path
import shlex
import signal
import socket
import subprocess
import sys
import tempfile
import time

NODE = 17
APP = "/home/orbit/apps/orbit-swamp/default"
SWAMP = "/home/orbit/.local/bin/swamp"
DRAIN_TIMEOUT = 600
REMOTE_TIMEOUT = 180
SERVE_TIMEOUT_MS = 120_000
REQUIRED_SWAMP = "20261028.205235.0-sha.1602a617"
DRAIN_POLL = 2
INCOMING = "umask 077; mktemp /tmp/swamp-main.bundle.XXXXXXXX\n"
LOCK_FILE = "/home/orbit/.local/state/orbit-swamp/services-deploy-in-progress.json"

CHECK_HOST = r'''
set -eu
app=$1
swamp=$2
[ "$(id -un)" = orbit ]
[ -x "$swamp" ]
[ -x /home/orbit/.swamp/deno/deno ]
[ -d "$app/.swamp" ]
[ "$("$swamp" --version)" = "swamp $3" ] || { echo "Upgrade Services to Swamp $3 before deployment" >&2; exit 1; }
'''

ACTIVE = r'''
unset SWAMP_SERVER_URL SWAMP_SERVE_URL
"$1" run history --active --repo-dir "$2" --json
'''

SCHEDULES = r'''
"$1" workflow schedule list --server ws://127.0.0.1:9417 --token-file "$2" --json
'''

PAUSE = r'''
unset SWAMP_SERVER_URL SWAMP_SERVE_URL
"$1" workflow schedule pause "$3" --reason "Services deployment" --repo-dir "$2" --json
'''

RESUME = r'''
"$1" workflow schedule resume "$3" --server ws://127.0.0.1:9417 --token-file "$2" --json
'''

RESUME_STOPPED = r'''
unset SWAMP_SERVER_URL SWAMP_SERVE_URL
"$1" workflow schedule resume "$3" --repo-dir "$2" --json
'''

LIST_STOPPED = r'''
unset SWAMP_SERVER_URL SWAMP_SERVE_URL
"$1" workflow schedule list --repo-dir "$2" --json
'''

STATE = r'''
systemctl show "$1" --property=ActiveState --property=MainPID
'''

ACQUIRE = r'''
python3 - "$1" "$2" <<'LOCK_PY'
import json, os, sys, tempfile
from pathlib import Path
marker, owner = Path(sys.argv[1]), json.loads(sys.argv[2])
marker.parent.mkdir(parents=True, mode=0o700, exist_ok=True)
# Publish a complete protected marker atomically. A concurrent client never
# sees an empty file between exclusive creation and saving the snapshot path.
with tempfile.NamedTemporaryFile(mode="w", dir=marker.parent, delete=False) as candidate:
    json.dump(owner, candidate)
    candidate.flush()
    os.fsync(candidate.fileno())
try:
    try:
        os.link(candidate.name, marker)
    except FileExistsError:
        try:
            holder = json.loads(marker.read_text())
            detail = f"{holder['host']} PID {holder['pid']}; snapshot {holder['snapshot']}"
        except (OSError, ValueError, KeyError, TypeError):
            detail = f"unreadable marker {marker}; inspect it before recovery"
        raise SystemExit(f"Services deployment already in progress or needs recovery: {detail}. Marker: {marker}")
finally:
    os.unlink(candidate.name)
LOCK_PY
'''

RELEASE = r'''
python3 - "$1" "$2" <<'UNLOCK_PY'
import json, sys
from pathlib import Path
marker = Path(sys.argv[1])
if json.loads(marker.read_text()) != json.loads(sys.argv[2]):
    raise SystemExit("Deployment marker owner changed; refusing to remove it")
marker.unlink()
UNLOCK_PY
'''

PREFLIGHT = r'''
set -eu
python3 - "$1" "$2" "$3" <<'PREFLIGHT_PY'
import json, subprocess, sys
from pathlib import Path
app, bundle, sha = sys.argv[1:]
ref = "refs/remotes/bundle/main"

def git(*args):
    return subprocess.check_output(["git", "-C", app, *args], text=True,
                                   errors="surrogateescape")

if not (Path(app) / ".git").exists():
    raise SystemExit("Services checkout needs an existing HEAD; restore it from a bundle first")
head = subprocess.run(["git", "-C", app, "rev-parse", "--verify", "HEAD"],
                      capture_output=True, text=True)
if head.returncode != 0:
    raise SystemExit("Services checkout needs an existing HEAD; restore it from a bundle first")
git("diff", "--quiet")
git("diff", "--cached", "--quiet")
if git("branch", "--show-current").strip() != "main":
    raise SystemExit("Services checkout must be on main")
git("fetch", "--quiet", "--force", bundle, "refs/remotes/origin/main:" + ref)
if git("rev-parse", ref + "^{commit}").strip() != sha:
    raise SystemExit("Bundle main does not match the requested commit")
git("merge-base", "--is-ancestor", "HEAD", sha)
added = git("diff", "--name-only", "--no-renames", "--diff-filter=A", "-z", "HEAD", sha)
untracked = [entry[3:] for entry in
             git("status", "--porcelain", "-z", "--untracked-files=all").split("\0")
             if entry.startswith("?? ")]
for path in filter(None, added.split("\0")):
    for local in untracked:
        if path == local or path.startswith(local + "/") or local.startswith(path + "/"):
            raise SystemExit("Untracked path conflicts with bundle main: " + repr(local))
print(json.dumps({"changed": head.stdout.strip() != sha}))
PREFLIGHT_PY
'''

UPDATE = r'''
set -eu
app=$1
sha=$2
git -C "$app" merge --ff-only --quiet "$sha"
[ "$(git -C "$app" rev-parse HEAD)" = "$sha" ]
'''

HEALTH = r'''
set -eu
python3 - "$1" "$2" <<'HEALTH_PY'
import json, subprocess, sys, time
deadline = time.monotonic() + 360
while time.monotonic() < deadline:
    try:
        result = subprocess.run([
            sys.argv[1], "workflow", "schedule", "list", "--server", "ws://127.0.0.1:9417",
            "--token-file", sys.argv[2], "--json",
        ], capture_output=True, text=True, timeout=min(120, max(1, deadline - time.monotonic())))
        ready = result.returncode == 0 and "schedules" in json.loads(result.stdout)
    except (subprocess.TimeoutExpired, json.JSONDecodeError):
        ready = False
    if ready:
        print(json.dumps({"authenticated": True}))
        break
    time.sleep(1)
else:
    raise SystemExit("Swamp authenticated readiness check did not pass")
HEALTH_PY
'''



def run(argv, *, source=None, timeout=REMOTE_TIMEOUT):
    result = subprocess.run(argv, input=source, text=True, stdout=subprocess.PIPE,
                            stderr=subprocess.PIPE, check=False, timeout=timeout)
    if result.returncode:
        # Deployment subprocesses handle code and metadata only, never secret values.
        raise RuntimeError(f"{argv[0]} failed: {result.stderr.strip()}")
    return result.stdout


def orbit(*args):
    return json.loads(run(["orbit", *args, "--json"]))


def wait_for_idle(remote, token):
    deadline = time.monotonic() + DRAIN_TIMEOUT
    while True:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise RuntimeError(f"Swamp still has active runs after {DRAIN_TIMEOUT}s; deployment aborted")
        result = json.loads(remote(ACTIVE, SWAMP, APP, timeout=min(REMOTE_TIMEOUT, remaining)))
        if not isinstance(result, dict) or not isinstance(result.get("runs"), list):
            raise RuntimeError("Swamp active-run response is unreadable; deployment aborted")
        if not result["runs"]:
            return
        time.sleep(min(DRAIN_POLL, max(0, deadline - time.monotonic())))


@contextlib.contextmanager
def ignore_hangup():
    previous = signal.signal(signal.SIGHUP, signal.SIG_IGN)
    try:
        yield
    finally:
        signal.signal(signal.SIGHUP, previous)


@contextlib.contextmanager
def interruption_handlers():
    def interrupted(number, _frame):
        raise RuntimeError(f"Services deployment interrupted by {signal.Signals(number).name}")
    previous = {number: signal.signal(number, interrupted)
                for number in (signal.SIGTERM, signal.SIGHUP)}
    try:
        yield
    finally:
        for number, handler in previous.items():
            signal.signal(number, handler)


@contextlib.contextmanager
def deployment_lock(remote):
    with tempfile.NamedTemporaryFile(mode="w", prefix="swamp-deploy-schedules-",
                                     suffix=".json", delete=False) as snapshot:
        json.dump({"schedules": []}, snapshot)
        snapshot.flush()
        os.fsync(snapshot.fileno())
    owner = json.dumps({"host": socket.gethostname(), "pid": os.getpid(), "snapshot": snapshot.name})
    print(f"Protected schedule snapshot: {snapshot.name}", file=sys.stderr)
    remote(ACQUIRE, LOCK_FILE, owner, timeout=REMOTE_TIMEOUT)
    progress = {"snapshot": snapshot.name, "restored": True}
    original_error = None
    try:
        yield progress
    except BaseException as error:
        original_error = error
        raise
    finally:
        with ignore_hangup():
            if progress["restored"]:
                try:
                    remote(RELEASE, LOCK_FILE, owner, timeout=REMOTE_TIMEOUT)
                except (OSError, RuntimeError, subprocess.TimeoutExpired) as error:
                    prefix = f"Deployment failed: {original_error}. " if original_error else ""
                    raise RuntimeError(prefix + f"Deployment marker release failed: {error}. "
                                       f"Recover {LOCK_FILE}; snapshot {snapshot.name}") from original_error
            elif original_error is None:
                raise RuntimeError(f"Deployment restoration incomplete; retained {LOCK_FILE}; snapshot {snapshot.name}")


def schedule_list(remote, token, offline=False):
    listing = json.loads(remote(LIST_STOPPED if offline else SCHEDULES, SWAMP,
                                APP if offline else token, timeout=REMOTE_TIMEOUT))
    schedules = listing.get("schedules") if isinstance(listing, dict) else None
    if not isinstance(schedules, list) or any(
        not isinstance(s, dict) or not isinstance(s.get("workflowId"), str)
        or not s["workflowId"] or type(s.get("paused")) is not bool
        or type(s.get("orphaned")) is not bool for s in schedules
    ) or len({s["workflowId"] for s in schedules}) != len(schedules):
        raise RuntimeError("Swamp schedule list is unreadable; deployment aborted")
    return schedules


@contextlib.contextmanager
def paused_schedules(remote, token, stopped, progress):
    schedules = schedule_list(remote, token, True)
    enabled = [s for s in schedules if not s["paused"] and not s["orphaned"]]
    path = progress["snapshot"]
    with open(path, "w") as snapshot:
        json.dump({"schedules": schedules}, snapshot)
        snapshot.flush()
        os.fsync(snapshot.fileno())
    attempted = []
    uncertain_pause = None
    original_error = None
    try:
        for schedule in enabled:
            progress["restored"] = False
            attempted.append(schedule)
            uncertain_pause = schedule["workflowId"]
            remote(PAUSE, SWAMP, APP, schedule["workflowId"], timeout=REMOTE_TIMEOUT)
            uncertain_pause = None
        yield path
    except BaseException as error:
        original_error = error
        raise
    finally:
        with ignore_hangup():
            failures = []
            # The pinned filesystem store supports local schedule control while
            # serve is running. Do not depend on an overloaded websocket to undo
            # pauses, or abandon all resumes because one observation failed.
            for schedule in attempted:
                try:
                    remote(RESUME_STOPPED, SWAMP, APP, schedule["workflowId"], timeout=REMOTE_TIMEOUT)
                except (OSError, ValueError, RuntimeError, subprocess.TimeoutExpired) as error:
                    failures.append(f'{schedule.get("workflowName", schedule["workflowId"])} ({schedule["workflowId"]}): {error}')
            if attempted:
                try:
                    current = {s["workflowId"]: s for s in schedule_list(remote, token, True)}
                    failures.extend(f'{s["workflowId"]}: still paused or missing' for s in attempted
                                    if s["workflowId"] not in current or current[s["workflowId"]]["paused"])
                except (OSError, ValueError, RuntimeError, subprocess.TimeoutExpired) as error:
                    failures.append(f"Cannot verify restored schedules: {error}")
            if uncertain_pause is not None:
                # Losing SSH does not prove its remote write has finished. A
                # late pause could land after our resume and verification.
                failures.append(f"Pause outcome uncertain for {uncertain_pause}; confirm the remote pause command has ended, then repeat the saved resumes")
            if failures:
                prefix = f"Deployment failed: {original_error}. " if original_error else ""
                commands = "\n".join(shlex.join([SWAMP, "workflow", "schedule", "resume", s["workflowId"], "--repo-dir", APP, "--json"]) for s in attempted)
                raise RuntimeError(prefix + "SCHEDULES MAY STILL BE PAUSED. " + "; ".join(failures)
                                   + f". Retained marker {LOCK_FILE}; snapshot {path}. "
                                   + "On Services as orbit, unset SWAMP_SERVER_URL and SWAMP_SERVE_URL, then restore only this snapshot's enabled schedules:\n" + commands
                                   + "\nThen verify schedule list and remove the marker only after confirming its deployer is gone.") from original_error
            progress["restored"] = True


def deploy():
    with interruption_handlers():
        return _deploy()


def _deploy():
    root = Path(__file__).resolve().parent.parent
    node = orbit("node:show", str(NODE))
    if node["status"] != "active" or node["user"] != "orbit":
        raise RuntimeError("Services must be active with managed user orbit")
    processes = orbit("process:list", f"--node={NODE}")["processes"]
    matches = [p for p in processes if p["name"] == "swamp-serve"]
    if len(matches) != 1:
        raise RuntimeError("Create exactly one swamp-serve Process on Services first")
    process = matches[0]
    if (process["runtime"] != "systemd" or process["user"] != "orbit"
            or process["working_directory"] != APP):
        raise RuntimeError("Swamp Process must use systemd, user orbit and the documented directory")
    host = f'orbit@{node["wireguard_ip"]}'
    options = ["-o", "BatchMode=yes", "-o", "ConnectTimeout=8"]
    if os.environ.get("SWAMP_SSH_IDENTITY"):
        options += ["-i", os.environ["SWAMP_SSH_IDENTITY"]]

    def remote(script, *args, timeout=REMOTE_TIMEOUT):
        return run(["ssh", *options, host, shlex.join(["env", f"SWAMP_SERVE_TIMEOUT_MS={SERVE_TIMEOUT_MS}", "bash", "-s", "--", *args])],
                   source=script, timeout=timeout)

    remote(CHECK_HOST, APP, SWAMP, REQUIRED_SWAMP)
    token = "/home/orbit/.config/swamp/serve-driver-token"

    def process_stopped():
        unit = f'orbit-process-{process["id"]}-{process["name"]}.service'
        observed = dict(line.split("=", 1) for line in remote(STATE, unit, timeout=REMOTE_TIMEOUT).splitlines() if "=" in line)
        if observed.get("ActiveState") in ("inactive", "failed") and observed.get("MainPID") == "0":
            return True
        if observed.get("ActiveState") == "active" and int(observed.get("MainPID", "0")) > 0:
            return False
        raise RuntimeError("Cannot establish whether the Swamp Process is stopped; inspect systemd state")

    with deployment_lock(remote) as progress:
        run(["git", "-C", str(root), "fetch", "--quiet", "origin", "main"])
        sha = run(["git", "-C", str(root), "rev-parse", "origin/main"]).strip()
        with tempfile.TemporaryDirectory(prefix="swamp-deploy-") as tmp:
            bundle = str(Path(tmp) / "main.bundle")
            run(["git", "-C", str(root), "bundle", "create", bundle, "refs/remotes/origin/main"])
            incoming = remote(INCOMING).strip()
            snapshot = None
            try:
                run(["scp", *options, "-q", bundle, f"{host}:{incoming}"])
                preflight = json.loads(remote(PREFLIGHT, APP, incoming, sha))
                if preflight["changed"]:
                    with paused_schedules(remote, token, process_stopped, progress) as snapshot:
                        wait_for_idle(remote, token)
                        orbit("process:stop", str(process["id"]))
                        if not process_stopped():
                            raise RuntimeError("Swamp Process is still running after stop; refusing checkout update")
                        remote(UPDATE, APP, sha)
                        orbit("process:restart", str(process["id"]))
                        health = json.loads(remote(HEALTH, SWAMP, token, timeout=400))
                else:
                    health = json.loads(remote(HEALTH, SWAMP, token, timeout=400))
            finally:
                try:
                    remote('rm -f -- "$1"\n', incoming)
                except (OSError, RuntimeError, subprocess.TimeoutExpired) as error:
                    print(f"Bundle cleanup failed for {incoming}: {error}", file=sys.stderr)
        return {"status": "ok", "sha": sha, "node": NODE,
                "process": process["id"], "scheduleSnapshot": snapshot, **preflight, **health}


if __name__ == "__main__":
    try:
        print(json.dumps(deploy()))
    except (OSError, ValueError, KeyError, RuntimeError, subprocess.TimeoutExpired) as error:
        print(json.dumps({"status": "failed", "error": str(error)}))
        sys.exit(1)
