{
  "kind": "firewall.allow",
  "workflow": "operation-firewall-direct",
  "topology": "minimal",
  "budget_seconds": 300,
  "expect": {
    "status": "succeeded"
  },
  "phases": [
    {
      "name": "assets",
      "job": "firewall",
      "step": "assets",
      "budget_seconds": 60
    },
    {
      "name": "apply",
      "job": "firewall",
      "step": "apply",
      "budget_seconds": 60
    },
    {
      "name": "accepted",
      "job": "firewall",
      "step": "accepted",
      "budget_seconds": 60
    }
  ],
  "prepare": [
    {
      "method": "POST",
      "path": "nodes/${node.target}/firewall-rules/deny",
      "body": {
        "port": "5432",
        "protocol": "tcp"
      }
    }
  ],
  "request": {
    "method": "POST",
    "path": "nodes/${node.target}/firewall-rules/allow",
    "body": {
      "port": "5432",
      "protocol": "tcp",
      "source": "192.0.2.10",
      "label": "db office"
    }
  },
  "parity": [
    "swamp/proof/firewall/check.py",
    "+5432/tcp ALLOW 192.0.2.10 # orbit db office",
    "+5432/tcp DENY Anywhere # orbit",
    "+5432/tcp (v6) DENY Anywhere (v6)"
  ]
}
