{
  "kind": "node.role_converge",
  "workflow": "operation-node-role-add",
  "topology": "minimal",
  "clean": false,
  "budget_seconds": 1800,
  "queue_timeout_seconds": 30,
  "prepare": [
    {
      "method": "POST",
      "path": "nodes/${node.peer}/roles",
      "body": {
        "role": "app-dev",
        "converge_existing": true
      }
    }
  ],
  "after_prepare": [
    [
      "python3",
      "swamp/proof/node.role_converge/capture.py",
      "peer",
      "app-dev"
    ]
  ],
  "request": {
    "method": "POST",
    "path": "nodes/${node.peer}/roles",
    "body": {
      "role": "app-dev",
      "converge_existing": true
    }
  },
  "expect": {
    "status": "succeeded"
  },
  "phases": [
    {
      "name": "Check the role",
      "job": "role",
      "step": "Check the role",
      "budget_seconds": 20
    }
  ],
  "parity": [
    "swamp/proof/node.role_converge/parity.py",
    "peer",
    "app-dev"
  ]
}
