# Managed by Orbit: Node Caddy build
{
    auto_https disable_certs
    order abort first
    metrics {
        per_host
    }
}

# orbit: app-dev app-instance-3713
https://task-5888.dlf-leden.test {
    bind 10.44.0.7 192.168.6.20
    tls /etc/caddy/orbit-certificates/app-instance-3713/current/cert.pem /etc/caddy/orbit-certificates/app-instance-3713/current/key.pem
    @orbit_probe header X-Orbit-Probe 1
log_skip @orbit_probe
log_skip @orbit_asleep
log {
    output file /data/caddy/orbit/hibernation/app-instance-3713.log {
        roll_size 1MiB
        roll_keep 1
    }
}
@orbit_asleep {
    not header X-Orbit-Probe 1
    file {
        root /data/caddy/orbit/hibernation
        try_files /app-instance-3713.asleep
    }
}
handle @orbit_asleep {
    forward_auth https://gateway.orbit {
        uri /api/v1/runtime-activations/app-instance/3713
        header_up Host gateway.orbit
        transport http {
            tls_trusted_ca_certs /usr/local/share/ca-certificates/orbit-managed-root-ca.crt
            tls_server_name gateway.orbit
        }
    }
}
    reverse_proxy 10.253.0.71:8080 {
    flush_interval -1
    transport http {
        read_timeout 1h
        response_header_timeout 1h
    }
}
}

# orbit: app-dev app-instance-3713-dev
https://task-5888.dlf-leden.test:444 {
    bind 10.44.0.7
    @orbit_outside not remote_ip 10.44.0.0/24
    abort @orbit_outside
    tls /etc/caddy/orbit-certificates/app-instance-3713/current/cert.pem /etc/caddy/orbit-certificates/app-instance-3713/current/key.pem
    @orbit_dev_port expression `string({http.request.port}).matches('^[0-9]+$') && int({http.request.port}) >= 1024 && int({http.request.port}) <= 65535`
    handle @orbit_dev_port {
        reverse_proxy 10.253.0.71:{http.request.port} {
            flush_interval -1
            transport http {
                read_timeout 1h
            }
        }
    }
    respond "Orbit development port refused" 404
}

