{
  "kind": "vault.teardown",
  "workflow": "operation-vault-teardown",
  "topology": "minimal",
  "clean": true,
  "budget_seconds": 1800,
  "queue_timeout_seconds": 30,
  "expect": {
    "status": "succeeded",
    "run": false
  },
  "before_gateway": [
    [
      "python3",
      "-I",
      "swamp/tests/fixtures/vaultwarden_proof_setup.py",
      "keep"
    ]
  ],
  "prepare": [
    {
      "method": "POST",
      "path": "extensions/vault/enable",
      "body": {},
      "operation": false
    },
    {
      "method": "PUT",
      "path": "vault",
      "body": {
        "url": "${secret.url}",
        "client_id": "${secret.client_id}",
        "client_secret": "${secret.client_secret}",
        "master_password": "${secret.master_password}",
        "organization": "${secret.organization}",
        "collection": "${secret.collection}"
      }
    },
    {
      "method": "POST",
      "path": "vault/sync",
      "body": {}
    }
  ],
  "request": {
    "method": "DELETE",
    "path": "vault",
    "body": {
      "keep_items": true
    }
  },
  "phases": [],
  "parity": [
    "swamp/proof/vault/teardown_parity.py",
    "keep"
  ]
}
