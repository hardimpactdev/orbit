{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "hardimpactdev/orbit-e2e",
    "description": "External Orbit end-to-end harness.",
    "keywords": [
        "e2e",
        "orbit",
        "testing"
    ],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.5"
    },
    "require-dev": {
        "laravel/pint": "^1.29",
        "pestphp/pest": "^4.6",
        "phpstan/phpstan": "^2.1",
        "rector/rector": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse --memory-limit=512M",
        "e2e:dev-topology": "php bin/e2e-dev-topology @additional_args",
        "e2e:dev-topology:release": "php bin/e2e-dev-topology-release @additional_args",
        "format": "vendor/bin/pint",
        "rector": "vendor/bin/rector process",
        "test": "vendor/bin/pest --compact"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "rector/rector": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
