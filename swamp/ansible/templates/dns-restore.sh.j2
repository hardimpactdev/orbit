#!/bin/sh
{#
  The recovery of a private DNS publication that did not hold: puts the Node back as the snapshot saw it. It is a shell script because two
  callers run it and neither may depend on the other: the detached cutover on the Node (when dnsmasq does not come up, even after the
  controller is gone) and the rescue of the play (when a check failed). Both run it as root, under the lock of the publication or the
  detached job, and it is safe to run twice.
  Pure: it reads restore_snap (the manifest of dns-snapshot.j2), restore_probe (a name to ask), dns.listen, and the paths and numbers of the
  play (dns_snapshot, dns_dir, dns_conf_file, dns_loaded_file, dns_local_resolver, dns_port, dns_restore_deadline).
  What it does, in order: files back (and the files of the candidate that the Node did not hold, gone), systemd re-read, dnsmasq in the
  state it had, the old listener units in the state they had (enabled, then started, socket first), then the answers of the restored
  resolvers over UDP and TCP on every listen address, retried until a deadline. Exit status 0 only when every step and every answer held.
#}
# Generated by dns-publish for the snapshot of revision {{ restore_snap.revision }}. Do not edit.
fail=0
bad() { fail=1; printf 'restore: %s failed\n' "$1" >&2; }
rm -f -- {{ dns_loaded_file | quote }} || bad 'the loaded copy'
{% for f in restore_snap.files if f.present %}
mkdir -p -- {{ (f.path | dirname) | quote }} && cp -p -- {{ (dns_snapshot ~ '/files/' ~ f.saved) | quote }} {{ f.path | quote }} || bad {{ f.path | quote }}
{% endfor %}
{% for f in restore_snap.files if not f.present %}
rm -f -- {{ f.path | quote }} || bad {{ f.path | quote }}
{% endfor %}
{% for f in restore_snap.files if f.binder %}
rm -f -- {{ (dns_dir ~ '/disabled/' ~ (f.path | basename)) | quote }} || bad {{ (dns_dir ~ '/disabled/' ~ (f.path | basename)) | quote }}
{% endfor %}
systemctl daemon-reload || bad 'daemon-reload'
{% for u in restore_snap.units if u.name == 'dnsmasq' %}
{% if u.enabled %}
systemctl enable dnsmasq >/dev/null 2>&1 || bad 'enable dnsmasq'
{% else %}
systemctl disable dnsmasq >/dev/null 2>&1 || bad 'disable dnsmasq'
{% endif %}
{% if u.active %}
if systemctl restart dnsmasq; then
{% if restore_snap.files | selectattr('present') | selectattr('path', 'equalto', dns_conf_file) | list | length > 0 %}
  cp -p -- {{ dns_conf_file | quote }} {{ dns_loaded_file | quote }} || bad 'the loaded copy'
{% else %}
  :
{% endif %}
else
  bad 'restart dnsmasq'
fi
{% else %}
systemctl stop dnsmasq || bad 'stop dnsmasq'
{% endif %}
{% endfor %}
{% for u in restore_snap.units if u.name != 'dnsmasq' and u.enabled %}
systemctl enable -- {{ u.name | quote }} >/dev/null 2>&1 || bad {{ ('enable ' ~ u.name) | quote }}
{% endfor %}
{% for u in restore_snap.units if u.name != 'dnsmasq' and u.active %}
systemctl start -- {{ u.name | quote }} || bad {{ ('start ' ~ u.name) | quote }}
{% endfor %}
end=$(( $(date +%s) + {{ dns_restore_deadline }} ))
ask() {
  while :; do
    out=$(timeout 8 dig "@$1" -p {{ dns_port }} +noall +comments +tries=1 +time=2 "$2" {{ restore_probe | quote }} A 2>/dev/null)
    case $out in
      *'status: NOERROR'*|*'status: NXDOMAIN'*) return 0 ;;
    esac
    [ "$(date +%s)" -ge "$end" ] && return 1
    sleep 1
  done
}
{% for address in dns.listen + [dns_local_resolver] %}
ask {{ address | quote }} +notcp || bad {{ ('answer on ' ~ address ~ ' over UDP') | quote }}
ask {{ address | quote }} +tcp || bad {{ ('answer on ' ~ address ~ ' over TCP') | quote }}
{% endfor %}
exit "$fail"
