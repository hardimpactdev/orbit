#!/usr/bin/env php
<?php

declare(strict_types=1);

use App\Domain\Operations\OperationRegistryCheck;
use Illuminate\Contracts\Console\Kernel;

require __DIR__.'/../apps/gateway/vendor/autoload.php';

$app = require __DIR__.'/../apps/gateway/bootstrap/app.php';
$app->make(Kernel::class)->bootstrap();
$count = $app->make(OperationRegistryCheck::class)->execute();
fwrite(STDOUT, "Operation registry valid: {$count} kinds.\n");
