{
  "kind": "tool.install",
  "workflow": "operation-tool-write-209",
  "topology": "minimal",
  "budget_seconds": 300,
  "queue_timeout_seconds": 60,
  "clean_target": [
    ["timeout", "120", "apt-get", "update"],
    ["sh", "-c", "dpkg --purge rex >/dev/null 2>&1; true"]
  ],
  "request": {"method": "POST", "path": "tools", "body": {"node_id": "${node.target}", "manager": "apt", "package": "rex", "repository": {"name": "rex", "uris": ["https://pkgs.superlogical.com/rex/apt"], "suites": ["preview"], "components": ["main"], "signing_key": {"url": "https://pkgs.superlogical.com/rex/keys/rex-archive-keyring.gpg", "fingerprint": "E28636AC71905C6DDE40C1EDFAA6B80F641307A7"}}}},
  "expect": {"status": "succeeded"},
  "phases": [
    {"name": "Assert the key fingerprint", "job": "tools", "step": "Assert the key fingerprint", "budget_seconds": 10},
    {"name": "Publish the signing key", "job": "tools", "step": "Publish the signing key", "budget_seconds": 60},
    {"name": "Check apt package", "job": "tools", "step": "Check apt package", "budget_seconds": 60},
    {"name": "Check the candidate", "job": "tools", "step": "Check the candidate", "budget_seconds": 120},
    {"name": "Choose package action", "job": "tools", "step": "Choose package action", "budget_seconds": 30},
    {"name": "Apply the package", "job": "tools", "step": "Apply the package", "budget_seconds": 900},
    {"name": "Assert package state", "job": "tools", "step": "Assert package state", "budget_seconds": 10}
  ],
  "parity": "swamp/proof/tool.install/parity.py"
}
