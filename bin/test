#!/usr/bin/env python3
"""Run all project suites within the gate's shared worker budget."""
from concurrent.futures import ThreadPoolExecutor
import os
from pathlib import Path
import runpy
import subprocess
import sys
import tempfile
import threading

ROOT = Path(__file__).resolve().parent.parent
PROJECTS = ('apps/cli', 'apps/docs', 'apps/gateway', 'apps/e2e', 'packages/php-sdk')
_budget = runpy.run_path(str(ROOT / 'tools/check_budget.py'))
ProcessBudget, lane_count, lane_weight = (_budget[name] for name in ('ProcessBudget', 'lane_count', 'lane_weight'))


def main():
    for project in PROJECTS:
        if not os.access(ROOT / project / 'vendor/bin/pest', os.X_OK):
            print(f'{project} is not installed. Run bin/bootstrap first.', file=sys.stderr)
            return 2
    result = subprocess.run([str(ROOT / 'bin/check-processes')], capture_output=True, text=True, check=False)
    if result.returncode:
        print(result.stderr, file=sys.stderr, end='')
        return result.returncode
    processes = int(result.stdout.strip())
    weights = {project: lane_weight(ROOT, project) for project in PROJECTS}
    budget = ProcessBudget(processes, weights)
    output_lock = threading.Lock()
    print(f'Running {len(PROJECTS)} suites within a budget of {processes} Pest processes.', flush=True)
    with tempfile.TemporaryDirectory(prefix='orbit-test-') as directory:
        def run(project):
            budget.start(project)
            try:
                share = budget.acquire(project)
                log = Path(directory) / project.replace('/', '-')
                with log.open('w') as output:
                    result = subprocess.run(
                        [str(ROOT / 'bin/pest-plain'), 'vendor/bin/pest', '--parallel', f'--processes={share}',
                         '--compact', '--colors=never'],
                        cwd=ROOT / project, env={**os.environ, 'ORBIT_CHECK_PROCESSES': str(share)},
                        stdout=output, stderr=subprocess.STDOUT, check=False,
                    )
                with output_lock:
                    print(f'\n[{project}] {"passed" if result.returncode == 0 else "failed"}', flush=True)
                    print(log.read_text(), end='', flush=True)
                return result.returncode
            finally:
                budget.finish(project)
        with ThreadPoolExecutor(max_workers=lane_count(PROJECTS, processes)) as pool:
            results = list(pool.map(run, sorted(PROJECTS, key=lambda project: -weights[project])))
    return int(any(results))


if __name__ == '__main__':
    sys.exit(main())
