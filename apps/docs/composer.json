{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "nckrtl/orbit-docs",
    "description": "Console tooling for verified Orbit documentation context.",
    "keywords": [
        "documentation",
        "laravel",
        "librarian",
        "orbit"
    ],
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "hardimpactdev/librarian": "^0.0.3",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.11",
        "laravel/pao": "^1.1",
        "laravel/pint": "^1.32",
        "laravel/vet": "^0.2.1",
        "mockery/mockery": "^1.6",
        "nckrtl/pestphp-monorepo": "dev-main",
        "nunomaduro/collision": "^8.8",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpunit/phpunit": "^13.0",
        "rector/rector": "^2.3",
        "spaze/phpstan-disallowed-calls": "^4.14"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Orbit\\PHPStan\\": "../../tools/phpstan/"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse --no-progress --memory-limit=1G",
        "check": [
            "@guidance:check",
            "@docs:lint",
            "@fixtures:check",
            "@analyse",
            "@rector",
            "@format:check"
        ],
        "context": "@php artisan orbit:docs-context",
        "context:build": "@php artisan orbit:docs-index",
        "docs:lint": "@php artisan orbit:docs-lint --format=agent --strict",
        "fixtures:check": "python3 ../../bin/api-fixtures --check",
        "issue:lint": "@php artisan orbit:issue-lint",
        "format": "vendor/bin/pint --parallel --max-processes=$(../../bin/check-processes)",
        "format:check": "../../bin/quality-scope pint vendor/bin/pint --test --parallel --max-processes=$(../../bin/check-processes)",
        "guidance:check": "../../bin/guidance-check",
        "lint": "@format:check",
        "rector": "../../bin/quality-scope rector vendor/bin/rector process --dry-run --no-progress-bar --clear-cache",
        "test": "../../bin/pest-plain vendor/bin/pest --parallel --processes=$(../../bin/check-processes) --compact --colors=never",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "process-timeout": 0,
        "sort-packages": true,
        "allow-plugins": {
            "laravel/vet": true,
            "pestphp/pest-plugin": true,
            "rector/rector": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
