{
  "kind": "instance.env_import",
  "workflow": "operation-instance-env-import",
  "topology": "minimal",
  "clean": true,
  "budget_seconds": 90,
  "queue_timeout_seconds": 30,
  "prepare": [
    {
      "method": "POST",
      "path": "projects",
      "operation": false,
      "bind": "project",
      "body": {
        "slug": "proof-env-import",
        "name": "Proof env import",
        "type": "laravel-app",
        "root": "public",
        "repository_url": "https://github.com/laravel/laravel.git",
        "default_branch": "13.x"
      }
    },
    {
      "method": "PUT",
      "path": "nodes/${node.target}/access/${node.target}",
      "operation": false
    },
    {
      "method": "POST",
      "path": "instances/register",
      "caller": "target",
      "operation": false,
      "bind": "instance",
      "body": {
        "source_path": "/home/orbit/apps/proof-env-import/i-${proof.run}",
        "project_id": "${project.id}"
      }
    },
    {
      "method": "POST",
      "path": "routes",
      "bind": "route",
      "body": {
        "instance_id": "${instance.id}",
        "domain": "i-${proof.run}.proof-env-import.test"
      }
    }
  ],
  "before_target": [
    [
      "runuser",
      "-u",
      "orbit",
      "--",
      "sh",
      "-eu",
      "-c",
      "base=/home/orbit/apps/proof-env-import/i-$1; printf 'PROOF_IMPORTED=\"%s\"\\n' \"$(openssl rand -hex 32)\" >> \"$base/.env\"; sha256sum \"$base/.env\" > /tmp/orbit-env-before-$1",
      "sh",
      "${proof.run}"
    ]
  ],
  "request": {
    "method": "POST",
    "path": "instances/${instance.id}/environment/import",
    "body": {
      "replace": true
    }
  },
  "expect": {
    "status": "succeeded"
  },
  "phases": [
    {
      "name": "Stage .env for the copy",
      "job": "import",
      "step": "Stage .env for the copy",
      "budget_seconds": 15
    },
    {
      "name": "Copy .env to 209",
      "job": "import",
      "step": "Copy .env to 209",
      "budget_seconds": 15
    },
    {
      "name": "Remove the staged copy",
      "job": "import",
      "step": "Remove the staged copy",
      "budget_seconds": 15
    },
    {
      "name": "Read .env into the vault",
      "job": "import",
      "step": "Read .env into the vault",
      "budget_seconds": 15
    },
    {
      "name": "Remove the local copy",
      "job": "import",
      "step": "Remove the local copy",
      "budget_seconds": 15
    }
  ],
  "parity": "swamp/proof/instance.env_import/parity.py",
  "before_node": {
    "target": [
      [
        "runuser",
        "-u",
        "orbit",
        "--",
        "sh",
        "-eu",
        "-c",
        "base=/home/orbit/apps/proof-env-import/i-$1; mkdir -p /home/orbit/apps/proof-env-import; git clone -q --depth=1 --branch 13.x https://github.com/laravel/laravel.git \"$base\"; cp \"$base/.env.example\" \"$base/.env\"; chmod 0600 \"$base/.env\"",
        "sh",
        "${proof.run}"
      ],
      [
        "systemctl",
        "restart",
        "orbit-agent"
      ]
    ]
  },
  "before_gateway": [
    [
      "runuser",
      "-u",
      "orbit",
      "--",
      "env",
      "-C",
      "/home/orbit/swamp-proof/src/apps/gateway",
      "HOME=/tmp",
      "XDG_CONFIG_HOME=/tmp",
      "timeout",
      "120",
      "php",
      "artisan",
      "tinker",
      "--execute",
      "$path='/home/orbit/apps/proof-env-import/i-${proof.run}'; $deadline=microtime(true)+110; while(!App\\Models\\NodeFact::where('node_id',${node.target})->where('kind','checkout')->where('subject',$path)->exists()){if(microtime(true)>$deadline){throw new RuntimeException('checkout fact timed out');}sleep(1);} echo 'agent checkout fact ready';"
    ]
  ]
}
