#!/usr/bin/env bash

set -Eeuo pipefail

TARGET_DIR="${ORBIT_INSTALL_PATH:-$HOME/orbit}"
REPO_URL="${ORBIT_REPO_URL:-https://github.com/hardimpactdev/orbit.git}"
BRANCH="${ORBIT_BRANCH:-main}"
SOURCE_ARCHIVE=""
LINK_PATH="${ORBIT_BIN_PATH:-/usr/local/bin/orbit}"
USE_SUDO=1
SKIP_PREREQUISITES="${ORBIT_INSTALL_SKIP_PREREQUISITES:-0}"
GATEWAY_MODE="${ORBIT_INSTALL_GATEWAY:-0}"
VERBOSE=0
LOG_FILE="${ORBIT_INSTALL_LOG:-}"
CURRENT_STEP=""

usage() {
    cat <<'HELP'
usage: bin/install-orbit [options]

Install the Orbit CLI and its Docker-first runtime prerequisites on the
current host. The installer prepares host PHP CLI for the CLI/local-executor
artifact, Docker, the Orbit source checkout, the orbit-runtime and orbit-caddy
container images, starts the orbit-runtime container, and runs migrations
inside the container. No host Composer, host Caddy, or host PHP-FPM is
installed.

Options:
  --path=PATH                  Orbit checkout path. Defaults to "$HOME/orbit".
  --repo=URL                   Git repository to clone when no source archive is provided.
  --branch=NAME                Git branch to clone or update. Defaults to "main".
  --source-archive=PATH        Extract this Orbit source tarball instead of cloning.
  --bin=PATH                   Symlink path for the orbit executable.
                               Defaults to "/usr/local/bin/orbit".
  --skip-prerequisites         Skip Docker / package prerequisite installation.
                               Intended for prepared E2E images that already
                               contain runtime packages.
  --gateway                    Start orbit-runtime with ORBIT_IS_GATEWAY=1 so
                               the gateway API HTTP listener is brought up
                               alongside the scheduler. Pass on first-gateway
                               provisioning.
  --no-sudo                    Run package and symlink commands without sudo.
  --verbose                    Stream underlying command output.
  -h, --help                   Show this help text.

The installer is intentionally local-host only. A new control node runs it
before invoking Orbit. Gateway and app roles are provisioned by node:new from a
configured control node.
HELP
}

fail() {
    local code="$1"
    shift

    printf 'orbit-install: error [%s] %s\n' "$code" "$*" >&2

    if [ -n "$LOG_FILE" ] && [ -f "$LOG_FILE" ]; then
        printf 'orbit-install: log %s\n' "$LOG_FILE" >&2
    fi

    exit 1
}

quote() {
    printf '%q' "$1"
}

run() {
    ensure_log_file

    {
        printf '+'
        printf ' %q' "$@"
        printf '\n'
    } >>"$LOG_FILE"

    if [ "$VERBOSE" = "1" ]; then
        "$@" 2>&1 | tee -a "$LOG_FILE"

        return "${PIPESTATUS[0]}"
    fi

    "$@" >>"$LOG_FILE" 2>&1
}

sudo_run() {
    if [ "$USE_SUDO" = "1" ] && [ "$(id -u)" -ne 0 ]; then
        run sudo "$@"
        return
    fi

    run "$@"
}

sudo_shell() {
    if [ "$USE_SUDO" = "1" ] && [ "$(id -u)" -ne 0 ]; then
        run sudo bash -lc "$1"
        return
    fi

    run bash -lc "$1"
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || fail validation_failed "required command missing: $1"
}

ensure_log_file() {
    local tmp_dir
    local tmp_file

    if [ -n "$LOG_FILE" ]; then
        return
    fi

    tmp_dir="${TMPDIR:-/tmp}"
    tmp_dir="${tmp_dir%/}"
    tmp_file="$(mktemp "$tmp_dir/orbit-install.XXXXXX")"
    LOG_FILE="${tmp_file}.log"
    mv "$tmp_file" "$LOG_FILE"
}

render_plan() {
    printf '  ┌ Orbit install\n'
    printf '  │\n'
    printf '  ○  Validate installer input\n'
    printf '  │\n'
    printf '  ○  Install host prerequisites\n'
    printf '  │\n'
    printf '  ○  Install Orbit source\n'
    printf '  │\n'
    printf '  ○  Prepare orbit-runtime and orbit-caddy images\n'
    printf '  │\n'
    printf '  ○  Bootstrap Orbit runtime in the container\n'
    printf '  │\n'
    printf '  ○  Start orbit-runtime container\n'
    printf '  │\n'
    printf '  ○  Run migrations inside orbit-runtime\n'
    printf '  │\n'
    printf '  ○  Align orbit checkout ownership\n'
    printf '  │\n'
    printf '  ○  Link orbit executable\n'
    printf '  │\n'
    printf '  ○  Verify Orbit\n'
    printf '  │\n'
    printf '  └  Log: %s\n\n' "$LOG_FILE"
}

start_step() {
    CURRENT_STEP="$1"
    printf '  ◉  %s\n' "$CURRENT_STEP"
}

complete_step() {
    printf '  ●  %s\n' "$CURRENT_STEP"
    CURRENT_STEP=""
}

fail_step() {
    local status="$1"

    if [ -n "$CURRENT_STEP" ]; then
        printf '  ●  %s failed\n' "$CURRENT_STEP" >&2
    fi

    if [ -n "$LOG_FILE" ] && [ -f "$LOG_FILE" ]; then
        printf 'orbit-install: log %s\n' "$LOG_FILE" >&2
        tail -n 20 "$LOG_FILE" >&2 || true
    fi

    exit "$status"
}

finish_tree() {
    printf '\n  └  Orbit installed at %s\n' "$TARGET_DIR"
}

parse_args() {
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --path=*)
                TARGET_DIR="${1#*=}"
                ;;
            --repo=*)
                REPO_URL="${1#*=}"
                ;;
            --branch=*)
                BRANCH="${1#*=}"
                ;;
            --source-archive=*)
                SOURCE_ARCHIVE="${1#*=}"
                ;;
            --bin=*)
                LINK_PATH="${1#*=}"
                ;;
            --skip-prerequisites)
                SKIP_PREREQUISITES=1
                ;;
            --gateway)
                GATEWAY_MODE=1
                ;;
            --no-sudo)
                USE_SUDO=0
                ;;
            --verbose)
                VERBOSE=1
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            *)
                fail validation_failed "unknown option: $1"
                ;;
        esac

        shift
    done
}

validate_args() {
    [ -n "$TARGET_DIR" ] || fail validation_failed "--path is required"
    [ -n "$LINK_PATH" ] || fail validation_failed "--bin is required"
}

wait_for_cloud_init() {
    if ! command -v cloud-init >/dev/null 2>&1; then
        return
    fi

    sudo_run cloud-init status --wait || true
}

host_php_is_ready() {
    local version

    command -v php >/dev/null 2>&1 || return 1

    version="$(php --version 2>/dev/null | head -n 1 || true)"

    [[ "$version" == PHP\ 8.4.* ]] || return 1

    php -r 'foreach (["pdo_sqlite", "openssl", "curl", "mbstring", "json"] as $extension) { if (! extension_loaded($extension)) { exit(1); } }' >/dev/null 2>&1
}

verify_host_php_baseline() {
    local version

    require_command php

    version="$(php --version 2>/dev/null | head -n 1 || true)"

    if [[ "$version" != PHP\ 8.4.* ]]; then
        fail validation_failed "host php must resolve to PHP 8.4.x after prerequisite installation; got: ${version:-missing}"
    fi

    if ! php -r 'foreach (["pdo_sqlite", "openssl", "curl", "mbstring", "json"] as $extension) { if (! extension_loaded($extension)) { fwrite(STDERR, $extension.PHP_EOL); exit(1); } }' >/dev/null 2>&1; then
        fail validation_failed "host php is missing one of the required extensions: pdo_sqlite, openssl, curl, mbstring, json"
    fi
}

ubuntu_requires_ondrej_php_ppa() {
    local version_id

    version_id="$(. /etc/os-release && printf '%s' "$VERSION_ID")"

    case "$version_id" in
        22.04|24.04)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

install_host_php_ubuntu() {
    if host_php_is_ready; then
        printf 'orbit-install: host PHP 8.4 CLI baseline already present\n'
        return
    fi

    printf 'orbit-install: installing host PHP 8.4 CLI baseline\n'

    sudo_run env DEBIAN_FRONTEND=noninteractive apt-get install -y software-properties-common

    if ubuntu_requires_ondrej_php_ppa; then
        sudo_run add-apt-repository ppa:ondrej/php -y
        sudo_run apt-get update
    else
        printf 'orbit-install: using Ubuntu package repositories for PHP 8.4 CLI baseline\n'
    fi

    sudo_run env DEBIAN_FRONTEND=noninteractive apt-get install -y \
        php8.4-cli \
        php8.4-mbstring \
        php8.4-curl \
        php8.4-sqlite3 \
        php8.4-xml

    if [ -x /usr/bin/php8.4 ]; then
        sudo_run update-alternatives --set php /usr/bin/php8.4
    fi

    verify_host_php_baseline
}

install_ubuntu_prerequisites() {
    wait_for_cloud_init

    sudo_run apt-get update
    sudo_run env DEBIAN_FRONTEND=noninteractive apt-get install -y \
        ca-certificates \
        curl \
        git \
        gnupg \
        openssh-client \
        tar \
        unzip \
        wireguard \
        wireguard-tools

    install_host_php_ubuntu
    install_docker_engine_ubuntu
}

install_docker_engine_ubuntu() {
    local needs_install=0
    if ! command -v docker >/dev/null 2>&1; then
        needs_install=1
    fi

    if [ "$needs_install" = "1" ]; then
        local keyring="/etc/apt/keyrings/docker.gpg"
        local codename
        codename="$(. /etc/os-release && printf '%s' "$VERSION_CODENAME")"

        sudo_run install -d -m 0755 /etc/apt/keyrings
        sudo_shell "curl -fsSL --retry 3 --retry-delay 2 https://download.docker.com/linux/ubuntu/gpg -o /tmp/docker.gpg.armor && gpg --batch --yes --dearmor -o ${keyring} /tmp/docker.gpg.armor && rm -f /tmp/docker.gpg.armor"
        sudo_run chmod 0644 "${keyring}"
        sudo_shell "printf 'deb [arch=%s signed-by=%s] https://download.docker.com/linux/ubuntu %s stable\n' \"\$(dpkg --print-architecture)\" \"${keyring}\" \"${codename}\" > /etc/apt/sources.list.d/docker.list"
        sudo_run apt-get update
        sudo_run env DEBIAN_FRONTEND=noninteractive apt-get install -y \
            docker-ce \
            docker-ce-cli \
            containerd.io \
            docker-buildx-plugin \
            docker-compose-plugin
        sudo_run systemctl enable --now docker
    fi

    grant_runtime_user_docker_access
}

grant_runtime_user_docker_access() {
    # Add the user that runs Orbit commands to the docker group so steady-state
    # use of `orbit` does not need sudo. The current shell will not gain the
    # new group membership in this session — install-orbit therefore continues
    # to invoke docker via sudo through `docker_cli` so the install path is
    # valid before group membership is picked up by a future login.
    local current_user
    current_user="$(id -un)"

    if [ "$current_user" = "root" ]; then
        return
    fi

    if ! getent group docker >/dev/null 2>&1; then
        # docker-ce should have created this group; in case it didn't (or
        # docker is supplied through an alternate mechanism), keep going so
        # later steps surface the real error.
        return
    fi

    if id -nG "$current_user" 2>/dev/null | tr ' ' '\n' | grep -qx docker; then
        return
    fi

    sudo_run usermod -aG docker "$current_user"
}

# Wrapper around `docker` that picks the right access path for install-time
# use. The runtime user is added to the docker group above, but that
# membership is not visible until the next login, so we transparently sudo
# during install. After install, the host launcher (`bin/orbit`) runs as the
# user's interactive session and uses the docker group directly.
docker_cli() {
    if [ "$(id -u)" -eq 0 ] || [ "$USE_SUDO" != "1" ]; then
        docker "$@"
        return
    fi

    sudo -n docker "$@"
}

brew_formula_installed() {
    brew --prefix "$1" >/dev/null 2>&1
}

install_host_php_macos() {
    if host_php_is_ready; then
        printf 'orbit-install: host PHP 8.4 CLI baseline already present\n'
        return
    fi

    printf 'orbit-install: installing host PHP 8.4 CLI baseline\n'

    if brew_formula_installed php@8.4; then
        printf 'orbit-install: Homebrew php@8.4 already installed; linking host php\n'
    elif brew search --formula php@8.4 2>/dev/null | grep -qx php@8.4; then
        run brew install php@8.4
    else
        run brew install php
    fi

    if brew_formula_installed php@8.4; then
        run brew link --overwrite --force php@8.4
    fi

    verify_host_php_baseline
}

install_macos_prerequisites() {
    require_command brew

    run brew update
    install_host_php_macos
    run brew install git
    require_command docker
}

install_prerequisites() {
    if [ "$SKIP_PREREQUISITES" = "1" ]; then
        return
    fi

    case "$(uname -s)" in
        Linux)
            if [ -r /etc/os-release ] && grep -q '^ID=ubuntu$' /etc/os-release; then
                install_ubuntu_prerequisites
                return
            fi

            fail node.unsupported_platform "only Ubuntu Linux is supported for Orbit host installation"
            ;;
        Darwin)
            install_macos_prerequisites
            ;;
        *)
            fail node.unsupported_platform "unsupported operating system: $(uname -s)"
            ;;
    esac
}

require_docker() {
    require_command docker

    if ! docker_cli info >/dev/null 2>&1; then
        fail validation_failed "Docker daemon is not reachable; start Docker before running install-orbit"
    fi
}

install_source() {
    if [ -n "$SOURCE_ARCHIVE" ]; then
        [ -f "$SOURCE_ARCHIVE" ] || fail validation_failed "source archive not found: $SOURCE_ARCHIVE"

        if [ -e "$TARGET_DIR" ] && [ ! -f "$TARGET_DIR/artisan" ]; then
            fail validation_failed "$TARGET_DIR exists and does not look like an Orbit checkout"
        fi

        run mkdir -p "$TARGET_DIR"
        run tar --no-same-owner -xzf "$SOURCE_ARCHIVE" -C "$TARGET_DIR"

        return
    fi

    require_command git

    if [ -d "$TARGET_DIR/.git" ]; then
        run git -C "$TARGET_DIR" fetch --prune
        run git -C "$TARGET_DIR" checkout "$BRANCH"
        run git -C "$TARGET_DIR" pull --ff-only

        return
    fi

    if [ -e "$TARGET_DIR" ]; then
        fail validation_failed "$TARGET_DIR exists but is not a git checkout"
    fi

    run git clone --branch "$BRANCH" "$REPO_URL" "$TARGET_DIR"
}

build_runtime_images() {
    require_docker

    run docker_cli build \
        -f "$TARGET_DIR/docker/orbit-runtime/Dockerfile" \
        -t "orbit-runtime:current" \
        "$TARGET_DIR"

    run docker_cli pull "caddy:2-alpine"
}

bootstrap_runtime() {
    require_docker

    if [ ! -f "$TARGET_DIR/.env" ]; then
        run cp "$TARGET_DIR/.env.example" "$TARGET_DIR/.env"
    fi

    run mkdir -p "$TARGET_DIR/database"

    if [ ! -f "$TARGET_DIR/database/database.sqlite" ]; then
        run touch "$TARGET_DIR/database/database.sqlite"
    fi

    run docker_cli run --rm \
        --pull never \
        -v "$TARGET_DIR":/opt/orbit \
        orbit-runtime:current \
        composer install --no-dev --no-interaction --prefer-dist --optimize-autoloader

    run docker_cli run --rm \
        --pull never \
        -v "$TARGET_DIR":/opt/orbit \
        orbit-runtime:current \
        bash -lc "grep -q '^APP_KEY=base64:' .env || php artisan key:generate --force --no-interaction"
}

container_env_contains() {
    local needle="$1"
    local env_output

    # Capture docker output before piping into grep so pipefail does not
    # turn a SIGPIPE-on-early-grep-match into a false negative.
    env_output="$(docker_cli container inspect --format '{{range .Config.Env}}{{println .}}{{end}}' orbit-runtime 2>/dev/null || true)"

    grep -qxF -- "$needle" <<<"$env_output"
}

prepare_orbit_caddy_host_paths() {
    # orbit-runtime mounts /etc/caddy and /etc/orbit (rw) so the gateway
    # bootstrap inside the container can mutate the same host paths that
    # orbit-caddy reads. Docker `--mount type=bind` requires the source to
    # exist, so prepare it on the host first.
    sudo_run install -d -m 0755 \
        /etc/caddy \
        /etc/caddy/orbit \
        /etc/caddy/sites \
        /etc/orbit \
        /etc/orbit/certs
}

start_runtime_container() {
    require_docker
    prepare_orbit_caddy_host_paths

    if ! docker_cli network inspect orbit-network >/dev/null 2>&1; then
        run docker_cli network create \
            --label "orbit.managed=true" \
            --label "orbit.network.kind=runtime" \
            orbit-network
    fi

    local gateway_env=()
    if [ "$GATEWAY_MODE" = "1" ]; then
        gateway_env=(--env "ORBIT_IS_GATEWAY=1")
    fi

    if docker_cli container inspect orbit-runtime >/dev/null 2>&1; then
        local needs_recreate=0

        if [ "$GATEWAY_MODE" = "1" ] && ! container_env_contains "ORBIT_IS_GATEWAY=1"; then
            printf 'orbit-install: existing orbit-runtime container is missing ORBIT_IS_GATEWAY=1; recreating to enable the gateway API listener\n' >&2
            needs_recreate=1
        fi

        if [ "$needs_recreate" = "0" ] && ! container_env_contains "ORBIT_HOST_PATH=$TARGET_DIR"; then
            printf 'orbit-install: existing orbit-runtime container is missing ORBIT_HOST_PATH=%s; recreating so host-path-aware operations work\n' "$TARGET_DIR" >&2
            needs_recreate=1
        fi

        if [ "$needs_recreate" = "1" ]; then
            run docker_cli rm -f orbit-runtime
        else
            local running
            running="$(docker_cli container inspect --format '{{.State.Running}}' orbit-runtime 2>/dev/null || true)"

            if [ "$running" != "true" ]; then
                run docker_cli start orbit-runtime
            fi

            return
        fi
    fi

    run docker_cli run -d \
        --pull never \
        --name orbit-runtime \
        --restart unless-stopped \
        --network orbit-network \
        --network-alias orbit-runtime \
        --label "orbit.managed=true" \
        --label "orbit.container.kind=runtime" \
        --env "ORBIT_SOURCE_PATH=/opt/orbit" \
        --env "ORBIT_HOST_PATH=$TARGET_DIR" \
        "${gateway_env[@]}" \
        --mount "type=bind,source=$TARGET_DIR,target=/opt/orbit" \
        --mount "type=bind,source=/var/run/docker.sock,target=/var/run/docker.sock" \
        --mount "type=bind,source=/etc/caddy,target=/etc/caddy" \
        --mount "type=bind,source=/etc/orbit,target=/etc/orbit" \
        orbit-runtime:current
}

run_migrations_in_container() {
    require_docker

    run docker_cli exec \
        --env "ORBIT_HOST_CWD=$TARGET_DIR" \
        --env "ORBIT_HOST_UID=$(id -u)" \
        --env "ORBIT_HOST_GID=$(id -g)" \
        orbit-runtime \
        php /opt/orbit/artisan migrate --force --no-interaction
}

link_orbit() {
    if [ -e "$LINK_PATH" ] && [ ! -L "$LINK_PATH" ]; then
        fail validation_failed "$LINK_PATH exists and is not a symlink"
    fi

    if [ ! -f "$TARGET_DIR/bin/orbit" ]; then
        fail validation_failed "Orbit launcher missing: $TARGET_DIR/bin/orbit"
    fi

    run chmod 0755 "$TARGET_DIR/bin/orbit"
    sudo_run ln -sf "$TARGET_DIR/bin/orbit" "$LINK_PATH"
}

verify_install() {
    if [ ! -x "$TARGET_DIR/bin/orbit" ]; then
        fail validation_failed "Orbit launcher is not executable: $TARGET_DIR/bin/orbit"
    fi

    local running
    running="$(docker_cli container inspect --format '{{.State.Running}}' orbit-runtime 2>/dev/null || true)"

    if [ "$running" != "true" ]; then
        fail validation_failed "orbit-runtime container is not running after install"
    fi
}

finalize_target_ownership() {
    local parent
    local parent_owner

    parent="$(dirname "$TARGET_DIR")"

    case "$(uname -s)" in
        Linux)
            parent_owner="$(stat -c '%U:%G' "$parent" 2>/dev/null || true)"
            ;;
        Darwin)
            parent_owner="$(stat -f '%Su:%Sg' "$parent" 2>/dev/null || true)"
            ;;
        *)
            return
            ;;
    esac

    if [ -z "$parent_owner" ] || [ "${parent_owner%:*}" = "$(id -un)" ]; then
        return
    fi

    sudo_run chown -R "$parent_owner" "$TARGET_DIR"
}

main() {
    parse_args "$@"

    ensure_log_file
    trap 'fail_step "$?"' ERR

    render_plan

    start_step "Validate installer input"
    validate_args
    complete_step

    start_step "Install host prerequisites"
    install_prerequisites
    complete_step

    start_step "Install Orbit source"
    install_source
    complete_step

    start_step "Prepare orbit-runtime and orbit-caddy images"
    build_runtime_images
    complete_step

    start_step "Bootstrap Orbit runtime in the container"
    bootstrap_runtime
    complete_step

    start_step "Start orbit-runtime container"
    start_runtime_container
    complete_step

    start_step "Run migrations inside orbit-runtime"
    run_migrations_in_container
    complete_step

    start_step "Align orbit checkout ownership"
    finalize_target_ownership
    complete_step

    start_step "Link orbit executable"
    link_orbit
    complete_step

    start_step "Verify Orbit"
    verify_install
    complete_step

    finish_tree
}

if [ "${BASH_SOURCE[0]:-$0}" = "$0" ]; then
    main "$@"
fi
