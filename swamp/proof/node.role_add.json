{
  "kind": "node.role_add",
  "workflow": "operation-node-role-add",
  "topology": "minimal",
  "clean": false,
  "budget_seconds": 1800,
  "queue_timeout_seconds": 30,
  "before_gateway": [
    [
      "runuser",
      "-u",
      "orbit",
      "--",
      "php",
      "swamp/proof/node.role_add/prepare.php",
      "${node.peer}",
      "app-dev"
    ]
  ],
  "request": {
    "method": "POST",
    "path": "nodes/${node.peer}/roles",
    "body": {
      "role": "app-dev"
    }
  },
  "expect": {
    "status": "succeeded"
  },
  "phases": [
    {
      "name": "Check the role",
      "job": "role",
      "step": "Check the role",
      "budget_seconds": 20
    }
  ],
  "parity": [
    "swamp/proof/node.role_add/parity.py",
    "peer",
    "app-dev"
  ],
  "before_node": {
    "peer": [
      [
        "dpkg",
        "--purge",
        "--force-depends",
        "git",
        "git-man"
      ],
      [
        "rm",
        "-f",
        "/var/cache/orbit/tool-setup/composer/git.deb",
        "/var/cache/orbit/tool-setup/composer/git-man.deb"
      ]
    ]
  }
}
