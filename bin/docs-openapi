def openapi_path(route):
    params = []

    def repl(m):
        name = PARAM_RENAME.get(m.group(1), m.group(1))
        params.append(name)
        return '{' + name + '}'

    return re.sub(r'\{([^}]+)\}', repl, '/' + route['uri']), params


# ---------------------------------------------------------------- validation rules -> JSON schema
def strip_closures(text):
    out = ''
    i = 0
    pattern = re.compile(r'(static\s+)?(function|fn)\s*\(')
    while i < len(text):
        m = pattern.search(text, i)
        if not m:
            out += text[i:]
            break
        out += text[i:m.start()]
        j = text.find('{', m.end())
        k = text.find('=>', m.end())
        if m.group(2) == 'fn' or (k != -1 and (j == -1 or k < j)):
            depth = 0
            p = m.end()
            while p < len(text):
                if text[p] in '([{':
                    depth += 1
                elif text[p] in ')]}':
                    if depth == 0:
                        break
                    depth -= 1
                elif text[p] == ',' and depth == 0:
                    break
                p += 1
            i = p
            continue
        depth = 0
        p = j
        while p < len(text):
            if text[p] == '{':
                depth += 1
            elif text[p] == '}':
                depth -= 1
                if depth == 0:
                    break
            p += 1
        i = p + 1
    return out


def parse_rule_entries(text):
    arr = text[text.find('return'):]
    j = arr.find('[')
    depth = 0
    k = j
    entries = {}
    key = None
    vstart = None
    while k < len(arr):
        c = arr[k]
        if c == "'" and depth >= 1:
            e = k + 1
            while e < len(arr) and not (arr[e] == "'" and arr[e - 1] != '\\'):
                e += 1
            if depth == 1 and key is None:
                m = re.match(r"'([^']+)'\s*=>", arr[k:])
                if m:
                    key = m.group(1)
                    k += len(m.group(0))
                    vstart = k
                    continue
            k = e + 1
            continue
        if c in '[({':
            depth += 1
        elif c in '])}':
            depth -= 1
            if depth == 0:
                if key is not None:
                    entries[key] = arr[vstart:k]
                break
        elif c == ',' and depth == 1 and key is not None:
            entries[key] = arr[vstart:k]
            key = None
            vstart = None
        k += 1
    return entries


ROUTE_TERNARY = re.compile(
    r"str_starts_with\(\s*\(string\)\s*\$this->route\(\)\?->getName\(\)\s*,\s*'([^']*)'\s*\)\s*\?\s*'([^']*)'\s*:\s*'([^']*)'"
)


def resolve_route_ternaries(value, route_name):
    """Resolve rules chosen by the route name, such as `str_starts_with($this->route()?->getName(), 'project:') ? 'required' : 'sometimes'`."""
    return ROUTE_TERNARY.sub(
        lambda m: "'" + (m.group(2) if (route_name or '').startswith(m.group(1)) else m.group(3)) + "'",
        value,
    )


def tokens_for(value, route_name=None):
    """Laravel rule strings, plus strictBoolean and strictTrue, which accept only a JSON boolean."""
    v = strip_closures(resolve_route_ternaries(value, route_name))
    toks = []
    # These closures are not Laravel rule names. strip_closures leaves the call in place, and without
    # this the field falls through to string, so every value the tool schema allows is rejected.
    if re.search(r'\bstrict(?:Boolean|True)\s*\(', value):
        toks.append(('rule', 'boolean'))
    for m in re.finditer(r'Rule::enum\((\w+)::class\)(?:->only\(\[(.*?)\]\))?', v, re.S):
        if m.group(2) is not None:
            cases = re.findall(r'(\w+)::(\w+)', m.group(2))
            toks.append(('in', [enum_cases[f'{enum}::{case}'] for enum, case in cases]))
        else:
            toks.append(('enum', m.group(1)))
    for m in re.finditer(r'Rule::in\(\[(.*?)\]\)', v, re.S):
        # Quoted values, integer literals and `Enum::Case->value`; class constants are resolved before parsing.
        values = []
        for token in re.finditer(r"'([^']*)'|(\w+)::(\w+)->value|(?<![\w])(-?\d+)(?![\w])", m.group(1)):
            if token.group(1) is not None:
                values.append(token.group(1))
                continue
            if token.group(4) is not None:
                values.append(int(token.group(4)))
                continue
            case = f'{token.group(2)}::{token.group(3)}'
            value = enum_cases.get(case)
            if value is None:
                sys.exit(f'Rule::in references unknown enum case {case}')
            values.append(value)
        toks.append(('in', values))
    if 'Rule::requiredIf' in v or 'required_if' in v:
        toks.append(('requiredIf', None))
    v2 = re.sub(r'Rule::\w+\(.*?\)(?=\s*[,\]])', '', v, flags=re.S)
    for m in re.finditer(r"'((?:[^'\\]|\\.)*)'", v2):
        s = m.group(1)
        parts = [s] if not ('|' in s and ':' not in s.split('|')[0] and not s.startswith('regex')) else s.split('|')
        for t in parts:
            toks.append(('rule', t))
    return toks


TYPE_RULES = {'string': 'string', 'integer': 'integer', 'int': 'integer', 'numeric': 'number', 'boolean': 'boolean', 'bool': 'boolean', 'array': 'array', 'list': 'array', 'uuid': 'string', 'ipv4': 'string', 'ipv6': 'string', 'ip': 'string', 'email': 'string', 'url': 'string', 'json': 'string', 'alpha_dash': 'string', 'lowercase': 'string', 'ascii': 'string'}


def schema_from_tokens(toks):
    sch = {}
    required = False
    sometimes = False
    nullable = False
    notes = []
    type_ = None
    for kind, t in toks:
        if kind == 'enum':
            sch['enum'] = enums.get(t, [])
            type_ = type_ or 'string'
        elif kind == 'in':
            sch['enum'] = t
            type_ = type_ or ('integer' if t and all(isinstance(value, int) for value in t) else 'string')
        elif kind == 'requiredIf':
            notes.append('Conditionally required.')
        elif kind == 'rule':
            base, _, arg = t.partition(':')
            if base in TYPE_RULES and type_ is None:
                type_ = TYPE_RULES[base]
            if base in ('uuid', 'ipv4', 'ipv6', 'email'):
                sch['format'] = base
            elif base == 'url':
                sch['format'] = 'uri'
            elif base in ('required', 'present'):
                # `present` means the key is in the body, which is `required` in OpenAPI.
                required = True
            elif base == 'sometimes':
                sometimes = True
            elif base == 'nullable':
                nullable = True
            elif base == 'array' and arg:
                type_ = 'object'
                sch['additionalProperties'] = False
            elif base == 'alpha_dash':
                sch['pattern'] = '^[A-Za-z0-9_-]+$'
            elif base == 'max':
                sch['_max'] = arg
            elif base == 'min':
                sch['_min'] = arg
            elif base == 'between':
                a, b = arg.split(',')
                sch['_min'] = a
                sch['_max'] = b
            elif base == 'in':
                sch['enum'] = arg.split(',')
            elif base == 'regex':
                pat = arg
                if pat and not pat[0].isalnum() and pat[0] not in '^(':
                    pat = pat[1:pat.rfind(pat[0])]
                # ECMAScript's $ also matches before a final newline. PCRE's \z must mean true end of input.
                sch['pattern'] = pat.replace('\\A', '^').replace('\\z', r'$(?![\s\S])')
            elif base == 'required_without':
                notes.append(f'Required when `{arg}` is absent.')
            elif base == 'prohibited':
                notes.append('Must be absent.')
    type_ = type_ or 'string'
    mx, mn = sch.pop('_max', None), sch.pop('_min', None)
    if type_ == 'string':
        if mx:
            sch['maxLength'] = int(mx)
        if mn:
            sch['minLength'] = int(mn)
    elif type_ in ('integer', 'number'):
        if mx:
            sch['maximum'] = int(mx)
        if mn:
            sch['minimum'] = int(mn)
    elif type_ == 'array':
        if mx:
            sch['maxItems'] = int(mx)
        if mn:
            sch['minItems'] = int(mn)
    if nullable and 'enum' in sch and None not in sch['enum']:
        sch['enum'] = [*sch['enum'], None]
    sch = {'type': [type_, 'null'] if nullable else type_, **sch}
    if notes:
        sch['description'] = ' '.join(notes)
    # A `sometimes|required` field is optional, but the request still needs a body with at least one field.
    return sch, required and not sometimes, required and sometimes


def clean_schema(s):
    if isinstance(s, dict):
        if s.get('required') == []:
            s.pop('required')
        if s.get('type') == 'object' and s.get('properties') == {}:
            s.pop('properties')
        for v in s.values():
            clean_schema(v)
    elif isinstance(s, list):
        for v in s:
            clean_schema(v)
    return s


def database_field_rules():
    """The shared database connection rules, with their constant-backed regex rule strings resolved."""
    path = GW / 'app/Http/Requests/DatabaseConnections/DatabaseConnectionFieldRules.php'
    return resolve_rule_constants(path.read_text(), path)


def database_update_rules(field_rules):
    """Expand the shared store rules and the update method's removals and overrides."""
    entries = parse_rule_entries(block(field_rules, field_rules.find('function store(')))
    update = block(field_rules, field_rules.find('function update('))
    for key in re.findall(r"unset\(\$rules\['([^']+)'\]\)", update):
        entries.pop(key)
    for key, value in re.findall(r"\$rules\['([^']+)'\]\s*=\s*(\[.*?\]);", update, re.S):
        entries[key] = value
    return 'return [' + ','.join(f"'{key}' => {value}" for key, value in entries.items()) + '];'


def rules_to_schema(rules_text, route_name=None):
    root = {'type': 'object', 'properties': {}, 'required': []}
    body_required = False
    for key, value in parse_rule_entries(rules_text).items():
        sch, req, required_when_sent = schema_from_tokens(tokens_for(value, route_name))
        body_required = body_required or ('.' not in key and required_when_sent)
        parts = key.split('.')
        node = root
        for idx, part in enumerate(parts):
            last = idx == len(parts) - 1
            if part == '*':
                node.setdefault('type', 'array')
                if last:
                    node['items'] = {**sch, **node.get('items', {})} if isinstance(node.get('items'), dict) else sch
                else:
                    items = node.get('items')
                    node['items'] = items if isinstance(items, dict) and items.get('type') == 'object' else {'type': 'object', 'properties': {}, 'required': []}
                    node = node['items']
            else:
                node.setdefault('properties', {})
                node.setdefault('required', [])
                if last:
                    existing = node['properties'].get(part, {})
                    merged = dict(sch)
                    if existing.get('type') == 'array' and sch['type'] != 'array':
                        merged = existing
                    for k2 in ('items', 'properties', 'required'):
                        if k2 in existing:
                            merged[k2] = existing[k2]
                    node['properties'][part] = merged
                    if req and part not in node['required']:
                        node['required'].append(part)
                else:
                    child = node['properties'].setdefault(part, {'type': 'object', 'properties': {}, 'required': []})
                    if parts[idx + 1] == '*':
                        child['type'] = 'array'
                    else:
                        child['type'] = ['object', 'null'] if isinstance(child.get('type'), list) and 'null' in child['type'] else 'object'
                        for drop in ('items', 'maxItems', 'minItems'):
                            child.pop(drop, None)
                    node = child
    if route_name in ('instance:rename', 'instance:update', 'node:update'):
        root['minProperties'] = 1
    if route_name == 'instance:update':
        root['properties']['shared_paths']['type'] = ['array', 'null']
    return clean_schema(root), body_required


# ---------------------------------------------------------------- data classes -> component schemas
components = {}
DOC_LIST = re.compile(r'^(?:list|array)<(?:int,\s*)?([\w\\]+)>$')
SCALARS = {'string': 'string', 'int': 'integer', 'bool': 'boolean', 'float': 'number'}


def comp_name(cls):
    return cls[:-4] if cls.endswith('Data') else cls


def ref(cls):
    name = comp_name(cls)
    if name not in components:
        components[name] = None
        d = gdata[cls]
        props = {}
        for key, prop in schema_fields(d):
            props[key] = prop_schema(prop)
        components[name] = {'type': 'object', 'properties': props}
        if name in {'DependencyResults', 'DependencyAttempt', 'DependencySource', 'DependencyReport', 'DependencyPackage', 'DependencyFinding', 'DependencyReason', 'DependencyLinks', 'DependencyBatchPr', 'DependencyPullRequest'}:
            components[name].update(required=list(props), additionalProperties=False)
    return {'$ref': f'#/components/schemas/{name}'}


def schema_fields(d):
    """Property names the API actually returns, paired with the constructor property that types each one."""
    by_name = {p['name']: p for p in d['props']}
    if d.get('outputs'):
        return [(key, by_name[prop]) for key, prop in d['outputs']]
    if d['snake']:
        return [(snake(p['name']), p) for p in d['props']]
    return [(p['name'], p) for p in d['props']]


def prop_schema(p):
    t = p['type'].replace('\\', '')
    doc = (p['doc'] or '').replace('\\', '')
    nullable = t.startswith('?') or '|null' in t or 'null|' in t
    t = t.lstrip('?').replace('|null', '').replace('null|', '')
    t = '|'.join(part for part in t.split('|') if part != 'Optional')
    union = [part.strip() for part in t.split('|') if part.strip()]
    if len(union) > 1 and all(part in SCALARS for part in union):
        kinds = []
        for part in union:
            kind = SCALARS[part]
            if kind not in kinds:
                kinds.append(kind)
        sch = {'type': kinds if len(kinds) > 1 else kinds[0]}
    elif t in SCALARS:
        sch = {'type': SCALARS[t]}
    elif t == 'mixed':
        sch = {}
    elif t == 'array':
        m = DOC_LIST.match(doc.removesuffix('|Optional'))
        if m and m.group(1) in gdata:
            sch = {'type': 'array', 'items': ref(m.group(1))}
        elif m and m.group(1) in SCALARS:
            sch = {'type': 'array', 'items': {'type': SCALARS[m.group(1)]}}
        elif re.match(r'^(?:list|array)<array<string,\s*string(?:\|bool)?>>$', doc):
            value = {'type': ['string', 'boolean']} if '|bool' in doc else {'type': 'string'}
            sch = {'type': 'array', 'items': {'type': 'object', 'additionalProperties': value}}
        elif doc == 'array<string, mixed>|list<never>':
            sch = {'oneOf': [{'type': 'object', 'additionalProperties': True}, {'type': 'array', 'maxItems': 0}]}
        elif doc.startswith('array<string'):
            sch = {'type': 'object', 'additionalProperties': True}
        elif doc.startswith(('list<', 'array<int')):
            sch = {'type': 'array', 'items': {'type': 'object'}}
        else:
            sch = {'type': 'object', 'additionalProperties': True}
    elif t in gdata:
        sch = ref(t)
    elif t in enums:
        sch = {'type': 'string', 'enum': enums[t]}
    elif 'Carbon' in t or 'DateTime' in t:
        sch = {'type': 'string', 'format': 'date-time'}
    else:
        sch = {'type': 'string'}
    if nullable:
        if '$ref' in sch:
            sch = {'oneOf': [sch, {'type': 'null'}]}
        elif 'type' in sch:
            kinds = sch['type'] if isinstance(sch['type'], list) else [sch['type']]
            if 'null' not in kinds:
                kinds = [*kinds, 'null']
            sch = {**sch, 'type': kinds}
            if 'enum' in sch and None not in sch['enum']:
                sch['enum'] = [*sch['enum'], None]
    return sch


def sdk_schema(cls):
    props = {}
    for name, t in sdkres.get(cls, []):
        if name == 'requestId':
            continue
        nullable = t.startswith('?')
        t = t.lstrip('?')
        if t in SCALARS:
            sch = {'type': SCALARS[t]}
        elif t == 'array':
            sch = {'type': 'array', 'items': {}}
        elif t in sdkres:
            sch = sdk_schema(t)
        else:
            sch = {'type': 'object'}
        if nullable and 'type' in sch:
            sch['type'] = [sch['type'], 'null']
        props[snake(name)] = sch
    return {'type': 'object', 'properties': props}


# ---------------------------------------------------------------- SDK request matching and code samples
def norm_sdk_endpoint(ep):
    if not ep:
        return None
    e = ep
    e = re.sub(r'\{\$this->\w+\}', '{}', e)
    e = re.sub(r"'\s*\.\s*rawurlencode\((?:[^()]|\([^()]*\))*\)\s*\.?\s*'?", '{}', e)
    e = re.sub(r"\.\s*rawurlencode\((?:[^()]|\([^()]*\))*\)", '{}', e)
    e = re.sub(r"'\s*\.\s*\$this->\w+", '{}', e)
    e = re.sub(r"\.\s*\$this->\w+", '{}', e)
    e = e.replace('"', '').replace("'", '').replace(' ', '').replace('.', '')
    return re.sub(r'\{\}+', '{}', e)


sdk_by_key = {}
for r in sdk:
    n = norm_sdk_endpoint(r['endpoint'])
    if n and r['method']:
        sdk_by_key[(r['method'], n)] = r


def route_key(route):
    return (route['method'], '/' + re.sub(r'\{[^}]+\}', '{}', route['uri']))


