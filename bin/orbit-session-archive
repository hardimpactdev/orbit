#!/usr/bin/env php
<?php

declare(strict_types=1);

require_once __DIR__.'/orbit-session-archive-filesystem.php';
require_once __DIR__.'/orbit-loop-contract.php';
require_once __DIR__.'/orbit-feedback-events.php';

/**
 * Archive a completed active .orbit session and preserve related provider
 * session files under the same persisted session directory.
 */

const ARCHIVE_BASENAME_PATTERN = '^[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{6}-[a-z0-9-]+$';

const STAGED_CAPTURE_STATUSES = [
    'ok',
    'partial',
    'ambiguous',
    'capture_failed',
    'extraction_failed',
    'invalid',
    'missing',
    'worker_not_found',
    'stale',
    'unsupported',
];

$options = getopt('', [
    'source-orbit-dir:',
    'archive-dir:',
    'archive-root:',
    'slug:',
    'timestamp:',
    'cwd:',
    'home:',
    'marker:',
    'processes-json:',
    'worker-id:',
    'max-start-distance:',
    'only-ok',
    'full',
    'help',
]);

if (array_key_exists('help', $options)) {
    fwrite(STDOUT, <<<'EOF'
        Usage:
          bin/orbit-session-archive [--archive-dir=<path> | --slug=<slug>] [--full] [agent session options]

        Options:
          --source-orbit-dir=<path>     Active .orbit directory to archive. Defaults to <cwd>/.orbit.
          --archive-dir=<path>          Exact destination session archive directory. Its basename must
                                        match ^[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{6}-[a-z0-9-]+$.
          --archive-root=<path>         Root directory for generated archives. Defaults to the primary checkout's .orbit/sessions.
          --slug=<slug>                 Short feature slug when --archive-dir is omitted. Defaults to the
                                        current branch name sanitized to kebab-case.
          --timestamp=<value>           Timestamp prefix when --archive-dir is omitted. Defaults to current local time as YYYY-MM-DD-HHMMSS.
          --cwd=<path>                  Feature checkout cwd. Defaults to the current directory.
          --full                       Preserve the complete active .orbit state and provider captures.
                                       The default archive is compact: loop.md, feedback.jsonl when present,
                                       evidence/quality-gate/release-evidence files cited as exact
                                       inline-code paths, structured worker handoffs and failed-gate
                                       summaries when present, and a versioned archive receipt.

        In --full mode, provider session options are forwarded to bin/orbit-agent-session-archive:
          --processes-json, --worker-id, --home, --marker, --max-start-distance, --only-ok.

        The active <source-orbit-dir>/loop.md is required. When an existing compact
        schema-v2/v3 archive already has matching content identity (byte-identical
        loop.md and/or matching receipt entry_digests for loop.md), that archive is
        refreshed in place instead of minting a near-duplicate directory — including
        when the caller's slug differs from the archive basename. The existing valid
        archive path is never renamed or removed until the replacement payload has
        fully validated and swapped. Cleanup discoverability for branch-derived
        slugs is preserved via receipt branch/compatible_slugs metadata, not by
        pre-success rename. Compact loop.md files stay byte-stable; the versioned
        receipt records the archive. Newly written compact receipts use schema_version
        3 (release-evidence roots included). Historical schema-v2 receipts remain
        valid with evidence/quality-gates proof roots only. Historical loop packets
        retain their Evidence Links write-back behavior.

        In --full mode, if no explicit --processes-json/--worker-id is supplied, this
        command reads <cwd>/.orbit/workers/*.json ids and passes them as --worker-id.
        Without a registry, agent session archiving safely writes an empty manifest
        and a WARNING is printed naming the missing context. Discovered worker ids
        that cannot be resolved do not abort the archive: each one is reported with
        a WARNING and recorded in the agent-sessions manifest with status
        worker_not_found, and the archive completes normally.
        EOF);

    exit(0);
}

$cwdInput = (string) ($options['cwd'] ?? getcwd());
$cwd = realpath($cwdInput) ?: $cwdInput;
$sourceOrbitDirInput = isset($options['source-orbit-dir'])
    ? rtrim((string) $options['source-orbit-dir'], '/')
    : "{$cwd}/.orbit";
$sourceOrbitLinkCandidate = normalizedAbsolutePath($sourceOrbitDirInput, $cwd);

if (is_link($sourceOrbitLinkCandidate)) {
    fwrite(STDERR, "Source .orbit directory must not be a symlink: {$sourceOrbitDirInput}\n");
    exit(2);
}

$sourceOrbitDir = realpath($sourceOrbitDirInput) ?: $sourceOrbitDirInput;

if (! is_dir($sourceOrbitDir)) {
    fwrite(STDERR, "Source .orbit directory does not exist: {$sourceOrbitDir}\n");
    exit(2);
}

$activeLoopPath = "{$sourceOrbitDir}/loop.md";

if (! is_file($activeLoopPath) || is_link($activeLoopPath)) {
    fwrite(STDERR, "Active loop.md is missing, refusing to archive: {$activeLoopPath}\n");
    exit(2);
}

$activeFeedbackPath = "{$sourceOrbitDir}/feedback.jsonl";

try {
    if (file_exists($activeFeedbackPath) || is_link($activeFeedbackPath)) {
        $activeFeedback = orbitFeedbackRead($activeFeedbackPath);
        orbitFeedbackRequireActionableClosure($activeFeedback);
    }
} catch (Throwable $exception) {
    fwrite(STDERR, "Active feedback stream is invalid: {$exception->getMessage()}\n");
    exit(2);
}

[$secretScanExit, , $secretScanError] = runCommand([
    __DIR__.'/orbit-secret-scan',
    "--worktree={$cwd}",
    "--orbit-dir={$sourceOrbitDir}",
]);

if ($secretScanExit !== 0) {
    fwrite(STDERR, rtrim($secretScanError, "\n").PHP_EOL);
    exit(2);
}

try {
    [$archiveDir, $archiveRoot, $mode] = resolveArchiveDirectory($options, $cwd, $sourceOrbitDir, $activeLoopPath);
} catch (Throwable $exception) {
    fwrite(STDERR, $exception->getMessage().PHP_EOL);
    exit(2);
}

if (is_link($archiveDir)) {
    fwrite(STDERR, "Archive directory must not be a symlink: {$archiveDir}\n");
    exit(2);
}

if ($mode === 'refreshed') {
    fwrite(
        STDERR,
        "Refreshing existing session archive with identical loop.md instead of minting a duplicate: {$archiveDir}\n",
    );
} elseif (directoryHasEntries($archiveDir)) {
    fwrite(STDERR, "Archive directory already exists and is not empty: {$archiveDir}\n");
    exit(2);
}

try {
    $expectedArchiveIdentity = orbitSessionArchivePathIdentity($archiveDir);
} catch (Throwable $exception) {
    fwrite(STDERR, $exception->getMessage().PHP_EOL);
    exit(2);
}

$archiveMode = requestedArchiveMode($options, $mode, $archiveDir);

if ($archiveMode === 'compact') {
    try {
        assertCompactArchiveIdentity($cwd, $sourceOrbitDir, (string) file_get_contents($activeLoopPath));
    } catch (Throwable $exception) {
        fwrite(STDERR, $exception->getMessage().PHP_EOL);
        exit(2);
    }
}

$workerDiscoveryAttempted = $archiveMode === 'full' && shouldDiscoverWorkerIds($options);
$discoveredWorkerIds = $workerDiscoveryAttempted ? discoverWorkerRegistryIds($cwd, $sourceOrbitDir) : [];

$temporaryArchiveFinalPath = isset($options['archive-dir'])
    ? $archiveDir
    : "{$archiveRoot}/".basename($archiveDir);
$temporaryArchiveDir = uniqueSiblingPath($temporaryArchiveFinalPath, 'tmp');
$backupDir = uniqueSiblingPath($archiveDir, 'backup');
$activeLoop = (string) file_get_contents($activeLoopPath);
$updatedLoop = orbitLoopIsCompact($activeLoop)
    ? $activeLoop
    : sessionArchiveLinkedLoopContent($activeLoopPath, basename($archiveDir));

try {
    orbitSessionArchiveEnsureDirectory($temporaryArchiveDir);
    $copiedEntries = $archiveMode === 'full'
        ? copyActiveOrbitEntries($sourceOrbitDir, $temporaryArchiveDir)
        : copyCompactOrbitEntries($sourceOrbitDir, $temporaryArchiveDir);

    if ($copiedEntries === []) {
        throw new RuntimeException(
            "No .orbit entries were copied from {$sourceOrbitDir} into {$temporaryArchiveDir}.",
        );
    }

    $agentResults = [];

    if ($archiveMode === 'full') {
        $hasStagedCaptures = validateStagedCaptures("{$temporaryArchiveDir}/agent-sessions");

        if ($hasStagedCaptures) {
            fwrite(
                STDERR,
                "Preferring validated staged captures from active .orbit/agent-sessions; skipping live extraction.\n",
            );
        } else {
            if ($workerDiscoveryAttempted && $discoveredWorkerIds === []) {
                fwrite(
                    STDERR,
                    'WARNING: no worker context available - no --processes-json/--worker-id option and no '
                    .".orbit/workers registry in {$cwd}; agent-sessions will contain an empty manifest.\n",
                );
            }

            $agentResults = runAgentSessionArchive($options, $cwd, $temporaryArchiveDir, $discoveredWorkerIds);
            normalizeFallbackManifestArchiveDirectory($temporaryArchiveDir, $archiveDir);
        }
    }

    orbitSessionArchiveWriteFile("{$temporaryArchiveDir}/loop.md", $updatedLoop);

    if ($mode === 'refreshed') {
        assertRefreshPreservesArchive($archiveDir, $temporaryArchiveDir);
    }

    $copiedEntries = $archiveMode === 'compact'
        ? archiveCompactFileEntries($temporaryArchiveDir)
        : archiveTopLevelEntries($temporaryArchiveDir);
    $entryDigests = archiveEntryDigests($temporaryArchiveDir, $copiedEntries);
    $branch = archiveGitValue($cwd, ['branch', '--show-current']) ?? 'unknown';
    $candidateCommit = archiveGitValue($cwd, ['rev-parse', 'HEAD']) ?? 'unknown';
    $requestedSlug = slugify(isset($options['slug']) ? (string) $options['slug'] : defaultArchiveSlug($cwd));
    $basenameSlug = preg_match(
        '/^\d{4}-\d{2}-\d{2}-\d{6}-([a-z0-9-]+)$/',
        basename($archiveDir),
        $basenameParts,
    ) === 1
        ? $basenameParts[1]
        : $requestedSlug;
    $compatibleSlugs = archiveCompatibleSlugs($options, $cwd, $archiveDir, $mode);

    $summary = [
        'schema_version' => $archiveMode === 'compact' ? 3 : 2,
        'generated_at' => gmdate('c'),
        'mode' => $mode,
        'archive_mode' => $archiveMode,
        'source_orbit_dir' => $sourceOrbitDir,
        'archive_dir' => $archiveDir,
        'agent_sessions_dir' => $archiveMode === 'full' ? "{$archiveDir}/agent-sessions" : null,
        'copied_entries' => $copiedEntries,
        'entry_digests' => $entryDigests,
        'slug' => $basenameSlug,
        'requested_slug' => $requestedSlug,
        'compatible_slugs' => $compatibleSlugs,
        'branch' => $branch,
        'candidate_commit' => $candidateCommit,
        'accepted_feature_tip' => orbitLoopLabel($updatedLoop, 'Proof', 'Accepted feature tip'),
        'accepted_main_tip' => orbitLoopLabel($updatedLoop, 'Proof', 'Accepted main tip'),
        'discovered_worker_ids' => $discoveredWorkerIds,
        'agent_results' => $agentResults,
    ];

    writeJsonFile("{$temporaryArchiveDir}/orbit-session-archive.json", $summary);

    [$secretScanExit, , $secretScanError] = runCommand([
        __DIR__.'/orbit-secret-scan',
        "--tree={$temporaryArchiveDir}",
    ]);

    if ($secretScanExit !== 0) {
        throw new RuntimeException(trim($secretScanError));
    }
} catch (Throwable $exception) {
    cleanupConstructionFailure($temporaryArchiveDir, $exception);
    exit(2);
}

try {
    swapArchiveDirectories(
        $temporaryArchiveDir,
        $archiveDir,
        $backupDir,
        expectedArchiveIdentity: $expectedArchiveIdentity,
    );
} catch (Throwable $exception) {
    fwrite(STDERR, $exception->getMessage().PHP_EOL);
    exit(2);
}

try {
    orbitSessionArchiveWriteFileAtomically($activeLoopPath, $updatedLoop);
} catch (Throwable $exception) {
    reportActiveLoopWriteFailure($exception, $archiveDir, $backupDir);
    exit(2);
}

try {
    refreshSessionIndex($archiveRoot);
} catch (Throwable $exception) {
    reportIndexRefreshFailure($exception, $archiveDir, $backupDir, $archiveRoot);
    exit(2);
}

try {
    if (file_exists($backupDir) || is_link($backupDir)) {
        orbitSessionArchiveRemovePath($backupDir);
    }
} catch (Throwable $exception) {
    reportBackupCleanupFailure($exception, $archiveDir, $backupDir);
    exit(2);
}

echo json_encode($summary, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR).PHP_EOL;

/** @return list<string> */
function archiveTopLevelEntries(string $archiveDir): array
{
    $entries = [];

    foreach (new DirectoryIterator($archiveDir) as $entry) {
        if ($entry->isDot() || $entry->getFilename() === 'orbit-session-archive.json') {
            continue;
        }

        if ($entry->isLink() || ! $entry->isFile() && ! $entry->isDir()) {
            throw new RuntimeException("Unsafe constructed archive entry: {$entry->getPathname()}");
        }

        $entries[] = $entry->getFilename();
    }

    sort($entries, SORT_STRING);

    return $entries;
}

/** @return list<string> */
function archiveCompactFileEntries(string $archiveDir): array
{
    $entries = [];
    $iterator = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator($archiveDir, RecursiveDirectoryIterator::SKIP_DOTS),
        RecursiveIteratorIterator::LEAVES_ONLY,
    );

    foreach ($iterator as $entry) {
        if ($entry->isLink() || ! $entry->isFile()) {
            throw new RuntimeException("Unsafe constructed compact archive entry: {$entry->getPathname()}");
        }

        $entries[] = ltrim(substr($entry->getPathname(), strlen($archiveDir)), '/');
    }

    sort($entries, SORT_STRING);

    return $entries;
}

/**
 * @param list<string> $entries
 * @return array<string, string>
 */
function archiveEntryDigests(string $archiveDir, array $entries): array
{
    $digests = [];

    foreach ($entries as $entry) {
        $digests[$entry] = archiveEntryDigest("{$archiveDir}/{$entry}");
    }

    ksort($digests, SORT_STRING);

    return $digests;
}

function archiveEntryDigest(string $path): string
{
    $stat = @lstat($path);

    if ($stat === false) {
        throw new RuntimeException("Unable to digest missing archive entry: {$path}");
    }

    if (orbitSessionArchiveStatIsRegular($stat)) {
        $digest = hash_file('sha256', $path);

        if ($digest === false) {
            throw new RuntimeException("Unable to digest archive file: {$path}");
        }

        return $digest;
    }

    if (! orbitSessionArchiveStatIsDirectory($stat)) {
        throw new RuntimeException("Unable to digest non-regular archive entry: {$path}");
    }

    $lines = [];
    $iterator = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator($path, RecursiveDirectoryIterator::SKIP_DOTS),
        RecursiveIteratorIterator::LEAVES_ONLY,
    );

    foreach ($iterator as $entry) {
        if ($entry->isLink() || ! $entry->isFile()) {
            throw new RuntimeException("Unable to digest unsafe archive entry: {$entry->getPathname()}");
        }

        $relative = ltrim(substr($entry->getPathname(), strlen($path)), '/');
        $digest = hash_file('sha256', $entry->getPathname());

        if ($digest === false) {
            throw new RuntimeException("Unable to digest archive file: {$entry->getPathname()}");
        }

        $lines[] = $relative."\0".$digest;
    }

    sort($lines, SORT_STRING);

    return hash('sha256', implode("\n", $lines));
}

function archiveGitValue(string $cwd, array $arguments): ?string
{
    [$exitCode, $stdout] = runCommand(['git', '-C', $cwd, ...$arguments]);
    $value = trim($stdout);

    return $exitCode === 0 && $value !== '' ? $value : null;
}

function assertCompactArchiveIdentity(string $cwd, string $sourceOrbitDir, string $loop): void
{
    $gitRoot = archiveGitValue($cwd, ['rev-parse', '--show-toplevel']);
    $canonicalCwd = realpath($cwd) ?: $cwd;

    if ($gitRoot === null || (realpath($gitRoot) ?: $gitRoot) !== $canonicalCwd) {
        throw new RuntimeException('Compact archive must run from the exact feature worktree root.');
    }

    $expectedOrbitDir = realpath($canonicalCwd.'/.orbit') ?: $canonicalCwd.'/.orbit';
    $canonicalSource = realpath($sourceOrbitDir) ?: $sourceOrbitDir;

    if ($canonicalSource !== $expectedOrbitDir) {
        throw new RuntimeException('Compact archive source must be the accepted feature worktree .orbit directory.');
    }

    if (! orbitLoopIsCompact($loop)) {
        throw new RuntimeException(
            'Compact archive requires an accepted compact feature loop; use --full for historical state.',
        );
    }

    $branch = archiveGitValue($cwd, ['branch', '--show-current']);

    if ($branch === null || in_array($branch, ['main', 'master'], true)) {
        throw new RuntimeException('Compact archive must run from the still-open accepted feature branch, not main.');
    }

    if (orbitLoopTopLabel($loop, 'Branch') !== $branch) {
        throw new RuntimeException('Compact archive loop branch does not equal current branch.');
    }

    $loopWorktree = orbitLoopTopLabel($loop, 'Worktree');

    if ($loopWorktree === null || (realpath($loopWorktree) ?: $loopWorktree) !== $canonicalCwd) {
        throw new RuntimeException('Compact archive loop worktree does not equal the current feature worktree.');
    }

    $candidate = archiveGitValue($cwd, ['rev-parse', 'HEAD']);

    if ($candidate === null) {
        throw new RuntimeException('Compact archive cannot resolve candidate HEAD.');
    }

    $reviewProblem = orbitLoopReviewedIdentityProblem($loop, $candidate);

    if ($reviewProblem !== null) {
        throw new RuntimeException('Compact archive '.$reviewProblem.'.');
    }

    if (orbitLoopLabel($loop, 'Proof', 'Accepted feature tip') !== $candidate) {
        throw new RuntimeException('Compact archive accepted feature tip does not equal candidate HEAD.');
    }

    if (orbitLoopStatusHead(orbitLoopLabel($loop, 'Proof', 'Acceptance')) !== 'accepted') {
        throw new RuntimeException('Compact archive requires accepted feature state.');
    }

    $acceptedMain = orbitLoopLabel($loop, 'Proof', 'Accepted main tip');

    if ($acceptedMain === null || preg_match('/^[0-9a-f]{40}$/', $acceptedMain) !== 1) {
        throw new RuntimeException('Compact archive requires an exact accepted main tip.');
    }

    if (archiveGitExitCode($cwd, ['merge-base', '--is-ancestor', $acceptedMain, $candidate]) !== 0) {
        throw new RuntimeException('Compact archive accepted main tip is not an ancestor of candidate HEAD.');
    }

    $blastRadiusProblem = orbitLoopBlastRadiusProblem(
        $loop,
        orbitLoopChangedFiles($cwd, $candidate, $acceptedMain),
    );

    if ($blastRadiusProblem !== null) {
        throw new RuntimeException('Compact archive '.$blastRadiusProblem.'.');
    }

    if (archiveGitExitCode($cwd, ['merge-base', '--is-ancestor', $candidate, 'main']) !== 0) {
        throw new RuntimeException('Compact archive candidate is not landed on main.');
    }

    [$statusExit, $status] = runCommand(['git', '-C', $cwd, 'status', '--porcelain', '--untracked-files=all']);

    if ($statusExit !== 0 || trim($status) !== '') {
        throw new RuntimeException('Compact archive feature worktree must be clean.');
    }
}

/** @param list<string> $arguments */
function archiveGitExitCode(string $cwd, array $arguments): int
{
    [$exitCode] = runCommand(['git', '-C', $cwd, ...$arguments]);

    return $exitCode;
}

function assertRefreshPreservesArchive(string $archiveDir, string $temporaryArchiveDir): void
{
    $iterator = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator($archiveDir, RecursiveDirectoryIterator::SKIP_DOTS),
        RecursiveIteratorIterator::SELF_FIRST,
    );

    foreach ($iterator as $entry) {
        $relative = ltrim(substr($entry->getPathname(), strlen($archiveDir)), '/');

        if ($relative === 'orbit-session-archive.json') {
            continue;
        }

        $replacement = "{$temporaryArchiveDir}/{$relative}";

        if ($entry->isLink()) {
            throw new RuntimeException("Refusing refresh of archive containing a symlink: {$relative}");
        }

        if ($entry->isDir()) {
            if (! file_exists($replacement) && ! is_link($replacement)) {
                if ($relative === 'agent-sessions' || str_starts_with($relative, 'agent-sessions/')) {
                    throw new RuntimeException("Refresh would remove archived entry: {$relative}");
                }

                copyDirectory($entry->getPathname(), $replacement);

                continue;
            }

            if (! is_dir($replacement) || is_link($replacement)) {
                throw new RuntimeException("Refresh would replace archived directory: {$relative}");
            }

            continue;
        }

        if (! $entry->isFile()) {
            throw new RuntimeException("Refresh contains unsafe archived entry: {$relative}");
        }

        if (! file_exists($replacement) && ! is_link($replacement)) {
            if ($relative === 'feedback.jsonl' || str_starts_with($relative, 'agent-sessions/')) {
                throw new RuntimeException("Refresh would remove archived entry: {$relative}");
            }

            orbitSessionArchiveCopyFile($entry->getPathname(), $replacement);

            continue;
        }

        if (! is_file($replacement) || is_link($replacement)) {
            throw new RuntimeException("Refresh would replace archived file: {$relative}");
        }

        $old = (string) file_get_contents($entry->getPathname());
        $new = (string) file_get_contents($replacement);
        $isAppendOnly =
            $relative === 'feedback.jsonl'
            || str_contains('/'.$relative, '/agent-sessions/') && str_ends_with($relative, '.jsonl');

        if ($isAppendOnly && ! str_starts_with($new, $old)) {
            throw new RuntimeException("Refresh would reduce append-only archived entry: {$relative}");
        }

        if (
            $relative !== 'loop.md'
            && ! $isAppendOnly
            && basename($relative) !== 'manifest.json'
            && ! hash_equals($old, $new)
        ) {
            throw new RuntimeException("Refresh would replace immutable archived entry: {$relative}");
        }
    }
}

/**
 * @param array<string, mixed> $options
 *
 * @return array{0: string, 1: string, 2: string}
 */
function resolveArchiveDirectory(array $options, string $cwd, string $sourceOrbitDir, string $activeLoopPath): array
{
    if (isset($options['archive-dir'])) {
        $requestedArchiveDir = rtrim((string) $options['archive-dir'], '/');
        $archiveDir = normalizedAbsolutePath($requestedArchiveDir, $cwd);
        $basename = basename($archiveDir);

        if (preg_match('/'.ARCHIVE_BASENAME_PATTERN.'/', $basename) !== 1) {
            throw new RuntimeException(
                'Archive directory basename must match '
                .ARCHIVE_BASENAME_PATTERN
                ." (YYYY-MM-DD-HHMMSS-<feature-slug> in local time): {$basename}",
            );
        }

        if (is_link($archiveDir)) {
            throw new RuntimeException("Archive directory must not be a symlink: {$archiveDir}");
        }

        if (file_exists($archiveDir) && ! is_dir($archiveDir)) {
            throw new RuntimeException("Archive directory must be a directory: {$archiveDir}");
        }

        $archiveRoot = isset($options['archive-root'])
            ? canonicalArchiveRoot((string) $options['archive-root'], $cwd)
            : canonicalArchiveRoot(dirname($archiveDir), $cwd);
        $canonicalArchiveParent = realpath(dirname($archiveDir));

        if ($canonicalArchiveParent === false || rtrim($canonicalArchiveParent, '/') !== $archiveRoot) {
            throw new RuntimeException(
                "Explicit archive directory must be a direct child of the archive root: {$archiveDir}; "
                ."archive root={$archiveRoot}",
            );
        }

        $mode = directoryHasEntries($archiveDir) && archiveLoopMatchesActive($archiveDir, $activeLoopPath)
            ? 'refreshed'
            : 'created';

        return [$archiveDir, $archiveRoot, $mode];
    }

    $archiveRootInput = isset($options['archive-root'])
        ? (string) $options['archive-root']
        : defaultArchiveRoot($cwd, $sourceOrbitDir);
    $visibleArchiveRoot = normalizedAbsolutePath(rtrim($archiveRootInput, '/'), $cwd);
    $archiveRoot = canonicalArchiveRoot($archiveRootInput, $cwd);
    $slug = slugify(isset($options['slug']) ? (string) $options['slug'] : defaultArchiveSlug($cwd));
    $existingArchiveDir = newestArchiveForSlug($archiveRoot, $slug);

    // Same-slug refresh: any archive with matching content (including full/legacy
    // by loop.md) may refresh under its existing path.
    if ($existingArchiveDir !== null && archiveContentMatchesActive($existingArchiveDir, $activeLoopPath)) {
        return ["{$visibleArchiveRoot}/".basename($existingArchiveDir), $archiveRoot, 'refreshed'];
    }

    // Cross-slug reuse: only versioned compact archives, refreshed in place.
    // Never rename here — a failed later validation must leave the original intact.
    $contentMatchDir = newestCompactArchiveMatchingContent($archiveRoot, $activeLoopPath);

    if ($contentMatchDir !== null) {
        return ["{$visibleArchiveRoot}/".basename($contentMatchDir), $archiveRoot, 'refreshed'];
    }

    $timestamp = archiveTimestamp($options);

    return ["{$visibleArchiveRoot}/{$timestamp}-{$slug}", $archiveRoot, 'created'];
}

function canonicalArchiveRoot(string $path, string $cwd): string
{
    $archiveRoot = normalizedAbsolutePath(rtrim($path, '/'), $cwd);

    if (is_link($archiveRoot)) {
        throw new RuntimeException("Archive root must not be a symlink: {$archiveRoot}");
    }

    if (file_exists($archiveRoot) && ! is_dir($archiveRoot)) {
        throw new RuntimeException("Archive root must be a directory: {$archiveRoot}");
    }

    orbitSessionArchiveEnsureDirectory($archiveRoot);
    $canonicalArchiveRoot = realpath($archiveRoot);

    if ($canonicalArchiveRoot === false) {
        throw new RuntimeException("Unable to resolve archive root: {$archiveRoot}");
    }

    return rtrim($canonicalArchiveRoot, '/');
}

function normalizedAbsolutePath(string $path, string $cwd): string
{
    $absolutePath = str_starts_with($path, '/') ? $path : rtrim($cwd, '/').'/'.$path;
    $parts = [];

    foreach (explode('/', $absolutePath) as $part) {
        if ($part === '' || $part === '.') {
            continue;
        }

        if ($part === '..') {
            array_pop($parts);

            continue;
        }

        $parts[] = $part;
    }

    return '/'.implode('/', $parts);
}

/**
 * @param array<string, mixed> $options
 */
function archiveTimestamp(array $options): string
{
    $timestamp = isset($options['timestamp']) ? (string) $options['timestamp'] : localArchiveTimestamp();

    if (preg_match('/^\d{4}-\d{2}-\d{2}-\d{6}$/', $timestamp) === 1) {
        return $timestamp;
    }

    throw new RuntimeException("Archive timestamp must use YYYY-MM-DD-HHMMSS in local time: {$timestamp}");
}

/**
 * PHP CLI often runs with date.timezone=UTC, which silently produces
 * UTC-derived basenames. Prefer the system clock, which uses the checkout's
 * local timezone, and fall back to PHP time only when the system call fails.
 */
function localArchiveTimestamp(): string
{
    $systemLocalTimestamp = trim((string) shell_exec("date '+%Y-%m-%d-%H%M%S' 2>/dev/null"));

    if (preg_match('/^\d{4}-\d{2}-\d{2}-\d{6}$/', $systemLocalTimestamp) === 1) {
        return $systemLocalTimestamp;
    }

    return date('Y-m-d-His');
}

function newestArchiveForSlug(string $archiveRoot, string $slug): ?string
{
    if (! is_dir($archiveRoot)) {
        return null;
    }

    $matches = [];

    foreach (new FilesystemIterator($archiveRoot, FilesystemIterator::SKIP_DOTS) as $entry) {
        if ($entry->isLink() || ! $entry->isDir()) {
            continue;
        }

        $name = $entry->getFilename();

        if (preg_match('/^\d{4}-\d{2}-\d{2}-\d{6}-([a-z0-9-]+)$/', $name, $found) !== 1 || $found[1] !== $slug) {
            continue;
        }

        $matches[] = $name;
    }

    if ($matches === []) {
        return null;
    }

    rsort($matches, SORT_STRING);

    return "{$archiveRoot}/{$matches[0]}";
}

/**
 * Newest versioned compact archive under any slug whose content identity matches
 * the active loop. Compatible slug variants reuse one archive in place; full and
 * legacy archives are never selected for cross-slug reuse.
 */
function newestCompactArchiveMatchingContent(string $archiveRoot, string $activeLoopPath): ?string
{
    if (! is_dir($archiveRoot)) {
        return null;
    }

    $matches = [];

    foreach (new FilesystemIterator($archiveRoot, FilesystemIterator::SKIP_DOTS) as $entry) {
        if ($entry->isLink() || ! $entry->isDir()) {
            continue;
        }

        $name = $entry->getFilename();

        if (preg_match('/^\d{4}-\d{2}-\d{2}-\d{6}-[a-z0-9-]+$/', $name) !== 1) {
            continue;
        }

        $path = $entry->getPathname();

        if (! isVersionedCompactArchive($path)) {
            continue;
        }

        if (! archiveContentMatchesActive($path, $activeLoopPath)) {
            continue;
        }

        $matches[] = $name;
    }

    if ($matches === []) {
        return null;
    }

    rsort($matches, SORT_STRING);

    return "{$archiveRoot}/{$matches[0]}";
}

function archiveLoopMatchesActive(string $archiveDir, string $activeLoopPath): bool
{
    $archivedLoopPath = "{$archiveDir}/loop.md";

    if (! is_file($archivedLoopPath) || is_link($archivedLoopPath)) {
        return false;
    }

    return file_get_contents($archivedLoopPath) === file_get_contents($activeLoopPath);
}

/**
 * @return array<string, mixed>|null
 */
function readArchiveReceipt(string $archiveDir): ?array
{
    $receiptPath = "{$archiveDir}/orbit-session-archive.json";

    if (! is_file($receiptPath) || is_link($receiptPath)) {
        return null;
    }

    try {
        /** @var mixed $receipt */
        $receipt = json_decode((string) file_get_contents($receiptPath), true, flags: JSON_THROW_ON_ERROR);
    } catch (JsonException) {
        return null;
    }

    return is_array($receipt) ? $receipt : null;
}

function isVersionedCompactArchive(string $archiveDir): bool
{
    $receipt = readArchiveReceipt($archiveDir);

    if ($receipt === null) {
        return false;
    }

    $schemaVersion = $receipt['schema_version'] ?? null;

    return in_array($schemaVersion, [2, 3], true) && ($receipt['archive_mode'] ?? null) === 'compact';
}

/**
 * Content identity: byte-identical loop.md, or compact receipt entry_digests
 * whose loop.md digest matches the active loop file.
 */
function archiveContentMatchesActive(string $archiveDir, string $activeLoopPath): bool
{
    if (archiveLoopMatchesActive($archiveDir, $activeLoopPath)) {
        return true;
    }

    if (! is_file($activeLoopPath) || is_link($activeLoopPath)) {
        return false;
    }

    $activeLoopDigest = hash_file('sha256', $activeLoopPath);

    if ($activeLoopDigest === false) {
        return false;
    }

    $receipt = readArchiveReceipt($archiveDir);

    if ($receipt === null) {
        return false;
    }

    $digests = $receipt['entry_digests'] ?? null;

    if (! is_array($digests)) {
        return false;
    }

    $loopDigest = $digests['loop.md'] ?? null;

    return is_string($loopDigest) && hash_equals($loopDigest, $activeLoopDigest);
}

/**
 * @param  array<string, mixed>  $options
 * @return list<string>
 */
function archiveCompatibleSlugs(
    array $options,
    string $cwd,
    string $archiveDir,
    string $mode,
): array {
    $requestedSlug = slugify(isset($options['slug']) ? (string) $options['slug'] : defaultArchiveSlug($cwd));
    $basename = basename($archiveDir);
    $basenameSlug = preg_match('/^\d{4}-\d{2}-\d{2}-\d{6}-([a-z0-9-]+)$/', $basename, $parts) === 1
        ? $parts[1]
        : $requestedSlug;
    $slugs = [$basenameSlug, $requestedSlug];

    if ($mode === 'refreshed') {
        $previous = readArchiveReceipt($archiveDir);
        $previousSlugs = is_array($previous) ? $previous['compatible_slugs'] ?? null : null;

        if (is_array($previousSlugs)) {
            foreach ($previousSlugs as $previousSlug) {
                if (is_string($previousSlug) && $previousSlug !== '') {
                    $slugs[] = slugify($previousSlug);
                }
            }
        }

        $previousSlug = is_array($previous) ? $previous['slug'] ?? null : null;

        if (is_string($previousSlug) && $previousSlug !== '') {
            $slugs[] = slugify($previousSlug);
        }

        $previousRequested = is_array($previous) ? $previous['requested_slug'] ?? null : null;

        if (is_string($previousRequested) && $previousRequested !== '') {
            $slugs[] = slugify($previousRequested);
        }
    }

    $unique = [];

    foreach ($slugs as $slug) {
        if ($slug !== '' && ! in_array($slug, $unique, true)) {
            $unique[] = $slug;
        }
    }

    sort($unique, SORT_STRING);

    return $unique;
}

function sessionArchiveLinkedLoopContent(string $loopPath, string $archiveBasename): string
{
    $bullet = "- Session archive: .orbit/sessions/{$archiveBasename}";
    $content = file_get_contents($loopPath);

    if ($content === false) {
        throw new RuntimeException("Unable to read active loop.md: {$loopPath}");
    }

    return upsertEvidenceLinkBullet($content, $bullet);
}

function upsertEvidenceLinkBullet(string $content, string $bullet): string
{
    $lines = explode("\n", $content);
    $sectionStart = null;

    foreach ($lines as $index => $line) {
        if (preg_match('/^##\s+Evidence Links\s*$/', $line) === 1) {
            $sectionStart = $index;

            break;
        }
    }

    if ($sectionStart === null) {
        return rtrim($content, "\n")."\n\n## Evidence Links\n\n{$bullet}\n";
    }

    $lineCount = count($lines);
    $sectionEnd = $lineCount;

    for ($index = $sectionStart + 1; $index < $lineCount; $index++) {
        if (str_starts_with($lines[$index], '## ')) {
            $sectionEnd = $index;

            break;
        }
    }

    for ($index = $sectionStart + 1; $index < $sectionEnd; $index++) {
        if (str_starts_with($lines[$index], '- Session archive:')) {
            $lines[$index] = $bullet;

            return implode("\n", $lines);
        }
    }

    $insertAt = $sectionEnd;

    while ($insertAt > ($sectionStart + 1) && trim($lines[$insertAt - 1]) === '') {
        $insertAt--;
    }

    array_splice($lines, $insertAt, 0, [$bullet]);

    return implode("\n", $lines);
}

function defaultArchiveRoot(string $cwd, string $sourceOrbitDir): string
{
    $worktreeMarker = '/.worktrees/';
    $worktreeOffset = strpos($cwd, $worktreeMarker);

    if ($worktreeOffset !== false) {
        $primaryCheckout = substr($cwd, 0, $worktreeOffset);

        if ($primaryCheckout !== '' && is_dir($primaryCheckout)) {
            return "{$primaryCheckout}/.orbit/sessions";
        }
    }

    return "{$sourceOrbitDir}/sessions";
}

function defaultArchiveSlug(string $cwd): string
{
    $branch = trim((string) shell_exec('git -C '.escapeshellarg($cwd).' branch --show-current 2>/dev/null'));

    return $branch !== '' ? $branch : basename($cwd);
}

function directoryHasEntries(string $directory): bool
{
    if (! is_dir($directory)) {
        return false;
    }

    $iterator = new FilesystemIterator($directory, FilesystemIterator::SKIP_DOTS);

    return $iterator->valid();
}

function uniqueSiblingPath(string $archiveDir, string $kind): string
{
    do {
        $path = dirname($archiveDir).'/.'.basename($archiveDir).".{$kind}-".bin2hex(random_bytes(8));
    } while (file_exists($path) || is_link($path));

    return $path;
}

/**
 * @param array<string, mixed> $options
 */
function requestedArchiveMode(array $options, string $lifecycleMode, string $archiveDir): string
{
    if (array_key_exists('full', $options)) {
        return 'full';
    }

    if ($lifecycleMode !== 'refreshed') {
        return 'compact';
    }

    $receiptPath = "{$archiveDir}/orbit-session-archive.json";

    if (is_file($receiptPath) && ! is_link($receiptPath)) {
        $receipt = json_decode((string) file_get_contents($receiptPath), true);

        if (is_array($receipt) && ($receipt['archive_mode'] ?? null) === 'full') {
            return 'full';
        }
    }

    return is_dir("{$archiveDir}/agent-sessions") ? 'full' : 'compact';
}

/**
 * @return list<string>
 */
function copyCompactOrbitEntries(string $sourceOrbitDir, string $archiveDir): array
{
    orbitSessionArchiveEnsureDirectory($archiveDir);
    $sourceIdentity = archiveDirectoryIdentity($sourceOrbitDir);
    $copiedEntries = [];

    foreach (['loop.md', 'feedback.jsonl'] as $name) {
        assertArchiveDirectoryIdentity($sourceOrbitDir, $sourceIdentity);
        $source = "{$sourceOrbitDir}/{$name}";

        if (is_link($source)) {
            warnSkippedSourceSymlink($source);

            continue;
        }

        if (! is_file($source)) {
            continue;
        }

        orbitSessionArchiveCopyFile($source, "{$archiveDir}/{$name}");
        $copiedEntries[] = $name;
    }

    $archivedLoopPath = "{$archiveDir}/loop.md";
    $archivedLoop = is_file($archivedLoopPath) ? (string) file_get_contents($archivedLoopPath) : '';

    foreach (orbitLoopProofReferences($archivedLoop) as $reference) {
        assertArchiveDirectoryIdentity($sourceOrbitDir, $sourceIdentity);
        $relative = substr($reference, strlen('.orbit/'));
        $source = compactOrbitProofSource($sourceOrbitDir, $relative, $reference);
        orbitSessionArchiveCopyFile($source, "{$archiveDir}/{$relative}");
        $copiedEntries[] = $relative;
    }

    $copiedEntries = array_values(array_unique(array_merge(
        $copiedEntries,
        copyCompactDiagnosticEntries($sourceOrbitDir, $archiveDir, $sourceIdentity),
    )));

    sort($copiedEntries, SORT_STRING);
    assertArchiveDirectoryIdentity($sourceOrbitDir, $sourceIdentity);

    return $copiedEntries;
}

/**
 * @param  array{dev: int, ino: int, mode: int}  $sourceIdentity
 * @return list<string>
 */
function copyCompactDiagnosticEntries(string $sourceOrbitDir, string $archiveDir, array $sourceIdentity): array
{
    $copiedEntries = [];
    $workersDir = "{$sourceOrbitDir}/workers";

    if (is_dir($workersDir) && ! is_link($workersDir)) {
        foreach (glob($workersDir.'/*.json') ?: [] as $source) {
            assertArchiveDirectoryIdentity($sourceOrbitDir, $sourceIdentity);

            if (is_link($source) || ! is_file($source)) {
                continue;
            }

            $relative = 'workers/'.basename($source);
            orbitSessionArchiveCopyFile($source, "{$archiveDir}/{$relative}");
            $copiedEntries[] = $relative;
        }

        $handoffDir = "{$workersDir}/handoff";

        if (is_dir($handoffDir) && ! is_link($handoffDir)) {
            foreach (glob($handoffDir.'/*') ?: [] as $source) {
                assertArchiveDirectoryIdentity($sourceOrbitDir, $sourceIdentity);

                if (is_link($source) || ! is_file($source)) {
                    continue;
                }

                $relative = 'workers/handoff/'.basename($source);
                orbitSessionArchiveCopyFile($source, "{$archiveDir}/{$relative}");
                $copiedEntries[] = $relative;
            }
        }
    }

    $qualityGatesDir = "{$sourceOrbitDir}/quality-gates";

    if (is_dir($qualityGatesDir) && ! is_link($qualityGatesDir)) {
        foreach (glob($qualityGatesDir.'/*') ?: [] as $source) {
            assertArchiveDirectoryIdentity($sourceOrbitDir, $sourceIdentity);

            if (is_link($source) || ! is_file($source)) {
                continue;
            }

            $decoded = json_decode((string) file_get_contents($source), true);
            $exitCode = is_array($decoded) ? ($decoded['exit_code'] ?? null) : null;

            if (! is_int($exitCode) && is_array($decoded) && is_array($decoded['payload'] ?? null)) {
                $exitCode = $decoded['payload']['exit_code'] ?? null;
            }

            if (! is_int($exitCode) || $exitCode === 0) {
                continue;
            }

            $relative = 'diagnostics/failed-gates/'.basename($source);
            orbitSessionArchiveCopyFile($source, "{$archiveDir}/{$relative}");
            $copiedEntries[] = $relative;
        }
    }

    return $copiedEntries;
}

function compactOrbitProofSource(string $sourceOrbitDir, string $relative, string $reference): string
{
    $segments = explode('/', $relative);

    if (
        ! in_array($segments[0] ?? '', ['evidence', 'quality-gates', 'release-evidence'], true)
        || count($segments) < 2
        || in_array('', $segments, true)
        || in_array('.', $segments, true)
        || in_array('..', $segments, true)
    ) {
        throw new RuntimeException("Compact cited proof has an unsafe path: {$reference}");
    }

    $current = rtrim($sourceOrbitDir, '/');

    foreach ($segments as $segment) {
        $current .= '/'.$segment;

        if (is_link($current)) {
            throw new RuntimeException("Compact cited proof must not traverse a symlink: {$reference}");
        }
    }

    if (! is_file($current)) {
        throw new RuntimeException("Compact cited proof must name an existing regular file: {$reference}");
    }

    $canonicalRoot = realpath($sourceOrbitDir);
    $canonicalSource = realpath($current);

    if (
        $canonicalRoot === false
        || $canonicalSource === false
        || ! str_starts_with($canonicalSource, rtrim($canonicalRoot, '/').'/')
    ) {
        throw new RuntimeException("Compact cited proof escapes the active .orbit directory: {$reference}");
    }

    return $current;
}

/**
 * @return list<string>
 */
function copyActiveOrbitEntries(string $sourceOrbitDir, string $archiveDir): array
{
    orbitSessionArchiveEnsureDirectory($archiveDir);
    $sourceIdentity = archiveDirectoryIdentity($sourceOrbitDir);
    $copiedEntries = [];
    $iterator = new DirectoryIterator($sourceOrbitDir);

    foreach ($iterator as $entry) {
        assertArchiveDirectoryIdentity($sourceOrbitDir, $sourceIdentity);

        if ($entry->isDot()) {
            continue;
        }

        $name = $entry->getFilename();

        if ($name === 'sessions' || $name === 'release-candidates') {
            continue;
        }

        $source = $entry->getPathname();
        $target = "{$archiveDir}/{$name}";

        if ($entry->isLink()) {
            warnSkippedSourceSymlink($source);

            continue;
        }

        if ($entry->isDir()) {
            copyDirectory($source, $target, $name === 'agent-sessions' ? 0 : null);
        } elseif ($entry->isFile()) {
            orbitSessionArchiveCopyFile($source, $target);
        } else {
            continue;
        }

        $copiedEntries[] = $name;
    }

    sort($copiedEntries, SORT_STRING);
    assertArchiveDirectoryIdentity($sourceOrbitDir, $sourceIdentity);

    return $copiedEntries;
}

function copyDirectory(string $source, string $target, ?int $agentSessionsDepth = null): void
{
    $sourceIdentity = archiveDirectoryIdentity($source);
    orbitSessionArchiveEnsureDirectory($target);
    $iterator = new DirectoryIterator($source);

    foreach ($iterator as $entry) {
        assertArchiveDirectoryIdentity($source, $sourceIdentity);

        if ($entry->isDot()) {
            continue;
        }

        if ($entry->isLink()) {
            warnSkippedSourceSymlink($entry->getPathname());

            continue;
        }

        if (
            $agentSessionsDepth === 1
            && $entry->isDir()
            && isProviderTransactionDirectory($entry->getFilename())
        ) {
            fwrite(STDERR, "WARNING: excluding provider transaction directory: {$entry->getPathname()}\n");

            continue;
        }

        $destination = "{$target}/{$entry->getFilename()}";

        if ($entry->isDir()) {
            copyDirectory(
                $entry->getPathname(),
                $destination,
                $agentSessionsDepth === null ? null : $agentSessionsDepth + 1,
            );

            continue;
        }

        if ($entry->isFile()) {
            orbitSessionArchiveCopyFile($entry->getPathname(), $destination);
        }
    }

    assertArchiveDirectoryIdentity($source, $sourceIdentity);
}

/** @return array{dev: int, ino: int, mode: int} */
function archiveDirectoryIdentity(string $path): array
{
    $stat = @lstat($path);

    if ($stat === false || ! orbitSessionArchiveStatIsDirectory($stat)) {
        throw new RuntimeException("Archive source directory must be real, not a symlink: {$path}");
    }

    return ['dev' => (int) $stat['dev'], 'ino' => (int) $stat['ino'], 'mode' => (int) $stat['mode']];
}

/** @param array{dev: int, ino: int, mode: int} $expected */
function assertArchiveDirectoryIdentity(string $path, array $expected): void
{
    if (archiveDirectoryIdentity($path) !== $expected) {
        throw new RuntimeException("Archive source directory changed during copy: {$path}");
    }
}

function warnSkippedSourceSymlink(string $path): void
{
    fwrite(STDERR, "WARNING: skipping source symlink without following it: {$path}\n");
}

function isProviderTransactionDirectory(string $name): bool
{
    return preg_match('/^\..+\.(?:tmp|backup)-[^\/]+$/', $name) === 1;
}

/**
 * @param array<string, mixed> $options
 */
function shouldDiscoverWorkerIds(array $options): bool
{
    return ! isset($options['processes-json']) && ! isset($options['worker-id']);
}

/**
 * @return list<string>
 */
function discoverWorkerRegistryIds(string $cwd, string $sourceOrbitDir): array
{
    $directories = array_unique([
        rtrim($cwd, '/').'/.orbit/workers',
        rtrim($sourceOrbitDir, '/').'/workers',
    ]);
    $ids = [];

    foreach ($directories as $directory) {
        if (! is_dir($directory)) {
            continue;
        }

        foreach (glob($directory.'/*.json') ?: [] as $path) {
            if (! is_file($path) || is_link($path)) {
                continue;
            }

            $payload = json_decode((string) file_get_contents($path), true);
            $id = is_array($payload) && is_string($payload['id'] ?? null) ? $payload['id'] : null;

            if ($id === null || $id === '' || in_array($id, $ids, true)) {
                continue;
            }

            $ids[] = $id;
        }
    }

    sort($ids, SORT_STRING);

    return $ids;
}

/**
 * @param array<string, mixed> $options
 * @param list<string> $discoveredWorkerIds
 *
 * @return array<int, array<string, mixed>>
 */
function runAgentSessionArchive(array $options, string $cwd, string $archiveDir, array $discoveredWorkerIds): array
{
    $command = [
        PHP_BINARY,
        __DIR__.'/orbit-agent-session-archive',
        "--archive-dir={$archiveDir}/agent-sessions",
        "--cwd={$cwd}",
    ];

    foreach ([
        'processes-json',
        'worker-id',
        'home',
        'marker',
        'max-start-distance',
    ] as $option) {
        if (isset($options[$option])) {
            $command[] = "--{$option}={$options[$option]}";
        }
    }

    if (! isset($options['worker-id']) && $discoveredWorkerIds !== []) {
        $command[] = '--worker-id='.implode(',', $discoveredWorkerIds);
    }

    if (array_key_exists('only-ok', $options)) {
        $command[] = '--only-ok';
    }

    [$exitCode, $stdout, $stderr] = runCommand($command);

    if ($stderr !== '') {
        fwrite(STDERR, rtrim($stderr, "\n").PHP_EOL);
    }

    if ($exitCode !== 0) {
        throw new RuntimeException(
            "Agent session archive failed with exit code {$exitCode}: ".trim($stdout),
        );
    }

    $payload = json_decode($stdout, true, flags: JSON_THROW_ON_ERROR);

    return is_array($payload) ? $payload : [];
}

function normalizeFallbackManifestArchiveDirectory(string $temporaryArchiveDir, string $archiveDir): void
{
    $manifestPath = "{$temporaryArchiveDir}/agent-sessions/manifest.json";
    $contents = file_get_contents($manifestPath);

    if ($contents === false) {
        throw new RuntimeException("Fallback extraction did not write its top-level manifest: {$manifestPath}");
    }

    $manifest = json_decode($contents, true, flags: JSON_THROW_ON_ERROR);

    if (! is_array($manifest)) {
        throw new RuntimeException("Fallback extraction wrote an invalid top-level manifest: {$manifestPath}");
    }

    $manifest['archive_dir'] = "{$archiveDir}/agent-sessions";
    writeJsonFile($manifestPath, $manifest);
}

/**
 * Keeps the child's stderr separate from its stdout so warnings on successful
 * runs pass through to the operator without corrupting the JSON payload.
 *
 * @param list<string> $command
 *
 * @return array{0: int, 1: string, 2: string}
 */
function runCommand(array $command): array
{
    $stderrPath = tempnam(sys_get_temp_dir(), 'orbit-session-archive-stderr-');
    $redirect = $stderrPath === false ? '2>&1' : '2>'.escapeshellarg($stderrPath);
    $output = [];
    $exitCode = 0;
    exec(implode(' ', array_map('escapeshellarg', $command)).' '.$redirect, $output, $exitCode);
    $stderr = '';

    if ($stderrPath !== false) {
        $stderr = (string) file_get_contents($stderrPath);
        unlink($stderrPath);
    }

    return [$exitCode, implode("\n", $output), $stderr];
}

function slugify(string $value): string
{
    $slug = strtolower((string) preg_replace('/[^a-zA-Z0-9]+/', '-', $value));
    $slug = trim($slug, '-');

    return $slug === '' ? 'session' : $slug;
}

/**
 * @param array<string, mixed> $payload
 */
function writeJsonFile(string $path, array $payload): void
{
    orbitSessionArchiveWriteFile(
        $path,
        json_encode($payload, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR).PHP_EOL,
    );
}

function refreshSessionIndex(string $sessionsDir): void
{
    $process = proc_open(
        [
            PHP_BINARY,
            __DIR__.'/orbit-session-index',
            "--sessions-dir={$sessionsDir}",
        ],
        [
            1 => ['pipe', 'w'],
            2 => ['pipe', 'w'],
        ],
        $pipes,
        dirname(__DIR__),
    );

    if (! is_resource($process)) {
        throw new RuntimeException("Unable to refresh session index for {$sessionsDir}.");
    }

    $stdout = stream_get_contents($pipes[1]);
    $stderr = stream_get_contents($pipes[2]);
    fclose($pipes[1]);
    fclose($pipes[2]);

    $exitCode = proc_close($process);

    if ($exitCode !== 0) {
        throw new RuntimeException(
            trim($stderr ?: $stdout ?: "Unable to refresh session index for {$sessionsDir}."),
        );
    }

    if ($stdout === false || $stdout === '') {
        throw new RuntimeException("Session index generation returned no content for {$sessionsDir}.");
    }

    orbitSessionArchiveWriteFileAtomically("{$sessionsDir}/index.json", $stdout);
}

function validateStagedCaptures(string $agentSessionsDir): bool
{
    if (! file_exists($agentSessionsDir) && ! is_link($agentSessionsDir)) {
        return false;
    }

    if (is_link($agentSessionsDir)) {
        warnSkippedSourceSymlink($agentSessionsDir);

        return false;
    }

    if (! is_dir($agentSessionsDir)) {
        return false;
    }

    $hasValidatedCapture = false;

    foreach (new DirectoryIterator($agentSessionsDir) as $providerEntry) {
        if ($providerEntry->isDot() || $providerEntry->isLink() || ! $providerEntry->isDir()) {
            if ($providerEntry->isLink()) {
                warnSkippedSourceSymlink($providerEntry->getPathname());
            }

            continue;
        }

        $provider = $providerEntry->getFilename();

        foreach (new DirectoryIterator($providerEntry->getPathname()) as $captureEntry) {
            if ($captureEntry->isDot()) {
                continue;
            }

            if ($captureEntry->isLink()) {
                warnSkippedSourceSymlink($captureEntry->getPathname());

                continue;
            }

            if (! $captureEntry->isDir() || isProviderTransactionDirectory($captureEntry->getFilename())) {
                continue;
            }

            $manifestPath = $captureEntry->getPathname().'/manifest.json';

            if (is_link($manifestPath) || ! is_file($manifestPath)) {
                throw new RuntimeException(
                    "Staged capture manifest.json is required and must be a non-symlink regular file: {$manifestPath}",
                );
            }

            validateStagedCaptureManifest($manifestPath, $provider, $captureEntry->getFilename());
            $hasValidatedCapture = true;
        }
    }

    return $hasValidatedCapture;
}

function validateStagedCaptureManifest(string $manifestPath, string $provider, string $slug): void
{
    $contents = file_get_contents($manifestPath);

    if ($contents === false) {
        throw new RuntimeException("Unable to read staged manifest: {$manifestPath}");
    }

    try {
        $manifest = json_decode($contents, true, flags: JSON_THROW_ON_ERROR);
    } catch (JsonException) {
        throw new RuntimeException("Staged manifest must contain valid JSON: {$manifestPath}");
    }

    if (! is_array($manifest)) {
        throw new RuntimeException("Staged manifest must contain a JSON object: {$manifestPath}");
    }

    if (($manifest['schema_version'] ?? null) !== 1) {
        throw new RuntimeException("Staged manifest schema_version must be 1: {$manifestPath}");
    }

    if (($manifest['provider'] ?? null) !== $provider) {
        throw new RuntimeException(
            "Staged manifest provider must match directory '{$provider}': {$manifestPath}",
        );
    }

    if (($manifest['slug'] ?? null) !== $slug) {
        throw new RuntimeException("Staged manifest slug must match directory '{$slug}': {$manifestPath}");
    }

    $workerId = $manifest['worker_id'] ?? null;

    if (! is_string($workerId) || preg_match('/^[a-z][a-z0-9-]*$/', $workerId) !== 1) {
        throw new RuntimeException("Staged manifest worker_id must be a worker id: {$manifestPath}");
    }

    $status = $manifest['status'] ?? null;

    if (! is_string($status) || $status === '') {
        throw new RuntimeException("Staged manifest status is required: {$manifestPath}");
    }

    if (! in_array($status, STAGED_CAPTURE_STATUSES, true)) {
        throw new RuntimeException("Staged manifest has unknown status '{$status}': {$manifestPath}");
    }

    if ($status !== 'ok' && (! is_string($manifest['reason'] ?? null) || trim($manifest['reason']) === '')) {
        throw new RuntimeException("A non-ok staged manifest requires a non-empty reason: {$manifestPath}");
    }

    if ($status === 'ok') {
        validateCompleteStagedCapture(dirname($manifestPath));
    }
}

function validateCompleteStagedCapture(string $captureDir): void
{
    foreach (['usage.json', 'messages.jsonl'] as $filename) {
        $path = "{$captureDir}/{$filename}";

        if (is_link($path) || ! is_file($path) || filesize($path) === 0) {
            throw new RuntimeException("Staged {$filename} must be non-empty: {$path}");
        }
    }

    $rawDir = "{$captureDir}/raw";

    if (is_link($rawDir) || ! is_dir($rawDir) || ! directoryContainsNonEmptyRegularFile($rawDir)) {
        throw new RuntimeException("Staged raw must contain a non-empty regular file: {$rawDir}");
    }
}

function directoryContainsNonEmptyRegularFile(string $directory): bool
{
    foreach (new DirectoryIterator($directory) as $entry) {
        if ($entry->isDot() || $entry->isLink()) {
            continue;
        }

        if ($entry->isFile() && $entry->getSize() > 0) {
            return true;
        }

        if ($entry->isDir() && directoryContainsNonEmptyRegularFile($entry->getPathname())) {
            return true;
        }
    }

    return false;
}

function cleanupConstructionFailure(string $temporaryArchiveDir, Throwable $exception): void
{
    $cleanupFailure = null;

    try {
        orbitSessionArchiveRemovePath($temporaryArchiveDir);
    } catch (Throwable $cleanupException) {
        $cleanupFailure = $cleanupException->getMessage();
    }

    fwrite(STDERR, "Archive construction failed: {$exception->getMessage()}\n");

    if ($cleanupFailure !== null) {
        fwrite(STDERR, "Temporary archive cleanup also failed: {$cleanupFailure}\n");
    }
}

function reportActiveLoopWriteFailure(
    Throwable $exception,
    string $archiveDir,
    string $backupDir,
): void {
    fwrite(STDERR, "Active loop bookkeeping failed: {$exception->getMessage()}\n");
    fwrite(STDERR, "Coherent new archive retained at: {$archiveDir}\n");

    if (file_exists($backupDir) || is_link($backupDir)) {
        fwrite(STDERR, "Previous archive retained at: {$backupDir}\n");
        fwrite(
            STDERR,
            'Recovery: remove '
            .escapeshellarg($archiveDir)
            .' and run mv '
            .escapeshellarg($backupDir)
            .' '
            .escapeshellarg($archiveDir)
            ."\n",
        );

        return;
    }

    fwrite(STDERR, 'Recovery: repair bookkeeping, or remove '.escapeshellarg($archiveDir)." before retrying.\n");
}

function reportIndexRefreshFailure(
    Throwable $exception,
    string $archiveDir,
    string $backupDir,
    string $archiveRoot,
): void {
    fwrite(STDERR, "Session index bookkeeping failed: {$exception->getMessage()}\n");
    fwrite(STDERR, "Coherent new archive and active loop retained at: {$archiveDir}\n");

    if (file_exists($backupDir) || is_link($backupDir)) {
        fwrite(STDERR, "Previous archive backup retained at: {$backupDir}\n");
    }

    fwrite(
        STDERR,
        'Index recovery: keep the coherent new archive and active loop; repair the index with bin/orbit-session-index '
        .'--sessions-dir='
        .escapeshellarg($archiveRoot)
        ." --write.\n",
    );

    if (file_exists($backupDir) || is_link($backupDir)) {
        fwrite(STDERR, 'After index repair, remove the retained backup at '.escapeshellarg($backupDir).".\n");
    }
}

function reportBackupCleanupFailure(
    Throwable $exception,
    string $archiveDir,
    string $backupDir,
): void {
    fwrite(STDERR, "Archive backup cleanup failed: {$exception->getMessage()}\n");
    fwrite(STDERR, "The new archive, active loop, and session index remain coherent at: {$archiveDir}\n");
    fwrite(
        STDERR,
        'Cleanup recovery: inspect and remove any retained backup residue at '.escapeshellarg($backupDir).".\n",
    );
}
