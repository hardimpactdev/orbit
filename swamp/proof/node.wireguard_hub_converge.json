{
  "kind": "node.wireguard_hub_converge",
  "workflow": "operation-node-wireguard-hub-converge",
  "topology": "minimal",
  "budget_seconds": 120,
  "queue_timeout_seconds": 30,
  "before_gateway": [
    [
      "bash",
      "tools/swamp-proof-guest/hub-proof.sh",
      "${node.target}",
      "${node.gateway}",
      "${node.operator}"
    ]
  ],
  "clean_target": [
    [
      "sh",
      "-c",
      "command -v wg-quick >/dev/null || DEBIAN_FRONTEND=noninteractive apt-get install -y -q wireguard-tools >/dev/null; umask 077; mkdir -p /etc/wireguard; rm -rf /etc/wireguard/orbit.key /etc/wireguard/orbit-peers.conf /etc/wireguard/orbit-peers.d"
    ]
  ],
  "request": {
    "method": "POST",
    "path": "nodes/${node.target}/wireguard-hub/converge"
  },
  "expect": {
    "status": "succeeded"
  },
  "phases": [
    {
      "name": "Keep the key in a file",
      "job": "files",
      "step": "Keep the key in a file",
      "budget_seconds": 30
    },
    {
      "name": "Write the hub config",
      "job": "files",
      "step": "Write the hub config",
      "budget_seconds": 30
    },
    {
      "name": "Write the peer files",
      "job": "files",
      "step": "Write the peer files-0",
      "budget_seconds": 60
    },
    {
      "name": "Remove stale peer files",
      "job": "files",
      "step": "Remove stale peer files",
      "budget_seconds": 30
    },
    {
      "name": "Apply the peers",
      "job": "apply",
      "step": "Apply the peers",
      "budget_seconds": 30
    },
    {
      "name": "Check the hub service",
      "job": "check",
      "step": "Check the hub service",
      "budget_seconds": 30
    },
    {
      "name": "Read the peers again",
      "job": "check",
      "step": "Read the peers again",
      "budget_seconds": 15
    },
    {
      "name": "Confirm the hub",
      "job": "check",
      "step": "Confirm the hub",
      "budget_seconds": 15
    }
  ],
  "parity": "swamp/proof/node.wireguard_hub_converge/parity.py"
}
