#!/usr/bin/env bash

set -Eeuo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." >/dev/null 2>&1 && pwd)"
TMP="$(mktemp -d "${TMPDIR:-/tmp}/orbit-prepare-worktree-test.XXXXXX")"
TMP="$(cd "$TMP" && pwd -P)"
REAL_GIT="$(command -v git)"

cleanup() {
    rm -rf "$TMP"
}

trap cleanup EXIT

fail() {
    printf 'FAIL: %s\n' "$*" >&2
    exit 1
}

assert_file_equals() {
    local path="$1"
    local expected="$2"

    [ -f "$path" ] || fail "missing file: $path"
    [ "$(cat "$path")" = "$expected" ] || fail "unexpected contents for: $path"
}

write_composer_stub() {
    cat >"$STUB_BIN/composer" <<'STUB'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"${COMPOSER_LOG:-/tmp/orbit-prepare-worktree-composer.log}"
if [ "$*" = "install" ]; then
    printf '%s\n' "$(pwd -P)" >>"${COMPOSER_INSTALL_LOG:-/dev/null}"
    mkdir -p vendor
    printf '<?php\n' >vendor/autoload.php
fi
exit 0
STUB
    chmod +x "$STUB_BIN/composer"
}

run_prepare_worktree() {
    local branch="$1"

    if ! PATH="$STUB_BIN:$PATH" "$REPO/bin/orbit-prepare-worktree" "$branch" --skip-tests >/tmp/orbit-prepare-worktree-test.out 2>/tmp/orbit-prepare-worktree-test.err; then
        cat /tmp/orbit-prepare-worktree-test.err >&2
        fail "prepare-worktree failed for branch: $branch"
    fi
}

assert_composer_installs_tracked_projects() {
    local worktree_path="$1"
    local install_log="$2"
    local expected_path
    local last_package_line=0
    local first_app_line=0
    local line_number=0
    local install_path
    local found_gateway=0
    local expected_paths=()

    [ -f "$install_log" ] || fail "missing composer install log: $install_log"

    expected_paths=("$worktree_path")
    for composer_manifest in "$worktree_path"/packages/*/composer.json "$worktree_path"/apps/*/composer.json; do
        if [ -f "$composer_manifest" ]; then
            expected_paths+=("$(dirname "$composer_manifest")")
        fi
    done

    worktree_path="$(cd "$worktree_path" && pwd -P)"

    for expected_path in "${expected_paths[@]}"; do
        expected_path="$(cd "$expected_path" && pwd -P)"
        if [ "$expected_path" = "${worktree_path}/apps/gateway" ]; then
            found_gateway=1
        fi

        grep -qxF "$expected_path" "$install_log" \
            || fail "composer install was not run in tracked project: $expected_path"
        [ -f "${expected_path}/vendor/autoload.php" ] \
            || fail "missing vendor/autoload.php in tracked project: $expected_path"
    done

    [ "$found_gateway" -eq 1 ] || fail "fixture must track apps/gateway/composer.json"

    while IFS= read -r install_path; do
        line_number=$((line_number + 1))
        case "$install_path" in
            "$worktree_path"/packages/*)
                last_package_line="$line_number"
                ;;
            "$worktree_path"/apps/*)
                if [ "$first_app_line" -eq 0 ]; then
                    first_app_line="$line_number"
                fi
                ;;
        esac
    done <"$install_log"

    [ "$last_package_line" -gt 0 ] || fail "composer install log is missing package projects"
    [ "$first_app_line" -gt 0 ] || fail "composer install log is missing app projects"
    [ "$last_package_line" -lt "$first_app_line" ] \
        || fail "package composer installs must run before app composer installs"
}

REPO="$TMP/repo"
STUB_BIN="$TMP/bin"

mkdir -p \
    "$REPO/bin" \
    "$REPO/packages/core" \
    "$REPO/packages/sdk" \
    "$REPO/packages/sdk-typescript" \
    "$REPO/apps/cli" \
    "$REPO/apps/docs" \
    "$REPO/apps/e2e" \
    "$REPO/apps/gateway" \
    "$REPO/apps/reverb" \
    "$STUB_BIN"
cp "$ROOT/bin/orbit-prepare-worktree" "$REPO/bin/orbit-prepare-worktree"

cat >"$REPO/bin/quality-gate-seed-baselines" <<'STUB'
#!/usr/bin/env bash
exit 0
STUB
chmod +x "$REPO/bin/orbit-prepare-worktree" "$REPO/bin/quality-gate-seed-baselines"

write_composer_stub

cat >"$STUB_BIN/vp" <<'STUB'
#!/usr/bin/env bash
exit 0
STUB

cat >"$STUB_BIN/tmux" <<'STUB'
#!/usr/bin/env bash
exit 0
STUB

cat >"$STUB_BIN/git" <<STUB
#!/usr/bin/env bash
if [ "\${1-}" = worktree ] && [ "\${2-}" = add ]; then
    printf '%s\n' "\$*" >>"\${GIT_WORKTREE_ADD_LOG:-/dev/null}"
fi
case "\${1-}" in
    fetch|pull|reset)
        printf '%s\n' "\$*" >>"\${GIT_MUTATION_LOG:-/dev/null}"
        ;;
esac
exec "$REAL_GIT" "\$@"
STUB

chmod +x "$STUB_BIN/composer" "$STUB_BIN/vp" "$STUB_BIN/tmux" "$STUB_BIN/git"

printf '{}\n' >"$REPO/composer.json"
printf '{}\n' >"$REPO/packages/core/composer.json"
printf '{}\n' >"$REPO/packages/sdk/composer.json"
printf '{}\n' >"$REPO/packages/sdk-typescript/package.json"
printf '{}\n' >"$REPO/apps/cli/composer.json"
printf '{}\n' >"$REPO/apps/docs/composer.json"
printf '{}\n' >"$REPO/apps/e2e/composer.json"
printf '{}\n' >"$REPO/apps/gateway/composer.json"
printf '{}\n' >"$REPO/apps/reverb/composer.json"

cat >"$REPO/LOOP.md.example" <<'EOF'
# Loop Template

| Slice | State | Checkpoint |
| --- | --- | --- |
| `.orbit/slices/01-example.md` | ready | none |

Seeded by the test fixture.
EOF

(
    cd "$REPO"

    git init -b main >/dev/null
    git config user.name 'Orbit Prepare Worktree Test'
    git config user.email 'orbit-prepare-worktree-test@example.invalid'

    printf '.worktrees\n/.worktrees/\n' >.gitignore
    git add .gitignore LOOP.md.example bin/orbit-prepare-worktree bin/quality-gate-seed-baselines composer.json packages apps
    git commit -m 'Initial fixture' >/dev/null
)

run_prepare_worktree feature-loop

LOOP_PATH="$REPO/.worktrees/feature-loop/.orbit/loop.md"
assert_file_equals "$LOOP_PATH" "$(cat "$REPO/LOOP.md.example")"

grep -Fq '| `.orbit/slices/01-example.md` | ready | none |' "$LOOP_PATH" \
    || fail "seeded loop must include the exact example slice row"

printf 'custom active packet\n' >"$LOOP_PATH"

run_prepare_worktree feature-loop

assert_file_equals "$LOOP_PATH" 'custom active packet'

[ -d "${REPO}/.worktrees/feature-loop/.orbit/slices" ] \
    || fail "prepare-worktree must create .orbit/slices"

printf 'existing slice artifact\n' >"${REPO}/.worktrees/feature-loop/.orbit/slices/existing.md"
run_prepare_worktree feature-loop
assert_file_equals "${REPO}/.worktrees/feature-loop/.orbit/slices/existing.md" 'existing slice artifact'

rm -rf "${REPO}/.worktrees/feature-loop/.orbit/slices"
printf 'legacy slice artifact\n' >"${REPO}/.worktrees/feature-loop/.orbit/legacy-slice.md"
run_prepare_worktree feature-loop
[ -d "${REPO}/.worktrees/feature-loop/.orbit/slices" ] \
    || fail "prepare-worktree must upgrade existing loops with .orbit/slices"
assert_file_equals "$LOOP_PATH" 'custom active packet'
assert_file_equals "${REPO}/.worktrees/feature-loop/.orbit/legacy-slice.md" 'legacy slice artifact'

if PATH="$STUB_BIN:$PATH" "$REPO/bin/orbit-prepare-worktree" My_Feature --skip-tests >/tmp/orbit-prepare-worktree-test.out 2>/tmp/orbit-prepare-worktree-test.err; then
    fail "prepare-worktree accepted invalid slug My_Feature"
fi
grep -q 'My_Feature' /tmp/orbit-prepare-worktree-test.err || fail "invalid-slug error must name My_Feature"
grep -Fq '^[a-z0-9][a-z0-9-]*$' /tmp/orbit-prepare-worktree-test.err || fail "invalid-slug error must name the pattern"
grep -q 'my-feature' /tmp/orbit-prepare-worktree-test.err || fail "invalid-slug error must suggest my-feature"

if PATH="$STUB_BIN:$PATH" "$REPO/bin/orbit-prepare-worktree" My_Feature --dry-run >/tmp/orbit-prepare-worktree-test.out 2>/tmp/orbit-prepare-worktree-test.err; then
    fail "prepare-worktree --dry-run accepted invalid slug My_Feature"
fi
grep -q 'My_Feature' /tmp/orbit-prepare-worktree-test.err || fail "dry-run invalid-slug error must name My_Feature"

write_composer_stub

COMPOSER_LOG="$TMP/composer-default.log"
COMPOSER_INSTALL_LOG="$TMP/composer-default-installs.log"
: >"$COMPOSER_LOG"
: >"$COMPOSER_INSTALL_LOG"
if ! PATH="$STUB_BIN:$PATH" COMPOSER_LOG="$COMPOSER_LOG" COMPOSER_INSTALL_LOG="$COMPOSER_INSTALL_LOG" "$REPO/bin/orbit-prepare-worktree" feature-default-skip >/tmp/orbit-prepare-worktree-test.out 2>/tmp/orbit-prepare-worktree-test.err; then
    cat /tmp/orbit-prepare-worktree-test.err >&2
    fail "prepare-worktree default should skip baseline tests"
fi
grep -q 'skip composer test: baseline tests are opt-in' /tmp/orbit-prepare-worktree-test.out \
    || fail "default prepare-worktree must skip baseline tests"
if grep -qx 'test' "$COMPOSER_LOG"; then
    fail "default prepare-worktree must not invoke composer test"
fi
assert_composer_installs_tracked_projects "$REPO/.worktrees/feature-default-skip" "$COMPOSER_INSTALL_LOG"

COMPOSER_LOG="$TMP/composer-with-tests.log"
: >"$COMPOSER_LOG"
if ! PATH="$STUB_BIN:$PATH" COMPOSER_LOG="$COMPOSER_LOG" "$REPO/bin/orbit-prepare-worktree" feature-with-tests --with-tests >/tmp/orbit-prepare-worktree-test.out 2>/tmp/orbit-prepare-worktree-test.err; then
    cat /tmp/orbit-prepare-worktree-test.err >&2
    fail "prepare-worktree --with-tests failed"
fi
grep -qx 'test' "$COMPOSER_LOG" \
    || fail "prepare-worktree --with-tests must invoke composer test"

cat >"$STUB_BIN/composer" <<'STUB'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"${COMPOSER_LOG:-/tmp/orbit-prepare-worktree-composer.log}"
exit 0
STUB
chmod +x "$STUB_BIN/composer"

MISSING_AUTOLOAD_BRANCH='feature-missing-autoload'
if PATH="$STUB_BIN:$PATH" "$REPO/bin/orbit-prepare-worktree" "$MISSING_AUTOLOAD_BRANCH" --skip-tests >/tmp/orbit-prepare-worktree-test.out 2>/tmp/orbit-prepare-worktree-test.err; then
    fail "prepare-worktree must fail when Composer install does not produce vendor/autoload.php"
fi
grep -qxF "orbit-prepare-worktree: Composer install did not produce vendor/autoload.php in $REPO/.worktrees/${MISSING_AUTOLOAD_BRANCH}" /tmp/orbit-prepare-worktree-test.err \
    || fail "missing autoload error must print the exact project path"
grep -qF 'vendor/autoload.php' /tmp/orbit-prepare-worktree-test.err \
    || fail "missing autoload error must name vendor/autoload.php"
if grep -qF 'WORKTREE_PREPARED' /tmp/orbit-prepare-worktree-test.out; then
    fail "missing autoload must not print WORKTREE_PREPARED"
fi

cat >"$STUB_BIN/composer" <<'STUB'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"${COMPOSER_LOG:-/tmp/orbit-prepare-worktree-composer.log}"
if [ "$*" = "install" ]; then
    printf '%s\n' "$(pwd -P)" >>"${COMPOSER_INSTALL_LOG:-/dev/null}"
    case "$(pwd -P)" in
        */apps/gateway)
            exit 0
            ;;
    esac
    mkdir -p vendor
    printf '<?php\n' >vendor/autoload.php
fi
exit 0
STUB
chmod +x "$STUB_BIN/composer"

MISSING_GATEWAY_AUTOLOAD_BRANCH='feature-missing-gateway-autoload'
GATEWAY_APP_PATH="$REPO/.worktrees/${MISSING_GATEWAY_AUTOLOAD_BRANCH}/apps/gateway"
(
    cd "$REPO"
    printf '<?php\n' >apps/gateway/artisan
    printf 'APP_NAME=Orbit\n' >apps/gateway/.env.example
    git add apps/gateway/artisan apps/gateway/.env.example
    git commit -m 'Add gateway app markers' >/dev/null
)
if PATH="$STUB_BIN:$PATH" "$REPO/bin/orbit-prepare-worktree" "$MISSING_GATEWAY_AUTOLOAD_BRANCH" --skip-tests >/tmp/orbit-prepare-worktree-test.out 2>/tmp/orbit-prepare-worktree-test.err; then
    fail "prepare-worktree must fail when a tracked app Composer install does not produce vendor/autoload.php"
fi
grep -qxF "orbit-prepare-worktree: Composer install did not produce vendor/autoload.php in $GATEWAY_APP_PATH" /tmp/orbit-prepare-worktree-test.err \
    || fail "missing gateway autoload error must print the exact project path"
grep -qF 'vendor/autoload.php' /tmp/orbit-prepare-worktree-test.err \
    || fail "missing gateway autoload error must name vendor/autoload.php"
if grep -qF 'WORKTREE_PREPARED' /tmp/orbit-prepare-worktree-test.out; then
    fail "missing gateway autoload must not print WORKTREE_PREPARED"
fi
if grep -qF 'Preparing gateway app state' /tmp/orbit-prepare-worktree-test.out; then
    fail "missing gateway autoload must not run gateway app setup"
fi
[ ! -e "${GATEWAY_APP_PATH}/storage/framework/testing/worktree-orbit" ] \
    || fail "missing gateway autoload must not create gateway app state"

write_composer_stub
(
    cd "$REPO"
    git rm -f apps/gateway/artisan apps/gateway/.env.example >/dev/null
    git commit -m 'Remove gateway app markers' >/dev/null
)

(
    cd "$REPO"
    LOCAL_MAIN="$(git rev-parse --verify main)"
    git commit --allow-empty -m 'origin/main ahead' >/dev/null
    ORIGIN_MAIN="$(git rev-parse --verify main)"
    git reset --hard "$LOCAL_MAIN" >/dev/null
    git update-ref refs/remotes/origin/main "$ORIGIN_MAIN"
    printf '%s\n' "$LOCAL_MAIN" >"$TMP/local-main.sha"
    printf '%s\n' "$ORIGIN_MAIN" >"$TMP/origin-main.sha"
)

LOCAL_MAIN="$(cat "$TMP/local-main.sha")"
ORIGIN_MAIN="$(cat "$TMP/origin-main.sha")"
GIT_WORKTREE_ADD_LOG="$TMP/git-worktree-add.log"
GIT_MUTATION_LOG="$TMP/git-mutation.log"
: >"$GIT_WORKTREE_ADD_LOG"
: >"$GIT_MUTATION_LOG"
MAIN_BEFORE="$(PATH="$STUB_BIN:$PATH" git -C "$REPO" rev-parse --verify main)"

if PATH="$STUB_BIN:$PATH" GIT_WORKTREE_ADD_LOG="$GIT_WORKTREE_ADD_LOG" GIT_MUTATION_LOG="$GIT_MUTATION_LOG" "$REPO/bin/orbit-prepare-worktree" feature-stale-main --skip-tests >/tmp/orbit-prepare-worktree-test.out 2>/tmp/orbit-prepare-worktree-test.err; then
    fail "prepare-worktree must fail when local main differs from origin/main"
fi
grep -qF "$LOCAL_MAIN" /tmp/orbit-prepare-worktree-test.err \
    || fail "stale-main error must print the local main SHA"
grep -qF "$ORIGIN_MAIN" /tmp/orbit-prepare-worktree-test.err \
    || fail "stale-main error must print the origin/main SHA"
grep -qF 'local main must be updated' /tmp/orbit-prepare-worktree-test.err \
    || fail "stale-main error must say that local main must be updated"
if grep -qF 'must be pushed' /tmp/orbit-prepare-worktree-test.err; then
    fail "stale-main error must not say that local main must be pushed"
fi
[ ! -s "$GIT_WORKTREE_ADD_LOG" ] \
    || fail "stale-main must fail before git worktree add"
[ ! -e "$REPO/.worktrees/feature-stale-main" ] \
    || fail "stale-main must not create the worktree path"
[ ! -s "$GIT_MUTATION_LOG" ] \
    || fail "stale-main must not fetch, pull, or reset"
MAIN_AFTER="$(PATH="$STUB_BIN:$PATH" git -C "$REPO" rev-parse --verify main)"
[ "$MAIN_BEFORE" = "$MAIN_AFTER" ] || fail "stale-main must not mutate local main"
[ "$MAIN_AFTER" = "$LOCAL_MAIN" ] || fail "local main SHA changed during stale-main rejection"

(
    cd "$REPO"
    git reset --hard origin/main >/dev/null
    ORIGIN_MAIN="$(git rev-parse --verify main)"
    git commit --allow-empty -m 'local main ahead' >/dev/null
    LOCAL_MAIN="$(git rev-parse --verify main)"
    git update-ref refs/remotes/origin/main "$ORIGIN_MAIN"
    printf '%s\n' "$LOCAL_MAIN" >"$TMP/ahead-local-main.sha"
    printf '%s\n' "$ORIGIN_MAIN" >"$TMP/ahead-origin-main.sha"
)

LOCAL_MAIN="$(cat "$TMP/ahead-local-main.sha")"
ORIGIN_MAIN="$(cat "$TMP/ahead-origin-main.sha")"
: >"$GIT_WORKTREE_ADD_LOG"
: >"$GIT_MUTATION_LOG"
MAIN_BEFORE="$(PATH="$STUB_BIN:$PATH" git -C "$REPO" rev-parse --verify main)"

if PATH="$STUB_BIN:$PATH" GIT_WORKTREE_ADD_LOG="$GIT_WORKTREE_ADD_LOG" GIT_MUTATION_LOG="$GIT_MUTATION_LOG" "$REPO/bin/orbit-prepare-worktree" feature-ahead-main --skip-tests >/tmp/orbit-prepare-worktree-test.out 2>/tmp/orbit-prepare-worktree-test.err; then
    fail "prepare-worktree must fail when local main is ahead of origin/main"
fi
grep -qF "$LOCAL_MAIN" /tmp/orbit-prepare-worktree-test.err \
    || fail "ahead-main error must print the local main SHA"
grep -qF "$ORIGIN_MAIN" /tmp/orbit-prepare-worktree-test.err \
    || fail "ahead-main error must print the origin/main SHA"
grep -qF 'is ahead of origin/main' /tmp/orbit-prepare-worktree-test.err \
    || fail "ahead-main error must say that local main is ahead"
grep -qF 'must be pushed' /tmp/orbit-prepare-worktree-test.err \
    || fail "ahead-main error must say that local main must be pushed"
if grep -qF 'local main must be updated' /tmp/orbit-prepare-worktree-test.err; then
    fail "ahead-main error must not say that local main must be updated"
fi
[ ! -s "$GIT_WORKTREE_ADD_LOG" ] \
    || fail "ahead-main must fail before git worktree add"
[ ! -e "$REPO/.worktrees/feature-ahead-main" ] \
    || fail "ahead-main must not create the worktree path"
[ ! -s "$GIT_MUTATION_LOG" ] \
    || fail "ahead-main must not fetch, pull, or reset"
MAIN_AFTER="$(PATH="$STUB_BIN:$PATH" git -C "$REPO" rev-parse --verify main)"
[ "$MAIN_BEFORE" = "$MAIN_AFTER" ] || fail "ahead-main must not mutate local main"
[ "$MAIN_AFTER" = "$LOCAL_MAIN" ] || fail "local main SHA changed during ahead-main rejection"

run_prepare_worktree feature-loop
assert_file_equals "$LOOP_PATH" 'custom active packet'

if ! PATH="$STUB_BIN:$PATH" "$REPO/bin/orbit-prepare-worktree" feature-explicit-base --base=feature-loop --skip-tests >/tmp/orbit-prepare-worktree-test.out 2>/tmp/orbit-prepare-worktree-test.err; then
    cat /tmp/orbit-prepare-worktree-test.err >&2
    fail "explicit non-main --base must remain allowed when local main is stale"
fi

(
    cd "$REPO"
    git update-ref refs/remotes/origin/main "$(git rev-parse --verify main)"
)

if ! PATH="$STUB_BIN:$PATH" "$REPO/bin/orbit-prepare-worktree" feature-synced-main --skip-tests >/tmp/orbit-prepare-worktree-test.out 2>/tmp/orbit-prepare-worktree-test.err; then
    cat /tmp/orbit-prepare-worktree-test.err >&2
    fail "prepare-worktree should succeed when local main matches origin/main"
fi

printf 'orbit-prepare-worktree tests passed\n'
