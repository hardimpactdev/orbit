{
  "workflow": "operation-task-publish",
  "topology": "minimal",
  "budget_seconds": 1800,
  "queue_timeout_seconds": 30,
  "before_gateway": [
    [
      "python3",
      "-I",
      "swamp/proof/tasks.publish/github_fixture.py",
      "setup",
      "moved",
      "${node.target}",
      "${proof.run}"
    ]
  ],
  "request": {
    "method": "POST",
    "path": "task-groups/${secret.group}/publish",
    "body": {
      "check": "${secret.check}"
    }
  },
  "expect": {
    "status": "failed"
  },
  "parity": [
    "swamp/proof/tasks.publish/github_fixture.py",
    "parity"
  ],
  "phases": [
    {"name": "Create publication scratch", "job": "publish", "step": "Create publication scratch", "budget_seconds": 120},
    {"name": "Read the index", "job": "publish", "step": "Read the index", "budget_seconds": 120},
    {"name": "Add workspace files", "job": "publish", "step": "Add workspace files", "budget_seconds": 120},
    {"name": "Read workspace tree", "job": "publish", "step": "Read workspace tree", "budget_seconds": 120},
    {"name": "Read workspace HEAD", "job": "publish", "step": "Read workspace HEAD", "budget_seconds": 120},
    {"name": "Check the workspace", "job": "publish", "step": "Check the workspace", "budget_seconds": 120},
    {"name": "Revoke the token", "job": "cleanup", "step": "Revoke the token", "budget_seconds": 120},
    {"name": "Remove remote scratch", "job": "cleanup", "step": "Remove remote scratch", "budget_seconds": 120},
    {"name": "Remove local scratch", "job": "cleanup", "step": "Remove local scratch", "budget_seconds": 120},
    {"name": "Confirm publication", "job": "cleanup", "step": "Confirm publication", "budget_seconds": 120}
  ]
}
