{
  "kind": "instance.run_steps",
  "workflow": "operation-instance-setup-direct",
  "topology": "app-dev",
  "budget_seconds": 120,
  "queue_timeout_seconds": 60,
  "prepare": [
    {
      "argv": ["orbit", "project:create", "proof-running-setup-${proof.run}", "node-package", "${proof.repo.url}", "--root=source-setup", "--default-branch=main", "--source-access=github_app", "--json"],
      "capture": {
        "project_id": "$.id"
      }
    },
    {
      "argv": ["orbit", "instance:create", "${capture.project_id}", "${topology.app-dev.node_id}", "proof-${proof.run}", "--root=source-setup", "--json"],
      "capture": {
        "instance_id": "$.target_id"
      }
    },
    {
      "argv": ["orbit", "instance:setup-step:create", "running-list-marker", "--project=${capture.project_id}", "--command=printf setup-ran > .orbit-proof-running-setup", "--timeout=10", "--json"]
    }
  ],
  "request": {
    "argv": ["orbit", "instance:setup", "${capture.instance_id}", "--json"],
    "operation": "$.id"
  },
  "envelope": {
    "instance_id": "${capture.instance_id}",
    "project_id": "${capture.project_id}",
    "source": "project",
    "list": "setup",
    "steps": [
      {
        "name": "running-list-marker",
        "timeout_seconds": 10
      }
    ]
  },
  "expect": {
    "status": "succeeded",
    "outputs": {
      "job": "setup",
      "step": "run-setup",
      "match": {
        "status": "succeeded"
      }
    }
  },
  "phases": [
    {
      "name": "setup-list-first-running-read",
      "job": "setup",
      "step": "run-setup",
      "budget_seconds": 120
    }
  ],
  "parity": {
    "command": ["python3", "-I", "swamp/proof/instance.create/outage_parity.py", "already-running"],
    "cases": [
      "gateway-already-running-list-executes",
      "exact-native-list-succeeds",
      "setup-workload-marker",
      "terminal-projection"
    ]
  },
  "limitations": [
    "The normal Gateway start marks the Operation running before workflow execution; no independent first-read trace is injected.",
    "route_phase: not_exercised (legacy node-package Projects have no automatic Route; this fixture creates no explicit Route)"
  ],
  "needs_caddy": false
}
