{
  "kind": "process.update.docker",
  "workflow": "operation-process-create",
  "topology": "minimal",
  "budget_seconds": 180,
  "queue_timeout_seconds": 30,
  "expect": {
    "status": "succeeded"
  },
  "prepare": [
    {
      "method": "POST",
      "path": "processes",
      "body": {
        "target_type": "node",
        "target_id": "${node.target}",
        "name": "update-${proof.run}",
        "runtime": "docker",
        "image": "busybox:1.36",
        "command": [
          "sleep",
          "infinity"
        ],
        "start": true
      },
      "bind": "process"
    }
  ],
  "request": {
    "method": "PATCH",
    "path": "processes/${process.id}",
    "body": {
      "command": [
        "sleep",
        "7200"
      ]
    }
  },
  "phases": [
    {
      "name": "Replace the container",
      "job": "process",
      "step": "Replace the container",
      "budget_seconds": 20
    },
    {
      "name": "Check the container",
      "job": "process",
      "step": "Check the container",
      "budget_seconds": 20
    },
    {
      "name": "Verify it runs",
      "job": "process",
      "step": "Verify it runs",
      "budget_seconds": 20
    }
  ],
  "parity": [
    "swamp/proof/process/parity.py",
    "running",
    "sleep",
    "7200"
  ]
}
