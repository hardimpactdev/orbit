{
  "kind": "node.settings.symlink",
  "workflow": "operation-node-settings",
  "topology": "minimal",
  "budget_seconds": 120,
  "queue_timeout_seconds": 30,
  "prepare": [],
  "before_target": [
    [
      "sh",
      "-c",
      "mkdir -p /srv/proof-real-${proof.run} && ln -sfn /srv/proof-real-${proof.run} /srv/proof-link-${proof.run}"
    ]
  ],
  "request": {
    "method": "PATCH",
    "path": "nodes/${node.target}/settings",
    "body": {
      "apps": {
        "path": "/srv/proof-link-${proof.run}/apps"
      }
    }
  },
  "expect": {
    "status": "failed"
  },
  "phases": [
    {
      "name": "Read the scripts",
      "job": "settings",
      "step": "Read the scripts",
      "budget_seconds": 20
    },
    {
      "name": "Create the apps folder",
      "job": "settings",
      "step": "Create the apps folder",
      "budget_seconds": 40
    }
  ],
  "parity": [
    "swamp/proof/node.settings/parity.py",
    "refused"
  ]
}
