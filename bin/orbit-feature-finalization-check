#!/usr/bin/env bash

set -Eeuo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." >/dev/null 2>&1 && pwd)"

if [ "$#" -eq 0 ]; then
    cat >&2 <<'EOF'
Usage:
  Packet dry-run (validates loop.md shape only, no git action needed):
    bin/orbit-feature-finalization-check --lint [path-to-loop.md]
      Defaults to ./.orbit/loop.md. Prints PASS/WARNING/BLOCKED lines.
      Exits 0 on pass, 2 on block.

  Required before merge-back:
    bin/orbit-feature-finalization-check git merge <feature-branch>

  Required after a compact session archive exists and is committed with index:
    bin/orbit-feature-finalization-check git worktree remove <worktree-path>
    bin/orbit-feature-finalization-check git branch -d <feature-branch>

  Solo cleanup (exact numeric ids; no chains; no --confirm-stop-running):
    bin/orbit-feature-finalization-check <solo-cli> processes stop <id>
    bin/orbit-feature-finalization-check <solo-cli> projects delete <id>

Explicit invocations print FINALIZATION: PASS or FINALIZATION: BLOCKED and
exit 64 when the arguments cannot be classified as a merge/cleanup/Solo
boundary, instead of silently passing.

Prefer bin/orbit-feature-land on primary main to coordinate resume-safe LAND.
Every destructive mutation still validates here first, then executes separately.

Merge requires diff-derived green proof, one independent reviewer PASS,
accepted feature HEAD, the actual accepted main tip, a clean worktree including
nonignored untracked files, and a conflict-free preview. Cleanup additionally
requires a compact receipt or compatible historical/full archive whose matching
archive directory and .orbit/sessions/index.json are tracked and committed.
Solo process-stop/project-delete require ownership of a linked feature worktree,
landed tip, and that same committed archive/index gate.

This applies the same boundary gate as the Codex PreToolUse hook without
relying on hook interception.
EOF
    exit 64
fi

if [ "$1" = "--lint" ]; then
    shift
    exec "$ROOT/bin/orbit-codex-pre-tool-use-hook" --lint "$@"
fi

ORBIT_FINALIZATION_EXPLICIT=1 exec "$ROOT/bin/orbit-codex-pre-tool-use-hook" "$@"
