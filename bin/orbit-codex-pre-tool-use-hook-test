    local function_name

    [ -f "$COMMAND_CLASSIFY_MODULE" ] || fail 'command classification module is missing'
    grep -Fq "require_once __DIR__.'/orbit-command-classify.php';" "$HOOK" \
        || fail 'hook does not load the command classification module'
    php -r 'ob_start(); require_once $argv[1]; require_once $argv[1]; exit(ob_get_clean() === "" ? 0 : 1);' \
        "$COMMAND_CLASSIFY_MODULE" \
        || fail 'command classification module emitted output while loading'

    for function_name in \
        command_from_argv \
        extract_command \
        find_command_value \
        classify_command \
        e2e_manual_only_invocation \
        composer_script_operand \
        shell_command_string_operand \
        e2e_block_message \
        unsafe_merge_option_problem \
        worktree_remove_command_count \
        branch_delete_command_count \
        git_merge_command_arguments \
        merge_head_operands \
        merge_head_operands_from_words \
        command_segment_after \
        shell_words \
        first_non_option_token \
        non_option_tokens \
        last_non_option_token \
        branch_delete_target \
        branch_delete_targets
    do
        grep -q "^function $function_name(" "$COMMAND_CLASSIFY_MODULE" \
            || fail "$function_name is missing from the command classification module"

        if grep -q "^function $function_name(" "$HOOK"; then
            fail "$function_name remains in the hook entry point"
        fi
    done
}

