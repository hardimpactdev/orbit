#!/usr/bin/env python3
"""Deliver on main only a commit that its merge queue run tested, with that run's digest-bound web build."""
import argparse
import hashlib
import io
import json
import os
from pathlib import Path, PurePosixPath
import re
import runpy
import stat
import subprocess
import time
import zipfile

WORKFLOW = '.github/workflows/ci.yml'
QUEUE_BRANCH = 'gh-readonly-queue/main/'
LIMIT = 128 * 1024 * 1024


def require(condition, message):
    if not condition:
        raise ValueError(message)


def sha256(data):
    return hashlib.sha256(data).hexdigest()


def git(value):
    return subprocess.check_output(['git', 'rev-parse', value], text=True, timeout=5).strip()


class GitHub:
    def __init__(self, repository):
        self.repository = repository
        # Leave runner time for checkout and artifact upload.
        self.deadline = time.monotonic() + 25

    def request(self, path, binary=False):
        left = self.deadline - time.monotonic()
        require(left > 0, 'Receipt API budget exceeded')
        args = ['gh', 'api', '--allow-escape-sequences'] if binary else ['gh', 'api']
        return subprocess.check_output([*args, f'repos/{self.repository}/{path}'], timeout=min(left, 10))

    def raw(self, path):
        return self.request(path, binary=True)

    def one(self, path):
        return json.loads(self.request(path))

    def rows(self, path, key=None):
        result = []
        for page in range(1, 11):
            data = self.one(path + ('&' if '?' in path else '?') + f'per_page=100&page={page}')
            rows = data if key is None else data[key]
            result.extend(rows)
            if len(rows) < 100:
                return result
        raise ValueError('Too many CI evidence records')


def trusted_queue_run(run, repository, workflow_id, sha):
    return (run.get('event') == 'merge_group' and run.get('head_sha') == sha
            and (run.get('head_branch') or '').startswith(QUEUE_BRANCH)
            and (run.get('repository') or {}).get('full_name') == repository
            and (run.get('head_repository') or {}).get('full_name') == repository
            and run.get('workflow_id') == workflow_id and run.get('path') == WORKFLOW)


def queue_run(api, workflow_id, sha):
    """The newest merge queue run of this workflow on the exact commit."""
    runs = [run for run in api.rows(f'actions/workflows/ci.yml/runs?event=merge_group&head_sha={sha}', 'workflow_runs')
            if trusted_queue_run(run, api.repository, workflow_id, sha)]
    return max(runs, key=lambda run: run['id']) if runs else None


def delivered(api, workflow_id, sha):
    """A main run of this workflow passed Main delivery checks on the exact commit."""
    trusted_run = runpy.run_path(str(Path(__file__).with_name('ci-delivery')))['trusted_run']
    runs = [run for run in api.rows(f'actions/workflows/ci.yml/runs?branch=main&head_sha={sha}', 'workflow_runs')
            if trusted_run(run, api.repository, sha, workflow_id)]
    if not runs:
        return False
    run = max(runs, key=lambda run: run['id'])
    job = latest_jobs(api.rows(f"actions/runs/{run['id']}/jobs?filter=all", 'jobs')).get('Main delivery checks', {})
    return job.get('head_sha') == sha and job.get('status') == 'completed' and job.get('conclusion') == 'success'


def queue_baseline(api, history):
    """The newest commit of the group's first-parent base history that the queue tests or main delivered.

    The queue merges a group only when every group ahead of it is green, so a base whose run has not ended counts.
    A commit that reached main without the queue has neither proof: the plan then also covers its changes.
    """
    workflow = api.one('actions/workflows/ci.yml')
    require(workflow['path'] == WORKFLOW, 'Wrong workflow identity')
    for sha in history:
        run = queue_run(api, workflow['id'], sha)
        if run is not None and (run.get('status') != 'completed' or run.get('conclusion') == 'success'):
            return sha
        if delivered(api, workflow['id'], sha):
            return sha
    raise ValueError('No verified commit found on the merge group base history')


def baseline():
    base = os.environ['QUEUE_BASE']
    require(re.fullmatch('[0-9a-f]{40}', base), 'Missing merge group base')
    print(queue_baseline(GitHub(os.environ['GITHUB_REPOSITORY']), subprocess.check_output(
        ['git', 'rev-list', '--first-parent', '--max-count=20', base], text=True, timeout=5).splitlines()))


def artifact_bytes(api, artifact, run_id):
    require(artifact.get('workflow_run', {}).get('id') == run_id, 'Artifact belongs to another run')
    require(not artifact.get('expired'), 'Artifact expired')
    require(0 < artifact['size_in_bytes'] <= LIMIT, 'Artifact size is invalid')
    require(re.fullmatch(r'sha256:[0-9a-f]{64}', artifact.get('digest') or ''), 'Artifact has no SHA256 digest')
    archive = api.raw(f"actions/artifacts/{artifact['id']}/zip")
    require(len(archive) <= LIMIT and 'sha256:' + sha256(archive) == artifact['digest'], 'Artifact digest mismatch')
    return archive


def files(archive):
    with zipfile.ZipFile(io.BytesIO(archive)) as bundle:
        entries = bundle.infolist()
        require(len(entries) <= 20000 and sum(e.file_size for e in entries) <= LIMIT, 'Expanded artifact too large')
        seen = set()
        for entry in entries:
            path = PurePosixPath(entry.filename)
            require(not path.is_absolute() and '..' not in path.parts and '\\' not in entry.filename,
                    'Unsafe artifact path')
            require(not stat.S_ISLNK(entry.external_attr >> 16), 'Artifact contains a symlink')
            require(entry.filename not in seen, 'Duplicate artifact path')
            seen.add(entry.filename)
            if not entry.is_dir():
                yield entry.filename, bundle.read(entry)


def latest_jobs(rows):
    latest = {}
    for row in rows:
        old = latest.get(row['name'])
        if old is None or (row['run_attempt'], row['id']) > (old['run_attempt'], old['id']):
            latest[row['name']] = row
    return latest


def verify(api, sha, tree):
    """The merge queue tested this exact commit: its run's gate and web build are green on it."""
    workflow = api.one('actions/workflows/ci.yml')
    require(workflow['path'] == WORKFLOW, 'Wrong workflow identity')
    run = queue_run(api, workflow['id'], sha)
    require(run is not None, 'No merge queue CI run tested this commit')
    jobs = latest_jobs(api.rows(f"actions/runs/{run['id']}/jobs?filter=all", 'jobs'))
    for name in ('Required checks', 'Select build inputs', 'Web build'):
        job = jobs.get(name, {})
        require(job.get('status') == 'completed' and job.get('conclusion') == 'success' and job.get('head_sha') == sha,
                f'{name} is not green on this commit in its merge queue run')
    # The queue merges when the gate reports, before GitHub closes the run. A rerun must not inherit an earlier gate.
    require(jobs['Required checks']['run_attempt'] == run.get('run_attempt'),
            'Required checks did not run in the current attempt')
    build = jobs['Web build']
    name = f"web-queue-{run['id']}-{build['run_attempt']}"
    webs = [a for a in api.rows(f"actions/runs/{run['id']}/artifacts", 'artifacts') if a['name'] == name]
    require(len(webs) == 1, 'No unique web build of the merge queue run')
    web = webs[0]
    require(build['started_at'] <= web['created_at'] <= build['completed_at'],
            'Web artifact not published by the green Web execution')
    web_files = dict(files(artifact_bytes(api, web, run['id'])))
    require(bool(web_files.get('index.html')) and bool(web_files.get('version.json')), 'Incomplete web build')
    return dict(repository=api.repository, tested_commit=sha, tree=tree, run=run['id'], attempt=run['run_attempt'],
                source_url=run['html_url'], web_id=web['id'], source_artifact_digest=web['digest']), web_files


def attempt(destination):
    started = time.monotonic()
    require(os.environ['GITHUB_EVENT_NAME'] in ('push', 'workflow_dispatch')
            and os.environ['GITHUB_REF'] == 'refs/heads/main', 'Delivery runs only from main CI')
    try:
        require(git('HEAD') == os.environ['GITHUB_SHA'], 'Main checkout does not match this run')
        receipt, web = verify(GitHub(os.environ['GITHUB_REPOSITORY']), os.environ['GITHUB_SHA'], git('HEAD^{tree}'))
        destination.mkdir(parents=True, exist_ok=False)
        for name, data in web.items():
            target = destination / name
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_bytes(data)
    except (AttributeError, KeyError, OSError, TypeError, ValueError, subprocess.SubprocessError, zipfile.BadZipFile) as error:
        message = f'Main delivery blocked after {time.monotonic() - started:.2f}s: {error}'
        with open(os.environ['GITHUB_STEP_SUMMARY'], 'a') as summary:
            summary.write(message + '\n')
        raise SystemExit(message) from error
    Path(os.environ['RUNNER_TEMP'], 'main-tree-receipt.json').write_text(json.dumps(receipt, sort_keys=True) + '\n')
    with open(os.environ['GITHUB_STEP_SUMMARY'], 'a') as summary:
        summary.write(f"Receipt verification and extraction: {time.monotonic() - started:.2f}s. "
                      f"Merge queue [CI]({receipt['source_url']}) tested commit `{receipt['tested_commit']}`, "
                      f"tree `{receipt['tree']}`, artifact `{receipt['web_id']}` digest `{receipt['source_artifact_digest']}`.\n")
    with open(os.environ['GITHUB_OUTPUT'], 'a') as output:
        output.write('reuse=true\n')


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('command', choices=['baseline', 'attempt'])
    parser.add_argument('path', nargs='?', type=Path)
    args = parser.parse_args()
    if args.command == 'baseline':
        baseline()
    elif args.path is None:
        parser.error('attempt requires an output path')
    else:
        attempt(args.path)
