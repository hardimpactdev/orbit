#!/usr/bin/env php
<?php

declare(strict_types=1);

require_once __DIR__.'/orbit-loop-contract.php';
require_once __DIR__.'/orbit-feedback-events.php';

const ARCHIVE_NAME_PATTERN = '/^(\d{4}-\d{2}-\d{2}-\d{6})-([a-z0-9-]+)$/';

$options = getopt('', ['sessions-dir:', 'check', 'write', 'help']);

if (array_key_exists('help', $options)) {
    fwrite(STDOUT, <<<'EOF'
        Usage:
          bin/orbit-session-index
              Print the generated session archive index JSON to stdout.
          bin/orbit-session-index --write
              Write .orbit/sessions/index.json from .orbit/sessions/YYYY-*/ archives.
          bin/orbit-session-index --check
              Fail when .orbit/sessions/index.json is missing or stale.
          bin/orbit-session-index --sessions-dir=<path>
              Use a non-default sessions directory. Intended for tests and archive hooks.
          bin/orbit-session-index --help
              Show this help text.

        The index is deterministic metadata for quick session mining before opening archives.
        Session archives remain trace evidence, not product authority.

        Candidate identity:
          Each indexed record carries candidate_commit from orbit-session-archive.json when
          that receipt field is an explicit 40-character lowercase commit id. Missing,
          invalid, or historical unknown receipt identity is stored as JSON null (unknown).
          The indexer never infers identity from Git, timestamps, later repair commits, or
          loop prose.

        Counts:
          record_count is the raw number of indexed archive records.
          unique_candidate_commit_count counts distinct valid explicit candidate_commit
          values only. Multiple unknown-identity records remain separate raw records and
          are never collapsed into a guessed candidate.

        Orphans:
          Archive-shaped directories that are empty, missing loop.md, or have an unsafe
          (symlink) loop.md are reported under orphans with a deterministic reason. They
          are not deleted, repaired, or indexed as records.

        Migration / backfill:
          Regenerating the index backfills candidate_commit only when a historical receipt
          already contains a valid explicit id. Absence remains unknown; history is never
          guessed. Schema version advances when the index contract changes; reading older
          archives stays compatible.
        EOF);

    exit(0);
}

$root = dirname(__DIR__);
$sessionsDir = isset($options['sessions-dir'])
    ? rtrim((string) $options['sessions-dir'], '/')
    : "{$root}/.orbit/sessions";
$indexPath = "{$sessionsDir}/index.json";
$index = build_session_index($sessionsDir);

if (array_key_exists('check', $options)) {
    if (! is_file($indexPath)) {
        fwrite(STDERR, "Session index is missing. Run `bin/orbit-session-index --write`.\n");

        exit(1);
    }

    $committed = file_get_contents($indexPath);

    if ($committed === false) {
        fwrite(STDERR, "Session index could not be read at {$indexPath}.\n");

        exit(1);
    }

    if ($committed !== to_json($index)) {
        fwrite(STDERR, "Session index is stale. Run `bin/orbit-session-index --write`.\n");

        exit(1);
    }

    fwrite(STDOUT, "Session index is up to date.\n");

    exit(0);
}

$json = to_json($index);

if (array_key_exists('write', $options)) {
    if (
        ! is_dir($sessionsDir)
        && ! mkdir($sessionsDir, permissions: 0o775, recursive: true)
        && ! is_dir($sessionsDir)
    ) {
        fwrite(STDERR, "Unable to create session index directory: {$sessionsDir}\n");

        exit(1);
    }

    if (file_put_contents($indexPath, $json) === false) {
        fwrite(STDERR, "Unable to write session index: {$indexPath}\n");

        exit(1);
    }

    fwrite(STDOUT, "Wrote {$indexPath}.\n");

    exit(0);
}

fwrite(STDOUT, $json);

/**
 * @return array<string, mixed>
 */
function build_session_index(string $sessionsDir): array
{
    $paths = glob("{$sessionsDir}/*", GLOB_ONLYDIR) ?: [];
    $records = [];
    $orphans = [];
    $uniqueCandidateCommits = [];

    sort($paths, SORT_STRING);

    foreach ($paths as $path) {
        $basename = basename($path);

        if (preg_match(ARCHIVE_NAME_PATTERN, $basename, $matches) !== 1) {
            continue;
        }

        $orphanReason = archive_orphan_reason($path);

        if ($orphanReason !== null) {
            $orphans[] = [
                'archive' => $basename,
                'reason' => $orphanReason,
            ];

            continue;
        }

        $record = parse_archive($path, $matches[1], $matches[2]);
        $records[] = $record;

        $candidateCommit = $record['candidate_commit'] ?? null;

        if (is_string($candidateCommit) && is_explicit_candidate_commit($candidateCommit)) {
            $uniqueCandidateCommits[$candidateCommit] = true;
        }
    }

    return [
        'schema_version' => 3,
        'generated_from' => '.orbit/sessions/YYYY-MM-DD-HHMMSS-<slug>',
        'record_count' => count($records),
        'unique_candidate_commit_count' => count($uniqueCandidateCommits),
        'orphan_count' => count($orphans),
        'records' => $records,
        'orphans' => $orphans,
    ];
}

function archive_orphan_reason(string $archiveDir): ?string
{
    $loopPath = "{$archiveDir}/loop.md";

    if (is_link($loopPath)) {
        return 'unsafe_loop_md';
    }

    if (is_file($loopPath)) {
        return null;
    }

    $entries = array_values(array_filter(
        scandir($archiveDir) ?: [],
        static fn (string $entry): bool => $entry !== '.' && $entry !== '..',
    ));

    if ($entries === []) {
        return 'empty';
    }

    return 'missing_loop_md';
}

function is_explicit_candidate_commit(string $value): bool
{
    return preg_match('/^[0-9a-f]{40}\z/', $value) === 1;
}

/**
 * @return string|null JSON null represents unknown historical/missing/invalid identity.
 */
function parse_candidate_commit(string $archiveDir): ?string
{
    $receiptPath = "{$archiveDir}/orbit-session-archive.json";

    if (! is_file($receiptPath) || is_link($receiptPath)) {
        return null;
    }

    $receipt = json_decode((string) file_get_contents($receiptPath), true);
    $candidateCommit = is_array($receipt) ? ($receipt['candidate_commit'] ?? null) : null;

    if (! is_string($candidateCommit) || ! is_explicit_candidate_commit($candidateCommit)) {
        return null;
    }

    return $candidateCommit;
}

/**
 * @return array<string, mixed>
 */
function parse_archive(string $archiveDir, string $timestamp, string $slug): array
{
    $loop = read_file_or_empty("{$archiveDir}/loop.md");
    $loopOutcomeRaw = parse_loop_outcome_raw($loop);
    $analyzerVerdict = parse_analyzer_verdict($loop);
    $legacy = [
        'loop_outcome' => $loopOutcomeRaw !== null ? normalize_loop_outcome($loopOutcomeRaw) : 'unknown',
        'loop_outcome_raw' => $loopOutcomeRaw,
        'required_verification' => parse_required_verification($loop),
        'fresh_analyzer_verdict' => $analyzerVerdict !== null
            ? normalize_analyzer_verdict($analyzerVerdict['value'], $analyzerVerdict['provenance'])
            : 'unknown',
        'fresh_analyzer_verdict_raw' => $analyzerVerdict['raw_value'] ?? null,
        'candidate_signals' => parse_candidate_signals($loop),
        'blockers_present' => blockers_present($loop),
        'token_usage' => token_usage($archiveDir),
        'capture_status' => capture_status($archiveDir),
    ];
    $compact = orbitLoopIsCompact($loop);
    $feedback = feedback_facets("{$archiveDir}/feedback.jsonl");

    $record = [
        'archive' => basename($archiveDir),
        'slug' => $slug,
        'timestamp' => $timestamp,
        'schema' => $compact ? 'compact-v1' : 'legacy',
        'archive_mode' => archive_mode($archiveDir),
        'candidate_commit' => parse_candidate_commit($archiveDir),
    ];

    if (! $compact) {
        $record['legacy'] = $legacy;

        if ($feedback['status'] !== 'absent') {
            $record['feedback_count'] = $feedback['event_count'];
            $record['feedback'] = $feedback;
        }

        return $record;
    }

    return array_merge($record, [
        'state' => orbitLoopStatusHead(orbitLoopLabel($loop, 'Status', 'State')),
        'review_status' => orbitLoopStatusHead(orbitLoopLabel($loop, 'Proof', 'Review')),
        'blast_radius_status' => orbitLoopStatusHead(orbitLoopLabel($loop, 'Proof', 'Blast radius')),
        'acceptance_status' => orbitLoopStatusHead(orbitLoopLabel($loop, 'Proof', 'Acceptance')),
        'acceptance_venue' => orbitLoopLabel($loop, 'Proof', 'Acceptance venues')
            ?? orbitLoopStatusHead(orbitLoopLabel($loop, 'Proof', 'Acceptance venue')),
        'feedback_count' => $feedback['event_count'],
        'feedback' => $feedback,
        'legacy' => null,
    ]);
}

/**
 * @return array{status: string, event_count: ?int, raw_count: ?int, promoted_count: ?int, waived_count: ?int, protection_failures: ?int}
 */
function feedback_facets(string $path): array
{
    $empty = [
        'status' => 'absent',
        'event_count' => 0,
        'raw_count' => 0,
        'promoted_count' => 0,
        'waived_count' => 0,
        'protection_failures' => 0,
    ];

    if (! is_file($path) || is_link($path)) {
        return $empty;
    }

    try {
        $events = orbitFeedbackRead($path);
    } catch (Throwable) {
        return [
            'status' => 'invalid',
            'event_count' => null,
            'raw_count' => null,
            'promoted_count' => null,
            'waived_count' => null,
            'protection_failures' => null,
        ];
    }

    $count = static fn (string $type): int => count(array_filter(
        $events,
        static fn (array $event): bool => $event['type'] === $type,
    ));

    return [
        'status' => 'valid',
        'event_count' => count($events),
        'raw_count' => $count('feedback.recorded'),
        'promoted_count' => $count('feedback.promoted'),
        'waived_count' => $count('feedback.waived'),
        'protection_failures' => $count('protection.failed'),
    ];
}

function archive_mode(string $archiveDir): string
{
    $receiptPath = "{$archiveDir}/orbit-session-archive.json";

    if (! is_file($receiptPath) || is_link($receiptPath)) {
        return 'legacy';
    }

    $receipt = json_decode((string) file_get_contents($receiptPath), true);
    $mode = is_array($receipt) ? $receipt['archive_mode'] ?? null : null;

    return in_array($mode, ['compact', 'full'], true) ? $mode : 'legacy';
}

/**
 * @return array<string, string>
 */
function parse_required_verification(string $loop): array
{
    $section = markdown_section($loop, 'Final Distillation');

    if (
        $section === null
        || ! preg_match('/^- Required verification:\s*\R(.*?)(?=^- [A-Z`].*?:|\z)/ms', $section, $matches)
    ) {
        return [];
    }

    $rows = [];

    foreach (preg_split('/\R/', trim($matches[1])) ?: [] as $line) {
        $row = parse_markdown_label_row($line);

        if ($row === null) {
            continue;
        }

        $rows[$row[0]] = verification_status($row[1]);
    }

    return $rows;
}

function parse_loop_outcome_raw(string $loop): ?string
{
    $section = markdown_section($loop, 'Final Distillation');

    if ($section === null) {
        return null;
    }

    $value = extract_same_line_label_value($section, 'Loop outcome');

    if ($value !== null) {
        return $value;
    }

    if (! preg_match('/^- Loop outcome:[ \t]*\R[ \t]*-[ \t]*(.+)$/m', $section, $matches)) {
        return null;
    }

    return trim($matches[1]);
}

/**
 * @return array{value: string, raw_value: string, provenance: string}|null
 */
function parse_analyzer_verdict(string $loop): ?array
{
    $section = markdown_section($loop, 'Final Distillation');

    if ($section === null) {
        return null;
    }

    $lines = preg_split('/\R/', $section) ?: [];
    $sameLineValue = null;
    $insideFreshAnalyzer = false;

    foreach ($lines as $line) {
        if (str_starts_with($line, '- ')) {
            $insideFreshAnalyzer = false;
            $row = parse_markdown_label_row($line);

            if ($row === null || strcasecmp($row[0], 'Fresh analyzer') !== 0) {
                continue;
            }

            $insideFreshAnalyzer = true;
            $value = trim($row[1]);

            if ($value !== '') {
                $sameLineValue = $value;
            }

            continue;
        }

        if (! $insideFreshAnalyzer) {
            continue;
        }

        if (preg_match('/^ {2}-[ \t]+(.+)$/', $line, $matches) !== 1) {
            continue;
        }

        $row = parse_markdown_label_row('- '.$matches[1]);

        if ($row !== null && strcasecmp($row[0], 'Verdict') === 0 && trim($row[1]) !== '') {
            $value = trim($row[1]);
            $rawValue = $value;

            if (
                $sameLineValue !== null
                && normalize_analyzer_verdict($sameLineValue, 'fresh-analyzer-row') === normalize_analyzer_verdict(
                    $value,
                    'explicit-verdict-row',
                )
            ) {
                $rawValue = $sameLineValue;
            }

            return [
                'value' => $value,
                'raw_value' => $rawValue,
                'provenance' => 'explicit-verdict-row',
            ];
        }
    }

    if ($sameLineValue === null) {
        return null;
    }

    return [
        'value' => $sameLineValue,
        'raw_value' => $sameLineValue,
        'provenance' => 'fresh-analyzer-row',
    ];
}

/**
 * @return array{total: int, classifications: object}
 */
function parse_candidate_signals(string $loop): array
{
    $section = markdown_section($loop, 'Final Distillation');
    $classifications = [];
    $total = 0;

    if (
        $section === null
        || ! preg_match('/^- Candidate signals:\s*\R(.*?)(?=^- [A-Z].*?:|\z)/ms', $section, $matches)
    ) {
        return [
            'total' => 0,
            'classifications' => (object) [],
        ];
    }

    foreach (preg_split('/\R/', trim($matches[1])) ?: [] as $line) {
        if (! preg_match('/^\s*-\s*(.+)$/', $line, $signal)) {
            continue;
        }

        $value = trim($signal[1]);

        if ($value === '' || strcasecmp($value, 'none') === 0) {
            continue;
        }

        $total++;

        if (preg_match('/\s->\s([a-z-]+)\s->\s/i', $value, $classification) !== 1) {
            $classifications['unknown'] = ($classifications['unknown'] ?? 0) + 1;

            continue;
        }

        $key = strtolower($classification[1]);
        $classifications[$key] = ($classifications[$key] ?? 0) + 1;
    }

    ksort($classifications);

    return [
        'total' => $total,
        'classifications' => (object) $classifications,
    ];
}

function blockers_present(string $loop): bool
{
    $section = markdown_section($loop, 'Blockers');

    if ($section === null) {
        return false;
    }

    $entries = [];

    foreach (preg_split('/\R/', $section) ?: [] as $line) {
        if (trim($line) === '') {
            continue;
        }

        if (preg_match('/^-[ \t]*(.+)$/', $line, $matches)) {
            $entries[] = $matches[1];

            continue;
        }

        if ($entries === []) {
            $entries[] = trim($line);

            continue;
        }

        $lastEntry = array_key_last($entries);
        $entries[$lastEntry] .= ' '.trim($line);
    }

    foreach ($entries as $entry) {
        $text = strtolower(normalize_whitespace($entry));
        $text = rtrim($text, '.,;:!?');

        if (
            $text === 'none'
            || $text === 'none currently'
            || $text === 'no blocker currently'
            || preg_match('/^no blockers?$/', $text) === 1
            || preg_match('/^no blocker for solo todo #\d+$/', $text) === 1
            || preg_match(
                '/^no active (?:correctness|implementation(?: or verification)?) blocker remains(?:\. the earlier blocker is resolved)?$/',
                $text,
            ) === 1
            || preg_match('/^the (?:previous analyzer evidence|earlier) blocker is resolved$/', $text) === 1
        ) {
            continue;
        }

        return true;
    }

    return false;
}

/**
 * @return array<string, int|string|null>
 */
function token_usage(string $archiveDir): array
{
    $keys = [
        'input_tokens',
        'output_tokens',
        'total_tokens',
        'reasoning_tokens',
    ];
    $nullTotals = [
        'input_tokens' => null,
        'output_tokens' => null,
        'total_tokens' => null,
        'reasoning_tokens' => null,
    ];
    $totals = [
        'input_tokens' => 0,
        'output_tokens' => 0,
        'total_tokens' => 0,
        'reasoning_tokens' => 0,
    ];
    $complete = array_fill_keys($keys, true);
    $found = false;
    $partial = false;
    $inconsistent = false;

    foreach (glob("{$archiveDir}/agent-sessions/*/*/usage.json") ?: [] as $path) {
        $usage = json_decode(read_file_or_empty($path), true);

        if (! is_array($usage)) {
            return [
                'status' => 'invalid',
                ...$nullTotals,
            ];
        }

        $found = true;

        foreach ($keys as $key) {
            if (! array_key_exists($key, $usage)) {
                $complete[$key] = false;
                $partial = true;

                continue;
            }

            if (! is_int($usage[$key]) || $usage[$key] < 0) {
                return [
                    'status' => 'invalid',
                    ...$nullTotals,
                ];
            }

            $totals[$key] += $usage[$key];
        }

        if (
            isset($usage['input_tokens'], $usage['output_tokens'], $usage['total_tokens'])
            && $usage['total_tokens'] !== ($usage['input_tokens'] + $usage['output_tokens'])
        ) {
            $inconsistent = true;
        }
    }

    if (! $found) {
        return [
            'status' => 'unavailable',
            ...$nullTotals,
        ];
    }

    $status = match (true) {
        $inconsistent => 'inconsistent',
        $partial => 'partial',
        default => 'consistent',
    };

    return [
        'status' => $status,
        'input_tokens' => $complete['input_tokens'] ? $totals['input_tokens'] : null,
        'output_tokens' => $complete['output_tokens'] ? $totals['output_tokens'] : null,
        'total_tokens' => $partial || ! $complete['total_tokens'] ? null : $totals['total_tokens'],
        'reasoning_tokens' => $complete['reasoning_tokens'] ? $totals['reasoning_tokens'] : null,
    ];
}

function capture_status(string $archiveDir): string
{
    $agentSessionsDir = "{$archiveDir}/agent-sessions";

    if (! is_dir($agentSessionsDir)) {
        return 'legacy';
    }

    $sessionManifests = glob("{$agentSessionsDir}/*/*/manifest.json") ?: [];

    if ($sessionManifests === []) {
        $aggregate = "{$agentSessionsDir}/manifest.json";

        if (! is_file($aggregate)) {
            return 'legacy';
        }

        $manifest = json_decode(read_file_or_empty($aggregate));

        if (
            ! $manifest instanceof stdClass
            || ! property_exists($manifest, 'sessions')
            || ! is_array($manifest->sessions)
        ) {
            return 'invalid';
        }

        $sessions = $manifest->sessions;

        return $sessions === [] ? 'empty' : 'partial';
    }

    foreach ($sessionManifests as $path) {
        $manifest = json_decode(read_file_or_empty($path), true);

        if (! is_array($manifest) || ($manifest['status'] ?? null) !== 'ok') {
            return 'partial';
        }
    }

    return 'ok';
}

function verification_status(string $value): string
{
    $value = strtolower(trim($value));

    foreach (['passed', 'blocked', 'not applicable', 'failed', 'unknown'] as $status) {
        if (str_starts_with($value, $status)) {
            return $status;
        }
    }

    return 'unknown';
}

/**
 * @return array{0: string, 1: string}|null
 */
function parse_markdown_label_row(string $line): ?array
{
    if (! preg_match('/^\s*-\s*(.+)$/', $line, $matches)) {
        return null;
    }

    $text = $matches[1];
    $inCode = false;
    $length = strlen($text);

    for ($index = 0; $index < $length; $index++) {
        if ($text[$index] === '`') {
            $inCode = ! $inCode;

            continue;
        }

        if ($text[$index] !== ':' || $inCode) {
            continue;
        }

        return [
            trim(substr($text, 0, $index)),
            trim(substr($text, $index + 1)),
        ];
    }

    return null;
}

function extract_same_line_label_value(string $section, string $label): ?string
{
    foreach (preg_split('/\R/', $section) ?: [] as $line) {
        if (! str_starts_with($line, '- ')) {
            continue;
        }

        $row = parse_markdown_label_row($line);

        if ($row === null || strcasecmp($row[0], $label) !== 0) {
            continue;
        }

        $value = trim($row[1]);

        if ($value !== '' && ! preg_match('/^[ \t]*-[ \t]/', $value)) {
            return $value;
        }
    }

    return null;
}

function markdown_section(string $contents, string $heading): ?string
{
    $pattern = '/^##\s+'.preg_quote($heading, '/').'\s*\R(.*?)(?=^##\s+|\z)/ms';

    if (! preg_match($pattern, $contents, $matches)) {
        return null;
    }

    return trim($matches[1], "\r\n");
}

function read_file_or_empty(string $path): string
{
    if (! is_file($path)) {
        return '';
    }

    return (string) file_get_contents($path);
}

function normalize_value(string $value): string
{
    $value = trim($value);

    if ($value === '' || str_contains($value, '<')) {
        return 'unknown';
    }

    return normalize_whitespace($value);
}

function normalize_whitespace(string $value): string
{
    return trim((string) preg_replace('/\s+/u', ' ', $value));
}

function normalize_loop_outcome(string $value): string
{
    $value = trim($value);

    if ($value === '' || str_contains($value, '<')) {
        return 'unknown';
    }

    $normalized = normalize_whitespace(rtrim($value, '.,;:!?'));

    if (preg_match(
        '/^`?(complete \+ loop improvement|complete|blocked)`?(?=$|[ \t]+-[ \t]+)/i',
        $normalized,
        $matches,
    )) {
        return strtolower($matches[1]);
    }

    return $normalized;
}

function normalize_analyzer_verdict(string $value, string $provenance): string
{
    $value = trim($value);

    if ($value === '' || str_contains($value, '<')) {
        return 'unknown';
    }

    $verdictCandidate = $value;

    if (preg_match('/^`?Verdict:\s*/i', $verdictCandidate, $matches) === 1) {
        $verdictCandidate = substr($verdictCandidate, strlen($matches[0]));
    }

    if (preg_match(
        '/^`?(not used|not applicable|skipped|deferred)`?(?=$|[.,;:!?]|[ \t]+(?:-[ \t]+|because\b|for\b))/i',
        $verdictCandidate,
        $matches,
    )) {
        return strtolower($matches[1]) === 'deferred' ? 'deferred' : 'not used';
    }

    if (preg_match('/^`?(yes|no)(?:`|[.,;:!?])*\s*$/i', $verdictCandidate, $matches)) {
        return strtolower($matches[1]);
    }

    if (
        $provenance === 'explicit-verdict-row'
        && preg_match('/^`?(yes|no)`?(?=[ \t]*(?:;|-[ \t]+))/i', $verdictCandidate, $matches) === 1
    ) {
        return strtolower($matches[1]);
    }

    if (preg_match(
        '/^`?(proper|flawed|blocked-by-missing-evidence|blocked by missing evidence)`?(?=$|[.,;:!?]|[ \t]+(?:-[ \t]+|because\b|for\b))/i',
        $verdictCandidate,
        $matches,
    )) {
        $normalizedVerdict = strtolower($matches[1]);

        if ($normalizedVerdict === 'blocked by missing evidence') {
            $normalizedVerdict = 'blocked-by-missing-evidence';
        }

        return $normalizedVerdict;
    }

    return normalize_value($value);
}

/**
 * @param array<string, mixed> $value
 */
function to_json(array $value): string
{
    return json_encode($value, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR).PHP_EOL;
}
