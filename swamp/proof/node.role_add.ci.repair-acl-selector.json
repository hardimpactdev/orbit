{
  "kind": "node.role_add.ci.repair-acl-selector",
  "workflow": "operation-node-role-add",
  "topology": "minimal",
  "clean": false,
  "budget_seconds": 1800,
  "queue_timeout_seconds": 30,
  "before_gateway": [],
  "request": {
    "method": "POST",
    "path": "nodes/${node.peer}/roles",
    "body": {
      "role": "ci-runner",
      "converge_existing": true
    }
  },
  "expect": {
    "status": "succeeded"
  },
  "phases": [
    {
      "name": "Apply role prerequisites",
      "job": "prerequisites",
      "step": "Apply role prerequisites",
      "budget_seconds": 900
    },
    {
      "name": "Apply the role on the Node",
      "job": "node",
      "step": "Apply the role on the Node",
      "budget_seconds": 900
    },
    {
      "name": "Publish role sites",
      "job": "publication",
      "step": "Publish role sites",
      "budget_seconds": 180
    },
    {
      "name": "Open the firewall",
      "job": "firewall",
      "step": "Open the firewall",
      "budget_seconds": 120
    },
    {
      "name": "Check the role",
      "job": "role",
      "step": "Check the role",
      "budget_seconds": 60
    }
  ],
  "parity": [
    "swamp/proof/node.role_add/parity.py",
    "peer",
    "ci-runner"
  ],
  "prepare": [],
  "before_node": {
    "peer": [
      [
        "python3",
        "-c",
        "import json,subprocess; state=json.loads(subprocess.check_output(['incus','query','/1.0/network-acls/orbit-ci-egress'])); state['egress'][0]['source']='192.0.2.1'; subprocess.run(['incus','network','acl','edit','orbit-ci-egress'],input=json.dumps(state).encode(),check=True)"
      ]
    ]
  }
}
