{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "nckrtl/orbit-php-sdk",
    "description": "PHP SDK for the Orbit gateway API.",
    "keywords": ["infrastructure", "orbit", "saloon", "sdk"],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.5",
        "guzzlehttp/psr7": "^2.13 || ^3.1",
        "psr/http-message": "^2.0",
        "saloonphp/saloon": "^4.0"
    },
    "require-dev": {
        "laravel/pao": "^1.1",
        "laravel/pint": "^1.32",
        "laravel/vet": "^0.2.1",
        "nckrtl/pestphp-monorepo": "dev-main",
        "phpstan/phpstan": "^2.2.13",
        "phpunit/phpunit": "^13.0",
        "rector/rector": "^2.3",
        "spaze/phpstan-disallowed-calls": "^4.14"
    },
    "autoload": {
        "psr-4": {
            "Orbit\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Orbit\\Sdk\\Tests\\": "tests/",
            "Orbit\\PHPStan\\": "../../tools/phpstan/"
        }
    },
    "scripts": {
        "test:affected": "../../bin/pest-plain vendor/bin/pest --parallel --processes=$(../../bin/check-processes) --tia --compact --colors=never",
        "analyse": "vendor/bin/phpstan analyse --no-progress --memory-limit=1G",
        "check": [
            "@guidance:check",
            "@analyse",
            "@rector",
            "@format:check"
        ],
        "format": "vendor/bin/pint --parallel --max-processes=$(../../bin/check-processes)",
        "format:check": "../../bin/quality-scope pint vendor/bin/pint --test --parallel --max-processes=$(../../bin/check-processes)",
        "guidance:check": "../../bin/guidance-check",
        "lint": "@format:check",
        "rector": "../../bin/quality-scope rector vendor/bin/rector process --dry-run --no-progress-bar --clear-cache",
        "test": "../../bin/pest-plain vendor/bin/pest --parallel --processes=$(../../bin/check-processes) --tia --compact --colors=never"
    },
    "config": {
        "allow-plugins": {
            "laravel/vet": true,
            "pestphp/pest-plugin": true,
            "rector/rector": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "process-timeout": 0,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
