{
  "workflow": "operation-node-role-remove-direct",
  "topology": "minimal",
  "clean": true,
  "budget_seconds": 1800,
  "queue_timeout_seconds": 30,
  "prepare": [],
  "phases": [
    {
      "name": "Read CI guests",
      "job": "phase_0",
      "step": "Read CI guests-0",
      "budget_seconds": 70
    },
    {
      "name": "Confirm role removal",
      "job": "remove",
      "step": "Confirm role removal",
      "budget_seconds": 20
    }
  ],
  "kind": "node.role_remove.ci",
  "before_gateway": [
    [
      "sh",
      "-c",
      "cd apps/gateway && printf '%s' '{\"roles\":{\"${node.metrics}\":[\"ci-runner\"]}}' | php ../../tools/swamp-proof-guest/gateway.php fixture"
    ]
  ],
  "before_node": {
    "metrics": [
      [
        "sh",
        "-c",
        "set -eu; mkdir -p /srv/proof-retained; echo keep > /srv/proof-retained/user-data; if ! command -v incus >/dev/null; then apt-get update; apt-get install -y incus; fi; incus project create orbit-ci"
      ]
    ]
  },
  "request": {
    "method": "DELETE",
    "path": "nodes/${node.metrics}/roles/ci-runner",
    "body": {
      "force": true
    }
  },
  "expect": {
    "status": "succeeded"
  },
  "parity": [
    "swamp/proof/node.remove/parity.py",
    "ci"
  ]
}
