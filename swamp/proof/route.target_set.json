{
  "kind": "route.target_set",
  "workflow": "operation-route-target-set",
  "topology": "minimal",
  "budget_seconds": 1800,
  "queue_timeout_seconds": 30,
  "prepare": [
    {
      "method": "POST",
      "path": "projects",
      "operation": false,
      "bind": "project",
      "body": {
        "slug": "proof-target",
        "name": "Proof target",
        "type": "monorepo",
        "root": "public",
        "repository_url": "https://github.com/laravel/laravel.git",
        "default_branch": "13.x"
      }
    },
    {
      "method": "POST",
      "path": "instances",
      "bind": "old",
      "body": {
        "project_id": "${project.id}",
        "node_id": "${node.target}",
        "name": "o-${proof.run}"
      }
    },
    {
      "method": "POST",
      "path": "routes",
      "bind": "route",
      "body": {
        "instance_id": "${old.id}",
        "domain": "t-${proof.run}.proof.test"
      }
    },
    {
      "method": "POST",
      "path": "instances",
      "bind": "new",
      "body": {
        "project_id": "${project.id}",
        "node_id": "${node.target}",
        "name": "n-${proof.run}"
      }
    }
  ],
  "after_prepare": [
    [
      "sh",
      "-c",
      "printf '%s' \"$1\" | runuser -u orbit -- env -C apps/gateway php ../../tools/swamp-proof-guest/gateway.php fixture",
      "sh",
      "{\"routes\": [{\"id\": \"${route.id}\", \"attributes\": {\"status\": \"failed\", \"sites_published\": true, \"failed_step\": \"proof\", \"error_code\": \"route.probe_failed\"}}], \"instance_updates\": [{\"id\": \"${old.id}\", \"attributes\": {\"status\": \"source_resolved\"}}]}"
    ]
  ],
  "request": {
    "method": "PUT",
    "path": "routes/${route.id}/target",
    "body": {
      "instance_id": "${new.id}"
    }
  },
  "expect": {
    "status": "succeeded"
  },
  "phases": [
    {
      "name": "sign",
      "job": "update",
      "step": "Sign the CSRs-0",
      "budget_seconds": 60
    },
    {
      "name": "publish",
      "job": "update",
      "step": "Install cert, publish site-0",
      "budget_seconds": 120
    }
  ],
  "parity": "swamp/proof/route.target_set/parity.py"
}
