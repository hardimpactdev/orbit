#!/usr/bin/env sh

set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
version_file="$repo_root/VERSION"

if [ ! -f "$version_file" ]; then
    printf 'orbit-version: VERSION file not found at %s\n' "$version_file" >&2
    exit 1
fi

version=$(tr -d '[:space:]' < "$version_file")

if ! printf '%s\n' "$version" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$'; then
    printf 'orbit-version: VERSION must be semver without v prefix, got [%s]\n' "$version" >&2
    exit 1
fi

printf '%s\n' "$version"
