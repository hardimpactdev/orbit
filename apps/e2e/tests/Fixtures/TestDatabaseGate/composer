#!/usr/bin/env php
<?php

declare(strict_types=1);

$command = $argv[1] ?? '';
$gateway = str_ends_with(str_replace('\\', '/', getcwd() ?: ''), '/apps/gateway');

if ($gateway && $command === 'check' && getenv('ORBIT_GATEWAY_ACTUAL_CHECK') === '1') {
    $composer = getenv('ORBIT_REAL_COMPOSER');
    $source = getenv('ORBIT_GATEWAY_SOURCE');

    if (! is_string($composer) || ! is_string($source)) {
        fwrite(STDERR, "The actual Gateway check fixture is incomplete.\n");

        exit(2);
    }

    foreach ([
        'COLLISION_PRINTER',
        'PARATEST',
        'PEST_TIA',
        'PEST_TIA_BASELINED',
        'PEST_TIA_FILTERED',
        'PEST_TIA_LOCALLY',
        'TEST_TOKEN',
        'UNIQUE_TEST_TOKEN',
    ] as $name) {
        putenv($name);
        unset($_ENV[$name], $_SERVER[$name]);
    }

    chdir($source);
    // Keep the real renderer, then trigger lazy migrations so the sentinel assertion exercises database isolation.
    passthru(escapeshellarg($composer).' guidance:check -- --filter='.escapeshellarg('regenerates strict guidance'), $exitCode);

    if ($exitCode !== 0) {
        exit($exitCode);
    }

    passthru(escapeshellarg(PHP_BINARY).' vendor/bin/pest --no-tia --colors=never tests/Feature/Configuration/FeatureDatabaseTest.php', $exitCode);

    exit($exitCode);
}

// The Gateway guidance tests that composer check runs refuse an unsafe database connection.
if ($gateway && $command === 'check' && getenv('ORBIT_GATEWAY_GATE_REFUSAL') === '1') {
    fwrite(STDERR, "Gateway tests refused an unsafe database connection.\n");

    exit(23);
}

exit(0);
