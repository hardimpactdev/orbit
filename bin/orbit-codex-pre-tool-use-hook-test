#!/usr/bin/env bash

set -Eeuo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." >/dev/null 2>&1 && pwd)"
HOOK="$ROOT/bin/orbit-codex-pre-tool-use-hook"
GIT_PROCESS_MODULE="$ROOT/bin/orbit-git-process.php"
COMMAND_CLASSIFY_MODULE="$ROOT/bin/orbit-command-classify.php"
ARCHIVE_RECEIPT_MODULE="$ROOT/bin/orbit-session-archive-receipt.php"
CAPTURE_HEALTH_MODULE="$ROOT/bin/orbit-session-capture-health.php"
ACCEPTANCE_CONTRACT_MODULE="$ROOT/bin/orbit-feature-acceptance-contract.php"
PROOF_REQUIREMENTS_MODULE="$ROOT/bin/orbit-feature-proof-requirements.php"
QUALITY_ARTIFACTS_MODULE="$ROOT/bin/orbit-quality-gate-artifacts.php"
CHECK="$ROOT/bin/orbit-feature-finalization-check"
TMP="$(mktemp -d "${TMPDIR:-/tmp}/orbit-codex-hook-test.XXXXXX")"
OUT="$TMP/hook.out"
ERR="$TMP/hook.err"
EXPECTED_OUT="$TMP/expected.out"
EXPECTED_ERR="$TMP/expected.err"

cleanup() {
    rm -rf "$TMP"
}

trap cleanup EXIT

fail() {
    printf 'FAIL: %s\n' "$*" >&2
    exit 1
}

run_hook() {
    local repo="$1"
    local command="$2"

    printf '{"tool_input":{"command":"%s"}}' "$command" | (cd "$repo" && "$HOOK") >"$OUT" 2>"$ERR"
}

run_hook_argv() {
    local repo="$1"
    local command="$2"

    (cd "$repo" && "$HOOK" "$command") >"$OUT" 2>"$ERR"
}

run_lint() {
    local repo="$1"
    local path="$2"

    (cd "$repo" && "$HOOK" --lint "$path") >"$OUT" 2>"$ERR"
}

run_check() {
    local repo="$1"
    shift

    (cd "$repo" && "$CHECK" "$@") >"$OUT" 2>"$ERR"
}

expect_pass() {
    local repo="$1"
    local command="$2"

    if ! run_hook "$repo" "$command"; then
        cat "$ERR" >&2
        fail "expected pass for [$command]"
    fi
}

expect_block() {
    local repo="$1"
    local command="$2"
    local status=0

    run_hook "$repo" "$command" || status=$?

    if [ "$status" -eq 0 ]; then
        fail "expected block for [$command]"
    fi

    [ "$status" -eq 2 ] || fail "expected block exit code 2 for [$command], got $status"

    grep -q 'Orbit finalization gate blocked' "$ERR" \
        || fail "block message missing for [$command]"
}

expect_e2e_block() {
    local repo="$1"
    local command="$2"
    local status=0

    run_hook "$repo" "$command" || status=$?

    if [ "$status" -eq 0 ]; then
        fail "expected e2e block for [$command]"
    fi

    [ "$status" -eq 2 ] || fail "expected e2e block exit code 2 for [$command], got $status"

    grep -q 'Orbit E2E guard blocked' "$ERR" \
        || fail "dedicated e2e block message missing for [$command]"

    grep -q 'human-only' "$ERR" \
        || fail "human-only teaching missing for [$command]"

    if grep -q 'Orbit finalization gate blocked' "$ERR"; then
        fail "e2e block for [$command] must use the dedicated e2e message, not the finalization gate message"
    fi
}

expect_check_block() {
    local repo="$1"
    shift
    local status=0

    run_check "$repo" "$@" || status=$?

    if [ "$status" -eq 0 ]; then
        fail "expected explicit check block for [$*]"
    fi

    [ "$status" -eq 2 ] || fail "expected explicit check exit code 2 for [$*], got $status"

    grep -q 'Orbit finalization gate blocked' "$ERR" \
        || fail "explicit check block message missing for [$*]"
}

expect_empty_file() {
    local path="$1"
    local label="$2"

    [ ! -s "$path" ] || {
        cat "$path" >&2
        fail "$label must be empty"
    }
}

expect_exact_file() {
    local expected="$1"
    local actual="$2"
    local label="$3"

    if ! cmp -s "$expected" "$actual"; then
        diff -u "$expected" "$actual" >&2 || true
        fail "$label changed"
    fi
}

write_expected_finalization_block() {
    local subject="$1"
    local reason="$2"

    cat >"$EXPECTED_ERR" <<EOF
FINALIZATION: BLOCKED $reason

Orbit finalization gate blocked this merge/cleanup boundary.

Subject: $subject
Reason: $reason

Before landing, complete the compact \`.orbit/loop.md\` Proof and Status: exact
diff-routed verification, one independent review PASS, accepted venue and
actor, exact accepted feature HEAD, and the actual current main tip. Commit,
ignore, or remove every nonignored worktree file so the accepted HEAD is the
tested surface. Resolve any merge-preview conflict and repeat affected proof
and acceptance.

Before cleanup, run \`bin/orbit-session-archive\`. A compact archive requires
\`loop.md\` plus its schema-v2 or schema-v3 receipt; historical/full archives retain their
manifest compatibility.

Dry-run the packet shape first with:
bin/orbit-feature-finalization-check --lint <worktree>/.orbit/loop.md

Then rerun the same git command.
EOF
}

expect_exact_e2e_block() {
    local repo="$1"
    local command='composer test:e2e'
    local status=0

    run_hook_argv "$repo" "$command" || status=$?

    [ "$status" -eq 2 ] || fail "expected exact E2E block exit code 2, got $status"
    expect_empty_file "$OUT" 'E2E block stdout'

    cat >"$EXPECTED_ERR" <<'EOF'
Orbit E2E guard blocked `composer test:e2e`.

The `composer test:e2e*` lanes are human-only: they run only when the
user personally decides to type the Composer command in a shell they
operate directly. Agents never run, delegate, background, schedule,
hook, script, or trigger these lanes, and never hand them off as a
feature-completion step. For integrated runtime behavior, use retained
topology proof per `HARNESS.md` Acceptance Venues; existing E2E
artifacts may be read and triaged without execution.

Blocked command: composer test:e2e
EOF
    expect_exact_file "$EXPECTED_ERR" "$ERR" 'E2E block stderr'
}

expect_exact_boundary_block() {
    local repo="$1"
    local command="$2"
    local subject="$3"
    local reason="$4"
    local status=0

    run_hook_argv "$repo" "$command" || status=$?

    [ "$status" -eq 2 ] || fail "expected exact boundary block exit code 2 for [$command], got $status"
    expect_empty_file "$OUT" "boundary block stdout for [$command]"
    write_expected_finalization_block "$subject" "$reason"
    expect_exact_file "$EXPECTED_ERR" "$ERR" "boundary block stderr for [$command]"
}

expect_exact_lint() {
    local repo="$1"
    local path="$2"
    local expected_status="$3"
    local expected_output="$4"
    local status=0

    run_lint "$repo" "$path" || status=$?

    [ "$status" -eq "$expected_status" ] \
        || fail "expected lint exit code $expected_status for [$path], got $status"
    printf '%s\n' "$expected_output" >"$EXPECTED_OUT"
    expect_exact_file "$EXPECTED_OUT" "$OUT" "lint stdout for [$path]"
    expect_empty_file "$ERR" "lint stderr for [$path]"
}

expect_git_process_module_boundary() {
    local function_name

    [ -f "$GIT_PROCESS_MODULE" ] || fail 'git/process module is missing'
    grep -Fq "require_once __DIR__.'/orbit-git-process.php';" "$HOOK" \
        || fail 'hook does not load the git/process module'
    php -r 'ob_start(); require_once $argv[1]; require_once $argv[1]; exit(ob_get_clean() === "" ? 0 : 1);' \
        "$GIT_PROCESS_MODULE" \
        || fail 'git/process module emitted output while loading'

    for function_name in \
        git_root \
        local_branch_exists \
        worktree_for_branch \
        branch_for_worktree \
        worktrees \
        absolute_path \
        run_git \
        run_process \
        run_process_with_timeout
    do
        grep -q "^function $function_name(" "$GIT_PROCESS_MODULE" \
            || fail "$function_name is missing from the git/process module"

        if grep -q "^function $function_name(" "$HOOK"; then
            fail "$function_name remains in the hook entry point"
        fi
    done
}

