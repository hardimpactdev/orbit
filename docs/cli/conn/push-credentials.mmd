sequenceDiagram
  %% Conn push credentials (docs/reference/conn.md#apns-credentials): store an Apple APNs .p8 private key from stdin into Gateway encrypted settings, or inspect whether credentials are configured without ever returning the key.
  %% status: shipped
  %% command: orbit conn:push-credentials:set --key-id <id> --team-id <id> · orbit conn:push-credentials:show
  %% kind: conn.push_credentials
  autonumber
  %% lane CLI icon=terminal pill=caller tone=gray
  %% lane GW icon=gateway pill=control tone=blue
  participant CLI as CLI<br/>operator
  participant GW as Gateway<br/>Conn push store
  alt store credentials
    %% path: set
    Note over CLI: Validate IDs<br/>Read .p8 from stdin
    %%> Refuses a TTY, empty input, or keys over 16 KiB before calling the Gateway.
    CLI->>GW: PUT push-credentials<br/>key_id · team_id · key
    %%> Sends PUT /api/v1/conn/push-credentials with the piped EC P-256 PEM.
    Note over GW: Check push flag<br/>Validate EC PEM
    %%> Requires conn.push, Gateway access, and a valid EC P-256 private key; redacts private_key from Activity.
    Note over GW: Encrypt key in settings<br/>Clear cached JWT
    %%> Stores private_key via SettingValueProtection::Secret and clears any cached ES256 JWT.
    GW-->>CLI: 200 · configured<br/>key_id · team_id
  else show status
    %% path: show
    CLI->>GW: GET push-credentials
    %%> Sends GET /api/v1/conn/push-credentials.
    Note over GW: Check push flag<br/>Read status only
    %%> Requires conn.push and Gateway access; never returns private_key.
    GW-->>CLI: 200 · configured<br/>key_id · team_id
  end
