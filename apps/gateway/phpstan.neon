includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/spaze/phpstan-disallowed-calls/extension.neon
    - ../../tools/phpstan/orbit-rules.neon
    - ../../tools/phpstan/parallel.php

parameters:
    level: 9
    paths:
        - app
        - routes
        - database/migrations
        - extensions
        - ../../tools/phpstan
        - ../../tools/boost
    databaseMigrationsPath:
        - database/migrations
        - vendor/nckrtl/horizon-new-dawn/database/migrations
    configDirectories:
        - config
        - extensions/*/config
    tmpDir: vendor/phpstan/cache
