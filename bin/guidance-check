#!/usr/bin/env bash

# Guidance must not reuse Blade files owned by another gate user.
set -euo pipefail

runtime=$(mktemp -d "${TMPDIR:-/tmp}/orbit-guidance.XXXXXXXXXX")
trap 'rm -rf -- "$runtime"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# Explicit modes also avoid sticky directories from alternative mkdir tools.
mkdir -m 700 "$runtime/views"
export VIEW_COMPILED_PATH="$runtime/views"

vendor/bin/pest --configuration=phpunit.guidance.xml --compact "$@"
