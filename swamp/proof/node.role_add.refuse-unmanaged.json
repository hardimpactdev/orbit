{
  "kind": "node.role_add.refuse-unmanaged",
  "workflow": "operation-node-role-add",
  "topology": "minimal",
  "clean": true,
  "budget_seconds": 30,
  "queue_timeout_seconds": 30,
  "before_gateway": [
    ["runuser", "-u", "orbit", "--", "php", "swamp/proof/node.role_add/prepare.php", "${node.target}", "precondition", "{\"ssh_host_fingerprint\": null}"],
    ["runuser", "-u", "orbit", "--", "php", "swamp/proof/node.role_add/prepare.php", "0", "snapshot"]
  ],
  "request": {"method": "POST", "path": "nodes/${node.target}/roles", "body": {"role": "ci-runner"}},
  "expect": {"http_status": 422, "error_code": "operation.kind_unavailable"},
  "phases": [],
  "parity": "swamp/proof/node.role_add/refusal.py"
}
