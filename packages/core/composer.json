{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "hardimpactdev/orbit-core",
    "description": "Shared Orbit core contracts and helpers.",
    "keywords": [
        "laravel",
        "orbit"
    ],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.4",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.29",
        "pestphp/pest": "^4.6"
    },
    "autoload": {
        "psr-4": {
            "Hardimpactdev\\OrbitCore\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hardimpactdev\\OrbitCore\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "format": "vendor/bin/pint",
        "test": "vendor/bin/pest --compact"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Hardimpactdev\\OrbitCore\\OrbitCoreServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
