includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/spaze/phpstan-disallowed-calls/extension.neon
    - ../../tools/phpstan/orbit-rules.neon
    - ../../tools/phpstan/parallel.php

parameters:
    level: 9
    paths:
        - app
        - design
        - ../../tools/phpstan
    tmpDir: vendor/phpstan/cache

    # Larastan checks inherited helpers against every registered subclass, even
    # when that subclass never calls the helper. ToolCommand::nodeId() reads
    # --node; tool:remove, tool:show, and tool:update never call it, so they do
    # not declare that option.
    # Match the exact commands, input names, files, and counts. New findings fail.
    ignoreErrors:
        -
            identifier: larastan.console.undefinedOption
            message: '#^Command "(?:tool:remove|tool:show|tool:update)" does not have option "node"\.$#'
            path: app/Commands/Tools/ToolCommand.php
            count: 3
