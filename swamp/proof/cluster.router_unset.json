{
  "kind": "cluster.router_unset",
  "workflow": "operation-cluster-router-unset",
  "topology": "minimal",
  "clean": true,
  "budget_seconds": 1800,
  "queue_timeout_seconds": 30,
  "before_gateway": [
    [
      "sh",
      "-c",
      "printf '%s' \"$1\" | runuser -u orbit -- env -C apps/gateway php ../../tools/swamp-proof-guest/gateway.php fixture",
      "sh",
      "{\"node_updates\": [{\"id\": \"${node.target}\", \"attributes\": {\"lan_ip\": \"10.231.0.10\"}}, {\"id\": \"${node.peer}\", \"attributes\": {\"lan_ip\": \"10.231.0.12\"}}], \"clusters\": [{\"name\": \"proof\", \"node_ids\": [\"${node.target}\", \"${node.peer}\"], \"router_node_id\": \"${node.target}\"}]}"
    ]
  ],
  "prepare": [
    {
      "method": "GET",
      "path": "clusters",
      "operation": false,
      "bind": "cluster",
      "body": {},
      "match": {
        "name": "proof"
      }
    }
  ],
  "request": {
    "method": "DELETE",
    "path": "clusters/${cluster.id}/router",
    "body": {
      "force": true
    }
  },
  "expect": {
    "status": "succeeded",
    "run": false
  },
  "parity": "swamp/proof/cluster.router_unset/parity.py"
}
