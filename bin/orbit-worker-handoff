#!/usr/bin/env php
<?php

declare(strict_types=1);

require_once __DIR__.'/orbit-worker-registry.php';
require_once __DIR__.'/orbit-quality-subgates.php';
require_once __DIR__.'/orbit-git-process.php';
require_once __DIR__.'/orbit-loop-contract.php';
require_once __DIR__.'/orbit-quality-gate-artifacts.php';
require_once __DIR__.'/orbit-feature-proof-requirements.php';
require_once __DIR__.'/orbit-cleanup-checks.php';
require_once __DIR__.'/orbit-proof-receipt.php';

const ORBIT_WORKER_HANDOFF_USAGE = 'Usage: bin/orbit-worker-handoff <id> <file> [--note=<text>] [--force]';

try {
    $parsed = orbit_worker_parse_argv(array_slice($argv, 1));
    $id = $parsed['positional'][0] ?? null;
    $file = $parsed['positional'][1] ?? null;

    if (! is_string($id) || $id === '' || ! is_string($file) || $file === '' || count($parsed['positional']) !== 2) {
        throw new RuntimeException(ORBIT_WORKER_HANDOFF_USAGE);
    }

    if (! is_file($file) || is_link($file)) {
        throw new RuntimeException("handoff source is missing or not a regular file: {$file}");
    }

    $worktree = orbit_worker_worktree((string) getcwd());
    $entry = orbit_worker_require_entry($worktree, $id);
    $force = ($parsed['options']['force'] ?? false) === true;
    $contents = file_get_contents($file);

    if ($contents === false) {
        throw new RuntimeException("unable to read handoff source: {$file}");
    }

    $sha = orbit_worker_handoff_named_sha($contents);
    $role = (string) ($entry['role'] ?? '');

    if ($role === 'impl') {
        $head = trim(orbit_worker_run_command(['git', 'rev-parse', 'HEAD'], $worktree)['stdout']);

        if ($sha === null) {
            throw new RuntimeException(
                'impl handoff must name candidate=<40-character sha> for the exact clean HEAD',
            );
        }

        if (! hash_equals($head, $sha)) {
            throw new RuntimeException(
                "impl handoff candidate={$sha} does not match clean HEAD {$head}",
            );
        }

        $receiptProblem = orbit_proof_receipt_problem($worktree, [
            'changed_files' => orbitLoopExactProofRoute($worktree)['changed_files'],
            'venue' => 'automated',
        ]);

        if ($receiptProblem !== null) {
            throw new RuntimeException($receiptProblem);
        }
    }

    $destination = $sha === null
        ? orbit_worker_handoff_path($worktree, $id)
        : orbit_worker_handoff_path($worktree, $id, $sha);

    if (is_file($destination) && ! $force) {
        throw new RuntimeException(
            "handoff file already exists: {$destination}. Re-run with --force to overwrite.",
        );
    }

    if (file_put_contents($destination, $contents) === false) {
        throw new RuntimeException("unable to write handoff file: {$destination}");
    }

    $note = orbit_worker_option_string($parsed['options'], 'note');

    if ($note !== null) {
        orbit_worker_reject_newline('note', $note);
        $entry['note'] = $note;
    }

    $entry['status'] = 'handoff';
    $entry['handoff'] = $destination;
    $entry['heartbeat_at'] = orbit_worker_now();
    orbit_worker_write($worktree, $entry);
} catch (Throwable $exception) {
    fwrite(STDERR, $exception->getMessage().PHP_EOL);
    exit(2);
}

function orbit_worker_handoff_named_sha(string $contents): ?string
{
    if (preg_match('/(?:^|\n)candidate=([0-9a-f]{40})(?:\n|$)/', $contents, $match) !== 1) {
        return null;
    }

    return $match[1];
}
