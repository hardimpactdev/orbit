# Copy to .env.e2e for local E2E settings. Composer E2E scripts source this
# file before setting their lane-specific defaults.
#
# Do not point E2E at standing live nodes.

ORBIT_E2E_DOCKER_HOSTS=sidecar1,sidecar2,beast
ORBIT_E2E_DOCKER_HOST_SLOTS=sidecar1:2,sidecar2:2,beast:3
ORBIT_E2E_DOCKER_MAX_CONTAINERS_PER_HOST=8
ORBIT_E2E_PARALLEL_PROCESSES=7

ORBIT_E2E_PROVIDER=incus
ORBIT_E2E_PROVIDERS=incus
ORBIT_E2E_INCUS_IMAGE_BUILD_HOST=beast
ORBIT_E2E_INCUS_HOSTS=beast
ORBIT_E2E_INCUS_HOST_SLOTS=beast:1
ORBIT_E2E_INCUS_STORAGE_POOL=orbit-e2e
ORBIT_E2E_INCUS_MAX_VMS_PER_HOST=4
ORBIT_E2E_PROVISION_PARALLEL_PROCESSES=1

ORBIT_E2E_EXCLUSIVE_HOSTS=beast

# Hetzner is opt-in only. Keep these commented unless a run should create paid
# resources.
# ORBIT_E2E_HCLOUD_RESOURCE_SLOTS=nbg1/cx23/ubuntu-24.04:1
# ORBIT_E2E_HCLOUD_LOCATION_SLOTS=nbg1:1

ORBIT_E2E_SLOT_WAIT_SECONDS=900
ORBIT_E2E_SLOT_STALE_SECONDS=7200
