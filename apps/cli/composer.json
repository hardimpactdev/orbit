{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "nckrtl/orbit-cli",
    "description": "The minimal command-line client for the Orbit gateway.",
    "keywords": [
        "cli",
        "infrastructure",
        "laravel-zero",
        "orbit"
    ],
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "illuminate/http": "^13.0",
        "laravel-zero/foundation": "^13.0",
        "laravel-zero/framework": "^13.0",
        "nckrtl/orbit-php-sdk": "dev-main"
    },
    "require-dev": {
        "larastan/larastan": "^3.11",
        "laravel/boost": "^2.5",
        "laravel/pao": "^1.1",
        "laravel/pint": "^1.32",
        "laravel/vet": "^0.2.1",
        "mockery/mockery": "^1.6.12",
        "nckrtl/pestphp-monorepo": "dev-main",
        "phpunit/phpunit": "^13.0",
        "rector/rector": "^2.3",
        "spatie/guidelines-skills": "^1.1",
        "spaze/phpstan-disallowed-calls": "^4.14"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Design\\": "design/",
            "Orbit\\PHPStan\\": "../../tools/phpstan/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../packages/php-sdk",
            "options": {
                "symlink": true
            }
        }
    ],
    "scripts": {
        "test:affected": "../../bin/pest-plain vendor/bin/pest --parallel --processes=$(../../bin/check-processes) --tia --compact --colors=never",
        "analyse": "vendor/bin/phpstan analyse --no-progress --memory-limit=1G",
        "check": [
            "@guidance:check",
            "@analyse",
            "@rector",
            "@format:check"
        ],
        "format": "vendor/bin/pint --parallel --max-processes=$(../../bin/check-processes)",
        "format:check": "../../bin/quality-scope pint vendor/bin/pint --test --parallel --max-processes=$(../../bin/check-processes)",
        "guidance:check": "../../bin/guidance-check",
        "guidance:update": "@php orbit boost:update --no-discover --no-interaction",
        "lint": "@format:check",
        "rector": "../../bin/quality-scope rector vendor/bin/rector process --dry-run --no-progress-bar --clear-cache",
        "test": "../../bin/pest-plain vendor/bin/pest --parallel --processes=$(../../bin/check-processes) --tia --compact --colors=never"
    },
    "config": {
        "preferred-install": "dist",
        "process-timeout": 0,
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "laravel/vet": true,
            "pestphp/pest-plugin": true,
            "rector/rector": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "bin": [
        "orbit"
    ]
}
