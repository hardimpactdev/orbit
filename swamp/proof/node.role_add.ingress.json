{
  "kind": "node.role_add.ingress",
  "defaults": "node-role-add-defaults.json",
  "clean": true,
  "before_gateway": [
    ["apt-get", "update"],
    ["apt-get", "install", "--yes", "python3-venv"],
    ["python3", "-m", "venv", "/opt/orbit/ansible/venv"],
    ["/opt/orbit/ansible/venv/bin/pip", "install", "--disable-pip-version-check", "-r", "swamp/ansible/requirements.txt"],
    ["/opt/orbit/ansible/venv/bin/ansible-galaxy", "collection", "install", "-r", "swamp/ansible/requirements.yml", "-p", "/opt/orbit/ansible/collections"],
    ["runuser", "-u", "orbit", "--", "php", "swamp/proof/node.role_add/prepare.php", "${node.peer}"],
    [
      "sh",
      "-c",
      "printf '%s' \"$1\" | runuser -u orbit -- php tools/swamp-proof-guest/gateway.php fixture",
      "sh",
      "{\"clusters\": [{\"name\": \"role-ingress-proof\", \"node_ids\": [\"${node.peer}\"], \"router_node_id\": \"${node.target}\"}]}"
    ]
  ],
  "request": {"method": "POST", "path": "nodes/${node.peer}/roles", "body": {"role": "ingress"}},
  "parity": ["swamp/proof/node.role_add/parity.py", "peer", "ingress"],
  "prepare": [{"method": "POST", "path": "nodes/${node.peer}/converge", "body": {}}]
}
