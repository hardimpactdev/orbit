{
  "kind": "metrics.credentials_reset",
  "workflow": "operation-metrics-credentials-reset",
  "topology": "minimal",
  "budget_seconds": 180,
  "queue_timeout_seconds": 60,
  "before_gateway": [["runuser", "-u", "orbit", "--", "env", "-C", "apps/gateway", "PROOF_TARGET_NODE=${node.target}", "php", "-r", "require \"vendor/autoload.php\"; $app=require \"bootstrap/app.php\"; $app->make(Illuminate\\Contracts\\Console\\Kernel::class)->bootstrap(); $node=App\\Models\\Node::findOrFail((int)getenv(\"PROOF_TARGET_NODE\")); $node->roles()->firstOrCreate([\"role\"=>\"metrics\"],[\"status\"=>\"active\"]); app(App\\Domain\\Settings\\SettingRepository::class)->put(new App\\Domain\\Settings\\SettingScope(App\\Domain\\Settings\\SettingScopeType::Node,$node->id),App\\Infrastructure\\Metrics\\NativeMetricsCredentialManager::ActivePasswordKey,\"proof-active\",App\\Domain\\Settings\\SettingValueProtection::Secret);"]],
  "clean_target": [["sh", "-c", "docker rm --force --volumes proof-grafana >/dev/null 2>&1 || true"]],
  "before_target": [["timeout", "60", "docker", "run", "--detach", "--name", "proof-grafana", "--network", "host", "--env", "GF_SECURITY_ADMIN_PASSWORD=proof-active", "grafana/grafana:12.1.1"], ["timeout", "60", "curl", "--silent", "--show-error", "--fail", "--retry", "30", "--retry-connrefused", "--retry-delay", "1", "--output", "/dev/null", "http://127.0.0.1:3000/api/health"]],
  "request": {"method": "POST", "path": "metrics/credentials/reset"},
  "expect": {"status": "succeeded"},
  "phases": [{"name": "Check the pending one", "job": "credentials", "step": "Check the pending one", "budget_seconds": 60}, {"name": "Change the password", "job": "credentials", "step": "Change the password", "budget_seconds": 60}, {"name": "Confirm the new login", "job": "credentials", "step": "Confirm the new login", "budget_seconds": 60}, {"name": "Assert the new login", "job": "credentials", "step": "Assert the new login", "budget_seconds": 10}],
  "parity": "swamp/proof/metrics.credentials_reset/parity.py"
}
