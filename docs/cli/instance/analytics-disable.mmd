sequenceDiagram
  %% Target design: ADR 0244 task, one Swamp run; disable keeps the Plausible site. docs/reference/analytics.md#publish-a-tracking-host.
  %% status: reviewed
  %% command: instance:analytics:disable
  %% kind: analytics.disable
  autonumber
  %% lane CLI icon=terminal pill=caller tone=gray
  %% lane GW icon=gateway pill=intent tone=blue
  %% lane SW icon=workflow pill=executes tone=green
  %% lane N icon=server pill=target tone=amber
  participant CLI as CLI / MCP<br/>orbit · MCP tools
  participant GW as Gateway<br/>Laravel API
  participant SW as Swamp<br/>workflow execution
  participant N as Serving Node<br/>Instance or Router
  Note over CLI: Confirm host removal<br/>default No
  %%> Why:
  %%> - visits stop being counted as soon as the hosts are gone
  CLI->>GW: instance:analytics:disable<br/>INSTANCE
  Note over GW: Validate, find hosts
  alt Instance has no hosts
    GW-->>CLI: Skipped<br/>no hosts · no run
    %%> Result:
    %%> - the command succeeds and changes nothing
  else hosts exist
    GW->>SW: Start run, full intent<br/>operation-analytics-disable-direct
    GW-->>CLI: 202 Accepted<br/>task ID
    opt host outside the TLD
      Note over SW: Remove private DNS<br/>VPN Node over @swamp/ssh
      %%> Why first:
      %%> - the name stops resolving before its site leaves
    end
    SW->>N: Withdraw sites, certs<br/>@swamp/cfgmgmt/file absent
    %%> Why one step:
    %%> - the site goes before its certificate, as `route:destroy` does; other sites stay
    SW->>N: Check the hosts are gone<br/>@swamp/cfgmgmt/file check
    alt every step succeeds
      SW-->>GW: Run succeeded<br/>terminal event
      Note over GW: Delete tracking Routes<br/>site binding deleted
      %%> Result:
      %%> - the Plausible site, its history and its goals stay; disable never calls Plausible
    else a step fails
      SW--xGW: Run failed<br/>error_code, failed step
      Note over GW: Keep the Routes<br/>marked failed
      %%> On the Nodes:
      %%> - sections already withdrawn stay withdrawn; there is no rollback
      %%> Retry:
      %%> - run the same command again; it skips what is already gone
    end
    loop every 2 s until terminal
      CLI->>GW: operation:show TASK
      GW-->>CLI: status + result
    end
  end
