{
  "kind": "websocket.app_rotate",
  "workflow": null,
  "topology": "minimal",
  "budget_seconds": 90,
  "prepare": [
    {
      "method": "POST",
      "path": "websocket-apps",
      "body": {
        "name": "rotate-${proof.run}"
      }
    },
    {
      "method": "PUT",
      "path": "instances/7001/websocket-apps/rotate-${proof.run}",
      "operation": false
    }
  ],
  "after_prepare": [
    [
      "php",
      "swamp/proof/websocket/check.php",
      "prepare",
      "${proof.run}",
      "rotate-${proof.run}"
    ],
    [
      "php",
      "swamp/proof/websocket/check.php",
      "offline",
      "${proof.run}"
    ],
    [
      "incus",
      "stop",
      "target",
      "--force"
    ]
  ],
  "request": {
    "method": "POST",
    "path": "websocket-apps/rotate-${proof.run}/rotate"
  },
  "expect": {
    "status": "succeeded",
    "run": false
  },
  "phases": [],
  "parity": "swamp/proof/websocket/parity.py",
  "before_gateway": [
    [
      "php",
      "swamp/proof/websocket/check.php",
      "seed-rotation",
      "${proof.run}",
      "${node.target}"
    ]
  ]
}
