{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "@hardimpactdev/orbit-sdk-typescript",
    "version": "0.3.0",
    "private": true,
    "type": "module",
    "description": "Generated TypeScript client for the public Orbit gateway API surface.",
    "license": "MIT",
    "keywords": [
        "orbit",
        "gateway",
        "openapi",
        "typescript",
        "sdk"
    ],
    "homepage": "https://github.com/hardimpactdev/orbit/tree/main/packages/sdk-typescript",
    "bugs": {
        "url": "https://github.com/hardimpactdev/orbit/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/hardimpactdev/orbit.git",
        "directory": "packages/sdk-typescript"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "openapi/public-gateway-openapi.json",
        "README.md"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "generate": "vp run generate:openapi && vp run generate:types",
        "generate:openapi": "composer --working-dir=../../apps/gateway openapi:export && node scripts/filter-public-openapi.mjs",
        "generate:types": "openapi-typescript openapi/public-gateway-openapi.json -o src/generated/schema.ts",
        "pack:dry-run": "npm pack --dry-run",
        "test": "vp run typecheck && vp run test:runtime",
        "test:runtime": "node --experimental-strip-types --test tests/process-stream.test.ts tests/client.test.ts",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "openapi-fetch": "^0.17.0"
    },
    "devDependencies": {
        "openapi-typescript": "^7.13.0",
        "typescript": "^5.9.3"
    },
    "packageManager": "npm@11.17.0"
}
