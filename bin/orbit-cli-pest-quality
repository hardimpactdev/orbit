#!/usr/bin/env bash

set -Eeuo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." >/dev/null 2>&1 && pwd)"
APP_ROOT="${ROOT}/apps/cli"
PEST_BIN="${APP_ROOT}/vendor/pestphp/pest/bin/pest"

cd "$APP_ROOT"

PEST_ARGS=("$@")
PROFILE_OUTPUT=0

for argument in "${PEST_ARGS[@]}"; do
    if [ "$argument" = "--profile" ]; then
        PROFILE_OUTPUT=1
        break
    fi
done

LOG_DIR="$(mktemp -d)"
GROUP_WORKERS=()

terminate_process_tree() {
    local parent_pid="$1"
    local signal="${2:-TERM}"
    local child_pid
    local child_pids

    child_pids="$(pgrep -P "$parent_pid" 2>/dev/null || true)"
    kill -"$signal" "$parent_pid" 2>/dev/null || true

    for child_pid in $child_pids; do
        terminate_process_tree "$child_pid" "$signal"
    done
}

cleanup() {
    local pid

    for pid in "${GROUP_WORKERS[@]}"; do
        if kill -0 "$pid" 2>/dev/null; then
            terminate_process_tree "$pid"
        fi
    done

    for pid in "${GROUP_WORKERS[@]}"; do
        wait "$pid" 2>/dev/null || true
    done

    rm -rf "$LOG_DIR"
}

trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

GROUP_LABELS=(mixed_1 mixed_2 mixed_3 mixed_4 mixed_5 services)
PARALLEL_GROUP_LABELS=(mixed_1 mixed_2 mixed_3 mixed_4 mixed_5)

mixed_1_files=()
mixed_2_files=()
mixed_3_files=()
mixed_4_files=()
mixed_5_files=()
services_files=()

assign_mixed_file() {
    local group="$1"
    local file="$2"

    case "$group" in
        0) mixed_1_files+=("$file") ;;
        1) mixed_2_files+=("$file") ;;
        2) mixed_3_files+=("$file") ;;
        3) mixed_4_files+=("$file") ;;
        4) mixed_5_files+=("$file") ;;
    esac
}

assign_surface_round_robin() {
    local file
    local file_index=0

    while IFS= read -r file; do
        assign_mixed_file "$((file_index % 5))" "$file"
        file_index=$((file_index + 1))
    done
}

assign_surface_round_robin < <(find tests/Feature -maxdepth 1 -type f -name '*Test.php' | sort)

mixed_surface_files=()
for directory in tests/Feature/Commands tests/Feature/Architecture tests/Feature/Support; do
    if [ -d "$directory" ]; then
        while IFS= read -r file; do
            mixed_surface_files+=("$file")
        done < <(find "$directory" -type f -name '*Test.php' | sort)
    fi
done

if [ "${#mixed_surface_files[@]}" -gt 0 ]; then
    assign_surface_round_robin < <(printf '%s\n' "${mixed_surface_files[@]}")
fi

service_dirs=()
for directory in tests/Feature/Services tests/Unit/Services; do
    if [ -d "$directory" ]; then
        service_dirs+=("$directory")
    fi
done

if [ "${#service_dirs[@]}" -gt 0 ]; then
    for directory in "${service_dirs[@]}"; do
        while IFS= read -r file; do
            services_files+=("$file")
        done < <(find "$directory" -type f -name '*Test.php' | sort)
    done
fi

top_level_files=()
while IFS= read -r file; do
    top_level_files+=("$file")
done < <(find tests -maxdepth 1 -type f -name '*Test.php' | sort)

if [ "${#top_level_files[@]}" -gt 0 ]; then
    assign_surface_round_robin < <(printf '%s\n' "${top_level_files[@]}")
fi

validate_coverage() {
    local all_tests_file="$LOG_DIR/all-tests.txt"
    local covered_tests_file="$LOG_DIR/covered-tests.txt"
    local duplicate_tests_file="$LOG_DIR/duplicate-tests.txt"

    find tests -type f -name '*Test.php' | sort >"$all_tests_file"

    {
        [ "${#mixed_1_files[@]}" -eq 0 ] || printf '%s\n' "${mixed_1_files[@]}"
        [ "${#mixed_2_files[@]}" -eq 0 ] || printf '%s\n' "${mixed_2_files[@]}"
        [ "${#mixed_3_files[@]}" -eq 0 ] || printf '%s\n' "${mixed_3_files[@]}"
        [ "${#mixed_4_files[@]}" -eq 0 ] || printf '%s\n' "${mixed_4_files[@]}"
        [ "${#mixed_5_files[@]}" -eq 0 ] || printf '%s\n' "${mixed_5_files[@]}"
        [ "${#services_files[@]}" -eq 0 ] || printf '%s\n' "${services_files[@]}"

    } | sort >"$covered_tests_file"

    sort "$covered_tests_file" | uniq -d >"$duplicate_tests_file"

    if [ -s "$duplicate_tests_file" ]; then
        echo "CLI Pest quality split assigns test files to multiple groups:" >&2
        cat "$duplicate_tests_file" >&2

        exit 1
    fi

    if ! cmp -s "$all_tests_file" "$covered_tests_file"; then
        echo "CLI Pest quality split does not cover every CLI test file." >&2
        echo "Missing from split:" >&2
        comm -23 "$all_tests_file" "$covered_tests_file" >&2 || true

        exit 1
    fi
}

record_now() {
    local path="$1"

    php -r 'file_put_contents($argv[1], (string) microtime(true));' "$path"
}

elapsed_seconds() {
    local start_file="$1"

    php -r 'echo round(max(0, microtime(true) - (float) file_get_contents($argv[1])), 3);' "$start_file"
}

run_group() {
    local label="$1"
    shift

    local start_file="$LOG_DIR/$label.start"
    local log_file="$LOG_DIR/$label.log"
    local exit_file="$LOG_DIR/$label.exit"
    local duration_file="$LOG_DIR/$label.duration"

    if [ "$#" -eq 0 ]; then
        (
            : >"$log_file"
            echo 0 >"$duration_file"
            echo 0 >"$exit_file"
        ) &

        echo "$!" >"$LOG_DIR/$label.pid"
        GROUP_WORKERS+=("$!")

        return
    fi

    record_now "$start_file"

    (
        code=0

        if [ "${#PEST_ARGS[@]}" -gt 0 ]; then
            "$PEST_BIN" "${PEST_ARGS[@]}" "$@" >"$log_file" 2>&1 || code="$?"
        else
            "$PEST_BIN" "$@" >"$log_file" 2>&1 || code="$?"
        fi

        elapsed_seconds "$start_file" >"$duration_file"
        echo "$code" >"$exit_file"

        exit "$code"
    ) &

    echo "$!" >"$LOG_DIR/$label.pid"
    GROUP_WORKERS+=("$!")
}

validate_coverage

overall_start="$LOG_DIR/overall.start"
record_now "$overall_start"

for group_number in 1 2 3 4 5; do
    group_label="mixed_${group_number}"

    case "$group_number" in
        1) run_group "$group_label" "${mixed_1_files[@]}" ;;
        2) run_group "$group_label" "${mixed_2_files[@]}" ;;
        3) run_group "$group_label" "${mixed_3_files[@]}" ;;
        4) run_group "$group_label" "${mixed_4_files[@]}" ;;
        5) run_group "$group_label" "${mixed_5_files[@]}" ;;
    esac
done

overall_exit=0

collect_group_exit() {
    local label="$1"

    wait "$(cat "$LOG_DIR/$label.pid")" || true

    local code
    code="$(cat "$LOG_DIR/$label.exit" 2>/dev/null || echo 1)"

    if [ "$code" -ne 0 ]; then
        overall_exit="$code"
    fi
}

for label in "${PARALLEL_GROUP_LABELS[@]}"; do
    collect_group_exit "$label"
done

run_group services "${services_files[@]}"
collect_group_exit services

elapsed_seconds "$overall_start" >"$LOG_DIR/overall.duration"

if [ "$overall_exit" -ne 0 ]; then
    for label in "${GROUP_LABELS[@]}"; do
        code="$(cat "$LOG_DIR/$label.exit" 2>/dev/null || echo 1)"

        if [ "$code" -ne 0 ]; then
            echo "─── cli_pest_${label} (exit=${code}) ───"
            cat "$LOG_DIR/$label.log"
            echo
        fi
    done
fi

# Pest writes the slow-test profile into each process log. On successful
# aggregate runs, keep those reports visible before the final machine-readable
# JSON line so quality-check evidence includes the actionable timings.
if [ "$overall_exit" -eq 0 ] && [ "$PROFILE_OUTPUT" -eq 1 ]; then
    for label in "${GROUP_LABELS[@]}"; do
        echo "─── cli_pest_${label}_profile ───"
        cat "$LOG_DIR/$label.log"
        echo
    done
fi

php -r '
$directory = $argv[1];
$labels = ["mixed_1", "mixed_2", "mixed_3", "mixed_4", "mixed_5", "services"];
$groups = [];
$tests = 0;
$assertions = 0;
$exitCode = 0;

foreach ($labels as $label) {
    $logPath = "{$directory}/{$label}.log";
    $exitPath = "{$directory}/{$label}.exit";
    $durationPath = "{$directory}/{$label}.duration";
    $log = is_file($logPath) ? file_get_contents($logPath) : "";
    $plain = preg_replace("/\x1B\[[0-9;?]*[ -\/]*[@-~]/", "", $log);
    $matched = preg_match("/Tests:\s+([0-9]+) passed\s+\(([0-9]+) assertions\)/s", $plain, $matches) === 1;
    $groupTests = $matched ? (int) $matches[1] : 0;
    $groupAssertions = $matched ? (int) $matches[2] : 0;
    $groupExitCode = is_file($exitPath) ? (int) trim(file_get_contents($exitPath)) : 1;
    $duration = is_file($durationPath) ? (float) trim(file_get_contents($durationPath)) : 0.0;

    $tests += $groupTests;
    $assertions += $groupAssertions;
    $exitCode = max($exitCode, $groupExitCode);

    $groups[$label] = [
        "exit" => $groupExitCode,
        "duration_ms" => (int) round($duration * 1000),
        "tests" => $groupTests,
        "assertions" => $groupAssertions,
    ];
}

$overallDuration = (float) trim(file_get_contents("{$directory}/overall.duration"));

echo json_encode([
    "tool" => "pest",
    "result" => $exitCode === 0 ? "passed" : "failed",
    "tests" => $tests,
    "passed" => $exitCode === 0 ? $tests : null,
    "assertions" => $assertions,
    "duration_ms" => (int) round($overallDuration * 1000),
    "groups" => $groups,
], JSON_UNESCAPED_SLASHES).PHP_EOL;
' "$LOG_DIR"

exit "$overall_exit"
