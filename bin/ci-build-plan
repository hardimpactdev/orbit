#!/usr/bin/env python3
"""Select CI builds from changed inputs; every main commit is a Gateway release, which also loads Swamp."""
import argparse
import json
import os
from pathlib import Path
import re
import runpy
from types import SimpleNamespace
import subprocess
import sys
import tomllib
from functools import lru_cache

JOBS = ('php', 'gateway-static', 'gateway-tests', 'cli', 'cli-static', 'cli-tests', 'sdk-static', 'sdk-tests', 'e2e-static', 'docs', 'api-reference', 'web', 'pi', 'agent', 'swamp', 'proof')
ROOT = Path(__file__).resolve().parent.parent
registry = SimpleNamespace(**runpy.run_path(str(ROOT / 'bin/ci-registry')))
SELECTION = 'swamp/proof/selection.txt'
SELECTION_COMMAND = re.compile(r'[a-z][a-z0-9_-]*(?::[a-z][a-z0-9_-]*)+')


def selection_regex(glob):
    """Match `ProofSelectionRule` in the Gateway: `**` crosses directories, `*` and `?` stay in one name."""
    pattern, i = '', 0
    while i < len(glob):
        if glob.startswith('**', i):
            i += 2
            if glob.startswith('/', i):
                i += 1
                pattern += '(?:.*/)?'
            else:
                pattern += '.*'
            continue
        pattern += '[^/]*' if glob[i] == '*' else '[^/]' if glob[i] == '?' else re.escape(glob[i])
        i += 1
    return re.compile(pattern)


def selection_rules(text):
    """The lines of `swamp/proof/selection.txt` as (glob regex, selects a proof). The Gateway refuses a malformed line."""
    rules = []
    for number, line in enumerate(text.splitlines(), 1):
        line = line.strip()
        if not line or line.startswith('#'):
            continue
        parts = line.split(None, 1)
        if len(parts) != 2:
            raise ValueError(f'{SELECTION} line {number}: a line holds a path glob and its value')
        glob, value = parts[0], parts[1].strip()
        if value == 'skip' or (value.startswith('none:') and value[5:].strip()):
            selects = False
        elif value == '*' or all(SELECTION_COMMAND.fullmatch(word) for word in value.split()):
            selects = True
        else:
            raise ValueError(f'{SELECTION} line {number}: [{value}] is not skip, *, none: or a family:command')
        rules.append((selection_regex(glob), selects))
    return rules


def proof_run(paths, selection):
    """Whether a changed path selects a command in the list that `orbit proof:run` reads: the last matching line wins.

    A path no line matches also starts the job, so `proof:run` refuses it (proof.path_unmapped). Without a list,
    every change starts it, as proof:run then selects every case.
    """
    paths = [path for path in paths if path]
    if not paths:
        return False
    if selection is None:
        return True
    rules = selection_rules(selection)
    for path in paths:
        match = next((selects for regex, selects in reversed(rules) if regex.fullmatch(path)), True)
        if match:
            return True
    return False


INSTANCE_COMMANDS = ('instance:create', 'instance:clone', 'instance:migrate', 'instance:destroy')


def instance_execution_coverage(paths, selection, read, tracked_paths=()):
    """Keep ownership from both sides: deleting a mapping cannot hide an execution change."""
    import sys
    sys.path.insert(0, str(ROOT / 'swamp/proof/runner'))
    from selection import definitions
    import yaml

    parsed = []
    for text in (read('base', SELECTION), selection):
        rules = selection_rules(text or '')
        values = [line.strip().split(None, 1)[1].strip() for line in (text or '').splitlines()
                  if line.strip() and not line.strip().startswith('#')]
        parsed.append(list(zip(rules, values)))

    def commands(path, rules):
        value = next((value for (regex, _), value in reversed(rules) if regex.fullmatch(path)), '')
        if value == '*':
            return set(INSTANCE_COMMANDS)
        return set() if value == 'skip' or value.startswith('none:') else set(value.split()) & set(INSTANCE_COMMANDS)

    def execution_path(path):
        return (path.startswith('swamp/') and not path.startswith(('swamp/proof/', 'swamp/tests/'))
                and not path.endswith(('.md', '.mdx', '.mmd', '_test.ts', '_test.py')))

    owners, mapping_gaps = {}, {}
    for rules in parsed:
        for path in paths:
            if not execution_path(path):
                continue
            for command in commands(path, rules):
                owners.setdefault(command, set()).add(path)
    if SELECTION in paths:
        for path in tracked_paths:
            if execution_path(path):
                for command in commands(path, parsed[0]) - commands(path, parsed[1]):
                    owners.setdefault(command, set()).add(path)
                    mapping_gaps.setdefault(command, []).append(path)

    def real_cases(ref, file, command):
        text = read(ref, file)
        if text is None:
            return []
        raw = yaml.safe_load(text)
        if isinstance(raw, dict) and raw.get('command') == command and raw.get('cases') == []:
            return []
        cases, _ = definitions(text, read(ref, 'swamp/proof/batches.yaml'))
        return [name for name, definition in cases.items()
                if definition['settings']['command'] == command
                and not definition['case']['fails_today']
                and any(step['name'] == 'cli' and step['args']['run'][0] == command
                        and step['args'].get('expect', {}).get('exit') == 0
                        and step['args'].get('expect', {}).get('status') == 'succeeded'
                        and step['args'].get('expect', {}).get('request') != 'none'
                        for stage in definition['case']['stages'] for step in stage['act'])]

    coverage = []
    for command in INSTANCE_COMMANDS:
        file = 'swamp/proof/' + command.replace(':', '/', 1) + '.cases.yaml'
        # Removing the last success case is also a coverage change, even without an execution edit.
        if command not in owners and file not in paths:
            continue
        before, after = real_cases('base', file, command), real_cases('head', file, command)
        if command in owners or bool(before) != bool(after):
            coverage.append({'command': command, 'file': file, 'paths': sorted(owners.get(command, {file})),
                             'real_cases': after, 'enforced': bool(before or after),
                             'missing_mappings': sorted(mapping_gaps.get(command, []))})
    return coverage


def report_instance_execution_coverage(coverage, selected):
    """Warnings today; a local selection error once that command has a real case. No fleet wait."""
    lines, errors = [], []
    for item in coverage:
        entry = next((entry for entry in (selected or []) if entry['file'] == item['file']), None)
        covered = not item['missing_mappings'] and entry is not None and any(entry['only'] is None or name in entry['only'] for name in item['real_cases'])
        if covered:
            lines.append(f"{item['command']}: real proof selected for " + ', '.join(item['paths']))
            continue
        message = 'no real proof case covers these executed files: ' + ', '.join(item['paths']) + f" ({item['command']})"
        level = 'error' if item['enforced'] else 'warning'
        # Escape workflow command data, including filenames from the PR.
        escaped = message.replace('%', '%25').replace('\r', '%0D').replace('\n', '%0A')
        print(f'::{level} title=Instance execution proof coverage::{escaped}', file=sys.stderr)
        lines.append(message)
        if item['enforced']:
            errors.append(message)
    if lines and os.environ.get('GITHUB_STEP_SUMMARY'):
        with Path(os.environ['GITHUB_STEP_SUMMARY']).open('a') as summary:
            import html
            summary.write('### Instance execution proof coverage\n\n' + '\n'.join('- ' + html.escape(line) for line in lines) + '\n')
    if errors:
        raise ValueError('\n'.join(errors))


def proof_cases(paths, selection, read, files, coverage=()):
    """Use the runner to plan every candidate, retaining verified empty selections. None means Gateway must refuse an unmapped path."""
    import sys
    sys.path.insert(0, str(ROOT / 'swamp/proof/runner'))
    from selection import select as select_cases
    from spec import Loader
    import yaml

    rules = selection_rules(selection) if selection is not None else []
    # Keep the parser's validation and glob semantics; retain each value for command ownership.
    values = [line.strip().split(None, 1)[1].strip() for line in (selection or '').splitlines() if line.strip() and not line.strip().startswith('#')]
    commands, everything = {}, selection is None
    batch_path = 'swamp/proof/batches.yaml'
    for path in paths:
        matched = next((value for (regex, _), value in reversed(list(zip(rules, values))) if regex.fullmatch(path)), None)
        if matched is None and selection is not None:
            return None
        if matched == '*':
            everything = True
        elif matched and matched != 'skip' and not matched.startswith('none:'):
            for command in matched.split():
                if any(item['command'] == command and not item['enforced'] and path in item['paths'] for item in coverage):
                    continue  # A refusal-only file cannot prove Node execution; report the gap without allocating a fleet.
                commands.setdefault(command, []).append(path)
    candidates = {f"swamp/proof/{c.split(':', 1)[0]}/{c.split(':', 1)[1].replace(':', '-')}.cases.yaml": c for c in sorted(commands)}
    if everything or batch_path in paths:
        for file in files:
            if file not in candidates:
                try:
                    candidates[file] = yaml.load(read('head', file), Loader=Loader)['command']
                except Exception:
                    candidates[file] = file.removeprefix('swamp/proof/').removesuffix('.cases.yaml').replace('/', ':', 1)
    # A mixed PR may run another proof. Keep explicit empty entries for these files,
    # otherwise the Gateway treats a missing artifact entry as whole-file execution.
    result = [{'command': item['command'], 'file': item['file'], 'only': [], 'reasons': {}}
              for item in coverage if not item['enforced'] and item['file'] in files and item['file'] not in candidates]
    for file, command in candidates.items():
        if file not in files:
            continue
        code_changed = everything or any(path not in (file, batch_path) for path in commands.get(command, []))
        chosen = select_cases(read('base', file), read('head', file), code_changed,
                              read('base', batch_path), read('head', batch_path), changed_paths=paths)
        # Keep empty entries in the artifact: the Gateway must distinguish verified zero from missing data.
        result.append({'command': command, 'file': file, **chosen})
    return sorted(result, key=lambda entry: entry['command'])


TABLE = '.github/ci/checks.toml'
SWAMP_CHECKS = ('shape', 'validate', 'tests')


def input_rules(inputs):
    """Compile includes and exclusions; exclusions always win."""
    return ([selection_regex(glob) for glob in inputs if not glob.startswith('!')],
            [selection_regex(glob[1:]) for glob in inputs if glob.startswith('!')])


def matches(path, rules):
    includes, excludes = rules
    return any(regex.fullmatch(path) for regex in includes) and not any(regex.fullmatch(path) for regex in excludes)


@lru_cache(maxsize=1)
def check_table():
    table, _ = registry.load(ROOT)
    checks = {name: input_rules(check['inputs']) for name, check in table['check'].items()}
    roots = [(name, input_rules(root['inputs']), root['default']) for name, root in table['roots'].items()]
    return table, checks, roots


def check_source_roots(paths):
    _, _, roots = check_table()
    for path in paths:
        if not any(matches(path, rules) for _, rules, _ in roots):
            raise ValueError(f'Unknown CI source root: {path}. Add [roots."{path.split("/")[0]}"] with inputs and default checks to {TABLE}.')


def registry_check_changes(base, head):
    """Compare fast-check definitions at the same merge base as changed paths."""
    before, _ = registry.read_revision(Path.cwd(), base)
    after, _ = registry.read_revision(Path.cwd(), head)
    # Fixture bodies have their own semantic selector in ci-units. Everything
    # else outside an individual check is shared policy, including new sections.
    def shared(table):
        return {key: value for key, value in table.items() if key not in ('fixture', 'check')}
    if shared(before) != shared(after):
        return set(check_table()[1])
    old, new = before.get('check', {}), after.get('check', {})
    return {name for name in old.keys() | new.keys() if old.get(name) != new.get(name)}


def selected_checks(paths, registry_checks=None):
    """Interpret only table data; return selected names and unclaimed paths for the summary."""
    table, checks, roots = check_table()
    shared = input_rules(table['all-checks']['inputs'])
    ignored = input_rules(table['ignored']['inputs'])
    selected, unclaimed = set(), []
    for path in paths:
        if path == TABLE and registry_checks is not None:
            selected.update(registry_checks)
            continue
        claimed = {name for name, rules in checks.items() if matches(path, rules)}
        if matches(path, shared):
            claimed.update(checks)
        if not claimed and not matches(path, ignored):
            for root, rules, default in roots:
                if matches(path, rules):
                    claimed.update(default)
                    unclaimed.append((path, root, default))
                    break
        selected.update(claimed)
    return selected, unclaimed


def select(paths, main=False, selection=None, registry_checks=None, pull_request=False, population_changed=False):
    """`selection` is the text of the proof list; omitted, read this checkout's list."""
    paths = [path for path in paths if path]
    check_source_roots(paths)
    selected, _ = selected_checks(paths, registry_checks)
    jobs = {name: name in selected for name in JOBS}
    swamp_checks = {name: 'swamp-' + name in selected or 'swamp' in selected for name in SWAMP_CHECKS}
    jobs['swamp'] = any(swamp_checks.values())
    jobs['web'] |= main or pull_request
    jobs['docs'] |= pull_request
    docs_only = selected == {'docs'}
    scope_paths = [path for path in paths if path != TABLE or registry_checks is None or registry_checks]
    # Population changes previously lived outside swamp/ in the inventory. Keep
    # their release-input selection without inventing a deleted changed path.
    swamp_only = not population_changed and bool(scope_paths) and all(path.startswith('swamp/') for path in scope_paths)
    registry_only = not population_changed and bool(paths) and not scope_paths
    if selection is None and (ROOT / SELECTION).is_file():
        selection = (ROOT / SELECTION).read_text()
    return {'jobs': jobs, 'swamp_checks': swamp_checks, 'gateway_release': main or (not swamp_only and not docs_only and not registry_only),
            'proof_run': proof_run(paths, selection)}


def swamp_comparison_base(base, head):
    """The first import compares against its retained source; later changes use Orbit's base."""
    if subprocess.run(['git', 'cat-file', '-e', f'{base}:swamp'],
                      stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=60).returncode == 0:
        return base
    source = json.loads(subprocess.check_output(
        ['git', 'show', f'{head}:swamp/import-source.json'], timeout=60))['shape_base']
    if not isinstance(source, str) or not re.fullmatch('[0-9a-f]{40}', source):
        raise ValueError('The Swamp import source must be a full commit SHA')
    subprocess.run(['git', 'merge-base', '--is-ancestor', source, head], check=True,
                   stderr=subprocess.PIPE, timeout=60)
    return source


def changed_inputs(base, head):
    """Select head's changes; the checkout must contain both refs and their common ancestry."""
    ancestor = subprocess.check_output(['git', 'merge-base', base, head], text=True, timeout=60).strip()
    paths = subprocess.check_output(['git', 'diff', '--name-only', '--no-renames', '-z', ancestor, head],
                                    text=True, timeout=60).rstrip('\0').split('\0')
    return ancestor, [path for path in paths if path]


def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument('--base', required=True)
    p.add_argument('--head', default='HEAD')
    p.add_argument('--main', action='store_true')
    p.add_argument('--pull-request', action='store_true', help='Require the Docs impact gate on every PR')
    p.add_argument('--proof-cases', action='store_true', help='Compare case definitions at the merge base and head')
    p.add_argument('--github-output', type=Path)
    p.add_argument('--proof-selection-output', type=Path)
    p.add_argument('--swamp-base', action='store_true', help='Resolve the retained source for the first history import')
    a = p.parse_args()
    base, paths = changed_inputs(a.base, a.head)
    population_changed = False
    registry_checks = registry_check_changes(base, a.head) if registry.metadata_changed(paths) else None
    if registry.metadata_changed(paths):
        # One metadata file replaces policy and population edits. Preserve their
        # old selection meanings without treating its physical move as code.
        _, before = registry.read_revision(Path.cwd(), base)
        _, after = registry.read_revision(Path.cwd(), a.head)
        paths = [path for path in paths if not path.startswith(registry.DIRECTORY + '/')
                 and path != registry.LEGACY_INVENTORY]
        if TABLE not in paths:
            paths.append(TABLE)
        population_changed = before != after
    result = select(paths, a.main, registry_checks=registry_checks, pull_request=a.pull_request,
                    population_changed=population_changed)
    _, unclaimed = selected_checks(paths, registry_checks)
    if unclaimed:
        import sys
        lines = [f'Unclaimed CI input: {path}; root {root} defaults: {", ".join(default) or "none"}'
                 for path, root, default in unclaimed]
        print('\n'.join(lines), file=sys.stderr)
        if os.environ.get('GITHUB_STEP_SUMMARY'):
            with Path(os.environ['GITHUB_STEP_SUMMARY']).open('a') as summary:
                summary.write('### Unclaimed CI inputs\n\n' + '\n'.join(f'- {line}' for line in lines) + '\n')
    # The full-history plan job supplies one comparison for builds, fixtures and proof.
    if a.proof_cases:
        def read(ref, path):
            process = subprocess.run(['timeout', '60', 'git', 'show', f'{base if ref == "base" else a.head}:{path}'], capture_output=True, text=True)
            if process.returncode:
                exists = subprocess.run(['timeout', '60', 'git', 'cat-file', '-e', f'{base if ref == "base" else a.head}:{path}'], capture_output=True)
                if exists.returncode == 1 or exists.returncode == 128:
                    return None
                raise ValueError(process.stderr)
            return process.stdout
        files = subprocess.check_output(['timeout', '60', 'git', 'ls-tree', '-r', '--name-only', a.head, '--', 'swamp/proof'], text=True).splitlines()
        files = [file for file in files if re.fullmatch(r'swamp/proof/[a-z][a-z0-9_]*/[a-z][a-z0-9_-]*\.cases\.yaml', file)]
        selection = read('head', SELECTION)
        tracked_paths = subprocess.check_output(['timeout', '60', 'git', 'ls-tree', '-r', '--name-only', a.head, '--', 'swamp'], text=True).splitlines() if SELECTION in paths else []
        coverage = instance_execution_coverage(paths, selection, read, tracked_paths)
        result['proof_cases'] = proof_cases(paths, selection, read, files, coverage)
        result['instance_execution_coverage'] = coverage
        report_instance_execution_coverage(coverage, result['proof_cases'])
        result['proof_run'] = result['proof_cases'] is None or any(entry['only'] is None or entry['only'] for entry in result['proof_cases'])
        if a.proof_selection_output:
            head = subprocess.check_output(['timeout', '60', 'git', 'rev-parse', a.head], text=True).strip()
            a.proof_selection_output.write_text(json.dumps({'version': 1, 'base': base, 'head': head, 'files': result['proof_cases']}))
    if a.swamp_base and result['jobs']['swamp']:
        result['swamp_base_ref'] = swamp_comparison_base(base, a.head)
    print(json.dumps(result))
    if a.github_output:
        with a.github_output.open('a') as output:
            for name, value in result.items():
                encoded = value if isinstance(value, str) else json.dumps(value, separators=(',', ':'))
                output.write(f'{name}={encoded}\n')


if __name__ == '__main__':
    main()
