sequenceDiagram
  %% Target design: ADR 0243/0244 task, one Swamp run, Ansible phases for idempotent Node state (rule 22). docs/reference/node-provisioning.md.
  %% status: draft
  %% command: node:role:add
  %% kind: node.role_add
  autonumber
  %% lane CLI icon=terminal pill=caller tone=gray
  %% lane GW icon=gateway pill=intent tone=blue
  %% lane SW icon=workflow pill=executes tone=green
  %% lane N icon=server pill=target tone=amber
  %% lane M icon=server pill=target tone=purple
  participant CLI as CLI / MCP<br/>orbit · MCP tools
  participant GW as Gateway<br/>Laravel API
  participant SW as Swamp<br/>workflow execution
  participant N as Target Node<br/>gets the role
  participant M as Fleet Nodes<br/>role participants
  %% path: main
  CLI->>GW: node:role:add NODE ROLE
  %%> Command:
  %%> - `orbit node:role:add NODE ROLE`
  %%> - syntax: `<node> <role> [--converge] [--postgres-process=ID] [--clickhouse-process=ID] [--idempotency-key=KEY] [--json]`
  Note over GW: Check recorded state
  %%> Requirements:
  %%> - apply the [Node family's shared authority rule](/cli/node#authority)
  %%> - use recorded Node eligibility, role compatibility, singleton ownership and Cluster membership; admission contacts no Node
  %%> - `database` needs a recorded WireGuard address; Analytics needs its two valid storage Processes
  alt unknown Node
    %% path: node-not-found
    GW--xCLI: http.404
  else caller refused
    %% path: access-refused
    GW--xCLI: node_access.required
  else database address missing
    %% path: database-address-missing
    GW--xCLI: Database address missing<br/>database.wireguard_ip_missing
  else Node not eligible
    %% path: node-ineligible
    GW--xCLI: operation.kind_unavailable
    %%> When:
    %%> - the Node is not active Linux or lacks recorded SSH management
  else role not admissible
    %% path: role-refused
    GW--xCLI: validation.failed
    %%> When:
    %%> - the role is unknown or protected, conflicts with an assigned role, has another singleton holder, or violates the ingress Cluster rule
    %%> - an existing assignment needs explicit convergence, except an active ingress assignment
    %%> - Analytics storage options are refused for another role
  else Analytics Process invalid
    %% path: analytics-storage-refused
    GW--xCLI: Process refused<br/>analytics.* or ownership conflict
    %%> Result:
    %%> - the storage error identifies the missing or unsuitable Process, port or credentials; no assignment is claimed
    %%> - an attached collector or storage Process returns process.node_service_ownership_conflict and names every dependent Instance before owner state changes
  else storage path refused
    %% path: storage-path-refused
    GW--xCLI: Storage path refused<br/>node.settings_path_*
    %%> When:
    %%> - the effective application storage path is invalid, protected or inside a managed checkout
  else Node held
    %% path: target-busy
    GW--xCLI: operation.target_busy
    %%> Result:
    %%> - no Operation or assignment change
  else convergence requested
    %% path: converge-requested
    opt --converge
      %% path: converge-mode
      alt assignment not eligible
        %% path: converge-refused
        GW--xCLI: validation.failed
        %%> When:
        %%> - the assignment is absent, fresh provisioning, removing, or failed outside a `converge:` step
      else convergence admitted
        %% path: converge
        Note over GW: Claim convergence
        %%> Requirements:
        %%> - accept an active role, a `converge:` failure, or provisioning at least 11 minutes old with no Operation holding the Node
        %%> Result:
        %%> - one Node Operation owns the convergence; freeze its full intent and vault key names
        GW->>SW: Start convergence run<br/>node.role_converge
        %%> Next:
        %%> - execute the [node.role_converge chart](https://github.com/hardimpactdev/orbit/blob/main/docs/cli/node/role-converge.mmd), not the add-only phases below
        GW-->>CLI: 202 Accepted<br/>Operation ID
        alt convergence succeeds
          %% path: converge-succeeded
          SW-->>GW: Convergence succeeded<br/>terminal event
          %%> Result:
          %%> - the shared terminal reader records the assignment active and clears earlier failure details
        else convergence fails
          %% path: converge-failed
          SW--xGW: Convergence failed<br/>error_code, failed step
          %%> Result:
          %%> - the shared terminal reader records the failure; an already-active assignment stays active
        end
        loop every 2 s until terminal
          CLI->>GW: operation:show TASK
          GW-->>CLI: status + result
        end
      end
    end
  else addition admitted
    %% path: add
    Note over GW: Claim the role and Node
    %%> Result:
    %%> - one Node Operation owns the add; a new assignment is provisioning, and a repeated active ingress assignment stays active
    %%> - capture full public intent and vault key names, never credential values
    %%> - for gateway, record its grants to active vpn and metrics Nodes on other machines
    GW->>SW: Start run, full intent<br/>operation-node-role-add
    GW-->>CLI: 202 Accepted<br/>Operation ID
    SW->>N: Apply prerequisites<br/>Ansible phase: prerequisites
    %%> What it does:
    %%> - require an admitted Ubuntu release before changing the host, then apply pinned repositories and packages
    %%> - for the swamp role, bootstrap its pinned Ansible and collections before the remaining phases
    %% path: tools
    SW->>N: Read Tool Manager accounts<br/>Ansible phase: tools-read
    SW->>SW: Compose tools resources
    SW->>SW: Write tool variables
    SW->>N: Set up Tool Managers<br/>Ansible phase: tools
    %%> What it does:
    %%> - apply only the admitted managers; rerun manager commands only when their pin or lock changes
    SW->>N: Apply the role<br/>Ansible phase: node
    %%> What it does:
    %%> - apply the role's files, units and storage ownership
    %%> - for swamp, repair ownership and mode 0644 of an existing `/tmp/deno-compile-swamp.cache`
    opt new Analytics assignment
      %% path: analytics
      SW->>M: Open Analytics storage<br/>Ansible phase: storage-firewall
      SW->>M: Apply Analytics runtime<br/>Ansible phase: analytics
      %%> What it does:
      %%> - initialize the database and apply the runtime
      SW->>M: Wait for Analytics<br/>Ansible phase: readiness
      %%> Result:
      %%> - a completed runtime is retained and recorded even if a later publication fails
    end
    opt swamp role
      %% path: swamp
      SW->>N: Install Swamp<br/>Ansible phase: swamp
      %%> What it does:
      %%> - publish the binary beside the running one, then apply identity, serve and worker units
      %%> - start all three permanent workers without restarting live processes; enable renewal to drain one at a time while two serve
    end
    opt role needs certificates
      %% path: certificates
      SW->>GW: Sign role certificates<br/>native child workflow
    end
    SW->>M: Read role publications<br/>Ansible phase: publication-read
    SW->>SW: Compose publications
    SW->>SW: Write publication vars
    opt role changes PHP pools
      %% path: php-pools
      SW->>M: Publish PHP pools<br/>Ansible phase: php
    end
    SW->>M: Publish role sites<br/>Ansible phase: publication
    %%> What it does:
    %%> - apply each participant's admitted delta; validate Caddy before reloading
    SW->>M: Open the firewall<br/>Ansible phase: firewall
    %%> What it does:
    %%> - repair owned rules, placing specific allows before isolation denies and broader peer trust; preserve unrelated rules
    opt role changes DNS
      %% path: dns
      SW->>M: Publish private DNS<br/>Ansible phase: dns
      %%> Why:
      %%> - publish only after the site serves and its firewall is open
    end
    opt role joins Metrics
      %% path: metrics
      SW->>N: Add the exporters<br/>Ansible phase: exporters
      SW->>M: Publish Prometheus<br/>Ansible phase: prometheus
      %%> What it does:
      %%> - publish membership after the target's exporters are ready
    end
    SW->>M: Check the role<br/>Ansible phase: check
    %%> What it does:
    %%> - prove the role's services, ports, sites and owned rules, including swamp cache readability
    alt every phase passes
      %% path: succeeded
      SW-->>GW: Run succeeded<br/>terminal event
      %%> Result:
      %%> - the shared terminal reader records the assignment active and clears earlier failure details
    else a phase fails
      %% path: failed
      SW--xGW: Run failed<br/>error_code, failed step
      %%> Result:
      %%> - a first add stays recorded as failed at `converge:STEP`; an already-active ingress assignment stays active
      %%> - retain the failed step and error code on the Operation and the failed assignment
      %%> - finished host changes remain, with no rollback; recover with `node:role:add NODE ROLE --converge`
    end
    opt Analytics init containers
      %% path: analytics-cleanup
      SW->>M: Remove init containers<br/>Ansible phase: cleanup
      %%> When:
      %%> - condition: completed; best-effort cleanup on the admitted runtime Node
    end
    SW->>SW: Remove the run folder<br/>condition: completed
    %%> Result:
    %%> - remove private intent and credential files after role phases and init-container cleanup finish, on either result
    loop every 2 s until terminal
      CLI->>GW: operation:show TASK
      GW-->>CLI: status + result
    end
  end
