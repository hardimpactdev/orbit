# The create and register responses report a name that Orbit converted to `default` the same way.
NAME_CONVERTED_FROM = {'type': ['string', 'null'],
    'description': 'The requested name when Orbit used `default` because the name equals the Project default branch. Null otherwise. A create on an `app-prod` Node converts nothing.'}


def data_schema_for(route):
    action = route['action']
    if action in ('TaskGroupsController@store', 'TaskGroupsController@show', 'TaskGroupsController@update', 'TaskGroupsController@index'):
        return {'anyOf': [ref('TaskGroupData'), ref('TaskData')]}, action.endswith('@index')
    if action.startswith('ProjectDocumentsController@'):
        verb = action.split('@')[1]
        if verb in ('index', 'search'):
            return ref('DocumentEntryData'), True
        if verb == 'versions':
            return ref('DocumentVersionData'), True
        if verb in ('read', 'download'):
            field = 'content_text' if verb == 'read' else 'content_base64'
            return {'type': 'object', 'properties': {'entry_id': {'type': 'integer'}, 'revision': {'type': 'integer'}, 'version': ref('DocumentVersionData'), field: {'type': 'string'}}, 'required': ['entry_id', 'revision', 'version', field], 'additionalProperties': False}, False
        if verb == 'destroy':
            return {'type': 'object', 'properties': {'id': {'type': 'integer'}, 'removed': {'type': 'boolean'}, 'cleanup_pending': {'type': 'boolean'}}, 'required': ['id', 'removed', 'cleanup_pending'], 'additionalProperties': False}, False
        return ref('DocumentEntryData'), False
    if action == 'FirewallRulesController@index':
        return {'type': 'array', 'items': {'type': 'object', 'required': ['node_id', 'node', 'rules'], 'properties': {
        'node_id': {'type': 'integer'}, 'node': {'type': 'string'},
        'agent': {'type': ['object', 'null'], 'description': 'With `live`: the liveness of the Node agent. Null for a Node that runs no observing agent.', 'properties': {'state': {'type': 'string', 'enum': ['online', 'offline', 'not_seen', 'unknown']}, 'since': {'type': ['string', 'null'], 'description': 'The time of the last agent event while it is offline.'}}},
        'rules': {'type': 'array', 'description': 'The operator rules in the order UFW checks them. With `live`, each has a `match`.', 'items': {'allOf': [ref('FirewallRuleData'), {'type': 'object', 'properties': {'match': {'type': 'string', 'enum': ['exact', 'drift', 'missing', 'unverifiable'], 'description': 'With `live`: whether the Node has the rule. `missing` also covers a firewall that is off or not installed.'}}}]}},
        'managed': {'type': 'array', 'description': 'With `managed`: the rules Orbit intends on the Node after role converge. No request adds, changes, or removes one.', 'items': {'type': 'object', 'properties': {'name': {'type': 'string', 'description': 'The `orbit:` comment that identifies the rule in UFW.'}, 'role': {'type': ['string', 'null'], 'description': 'The role that needs the rule, or null for a baseline rule the Node still intends.'}, 'action': {'type': 'string'}, 'source': {'type': 'string'}, 'destination': {'type': 'string'}, 'port': {'type': 'string'}, 'protocol': {'type': 'string'}, 'interface': {'type': ['string', 'null'], 'description': 'The interface the rule is limited to; `orbit` is the WireGuard interface.'}, 'match': {'type': 'string', 'enum': ['exact', 'drift', 'missing', 'unverifiable'], 'description': 'With `live`: the match with the Node.'}}}},
        'live': {'type': 'object', 'description': 'With `live`: how the Node compares with the rules.', 'required': ['backend_status', 'observed_at', 'possibly_outdated', 'unmatched'], 'properties': {
            'backend_status': {'type': 'string', 'enum': ['active', 'inactive', 'absent', 'unreachable', 'unverifiable'], 'description': 'Whether UFW answered on the Node. `unverifiable` means no orbit-agent UFW observation exists.'},
            'observed_at': {'type': ['string', 'null'], 'description': 'When the agent observed UFW.'},
            'possibly_outdated': {'type': 'boolean', 'description': 'True while the Node agent is offline, so the matches may be stale.'},
            'unmatched': {'type': 'array', 'description': 'Live rules that no listed rule explains: `unmanaged`, or `drift` from a rule with a known comment. Rules of Orbit itself appear only with `managed`.', 'items': {'type': 'object', 'properties': {'name': {'type': 'string'}, 'comment': {'type': 'string'}, 'action': {'type': 'string'}, 'source': {'type': 'string'}, 'destination': {'type': 'string'}, 'port': {'type': 'string'}, 'protocol': {'type': 'string'}, 'interface': {'type': ['string', 'null']}, 'family': {'type': ['string', 'null']}, 'match': {'type': 'string', 'enum': ['drift', 'unmanaged']}}}}}}}}}, False
    if action in RESPONSE_OVERRIDES:
        return RESPONSE_OVERRIDES[action], False
    if action in CTRL_DATA_OVERRIDES:
        cls, is_list = CTRL_DATA_OVERRIDES[action]
        return ref(cls), is_list
    if action in SDK_RESPONSE_FALLBACK:
        return sdk_schema(SDK_RESPONSE_FALLBACK[action]), False
    if action == 'DirectOperationsController@failure':
        return {'type': 'object', 'properties': {'id': {'type': 'integer'}, 'status': {'type': 'string', 'enum': ['failed', 'succeeded', 'cancelled']}}, 'required': ['id', 'status'], 'additionalProperties': False}, False
    if action in ('OperationsController@show', 'OperationsController@cancel', 'ConnOperationsController@show'):
        return ref('OperationData'), False
    cands = [c for c in controllers.get(action, {}).get('data', []) if not INPUT_PREFIX.match(c) and c in gdata]
    is_list = action.endswith(('@index', '@processIndex', '@scheduleIndex'))
    if not cands:
        return {'type': 'object'}, is_list
    if action == 'NodesController@show':
        return {'allOf': [ref('NodeData'), {'type': 'object', 'properties': {
            'access': ref('NodeAccessData'),
        }}]}, False
    if action == 'DatabaseServersController@show':
        return {'allOf': [ref('DatabaseServerData'), {'type': 'object', 'properties': {
            'databases': {'type': 'array', 'items': ref('DatabaseConnectionData')},
        }}]}, False
    return ref(cands[0]), is_list


def direct_run_body():
    return {'type': 'object', 'properties': {'run_id': {'type': 'string', 'format': 'uuid'}},
            'required': ['run_id'], 'additionalProperties': False}


