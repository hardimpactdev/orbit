{
  "kind": "cluster.router_set",
  "workflow": "operation-cluster-router",
  "topology": "minimal",
  "clean": true,
  "budget_seconds": 1800,
  "queue_timeout_seconds": 30,
  "before_gateway": [
    [
      "sh",
      "-c",
      "printf '%s' \"$1\" | runuser -u orbit -- env -C apps/gateway php ../../tools/swamp-proof-guest/gateway.php fixture",
      "sh",
      "{\"node_updates\": [{\"id\": \"${node.target}\", \"attributes\": {\"lan_ip\": \"10.231.0.10\"}}, {\"id\": \"${node.peer}\", \"attributes\": {\"lan_ip\": \"10.231.0.12\"}}], \"clusters\": [{\"name\": \"proof\", \"node_ids\": [\"${node.target}\", \"${node.peer}\"], \"router_node_id\": \"${node.target}\"}]}"
    ]
  ],
  "prepare": [
    {
      "method": "GET",
      "path": "clusters",
      "operation": false,
      "bind": "cluster",
      "body": {},
      "match": {
        "name": "proof"
      }
    },
    {
      "method": "POST",
      "path": "projects",
      "operation": false,
      "bind": "project",
      "body": {
        "slug": "proof-router",
        "name": "Proof router",
        "type": "monorepo",
        "root": "public",
        "repository_url": "https://github.com/laravel/laravel.git",
        "default_branch": "13.x"
      }
    },
    {
      "method": "POST",
      "path": "instances",
      "bind": "instance",
      "body": {
        "project_id": "${project.id}",
        "node_id": "${node.target}",
        "name": "c-${proof.run}"
      }
    },
    {
      "method": "POST",
      "path": "routes",
      "bind": "route",
      "body": {
        "instance_id": "${instance.id}",
        "domain": "c-${proof.run}.proof.test"
      }
    }
  ],
  "request": {
    "method": "PUT",
    "path": "clusters/${cluster.id}/router/${node.peer}",
    "body": {}
  },
  "expect": {
    "status": "succeeded"
  },
  "phases": [
    {
      "name": "prepare",
      "job": "router",
      "step": "Prepare the Router-0",
      "budget_seconds": 600
    },
    {
      "name": "probe",
      "job": "router",
      "step": "Probe the workloads-0",
      "budget_seconds": 60
    }
  ],
  "parity": "swamp/proof/cluster.router_set/parity.py"
}
