#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Archive a completed active .orbit session and preserve related provider
 * session files under the same persisted session directory.
 */

const ARCHIVE_BASENAME_PATTERN = '^[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{6}-[a-z0-9-]+$';

$options = getopt('', [
    'source-orbit-dir:',
    'archive-dir:',
    'archive-root:',
    'slug:',
    'timestamp:',
    'cwd:',
    'home:',
    'marker:',
    'processes-json:',
    'solo-process-id:',
    'solo-project-id:',
    'solo-app-data-dir:',
    'solo-db:',
    'solo-cli:',
    'max-start-distance:',
    'only-ok',
    'discover-by-cwd',
    'help',
]);

if (array_key_exists('help', $options)) {
    fwrite(STDOUT, <<<'EOF'
        Usage:
          bin/orbit-session-archive [--archive-dir=<path> | --slug=<slug>] [agent session options]

        Options:
          --source-orbit-dir=<path>     Active .orbit directory to archive. Defaults to <cwd>/.orbit.
          --archive-dir=<path>          Exact destination session archive directory. Its basename must
                                        match ^[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{6}-[a-z0-9-]+$.
          --archive-root=<path>         Root directory for generated archives. Defaults to the primary checkout's .orbit/sessions.
          --slug=<slug>                 Short feature slug when --archive-dir is omitted. Defaults to the
                                        current branch name sanitized to kebab-case.
          --timestamp=<value>           Timestamp prefix when --archive-dir is omitted. Defaults to current local time as YYYY-MM-DD-HHMMSS.
          --cwd=<path>                  Feature checkout cwd. Defaults to the current directory.

        Provider session options are forwarded to bin/orbit-agent-session-archive:
          --processes-json, --solo-process-id, --solo-project-id, --discover-by-cwd,
          --home, --marker, --solo-app-data-dir, --solo-db, --solo-cli,
          --max-start-distance, --only-ok.

        The active <source-orbit-dir>/loop.md is required. When the newest archive
        for the same slug already contains a byte-identical loop.md, that archive is
        refreshed in place instead of minting a near-duplicate directory. After a
        successful archive the "- Session archive: .orbit/sessions/<basename>"
        bullet is appended or updated under "## Evidence Links" in the active
        loop.md, and loop.md is re-copied so archive and source match.

        If no explicit provider process context is supplied, this command scans
        <source-orbit-dir>/loop.md for Solo process ids and passes them as a
        comma-separated --solo-process-id list. Without discovered process ids,
        agent session archiving safely writes an empty manifest and a WARNING is
        printed naming the missing context. Discovered process ids that cannot
        be resolved do not abort the archive: each one is reported with a
        WARNING and recorded in the agent-sessions manifest with status
        solo_process_not_found, and the archive completes normally.
        EOF);

    exit(0);
}

$cwd = realpath((string) ($options['cwd'] ?? getcwd())) ?: (string) ($options['cwd'] ?? getcwd());
$sourceOrbitDir = isset($options['source-orbit-dir'])
    ? rtrim((string) $options['source-orbit-dir'], '/')
    : "{$cwd}/.orbit";
$sourceOrbitDir = realpath($sourceOrbitDir) ?: $sourceOrbitDir;

if (!is_dir($sourceOrbitDir)) {
    fwrite(STDERR, "Source .orbit directory does not exist: {$sourceOrbitDir}\n");
    exit(2);
}

$activeLoopPath = "{$sourceOrbitDir}/loop.md";

if (!is_file($activeLoopPath)) {
    fwrite(STDERR, "Active loop.md is missing, refusing to archive: {$activeLoopPath}\n");
    exit(2);
}

[$archiveDir, $mode] = resolveArchiveDirectory($options, $cwd, $sourceOrbitDir, $activeLoopPath);

if ($mode === 'refreshed') {
    fwrite(STDERR, "Refreshing existing session archive with identical loop.md instead of minting a duplicate: {$archiveDir}\n");
    clearDirectoryEntries($archiveDir);
} elseif (directoryHasEntries($archiveDir)) {
    fwrite(STDERR, "Archive directory already exists and is not empty: {$archiveDir}\n");
    exit(2);
}

$copiedEntries = copyActiveOrbitEntries($sourceOrbitDir, $archiveDir);

if ($copiedEntries === []) {
    fwrite(STDERR, "No .orbit entries were copied from {$sourceOrbitDir} into {$archiveDir}.\n");
    exit(2);
}

$loopDiscoveryAttempted = shouldDiscoverLoopProcessIds($options);
$loopProcessIds = $loopDiscoveryAttempted ? loopSoloProcessIds($activeLoopPath) : [];

if ($loopDiscoveryAttempted && $loopProcessIds === []) {
    fwrite(
        STDERR,
        'WARNING: no Solo process context available — no --processes-json/--solo-process-id/--solo-project-id/'
        . '--discover-by-cwd option, no SOLO_PROCESS_ID/SOLO_PROJECT_ID environment, and no Solo process ids found in '
        . "{$activeLoopPath}; agent-sessions will contain an empty manifest.\n",
    );
}

// Staged precedence (lane-close capture contract):
// If the active source .orbit/agent-sessions contains staged provider/session captures,
// prefer the copied tree byte-for-byte and do NOT invoke live fallback extraction
// (which would add top-level manifest or other files into archive/agent-sessions).
// No-staging loops still fall back to live extraction.
$sourceStaged = rtrim($sourceOrbitDir, '/') . '/agent-sessions';
if (is_dir($sourceStaged) && hasStagedCaptures($sourceStaged)) {
    fwrite(STDERR, "Preferring validated staged captures from active .orbit/agent-sessions; skipping live extraction.\n");
    $agentResults = [];
} else {
    $agentResults = runAgentSessionArchive($options, $cwd, $archiveDir, $loopProcessIds);
}

writeSessionArchiveLink($activeLoopPath, basename($archiveDir));
copyFileOrFail($activeLoopPath, "{$archiveDir}/loop.md");

$summary = [
    'schema_version' => 1,
    'generated_at' => gmdate('c'),
    'mode' => $mode,
    'source_orbit_dir' => $sourceOrbitDir,
    'archive_dir' => $archiveDir,
    'agent_sessions_dir' => "{$archiveDir}/agent-sessions",
    'copied_entries' => $copiedEntries,
    'discovered_solo_process_ids' => $loopProcessIds,
    'agent_results' => $agentResults,
];

writeJsonFile("{$archiveDir}/orbit-session-archive.json", $summary);
refreshSessionIndex(dirname($archiveDir));

echo json_encode($summary, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR) . PHP_EOL;

/**
 * @param array<string, mixed> $options
 *
 * @return array{0: string, 1: string}
 */
function resolveArchiveDirectory(array $options, string $cwd, string $sourceOrbitDir, string $activeLoopPath): array
{
    if (isset($options['archive-dir'])) {
        $archiveDir = rtrim((string) $options['archive-dir'], '/');
        $basename = basename($archiveDir);

        if (preg_match('/' . ARCHIVE_BASENAME_PATTERN . '/', $basename) !== 1) {
            fwrite(
                STDERR,
                'Archive directory basename must match ' . ARCHIVE_BASENAME_PATTERN
                . " (YYYY-MM-DD-HHMMSS-<feature-slug> in local time): {$basename}\n",
            );
            exit(2);
        }

        $mode = directoryHasEntries($archiveDir) && archiveLoopMatchesActive($archiveDir, $activeLoopPath)
            ? 'refreshed'
            : 'created';

        return [$archiveDir, $mode];
    }

    $archiveRoot = isset($options['archive-root'])
        ? rtrim((string) $options['archive-root'], '/')
        : defaultArchiveRoot($cwd, $sourceOrbitDir);
    $slug = slugify(isset($options['slug']) ? (string) $options['slug'] : defaultArchiveSlug($cwd));
    $existingArchiveDir = newestArchiveForSlug($archiveRoot, $slug);

    if ($existingArchiveDir !== null && archiveLoopMatchesActive($existingArchiveDir, $activeLoopPath)) {
        return [$existingArchiveDir, 'refreshed'];
    }

    $timestamp = archiveTimestamp($options);

    return ["{$archiveRoot}/{$timestamp}-{$slug}", 'created'];
}

/**
 * @param array<string, mixed> $options
 */
function archiveTimestamp(array $options): string
{
    $timestamp = isset($options['timestamp']) ? (string) $options['timestamp'] : localArchiveTimestamp();

    if (preg_match('/^\d{4}-\d{2}-\d{2}-\d{6}$/', $timestamp) === 1) {
        return $timestamp;
    }

    fwrite(STDERR, "Archive timestamp must use YYYY-MM-DD-HHMMSS in local time: {$timestamp}\n");
    exit(2);
}

/**
 * PHP CLI often runs with date.timezone=UTC, which silently produces
 * UTC-derived basenames. Prefer the system clock, which uses the checkout's
 * local timezone, and fall back to PHP time only when the system call fails.
 */
function localArchiveTimestamp(): string
{
    $systemLocalTimestamp = trim((string) shell_exec("date '+%Y-%m-%d-%H%M%S' 2>/dev/null"));

    if (preg_match('/^\d{4}-\d{2}-\d{2}-\d{6}$/', $systemLocalTimestamp) === 1) {
        return $systemLocalTimestamp;
    }

    return date('Y-m-d-His');
}

function newestArchiveForSlug(string $archiveRoot, string $slug): ?string
{
    if (!is_dir($archiveRoot)) {
        return null;
    }

    $matches = [];

    foreach (new FilesystemIterator($archiveRoot, FilesystemIterator::SKIP_DOTS) as $entry) {
        if (!$entry->isDir()) {
            continue;
        }

        $name = $entry->getFilename();

        if (preg_match('/^\d{4}-\d{2}-\d{2}-\d{6}-([a-z0-9-]+)$/', $name, $found) !== 1 || $found[1] !== $slug) {
            continue;
        }

        $matches[] = $name;
    }

    if ($matches === []) {
        return null;
    }

    rsort($matches, SORT_STRING);

    return "{$archiveRoot}/{$matches[0]}";
}

function archiveLoopMatchesActive(string $archiveDir, string $activeLoopPath): bool
{
    $archivedLoopPath = "{$archiveDir}/loop.md";

    if (!is_file($archivedLoopPath)) {
        return false;
    }

    return file_get_contents($archivedLoopPath) === file_get_contents($activeLoopPath);
}

function writeSessionArchiveLink(string $loopPath, string $archiveBasename): void
{
    $bullet = "- Session archive: .orbit/sessions/{$archiveBasename}";
    $content = (string) file_get_contents($loopPath);
    $updated = upsertEvidenceLinkBullet($content, $bullet);

    if ($updated === $content) {
        return;
    }

    if (file_put_contents($loopPath, $updated) === false) {
        fwrite(STDERR, "Failed to write session archive link into active loop.md: {$loopPath}\n");
        exit(2);
    }
}

function upsertEvidenceLinkBullet(string $content, string $bullet): string
{
    $lines = explode("\n", $content);
    $sectionStart = null;

    foreach ($lines as $index => $line) {
        if (preg_match('/^##\s+Evidence Links\s*$/', $line) === 1) {
            $sectionStart = $index;

            break;
        }
    }

    if ($sectionStart === null) {
        return rtrim($content, "\n") . "\n\n## Evidence Links\n\n{$bullet}\n";
    }

    $lineCount = count($lines);
    $sectionEnd = $lineCount;

    for ($index = $sectionStart + 1; $index < $lineCount; $index++) {
        if (str_starts_with($lines[$index], '## ')) {
            $sectionEnd = $index;

            break;
        }
    }

    for ($index = $sectionStart + 1; $index < $sectionEnd; $index++) {
        if (str_starts_with($lines[$index], '- Session archive:')) {
            $lines[$index] = $bullet;

            return implode("\n", $lines);
        }
    }

    $insertAt = $sectionEnd;

    while ($insertAt > $sectionStart + 1 && trim($lines[$insertAt - 1]) === '') {
        $insertAt--;
    }

    array_splice($lines, $insertAt, 0, [$bullet]);

    return implode("\n", $lines);
}

function defaultArchiveRoot(string $cwd, string $sourceOrbitDir): string
{
    $worktreeMarker = '/.worktrees/';
    $worktreeOffset = strpos($cwd, $worktreeMarker);

    if ($worktreeOffset !== false) {
        $primaryCheckout = substr($cwd, 0, $worktreeOffset);

        if ($primaryCheckout !== '' && is_dir($primaryCheckout)) {
            return "{$primaryCheckout}/.orbit/sessions";
        }
    }

    return "{$sourceOrbitDir}/sessions";
}

function defaultArchiveSlug(string $cwd): string
{
    $branch = trim((string) shell_exec('git -C ' . escapeshellarg($cwd) . ' branch --show-current 2>/dev/null'));

    return $branch !== '' ? $branch : basename($cwd);
}

function directoryHasEntries(string $directory): bool
{
    if (!is_dir($directory)) {
        return false;
    }

    $iterator = new FilesystemIterator($directory, FilesystemIterator::SKIP_DOTS);

    return $iterator->valid();
}

function clearDirectoryEntries(string $directory): void
{
    foreach (new FilesystemIterator($directory, FilesystemIterator::SKIP_DOTS) as $entry) {
        removePath($entry->getPathname());
    }
}

function removePath(string $path): void
{
    if (is_dir($path) && !is_link($path)) {
        foreach (new FilesystemIterator($path, FilesystemIterator::SKIP_DOTS) as $child) {
            removePath($child->getPathname());
        }

        rmdir($path);

        return;
    }

    unlink($path);
}

/**
 * @return list<string>
 */
function copyActiveOrbitEntries(string $sourceOrbitDir, string $archiveDir): array
{
    ensureDirectory($archiveDir);
    $copiedEntries = [];
    $iterator = new DirectoryIterator($sourceOrbitDir);

    foreach ($iterator as $entry) {
        if ($entry->isDot()) {
            continue;
        }

        $name = $entry->getFilename();

        if ($name === 'sessions') {
            continue;
        }

        $source = $entry->getPathname();
        $target = "{$archiveDir}/{$name}";

        if ($entry->isLink() && $entry->isDir()) {
            continue;
        }

        if ($entry->isDir()) {
            copyDirectory($source, $target, $name === 'agent-sessions' ? 0 : null);
        } elseif ($entry->isFile()) {
            ensureDirectory(dirname($target));
            copyFileOrFail($source, $target);
        } else {
            continue;
        }

        $copiedEntries[] = $name;
    }

    sort($copiedEntries, SORT_STRING);

    return $copiedEntries;
}

function copyDirectory(string $source, string $target, ?int $agentSessionsDepth = null): void
{
    ensureDirectory($target);
    $iterator = new DirectoryIterator($source);

    foreach ($iterator as $entry) {
        if ($entry->isDot()) {
            continue;
        }

        if ($entry->isLink() && $entry->isDir()) {
            continue;
        }

        if (
            $agentSessionsDepth === 1
            && $entry->isDir()
            && isForeignTemporaryCaptureDirectory($entry->getPathname())
        ) {
            fwrite(STDERR, "WARNING: excluding foreign temporary capture directory: {$entry->getPathname()}\n");

            continue;
        }

        $destination = "{$target}/{$entry->getFilename()}";

        if ($entry->isDir()) {
            copyDirectory(
                $entry->getPathname(),
                $destination,
                $agentSessionsDepth === null ? null : $agentSessionsDepth + 1,
            );

            continue;
        }

        if ($entry->isFile()) {
            ensureDirectory(dirname($destination));
            copyFileOrFail($entry->getPathname(), $destination);
        }
    }
}

function copyFileOrFail(string $source, string $target): void
{
    if (@copy($source, $target)) {
        return;
    }

    fwrite(STDERR, "Failed to copy .orbit entry: {$source} -> {$target}\n");
    exit(2);
}

/**
 * @param array<string, mixed> $options
 */
function shouldDiscoverLoopProcessIds(array $options): bool
{
    if (
        isset($options['processes-json'])
        || isset($options['solo-process-id'])
        || isset($options['solo-project-id'])
        || array_key_exists('discover-by-cwd', $options)
    ) {
        return false;
    }

    return getenv('SOLO_PROCESS_ID') === false && getenv('SOLO_PROJECT_ID') === false;
}

/**
 * @return list<int>
 */
function loopSoloProcessIds(string $loopPath): array
{
    if (!is_file($loopPath)) {
        return [];
    }

    $content = (string) file_get_contents($loopPath);
    $ids = [];
    $patterns = [
        '/\bSolo[^\n]*\bprocess(?:\s+id)?\s*`?(\d+)`?/i',
        '/\b(?:worker|reviewer|analyzer|orchestrator)[^\n]*\bprocess(?:\s+id)?\s*`?(\d+)`?/i',
        '/\bprocess\s+id\s*`?(\d+)`?/i',
    ];

    foreach ($patterns as $pattern) {
        preg_match_all($pattern, $content, $matches);

        foreach ($matches[1] ?? [] as $match) {
            $id = (int) $match;

            if ($id > 0 && !in_array($id, $ids, true)) {
                $ids[] = $id;
            }
        }
    }

    sort($ids, SORT_NUMERIC);

    return $ids;
}

/**
 * @param array<string, mixed> $options
 * @param list<int> $loopProcessIds
 *
 * @return array<int, array<string, mixed>>
 */
function runAgentSessionArchive(array $options, string $cwd, string $archiveDir, array $loopProcessIds): array
{
    $command = [
        PHP_BINARY,
        __DIR__ . '/orbit-agent-session-archive',
        "--archive-dir={$archiveDir}/agent-sessions",
        "--cwd={$cwd}",
    ];

    foreach ([
        'processes-json',
        'solo-process-id',
        'solo-project-id',
        'solo-app-data-dir',
        'solo-db',
        'solo-cli',
        'home',
        'marker',
        'max-start-distance',
    ] as $option) {
        if (isset($options[$option])) {
            $command[] = "--{$option}={$options[$option]}";
        }
    }

    if (!isset($options['solo-process-id']) && $loopProcessIds !== []) {
        $command[] = '--solo-process-id=' . implode(',', $loopProcessIds);
    }

    foreach (['only-ok', 'discover-by-cwd'] as $flag) {
        if (array_key_exists($flag, $options)) {
            $command[] = "--{$flag}";
        }
    }

    [$exitCode, $stdout, $stderr] = runCommand($command);

    if ($stderr !== '') {
        fwrite(STDERR, rtrim($stderr, "\n") . PHP_EOL);
    }

    if ($exitCode !== 0) {
        fwrite(STDERR, $stdout . PHP_EOL);
        exit($exitCode);
    }

    $payload = json_decode($stdout, true);

    return is_array($payload) ? $payload : [];
}

/**
 * Keeps the child's stderr separate from its stdout so warnings on successful
 * runs pass through to the operator without corrupting the JSON payload.
 *
 * @param list<string> $command
 *
 * @return array{0: int, 1: string, 2: string}
 */
function runCommand(array $command): array
{
    $stderrPath = tempnam(sys_get_temp_dir(), 'orbit-session-archive-stderr-');
    $redirect = $stderrPath === false ? '2>&1' : '2>' . escapeshellarg($stderrPath);
    $output = [];
    $exitCode = 0;
    exec(implode(' ', array_map('escapeshellarg', $command)) . ' ' . $redirect, $output, $exitCode);
    $stderr = '';

    if ($stderrPath !== false) {
        $stderr = (string) file_get_contents($stderrPath);
        unlink($stderrPath);
    }

    return [$exitCode, implode("\n", $output), $stderr];
}

function slugify(string $value): string
{
    $slug = strtolower((string) preg_replace('/[^a-zA-Z0-9]+/', '-', $value));
    $slug = trim($slug, '-');

    return $slug === '' ? 'session' : $slug;
}

function writeJsonFile(string $path, array $payload): void
{
    ensureDirectory(dirname($path));
    file_put_contents(
        $path,
        json_encode($payload, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR) . PHP_EOL,
    );
}

function refreshSessionIndex(string $sessionsDir): void
{
    $process = proc_open(
        [
            PHP_BINARY,
            __DIR__ . '/orbit-session-index',
            "--sessions-dir={$sessionsDir}",
            '--write',
        ],
        [
            1 => ['pipe', 'w'],
            2 => ['pipe', 'w'],
        ],
        $pipes,
        dirname(__DIR__),
    );

    if (! is_resource($process)) {
        fwrite(STDERR, "Unable to refresh session index for {$sessionsDir}.\n");
        exit(2);
    }

    $stdout = stream_get_contents($pipes[1]);
    $stderr = stream_get_contents($pipes[2]);
    fclose($pipes[1]);
    fclose($pipes[2]);

    $exitCode = proc_close($process);

    if ($exitCode !== 0) {
        fwrite(STDERR, $stderr ?: $stdout ?: "Unable to refresh session index for {$sessionsDir}.\n");
        exit(2);
    }
}

function ensureDirectory(string $directory): void
{
    if (is_dir($directory)) {
        return;
    }

    if (!mkdir($directory, 0o775, true) && !is_dir($directory)) {
        throw new RuntimeException("Unable to create directory: {$directory}");
    }
}

/**
 * Returns true only when the active staging tree contains manifest-backed
 * captures. Malformed or empty staging should not suppress fallback extraction.
 */
function hasStagedCaptures(string $dir, int $agentSessionsDepth = 0): bool
{
    if (! is_dir($dir) || is_link($dir)) {
        return false;
    }

    $iterator = new DirectoryIterator($dir);

    foreach ($iterator as $entry) {
        if ($entry->isDot()) {
            continue;
        }

        if ($entry->isLink() && $entry->isDir()) {
            continue;
        }

        if ($entry->isDir()) {
            if ($agentSessionsDepth === 1 && isForeignTemporaryCaptureDirectory($entry->getPathname())) {
                continue;
            }

            if (hasStagedCaptures($entry->getPathname(), $agentSessionsDepth + 1)) {
                return true;
            }

            continue;
        }

        if ($entry->isFile() && $entry->getFilename() === 'manifest.json') {
            return true;
        }
    }

    return false;
}

function isForeignTemporaryCaptureDirectory(string $path): bool
{
    return preg_match('/^\..+\.tmp-[^\/]+$/', basename($path)) === 1;
}
