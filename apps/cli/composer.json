{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "hardimpactdev/orbit-cli",
    "description": "Orbit local CLI and executor application.",
    "keywords": [
        "cli",
        "laravel-zero",
        "orbit"
    ],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.4",
        "hardimpactdev/orbit-core": "dev-main",
        "illuminate/http": "^12.0",
        "laravel-zero/framework": "^12.0"
    },
    "require-dev": {
        "laravel/pint": "^1.29",
        "pestphp/pest": "^4.6",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "provide": {
        "laravel/framework": "12.60.2"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../packages/core",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "format": "vendor/bin/pint",
        "test": "vendor/bin/pest --compact"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "bin": [
        "orbit"
    ]
}
