{
  "kind": "metrics.exporter_disable",
  "workflow": "operation-metrics-exporter-disable",
  "topology": "minimal",
  "clean": false,
  "budget_seconds": 600,
  "queue_timeout_seconds": 60,
  "request": {
    "method": "DELETE",
    "path": "metrics/exporters/${node.metrics}"
  },
  "expect": {
    "status": "succeeded"
  },
  "phases": [
    {
      "name": "Publish the config",
      "job": "exporter",
      "step": "Publish the config",
      "budget_seconds": 120
    },
    {
      "name": "Stop, remove exporters",
      "job": "exporter",
      "step": "Stop, remove exporters",
      "budget_seconds": 300
    },
    {
      "name": "Prove the exporter state",
      "job": "exporter",
      "step": "Prove the exporter state",
      "budget_seconds": 10
    }
  ],
  "parity": [
    "swamp/proof/metrics.exporter/parity.py",
    "disable"
  ]
}
