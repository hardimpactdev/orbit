{
  "kind": "process.create.docker.stopped",
  "workflow": "operation-process-create",
  "topology": "minimal",
  "budget_seconds": 180,
  "queue_timeout_seconds": 30,
  "expect": {
    "status": "succeeded"
  },
  "request": {
    "method": "POST",
    "path": "processes",
    "body": {
      "target_type": "node",
      "target_id": "${node.target}",
      "name": "docker-${proof.run}",
      "runtime": "docker",
      "image": "busybox:1.36",
      "command": [
        "sleep",
        "infinity"
      ],
      "start": false
    }
  },
  "phases": [
    {
      "name": "Pull the image",
      "job": "process",
      "step": "Pull the image",
      "budget_seconds": 120
    },
    {
      "name": "Run the container",
      "job": "process",
      "step": "Run the container",
      "budget_seconds": 20
    },
    {
      "name": "Stop the container",
      "job": "process",
      "step": "Stop the container",
      "budget_seconds": 20
    },
    {
      "name": "Verify it runs",
      "job": "process",
      "step": "Verify it runs",
      "budget_seconds": 20
    }
  ],
  "parity": [
    "swamp/proof/process/parity.py",
    "stopped"
  ]
}
