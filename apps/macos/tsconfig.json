{
    "compilerOptions": {
        "allowSyntheticDefaultImports": true,
        "exactOptionalPropertyTypes": true,
        "lib": [
            "ES2024",
            "DOM",
            "DOM.Iterable"
        ],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "noEmit": true,
        "noUncheckedIndexedAccess": true,
        "skipLibCheck": true,
        "strict": true,
        "target": "ES2024",
        "verbatimModuleSyntax": true
    },
    "include": [
        "frontend/src/**/*.ts",
        "vite.config.ts"
    ],
    "exclude": [
        "frontend/src/**/*.test.ts"
    ]
}
