{
  "kind": "database.destroy.redis",
  "workflow": "operation-database-destroy",
  "topology": "minimal",
  "budget_seconds": 120,
  "queue_timeout_seconds": 30,
  "expect": {
    "status": "succeeded"
  },
  "clean_target": [
    [
      "sh",
      "-c",
      "docker ps --all --quiet --filter name=-proof- | xargs -r docker rm --force"
    ]
  ],
  "prepare": [
    {
      "method": "POST",
      "path": "database-servers",
      "body": {
        "slug": "proof-dbsrv-${proof.run}",
        "node_id": "${node.target}",
        "driver": "redis",
        "port": 36401
      },
      "bind": "server"
    },
    {
      "method": "POST",
      "path": "database-connections",
      "body": {
        "slug": "proof-db-${proof.run}",
        "server": "proof-dbsrv-${proof.run}",
        "patterns": [
          "proof:*"
        ],
        "allow": [
          "@read",
          "@write"
        ]
      },
      "bind": "connection"
    }
  ],
  "request": {
    "method": "DELETE",
    "path": "database-connections/proof-db-${proof.run}"
  },
  "phases": [
    {
      "name": "Read the scripts",
      "job": "destroy",
      "step": "Read the scripts",
      "budget_seconds": 30
    },
    {
      "name": "Drop databases and users",
      "job": "destroy",
      "step": "Drop databases and users",
      "budget_seconds": 120
    },
    {
      "name": "Check they are gone",
      "job": "destroy",
      "step": "Check they are gone",
      "budget_seconds": 60
    },
    {
      "name": "Report the result",
      "job": "destroy",
      "step": "Report the result",
      "budget_seconds": 30
    }
  ],
  "parity": [
    "swamp/proof/database/parity.py",
    "destroyed"
  ]
}
