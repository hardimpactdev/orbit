{
  "kind": "instance.create",
  "workflow": "operation-instance-create",
  "topology": "app-dev",
  "budget_seconds": 1800,
  "queue_timeout_seconds": 600,
  "request": {
    "argv": ["orbit", "instance:create", "${capture.project_id}", "${topology.app-dev.node_id}", "proof-${proof.run}", "--root=empty-environment", "--branch=proof-${proof.run}", "--json"],
    "operation": "$.id"
  },
  "expect": {
    "status": "succeeded",
    "outputs": {
      "job": "create",
      "step": "finish-result",
      "match": {
        "ready": true
      }
    }
  },
  "prepare": [
    {
      "argv": ["orbit", "project:create", "proof-empty-environment-${proof.run}", "node-package", "${proof.repo.url}", "--root=empty-environment", "--default-branch=main", "--source-access=github_app", "--json"],
      "capture": {
        "project_id": "$.id"
      }
    },
    {
      "argv": ["orbit", "instance:setup-step:create", "empty-map-reached-setup", "--project=${capture.project_id}", "--command=test -f empty-environment/.env && printf empty-environment > .orbit-proof-empty", "--timeout=10", "--json"]
    }
  ],
  "envelope": {
    "project_id": "${capture.project_id}",
    "node_id": "${topology.app-dev.node_id}",
    "root": "empty-environment",
    "branch_override": "proof-${proof.run}",
    "repository": "${proof.repo.url}",
    "default_branch": "main"
  },
  "phases": [
    {
      "name": "source",
      "job": "prepare",
      "step": "source-result",
      "budget_seconds": 1800
    },
    {
      "name": "setup",
      "job": "create",
      "step": "finish-setup-0-0",
      "budget_seconds": 30
    }
  ],
  "parity": {
    "command": ["python3", "-I", "swamp/proof/instance.create/outage_parity.py", "empty-environment"],
    "cases": [
      "exact-normal-operation-terminal-projection",
      "empty-environment",
      "new-instance-no-stored-environment-writes",
      "empty-map-accepted-by-native-environment-schema"
    ]
  }
}
