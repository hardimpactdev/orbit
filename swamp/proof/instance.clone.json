{
  "kind": "instance.clone",
  "workflow": "operation-instance-clone",
  "topology": "minimal",
  "budget_seconds": 240,
  "queue_timeout_seconds": 30,
  "prepare": [
    {
      "method": "POST",
      "path": "projects",
      "operation": false,
      "bind": "project",
      "body": {
        "slug": "proof-clone",
        "name": "Proof clone",
        "type": "node-package",
        "root": "public",
        "repository_url": "https://github.com/laravel/laravel.git",
        "default_branch": "12.x"
      }
    },
    {
      "method": "POST",
      "path": "projects/${project.id}/process-definitions",
      "operation": false,
      "body": {
        "name": "proof-worker",
        "environments": [
          "production"
        ],
        "spec": {
          "runtime": "systemd",
          "command": [
            "/bin/sleep",
            "3600"
          ]
        }
      }
    },
    {
      "method": "POST",
      "path": "instances",
      "bind": "candidate",
      "body": {
        "project_id": "${project.id}",
        "node_id": "${node.target}",
        "name": "cand",
        "branch": "12.x"
      }
    },
    {
      "method": "POST",
      "path": "routes",
      "body": {
        "instance_id": "${candidate.id}",
        "domain": "cand.proof.test"
      }
    },
    {
      "method": "PATCH",
      "path": "projects/${project.id}",
      "operation": false,
      "body": {
        "type": "laravel-app"
      }
    },
    {
      "method": "PUT",
      "path": "instances/${candidate.id}/environment/PROOF_SECRET",
      "operation": false,
      "body": {
        "value": "proof-private-${proof.run}"
      }
    }
  ],
  "request": {
    "method": "POST",
    "path": "instances/${candidate.id}/clone",
    "body": {
      "node_id": "${node.peer}",
      "name": "k-${proof.run}",
      "preview_name": "k-${proof.run}",
      "sqlite_source_path": "/home/orbit/proof-clone.sqlite"
    }
  },
  "expect": {
    "status": "succeeded"
  },
  "phases": [
    {
      "name": "Check candidate source",
      "job": "clone",
      "step": "Check candidate source",
      "budget_seconds": 30
    },
    {
      "name": "Fetch the source",
      "job": "clone",
      "step": "Fetch the source",
      "budget_seconds": 90
    },
    {
      "name": "Write .env, prepare Vite+",
      "job": "clone",
      "step": "Write .env, prepare Vite+",
      "budget_seconds": 60
    },
    {
      "name": "Snapshot the database",
      "job": "clone",
      "step": "Snapshot the database",
      "budget_seconds": 30
    },
    {
      "name": "Install the database",
      "job": "clone",
      "step": "Install the database",
      "budget_seconds": 30
    },
    {
      "name": "Add Processes, Schedules",
      "job": "clone",
      "step": "Add Processes, Schedules",
      "budget_seconds": 60
    },
    {
      "name": "Make a CSR on the Node",
      "job": "clone",
      "step": "Make a CSR on the Node-0",
      "budget_seconds": 30
    },
    {
      "name": "Sign the CSR",
      "job": "clone",
      "step": "Sign the CSR-0",
      "budget_seconds": 30
    },
    {
      "name": "Publish preview Route",
      "job": "clone",
      "step": "Publish preview Route",
      "budget_seconds": 60
    },
    {
      "name": "Check the clone",
      "job": "clone",
      "step": "Check the clone",
      "budget_seconds": 30
    },
    {
      "name": "Remove the snapshot",
      "job": "clone",
      "step": "Remove the snapshot",
      "budget_seconds": 30
    },
    {
      "name": "Report the result",
      "job": "clone",
      "step": "Report the result",
      "budget_seconds": 15
    }
  ],
  "parity": "swamp/proof/instance.clone/parity.py",
  "before_gateway": [
    [
      "sh",
      "-c",
      "printf '%s' \"$1\" | runuser -u orbit -- env -C apps/gateway php ../../tools/swamp-proof-guest/gateway.php fixture",
      "sh",
      "{\"replace_roles\": {\"${node.peer}\": [\"app-prod\"]}, \"node_updates\": [{\"id\": \"${node.peer}\", \"attributes\": {\"tld\": \"prod.test\"}}]}"
    ]
  ],
  "before_target": [
    [
      "runuser",
      "-u",
      "orbit",
      "--",
      "python3",
      "-I",
      "-c",
      "import sqlite3; c = sqlite3.connect('/home/orbit/proof-clone.sqlite'); c.execute('create table if not exists proof (v text)'); c.execute('delete from proof'); c.execute(\"insert into proof values ('proof-row')\"); c.commit()"
    ]
  ],
  "clean": true
}
