{
  "workflow": "operation-node-remove",
  "topology": "minimal",
  "clean": true,
  "budget_seconds": 1800,
  "queue_timeout_seconds": 30,
  "prepare": [],
  "phases": [
    {
      "name": "Confirm Node removal",
      "job": "remove",
      "step": "Confirm Node removal",
      "budget_seconds": 20
    }
  ],
  "kind": "node.remove.offline",
  "before_node": {
    "peer": [
      [
        "sh",
        "-c",
        "mkdir -p /srv/proof-retained; echo keep > /srv/proof-retained/user-data; ufw insert 1 deny proto tcp from 10.231.0.1 to any port 22"
      ]
    ]
  },
  "request": {
    "method": "DELETE",
    "path": "nodes/${node.peer}",
    "body": {
      "force": true,
      "offline": true
    }
  },
  "expect": {
    "status": "succeeded"
  },
  "parity": [
    "swamp/proof/node.remove/parity.py",
    "offline"
  ]
}
