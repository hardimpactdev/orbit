#!/usr/bin/env python3
"""Switch only the Gateway handlers under the Node's Caddy publication lock."""

import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path


CADDY = Path("/etc/caddy")
CONFIG = CADDY / "Caddyfile"
MODES = CADDY / "orbit-gateway-modes"
SELECTION = CADDY / "orbit-gateway-handlers.caddy"
HANDOVER = Path("/var/lib/orbit/gateway-release-switch/operation")
PREPARED = Path("/home/orbit/.orbit/gateway-site-prepared")


def write(path, content, mode=0o644, owner=None):
    with tempfile.NamedTemporaryFile(dir=path.parent, delete=False) as stream:
        stage = Path(stream.name)
        try:
            if owner is not None:
                os.fchown(stream.fileno(), *owner)
            os.fchmod(stream.fileno(), mode)
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
            os.replace(stage, path)
        finally:
            stage.unlink(missing_ok=True)


def select(mode):
    source = MODES / (mode + ".caddy")
    if not source.is_file():
        raise ValueError(f"missing prepared handlers: {source}")
    if SELECTION.exists() and not SELECTION.is_symlink():
        raise ValueError(f"refusing to replace an unmanaged file: {SELECTION}")
    temp = MODES / "selection.next"
    temp.unlink(missing_ok=True)
    temp.symlink_to(source)
    os.replace(temp, SELECTION)


def prepare(config, managed):
    if not config.startswith("# Managed by Orbit: Node Caddy build\n"):
        raise ValueError("expected a managed Node Caddyfile")
    sections = tuple(re.finditer(r"(?ms)^# orbit: gateway [^\n]+\n.*?^\}", config))
    if len(sections) != 1:
        raise ValueError("expected exactly one Gateway site")
    block = sections[0]
    match = re.search(r"(?m)^    bind (\d+\.\d+\.\d+\.\d+)$", block[0])
    if not match:
        raise ValueError("Gateway site has no private IPv4 bind")
    include = f"    import {SELECTION} {match[1]}\n"
    if managed and (include not in block[0] or not SELECTION.is_symlink() or SELECTION.readlink() != MODES / "container.caddy"):
        raise ValueError("restore the managed Gateway container handlers before preparing the site")
    if include in block[0]:
        if not SELECTION.is_symlink() or not (MODES / "host.caddy").is_file():
            raise ValueError("missing handler selection or host recovery configuration")
        return config
    start = block[0].find("    @gateway path ")
    if start < 0 or "php_fastcgi unix//run/php/orbit-gateway.sock" not in block[0][start:]:
        raise ValueError("Gateway site does not contain the expected PHP-FPM handlers")
    handlers = block[0][start:-1]
    write(MODES / "host.caddy", handlers.encode())
    select("host")
    return config[:block.start() + start] + include + config[block.end()-1:]


def metrics_import(config):
    # Convert only the published private Metrics site. Keep its listener, access guard,
    # certificate and Grafana upstream exactly as published.
    block = re.search(r"(?ms)^# orbit: metrics metrics[.]orbit\n.*?^}", config)
    if not block:
        return config
    body = block[0]
    selected = str(MODES / "metrics-auth.caddy")
    if re.search(r"(?m)^\s*import " + re.escape(selected) + r" ", body):
        return config
    old = re.search(
        r"(?m)^(?P<indent>[ \t]*)forward_auth unix//run/php/orbit-gateway[.]sock \{\n"
        r"\s*uri /index[.]php\n\s*transport fastcgi \{\n\s*root (?P<root>/[^\n{}]+/public)\n"
        r"\s*resolve_root_symlink\n\s*split [.]php\n\s*env REQUEST_URI /api/v1/metrics/grafana/authorize\n"
        r"\s*env REMOTE_ADDR \{remote_host\}\n\s*\}\n\s*\}", body,
    )
    if not old or not re.search(r"(?m)^metrics[.]orbit \{$", body):
        raise ValueError("unrecognized Gateway authorization in the private Metrics site")
    directive = old["indent"] + "import " + selected + " " + old["root"]
    return config[:block.start()] + body[:old.start()] + directive + body[old.end():] + config[block.end():]


def metrics_handler(mode):
    if mode == "host":
        return b"""forward_auth unix//run/php/orbit-gateway.sock {
    uri /index.php
    transport fastcgi {
        root {args[0]}
        resolve_root_symlink
        split .php
        env REQUEST_URI /api/v1/metrics/grafana/authorize
        env REMOTE_ADDR {remote_host}
    }
}
"""
    return b"""import /etc/caddy/orbit-gateway-upstream.caddy
forward_auth {http.vars.gateway_release_upstream} {
    uri /api/v1/metrics/grafana/authorize
    header_up X-Forwarded-For {remote_host}
}
"""


def reload_config():
    subprocess.run(["caddy", "validate", "--adapter", "caddyfile", "--config", CONFIG], check=True)
    subprocess.run(["systemctl", "reload", "caddy.service"], check=True)


def apply(mode):
    managed = PREPARED.with_name("gateway-containers.json").exists()
    if mode != "container" and HANDOVER.exists():
        raise ValueError("finish the committed Gateway handover with --recover")
    if mode == "host" and managed:
        raise ValueError("the managed Gateway only accepts forward container releases")
    status = CONFIG.stat()
    permissions = status.st_mode & 0o777
    owner = (status.st_uid, status.st_gid)
    original = CONFIG.read_bytes()
    previous = SELECTION.readlink() if SELECTION.is_symlink() else None
    changed_config = False
    metrics_file = MODES / "metrics-auth.caddy"
    old_metrics = metrics_file.read_bytes() if metrics_file.exists() else None
    try:
        candidate = original.decode()
        if mode == "prepare":
            candidate = prepare(candidate, managed)
        else:
            if not PREPARED.is_file():
                raise ValueError("prepare the Gateway Caddy site first")
            select(mode)
        candidate = metrics_import(candidate).encode()
        active = SELECTION.readlink()
        if active not in (MODES / "host.caddy", MODES / "container.caddy"):
            raise ValueError("unexpected Gateway handler selection")
        write(metrics_file, metrics_handler(active.stem))
        if candidate != original:
            write(CONFIG, candidate, permissions, owner)
            changed_config = True
        reload_config()
        if mode == "prepare":
            write(PREPARED, b"1\n")
        write(PREPARED.with_name("gateway-metrics-prepared"), b"1\n")
    except BaseException:
        # A failed reload can have accepted the new route. The committed handover
        # republishes this candidate on recovery; never re-expose the host here.
        if mode == "container":
            raise
        if old_metrics is None:
            metrics_file.unlink(missing_ok=True)
        else:
            write(metrics_file, old_metrics)
        changed_selection = (SELECTION.readlink() if SELECTION.is_symlink() else None) != previous
        if changed_config:
            write(CONFIG, original, permissions, owner)
        if previous is None:
            SELECTION.unlink(missing_ok=True)
        elif changed_selection:
            restore = MODES / "selection.next"
            restore.unlink(missing_ok=True)
            restore.symlink_to(previous)
            os.replace(restore, SELECTION)
        if changed_config or changed_selection:
            reload_config()
        raise


if __name__ == "__main__":
    if len(sys.argv) != 2 or sys.argv[1] not in {"prepare", "host", "container"}:
        sys.exit("usage: orbit-gateway-site prepare|host|container")
    with (CADDY / ".orbit-publish.lock").open("a") as lock:
        subprocess.run(["flock", "--exclusive", "--timeout", "30", str(lock.fileno())],
                       pass_fds=(lock.fileno(),), check=True)
        apply(sys.argv[1])
